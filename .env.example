# Copy this file to .env and fill in real values before deploying.

# If something else on this computer already uses port 3000 (a common
# default for other projects/apps), change this to something else, e.g. 3010.
PORT=3010

# Signs the admin login session cookie. Set this to a long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Seeded on first run only (when no admin account exists yet).
# Change the password immediately after logging in via Admin > Settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Only set this to 1 if this app is deployed behind a real TLS-terminating
# reverse proxy (nginx, Caddy, a tunnel) rather than run directly - it
# tells Express to trust that proxy's X-Forwarded-Proto header so the
# login session cookie is correctly marked Secure. Leave unset for a
# normal LAN kiosk setup (plain http://, no proxy in front).
# TRUST_PROXY=1

# --- Supabase/Postgres + Netlify deployment (see MIGRATION.md) ---
# Not needed for a normal local/LAN install - only set these once actually
# cutting over to the hosted Supabase + Netlify deployment. Until then
# this app runs entirely on the local SQLite file in data/, no network
# database required.

# Supabase project's *pooled* Postgres connection string (Project Settings
# > Database > Connect > Transaction pooler), password percent-encoded.
# Netlify Functions open/close connections far more often than a
# long-running server would - the pooler is built for exactly that.
# DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Project Settings > API. SUPABASE_URL/SUPABASE_ANON_KEY are the project's
# public identifiers; SUPABASE_SERVICE_ROLE_KEY is a privileged secret
# (bypasses RLS) needed for utils/storage.js to actually read/write
# uploaded files (member photos, documents, design images) - never expose
# it to a browser, it's server-side-only.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# TRUST_PROXY should be set to 1 for the Netlify deployment specifically -
# Netlify's own edge network terminates TLS in front of the function, so
# Express needs to trust its X-Forwarded-Proto header for the login
# session cookie to be correctly marked Secure.
# TRUST_PROXY=1
