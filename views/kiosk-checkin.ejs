<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="kiosk kiosk-checkin">
  <main class="kiosk-wrap">
    <a href="/" class="kiosk-home">&larr; Home</a>
    <img class="kiosk-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
    <p class="kiosk-date"><%= dateLabel %></p>

    <div class="kiosk-panel">
      <p id="kiosk-instructions" class="kiosk-instructions">Scan your name tag barcode</p>
      <div id="kiosk-status" class="kiosk-status kiosk-status-idle">
        <span class="kiosk-status-icon">📷</span>
      </div>
      <form id="scan-form" autocomplete="off">
        <input
          id="barcode-input"
          name="barcode"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          inputmode="none"
        />
      </form>
    </div>
  </main>
  <script src="/js/kiosk-common.js"></script>
  <script src="/js/kiosk-checkin.js"></script>
</body>
</html>
