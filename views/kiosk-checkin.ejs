<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="kiosk kiosk-checkin">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="kiosk-wrap">
    <a href="/kiosk" class="kiosk-home"><svg class="icon"><use href="#icon-home"/></svg> Return to Home Screen</a>
    <div class="kiosk-header">
      <img class="kiosk-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <h1><%= title %></h1>
    </div>
    <p class="kiosk-date"><%= dateLabel %></p>

    <div id="step-scan" class="kiosk-panel">
      <div class="kiosk-method-choice">
        <p class="kiosk-instructions">How would you like to check in?</p>
        <div class="kiosk-method-buttons">
          <button type="button" class="kiosk-method-btn kiosk-method-btn-scanner" data-method="scanner">
            <span class="landing-icon"><svg class="icon"><use href="#icon-barcode"/></svg></span>
            <span class="landing-label">Barcode Scanner</span>
          </button>
          <button type="button" class="kiosk-method-btn kiosk-method-btn-manual" data-method="manual">
            <span class="landing-icon"><svg class="icon"><use href="#icon-grid"/></svg></span>
            <span class="landing-label">Manually Enter ID #</span>
          </button>
        </div>
      </div>

      <div data-method-panel="scanner" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-scan-now-text">Scan barcode now</p>
      </div>

      <div data-method-panel="manual" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-scan-now-text">Please enter your ID number</p>
        <div id="id-keypad"></div>
        <button type="button" id="manual-submit-btn" class="primary-btn">Submit</button>
      </div>

      <div id="kiosk-result" hidden>
        <div id="kiosk-status" class="kiosk-status kiosk-status-idle">
          <span class="kiosk-status-icon"></span>
        </div>
        <p id="kiosk-instructions" class="kiosk-instructions"></p>
      </div>

      <form id="scan-form" autocomplete="off">
        <input
          id="barcode-input"
          name="barcode"
          type="text"
          aria-label="Scan a barcode"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          inputmode="none"
        />
      </form>
    </div>

    <!-- A real request: "add a dropdown menu to each setup/cleanup team
         list that asks, log on check in or log on check out ... if team
         1 is, log on check in, those members will click check in, scan
         their name tag, then will be asked to scan their setup/cleanup
         card." Only shown for a parent/admin on a team set to that
         timing (see step-scan above and public/js/kiosk-checkin.js) -
         everyone else (students always; a "log on check out" member)
         checks in with the single name tag scan above, same as before.
         Same two-method shape as step-scan, just for a task's barcode
         instead of a member's - mirrors kiosk-checkout.ejs's own
         step-task exactly. -->
    <!-- A real request: "if the check in/out needs to ask the parent to
         scan their setup/cleanup badge then after scanning their ID it
         will immediately say please scan your setup/cleanup badge. if
         they select ID, then after they enter their ID and click
         submit, it will immediately say please enter your setup/cleanup
         badge ID number." No chooser here anymore for that reason -
         public/js/kiosk-checkin.js jumps straight to whichever method
         panel matches step-scan's own (data-back-to-chooser still lets
         someone switch if they need to), so this step never makes them
         pick a method twice.

         The task-* classes below (alongside this panel's own ids, kept
         for aria-label/uniqueness) are what public/js/kiosk-checkin.js's
         shared wireTaskStep() queries by, so this exact block can be
         reused verbatim as step-task-2 further down for the optional
         2nd badge. -->
    <div id="step-task" class="kiosk-panel kiosk-hidden">
      <div class="kiosk-method-choice">
        <div class="kiosk-method-buttons">
          <button type="button" class="kiosk-method-btn kiosk-method-btn-scanner" data-method="scanner">
            <span class="landing-icon"><svg class="icon"><use href="#icon-barcode"/></svg></span>
            <span class="landing-label">Barcode Scanner</span>
          </button>
          <button type="button" class="kiosk-method-btn kiosk-method-btn-manual" data-method="manual">
            <span class="landing-icon"><svg class="icon"><use href="#icon-grid"/></svg></span>
            <span class="landing-label">Manually Enter ID #</span>
          </button>
        </div>
      </div>

      <div data-method-panel="scanner" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-instructions">Hi <span class="task-member-name">-</span>, please scan your Setup/Cleanup badge</p>
      </div>

      <div data-method-panel="manual" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-instructions">Hi <span class="task-member-name">-</span>, please enter your Setup/Cleanup badge ID number</p>
        <div class="task-id-keypad" id="task-id-keypad"></div>
        <button type="button" class="task-manual-submit-btn primary-btn" id="task-manual-submit-btn">Submit</button>
      </div>

      <div class="task-kiosk-result" id="task-kiosk-result" hidden>
        <div class="task-kiosk-status kiosk-status kiosk-status-idle" id="task-kiosk-status">
          <span class="kiosk-status-icon"></span>
        </div>
        <p class="task-kiosk-instructions kiosk-instructions" id="task-kiosk-instructions"></p>
      </div>

      <form class="task-scan-form" id="task-scan-form" autocomplete="off">
        <input
          class="task-barcode-input"
          id="task-barcode-input"
          name="barcode"
          type="text"
          aria-label="Scan your Setup/Cleanup badge"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          inputmode="none"
        />
      </form>

      <button id="cancel-btn" type="button" class="kiosk-cancel-btn">Cancel</button>
    </div>

    <!-- A real request: "after parent scans their setup/cleanup badge it
         should ask if they have a 2nd setup/cleanup badge to scan, with
         yes and no buttons. if they select yes, it allows them to scan
         their barcode. if they are entering I'd numbers, it will show a
         keypad and allow them to enter their ID number. after the 2nd
         badge entry the screen says thank, you! and goes back to the
         home screen. if they select no, it's says thank you! and goes
         back to the home screen." A member covering two Setup/Cleanup
         jobs the same day (setup_task_assignments.task_item_id_2) needs
         a way to log both - shown right after step-task's own badge
         scan succeeds instead of finishing immediately. -->
    <div id="step-second-badge" class="kiosk-panel kiosk-hidden">
      <p class="kiosk-instructions">Do you have a 2nd Setup/Cleanup badge to scan?</p>
      <div class="kiosk-yesno-buttons">
        <button type="button" id="second-badge-yes-btn" class="primary-btn">Yes</button>
        <button type="button" id="second-badge-no-btn" class="btn-secondary">No</button>
      </div>
    </div>

    <!-- Badge #2 - an exact copy of step-task above (same task-* classes,
         see that panel's own comment), reused by public/js/kiosk-
         checkin.js's shared wireTaskStep() for the second scan. -->
    <div id="step-task-2" class="kiosk-panel kiosk-hidden">
      <div class="kiosk-method-choice">
        <div class="kiosk-method-buttons">
          <button type="button" class="kiosk-method-btn kiosk-method-btn-scanner" data-method="scanner">
            <span class="landing-icon"><svg class="icon"><use href="#icon-barcode"/></svg></span>
            <span class="landing-label">Barcode Scanner</span>
          </button>
          <button type="button" class="kiosk-method-btn kiosk-method-btn-manual" data-method="manual">
            <span class="landing-icon"><svg class="icon"><use href="#icon-grid"/></svg></span>
            <span class="landing-label">Manually Enter ID #</span>
          </button>
        </div>
      </div>

      <div data-method-panel="scanner" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-instructions">Hi <span class="task-member-name">-</span>, please scan your 2nd Setup/Cleanup badge</p>
      </div>

      <div data-method-panel="manual" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-instructions">Hi <span class="task-member-name">-</span>, please enter your 2nd Setup/Cleanup badge ID number</p>
        <div class="task-id-keypad" id="task-id-keypad-2"></div>
        <button type="button" class="task-manual-submit-btn primary-btn" id="task-manual-submit-btn-2">Submit</button>
      </div>

      <div class="task-kiosk-result" id="task-kiosk-result-2" hidden>
        <div class="task-kiosk-status kiosk-status kiosk-status-idle" id="task-kiosk-status-2">
          <span class="kiosk-status-icon"></span>
        </div>
        <p class="task-kiosk-instructions kiosk-instructions" id="task-kiosk-instructions-2"></p>
      </div>

      <form class="task-scan-form" id="task-scan-form-2" autocomplete="off">
        <input
          class="task-barcode-input"
          id="task-barcode-input-2"
          name="barcode"
          type="text"
          aria-label="Scan your 2nd Setup/Cleanup badge"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          inputmode="none"
        />
      </form>

      <button id="cancel-btn-2" type="button" class="kiosk-cancel-btn">Cancel</button>
    </div>
  </main>
  <script src="/js/kiosk-common.js"></script>
  <script src="/js/kiosk-id-keypad.js"></script>
  <script src="/js/kiosk-checkin.js"></script>
  <script src="/js/fullscreen-nav.js"></script>
</body>
</html>
