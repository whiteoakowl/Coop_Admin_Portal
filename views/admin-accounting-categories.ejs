<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1>Category/Fiscal Year</h1>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('add-category-dialog').showModal()">+ Add Category</button>
    </div>
    <p class="hint">A fixed list an event's Finance tab (or an invoice's own Category) picks one of, for internal bookkeeping.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (accountingCategories.length === 0) { %>
      <p class="roster-empty">No accounting categories yet &mdash; add one above.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table condensed-table accounting-table-mobile-fit">
          <thead><tr><th>Title</th><th>Code</th><th></th></tr></thead>
          <tbody>
            <% accountingCategories.forEach(function(c) { %>
              <tr>
                <td>
                  <form method="POST" action="/main-admin/accounting/accounting-categories/<%= c.id %>/update" class="inline-block-form">
                    <input type="hidden" name="code" value="<%= c.code || '' %>" />
                    <input type="text" name="name" value="<%= c.name %>" onchange="this.form.submit()" aria-label="Title for <%= c.name %>" />
                  </form>
                </td>
                <td>
                  <form method="POST" action="/main-admin/accounting/accounting-categories/<%= c.id %>/update" class="inline-block-form">
                    <input type="hidden" name="name" value="<%= c.name %>" />
                    <input type="text" name="code" value="<%= c.code || '' %>" onchange="this.form.submit()" aria-label="Code for <%= c.name %>" />
                  </form>
                </td>
                <td>
                  <form method="POST" action="/main-admin/accounting/accounting-categories/<%= c.id %>/delete" class="inline-block-form" data-confirm="Delete this accounting category? Events/invoices using it will just show no category.">
                    <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= c.name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="grid-box-header" style="margin-top: 1.5rem;">
      <h2>Fiscal Years</h2>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('add-fiscal-year-dialog').showModal()">+ Add Fiscal Year</button>
    </div>

    <% if (fiscalYears.length === 0) { %>
      <p class="roster-empty">No fiscal years yet &mdash; add one above.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table condensed-table accounting-table-mobile-fit">
          <thead><tr><th>Start Date</th><th>End Date</th><th></th></tr></thead>
          <tbody>
            <% fiscalYears.forEach(function(fy) { %>
              <tr>
                <td><%= fy.start_date %></td>
                <td><%= fy.end_date %></td>
                <td>
                  <form method="POST" action="/main-admin/accounting/fiscal-years/<%= fy.id %>/delete" class="inline-block-form" data-confirm="Delete this fiscal year?">
                    <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete fiscal year" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <dialog id="add-category-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/accounting/accounting-categories">
        <h3>Add Category</h3>
        <label>Title
          <input type="text" name="name" placeholder="e.g. Registration &amp; Renewals" required />
        </label>
        <label>Code
          <input type="text" name="code" placeholder="e.g. RR" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Save</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-fiscal-year-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/accounting/fiscal-years">
        <h3>Add Fiscal Year</h3>
        <label>Start Date
          <input type="date" name="startDate" required />
        </label>
        <label>End Date
          <input type="date" name="endDate" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Save</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
