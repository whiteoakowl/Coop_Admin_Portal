<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <main class="form-wrap">
    <a href="/" class="kiosk-home">&larr; Home</a>
    <img class="form-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
    <h1>Absence/Late Form</h1>

    <% if (result) { %>
      <div class="alert <%= result.ok ? 'alert-success' : 'alert-error' %>"><%= result.message %></div>
    <% } %>

    <form method="POST" action="/absence/submit" class="stack-form" id="absence-form" data-redirect-home="<%= result && result.redirectHome ? '1' : '' %>">
      <label for="type">Absence or Late</label>
      <select id="type" name="type" required>
        <option value="absence" <%= formValues.type === 'absence' ? 'selected' : '' %>>Absence &ndash; won't be there</option>
        <option value="late" <%= formValues.type === 'late' ? 'selected' : '' %>>Late &ndash; will arrive late</option>
      </select>

      <label for="parentId">Parent Name</label>
      <select id="parentId" name="parentId" required>
        <option value="">Select your name&hellip;</option>
        <% parents.forEach(function(p) { %>
          <option value="<%= p.id %>" <%= String(formValues.parentId) === String(p.id) ? 'selected' : '' %>><%= p.name %></option>
        <% }); %>
      </select>

      <label>Student(s)</label>
      <div id="absence-children-groups">
        <% parents.forEach(function(p) { %>
          <% var kids = childrenByParent[p.id] || []; %>
          <div class="absence-children-group" data-parent-id="<%= p.id %>" <%= String(formValues.parentId) === String(p.id) ? '' : 'hidden' %>>
            <% if (kids.length === 0) { %>
              <p class="hint">No students linked to this parent yet.</p>
            <% } else { %>
              <div class="checkbox-group">
                <% kids.forEach(function(k) { %>
                  <label class="checkbox-option">
                    <input type="checkbox" name="studentIds" value="<%= k.id %>" <%= formValues.studentIds.map(String).includes(String(k.id)) ? 'checked' : '' %> />
                    <%= k.name %>
                  </label>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
      <p id="student-required-msg" class="hint absence-required-msg" hidden>Please select at least one student.</p>

      <label for="sessionDate">Class Date</label>
      <input id="sessionDate" name="sessionDate" type="date" required value="<%= formValues.sessionDate %>" />

      <label for="reasonCategory">Reason</label>
      <select id="reasonCategory" name="reasonCategory" required>
        <option value="">Select a reason&hellip;</option>
        <option value="personal" <%= formValues.reasonCategory === 'personal' ? 'selected' : '' %>>Personal</option>
        <option value="medical" <%= formValues.reasonCategory === 'medical' ? 'selected' : '' %>>Medical</option>
      </select>

      <label for="reason">Description</label>
      <textarea id="reason" name="reason" rows="3" placeholder="Briefly explain the reason" required><%= formValues.reason %></textarea>

      <button type="submit" class="primary-btn">Submit</button>
    </form>
  </main>
  <script src="/js/absence.js"></script>
</body>
</html>
