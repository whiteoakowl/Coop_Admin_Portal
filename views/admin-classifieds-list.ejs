<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Communication' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/events', icon: 'calendar-check', label: 'Events' },
      { href: '/main-admin/directory', icon: 'map-pin', label: 'Business Directory' },
      { href: '/main-admin/classifieds', icon: 'tag', label: 'Classifieds' },
      { href: '/main-admin/member-directory', icon: 'users', label: 'Member Directory' },
      { href: '/main-admin/forums', icon: 'users', label: 'Chat' },
      { href: '/main-admin/forms', icon: 'clipboard-list', label: 'Custom Forms' },
      { href: '/main-admin/accounting', icon: 'file-text', label: 'Accounting' },
      { href: '/main-admin/store', icon: 'tag', label: 'Store' },
      { href: '/main-admin/newsletter', icon: 'mail', label: 'Newsletter' },
      { href: '/main-admin/notifications', icon: 'bell', label: 'Notifications' },
      { href: '/main-admin/photos', icon: 'image', label: 'Photos' },
      { href: '/main-admin/publications', icon: 'book', label: 'Publications' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1>Classifieds</h1>
      <% if (activeTab === 'categories') { %>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-category-dialog').showModal()">+ Add Category</button>
      <% } %>
    </div>
    <p class="hint">Members post their own listings for review here.</p>

    <%# A real request: "Only admin can add classifieds categories...
        Admin Classifieds gets tabs: Categories, Archive, Requests." %>
    <div class="view-tabs">
      <a href="/main-admin/classifieds?tab=categories" class="view-tab <%= activeTab === 'categories' ? 'active' : '' %>">Categories</a>
      <a href="/main-admin/classifieds?tab=requests" class="view-tab <%= activeTab === 'requests' ? 'active' : '' %>">Requests<% if (requests.length > 0 && activeTab !== 'requests') { %> <span class="badge-pill badge-pill-orange"><%= requests.length %></span><% } %></a>
      <a href="/main-admin/classifieds?tab=archive" class="view-tab <%= activeTab === 'archive' ? 'active' : '' %>">Archive</a>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (activeTab === 'categories') { %>
      <% if (groups.length === 0) { %>
        <p class="roster-empty">No active listings yet.</p>
      <% } %>
      <% groups.forEach(function(group) { %>
        <h2><%= group.categoryTitle %></h2>
        <div class="team-card-grid">
          <% group.listings.forEach(function(l) { %>
            <div class="team-col">
              <div class="team-info-card">
                <span class="team-info-icon"><svg class="icon"><use href="#icon-tag"/></svg></span>
                <h3 class="team-info-title"><a href="/main-admin/classifieds/<%= l.id %>/edit"><%= l.title %></a></h3>
                <span class="badge-pill badge-pill-green">Active</span>
                <p class="hint"><%= l.price || 'No price listed' %> &bull; <%= l.visibility === 'public' ? 'Public' : 'Members only' %></p>
                <div class="roster-btn-row">
                  <a class="roster-action-btn" href="/main-admin/classifieds/<%= l.id %>/edit">Edit</a>
                  <form method="POST" action="/main-admin/classifieds/<%= l.id %>/status" class="inline-block-form">
                    <input type="hidden" name="status" value="archived" />
                    <button type="submit" class="roster-action-btn roster-action-btn-danger">Archive</button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% }); %>
    <% } else if (activeTab === 'requests') { %>
      <% if (requests.length === 0) { %>
        <p class="roster-empty">No pending requests.</p>
      <% } else { %>
        <div class="team-card-grid">
          <% requests.forEach(function(l) { %>
            <div class="team-col">
              <div class="team-info-card">
                <span class="team-info-icon"><svg class="icon"><use href="#icon-tag"/></svg></span>
                <h3 class="team-info-title"><a href="/main-admin/classifieds/<%= l.id %>/edit"><%= l.title %></a></h3>
                <span class="badge-pill badge-pill-orange">Pending</span>
                <p class="hint"><%= l.categoryTitle || 'Uncategorized' %> &bull; <%= l.price || 'No price listed' %></p>
                <div class="roster-btn-row">
                  <form method="POST" action="/main-admin/classifieds/<%= l.id %>/status" class="inline-block-form">
                    <input type="hidden" name="status" value="active" />
                    <button type="submit" class="roster-action-btn">Approve</button>
                  </form>
                  <form method="POST" action="/main-admin/classifieds/<%= l.id %>/deny" class="inline-block-form" data-confirm="Deny this listing request? It will be removed.">
                    <button type="submit" class="roster-action-btn roster-action-btn-danger">Deny</button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } else { %>
      <% if (archived.length === 0) { %>
        <p class="roster-empty">Nothing archived.</p>
      <% } else { %>
        <div class="team-card-grid">
          <% archived.forEach(function(l) { %>
            <div class="team-col">
              <div class="team-info-card">
                <span class="team-info-icon"><svg class="icon"><use href="#icon-tag"/></svg></span>
                <h3 class="team-info-title"><a href="/main-admin/classifieds/<%= l.id %>/edit"><%= l.title %></a></h3>
                <span class="badge-pill badge-pill-gray"><%= l.status.charAt(0).toUpperCase() + l.status.slice(1) %></span>
                <p class="hint"><%= l.categoryTitle || 'Uncategorized' %></p>
                <div class="roster-btn-row">
                  <form method="POST" action="/main-admin/classifieds/<%= l.id %>/status" class="inline-block-form">
                    <input type="hidden" name="status" value="active" />
                    <button type="submit" class="roster-action-btn">Restore</button>
                  </form>
                  <form method="POST" action="/main-admin/classifieds/<%= l.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= l.title %>&quot;? This cannot be undone.">
                    <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } %>
  </main>

  <dialog id="add-category-dialog" class="member-picker-dialog">
    <form method="POST" action="/main-admin/classifieds/categories">
      <h3>Add Category</h3>
      <label for="add-classifieds-category-title">Category Name
        <input id="add-classifieds-category-title" type="text" name="title" placeholder="e.g. Books, Sports Equipment" required />
      </label>
      <% if (categories.length > 0) { %>
        <p class="hint">Existing categories</p>
        <div class="grade-pill-grid">
          <% categories.forEach(function(c) { %>
            <form method="POST" action="/main-admin/classifieds/categories/<%= c.id %>/delete" class="inline-block-form" data-confirm="Delete the &quot;<%= c.title %>&quot; category? Its listings stay, just uncategorized.">
              <span class="badge-pill">
                <%= c.title %>
                <button type="submit" class="badge-pill-x" aria-label="Delete <%= c.title %>" title="Delete">&times;</button>
              </span>
            </form>
          <% }); %>
        </div>
      <% } %>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
        <button type="submit" class="primary-btn">Save</button>
      </div>
    </form>
  </dialog>
</body>
</html>
