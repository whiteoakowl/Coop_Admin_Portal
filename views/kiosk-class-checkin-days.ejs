<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="form-wrap">
    <div class="kiosk-inline-header">
      <a href="/kiosk" class="kiosk-home kiosk-home-inline">&larr; Home</a>
      <form method="POST" action="/kiosk/class-checkin/lock" data-preserve-fullscreen>
        <button type="submit" class="btn-secondary">Done</button>
      </form>
    </div>
    <h1>Class Check-In</h1>
    <p class="subtitle">Choose a day to see its class rosters.</p>

    <%# A real request: "Full 7 day expansion..." - these cards used to be
        a hardcoded Monday/Wednesday pair; days is every day activated on
        Settings > Day Settings. %>
    <div class="landing-grid landing-grid-two">
      <% days.forEach(function(d) { %>
        <a class="landing-card landing-card-purple" href="/kiosk/class-checkin/classes/<%= d.value %>">
          <span class="landing-icon"><svg class="icon"><use href="#icon-clipboard-list"/></svg></span>
          <span class="landing-label"><%= d.label %></span>
        </a>
      <% }); %>
    </div>
  </main>
  <script src="/js/fullscreen-nav.js"></script>
</body>
</html>
