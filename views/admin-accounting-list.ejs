<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Accounts</h1>
    <p class="hint">Every active member below, charge history or not. Search Member to add a first charge for someone new.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <%# A real request: "accounts page... +invoice/+payment/+adjustment
        buttons." +Invoice creates a charge for any member directly from
        here (same POST /invoices the Invoices subpage's own dialog
        uses); +Payment/+Adjustment both just jump to that member's own
        Account page below, where Record Payment (direction: payment or
        refund) already works per-charge - one shared "which member?"
        dialog for both rather than two, since they lead to the exact
        same place. %>
    <div class="roster-btn-row accounting-list-toolbar no-print">
      <button type="button" class="roster-action-btn" onclick="document.getElementById('goto-invoice-dialog').showModal()">+ Invoice</button>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('goto-member-dialog').showModal()">+ Payment</button>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('goto-member-dialog').showModal()">+ Adjustment</button>
    </div>

    <%# A real request: "print and export icons should be to the left and
        on the same row next to each other" - moved ahead of the Email
        buttons row below. %>
    <div class="roster-btn-row accounting-accounts-toolbar-3 no-print" data-fixed-columns="2">
      <button type="button" class="icon-btn" onclick="window.print()" aria-label="Print Preview" title="Print Preview"><svg class="icon"><use href="#icon-printer"/></svg></button>
      <a class="icon-btn" href="/main-admin/accounting/export.csv?q=<%= encodeURIComponent(q) %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
    </div>

    <%# A real request: "past due check box should be a button that says
        email all past due invoices. Email all invoices button will send
        all. These two buttons should shrink to fit side by side on one
        row." Replaces the old Past Due Only filter checkbox (which just
        narrowed the table) with a real action button of its own, side by
        side with Email All Invoices (now a genuine "everyone", not the
        same past-due-only list under a misleading name). %>
    <div class="roster-btn-row accounting-accounts-toolbar-2 no-print roster-btn-row-fit-text" data-fixed-columns="2">
      <form method="POST" action="/main-admin/accounting/email-all-past-due-invoices" class="inline-block-form" data-confirm="Send a balance-due reminder to every member who currently owes something?">
        <button type="submit" class="roster-action-btn roster-action-btn-fit">Email All Past Due Invoices</button>
      </form>
      <form method="POST" action="/main-admin/accounting/email-all-invoices" class="inline-block-form" data-confirm="Send an accounting statement to every member with billing on record?">
        <button type="submit" class="roster-action-btn roster-action-btn-fit">Email All Invoices</button>
      </form>
    </div>

    <%# A real request: "search bar should be just above the member
        table" + "go button should be in the search bar, attached." %>
    <div class="members-search-filter-row no-print">
      <form method="GET" action="/main-admin/accounting" class="members-search-bar accounting-search-attached">
        <svg class="icon"><use href="#icon-search"/></svg>
        <input type="search" name="q" value="<%= q %>" placeholder="Search member&hellip;" aria-label="Search member" />
        <button type="submit" class="members-search-go-btn">Go</button>
      </form>
    </div>

    <% if (members.length === 0) { %>
      <p class="roster-empty"><%= q ? 'No active members match that search.' : 'No active members yet.' %></p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table accounting-table-mobile-fit accounting-accounts-table-fit">
          <thead>
            <tr>
              <th>Member</th>
              <th></th>
              <th>Balance</th>
              <th>Past Due</th>
            </tr>
          </thead>
          <tbody>
            <% members.forEach(function(m) { %>
              <tr>
                <%# A real request: "when you click on each member name it
                    shows the full membership profile just like other
                    pages, exactly. When you click the invoice icon it
                    goes to that members full account page." %>
                <td class="roster-name-col">
                  <a href="/main-admin/members/<%= m.id %>"><%= m.name %></a>
                  <% if (m.parked) { %> <span class="badge-pill badge-pill-gray" title="Auto-parked: an auto-park invoice is overdue and unpaid">Parked</span><% } %>
                </td>
                <td class="roster-btn-row accounting-row-icons">
                  <a class="icon-btn" href="/main-admin/accounting/members/<%= m.id %>?autoprint=1" aria-label="Print statement for <%= m.name %>" title="Print statement"><svg class="icon"><use href="#icon-printer"/></svg></a>
                  <% if (m.email) { %>
                    <a class="icon-btn" href="mailto:<%= m.email %>" aria-label="Email <%= m.name %>" title="Email <%= m.name %>"><svg class="icon"><use href="#icon-mail"/></svg></a>
                  <% } else { %>
                    <span class="icon-btn icon-btn-disabled" aria-hidden="true" title="No email on file"><svg class="icon"><use href="#icon-mail"/></svg></span>
                  <% } %>
                  <a class="icon-btn" href="/main-admin/accounting/members/<%= m.id %>" aria-label="View account for <%= m.name %>" title="View account"><svg class="icon"><use href="#icon-file-text"/></svg></a>
                </td>
                <td><span class="badge-pill badge-pill-<%= m.balanceCents > 0 ? 'orange' : 'green' %>"><%= formatCents(m.balanceCents) %></span></td>
                <td><% if (m.balanceCents > 0) { %><span class="badge-pill badge-pill-orange">Past Due</span><% } else { %>&mdash;<% } %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <dialog id="goto-invoice-dialog" class="member-picker-dialog">
      <form method="GET" onsubmit="event.preventDefault(); var id = this.memberId.value; if (id) window.location = '/main-admin/accounting/invoices/new?memberId=' + id;">
        <h3>Which Member?</h3>
        <p class="hint">Opens a new invoice for that member's own account.</p>
        <label>Member
          <select name="memberId" required>
            <option value="">Select a member&hellip;</option>
            <% allMembers.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Continue</button>
        </div>
      </form>
    </dialog>

    <dialog id="goto-member-dialog" class="member-picker-dialog">
      <form method="GET" onsubmit="event.preventDefault(); var id = this.memberId.value; if (id) window.location = '/main-admin/accounting/members/' + id;">
        <h3>Which Member?</h3>
        <p class="hint">Opens that member's own Account page, where Record Payment covers both a payment received and a refund/adjustment.</p>
        <label>Member
          <select name="memberId" required>
            <option value="">Select a member&hellip;</option>
            <% allMembers.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Continue</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
