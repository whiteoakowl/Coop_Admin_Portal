<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Accounting</h1>
    <p class="hint">Members with any charge history below. To add a first charge for someone new, find them here.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <%# A real request: "add/edit account category button should not be
        [on Events Settings]. That should only be under the accounting
        tab." Moved here from views/admin-events-list.ejs - same list
        (event_accounting_categories) the Events Finance tab's own
        dropdown still reads from. %>
    <div class="roster-btn-row no-print">
      <button type="button" class="roster-action-btn" onclick="document.getElementById('manage-accounting-categories-dialog').showModal()">Add/Edit Accounting Category</button>
    </div>

    <form method="GET" onsubmit="event.preventDefault(); var id = this.memberId.value; if (id) window.location = '/main-admin/accounting/members/' + id;" class="roster-btn-row" style="margin-bottom: 1rem;">
      <select name="memberId">
        <option value="">Find a member&hellip;</option>
        <% allMembers.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
      </select>
      <button type="submit" class="roster-action-btn">Go</button>
    </form>

    <% if (members.length === 0) { %>
      <p class="roster-empty">No charges recorded yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>Member</th>
              <th>Balance</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% members.forEach(function(m) { %>
              <tr>
                <td class="roster-name-col"><%= m.name %></td>
                <td><span class="badge-pill badge-pill-<%= m.balanceCents > 0 ? 'orange' : 'green' %>"><%= formatCents(m.balanceCents) %></span></td>
                <td><a href="/main-admin/accounting/members/<%= m.id %>">View</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <dialog id="manage-accounting-categories-dialog" class="member-picker-dialog">
      <h3>Accounting Categories</h3>
      <p class="hint">A fixed list an event's Finance tab picks one of, for internal bookkeeping.</p>
      <form method="POST" action="/main-admin/accounting/accounting-categories" class="stack-form">
        <div class="member-form-grid">
          <label>Category Name
            <input type="text" name="name" placeholder="e.g. Fundraising Revenue" required />
          </label>
        </div>
        <div class="member-form-footer">
          <div class="member-form-footer-edit">
            <button type="submit" class="primary-btn">+ Add Accounting Category</button>
          </div>
        </div>
      </form>

      <% if (accountingCategories.length === 0) { %>
        <p class="roster-empty">No accounting categories yet - add one above.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table">
            <thead><tr><th>Category</th><th></th></tr></thead>
            <tbody>
              <% accountingCategories.forEach(function(c) { %>
                <tr>
                  <td>
                    <form method="POST" action="/main-admin/accounting/accounting-categories/<%= c.id %>/update" class="inline-block-form">
                      <input type="text" name="name" value="<%= c.name %>" onchange="this.form.submit()" aria-label="Name for <%= c.name %>" />
                    </form>
                  </td>
                  <td>
                    <form method="POST" action="/main-admin/accounting/accounting-categories/<%= c.id %>/delete" class="inline-block-form" data-confirm="Delete this accounting category? Events using it will just show no category.">
                      <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
      </div>
    </dialog>
  </main>
</body>
</html>
