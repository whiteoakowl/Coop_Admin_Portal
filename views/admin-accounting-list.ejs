<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Accounts</h1>
    <p class="hint">Members with any charge history below. Search Member to add a first charge for someone new.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <%# A real request: "accounts page... +invoice/+payment/+adjustment
        buttons." +Invoice creates a charge for any member directly from
        here (same POST /invoices the Invoices subpage's own dialog
        uses); +Payment/+Adjustment both just jump to that member's own
        Account page below, where Record Payment (direction: payment or
        refund) already works per-charge - one shared "which member?"
        dialog for both rather than two, since they lead to the exact
        same place. %>
    <div class="roster-btn-row accounting-list-toolbar no-print">
      <button type="button" class="roster-action-btn" onclick="document.getElementById('new-invoice-dialog').showModal()">+ Invoice</button>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('goto-member-dialog').showModal()">+ Payment</button>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('goto-member-dialog').showModal()">+ Adjustment</button>
    </div>

    <div class="members-search-filter-row no-print">
      <form method="GET" action="/main-admin/accounting" class="members-search-bar">
        <svg class="icon"><use href="#icon-search"/></svg>
        <input type="search" name="q" value="<%= q %>" placeholder="Search member&hellip;" aria-label="Search member" />
        <button type="submit" class="members-search-go-btn">Go</button>
      </form>
    </div>

    <%# A real request: "2nd button row, filters, email all invoices,
        print preview icon, export icon." Filter here just narrows the
        table to members who currently owe something - a status filter
        (paid/pending/etc.) belongs to the Invoices subpage instead,
        where "status" actually means something (a charge's own status),
        not a member's. %>
    <div class="roster-btn-row accounting-accounts-toolbar-2 no-print">
      <form method="GET" class="inline-block-form">
        <input type="hidden" name="q" value="<%= q %>" />
        <label class="checkbox-option">
          <input type="checkbox" name="pastDueOnly" value="1" <%= pastDueOnly ? 'checked' : '' %> onchange="this.form.submit()" /> Past Due Only
        </label>
      </form>
      <form method="POST" action="/main-admin/accounting/email-all-invoices" class="inline-block-form" data-confirm="Send a balance-due reminder to every member who currently owes something?">
        <button type="submit" class="roster-action-btn">Email All Invoices</button>
      </form>
      <button type="button" class="icon-btn" onclick="window.print()" aria-label="Print Preview" title="Print Preview"><svg class="icon"><use href="#icon-printer"/></svg></button>
      <a class="icon-btn" href="/main-admin/accounting/export.csv?q=<%= encodeURIComponent(q) %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
    </div>

    <% const visibleMembers = pastDueOnly ? members.filter((m) => m.balanceCents > 0) : members; %>
    <% if (visibleMembers.length === 0) { %>
      <p class="roster-empty"><%= q ? 'No active members match that search.' : 'No charges recorded yet.' %></p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>Member</th>
              <th>Balance</th>
              <th>Past Due</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% visibleMembers.forEach(function(m) { %>
              <tr>
                <td class="roster-name-col"><a href="/main-admin/accounting/members/<%= m.id %>"><%= m.name %></a></td>
                <td><span class="badge-pill badge-pill-<%= m.balanceCents > 0 ? 'orange' : 'green' %>"><%= formatCents(m.balanceCents) %></span></td>
                <td><% if (m.balanceCents > 0) { %><span class="badge-pill badge-pill-orange">Past Due</span><% } else { %>&mdash;<% } %></td>
                <td class="roster-btn-row">
                  <a class="icon-btn" href="/main-admin/accounting/members/<%= m.id %>?autoprint=1" aria-label="Print statement for <%= m.name %>" title="Print statement"><svg class="icon"><use href="#icon-printer"/></svg></a>
                  <% if (m.email) { %>
                    <a class="icon-btn" href="mailto:<%= m.email %>" aria-label="Email <%= m.name %>" title="Email <%= m.name %>"><svg class="icon"><use href="#icon-mail"/></svg></a>
                  <% } else { %>
                    <span class="icon-btn icon-btn-disabled" aria-hidden="true" title="No email on file"><svg class="icon"><use href="#icon-mail"/></svg></span>
                  <% } %>
                  <a class="icon-btn" href="/main-admin/accounting/invoices?memberId=<%= m.id %>" aria-label="View invoices for <%= m.name %>" title="View invoices"><svg class="icon"><use href="#icon-file-text"/></svg></a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <dialog id="new-invoice-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/accounting/invoices">
        <h3>New Invoice</h3>
        <label>Member
          <select name="memberId" required>
            <option value="">Select a member&hellip;</option>
            <% allMembers.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
          </select>
        </label>
        <label>Description
          <input type="text" name="description" placeholder="e.g. Registration Fee" required />
        </label>
        <label>Amount ($)
          <input type="number" name="amount" min="0.01" step="0.01" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="goto-member-dialog" class="member-picker-dialog">
      <form method="GET" onsubmit="event.preventDefault(); var id = this.memberId.value; if (id) window.location = '/main-admin/accounting/members/' + id;">
        <h3>Which Member?</h3>
        <p class="hint">Opens that member's own Account page, where Record Payment covers both a payment received and a refund/adjustment.</p>
        <label>Member
          <select name="memberId" required>
            <option value="">Select a member&hellip;</option>
            <% allMembers.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Continue</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
