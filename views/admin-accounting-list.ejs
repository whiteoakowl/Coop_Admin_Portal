<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/users', icon: 'user-check', label: 'Users' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Announcements' },
      { href: '/main-admin/sections', icon: 'grid', label: 'Sections' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/roles', icon: 'sliders', label: 'Roles & Permissions' },
      { href: '/main-admin/website', icon: 'palette', label: 'Website' },
      { href: '/main-admin/events', icon: 'calendar-check', label: 'Events' },
      { href: '/main-admin/directory', icon: 'map-pin', label: 'Business Directory' },
      { href: '/main-admin/classifieds', icon: 'tag', label: 'Classifieds' },
      { href: '/main-admin/member-directory', icon: 'users', label: 'Member Directory' },
      { href: '/main-admin/forums', icon: 'users', label: 'Forums' },
      { href: '/main-admin/forms', icon: 'clipboard-list', label: 'Custom Forms' },
      { href: '/main-admin/accounting', icon: 'file-text', label: 'Accounting' },
      { href: '/main-admin/store', icon: 'tag', label: 'Store' },
      { href: '/main-admin/newsletter', icon: 'mail', label: 'Newsletter' },
      { href: '/main-admin/notifications', icon: 'bell', label: 'Notifications' },
      { href: '/main-admin/photos', icon: 'image', label: 'Photos' },
      { href: '/main-admin/publications', icon: 'book', label: 'Publications' },
      { href: '/main-admin/audit-log', icon: 'file-text', label: 'Audit Log' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Accounting</h1>
    <p class="hint">Members with any charge history below. To add a first charge for someone new, find them here.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <form method="GET" onsubmit="event.preventDefault(); var id = this.memberId.value; if (id) window.location = '/main-admin/accounting/members/' + id;" class="roster-btn-row" style="margin-bottom: 1rem;">
      <select name="memberId">
        <option value="">Find a member&hellip;</option>
        <% allMembers.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
      </select>
      <button type="submit" class="roster-action-btn">Go</button>
    </form>

    <% if (members.length === 0) { %>
      <p class="roster-empty">No charges recorded yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>Member</th>
              <th>Balance</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% members.forEach(function(m) { %>
              <tr>
                <td class="roster-name-col"><%= m.name %></td>
                <td><span class="badge-pill badge-pill-<%= m.balanceCents > 0 ? 'orange' : 'green' %>"><%= formatCents(m.balanceCents) %></span></td>
                <td><a href="/main-admin/accounting/members/<%= m.id %>">View</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
