<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Transcripts</h1>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (transcripts.length === 0) { %>
      <p class="roster-empty">No students are linked to your family yet. Contact an admin if this looks wrong.</p>
    <% } %>

    <%# A real request: "On transcripts you can create and print a
        transcript for each student. You can add classes from co-op
        classes or family management classes or manually add an
        entirely new class. Then calculate the GPA per school year and
        for the entire 4 years. Print full page view of transcript." A
        later real request: "add class button, print should be an icon
        and pdf icons should all be on the same row." %>
    <%# The per-student builder itself (manage-section + Add Class
        dialog) is shared with Main Admin's own Transcripts page (any
        student, not just one's own children) - see views/partials/
        transcript-student-builder.ejs. %>
    <% transcripts.forEach(function(rec) { %>
      <%- include('partials/transcript-student-builder', { rec, semesters, yearOptions, currentSchoolYearValue, gradeLetters, basePath: '/parent/academics' }) %>
    <% }); %>
  </main>
  <script src="/js/transcript-add-class.js"></script>
</body>
</html>
