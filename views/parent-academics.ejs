<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Parent Portal',
    navLinks: [
      { href: '/parent', icon: 'home', label: 'Home' },
      { href: '/parent/classes', icon: 'graduation-cap', label: 'Classes' },
      { href: '/parent/library', icon: 'book', label: 'Library' },
      { href: '/parent/academics', icon: 'clipboard-list', label: 'Academics' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Academics</h1>

    <% if (academics.length === 0) { %>
      <p class="roster-empty">No students are linked to your family yet. Contact an admin if this looks wrong.</p>
    <% } %>

    <% academics.forEach(function(rec) { %>
      <section class="portal-dashboard-section">
        <h2><%= rec.child.name %></h2>

        <h3>Assignments</h3>
        <% if (rec.assignments.length === 0) { %>
          <p class="roster-empty">No assignments yet.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table">
              <thead><tr><th>Assignment</th><th>Class</th><th>Due</th><th>Grade</th></tr></thead>
              <tbody>
                <% rec.assignments.forEach(function(a) { %>
                  <tr>
                    <td class="roster-name-col"><%= a.title %></td>
                    <td><%= a.class_name %></td>
                    <td><%= a.dueDateLabel || '—' %></td>
                    <td>
                      <% if (!a.graded) { %>
                        <span class="hint">Not graded yet</span>
                      <% } else { %>
                        <%= a.points_earned %><% if (a.points_possible != null) { %> / <%= a.points_possible %><% } %>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>

        <h3>Transcript</h3>
        <% if (rec.current.length === 0 && rec.history.length === 0) { %>
          <p class="roster-empty">No classes on record yet.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table">
              <thead><tr><th>Class</th><th>Status</th></tr></thead>
              <tbody>
                <% rec.current.forEach(function(c) { %>
                  <tr><td class="roster-name-col"><%= c.class_name %></td><td><span class="badge-pill">Current</span></td></tr>
                <% }); %>
                <% rec.history.forEach(function(h) { %>
                  <tr><td class="roster-name-col"><%= h.class_name %></td><td>Completed <%= h.termEndedLabel %></td></tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>

        <h3>Diploma</h3>
        <% if (!rec.diploma) { %>
          <p class="roster-empty">No diploma issued yet.</p>
        <% } else { %>
          <p><%= rec.diploma.title %> &middot; issued <%= rec.diploma.issued_date %></p>
        <% } %>
      </section>
    <% }); %>
  </main>
</body>
</html>
