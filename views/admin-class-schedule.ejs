<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= dayLabel %> Class Schedule</p>
      </div>
    </div>

    <h1>Class Schedule</h1>

    <div class="roster-toolbar no-print">
      <div class="filter-row">
        <div class="category-filter">
          <label for="day-select">Day</label>
          <select id="day-select" onchange="window.location = '/admin/class-schedule/' + this.value">
            <option value="monday" <%= day === 'monday' ? 'selected' : '' %>>Monday</option>
            <option value="wednesday" <%= day === 'wednesday' ? 'selected' : '' %>>Wednesday</option>
          </select>
        </div>
      </div>
    </div>

    <%- include('partials/class-schedule-grid', { day, dayLabel, error, notice, selectedDate, hours, roomGrid, rooms, gradeLevels, availableStaff, absentIds, readOnly: !isFullAdmin }) %>
  </main>
</body>
</html>
