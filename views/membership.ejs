<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="form-wrap">
    <a href="/" class="kiosk-home"><svg class="icon"><use href="#icon-home"/></svg> Return to Home</a>
    <div class="kiosk-header">
      <img class="form-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <h1>Membership Form</h1>
    </div>
    <p class="subtitle">Please complete the membership form below to request membership.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <form method="POST" action="/membership" enctype="multipart/form-data" id="membership-form" class="form-outer-panel">
      <div class="form-section">
        <h2>Parent / Guardian #1</h2>
        <div class="member-form-grid">
          <label>First Name
            <input type="text" name="parent1FirstName" required />
          </label>
          <label>Last Name
            <input type="text" name="parent1LastName" required />
          </label>
          <label class="member-form-full">Email
            <input type="email" name="parent1Email" required />
          </label>
          <label class="member-form-full">Phone Number
            <input type="tel" name="parent1Phone" />
          </label>
          <label class="member-form-full">Address
            <input type="text" name="address" />
          </label>
          <label>City
            <input type="text" name="city" />
          </label>
          <label>State
            <input type="text" name="state" value="North Carolina" />
          </label>
          <label class="member-form-full">Zipcode
            <input type="text" name="zipcode" />
          </label>
        </div>
        <label class="checkbox-option membership-add-parent2">
          <input type="checkbox" id="add-parent2-checkbox" />
          Add 2nd Parent / Guardian
        </label>
      </div>

      <div class="form-section" id="parent2-section" hidden>
        <h2>Parent / Guardian #2</h2>
        <div class="member-form-grid">
          <label>First Name
            <input type="text" name="parent2FirstName" />
          </label>
          <label>Last Name
            <input type="text" name="parent2LastName" />
          </label>
          <label class="member-form-full">Email
            <input type="email" name="parent2Email" />
          </label>
          <label class="member-form-full">Phone Number
            <input type="tel" name="parent2Phone" />
          </label>
        </div>
      </div>

      <div class="form-section">
        <h2>Children</h2>
        <div id="membership-children">
          <%- include('partials/membership-child-fields', { index: 0, gradeOptions }) %>
        </div>
        <button type="button" class="btn-secondary" id="add-child-btn">+ Add Child</button>
      </div>

      <div class="form-section">
        <h2>Volunteer Opportunities</h2>
        <p class="hint">Please select any volunteer opportunities you would be interested in helping with.</p>
        <div class="membership-volunteer-grid">
          <% volunteerOptions.forEach(function(opt) { %>
            <label class="checkbox-option">
              <input type="checkbox" name="volunteerInterests" value="<%= opt %>" />
              <%= opt %>
            </label>
          <% }); %>
        </div>
      </div>

      <button type="submit" class="primary-btn membership-submit-btn">Submit Membership Form</button>
    </form>
  </main>

  <template id="membership-child-template">
    <%- include('partials/membership-child-fields', { index: '__INDEX__', gradeOptions }) %>
  </template>

  <script src="/js/membership-form.js"></script>
</body>
</html>
