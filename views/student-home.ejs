<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Welcome, <%= member.name %></h1>

    <section class="portal-dashboard-section">
      <h2>Word of the Week</h2>
      <div class="word-of-week-grid">
        <div class="word-of-week-card">
          <span class="word-of-week-level">Elementary</span>
          <strong class="word-of-week-word"><%= words.elementary.word %></strong>
          <p class="hint"><%= words.elementary.definition %></p>
        </div>
        <div class="word-of-week-card">
          <span class="word-of-week-level">Middle School</span>
          <strong class="word-of-week-word"><%= words.middle.word %></strong>
          <p class="hint"><%= words.middle.definition %></p>
        </div>
        <div class="word-of-week-card">
          <span class="word-of-week-level">High School</span>
          <strong class="word-of-week-word"><%= words.high.word %></strong>
          <p class="hint"><%= words.high.definition %></p>
        </div>
      </div>
    </section>

    <section class="portal-dashboard-section">
      <h2>Announcements</h2>
      <% if (announcements.length === 0) { %>
        <p class="roster-empty">No announcements right now.</p>
      <% } else { %>
        <div class="site-announcement-list">
          <% announcements.forEach(function(a) { %>
            <div class="site-announcement-card">
              <span class="site-announcement-date">
                <%= a.dateLabel %>
                <% if (a.isNew) { %><span class="badge-pill badge-pill-present">New</span><% } %>
              </span>
              <h3><%= a.title %></h3>
              <div class="forum-editable-display"><%- a.body %></div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>

    <div class="portal-dashboard-grid">
      <section class="portal-dashboard-card">
        <h2>My Classes</h2>
        <p class="portal-dashboard-stat"><%= classes.length %></p>
        <p class="hint">class<%= classes.length === 1 ? '' : 'es' %> this term</p>
        <a class="roster-action-btn" href="/student/classes">View My Classes</a>
      </section>

      <section class="portal-dashboard-card portal-dashboard-card-wide">
        <h2>Nature News</h2>
        <% if (!natureNewsLatest.length) { %>
          <p class="hint">No approved discoveries yet - be the first to share one!</p>
        <% } else { %>
          <div class="nature-news-grid">
            <% natureNewsLatest.forEach((post) => { %>
              <div class="nature-news-card">
                <img src="/nature-news/<%= post.id %>/image" alt="" class="nature-news-card-img" />
                <div class="nature-news-card-body">
                  <strong><%= post.member_name %></strong>
                  <p><%= post.description %></p>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
        <a class="roster-action-btn" href="/student/nature-news">Share a Discovery</a>
      </section>
    </div>
  </main>
</body>
</html>
