<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= cls.class_name %> Roster</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub"><%= dayLabel %> &mdash; <%= cls.class_name %> Roster</p>
        </div>
      </div>

      <h2><%= cls.class_name %></h2>
      <p class="hint">
        <%= dayLabel %><% if (cls.room) { %> &middot; Room <%= cls.room %><% } %><% if (cls.start_time) { %> &middot; <%= cls.start_time %><% if (cls.end_time) { %>&ndash;<%= cls.end_time %><% } %><% } %>
      </p>

      <h3>Teachers &amp; Assistants</h3>
      <table class="roster-table">
        <thead><tr><th>Name</th><th>Role</th></tr></thead>
        <tbody>
          <% if (cls.staff.length === 0) { %>
            <tr><td colspan="2" class="roster-empty">No teachers/assistants yet.</td></tr>
          <% } %>
          <% cls.staff.forEach(function(s) { %>
            <tr><td><%= s.name %></td><td><%= s.role === 'assistant' ? 'Assistant' : 'Teacher' %></td></tr>
          <% }); %>
        </tbody>
      </table>

      <h3>Student Roster</h3>
      <table class="roster-table">
        <thead><tr><th>Name</th><th>Family</th><th>Age</th><th>Grade</th><th>Birthday</th></tr></thead>
        <tbody>
          <% if (cls.students.length === 0) { %>
            <tr><td colspan="5" class="roster-empty">No students enrolled yet.</td></tr>
          <% } %>
          <% cls.students.forEach(function(s) { %>
            <tr>
              <td><%= s.name %></td>
              <td><%= s.family_name || '—' %></td>
              <td><%= s.age !== null && s.age !== undefined ? s.age : '—' %></td>
              <td><%= s.grade_level || '—' %></td>
              <td><%= s.birthday || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
