<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main parent-home-main">
    <h1>Welcome, <%= member.name %></h1>

    <section class="portal-dashboard-section">
      <h2>Announcements</h2>
      <% if (announcements.length === 0) { %>
        <p class="roster-empty">No announcements right now.</p>
      <% } else { %>
        <div class="site-announcement-list">
          <% announcements.forEach(function(a) { %>
            <div class="site-announcement-card">
              <span class="site-announcement-date">
                <%= a.dateLabel %>
                <% if (a.isNew) { %><span class="badge-pill badge-pill-present">New</span><% } %>
              </span>
              <h3><%= a.title %></h3>
              <div class="forum-editable-display"><%- a.body %></div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>

    <div class="portal-dashboard-grid">
      <%# A real request: "Take off the my family card and replace it with
          upcoming events from the event calendar." %>
      <section class="portal-dashboard-card">
        <h2>Upcoming Events</h2>
        <% if (upcomingEvents.length === 0) { %>
          <p class="roster-empty">No upcoming events right now.</p>
        <% } else { %>
          <ul class="portal-dashboard-list">
            <% upcomingEvents.forEach(function(e) { %>
              <li><%= e.title %> <span class="hint">&middot; <%= e.startsLabel %></span></li>
            <% }); %>
          </ul>
        <% } %>
        <a class="roster-action-btn" href="/events">View Event Calendar</a>
      </section>

      <section class="portal-dashboard-card">
        <h2>Class Registrations</h2>
        <%# A real request: "should show how many classes your family is
            registered for by person in your family" - per-child counts
            instead of one ambiguous family-wide total. %>
        <% if (registrationCountsByChild.length === 0) { %>
          <p class="hint">No students linked to your family yet.</p>
        <% } else { %>
          <ul class="portal-dashboard-list">
            <% registrationCountsByChild.forEach(function(c) { %>
              <li><%= c.name %>: <span class="badge-pill badge-pill-blue"><%= c.count %> class<%= c.count === 1 ? '' : 'es' %></span></li>
            <% }); %>
          </ul>
        <% } %>
        <a class="roster-action-btn" href="/parent/classes/dashboard">Classroom Dashboard</a>
      </section>

      <section class="portal-dashboard-card">
        <h2>Quick Links</h2>
        <ul class="portal-dashboard-list">
          <li><a href="/name-tag">Name Tag Form</a></li>
          <li><a href="/absence">Absence/Late Form</a></li>
        </ul>
      </section>

      <%# A real request: "add a button on the parent portal homepage for
          committee sign up." Its own card (matching Quick Links' own
          card treatment) rather than a 3rd Quick Links list item - a
          real signup action, not just a link to a form. %>
      <section class="portal-dashboard-card">
        <h2>Committees</h2>
        <p class="hint">Signup for a Committee and help us create fun events for the group!</p>
        <a class="roster-action-btn" href="/committees">Committee Sign Up</a>
      </section>

      <%# A real request: "should have a card showing the rankings for
          Parent reading challenge" - same leaderboard /parent/leaderboard
          already renders, scoped to parents. %>
      <section class="portal-dashboard-card">
        <h2>Parent Reading Challenge</h2>
        <% if (readingLeaders.length === 0) { %>
          <p class="roster-empty">No reading hours logged yet.</p>
        <% } else { %>
          <ul class="portal-dashboard-list">
            <% readingLeaders.forEach(function(l) { %>
              <li>#<%= l.rank %> <%= l.name %> <span class="hint">&middot; <%= l.hours %> hrs</span></li>
            <% }); %>
          </ul>
        <% } %>
        <a class="roster-action-btn" href="/parent/leaderboard">View Reading Challenge</a>
      </section>

      <%# A real request: "a card showing business directory listing." %>
      <section class="portal-dashboard-card">
        <h2>Business Directory</h2>
        <% if (businessDirectoryListings.length === 0) { %>
          <p class="roster-empty">No business listings yet.</p>
        <% } else { %>
          <ul class="portal-dashboard-list">
            <% businessDirectoryListings.forEach(function(l) { %>
              <li><%= l.business_name %></li>
            <% }); %>
          </ul>
        <% } %>
        <a class="roster-action-btn" href="/directory">View Business Directory</a>
      </section>

      <%# A real request: "a card showing classifieds listings." %>
      <section class="portal-dashboard-card">
        <h2>Classifieds</h2>
        <% if (classifiedsListings.length === 0) { %>
          <p class="roster-empty">No classifieds listings yet.</p>
        <% } else { %>
          <ul class="portal-dashboard-list">
            <% classifiedsListings.forEach(function(l) { %>
              <li><%= l.title %></li>
            <% }); %>
          </ul>
        <% } %>
        <a class="roster-action-btn" href="/classifieds">View Classifieds</a>
      </section>
    </div>
  </main>
</body>
</html>
