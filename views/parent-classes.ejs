<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Class Registration</h1>
    <p class="hint">Tap a class below for details, seats, and to register your children. A class shown here isn't
      necessarily open for registration yet - it's still worth seeing what's scheduled.</p>

    <%# A real request: "Add a button at the top that says, classes
        needing a teacher or assistant" - a standing recruiting list
        (views/parent-classes-needing-staff.ejs), separate from this
        grid's own per-class popups, for a parent who just wants to see
        where help is still needed without opening every class one at a
        time. %>
    <div class="roster-btn-row no-print">
      <a class="roster-action-btn" href="/parent/classes/needing-staff?day=<%= day %>">Classes Needing a Teacher or Assistant</a>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (!hasChildren) { %>
      <p class="roster-empty">No students are linked to your family yet, so there's no one to register. Contact an admin if this looks wrong.</p>
    <% } else if (!windowOpen) { %>
      <div class="alert alert-info">
        Registration isn't open for your account yet<% if (nextWindowLabel) { %> - it opens <%= nextWindowLabel %><% } %>.
        You can still open a class below to see or cancel a registration you already have.
      </div>
    <% } %>

    <div class="filter-row no-print">
      <%# A real request: "add icons at the top for grid view vs list
          view of classes like co-op class portal." %>
      <div class="class-schedule-view-toggle" role="group" aria-label="Grid or list view">
        <a class="icon-btn<%= view === 'grid' ? ' icon-btn-active' : '' %>" href="/parent/classes?day=<%= day %>&view=grid" aria-pressed="<%= view === 'grid' %>" aria-label="Grid view" title="Grid view"><svg class="icon"><use href="#icon-grid"/></svg></a>
        <a class="icon-btn<%= view === 'list' ? ' icon-btn-active' : '' %>" href="/parent/classes?day=<%= day %>&view=list" aria-pressed="<%= view === 'list' %>" aria-label="List view" title="List view"><svg class="icon"><use href="#icon-clipboard-list"/></svg></a>
      </div>
      <div class="day-toggle schedule-day-toggle">
        <% activeDays.forEach(function (d) { %>
          <a class="day-toggle-option<%= day === d ? ' active' : '' %>" href="/parent/classes?day=<%= d %>&view=<%= view %>"><%= dayLabels[d] %></a>
        <% }); %>
      </div>
      <%# A real request: "Parents can filter classes by grade level and
          by their own students, drop down menu. If filtering by their
          student it will only show classes that matching their grade
          level." Picking a student locks the Grade Level select to that
          student's own grade_level (public/js/parent-class-filters.js) -
          "All Students" hands control back to Grade Level on its own. %>
      <% if (hasChildren) { %>
        <details class="filter-details" data-filter-details>
          <summary class="roster-action-btn">Filter</summary>
          <div class="filter-panel">
            <div class="category-filter">
              <label for="parent-class-student-select">My Student</label>
              <select id="parent-class-student-select" data-parent-class-student-filter>
                <option value="">All Students</option>
                <% children.forEach(function(child) { %>
                  <option value="<%= child.id %>" data-grade="<%= child.grade_level || '' %>"><%= child.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="category-filter">
              <label for="parent-class-grade-select">Grade Level</label>
              <select id="parent-class-grade-select" data-parent-class-grade-filter>
                <option value="">All Grades</option>
                <% gradeLevels.forEach(function(g) { %><option value="<%= g %>"><%= g %></option><% }); %>
              </select>
            </div>
          </div>
        </details>
      <% } %>
    </div>

    <% if (view === 'list') { %>
      <div class="parent-class-list">
        <% if (classList.length === 0) { %>
          <p class="roster-empty">No classes have been scheduled yet.</p>
        <% } else { %>
          <% classList.forEach(function(cls) { %>
            <%- include('partials/parent-class-card', { cls, day, view, enrolledClassIds }) %>
          <% }); %>
        <% } %>
      </div>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table class-schedule-room-grid">
          <thead>
            <tr>
              <th class="class-schedule-room-col">Room</th>
              <% roomGrid.hours.forEach(function(h) { %>
                <th><%= h.label %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% if (roomGrid.rows.length === 0) { %>
              <tr><td colspan="<%= roomGrid.hours.length + 1 %>" class="roster-empty">No classes have been scheduled yet.</td></tr>
            <% } %>
            <% roomGrid.rows.forEach(function(row) { %>
              <tr>
                <td class="class-schedule-room-col"><%= row.room %></td>
                <% row.cells.forEach(function(cell) { %>
                  <td colspan="<%= cell.span %>" class="class-schedule-cell">
                    <% if (cell.classes.length === 0) { %>
                      &nbsp;
                    <% } else { %>
                      <% cell.classes.forEach(function(cls) { %>
                        <%- include('partials/parent-class-card', { cls, day, view, enrolledClassIds }) %>
                      <% }); %>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>

  <dialog id="parent-class-dialog" class="parent-class-dialog"></dialog>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/parent-class-view.js"></script>
  <script src="/js/parent-class-filters.js"></script>
  <script src="/js/filter-details-dismiss.js"></script>
  <script src="/js/class-card-title-fit.js"></script>
  <script src="/js/parent-class-row-fit.js"></script>
  <script src="/js/parent-class-register-withdraw.js"></script>
</body>
</html>
