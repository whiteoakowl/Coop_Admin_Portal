<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Parent Portal',
    navLinks: [
      { href: '/parent', icon: 'home', label: 'Home' },
      { href: '/parent/classes', icon: 'graduation-cap', label: 'Classes' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Classes</h1>
    <p class="hint">Browse open classes and register your children. Classes with registration closed are shown for reference only.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (children.length === 0) { %>
      <p class="roster-empty">No students are linked to your family yet, so there's no one to register. Contact an admin if this looks wrong.</p>
    <% } %>

    <% if (classes.length === 0) { %>
      <p class="roster-empty">No classes have been scheduled yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>Class</th>
              <th>Day / Time</th>
              <th>Grades</th>
              <th>Teacher</th>
              <th>Seats</th>
              <th>Register</th>
            </tr>
          </thead>
          <tbody>
            <% classes.forEach(function(c) { %>
              <tr>
                <td class="roster-name-col">
                  <strong><%= c.class_name %></strong>
                  <% if (c.description) { %><div class="hint"><%= c.description %></div><% } %>
                </td>
                <td><%= c.dayLabel %> &middot; <%= c.timeLabel %></td>
                <td><%= c.gradeLabel || '—' %></td>
                <td><%= c.teacherNames.length ? c.teacherNames.join(', ') : '—' %></td>
                <td>
                  <% if (c.capacity == null) { %>
                    <span class="badge-pill">Open</span>
                  <% } else if (c.isFull) { %>
                    <span class="badge-pill badge-pill-absent">Full</span>
                  <% } else { %>
                    <span class="badge-pill badge-pill-present"><%= c.seatsLeft %> left</span>
                  <% } %>
                </td>
                <td>
                  <% if (!c.registration_open) { %>
                    <span class="hint">Not open</span>
                  <% } else { %>
                    <% children.forEach(function(child) { %>
                      <% var key = c.id + ':' + child.id; %>
                      <% if (enrolledKey.indexOf(key) !== -1) { %>
                        <form method="POST" action="/parent/classes/<%= c.id %>/unregister" class="inline-block-form">
                          <input type="hidden" name="studentId" value="<%= child.id %>" />
                          <button type="submit" class="roster-action-btn roster-action-btn-danger"><%= child.name %>: Cancel</button>
                        </form>
                      <% } else { %>
                        <form method="POST" action="/parent/classes/<%= c.id %>/register" class="inline-block-form">
                          <input type="hidden" name="studentId" value="<%= child.id %>" />
                          <button type="submit" class="roster-action-btn"><%= child.name %>: Register</button>
                        </form>
                      <% } %>
                    <% }); %>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
