<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Parent Portal',
    navLinks: [
      { href: '/parent', icon: 'home', label: 'Home' },
      { href: '/parent/library', icon: 'book', label: 'Library' },
      { href: '/parent/academics', icon: 'clipboard-list', label: 'Academics' },
      { href: '/parent/babysitters', icon: 'user', label: 'Babysitters' },
    ],
    classLinks: [
      { href: '/parent/classes', icon: 'graduation-cap', label: 'Classes' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Classes</h1>
    <p class="hint">Tap a class below for details, seats, and to register your children. A class shown here isn't
      necessarily open for registration yet - it's still worth seeing what's scheduled.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (!hasChildren) { %>
      <p class="roster-empty">No students are linked to your family yet, so there's no one to register. Contact an admin if this looks wrong.</p>
    <% } else if (!windowOpen) { %>
      <div class="alert alert-info">
        Registration isn't open for your account yet<% if (nextWindowLabel) { %> - it opens <%= nextWindowLabel %><% } %>.
        You can still open a class below to see or cancel a registration you already have.
      </div>
    <% } %>

    <div class="day-toggle no-print schedule-day-toggle">
      <a class="day-toggle-option<%= day === 'monday' ? ' active' : '' %>" href="/parent/classes?day=monday">Monday</a>
      <a class="day-toggle-option<%= day === 'wednesday' ? ' active' : '' %>" href="/parent/classes?day=wednesday">Wednesday</a>
    </div>

    <div class="roster-scroll">
      <table class="roster-table class-schedule-room-grid">
        <thead>
          <tr>
            <th class="class-schedule-room-col">Room</th>
            <% roomGrid.hours.forEach(function(h) { %>
              <th><%= h.label %></th>
            <% }); %>
          </tr>
        </thead>
        <tbody>
          <% if (roomGrid.rows.length === 0) { %>
            <tr><td colspan="<%= roomGrid.hours.length + 1 %>" class="roster-empty">No classes have been scheduled yet.</td></tr>
          <% } %>
          <% roomGrid.rows.forEach(function(row) { %>
            <tr>
              <td class="class-schedule-room-col"><%= row.room %></td>
              <% row.cells.forEach(function(cell) { %>
                <td colspan="<%= cell.span %>" class="class-schedule-cell">
                  <% if (cell.classes.length === 0) { %>
                    &nbsp;
                  <% } else { %>
                    <% cell.classes.forEach(function(cls) { %>
                      <button
                        type="button"
                        class="class-card class-card-clickable"
                        style="border-left-color: <%= cls.color %>; background: color-mix(in srgb, <%= cls.color %> 42%, white);"
                        data-view-class="<%= cls.id %>"
                        data-view-class-day="<%= day %>"
                      >
                        <div class="class-card-header">
                          <h3><%= cls.class_name %></h3>
                          <% if (enrolledClassIds.indexOf(cls.id) !== -1) { %>
                            <span class="badge-pill badge-pill-present" title="One of your children is enrolled">Registered</span>
                          <% } %>
                        </div>
                        <div class="class-card-info">
                          <% if (cls.gradeLabel) { %><p class="class-card-line"><%= cls.gradeLabel %></p><% } %>
                          <p class="class-card-line"><span class="class-card-line-label">Teacher:</span> <%= cls.teacherNames.length ? cls.teacherNames.join(', ') : '—' %></p>
                          <% if (cls.room) { %><p class="class-card-line"><span class="class-card-line-label">Room:</span> <%= cls.room %></p><% } %>
                        </div>
                      </button>
                    <% }); %>
                  <% } %>
                </td>
              <% }); %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>

  <dialog id="parent-class-dialog" class="parent-class-dialog"></dialog>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/parent-class-view.js"></script>
</body>
</html>
