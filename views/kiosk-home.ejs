<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="landing landing-has-action-bar">
  <%- include('partials/icon-sprite') %>
  <!-- Desktop/tablet: a full-width orange menu bar fixed across the very
       top of the screen (see .landing-top-menu's own comment) for the
       day's less-frequent forms/links, and Check In/Check Out (green) +
       Floater Assignments/Setup-Cleanup Teams (purple) as two stacked
       columns instead of one undifferentiated grid. Below 640px this whole
       block is hidden - see .landing-mobile-grid below for the phone-sized
       4-button grid instead (just Check In/Check Out/Floater Assignments/
       Setup-Cleanup Teams), and .landing-action-bar below for the same 5
       links this top menu has (Name Tag Form, Absence/Late Form, Find a
       Parent, Class Check In & Out, Admin) as the phone's own bottom menu.
       Lives outside .landing-wrap so it isn't constrained to that
       element's own centered max-width. -->
  <nav class="landing-top-menu landing-desktop-only">
    <a class="landing-top-menu-link" href="/name-tag"><svg class="icon"><use href="#icon-badge"/></svg> Name Tag Form</a>
    <a class="landing-top-menu-link" href="/absence"><svg class="icon"><use href="#icon-clipboard-list"/></svg> Absence/Late Form</a>
    <a class="landing-top-menu-link" href="/kiosk/find-parent"><svg class="icon"><use href="#icon-search"/></svg> Find a Parent</a>
    <a class="landing-top-menu-link" href="/kiosk/class-checkin"><svg class="icon"><use href="#icon-graduation-cap"/></svg> Class Check In &amp; Out</a>
    <a class="landing-top-menu-link" href="/admin"><svg class="icon"><use href="#icon-lock"/></svg> Admin</a>
  </nav>
  <div class="landing-corner-actions">
    <button type="button" class="admin-corner-link" id="fullscreen-toggle-btn">
      <svg class="icon"><use href="#icon-maximize"/></svg>
      <span id="fullscreen-toggle-label" class="fullscreen-toggle-label">Full Screen View</span>
    </button>
  </div>
  <%# A real request: "we need to make the kiosk page have an actual
      kiosk button that locks the screen in full screen mode so members
      can't click in the browser. once activated it should stay in kiosk
      mode/full screen through all kiosk pages," refined by a follow-up:
      "on kiosk homepage, tablet snd desktop view, the kiosk button
      should be bottom right of the screen." Reuses the fixed bottom-
      right corner spot (.landing-corner-actions-bottom-right) an earlier
      kiosk-home design already used for this exact purpose before the
      Class Check In & Out/Admin links moved into .landing-top-menu/
      .landing-action-bar above - desktop/tablet only, since mobile
      already has its own Kiosk Mode entry in the bottom orange action
      bar below. public/js/fullscreen-toggle.js keeps this button, that
      mobile one, and the small Full Screen View corner icon all in sync
      with each other and with real fullscreen state; public/js/
      fullscreen-nav.js (loaded on every kiosk page) is what actually
      keeps fullscreen alive across a real page navigation once
      activated. %>
  <div class="landing-corner-actions-bottom-right landing-desktop-only">
    <button type="button" class="kiosk-mode-corner-btn" id="kiosk-mode-btn" data-label-off="Start Kiosk Mode" data-label-on="Exit Kiosk Mode">
      <svg class="icon"><use href="#icon-maximize"/></svg>
      <span class="fullscreen-toggle-label">Start Kiosk Mode</span>
    </button>
  </div>
  <%# A real request: "exiting full screen on kiosk should ask for an id
      number, otherwis it's stays in full screen kiosk mode. the id
      number is the class check in id number." This partial was never
      included here before, so the button above had nothing to gate it -
      public/js/fullscreen-toggle.js's own requestExit() falls straight
      through to document.exitFullscreen() with no dialog at all when
      #fullscreen-exit-pin-dialog doesn't exist in the page. verifyPinUrl
      points at the kiosk's own unauthenticated verify route (routes/
      kiosk.js) instead of the default admin one, which would 403 here -
      see that partial's own comment. %>
  <%- include('partials/fullscreen-exit-pin-dialog', { verifyPinUrl: '/kiosk/fullscreen/verify-pin' }) %>
  <footer class="landing-action-bar">
    <a class="landing-action-bar-btn" href="/name-tag"><svg class="icon"><use href="#icon-badge"/></svg><span>Name Tag Form</span></a>
    <a class="landing-action-bar-btn" href="/absence"><svg class="icon"><use href="#icon-clipboard-list"/></svg><span>Absence/Late Form</span></a>
    <a class="landing-action-bar-btn" href="/kiosk/find-parent"><svg class="icon"><use href="#icon-search"/></svg><span>Find a Parent</span></a>
    <a class="landing-action-bar-btn" href="/kiosk/class-checkin"><svg class="icon"><use href="#icon-graduation-cap"/></svg><span>Class Check In &amp; Out</span></a>
    <a class="landing-action-bar-btn" href="/admin"><svg class="icon"><use href="#icon-lock"/></svg><span>Admin</span></a>
    <%# Same Kiosk Mode button as the desktop/tablet bottom-right corner
        button above - "bottom orange bar, far right for mobile."
        .landing-action-bar-btn items already stretch evenly (flex: 1
        each), so being last in source order already puts it at the far
        right edge with no extra CSS. %>
    <button type="button" class="landing-action-bar-btn" id="kiosk-mode-btn-mobile" data-label-off="Start Kiosk Mode" data-label-on="Exit Kiosk Mode">
      <svg class="icon"><use href="#icon-maximize"/></svg><span class="fullscreen-toggle-label">Start Kiosk Mode</span>
    </button>
  </footer>
  <main id="main-content" tabindex="-1" class="landing-wrap">
    <div class="landing-banner">
      <img class="landing-logo-sm" src="/img/logo-owl.png" alt="Sanford Homeschoolers" />
      <h1 class="landing-welcome">Welcome to Co-op!</h1>
    </div>

    <div class="landing-columns landing-desktop-only">
      <div class="landing-column">
        <a class="landing-card landing-card-green landing-card-wide" href="/kiosk/checkin">
          <span class="landing-icon"><svg class="icon"><use href="#icon-check"/></svg></span>
          <span class="landing-label">Check In</span>
        </a>
        <a class="landing-card landing-card-green landing-card-wide" href="/kiosk/checkout">
          <span class="landing-icon"><svg class="icon"><use href="#icon-log-out"/></svg></span>
          <span class="landing-label">Check Out</span>
        </a>
      </div>
      <div class="landing-column">
        <a class="landing-card landing-card-purple landing-card-wide" href="/volunteers">
          <span class="landing-icon"><svg class="icon"><use href="#icon-users"/></svg></span>
          <span class="landing-label">Floater Assignments</span>
        </a>
        <a class="landing-card landing-card-purple landing-card-wide" href="/setup">
          <span class="landing-icon"><svg class="icon"><use href="#icon-broom"/></svg></span>
          <span class="landing-label">Setup/Cleanup Teams</span>
        </a>
      </div>
    </div>

    <!-- Name Tag Form and Absence/Late Form moved to .landing-action-bar
         (the mobile bottom menu) instead of living here too - see that
         footer above. -->
    <div class="landing-mobile-grid">
      <div class="landing-grid">
        <a class="landing-card landing-card-green" href="/kiosk/checkin">
          <span class="landing-icon"><svg class="icon"><use href="#icon-check"/></svg></span>
          <span class="landing-label">Check In</span>
        </a>
        <a class="landing-card landing-card-green" href="/kiosk/checkout">
          <span class="landing-icon"><svg class="icon"><use href="#icon-log-out"/></svg></span>
          <span class="landing-label">Check Out</span>
        </a>
        <a class="landing-card landing-card-purple" href="/volunteers">
          <span class="landing-icon"><svg class="icon"><use href="#icon-users"/></svg></span>
          <span class="landing-label">Floater Assignments</span>
        </a>
        <a class="landing-card landing-card-purple" href="/setup">
          <span class="landing-icon"><svg class="icon"><use href="#icon-broom"/></svg></span>
          <span class="landing-label">Setup/Cleanup Teams</span>
        </a>
      </div>
    </div>
  </main>
  <script src="/js/fullscreen-toggle.js"></script>
  <script src="/js/fullscreen-nav.js"></script>
</body>
</html>
