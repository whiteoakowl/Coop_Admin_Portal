<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="site-section">
      <div class="site-section-inner">
        <p><a href="/classifieds">&larr; All Classifieds</a></p>

        <% if (listing.imageUrl) { %>
          <img src="<%= listing.imageUrl %>" alt="" style="width: 100%; max-height: 320px; object-fit: cover; border-radius: var(--radius); margin-bottom: 1.25rem;" />
        <% } %>

        <h1><%= listing.title %></h1>
        <% if (listing.price) { %><p class="site-hero-meta"><svg class="icon"><use href="#icon-tag"/></svg> <%= listing.price %></p><% } %>
        <% if (listing.categoryTitle) { %><p class="site-hero-meta"><%= listing.categoryTitle %></p><% } %>
        <% if (listing.description) { %><p><%= listing.description %></p><% } %>
      </div>
    </section>
  </main>
</body>
</html>
