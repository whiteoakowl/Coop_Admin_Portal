<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Settings</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="view-tabs">
      <% if (isFullAdmin) { %>
        <a class="view-tab<%= activeTab === 'account' ? ' active' : '' %>" href="/admin/settings?tab=account">Username/Password</a>
        <a class="view-tab<%= activeTab === 'classcheckin' ? ' active' : '' %>" href="/admin/settings?tab=classcheckin">Class Check-In PIN</a>
        <a class="view-tab<%= activeTab === 'leaders' ? ' active' : '' %>" href="/admin/settings?tab=leaders">Admin &amp; Leaders</a>
      <% } %>
      <a class="view-tab<%= activeTab === 'quicklinks' ? ' active' : '' %>" href="/admin/settings?tab=quicklinks">Quick Links</a>
      <a class="view-tab<%= activeTab === 'install' ? ' active' : '' %>" href="/admin/settings?tab=install">Install App</a>
      <% if (isFullAdmin) { %>
        <a class="view-tab<%= activeTab === 'documents' ? ' active' : '' %>" href="/admin/settings?tab=documents">Documents</a>
      <% } %>
    </div>
    <div class="view-tab-panel">
      <% if (activeTab === 'account') { %>
        <div class="settings-account-grid">
          <form method="POST" action="/admin/settings/username" class="stack-form stack-form-narrow">
            <h2>Username</h2>
            <label for="currentUsernameDisplay">Current Username</label>
            <input id="currentUsernameDisplay" type="text" value="<%= username %>" disabled />

            <label for="newUsername">New Username</label>
            <input id="newUsername" name="newUsername" type="text" required />

            <button type="submit" class="primary-btn">Update</button>
          </form>

          <form method="POST" action="/admin/settings/password" class="stack-form stack-form-narrow">
            <h2>Password</h2>
            <label for="currentPassword">Current Password</label>
            <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />

            <label for="newPassword">New Password</label>
            <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required minlength="8" />

            <button type="submit" class="primary-btn">Update</button>
          </form>
        </div>
      <% } else if (activeTab === 'classcheckin') { %>
        <div class="manage-section">
          <h2>Class Check-In PIN</h2>
          <p class="hint">A shared 4-digit PIN staff enter at the kiosk's Class Check-In screen to check students into individual classes and view class attendance. Anyone with this PIN can use it - change it if it's ever shared beyond who should have ongoing access.</p>
          <form method="POST" action="/admin/settings/class-checkin-pin" class="stack-form stack-form-narrow">
            <label for="newPin">New PIN</label>
            <input id="newPin" name="newPin" type="text" inputmode="numeric" pattern="[0-9]{4}" minlength="4" maxlength="4" placeholder="4 digits" required autocomplete="off" />

            <button type="submit" class="primary-btn">Update PIN</button>
          </form>
        </div>
      <% } else if (activeTab === 'leaders') { %>
        <div class="manage-section">
          <h2>Add Admin Position</h2>
          <p class="hint">Positions listed here appear as choices in the Admin Position dropdown on the member form (Member Type: Admin), and print on that member's Admin name tag.</p>
          <form method="POST" action="/admin/settings/admin-positions" class="stack-form stack-form-narrow">
            <label for="adminPositionTitle">Position Title</label>
            <input id="adminPositionTitle" name="title" type="text" placeholder="e.g. President" required />

            <button type="submit" class="primary-btn">Add Position</button>
          </form>
        </div>
        <div class="manage-section">
          <h2>Admin Positions</h2>
          <% if (adminPositions.length === 0) { %>
            <p class="hint">No admin positions added yet.</p>
          <% } else { %>
            <table class="roster-table">
              <thead><tr><th>Title</th><th></th></tr></thead>
              <tbody>
                <% adminPositions.forEach(function(p) { %>
                  <tr>
                    <td><%= p.title %></td>
                    <td>
                      <form method="POST" action="/admin/settings/admin-positions/<%= p.id %>/delete" data-confirm="Remove &quot;<%= p.title %>&quot;?">
                        <button type="submit" class="icon-btn" aria-label="Remove <%= p.title %>" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        </div>
      <% } else if (activeTab === 'documents') { %>
        <div class="manage-section">
          <h2>Upload Document</h2>
          <p class="hint">Add a PDF or Word document to show as a button on the <a href="/admin/documents">Documents</a> page. Max file size: 5MB.</p>
          <form method="POST" action="/admin/documents/upload" enctype="multipart/form-data" class="stack-form stack-form-narrow">
            <label for="docTitle">Title</label>
            <input id="docTitle" name="title" type="text" placeholder="e.g. Parent Handbook" />

            <label for="docFile">File (PDF or Word)</label>
            <input id="docFile" name="file" type="file" accept=".pdf,.doc,.docx" required />

            <button type="submit" class="primary-btn">Upload</button>
          </form>
        </div>
        <div class="manage-section">
          <h2>Uploaded Documents</h2>
          <% if (documents.length === 0) { %>
            <p class="hint">No documents uploaded yet.</p>
          <% } else { %>
            <table class="roster-table">
              <thead><tr><th>Title</th><th>File</th><th></th></tr></thead>
              <tbody>
                <% documents.forEach(function(d) { %>
                  <tr>
                    <td><%= d.title %></td>
                    <td><%= d.original_name %></td>
                    <td>
                      <form method="POST" action="/admin/documents/<%= d.id %>/delete" data-confirm="Delete &quot;<%= d.title %>&quot;?">
                        <button type="submit" class="icon-btn" aria-label="Delete <%= d.title %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        </div>
      <% } else if (activeTab === 'install') { %>
        <div class="manage-section">
          <h2>Install as an App</h2>
          <p class="hint">Add Sanford Homeschoolers to this device's home screen or app list for quick, full-screen access - no browser address bar or tabs, just like a regular app.</p>
          <button type="button" id="pwa-install-btn" class="primary-btn" hidden>Install App</button>
          <p class="hint" id="pwa-install-status"></p>
        </div>
        <div class="manage-section">
          <h2>Android (Chrome / Edge)</h2>
          <ol class="pwa-steps">
            <li>Tap <strong>Install App</strong> above, or open the browser menu (&#8942;) and choose <strong>Install app</strong> or <strong>Add to Home screen</strong>.</li>
            <li>Confirm by tapping <strong>Install</strong>.</li>
          </ol>
        </div>
        <div class="manage-section">
          <h2>iPhone / iPad (Safari)</h2>
          <ol class="pwa-steps">
            <li>Tap the <strong>Share</strong> icon in Safari's toolbar.</li>
            <li>Scroll down and tap <strong>Add to Home Screen</strong>.</li>
            <li>Tap <strong>Add</strong> in the top right.</li>
          </ol>
        </div>
        <div class="manage-section">
          <h2>Desktop (Chrome / Edge)</h2>
          <ol class="pwa-steps">
            <li>Click <strong>Install App</strong> above, or click the install icon in the address bar.</li>
            <li>Confirm by clicking <strong>Install</strong>.</li>
          </ol>
        </div>
      <% } else { %>
        <p class="subtitle">Kiosk screens, public forms, and admin pages, opened in a new tab.</p>
        <div class="admin-card-grid">
          <a class="admin-card" href="/kiosk" target="_blank">Full Kiosk Screen</a>
          <a class="admin-card" href="/kiosk/checkin" target="_blank">Check-In Kiosk</a>
          <a class="admin-card" href="/kiosk/checkout" target="_blank">Check-Out Kiosk</a>
          <a class="admin-card" href="/kiosk/class-checkin" target="_blank">Class Check-In Kiosk</a>
          <a class="admin-card" href="/absence" target="_blank">Absence/Late Form (public link)</a>
          <a class="admin-card" href="/name-tag" target="_blank">Name Tag Form (public link)</a>
          <a class="admin-card" href="/membership" target="_blank">Membership Form (public link)</a>
          <a class="admin-card" href="/training" target="_blank">Training (public link)</a>
          <a class="admin-card" href="/setup" target="_blank">Setup/Cleanup Assignments</a>
          <a class="admin-card" href="/volunteers" target="_blank">Floater Assignments</a>
        </div>
      <% } %>
    </div>
  </main>
  <script src="/js/edit-toggle.js"></script>
</body>
</html>
