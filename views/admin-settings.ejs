<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Settings</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="settings-box-row">
      <div class="settings-box">
        <h2>Username</h2>
        <form method="POST" action="/admin/settings/username" class="stack-form stack-form-narrow">
          <label>Current Username</label>
          <input type="text" value="<%= username %>" disabled />

          <label for="newUsername">New Username</label>
          <input id="newUsername" name="newUsername" type="text" required />

          <button type="submit" class="primary-btn">Update</button>
        </form>
      </div>

      <div class="settings-box">
        <h2>Password</h2>
        <form method="POST" action="/admin/settings/password" class="stack-form stack-form-narrow">
          <label for="currentPassword">Current Password</label>
          <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />

          <label for="newPassword">New Password</label>
          <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required minlength="8" />

          <button type="submit" class="primary-btn">Update</button>
        </form>
      </div>

      <div class="settings-box">
        <h2>Categories</h2>
        <p class="subtitle">Used to organize rosters. Add one here, then pick it from the dropdown when creating or editing a roster.</p>
        <form method="POST" action="/admin/rosters/categories" class="inline-form-flat">
          <input type="text" name="name" placeholder="e.g. Youth, Adults, Sports" required />
          <button type="submit">Add</button>
        </form>
        <div class="checkbox-row">
          <% if (categories.length === 0) { %>
            <span class="hint">No categories yet.</span>
          <% } %>
          <% categories.forEach(function(c) { %>
            <span class="badge-pill"><%= c %></span>
          <% }); %>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
