<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Settings</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <% if (!activeTab) { %>
      <%# A real request: "change co-op admin settings gear to cards for
          each tab like main admin portal settings gear." Same
          .team-card-grid/.team-info-card hub component Main Admin's own
          /main-admin/settings uses - Username/Password, Class Check-In
          PIN, and Kiosk only show for the full master admin account
          (same restriction the old tab strip enforced). %>
      <div class="team-card-grid">
        <% if (isFullAdmin) { %>
          <div class="team-col">
            <a class="team-info-card" href="/admin/settings?tab=account">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-user-circle"/></svg></span>
              <h3 class="team-info-title">Username/Password</h3>
              <p class="hint">Change the shared admin login's username or password.</p>
            </a>
          </div>
          <div class="team-col">
            <a class="team-info-card" href="/admin/settings?tab=classcheckin">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-badge"/></svg></span>
              <h3 class="team-info-title">Class Check-In PIN</h3>
              <p class="hint">The shared PIN staff enter at the kiosk's Class Check-In screen.</p>
            </a>
          </div>
          <div class="team-col">
            <a class="team-info-card" href="/admin/settings?tab=kiosk">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-sliders"/></svg></span>
              <h3 class="team-info-title">Kiosk</h3>
              <p class="hint">Choose which semester the Kiosk is currently running.</p>
            </a>
          </div>
        <% } %>
        <div class="team-col">
          <a class="team-info-card" href="/admin/settings?tab=quicklinks">
            <span class="team-info-icon"><svg class="icon"><use href="#icon-link"/></svg></span>
            <h3 class="team-info-title">Quick Links</h3>
            <p class="hint">Shortcut links shown to members.</p>
          </a>
        </div>
        <div class="team-col">
          <a class="team-info-card" href="/admin/settings?tab=install">
            <span class="team-info-icon"><svg class="icon"><use href="#icon-file-text"/></svg></span>
            <h3 class="team-info-title">Install App</h3>
            <p class="hint">Add this site to your device's home screen or app list.</p>
          </a>
        </div>
      </div>
    <% } else { %>
    <p class="subtitle no-print"><a href="/admin/settings">&larr; Back to Settings Menu</a></p>
    <div class="view-tab-panel">
      <% if (activeTab === 'account') { %>
        <div class="settings-account-grid">
          <form method="POST" action="/admin/settings/username" class="stack-form stack-form-narrow">
            <h2>Username</h2>
            <label for="currentUsernameDisplay">Current Username</label>
            <input id="currentUsernameDisplay" type="text" value="<%= username %>" disabled />

            <label for="newUsername">New Username</label>
            <input id="newUsername" name="newUsername" type="text" required />

            <button type="submit" class="primary-btn">Update</button>
          </form>

          <form method="POST" action="/admin/settings/password" class="stack-form stack-form-narrow">
            <h2>Password</h2>
            <label for="currentPassword">Current Password</label>
            <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />

            <label for="newPassword">New Password</label>
            <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required minlength="8" />

            <button type="submit" class="primary-btn">Update</button>
          </form>
        </div>
      <% } else if (activeTab === 'classcheckin') { %>
        <div class="manage-section">
          <h2>Class Check-In PIN</h2>
          <p class="hint">A shared 4-digit PIN staff enter at the kiosk's Class Check-In screen to check students into individual classes and view class attendance. Anyone with this PIN can use it - change it if it's ever shared beyond who should have ongoing access.</p>
          <form method="POST" action="/admin/settings/class-checkin-pin" class="stack-form stack-form-narrow">
            <label for="newPin">New PIN</label>
            <input id="newPin" name="newPin" type="text" inputmode="numeric" pattern="[0-9]{4}" minlength="4" maxlength="4" placeholder="4 digits" required autocomplete="off" />

            <button type="submit" class="primary-btn">Update PIN</button>
          </form>
        </div>
      <% } else if (activeTab === 'kiosk') { %>
        <div class="manage-section">
          <h2>Kiosk Semester</h2>
          <p class="hint">Choose which semester the Kiosk (Floater List, Setup/Cleanup, Class Check-In, and Check-Out) is currently running. Each semester has its own fully separate Floater List and Setup/Cleanup Teams - switching here switches which semester's data the Kiosk and these admin pages show.</p>
          <form method="POST" action="/admin/settings/kiosk-semester" class="member-form-grid">
            <label class="member-form-full">Active Kiosk Semester
              <select name="semesterId" required>
                <option value="">Choose a semester...</option>
                <% semesters.forEach(function(s) { %>
                  <option value="<%= s.id %>" <%= activeKioskSemesterId === s.id ? 'selected' : '' %>><%= s.title %></option>
                <% }); %>
              </select>
            </label>
            <div class="member-form-full">
              <button type="submit" class="primary-btn">Save</button>
            </div>
          </form>
          <% if (semesters.length === 0) { %>
            <p class="roster-empty">No semesters yet - add one on the Classes &gt; Settings &gt; Semester tab first.</p>
          <% } %>
        </div>
      <% } else if (activeTab === 'install') { %>
        <div class="manage-section">
          <h2>Install as an App</h2>
          <p class="hint">Add Sanford Homeschoolers to this device's home screen or app list for quick, full-screen access - no browser address bar or tabs, just like a regular app.</p>
          <button type="button" id="pwa-install-btn" class="primary-btn" hidden>Install App</button>
          <p class="hint" id="pwa-install-status"></p>
        </div>
        <div class="manage-section">
          <h2>Android (Chrome / Edge)</h2>
          <ol class="pwa-steps">
            <li>Tap <strong>Install App</strong> above, or open the browser menu (&#8942;) and choose <strong>Install app</strong> or <strong>Add to Home screen</strong>.</li>
            <li>Confirm by tapping <strong>Install</strong>.</li>
          </ol>
        </div>
        <div class="manage-section">
          <h2>iPhone / iPad (Safari)</h2>
          <ol class="pwa-steps">
            <li>Tap the <strong>Share</strong> icon in Safari's toolbar.</li>
            <li>Scroll down and tap <strong>Add to Home Screen</strong>.</li>
            <li>Tap <strong>Add</strong> in the top right.</li>
          </ol>
        </div>
        <div class="manage-section">
          <h2>Desktop (Chrome / Edge)</h2>
          <ol class="pwa-steps">
            <li>Click <strong>Install App</strong> above, or click the install icon in the address bar.</li>
            <li>Confirm by clicking <strong>Install</strong>.</li>
          </ol>
        </div>
      <% } else { %>
        <div class="admin-card-grid">
          <a class="admin-card" href="/kiosk" target="_blank">Full Kiosk Screen</a>
          <a class="admin-card" href="/kiosk/checkin" target="_blank">Check-In Kiosk</a>
          <a class="admin-card" href="/kiosk/checkout" target="_blank">Check-Out Kiosk</a>
          <a class="admin-card" href="/kiosk/class-checkin" target="_blank">Class Check-In Kiosk</a>
          <a class="admin-card" href="/absence" target="_blank">Absence/Late Form</a>
          <a class="admin-card" href="/name-tag" target="_blank">Name Tag Form</a>
          <a class="admin-card" href="/membership" target="_blank">Membership Form</a>
          <a class="admin-card" href="/training" target="_blank">Training</a>
          <a class="admin-card" href="/setup" target="_blank">Setup/Cleanup Teams</a>
          <a class="admin-card" href="/volunteers" target="_blank">Floater Assignments</a>
        </div>
      <% } %>
    </div>
    <% } %>
  </main>
  <script src="/js/edit-toggle.js"></script>
</body>
</html>
