<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Audit Log</h1>
    <p class="hint">Financial changes, deletions, and moderation actions across the app - see Chat's own Moderation Log for chat-specific moderation.</p>

    <form method="GET" action="/main-admin/audit-log" class="inline-block-form">
      <label>Filter by type
        <select name="targetType" onchange="this.form.submit()">
          <option value="">All</option>
          <% targetTypes.forEach(function(t) { %>
            <option value="<%= t %>" <%= targetType === t ? 'selected' : '' %>><%= t %></option>
          <% }); %>
        </select>
      </label>
    </form>

    <% if (entries.length === 0) { %>
      <p class="roster-empty">No audit entries yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>When</th>
              <th>Actor</th>
              <th>Action</th>
              <th>Target</th>
              <th>Detail</th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach(function(e) { %>
              <tr>
                <td><%= e.created_at %></td>
                <td><%= e.actor_email || 'Unknown' %></td>
                <td><%= e.action %></td>
                <td><%= e.target_type %><% if (e.target_id != null) { %> #<%= e.target_id %><% } %></td>
                <td><%= e.detail || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
