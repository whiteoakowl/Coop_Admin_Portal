<%# Fragment (no <html>/<body>) - fetched by public/js/parent-class-view.js
    and injected into the shared #parent-class-dialog on the Classes grid,
    so viewing a class and registering a child never leaves the grid page.
    Read-only class info + per-child register/cancel, unlike the Co-op
    Admin version of this same popup (class-schedule-view-fragment.ejs) -
    a parent never edits the class itself here. A real request: "click on
    class to register, the class card should look like the image
    provided" - icon-badge header, Day&Time/Location row, a Teacher/
    Assistant box, a Grade Level/Enrollment row, and a highlighted
    "Register your children" footer, replacing the older plain row of
    badge-pills this used to be. %>
<div class="class-view-header-v2">
  <div class="class-view-icon-badge" style="background: <%= cls.color %>;">
    <svg class="icon"><use href="#icon-book"/></svg>
  </div>
  <div class="class-view-header-text">
    <h3><%= cls.class_name %></h3>
    <span class="class-view-eyebrow">Class Registration</span>
  </div>
  <button type="button" class="class-form-dialog-close" onclick="this.closest('dialog').close()" aria-label="Close"><svg class="icon"><use href="#icon-x-circle"/></svg></button>
</div>

<div class="parent-class-body">
  <% if (classImageUrl) { %>
    <img src="<%= classImageUrl %>" alt="" style="max-width: 100%; border-radius: var(--radius); display: block; margin-bottom: 0.75rem;" />
  <% } %>

  <div class="class-view-info-row">
    <div class="class-view-info-item">
      <svg class="icon"><use href="#icon-calendar-check"/></svg>
      <div>
        <span class="class-view-info-label">Day &amp; Time</span>
        <strong class="class-view-info-value">
          <%= cls.day === 'monday' ? 'Monday' : 'Wednesday' %>
          <% if (cls.start_time || cls.end_time) { %><br /><%= cls.start_time || '?' %>&ndash;<%= cls.end_time || '?' %><% } %>
        </strong>
      </div>
    </div>
    <% if (cls.room) { %>
      <div class="class-view-info-divider"></div>
      <div class="class-view-info-item">
        <svg class="icon"><use href="#icon-map-pin"/></svg>
        <div>
          <span class="class-view-info-label">Location</span>
          <strong class="class-view-info-value">Room <%= cls.room %></strong>
        </div>
      </div>
    <% } %>
  </div>

  <% if (teacherNames.length || assistantNames.length) { %>
    <div class="class-view-people-box">
      <% if (teacherNames.length) { %>
        <div class="class-view-person">
          <span class="class-view-avatar"><svg class="icon"><use href="#icon-user"/></svg></span>
          <div>
            <span class="class-view-info-label">Teacher</span>
            <strong class="class-view-info-value"><%= teacherNames.join(', ') %></strong>
          </div>
        </div>
      <% } %>
      <% if (teacherNames.length && assistantNames.length) { %><hr class="class-view-people-divider" /><% } %>
      <% if (assistantNames.length) { %>
        <div class="class-view-person">
          <span class="class-view-avatar class-view-avatar-alt"><svg class="icon"><use href="#icon-user"/></svg></span>
          <div>
            <span class="class-view-info-label">Assistant</span>
            <strong class="class-view-info-value"><%= assistantNames.join(', ') %></strong>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>

  <div class="class-view-info-row">
    <% if (gradeLabel) { %>
      <div class="class-view-info-item">
        <svg class="icon"><use href="#icon-graduation-cap"/></svg>
        <div>
          <span class="class-view-info-label">Grade Level</span>
          <strong class="class-view-info-value"><%= gradeLabel %></strong>
        </div>
      </div>
      <div class="class-view-info-divider"></div>
    <% } %>
    <div class="class-view-info-item">
      <svg class="icon"><use href="#icon-users"/></svg>
      <div>
        <span class="class-view-info-label">Enrollment</span>
        <strong class="class-view-info-value">
          <% if (cls.capacity == null) { %>
            Open enrollment
          <% } else if (isFull) { %>
            <span class="badge-pill badge-pill-absent">Full</span>
          <% } else { %>
            <span class="badge-pill badge-pill-present"><%= seatsLeft %> seat<%= seatsLeft === 1 ? '' : 's' %> left</span>
          <% } %>
        </strong>
      </div>
    </div>
    <% if (cls.price_cents != null) { %>
      <div class="class-view-info-divider"></div>
      <div class="class-view-info-item">
        <svg class="icon"><use href="#icon-tag"/></svg>
        <div>
          <span class="class-view-info-label">Price</span>
          <strong class="class-view-info-value">$<%= (cls.price_cents / 100).toFixed(2) %> / student</strong>
        </div>
      </div>
    <% } %>
  </div>

  <%# A real request: "show how many students can sign up, how many
      assistants can sign up and how many of each have already signed
      up. It should also show wait list amount." A slot count of null
      means "no limit set" for that role, same convention cls.capacity
      already uses. %>
  <div class="class-view-info-row">
    <div class="class-view-info-item">
      <svg class="icon"><use href="#icon-graduation-cap"/></svg>
      <div>
        <span class="class-view-info-label">Students</span>
        <strong class="class-view-info-value"><%= enrolledCount %><% if (cls.capacity != null) { %> / <%= cls.capacity %><% } %> signed up</strong>
      </div>
    </div>
    <div class="class-view-info-divider"></div>
    <div class="class-view-info-item">
      <svg class="icon"><use href="#icon-user"/></svg>
      <div>
        <span class="class-view-info-label">Assistants</span>
        <strong class="class-view-info-value"><%= assistantCount %><% if (cls.assistant_slots != null) { %> / <%= cls.assistant_slots %><% } %> signed up</strong>
      </div>
    </div>
    <% if (waitlistCount > 0) { %>
      <div class="class-view-info-divider"></div>
      <div class="class-view-info-item">
        <svg class="icon"><use href="#icon-clock"/></svg>
        <div>
          <span class="class-view-info-label">Waitlist</span>
          <strong class="class-view-info-value"><%= waitlistCount %> waiting</strong>
        </div>
      </div>
    <% } %>
  </div>

  <% if (cls.description) { %>
    <div class="hint forum-editable-display parent-class-description"><%- cls.description %></div>
  <% } %>

  <div class="class-view-register-box">
    <h4><svg class="icon"><use href="#icon-users"/></svg> Register your children</h4>
    <% if (!hasChildren) { %>
      <p class="hint">No students are linked to your family yet.</p>
    <% } else if (children.length === 0) { %>
      <p class="hint">None of your children are the right age/grade for this class<% if (gradeLabel) { %> (<%= gradeLabel %>)<% } %>.</p>
    <% } else { %>
      <%
      function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function childControl(child) {
        var name = escapeHtml(child.name);
        var waitlistPos = waitlistPositionByStudentId[child.id];
        var isEnrolled = enrolledIds.indexOf(child.id) !== -1;
        if (isEnrolled || waitlistPos != null) {
          var statusLabel = waitlistPos != null ? 'Waitlisted (#' + waitlistPos + ')' : 'Registered';
          var cancelDisabled = !cls.allow_cancel;
          return (
            '<div class="parent-class-child-row">' +
            '<span class="parent-class-child-name">' + name + '</span>' +
            '<span class="badge-pill' + (waitlistPos != null ? '' : ' badge-pill-present') + '">' + statusLabel + '</span>' +
            (cancelDisabled
              ? '<span class="hint">Cancellation not allowed for this class</span>'
              : '<form method="POST" action="/parent/classes/' + cls.id + '/unregister" class="inline-block-form">' +
                '<input type="hidden" name="studentId" value="' + child.id + '" />' +
                '<input type="hidden" name="day" value="' + day + '" />' +
                '<button type="submit" class="roster-action-btn roster-action-btn-danger">Cancel</button>' +
                '</form>') +
            '</div>'
          );
        }
        var reg = '<div class="parent-class-child-row"><span class="parent-class-child-name">' + name + '</span>';
        if (!cls.registration_open) {
          reg += '<span class="hint">Not open for registration</span>';
        } else if (!cls.allow_parent_register) {
          reg += '<span class="hint">Parent registration not open for this class</span>';
        } else if (!windowOpen) {
          reg += '<span class="hint">Registration window not open yet</span>';
        } else {
          reg +=
            '<form method="POST" action="/parent/classes/' + cls.id + '/register" class="inline-block-form">' +
            '<input type="hidden" name="studentId" value="' + child.id + '" />' +
            '<input type="hidden" name="day" value="' + day + '" />' +
            '<button type="submit" class="primary-btn primary-btn-dark">Register</button>' +
            '</form>';
        }
        reg += '</div>';
        return reg;
      }
      %>
      <div class="parent-class-children">
        <% children.forEach(function(child) { %><%- childControl(child) %><% }); %>
      </div>
    <% } %>
  </div>
</div>
