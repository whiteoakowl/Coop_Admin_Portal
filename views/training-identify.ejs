<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="form-wrap">
    <div class="kiosk-header">
      <img class="form-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <h1>My Training</h1>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/training/identify" class="form-outer-panel">
      <div class="form-section">
        <h2>Who are you?</h2>
        <p class="hint">Choose your name to see your assigned training.</p>
        <div class="stack-form">
          <select name="memberId" required>
            <option value="">Select your name&hellip;</option>
            <% members.forEach(function(m) { %>
              <option value="<%= m.id %>"><%= m.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <button type="submit" class="primary-btn">Continue</button>
    </form>
  </main>
</body>
</html>
