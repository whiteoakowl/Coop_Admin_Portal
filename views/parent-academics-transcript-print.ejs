<!doctype html>
<html lang="en">
<head>
  <%# A real request: "the download should be a pdf of exactly how it
      would also look when printing." utils/pdfRender.js renders this
      exact view (via req.app.render(), never through a real HTTP
      request) to build the Download PDF - pdfBaseUrl is only ever set
      for that internal render, since Chromium otherwise has no "current
      page URL" of its own to resolve this page's relative asset URLs
      (/css/styles.css, /img/logo.png) against. A real person visiting
      this same page in their own browser (the Print button's own
      target) never sets it, so the page's own URL already does that
      job and this <base> tag is simply absent. %>
  <% if (typeof pdfBaseUrl !== 'undefined' && pdfBaseUrl) { %><base href="<%= pdfBaseUrl %>/"><% } %>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: typeof portalTitle !== 'undefined' && portalTitle ? portalTitle : 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="no-print"><a href="<%= typeof backHref !== 'undefined' && backHref ? backHref : '/parent/academics' %>">&larr; Transcripts</a></p>
    <button type="button" class="roster-action-btn print-action-btn no-print" onclick="window.print()">Print</button>

    <%- include('partials/family-school-print-header', { familySettings, subtitle: 'Official Transcript' }) %>

    <section class="portal-dashboard-card portal-dashboard-card-wide">
      <h2><%= member.name %></h2>

      <% if (builder.schoolYears.length === 0) { %>
        <p class="hint">No classes on this transcript yet.</p>
      <% } else { %>
        <% builder.schoolYears.forEach(function(yr) { %>
          <h3><%= yr.schoolYear %></h3>
          <table class="roster-table condensed-table">
            <thead><tr><th>Class</th><th>Credits</th><th>Grade</th></tr></thead>
            <tbody>
              <% yr.entries.forEach(function(e) { %>
                <tr>
                  <td><%= e.class_name %></td>
                  <td><%= e.credit_hours %></td>
                  <td><%= e.grade_letter || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <p><%= yr.schoolYear %> GPA: <%= yr.gpa != null ? yr.gpa.toFixed(2) : 'N/A' %><% if (yr.gpa != null) { %> (<%= yr.totalCredits %> credits)<% } %></p>
        <% }); %>
        <p><strong>Cumulative GPA: <%= builder.cumulativeGpa != null ? builder.cumulativeGpa.toFixed(2) : 'N/A' %></strong><% if (builder.cumulativeGpa != null) { %> (<%= builder.cumulativeCredits %> total credits)<% } %></p>
      <% } %>
    </section>
  </main>
</body>
</html>
