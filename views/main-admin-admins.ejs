<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <%# A real request: "one blue button that says add/edit admin position
      and one for printing the admin roster list. Then you can click on
      each admin position in the list and it will open an edit window.
      Here you can add a member from the drop down list. Add email
      address, add phone number. Then the roles and permissions are
      listed below. Save button at the end. Admin list grid show admin
      position, admin name, phone, email, trash can at the end. Then we
      won't need a separate roles/permissions tab under settings." Also
      moved wholesale from Co-op Admin's own Settings > Admins tab -
      independent of members.member_type: an admin position never made a
      member "an Admin" by itself here, it now DOES (see
      utils/adminPositions.js's own syncMemberAdminStatus) - holding any
      position both marks member_type 'admin' (the star badge elsewhere)
      and grants the Main Admin portal role itself, the two things a
      separate manual toggle and the old standalone Roles & Permissions
      tab used to handle apart from this page. %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <%- include('partials/main-admin-settings-tabs', { activeSettingsTab: 'admins' }) %>
    <div class="grid-box-header">
      <h1>Admins</h1>
      <div class="roster-btn-row no-print">
        <button type="button" class="primary-btn" onclick="document.getElementById('add-position-dialog').showModal()">Add/Edit Admin Position</button>
        <button type="button" class="roster-action-btn" onclick="window.print()">Print</button>
      </div>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (rows.length === 0) { %>
      <p class="hint">No admin positions added yet.</p>
    <% } else { %>
      <div class="roster-scroll">
      <table class="roster-table">
        <thead><tr><th>Admin Position</th><th>Admin Name</th><th>Phone</th><th>Email</th><th></th></tr></thead>
        <tbody>
          <% rows.forEach(function(row) { %>
            <tr>
              <td>
                <button type="button" class="member-name-link" onclick="document.getElementById('edit-position-dialog-<%= row.position.id %>').showModal()"><%= row.position.title %></button>
              </td>
              <td><%= row.member ? row.member.name : '—' %></td>
              <td><%= (row.member && row.member.phone) || '—' %></td>
              <td><%= (row.member && row.member.email) || '—' %></td>
              <td class="no-print">
                <% if (row.member) { %>
                  <form method="POST" action="/main-admin/admins/positions/<%= row.position.id %>/members/<%= row.member.id %>/remove" data-confirm="Remove <%= row.member.name %> from <%= row.position.title %>?">
                    <button type="submit" class="icon-btn icon-btn-danger" aria-label="Remove <%= row.member.name %> from <%= row.position.title %>" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/main-admin/admins/positions/<%= row.position.id %>/delete" data-confirm="Delete &quot;<%= row.position.title %>&quot;?">
                    <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= row.position.title %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>

    <dialog id="add-position-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/admins/positions/bulk-save">
        <h3>Add/Edit Admin Position</h3>
        <% if (adminPositions.length === 0) { %>
          <p class="hint">No positions yet &mdash; add one below.</p>
        <% } else { %>
          <div class="store-category-list">
            <% adminPositions.forEach(function(p) { %>
              <div class="store-category-row">
                <input type="hidden" name="positionId" value="<%= p.id %>" />
                <input type="text" name="positionTitle" value="<%= p.title %>" required />
              </div>
            <% }); %>
          </div>
        <% } %>
        <label for="new-position-title">New Position
          <input id="new-position-title" type="text" name="newPositionTitle" placeholder="e.g. Treasurer" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Save</button>
        </div>
      </form>
    </dialog>

    <% adminPositions.forEach(function(p) { %>
      <dialog id="edit-position-dialog-<%= p.id %>" class="member-picker-dialog role-permissions-dialog">
        <form method="POST" action="/main-admin/admins/positions/<%= p.id %>/update">
          <h3><%= p.title %></h3>
          <label for="edit-position-member-<%= p.id %>">Member
            <select id="edit-position-member-<%= p.id %>" name="memberId">
              <option value="">Add or update a leader&hellip;</option>
              <% memberOptions.forEach(function(m) { %>
                <option value="<%= m.id %>"><%= m.name %></option>
              <% }); %>
            </select>
          </label>
          <label for="edit-position-email-<%= p.id %>">Email
            <input id="edit-position-email-<%= p.id %>" type="email" name="email" placeholder="Chosen member's email" />
          </label>
          <label for="edit-position-phone-<%= p.id %>">Phone
            <input id="edit-position-phone-<%= p.id %>" type="text" name="phone" placeholder="Chosen member's phone" />
          </label>

          <h4>Roles &amp; Permissions</h4>
          <p class="hint">Shared by everyone currently assigned to <%= p.title %>.</p>
          <div class="permission-checkbox-grid">
            <% permissions.forEach(function(perm) { %>
              <label class="checkbox-option" title="<%= perm.description || '' %>">
                <input type="checkbox" name="permissionIds" value="<%= perm.id %>" <%= (positionPermissionIds[p.id] || []).indexOf(perm.id) !== -1 ? 'checked' : '' %> />
                <%= perm.label %>
              </label>
            <% }); %>
          </div>

          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
            <button type="submit" class="primary-btn">Save</button>
          </div>
        </form>
      </dialog>
    <% }); %>
  </main>
</body>
</html>
