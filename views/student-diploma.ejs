<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Diploma</h1>

    <% if (!diploma) { %>
      <p class="roster-empty">No diploma has been issued yet.</p>
    <% } else { %>
      <a class="roster-action-btn print-action-btn no-print" href="/student/diploma/print" target="_blank">Print</a>
      <%- include('partials/diploma-certificate', { diploma, member }) %>
    <% } %>
  </main>
</body>
</html>
