<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <%# A real request: "Should be able to edit or add menu tabs to the
        homepage." An admin-editable list of label+URL links (Main
        Admin > Settings > Public Homepage's own Menu Tabs section,
        utils/homepage.js) - empty by default (this section simply
        doesn't render until an admin adds at least one), not a fixed
        set of hardcoded page links. %>
    <% if (menuItems.length > 0) { %>
      <nav class="site-header-menu" aria-label="Site menu">
        <% menuItems.forEach(function(item) { %>
          <a href="<%= item.url %>"><%= item.label %></a>
        <% }); %>
      </nav>
    <% } %>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <%
      // A real request: "edit the entire homepage like you would on
      // Spotify or wix. Drag and drop images and text of different size
      // choices. Add buttons and links." Replaces the old fixed Hero/
      // About/Why Families Join Us sections (each a single hardcoded
      // textarea on site_settings) with homepage_blocks - an ordered
      // list of text/image/button blocks the admin builds from Main
      // Admin > Settings > Public Homepage. Announcements/FAQ/the "Ready
      // to join" CTA below stay their own fixed, data-driven sections -
      // unrelated systems, not blocks.
    %>
    <section class="site-section" id="homepage-blocks">
      <div class="site-section-inner">
        <% blocks.forEach(function(b) { %>
          <% if (b.block_type === 'text') { %>
            <div class="homepage-block homepage-block-text homepage-text-<%= b.text_size || 'medium' %>"><%= b.text_body %></div>
          <% } else if (b.block_type === 'image' && b.imageUrl) { %>
            <div class="homepage-block homepage-block-image homepage-image-<%= b.image_size || 'medium' %>">
              <img src="<%= b.imageUrl %>" alt="<%= b.image_alt || '' %>" />
            </div>
          <% } else if (b.block_type === 'button') { %>
            <div class="homepage-block homepage-block-button">
              <a class="primary-btn" href="<%= b.button_url %>"><%= b.button_label %></a>
            </div>
          <% } %>
        <% }); %>
      </div>
    </section>

    <%# A real request: "Check box to be viewable to public on public
        homepage" - a read-only showcase of whichever Schedule Grids an
        admin opted into (Co-op Admin > Classes > Edit Schedule Grids'
        own new checkbox, routes/public-site.js's own publicShowcaseClasses).
        Registering still requires Member Registration/Login, same as the
        "Ready to join" CTA already at the bottom of this page. %>
    <% if (showcaseClasses.length > 0) { %>
      <section class="site-section site-section-alt">
        <div class="site-section-inner">
          <h2>Classes We Offer</h2>
          <div class="site-class-showcase-list">
            <% showcaseClasses.forEach(function(c) { %>
              <div class="site-class-showcase-card" style="border-left-color: <%= c.color || '#EE9A4D' %>;">
                <span class="site-class-showcase-day"><%= c.dayLabel %></span>
                <h3><%= c.className %></h3>
                <% if (c.timeLabel) { %><p class="site-class-showcase-time"><%= c.timeLabel %></p><% } %>
              </div>
            <% }); %>
          </div>
          <a class="primary-btn" href="/register">Member Registration to Enroll</a>
        </div>
      </section>
    <% } %>

    <% if (announcements.length > 0) { %>
      <section class="site-section">
        <div class="site-section-inner">
          <h2>Announcements</h2>
          <div class="site-announcement-list">
            <% announcements.forEach(function(a) { %>
              <div class="site-announcement-card">
                <span class="site-announcement-date"><%= a.publishedLabel %></span>
                <h3><%= a.title %></h3>
                <div class="forum-editable-display"><%- a.body %></div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (faqs.length > 0) { %>
      <section class="site-section site-section-alt">
        <div class="site-section-inner">
          <h2>Frequently Asked Questions</h2>
          <div class="site-faq-list">
            <% faqs.forEach(function(faq) { %>
              <details class="site-faq-item">
                <summary><%= faq.question %></summary>
                <p><%= faq.answer %></p>
              </details>
            <% }); %>
          </div>
        </div>
      </section>
    <% } %>

    <section class="site-cta">
      <h2>Ready to join <%= settings.org_name %>?</h2>
      <p>Create your account and we'll take it from there.</p>
      <a class="primary-btn" href="/register">Member Registration</a>
    </section>
  </main>

  <footer class="site-footer">
    <p>
      <% if (settings.contact_email) { %><a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a><% } %>
      <% if (settings.contact_phone) { %> &middot; <%= settings.contact_phone %><% } %>
    </p>
    <p>&copy; <%= new Date().getFullYear() %> <%= settings.org_name %>. All rights reserved.</p>
  </footer>
</body>
</html>
