<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="site-section">
      <div class="site-section-inner">
        <p><a href="/photos">&larr; All Albums</a></p>
        <div class="roster-toolbar">
          <div><h1><%= album.title %></h1></div>
          <% if (photos.length > 0) { %>
            <div class="roster-btn-row">
              <a class="roster-action-btn" href="/photos/<%= album.id %>/download">Download Album</a>
            </div>
          <% } %>
        </div>
        <% if (album.description) { %><p><%= album.description %></p><% } %>

        <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

        <%# A real request: "admins can create albums that members can
            upload to. members can't upload albums." No create-album
            form anywhere on this member-facing side - only an existing
            album's own upload, and only once signed in. %>
        <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
          <form method="POST" action="/photos/<%= album.id %>/upload" enctype="multipart/form-data" class="member-form-grid">
            <label class="member-form-full">Add Photos
              <input type="file" name="images" accept="image/*" multiple required />
            </label>
            <label class="member-form-full">Caption <span class="hint">(optional, applies to all photos in this upload)</span>
              <input type="text" name="caption" placeholder="e.g. Field trip day" />
            </label>
            <div class="member-form-full">
              <button type="submit" class="primary-btn">Upload</button>
            </div>
          </form>
        <% } %>

        <% if (photos.length === 0) { %>
          <p class="roster-empty">No photos in this album yet.</p>
        <% } else { %>
          <div class="team-card-grid">
            <% photos.forEach(function(p) { %>
              <div class="team-col">
                <div class="team-info-card">
                  <img src="/photos/<%= album.id %>/image/<%= p.id %>" alt="<%= p.caption || '' %>" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius);" />
                  <% if (p.caption) { %><p class="hint"><%= p.caption %></p><% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>
