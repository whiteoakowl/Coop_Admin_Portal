<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="site-section">
      <div class="site-section-inner document-view-main">
        <% if (doc.image_path) { %>
          <img class="document-view-image" src="/documents/<%= doc.public_token %>/image" alt="" />
        <% } %>
        <h1><%= doc.title %></h1>
        <div class="document-view-frame-wrap">
          <iframe class="document-view-frame" src="/documents/<%= doc.public_token %>/file" title="<%= doc.title %>"></iframe>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
