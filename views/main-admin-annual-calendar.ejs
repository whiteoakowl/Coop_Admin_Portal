<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Main Admin' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="roster-toolbar no-print">
      <h1>Annual Calendar</h1>
    </div>

    <% if (notice) { %><p class="notice-banner"><%= notice %></p><% } %>
    <% if (error) { %><p class="notice-banner notice-banner-error"><%= error %></p><% } %>

    <%# A real request: "Create key button. Be able to add a label and
        color for each key item. Key shows on page. Be able to click
        each key then click on the calendar dates to color/key each one
        that particular key. Click on a new key and repeat the process."
        data-annual-calendar-key-bar tracks which key button is
        currently "active" (public/js/annual-calendar.js) - the
        calendar grid click handler below reads that to decide which
        key a date click should apply. %>
    <div class="roster-btn-row roster-btn-row-fit-text fs-attendance-row-left no-print" data-annual-calendar-key-bar>
      <% keys.forEach(function(k) { %>
        <button type="button" class="annual-calendar-key-btn" data-annual-calendar-key-btn data-key-id="<%= k.id %>" data-key-label="<%= k.label %>" style="--key-color: <%= k.color %>;" title="Click, then click calendar dates to apply &ldquo;<%= k.label %>&rdquo;">
          <span class="annual-calendar-key-swatch"></span><%= k.label %>
        </button>
      <% }); %>
    </div>

    <%# A real request: "Edit calendar colors button and add/edit key
        button should be on the same row side by side." Their own
        dedicated row, kept separate from the per-key swatch buttons
        above so they always stay next to each other regardless of how
        many keys exist (same "split into sibling .roster-btn-row divs"
        convention this site already uses - see styles.css's own
        .roster-btn-row + .roster-btn-row rule). %>
    <div class="roster-btn-row roster-btn-row-fit-text fs-attendance-row-left annual-calendar-key-actions-row no-print">
      <button type="button" class="roster-action-btn" onclick="document.getElementById('annual-calendar-keys-dialog').showModal()">Add/Edit Key</button>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('annual-calendar-colors-dialog').showModal()">Edit Calendar Colors</button>
    </div>

    <%# A real request: "Print, and pdf icons should be on the last row
        just above the calendar." Their own row, immediately above the
        12-month grid instead of up with the other toolbar rows. A later
        real request ("Year dropdown should be first in the row with the
        pdf, export and print icons. Same row side by side") moved the
        School Year picker (previously its own row up near the title)
        in here too, first. Picking a year transparently finds-or-
        creates its calendar behind the scenes (routes/main-admin-
        annual-calendar.js), so there's no separate "+ Create Calendar"
        step. %>
    <div class="roster-btn-row roster-btn-row-fit-text fs-attendance-row-left no-print">
      <form method="GET" action="/main-admin/annual-calendar">
        <select name="schoolYear" aria-label="School Year" onchange="this.form.submit()">
          <% schoolYearStartYears.forEach(function(y) { %>
            <option value="<%= y %>" <%= selectedStartYear === y ? 'selected' : '' %>><%= y %>-<%= y + 1 %></option>
          <% }); %>
        </select>
      </form>
      <a class="icon-btn" href="/main-admin/annual-calendar/print?schoolYear=<%= selectedStartYear %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
      <a class="icon-btn" href="/main-admin/annual-calendar/download.pdf?schoolYear=<%= selectedStartYear %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
    </div>

    <%# A real request: "Add edit calendar colors buttons... set the
            color for the month row and set the color for the days of
            the week row." --annual-calendar-month-color/--annual-
            calendar-weekday-color are only set here when an admin has
            actually picked one - public/css/styles.css's own var()
            fallbacks (the site's existing blue/grey defaults) cover
            every calendar that hasn't, including Family Attendance,
            which never renders this attribute at all. %>
        <div
          class="annual-calendar-months-grid"
          data-annual-calendar-grid
          data-calendar-id="<%= calendar.id %>"
          data-toggle-url="/main-admin/annual-calendar/days/toggle"
          <% if (calendar.month_row_color || calendar.weekday_row_color) { %>
            style="<%= calendar.month_row_color ? `--annual-calendar-month-color: ${calendar.month_row_color};` : '' %><%= calendar.weekday_row_color ? `--annual-calendar-weekday-color: ${calendar.weekday_row_color};` : '' %>"
          <% } %>
        >
          <% months.forEach(function(m) { %>
            <div class="annual-calendar-month">
              <h3><%= MONTH_NAMES[m.month - 1] %> <%= m.year %></h3>
              <table class="fs-attendance-calendar annual-calendar-table">
                <thead>
                  <tr><th>Su</th><th>Mo</th><th>Tu</th><th>We</th><th>Th</th><th>Fr</th><th>Sa</th></tr>
                </thead>
                <tbody>
                  <% m.weeks.forEach(function(week) { %>
                    <tr>
                      <% week.forEach(function(d) { %>
                        <% if (!d) { %>
                          <td class="fs-attendance-day fs-attendance-day-empty"></td>
                        <% } else {
                          var keyed = m.keyByDate[d.date];
                        %>
                          <td class="fs-attendance-day" data-annual-calendar-day data-date="<%= d.date %>" <%- keyed ? `style="background-color: ${keyed.color};"` : '' %>><%= d.day %></td>
                        <% } %>
                      <% }); %>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% }); %>
        </div>

        <%# A real request: "Create key button should say add/edit key...
            Delete description. Be able to add a new key and stay in the
            popup and it will appear in the list below. Be able to edit
            existing keys and click save changes." Add Key is its own
            AJAX form (public/js/annual-calendar-keys.js) that appends
            the new row without closing the dialog; existing rows are
            plain inputs with no auto-submit, saved all at once by the
            Save Changes button below; each row's trash icon deletes
            that one key via AJAX, same no-page-reload shape public/js/
            annual-planner-curriculum.js's own delete already uses. %>
        <dialog id="annual-calendar-keys-dialog" class="member-picker-dialog">
          <h3>Add/Edit Key</h3>
          <form id="annual-calendar-add-key-form" class="stack-form" data-calendar-id="<%= calendar.id %>">
            <div class="member-form-grid">
              <label>Label
                <input type="text" name="label" placeholder="e.g. Holiday" required />
              </label>
              <label>Color
                <input type="color" name="color" value="#EE9A4D" />
              </label>
            </div>
            <div class="member-form-footer">
              <div class="member-form-footer-edit">
                <button type="submit" class="primary-btn">+ Add Key</button>
              </div>
            </div>
          </form>

          <div class="table-shrink-wrap" <%= keys.length === 0 ? 'hidden' : '' %> id="annual-calendar-keys-table-wrap">
            <table class="admin-table">
              <thead><tr><th>Label</th><th>Color</th><th></th></tr></thead>
              <tbody id="annual-calendar-keys-tbody">
                <% keys.forEach(function(k) { %>
                  <tr data-key-row data-key-id="<%= k.id %>">
                    <td><input type="text" name="label" value="<%= k.label %>" aria-label="Label for <%= k.label %>" /></td>
                    <td><input type="color" name="color" value="<%= k.color %>" aria-label="Color for <%= k.label %>" /></td>
                    <td><button type="button" class="icon-btn icon-btn-danger" data-delete-key aria-label="Delete key" title="Delete key"><svg class="icon"><use href="#icon-trash"/></svg></button></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <p class="roster-empty" id="annual-calendar-keys-empty" <%= keys.length > 0 ? 'hidden' : '' %>>No keys yet. Add one above.</p>

          <div class="notes-dialog-actions">
            <button type="button" class="primary-btn" id="annual-calendar-save-keys-btn">Save Changes</button>
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
          </div>
        </dialog>

        <%# A real request: "Add edit calendar colors buttons. This
            button will allow you to set the color for the month row and
            set the color for the days of the week row." AJAX save
            (public/js/annual-calendar-colors.js) applies the picked
            colors to the grid above immediately, no page reload - same
            shape every other dialog on this page already uses. %>
        <dialog id="annual-calendar-colors-dialog" class="member-picker-dialog">
          <h3>Edit Calendar Colors</h3>
          <form id="annual-calendar-colors-form" class="stack-form" data-calendar-id="<%= calendar.id %>">
            <div class="member-form-grid">
              <label>Month Row Color
                <input type="color" name="monthRowColor" value="<%= calendar.month_row_color || annualCalendarDefaults.monthRowColor %>" />
              </label>
              <label>Days of the Week Row Color
                <input type="color" name="weekdayRowColor" value="<%= calendar.weekday_row_color || annualCalendarDefaults.weekdayRowColor %>" />
              </label>
            </div>
          </form>
          <div class="notes-dialog-actions">
            <button type="button" class="primary-btn" id="annual-calendar-save-colors-btn">Save Changes</button>
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
          </div>
        </dialog>
  </main>
  <script src="/js/annual-calendar.js"></script>
  <script src="/js/annual-calendar-keys.js"></script>
  <script src="/js/annual-calendar-colors.js"></script>
</body>
</html>
