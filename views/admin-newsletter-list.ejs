<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1>Newsletter</h1>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('new-issue-dialog').showModal()">+ New Issue</button>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <details class="manage-section" style="margin-bottom: 1rem;" <%= schedule.enabled ? 'open' : '' %>>
      <summary><svg class="icon"><use href="#icon-clock"/></svg> Weekly Send Schedule</summary>
      <p class="hint" style="margin-top: 0.5rem;">
        Controls when the newsletter would go out automatically once a real email provider is connected - no email
        provider is configured yet, so nothing sends automatically regardless of this setting. Issues can still be
        marked sent manually below.
      </p>
      <form method="POST" action="/main-admin/newsletter/settings" class="stack-form" style="margin-top: 0.75rem;">
        <label class="checkbox-option">
          <input type="checkbox" name="enabled" value="1" <%= schedule.enabled ? 'checked' : '' %> />
          Send automatically every week
        </label>
        <div class="class-form-row">
          <div class="class-form-field">
            <span class="class-form-field-label">Day</span>
            <select name="day">
              <% weekdays.forEach(function(d) { %>
                <option value="<%= d %>" <%= schedule.day === d ? 'selected' : '' %>><%= d %></option>
              <% }); %>
            </select>
          </div>
          <div class="class-form-field">
            <span class="class-form-field-label">Time</span>
            <input type="time" name="time" value="<%= schedule.time %>" />
          </div>
        </div>
        <div>
          <button type="submit" class="primary-btn">Save Schedule</button>
        </div>
      </form>
    </details>

    <% if (issues.length === 0) { %>
      <p class="roster-empty">No issues yet &mdash; create one above.</p>
    <% } %>

    <table class="roster-table members-table condensed-table">
      <thead>
        <tr><th>Subject</th><th>Status</th><th>Scheduled</th><th>Sent</th><th>Recipients</th><th></th></tr>
      </thead>
      <tbody>
        <% issues.forEach(function(i) { %>
          <tr>
            <td><a href="/main-admin/newsletter/<%= i.id %>/edit"><%= i.subject %></a></td>
            <td><span class="badge-pill badge-pill-<%= i.status === 'sent' ? 'green' : i.status === 'scheduled' ? 'orange' : 'gray' %>"><%= i.status.charAt(0).toUpperCase() + i.status.slice(1) %></span></td>
            <td><%= i.scheduled_at || '' %></td>
            <td><%= i.sent_at || '' %></td>
            <td><%= i.recipient_count != null ? i.recipient_count : '' %></td>
            <td><a class="roster-action-btn" href="/main-admin/newsletter/<%= i.id %>/edit">Edit</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <dialog id="new-issue-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/newsletter">
        <h3>New Issue</h3>
        <p class="hint">Content is assembled automatically from upcoming events, reminders, this week's classes, announcements, and the business directory. You can edit it before sending.</p>
        <label>Subject
          <input type="text" name="subject" required placeholder="This Week at the Co-op" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create Draft</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
