<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Communication' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/diplomas', icon: 'badge', label: 'Diplomas' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p><a href="/main-admin/announcements/email">&larr; Back</a></p>
    <h1>Compose Email</h1>
    <p class="hint"><%= recipients.length %> recipient<%= recipients.length === 1 ? '' : 's' %>: <%= recipients.map(function(r) { return r.name; }).join(', ') %></p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/main-admin/announcements/email/send" id="email-compose-form" class="stack-form member-form-page-panel">
      <% recipients.forEach(function(r) { %>
        <input type="hidden" name="recipientIds" value="<%= r.accountId %>" />
      <% }); %>

      <label class="member-form-full">Reply-To (optional)
        <input type="email" name="replyTo" placeholder="e.g. board@ourcoop.org" />
      </label>
      <label class="member-form-full">Send To (optional)
        <input type="email" name="sendTo" placeholder="e.g. another@example.com" />
      </label>

      <label class="member-form-full">Subject
        <input type="text" name="subject" placeholder="e.g. Wednesday session cancelled" required />
      </label>
      <div class="member-form-full" data-forum-editor>
        <label>Message</label>
        <%- include('partials/forum-editor-toolbar') %>
        <div class="forum-editable" data-forum-editable contenteditable="true"></div>
        <input type="hidden" name="body" data-forum-body-input />
      </div>

      <%# A real request: "radio buttons for choose send immediately or
          send in the future. Send email button. After click the send
          email button for send in the future it will ask you to pick a
          date and time to send. And save." Same popup pattern
          Announcements' own Schedule for Later dialog uses (date input +
          partials/time-select + public/js/event-date-time-picker.js) -
          this hidden field IS that dialog's own data-date-time-hidden
          target (one input doing both jobs, matching partials/date-range-
          picker.ejs's own convention), so it's already kept in sync by the
          time the dialog's own Save button below ever runs. %>
      <input type="hidden" name="scheduledAt" id="email-scheduled-at" data-date-time-hidden="emailSchedule" />
      <div class="member-form-full">
        <span class="checkbox-group-label">Send</span>
        <label class="checkbox-option">
          <input type="radio" name="sendOption" value="now" checked data-send-option />
          Send right away
        </label>
        <label class="checkbox-option">
          <input type="radio" name="sendOption" value="schedule" data-send-option />
          Schedule for later
        </label>
      </div>

      <div class="member-form-footer">
        <div class="member-form-footer-edit">
          <button type="button" class="primary-btn" id="email-send-btn">Send Email</button>
        </div>
      </div>
    </form>

    <dialog id="schedule-email-dialog" class="member-picker-dialog">
      <h3>Schedule for Later</h3>
      <p class="hint">Saves this email to send later - an admin still has to come back and send it, same as a scheduled announcement or text.</p>
      <div class="date-time-two-col-row registration-dates-modern">
        <label>Date
          <input type="date" data-date-time-date data-date-time-group="emailSchedule" />
        </label>
        <label>Time
          <%- include('partials/time-select', { dataGroup: 'emailSchedule' }) %>
        </label>
      </div>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
        <button type="button" class="primary-btn" id="schedule-email-confirm">Save</button>
      </div>
    </dialog>
  </main>
  <script src="/js/forum-editor.js"></script>
  <script src="/js/event-date-time-picker.js"></script>
  <script>
    document.getElementById('email-send-btn').addEventListener('click', function () {
      var sendOption = document.querySelector('[data-send-option]:checked').value;
      if (sendOption === 'schedule') {
        document.getElementById('schedule-email-dialog').showModal();
        return;
      }
      document.getElementById('email-compose-form').requestSubmit();
    });
    document.getElementById('schedule-email-confirm').addEventListener('click', function () {
      var hidden = document.getElementById('email-scheduled-at');
      if (!hidden.value) {
        alert('Choose a date and time first.');
        return;
      }
      document.getElementById('schedule-email-dialog').close();
      document.getElementById('email-compose-form').requestSubmit();
    });
  </script>
</body>
</html>
