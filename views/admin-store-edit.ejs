<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/users', icon: 'user-check', label: 'Users' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Announcements' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/sections', icon: 'grid', label: 'Sections' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/roles', icon: 'sliders', label: 'Roles & Permissions' },
      { href: '/main-admin/website', icon: 'palette', label: 'Website' },
      { href: '/main-admin/events', icon: 'calendar-check', label: 'Events' },
      { href: '/main-admin/directory', icon: 'map-pin', label: 'Business Directory' },
      { href: '/main-admin/classifieds', icon: 'tag', label: 'Classifieds' },
      { href: '/main-admin/member-directory', icon: 'users', label: 'Member Directory' },
      { href: '/main-admin/forums', icon: 'users', label: 'Chat' },
      { href: '/main-admin/forms', icon: 'clipboard-list', label: 'Custom Forms' },
      { href: '/main-admin/accounting', icon: 'file-text', label: 'Accounting' },
      { href: '/main-admin/store', icon: 'tag', label: 'Store' },
      { href: '/main-admin/newsletter', icon: 'mail', label: 'Newsletter' },
      { href: '/main-admin/notifications', icon: 'bell', label: 'Notifications' },
      { href: '/main-admin/photos', icon: 'image', label: 'Photos' },
      { href: '/main-admin/publications', icon: 'book', label: 'Publications' },
      { href: '/main-admin/audit-log', icon: 'file-text', label: 'Audit Log' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= product.name %></h1>
      <span class="badge-pill badge-pill-<%= product.status === 'active' ? 'green' : product.status === 'archived' ? 'gray' : 'orange' %>"><%= product.status.charAt(0).toUpperCase() + product.status.slice(1) %></span>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="roster-toolbar">
      <div class="roster-btn-row">
        <a class="roster-action-btn" href="/main-admin/store">&larr; All Products</a>
        <% if (product.status !== 'active') { %>
          <form method="POST" action="/main-admin/store/<%= product.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="active" />
            <button type="submit" class="roster-action-btn">Activate</button>
          </form>
        <% } %>
        <% if (product.status !== 'archived') { %>
          <form method="POST" action="/main-admin/store/<%= product.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="archived" />
            <button type="submit" class="roster-action-btn roster-action-btn-danger">Archive</button>
          </form>
        <% } %>
        <form method="POST" action="/main-admin/store/<%= product.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= product.name %>&quot;? This cannot be undone.">
          <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
        </form>
      </div>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Details</h2></div>
      <form method="POST" action="/main-admin/store/<%= product.id %>" class="member-form-grid">
        <label class="member-form-full">Name
          <input type="text" name="name" value="<%= product.name %>" required />
        </label>
        <label class="member-form-full">Description
          <textarea name="description" rows="3"><%= product.description || '' %></textarea>
        </label>
        <label>Price ($)
          <input type="number" name="price" min="0" step="0.01" value="<%= (product.price_cents / 100).toFixed(2) %>" required />
        </label>
        <label>Inventory (blank = unlimited)
          <input type="number" name="inventoryCount" min="0" value="<%= product.inventory_count ?? '' %>" />
        </label>
        <label>Availability
          <select name="availability">
            <option value="both" <%= product.availability === 'both' ? 'selected' : '' %>>Online + In-person</option>
            <option value="online" <%= product.availability === 'online' ? 'selected' : '' %>>Online only</option>
            <option value="in_person" <%= product.availability === 'in_person' ? 'selected' : '' %>>In-person only</option>
          </select>
        </label>
        <div class="member-form-full">
          <button type="submit" class="primary-btn">Save</button>
        </div>
      </form>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Image</h2></div>
      <% if (imageUrl) { %>
        <img src="<%= imageUrl %>" alt="" style="max-width: 320px; border-radius: var(--radius); display: block; margin-bottom: 0.75rem;" />
      <% } %>
      <form method="POST" action="/main-admin/store/<%= product.id %>/image" enctype="multipart/form-data" class="training-resource-upload-form">
        <label>Choose an Image
          <input type="file" name="image" accept="image/*" required />
        </label>
        <button type="submit" class="btn-secondary">Upload</button>
      </form>
    </div>
  </main>
</body>
</html>
