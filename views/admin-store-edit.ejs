<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= product.name %></h1>
      <span class="badge-pill badge-pill-<%= product.status === 'active' ? 'green' : product.status === 'archived' ? 'gray' : 'orange' %>"><%= product.status.charAt(0).toUpperCase() + product.status.slice(1) %></span>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="roster-toolbar">
      <div class="roster-btn-row">
        <a class="roster-action-btn" href="/main-admin/store">&larr; All Products</a>
        <% if (product.status !== 'active') { %>
          <form method="POST" action="/main-admin/store/<%= product.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="active" />
            <button type="submit" class="roster-action-btn">Activate</button>
          </form>
        <% } %>
        <% if (product.status !== 'archived') { %>
          <form method="POST" action="/main-admin/store/<%= product.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="archived" />
            <button type="submit" class="roster-action-btn roster-action-btn-danger">Archive</button>
          </form>
        <% } %>
        <form method="POST" action="/main-admin/store/<%= product.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= product.name %>&quot;? This cannot be undone.">
          <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
        </form>
      </div>
    </div>

    <%# A real request: "only one save button at the bottom. Upload button
        should be on the same row as choose file." Details and Options
        used to be two separate <form>s, each with its own Save button
        (plus a third, separate Upload button for the Image section) -
        same "one form, Save moved to the very last thing on the page"
        restructuring views/admin-events-builder.ejs's own Details tab
        already uses for the same request there. Image stays its own
        <form> (an HTML form can't nest inside another, and a file upload
        needs its own enctype/multipart body) - its Upload button submits
        and shows the photo immediately, with no need to also click Save. %>
    <div class="manage-section">
      <div class="grid-box-header"><h2>Details</h2></div>
      <form method="POST" action="/main-admin/store/<%= product.id %>" class="member-form-grid" id="details-form">
        <label class="member-form-full">Name
          <input type="text" name="name" value="<%= product.name %>" required />
        </label>
        <label class="member-form-full">Description
          <textarea name="description" rows="3"><%= product.description || '' %></textarea>
        </label>
        <label>Price ($)
          <input type="number" name="price" min="0" step="0.01" value="<%= (product.price_cents / 100).toFixed(2) %>" required />
        </label>
        <label>Category
          <select name="categoryId">
            <option value="">Uncategorized</option>
            <% categories.forEach(function(c) { %><option value="<%= c.id %>" <%= product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
          </select>
        </label>
        <label>Inventory (blank = unlimited) <span class="hint">(ignored once this product has any Options below - each option tracks its own stock instead)</span>
          <input type="number" name="inventoryCount" min="0" value="<%= product.inventory_count ?? '' %>" />
        </label>
        <label>Availability
          <select name="availability">
            <option value="both" <%= product.availability === 'both' ? 'selected' : '' %>>Online + In-person</option>
            <option value="online" <%= product.availability === 'online' ? 'selected' : '' %>>Online only</option>
            <option value="in_person" <%= product.availability === 'in_person' ? 'selected' : '' %>>In-person only</option>
          </select>
        </label>
      </form>
    </div>

    <%
    // A real request: "add option will be a drop down menu on parent/
    // student portals. On main admin shop, product, when you add an
    // option there will be sub categories to add variables, each with
    // their own price. This setup is like shopify." A product can have
    // several option GROUPS at once (e.g. "Size" and "Color"), each
    // rendered as its own dropdown at checkout; a group's VALUES each
    // have their own optional price (blank = adds nothing) and stock
    // (qty, blank = unlimited) - see utils/store.js's own buildOrderLines
    // for how the final price sums every selected value's price across
    // every group, treating a blank one as $0. Whole-tree replace on Save
    // (public/js/store-product-options.js appends/removes groups/values
    // purely client-side; nothing here needs a stable id). Every row
    // posts as part of the Details form above (form="details-form"
    // below) - not a separate <form> of their own - so the one Save
    // button at the bottom of the page saves everything in one request.
    %>
    <div class="manage-section">
      <div class="grid-box-header"><h2>Options</h2></div>
      <% if (legacySizes.length > 0) { %>
        <p class="hint">This product previously had plain sizes (<%= legacySizes.join(', ') %>) with no price/stock of their own - add them below as a real option group to keep them.</p>
      <% } %>
      <div class="store-option-groups-list" data-groups-list data-next-index="<%= optionGroups.length %>">
        <% optionGroups.forEach(function(group, gIdx) { %>
          <div class="store-option-group" data-group-row data-group-index="<%= gIdx %>">
            <div class="store-option-group-header">
              <input type="text" class="store-group-name" form="details-form" name="groups[<%= gIdx %>][name]" value="<%= group.name %>" placeholder="Group title (e.g. Size)" required />
              <button type="button" class="icon-btn icon-btn-danger" data-remove-group aria-label="Remove group" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
            </div>
            <div class="store-options-list" data-values-list data-next-index="<%= group.values.length %>">
              <% group.values.forEach(function(o, vIdx) { %>
                <div class="store-option-row" data-option-row>
                  <input type="text" class="store-option-name" form="details-form" name="groups[<%= gIdx %>][values][<%= vIdx %>][name]" value="<%= o.name %>" placeholder="Value (e.g. Small)" required />
                  <label class="store-option-price-label">$<input type="number" form="details-form" name="groups[<%= gIdx %>][values][<%= vIdx %>][price]" min="0" step="0.01" value="<%= o.price_cents != null ? (o.price_cents / 100).toFixed(2) : '' %>" placeholder="optional" /></label>
                  <input type="number" class="store-option-qty" form="details-form" name="groups[<%= gIdx %>][values][<%= vIdx %>][qty]" min="0" placeholder="Qty" value="<%= o.quantity ?? '' %>" aria-label="Quantity (blank = unlimited)" />
                  <input type="hidden" form="details-form" name="groups[<%= gIdx %>][values][<%= vIdx %>][enabled]" value="0" />
                  <label class="store-option-enabled-toggle">
                    <input type="checkbox" form="details-form" name="groups[<%= gIdx %>][values][<%= vIdx %>][enabled]" value="1" <%= o.enabled ? 'checked' : '' %> /> Enabled
                  </label>
                  <button type="button" class="icon-btn icon-btn-danger" data-remove-option aria-label="Remove value" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </div>
              <% }); %>
            </div>
            <div class="roster-btn-row">
              <button type="button" class="btn-secondary" data-add-option data-add-option-form="details-form">+ Add Value</button>
            </div>
          </div>
        <% }); %>
      </div>
      <div class="roster-btn-row">
        <button type="button" class="btn-secondary" data-add-group data-add-option-form="details-form">+ Add Option Group</button>
      </div>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Image</h2></div>
      <% if (imageUrl) { %>
        <img src="<%= imageUrl %>" alt="" style="max-width: 320px; border-radius: var(--radius); display: block; margin-bottom: 0.75rem;" />
      <% } %>
      <form method="POST" action="/main-admin/store/<%= product.id %>/image" enctype="multipart/form-data" class="roster-btn-row">
        <input type="file" name="image" accept="image/*" required />
        <button type="submit" class="roster-action-btn" style="flex: 0 0 auto; min-width: 0;">Upload</button>
      </form>
    </div>

    <div class="member-form-full">
      <button type="submit" form="details-form" class="primary-btn">Save</button>
    </div>
  </main>
  <script src="/js/store-product-options.js"></script>
</body>
</html>
