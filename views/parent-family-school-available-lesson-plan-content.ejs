<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle no-print"><a href="/parent/family-school/classes/available-lesson-plans/<%= plan.id %>">&larr; <%= plan.title %></a></p>
    <h1><%= item.title || '(untitled)' %></h1>

    <%# "click on each assignment/lesson to view what is there." Plain
        read-only rendering of whichever one field this content item's
        own type actually uses - no edit controls, no delete, no
        submission/grading UI (there's no student attached to a shared
        template to submit anything). Mirrors the read-only fields
        views/partials/family-school-content-manage.ejs's own locked-
        plan branch already shows, just as its own standalone page. %>
    <div class="manage-section">
      <% if (item.type === 'video') { %>
        <% if (item.video_url) { %><p><a href="<%= item.video_url %>" target="_blank" rel="noopener">Video link</a></p><% } %>
        <% if (item.description) { %><p class="hint"><%= item.description %></p><% } %>
      <% } else if (item.type === 'text') { %>
        <div class="plain-text-display"><%= item.body || '' %></div>
      <% } else if (item.type === 'file') { %>
        <% if (item.attachmentUrl) { %><p><a href="<%= item.attachmentUrl %>" target="_blank" rel="noopener"><%= item.attachment_name || 'File' %></a></p><% } %>
        <% if (item.description) { %><p class="hint"><%= item.description %></p><% } %>
      <% } else if (item.type === 'quiz') { %>
        <% if (item.questions.length === 0) { %>
          <p class="hint">No questions yet.</p>
        <% } else { %>
          <ol class="lesson-outline-list">
            <% item.questions.forEach(function(q, idx) { %>
              <li class="manage-section">
                <p><strong><%= idx + 1 %>.</strong> <%= q.prompt %></p>
                <% if (q.type === 'multiple_choice') { %>
                  <ul>
                    <% q.choices.forEach(function(c) { %><li><%= c.label %></li><% }); %>
                  </ul>
                <% } else { %>
                  <p class="hint">Short answer</p>
                <% } %>
              </li>
            <% }); %>
          </ol>
        <% } %>
      <% } else if (item.type === 'assignment_upload' || item.type === 'assignment_submission') { %>
        <% if (item.body) { %><div class="forum-editable-display"><%- item.body %></div><% } %>
        <% if (item.attachmentUrl) { %><p><a href="<%= item.attachmentUrl %>" target="_blank" rel="noopener"><%= item.attachment_name || 'Attachment' %></a></p><% } %>
        <% if (item.points_possible != null) { %><p class="hint"><%= item.points_possible %> points</p><% } %>
      <% } %>
    </div>
  </main>
</body>
</html>
