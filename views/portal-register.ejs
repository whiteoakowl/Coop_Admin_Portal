<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="form-wrap">
    <div class="kiosk-header">
      <img class="form-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <h1>Request Membership</h1>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/register" id="portal-register-form" class="form-outer-panel" enctype="multipart/form-data">
      <div class="form-section">
        <h2>Parent / Guardian</h2>
        <div class="member-form-grid">
          <label>First Name
            <input type="text" name="firstName" value="<%= formValues.firstName || '' %>" required autocomplete="given-name" />
          </label>
          <label>Last Name
            <input type="text" name="lastName" value="<%= formValues.lastName || '' %>" required autocomplete="family-name" />
          </label>
          <label class="member-form-full">Email
            <input type="email" name="email" value="<%= formValues.email || '' %>" required autocomplete="email" />
          </label>
          <label class="member-form-full">Phone Number
            <input type="tel" id="register-phone-input" name="phone" value="<%= formValues.phone || '' %>" placeholder="555-123-4567" autocomplete="tel" />
          </label>
          <%# "Under first parent/guardian it should have address 1,
              address 2, city, state, zip code." %>
          <label class="member-form-full">Address
            <input type="text" name="address" value="<%= formValues.address || '' %>" autocomplete="address-line1" />
          </label>
          <label class="member-form-full">Address 2
            <input type="text" name="address2" value="<%= formValues.address2 || '' %>" autocomplete="address-line2" />
          </label>
          <label>City
            <input type="text" name="city" value="<%= formValues.city || '' %>" autocomplete="address-level2" />
          </label>
          <label>State
            <input type="text" name="state" value="<%= formValues.state || '' %>" autocomplete="address-level1" />
          </label>
          <label>Zip Code
            <input type="text" name="zip" value="<%= formValues.zip || '' %>" autocomplete="postal-code" />
          </label>
          <%# "Should be able to upload parent profile photos." %>
          <label class="member-form-full">Photo
            <input type="file" name="photo" accept="image/*" />
          </label>
        </div>
        <% parentFields.forEach(function(f) { %>
          <%- include('partials/membership-form-field', { field: f, namePrefix: 'customFields', values: formValues.customFields }) %>
        <% }); %>
      </div>

      <%# A real request: "Main admin portal. Members. Settings. Extra
          form fields. Add a general field section." A third kind of
          admin-defined question (utils/membershipFormFields.js's own
          'general' target, alongside 'parent'/'child') for something
          asked once per application rather than once per person - same
          flat 'customFields' top-level namePrefix the Parent/Guardian
          section above already uses (its own field ids never collide
          with these, so sharing the same req.body.customFields object
          is safe - see utils/membershipFormFields.js's own
          saveFieldValues, which only reads the keys matching the target
          it's called with). Only shown at all when an admin has actually
          defined one, same as every other optional section here. %>
      <% if (generalFields && generalFields.length > 0) { %>
        <div class="form-section">
          <h2>General</h2>
          <% generalFields.forEach(function(f) { %>
            <%- include('partials/membership-form-field', { field: f, namePrefix: 'customFields', values: formValues.customFields }) %>
          <% }); %>
        </div>
      <% } %>

      <%# A real request: "There is a +child button. There should also
          be an add adult button." A second (or third, etc.) parent/
          guardian, kept in its own section rather than crowded into the
          one inline block above - partials/register-adult-fields.ejs's
          own header comment for why there's no portal-login toggle here
          the way a child block gets one. %>
      <div class="form-section">
        <h2>Additional Parents / Guardians</h2>
        <div id="register-adults">
          <% (additionalParents && additionalParents.length ? additionalParents : []).forEach(function(adult, i) { %>
            <%- include('partials/register-adult-fields', { index: i, values: adult }) %>
          <% }); %>
        </div>
        <button type="button" class="btn-secondary" id="add-adult-btn">+ Add Adult</button>
      </div>

      <div class="form-section">
        <h2>Children</h2>
        <div id="register-children">
          <% (children && children.length ? children : []).forEach(function(child, i) { %>
            <%- include('partials/register-child-fields', { index: i, values: child, childFields }) %>
          <% }); %>
        </div>
        <button type="button" class="btn-secondary" id="add-child-btn">+ Add Child</button>
      </div>

      <div class="form-section">
        <h2>Account Login</h2>
        <div class="member-form-grid">
          <label>Password
            <input type="password" name="password" required minlength="8" autocomplete="new-password" />
          </label>
          <label>Confirm Password
            <input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" />
          </label>
        </div>
      </div>

      <%# 10DLC compliance - a real Telnyx campaign review rejection asked
          for "a link/screenshot of the opt-in form... showing the phone
          number field and full SMS opt-in language," separate from (and
          never bundled into) the handbook-read checkbox below: a
          dedicated, unchecked-by-default checkbox naming the brand,
          what SMS is used for, that message frequency varies, the
          standard "Msg & data rates may apply" notice, STOP/HELP
          instructions, and a link to the Privacy Policy - everything
          carriers want visible on the actual form that collects the
          phone number above, not just described after the fact. %>
      <div class="form-section">
        <h2>SMS Notifications</h2>
        <%# A real request: "the phone number field is far away from the
            request, should there be another phone number bar close to
            the permissions" - the actual <input name="phone"> stays up
            in Parent/Guardian (it's one real field, no duplicate to keep
            in sync), but this section echoes its current value live
            (public/js/portal-register-form.js) so this section alone -
            phone number, opt-in language, and the checkbox - is a
            self-contained screenshot/link target, without scrolling back
            up to prove a phone number was actually entered. %>
        <p class="hint">Texting: <strong id="sms-opt-in-phone-echo">(enter your phone number above)</strong></p>
        <%# A real request: "Agree to sms notification the check box
            should be on the first row next to the first word of the
            permission." The checkbox now sits inline, directly before
            "Sanford Homeschoolers may send..." (the permission text
            itself), on the same row/paragraph, instead of on its own
            separate line below it - the old standalone "I agree to
            receive..." sentence is folded into this same label rather
            than kept as a second, redundant agreement statement.
            name="smsOptIn"/the server-side handling in routes/portal-
            auth.js are unchanged. %>
        <label class="checkbox-option">
          <input type="checkbox" name="smsOptIn" value="1" />
          Sanford Homeschoolers may send SMS text messages to the phone number above for co-op announcements, event reminders, and schedule changes. Message frequency varies. Msg &amp; data rates may apply. Reply STOP to a message at any time to opt out, or HELP for help. See our <a href="/privacy-policy" target="_blank">Privacy Policy</a> and <a href="/terms-and-conditions" target="_blank">Terms and Conditions</a>.
        </label>
        <p class="hint">Optional - you can still register without opting in to SMS, and can change this later from your account's Notification Preferences.</p>
      </div>

      <%# A real request: "there should be a place at the bottom of the
          membership application to check a box after reading the policy
          handbook. can't check the box until you have scrolled through
          the entire handbook. can't submit application without checking
          the box." public/js/portal-register-form.js disables the
          checkbox until #handbook-scroll-box is scrolled to its bottom;
          routes/portal-auth.js's POST /register checks handbookRead
          again server-side since a disabled attribute is only ever a
          client-side nicety. %>
      <div class="form-section">
        <h2>Policy Handbook</h2>
        <%# A real request: "add an option to upload the policy handbook
            as a document, pdf, etc." - a plain download link, separate
            from (and not required for) the scroll-to-read checkbox
            below, which still only ever tracks the HTML content above. %>
        <% if (handbookFile) { %>
          <p class="hint"><a href="/handbook-file" target="_blank">Download a copy of the Policy Handbook (<%= handbookFile.originalName %>)</a></p>
        <% } %>
        <div id="handbook-scroll-box" class="handbook-scroll-box">
          <% if (handbookHtml && handbookHtml.trim()) { %>
            <%- handbookHtml %>
          <% } else { %>
            <p class="hint">No Policy Handbook has been posted yet.</p>
          <% } %>
        </div>
        <label class="checkbox-option">
          <input type="checkbox" name="handbookRead" id="handbook-read-checkbox" value="1" required disabled />
          I have read and agree to the Sanford Homeschoolers Policy Handbook.
        </label>
        <p class="hint" id="handbook-scroll-hint">Scroll through the handbook above to enable this checkbox.</p>
      </div>

      <%# A real request: "place at the bottom of the application for
          payment." Informational only - this app has no online "pay
          now" flow anywhere (see utils/membershipHandbook.js's own
          comment). %>
      <% if (paymentInfo.feeCents > 0 || paymentInfo.instructions) { %>
        <div class="form-section">
          <h2>Payment</h2>
          <% if (paymentInfo.feeCents > 0) { %>
            <p>Membership Fee: <strong>$<%= (paymentInfo.feeCents / 100).toFixed(2) %></strong></p>
          <% } %>
          <% if (paymentInfo.instructions) { %>
            <p class="hint"><%= paymentInfo.instructions %></p>
          <% } %>
        </div>
      <% } %>

      <button type="submit" class="primary-btn">Submit Registration</button>
      <p class="hint">Already have an account? <a href="/login">Log in</a>.</p>
    </form>
  </main>

  <template id="register-adult-template">
    <%- include('partials/register-adult-fields', { index: '__INDEX__', values: {} }) %>
  </template>

  <template id="register-child-template">
    <%- include('partials/register-child-fields', { index: '__INDEX__', values: {}, childFields }) %>
  </template>

  <script src="/js/portal-register-form.js"></script>
</body>
</html>
