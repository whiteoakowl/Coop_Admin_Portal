<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <p class="subtitle no-print"><a href="/admin/schedule?tab=<%= returnTab %>">&larr; All Schedules</a></p>
    <div class="roster-toolbar">
      <div><h1><%= member.name %></h1></div>
      <div class="roster-btn-row no-print">
        <a class="roster-action-btn print-action-btn" href="/admin/schedule/print?memberId=<%= member.id %>" target="_blank">Print Schedule</a>
      </div>
    </div>

    <p class="hint no-print">Generated automatically from the Class Schedule - enroll or staff <%= member.name %> on a class there to change what shows up here.</p>

    <div class="schedule-day-columns">
      <% [['monday', 'Monday', monday], ['wednesday', 'Wednesday', wednesday]].forEach(function (entry) { %>
        <% var dayKey = entry[0], dayLabel = entry[1], rows = entry[2]; %>
        <div class="form-section">
          <h2><%= dayLabel %> Schedule</h2>
          <div class="roster-scroll schedule-table-scroll">
            <table class="roster-table schedule-edit-table">
              <thead>
                <tr><th>Class</th><th>Time</th><th>Class Name</th><th>Room</th><th>Teacher</th></tr>
              </thead>
              <tbody>
                <% var anyRows = rows.some(function (r) { return r.class_name || r.time || r.room || r.teacher; }); %>
                <% if (!anyRows) { %>
                  <tr><td colspan="5" class="roster-empty">No classes on <%= dayLabel %> yet.</td></tr>
                <% } %>
                <% rows.forEach(function (r, i) { %>
                  <% if (!r.class_name && !r.time && !r.room && !r.teacher) return; %>
                  <tr>
                    <td class="schedule-edit-label">Class <%= i + 1 %></td>
                    <td><%= r.time || '—' %></td>
                    <td><%= r.class_name || '—' %></td>
                    <td><%= r.room || '—' %></td>
                    <td><%= r.teacher || '—' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% }); %>
    </div>
  </main>
</body>
</html>
