<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <p class="subtitle"><a href="/admin/members">&larr; Members</a></p>
    <h1><%= mode === 'create' ? 'Add Member' : 'Edit ' + member.name %></h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form
      method="POST"
      action="<%= mode === 'create' ? '/admin/members/new' : '/admin/members/' + member.id + '/edit' %>"
      enctype="multipart/form-data"
      id="member-form"
      class="member-edit-form"
    >
      <div class="manage-section">
        <h2>Member Type</h2>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="memberType" value="student" <%= member.member_type !== 'parent' && member.member_type !== 'admin' ? 'checked' : '' %> />
            Student
          </label>
          <label class="radio-option">
            <input type="radio" name="memberType" value="parent" <%= member.member_type === 'parent' ? 'checked' : '' %> />
            Parent
          </label>
          <label class="radio-option">
            <input type="radio" name="memberType" value="admin" <%= member.member_type === 'admin' ? 'checked' : '' %> />
            Admin
          </label>
        </div>
      </div>

      <div class="manage-section">
        <h2>Basic Info</h2>
        <div class="member-form-grid">
          <label>Name
            <input type="text" name="name" value="<%= member.name %>" required />
          </label>
          <label>Phone
            <input type="tel" name="phone" value="<%= member.phone || '' %>" />
          </label>
          <label>Email
            <input type="email" name="email" value="<%= member.email || '' %>" />
          </label>
          <label class="member-form-full">Address
            <input type="text" name="address" value="<%= member.address || '' %>" />
          </label>
          <label>City
            <input type="text" name="city" value="<%= member.city || '' %>" />
          </label>
          <label>State
            <input type="text" name="state" value="<%= member.state || '' %>" />
          </label>
          <label>Zip Code
            <input type="text" name="zip" value="<%= member.zip || '' %>" />
          </label>
        </div>
      </div>

      <div class="manage-section">
        <h2>Photo</h2>
        <% if (member.photo_path) { %>
          <img class="member-photo-preview" src="<%= member.photo_path %>" alt="<%= member.name %>" />
        <% } %>
        <input type="file" name="photo" accept="image/*" />
      </div>

      <div class="manage-section" id="student-only-fields">
        <h2>Student Info</h2>
        <div class="member-form-grid">
          <label>Birthday
            <input type="date" name="birthday" value="<%= member.birthday || '' %>" />
          </label>
          <label>Grade Level
            <input type="text" name="gradeLevel" value="<%= member.grade_level || '' %>" placeholder="e.g. 5th Grade" />
          </label>
          <label class="member-form-full">Medical/Allergy Notes
            <textarea name="medicalNotes" rows="3"><%= member.medical_notes || '' %></textarea>
          </label>
        </div>
      </div>

      <div class="manage-section">
        <h2>Family</h2>
        <p class="hint">Connect this profile to any other family members (parents, students, or admins) - they'll appear together on the Absence/Late and Name Tag forms.</p>
        <% if (familyOptions.length === 0) { %>
          <p class="hint">No other members exist yet.</p>
        <% } else { %>
          <div class="checkbox-group">
            <% familyOptions.forEach(function(p) { %>
              <label class="checkbox-option">
                <input type="checkbox" name="familyMemberIds" value="<%= p.id %>" <%= familyMemberIds.includes(p.id) ? 'checked' : '' %> />
                <%= p.name %>
              </label>
            <% }); %>
          </div>
        <% } %>
      </div>

      <div class="manage-section" id="parent-only-fields">
        <h2>Cleanup Team</h2>
        <% if (setupTeams.length === 0) { %>
          <p class="hint">No Setup/Cleanup teams exist yet.</p>
        <% } else { %>
          <% ['monday', 'wednesday'].forEach(function(day) { %>
            <% var dayTeams = setupTeams.filter(function(t) { return t.day === day; }); %>
            <% if (dayTeams.length === 0) return; %>
            <div class="cleanup-team-day-group">
              <h3 class="cleanup-team-day-heading"><%= day.charAt(0).toUpperCase() + day.slice(1) %></h3>
              <div class="checkbox-group">
                <% dayTeams.forEach(function(t) { %>
                  <label class="checkbox-option">
                    <input type="checkbox" name="cleanupTeamIds" value="<%= t.id %>" <%= memberCleanupTeamIds.includes(t.id) ? 'checked' : '' %> />
                    <%= t.title %>
                  </label>
                <% }); %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <button type="submit" class="primary-btn"><%= mode === 'create' ? 'Add Member' : 'Save Changes' %></button>
    </form>

    <% if (mode === 'edit') { %>
      <div class="manage-section">
        <h2>Portal Access</h2>
        <p class="hint">Grant this member their own login to the Parent, Student, or Co-op Admin portal. Admin use only - members log in themselves at the site's home page with these credentials.</p>
        <form method="POST" action="/admin/members/<%= member.id %>/portal-access" class="member-form-grid">
          <label>Username
            <input type="text" name="username" value="<%= member.username || '' %>" autocomplete="off" />
          </label>
          <label>Password<%= member.password_hash ? ' (leave blank to keep current)' : '' %>
            <input type="password" name="password" autocomplete="new-password" minlength="8" />
          </label>
          <div class="member-form-full checkbox-group">
            <label class="checkbox-option">
              <input type="checkbox" name="portalParent" value="1" <%= member.portal_parent ? 'checked' : '' %> />
              Parent Portal
            </label>
            <label class="checkbox-option">
              <input type="checkbox" name="portalStudent" value="1" <%= member.portal_student ? 'checked' : '' %> />
              Student Portal
            </label>
            <label class="checkbox-option">
              <input type="checkbox" name="portalCoopAdmin" value="1" <%= member.portal_coop_admin ? 'checked' : '' %> />
              Co-op Admin
            </label>
          </div>
          <button type="submit" class="primary-btn member-form-full">Save Portal Access</button>
        </form>
      </div>
    <% } %>
  </main>
  <script src="/js/member-form.js"></script>
</body>
</html>
