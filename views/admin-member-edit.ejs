<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/admin/members">&larr; Members</a></p>
    <h1><%= title %></h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="member-form-page-panel member-edit-page-panel">
      <%# A real request: "This page should look exactly like the
          membership request form. The additional parent sections and
          information, children sections and information. With family
          information below. Save and cancel buttons and the bottom of
          the page, same size, same row, side by side." Same partials
          Main Admin's own Edit Member page uses (views/main-admin-
          member-edit.ejs), minus Password - creating a portal account
          has always been Main-Admin-only (see routes/main-admin-
          members.js's own "No creating users" comment, and routes/
          admin-members.js's own identical boundary on this same POST
          /members/:id/edit) - so neither the Parent/Guardian fields
          above nor any Additional Parent/Children block below ever asks
          for a password here at all, new account or existing one alike
          (showLogin: false below). %>
      <form
        method="POST"
        action="/admin/members/<%= member.id %>/edit"
        enctype="multipart/form-data"
        id="member-form"
        class="member-edit-form member-edit-form-page"
        data-add-family-url="/admin/members/families/new"
      >
        <%- include('partials/member-edit-fields', { member, gradeLevels, showPassword: false, parentFields, childFields, generalFields, customFieldValues }) %>
        <%- include('partials/member-edit-family-sections', { familyAdults, familyChildren, familyChildFields, showLogin: false }) %>
        <%- include('partials/member-edit-admin-section', { member, families, memberFamilyId, allSections, memberSectionIds, allRoles, portalRoleIds, portalAccount, familyPortalRows, hasPasswordField: false }) %>

        <div class="member-form-footer">
          <div class="member-form-footer-edit">
            <a class="btn-secondary" href="/admin/members">Cancel</a>
            <button type="submit" class="primary-btn"><svg class="icon"><use href="#icon-save"/></svg> Save Member</button>
          </div>
        </div>
      </form>

      <%# Outside #member-form on purpose - a <form> can't nest inside another
          <form> (the browser silently drops the inner tag), so this dialog's
          own form has to live as a sibling, not a descendant, of the main
          Add/Edit Member form. See data-add-family-* in public/js/member-form.js. %>
      <dialog class="member-picker-dialog" data-add-family-dialog>
        <form data-add-family-form>
          <h3>Add Family</h3>
          <label>Family Last Name
            <input type="text" name="name" placeholder="e.g. Anderson" required />
          </label>
          <p class="alert alert-error" data-add-family-error hidden></p>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Add Family</button>
          </div>
        </form>
      </dialog>
    </div>

  </main>
  <script src="/js/member-form.js"></script>
  <script src="/js/member-family-edit-form.js"></script>
  <script src="/js/filter-details-dismiss.js"></script>
</body>
</html>
