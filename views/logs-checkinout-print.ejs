<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.4in; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1>Co-op Check-In/Out Log<%= dateFilter ? ` — ${dateFilterLabel}` : '' %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub">Co-op Check-In/Out Log &mdash; <%= dateFilterLabel %></p>
        </div>
      </div>

      <table class="roster-table members-table condensed-table">
        <thead>
          <tr><th>Name</th><th>Date</th><th>Check-In Time</th><th>Check-Out Time</th><th>Roster</th><th>Number</th></tr>
        </thead>
        <tbody>
          <% if (allRows.length === 0) { %>
            <tr><td colspan="6" class="roster-empty">No check-ins recorded yet.</td></tr>
          <% } %>
          <% allRows.forEach(function(r) { %>
            <tr>
              <td><%= r.memberName %></td>
              <td><%= r.dateLabel %></td>
              <td><%= r.checkInTime %></td>
              <td><%= r.checkOutTime %></td>
              <td><%= r.rosterName %></td>
              <td><%= r.number %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
