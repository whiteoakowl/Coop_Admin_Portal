<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="form-wrap">
    <div class="print-header-sub" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <a href="/kiosk" class="kiosk-home">&larr; Home</a>
      <form method="POST" action="/kiosk/class-checkin/lock">
        <button type="submit" class="btn-secondary">Done</button>
      </form>
    </div>
    <h1>Class Check-In</h1>
    <p class="subtitle">Choose a class to check students in or view its attendance.</p>

    <div class="roster-toolbar no-print">
      <div class="category-filter" style="margin: 0;">
        <label for="kiosk-class-day-select">Day</label>
        <select id="kiosk-class-day-select" onchange="window.location = '/kiosk/class-checkin/classes' + (this.value ? '?day=' + this.value : '') + (document.getElementById('kiosk-class-hour-select').value ? (this.value ? '&' : '?') + 'hour=' + document.getElementById('kiosk-class-hour-select').value : '')">
          <option value="" <%= !dayFilter ? 'selected' : '' %>>Monday &amp; Wednesday</option>
          <option value="monday" <%= dayFilter === 'monday' ? 'selected' : '' %>>Monday</option>
          <option value="wednesday" <%= dayFilter === 'wednesday' ? 'selected' : '' %>>Wednesday</option>
        </select>
      </div>
      <div class="category-filter" style="margin: 0;">
        <label for="kiosk-class-hour-select">Hour</label>
        <select id="kiosk-class-hour-select" onchange="window.location = '/kiosk/class-checkin/classes' + (document.getElementById('kiosk-class-day-select').value ? '?day=' + document.getElementById('kiosk-class-day-select').value : '') + (this.value ? (document.getElementById('kiosk-class-day-select').value ? '&' : '?') + 'hour=' + this.value : '')">
          <option value="" <%= !hourFilter ? 'selected' : '' %>>All Hours</option>
          <% hourPositions.forEach(function(h) { %>
            <option value="<%= h %>" <%= hourFilter === h ? 'selected' : '' %>>Hour <%= h %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <% if (classes.length === 0) { %>
      <p class="roster-empty">No classes match this filter.</p>
    <% } else { %>
      <div class="class-roster-list">
        <% classes.forEach(function(c) { %>
          <a class="class-roster-row-btn" href="/kiosk/class-checkin/classes/<%= c.id %>" style="border-left: 5px solid <%= c.color %>;">
            <span class="class-roster-row-name"><%= c.class_name %></span>
            <span class="class-roster-row-meta">
              <% if (c.gradeLabel) { %><span><%= c.gradeLabel %></span><% } %>
              <span><%= c.dayLabel %></span>
              <span><%= c.timeLabel %></span>
              <% if (c.room) { %><span>Room <%= c.room %></span><% } %>
              <span>Teacher: <%= c.teacherNames.length ? c.teacherNames.join(', ') : '—' %></span>
              <% if (c.assistantNames.length > 0) { %><span>Assistant: <%= c.assistantNames.join(', ') %></span><% } %>
            </span>
          </a>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
