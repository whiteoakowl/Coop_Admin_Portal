<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="grade-level-report-print-page">
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Grade Level Report</p>
      </div>
    </div>

    <p class="subtitle no-print"><a href="/main-admin/members">&larr; Members</a></p>

    <%
      var hasActiveFilter = !!(selectedSectionId || selectedSignup || selectedFamilyId);
    %>
    <div class="roster-toolbar no-print">
      <h1>Grade Level Report</h1>
      <div class="roster-btn-row">
        <%# A real request: "Add a filter for grade level report, orange
            button. Filter by section, schedule grid signup, family etc" -
            roster-action-btn is already this app's one orange toolbar
            button style (Print right beside it uses the same class), and
            this dialog/GET-params shape mirrors the Member Schedules
            tab's own Filter popup (views/admin-schedule.ejs). %>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('grade-level-report-filter-dialog').showModal()">
          <svg class="icon"><use href="#icon-filter"/></svg>
          Filter<% if (filterLabelParts.length > 0) { %>: <%= filterLabelParts.join(', ') %><% } %>
        </button>
        <%# A real request: "all pages/subpages with print, export,
            import, or download buttons should be changed to icons... and
            have all four" - this page only had Print. %>
        <a class="icon-btn" href="/main-admin/members/grade-level-report/export.csv<%= hasActiveFilter ? '?' + ['sectionId=' + (selectedSectionId || ''), 'signup=' + (selectedSignup || ''), 'familyId=' + (selectedFamilyId || '')].join('&') : '' %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <button type="button" class="icon-btn" onclick="window.print()" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></button>
      </div>
    </div>

    <dialog id="grade-level-report-filter-dialog" class="member-picker-dialog">
      <form method="GET" action="/main-admin/members/grade-level-report">
        <h3>Filter Grade Level Report</h3>
        <div class="category-filter">
          <label for="grade-level-report-section-select">Section</label>
          <select id="grade-level-report-section-select" name="sectionId">
            <option value="">All Sections</option>
            <% sections.forEach(function(s) { %>
              <option value="<%= s.id %>" <%= selectedSectionId === s.id ? 'selected' : '' %>><%= s.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="category-filter">
          <label for="grade-level-report-signup-select">Schedule Grid Signup</label>
          <select id="grade-level-report-signup-select" name="signup">
            <option value="">All Students</option>
            <option value="signedUp" <%= selectedSignup === 'signedUp' ? 'selected' : '' %>>Signed Up for a Class</option>
            <option value="notSignedUp" <%= selectedSignup === 'notSignedUp' ? 'selected' : '' %>>Not Signed Up for a Class</option>
          </select>
        </div>
        <div class="category-filter">
          <label for="grade-level-report-family-select">Family</label>
          <select id="grade-level-report-family-select" name="familyId">
            <option value="">All Families</option>
            <% families.forEach(function(f) { %>
              <option value="<%= f.id %>" <%= selectedFamilyId === f.id ? 'selected' : '' %>><%= f.name %> Family</option>
            <% }); %>
          </select>
        </div>
        <div class="notes-dialog-actions">
          <% if (hasActiveFilter) { %><a class="btn-secondary" href="/main-admin/members/grade-level-report">Clear Filter</a><% } %>
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Apply Filter</button>
        </div>
      </form>
    </dialog>

    <%
      var nonEmptyColumns = columns.filter(function (c) { return c.students.length > 0; });
    %>
    <% if (nonEmptyColumns.length === 0) { %>
      <p class="roster-empty"><%= hasActiveFilter ? 'No active students match this filter.' : 'No active students have a grade level on file yet.' %></p>
    <% } else { %>
      <%# data-shrink-to-fit-budget (public/js/print-shrink-to-fit.js) -
          not a permanent CSS height like the Attendance grid's own
          #grid-box-attendance - this report's own content height varies
          hugely with enrollment, and a permanent fixed height here would
          risk the exact trailing-blank-page bug that attribute's own
          comment documents. The budget is only ever applied long enough
          to MEASURE against when the browser actually prints; the
          wrapper is left at its natural height the rest of the time,
          including right now on screen. %>
      <%# --grade-level-cols-mobile (consumed by .grade-level-report-grid's
          own @media (max-width: 480px) override in styles.css) halves the
          one-row column count, wrapping the same nonEmptyColumns.length
          columns onto a 2nd row on phones instead of squeezing all of
          them into one row - a real follow-up request after a live mobile
          check found columns only ~16px wide (text overlapping) with as
          many as 18 grade levels on screen at once at a 390px width.
          Doubling each column's share of the width by giving it 2 rows
          instead of 1 is a straightforward fix for exactly that. Set here
          (not recomputed per-breakpoint in CSS) since it depends on
          nonEmptyColumns.length, which only the server knows. %>
      <%
        // A real follow-up request: "Names by grade level should be
        // broke into 4 rows to allow more space for name" - the Names by
        // Grade Level grid (unlike the bar chart just above it, which
        // keeps its own --grade-level-cols/-mobile exactly as before)
        // gets its own dedicated column counts, computed to land every
        // non-empty grade level into (at most) 4 rows on screen/tablet
        // and 8 on a phone (the same halving relationship --grade-level-
        // cols-mobile already uses) instead of cramming them all into
        // one single row of very narrow columns.
        var GRADE_LEVEL_NAMES_ROWS = 4;
        var gradeLevelNamesCols = Math.max(1, Math.ceil(nonEmptyColumns.length / GRADE_LEVEL_NAMES_ROWS));
        var gradeLevelNamesColsMobile = Math.max(1, Math.ceil(nonEmptyColumns.length / (GRADE_LEVEL_NAMES_ROWS * 2)));
      %>
      <div class="grade-level-report-fit" data-shrink-to-fit-on-print data-shrink-to-fit-budget="9.4in">
        <div class="grade-level-report-fit-inner" style="--grade-level-cols: <%= nonEmptyColumns.length %>; --grade-level-cols-mobile: <%= Math.ceil(nonEmptyColumns.length / 2) %>; --grade-level-names-cols: <%= gradeLevelNamesCols %>; --grade-level-names-cols-mobile: <%= gradeLevelNamesColsMobile %>;">
          <%# Bar graph - a real request: "a bar bargraph members on
              every grade level." Bars only for grade levels that
              actually have at least one student, same "don't show an
              always-empty column" reasoning the chart below applies to
              Ungraded - an all-zero bar for every grade nobody happens
              to be in yet would just be visual noise stretching the
              chart wide for no reason. Each bar's height is its own
              count ÷ the single largest count among all grade levels
              (maxCount, computed server-side so every bar scales
              against the exact same ruler). %>
          <h2>Students per Grade Level</h2>
          <div class="grade-level-bar-chart">
            <% nonEmptyColumns.forEach(function(col) { %>
              <div class="grade-level-bar-col">
                <span class="grade-level-bar-count"><%= col.students.length %></span>
                <div class="grade-level-bar-track">
                  <div class="grade-level-bar" style="height: <%= Math.round((col.students.length / maxCount) * 100) %>%;"></div>
                </div>
                <span class="grade-level-bar-label" title="<%= col.gradeLevel %>"><%= col.gradeLevel %></span>
              </div>
            <% }); %>
          </div>

          <%# Grade level chart - a real request: "a grade level chart
              with names and ages in parenthesis. Column titles are
              grade levels. Shrink to fit all grade levels." A CSS grid
              (not a <table>) since each grade level's own list of names
              is a completely independent length - a table's shared row
              grid would force ragged blank cells once one column runs
              out of students before its neighbors. grid-template-
              columns below is set to exactly nonEmptyColumns.length
              equal columns so every grade level that has anyone in it
              gets its own column, all in one row of headers, same
              "every category fits on screen at once, shrinking as
              needed" treatment the Classes grid's own Room column
              already established - see public/js/shrink-title-to-fit.js
              (also shrinks each one of these column titles and the bar
              chart's own labels above, alongside class titles/room
              names) and this page's own CSS for the breakpoints. %>
          <h2>Names by Grade Level</h2>
          <div class="grade-level-report-grid">
            <% nonEmptyColumns.forEach(function(col) { %>
              <div class="grade-level-report-col">
                <div class="grade-level-report-col-title" title="<%= col.gradeLevel %>"><%= col.gradeLevel %></div>
                <% col.students.forEach(function(s) { %>
                  <p class="grade-level-report-name"><%= s.name %><%= s.age != null ? ` (${s.age})` : '' %></p>
                <% }); %>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    <% } %>
  </main>

  <script src="/js/shrink-title-to-fit.js"></script>
  <script src="/js/print-shrink-to-fit.js"></script>
</body>
</html>
