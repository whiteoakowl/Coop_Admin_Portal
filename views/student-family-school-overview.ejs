<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Homeschool Overview</h1>

    <% if (!student) { %>
      <p class="roster-empty">No homeschool record on file yet.</p>
    <% } else { %>
      <div class="fs-overview-grid">
        <div class="fs-overview-card">
          <div class="fs-overview-card-header">
            <span class="member-avatar fs-overview-avatar member-avatar-blue">
              <% if (student.photoUrl) { %>
                <img src="<%= student.photoUrl %>" alt="" />
              <% } else { %>
                <%= student.name.charAt(0).toUpperCase() %>
              <% } %>
            </span>
            <div>
              <h3 class="fs-overview-name"><%= student.name %></h3>
              <p class="hint"><%= student.grade_level || 'No grade level set' %></p>
            </div>
          </div>

          <div class="fs-overview-stats">
            <div class="fs-overview-stat">
              <span class="fs-overview-stat-label">GPA</span>
              <span class="fs-overview-stat-value"><%= student.gpa != null ? student.gpa.toFixed(2) : '—' %></span>
            </div>
            <div class="fs-overview-stat">
              <span class="fs-overview-stat-label">Attendance</span>
              <span class="fs-overview-stat-value"><%= student.presentDays %>/<%= student.attendanceTargetDays %></span>
            </div>
          </div>
          <%- include('partials/fs-attendance-bar', { presentDays: student.presentDays, attendanceTargetDays: student.attendanceTargetDays }) %>

          <div class="fs-overview-classes">
            <% if (student.classes.length === 0) { %>
              <p class="roster-empty">Not assigned to any family classes yet.</p>
            <% } else { %>
              <ul class="fs-overview-classes-list">
                <% student.classes.forEach(function(c) { %>
                  <li>
                    <a href="/student/family-school/classes/<%= c.id %>"><%= c.class_name %></a>
                    <span class="badge-pill <%= c.gradeLetter === 'A' || c.gradeLetter === 'B' ? 'badge-pill-green' : c.gradeLetter === 'C' ? 'badge-pill-gold' : c.gradeLetter === 'D' || c.gradeLetter === 'F' ? 'badge-pill-red' : 'badge-pill-gray' %>"><%= c.gradeLetter || 'No grade yet' %></span>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </main>
</body>
</html>
