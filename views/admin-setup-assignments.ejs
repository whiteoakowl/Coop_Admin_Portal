<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.4in; }</style>
</head>
<body class="admin-page setup-assignments-print-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main" data-day="<%= day %>" data-semester-id="<%= semesterId %>">
    <%# A real request: "make sure it prints one team per page" - this
        page's own top-level .print-header (display:none outside print,
        so removing it changes nothing on screen) used to be the only
        header in the whole print job and landed on whichever page
        happened to hold it. partials/setup-assignment-cards.ejs now
        repeats its own copy on every team's own page instead - see its
        header comment. %>
    <h1>Setup/Cleanup Assignments</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%# Setup/Cleanup Assignments/Setup/Cleanup Teams/Task List now live as
        subpages under the orange bar's own Setup/Cleanup item (views/
        partials/admin-nav.ejs) instead of a trigger+dialog here. %>

    <div class="view-tab-panel">
      <div class="roster-toolbar no-print">
        <div class="roster-toolbar-left">
          <%- include('partials/schedule-combo-picker', { combos, basePrefix: '/admin/setup', pathSuffix: '/assignments', selectedComboId }) %>
        </div>
        <div class="roster-btn-row roster-btn-row-fit-text">
          <button type="button" class="roster-action-btn" onclick="document.getElementById('edit-dates-dialog').showModal()">Edit Dates</button>
        </div>
        <%# A real request: "export, import, print and pdf icons should
            be in a row side by side. Not in a single column" - see
            views/admin-design.ejs's own matching comment. %>
        <div class="roster-btn-row" data-fixed-columns="3">
          <a class="icon-btn" href="/admin/setup/<%= day %>/assignments/export.csv?semesterId=<%= semesterId %><%= selectedDate ? '&date=' + selectedDate : '' %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
          <a class="icon-btn" href="/admin/setup/<%= day %>/assignments/print?semesterId=<%= semesterId %><%= selectedDate ? '&date=' + selectedDate : '' %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
          <a class="icon-btn" href="/admin/setup/<%= day %>/assignments/download.pdf?semesterId=<%= semesterId %><%= selectedDate ? '&date=' + selectedDate : '' %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
        </div>
      </div>

      <div class="roster-toolbar no-print">
        <div class="category-filter" style="margin: 0;">
          <label for="assignments-date-select">Choose Date</label>
          <select id="assignments-date-select" onchange="window.fullscreenNavigate('/admin/setup/<%= day %>/assignments?semesterId=<%= semesterId %>' + (this.value ? '&date=' + this.value : ''))">
            <% if (upcomingDates.length === 0) { %><option value="">No upcoming dates</option><% } %>
            <% upcomingDates.forEach(function(d) { %>
              <option value="<%= d.date %>" <%= selectedDate === d.date ? 'selected' : '' %>><%= d.label %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <% if (dates.length === 0) { %>
        <p class="roster-empty">Add session dates above first.</p>
      <% } else if (!selectedDate) { %>
        <p class="roster-empty">No upcoming session dates - add one above.</p>
      <% } else { %>
        <div id="setup-assign-status" class="alert alert-error no-print" hidden></div>
        <div id="setup-assignment-cards-container" data-selected-date="<%= selectedDate %>">
          <%- include('partials/setup-assignment-cards', { cards, day, dayLabel, selectedDate, editable: true, semesterId }) %>
        </div>
      <% } %>
    </div>

    <dialog id="edit-dates-dialog" class="volunteer-edit-dialog">
      <h3>Edit Session Dates</h3>
      <div class="roster-scroll">
        <div id="setup-dates-list">
          <%- include('setup-dates-fragment', { day, dates, semesterId }) %>
        </div>
      </div>
      <form method="POST" action="/admin/setup/<%= day %>/dates/add?semesterId=<%= semesterId %>" class="volunteer-date-add-form">
        <input type="date" name="dates" onchange="if (this.value) this.form.requestSubmit();" />
      </form>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
      </div>
    </dialog>

    <%# A real request: "Add the same exact check box and button system
        on floater assignments, on each setup cleanup team and
        position." Mirrors Floater Assignments' own floater-text-
        notify-dialog exactly - see that dialog's own comment in
        views/admin-volunteers.ejs for the full reasoning (single
        recipient gets an editable starting message; 2+ recipients each
        get their own message built server-side from their own team/
        tasks instead). %>
    <dialog id="setup-text-notify-dialog" class="class-form-dialog" data-message-template="<%= setupMessageTemplate %>">
      <form id="setup-text-notify-form" class="stack-form">
        <div class="class-form-dialog-header">
          <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-mail"/></svg></span>
          <h3>Send Text Notification</h3>
        </div>
        <p class="hint" id="setup-text-notify-recipients-hint"></p>
        <label id="setup-text-notify-message-label">Message
          <textarea name="message" id="setup-text-notify-message" rows="4"></textarea>
        </label>
        <p class="hint" id="setup-text-notify-multi-hint" hidden>Each member will get their own text with their own team and task(s) - the message can't be customized when sending to more than one person at once.</p>
        <label>Image (optional)
          <input type="file" name="image" accept="image/*" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn" id="setup-text-notify-send-btn">Send Now</button>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/setup-dates.js"></script>
  <script src="/js/setup-assign.js"></script>
  <script src="/js/setup-text-notify.js"></script>
</body>
</html>
