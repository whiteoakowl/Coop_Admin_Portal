<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%# A real request: "sections. remove description. add a section
        button should have a pop up for being able to add a new section.
        shrink to fit table on mobile." - the explanatory hint paragraph
        that used to sit here is gone; + Add Section now opens a popup
        dialog (same .member-picker-dialog shape every other "Add X"
        popup on this site already uses) instead of an always-visible
        inline form. A later real request ("remove description column...
        Add section button should be under title") moved the button off
        the title's own row (it used to sit side by side with <h1> via
        .roster-toolbar's own justify-content: space-between) onto its
        own row directly below, and dropped the table's Description
        column (the dialog's own Description field is untouched - a
        section can still be given one, it's just not shown as a table
        column anymore). %>
    <h1>Sections</h1>
    <div class="roster-btn-row no-print">
      <button type="button" class="roster-action-btn" onclick="document.getElementById('add-section-dialog').showModal()">+ Add Section</button>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <dialog id="add-section-dialog" class="member-picker-dialog">
      <h3>Add Section</h3>
      <form method="POST" action="/main-admin/sections/new" class="stack-form">
        <label>Section Name
          <input type="text" name="name" placeholder="e.g. Teen Co-op" required />
        </label>
        <label>Description
          <input type="text" name="description" placeholder="Optional" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">+ Add Section</button>
        </div>
      </form>
    </dialog>

    <% if (sections.length === 0) { %>
      <p class="roster-empty">No sections yet - add one above.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table condensed-table sections-table">
          <thead><tr><th>Name</th><th>Members</th><th></th></tr></thead>
          <tbody>
            <% sections.forEach(function(s) { %>
              <tr>
                <td class="roster-name-col"><a href="/main-admin/sections/<%= s.id %>"><%= s.name %></a></td>
                <td><%= s.memberCount %></td>
                <td class="actions-cell">
                  <form method="POST" action="/main-admin/sections/<%= s.id %>/delete" class="inline-block-form" onsubmit="return confirm('Delete this section? Event/class restrictions using it will no longer apply.');">
                    <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= s.name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
