<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Homepage</h1>

    <%# Item 6: "remove accounts by role counting, remove user settings -
        user settings should be under the gear setting icon at the top of
        the page [already true - see routes/main-admin.js's own /settings
        redirect and the gear dropdown in partials/portal-nav.ejs]. There
        should be a count display for number of parents, students,
        families, teachers and admins. Then there should be a 2nd count
        display for pending requests... each name should be able to click
        and go straight to that request page." A later request dropped the
        "Main Admin" title + description ("should be called Homepage,
        remove the description") and renamed this section "People" ->
        "Members". A further request: "main admin, homepage, member count.
        should look like the member count on co-op admin portal homepage" -
        reuses the exact same .family-student-counts-card/-row markup and
        classes as the Co-op Admin dashboard's own "Co-op Member Counts"
        card (views/admin-dashboard.ejs) instead of the plain numbers-in-
        a-row .totals-card grid this used to be. That card splits into a
        Monday/Wednesday column pair because its 3 counts are genuinely
        day-scoped; these 5 aren't split by anything, so they're just one
        flat list of rows here - same icon-circle+label+value row shape,
        one consistent blue accent throughout instead of an orange/blue
        pair standing in for two different days. %>
    <div class="family-student-counts-card">
      <div class="family-student-counts-header">
        <svg class="icon"><use href="#icon-users"/></svg>
        <h2>Members</h2>
      </div>
      <div class="family-student-row">
        <span class="family-student-row-icon family-student-row-icon-blue"><svg class="icon"><use href="#icon-users"/></svg></span>
        <span class="family-student-row-label">Parents</span>
        <span class="family-student-row-value"><%= parentCount %></span>
      </div>
      <div class="family-student-row">
        <span class="family-student-row-icon family-student-row-icon-blue"><svg class="icon"><use href="#icon-graduation-cap"/></svg></span>
        <span class="family-student-row-label">Students</span>
        <span class="family-student-row-value"><%= studentCount %></span>
      </div>
      <div class="family-student-row">
        <span class="family-student-row-icon family-student-row-icon-blue"><svg class="icon"><use href="#icon-home"/></svg></span>
        <span class="family-student-row-label">Families</span>
        <span class="family-student-row-value"><%= familyCount %></span>
      </div>
      <div class="family-student-row">
        <span class="family-student-row-icon family-student-row-icon-blue"><svg class="icon"><use href="#icon-book"/></svg></span>
        <span class="family-student-row-label">Teachers</span>
        <span class="family-student-row-value"><%= teacherCount %></span>
      </div>
      <div class="family-student-row">
        <span class="family-student-row-icon family-student-row-icon-blue"><svg class="icon"><use href="#icon-shield"/></svg></span>
        <span class="family-student-row-label">Admins</span>
        <span class="family-student-row-value"><%= adminCount %></span>
      </div>
    </div>

    <% if (pendingCount > 0) { %>
      <div class="alert alert-info">
        <%= pendingCount %> account<%= pendingCount === 1 ? '' : 's' %> awaiting approval.
        <a href="/main-admin/members?tab=approvals">Review now &rarr;</a>
      </div>
    <% } %>

    <section class="portal-dashboard-section">
      <h2>Pending Requests</h2>
      <div class="totals-card totals-card-links">
        <a class="totals-item" href="/main-admin/members?tab=approvals">
          <span class="stat-value"><%= pendingCount %></span>
          <span class="stat-label">Membership Requests</span>
        </a>
        <a class="totals-item" href="/main-admin/events?tab=requests">
          <span class="stat-value"><%= eventRequestsCount %></span>
          <span class="stat-label">Event Requests</span>
        </a>
        <a class="totals-item" href="/main-admin/babysitters?tab=approvals">
          <span class="stat-value"><%= babysitterApprovalsCount %></span>
          <span class="stat-label">Babysitter Approvals</span>
        </a>
        <a class="totals-item" href="/main-admin/photos#pending-photos">
          <span class="stat-value"><%= photoSubmissionsCount %></span>
          <span class="stat-label">Photo Submissions</span>
        </a>
        <a class="totals-item" href="/main-admin/directory?tab=requests">
          <span class="stat-value"><%= directoryRequestsCount %></span>
          <span class="stat-label">Business Directory Requests</span>
        </a>
        <a class="totals-item" href="/main-admin/classifieds?tab=requests">
          <span class="stat-value"><%= classifiedsRequestsCount %></span>
          <span class="stat-label">Classifieds Requests</span>
        </a>
      </div>
    </section>
  </main>
</body>
</html>
