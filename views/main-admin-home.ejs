<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Main Admin</h1>
    <p class="hint">The control center for the whole platform - users, roles/permissions, and public website content.</p>

    <%# Item 6: "remove accounts by role counting, remove user settings -
        user settings should be under the gear setting icon at the top of
        the page [already true - see routes/main-admin.js's own /settings
        redirect and the gear dropdown in partials/portal-nav.ejs]. There
        should be a count display for number of parents, students,
        families, teachers and admins. Then there should be a 2nd count
        display for pending requests... each name should be able to click
        and go straight to that request page." %>
    <section class="portal-dashboard-section">
      <h2>People</h2>
      <div class="totals-card">
        <div class="totals-item">
          <span class="stat-value"><%= parentCount %></span>
          <span class="stat-label">Parents</span>
        </div>
        <div class="totals-item">
          <span class="stat-value"><%= studentCount %></span>
          <span class="stat-label">Students</span>
        </div>
        <div class="totals-item">
          <span class="stat-value"><%= familyCount %></span>
          <span class="stat-label">Families</span>
        </div>
        <div class="totals-item">
          <span class="stat-value"><%= teacherCount %></span>
          <span class="stat-label">Teachers</span>
        </div>
        <div class="totals-item">
          <span class="stat-value"><%= adminCount %></span>
          <span class="stat-label">Admins</span>
        </div>
      </div>
    </section>

    <% if (pendingCount > 0) { %>
      <div class="alert alert-info">
        <%= pendingCount %> account<%= pendingCount === 1 ? '' : 's' %> awaiting approval.
        <a href="/main-admin/users">Review now &rarr;</a>
      </div>
    <% } %>

    <section class="portal-dashboard-section">
      <h2>Pending Requests</h2>
      <div class="totals-card totals-card-links">
        <a class="totals-item" href="/main-admin/events?tab=requests">
          <span class="stat-value"><%= eventRequestsCount %></span>
          <span class="stat-label">Event Requests</span>
        </a>
        <a class="totals-item" href="/main-admin/babysitters?tab=approvals">
          <span class="stat-value"><%= babysitterApprovalsCount %></span>
          <span class="stat-label">Babysitter Approvals</span>
        </a>
        <a class="totals-item" href="/main-admin/photos#pending-photos">
          <span class="stat-value"><%= photoSubmissionsCount %></span>
          <span class="stat-label">Photo Submissions</span>
        </a>
        <a class="totals-item" href="/main-admin/directory?tab=requests">
          <span class="stat-value"><%= directoryRequestsCount %></span>
          <span class="stat-label">Business Directory Requests</span>
        </a>
        <a class="totals-item" href="/main-admin/classifieds?tab=requests">
          <span class="stat-value"><%= classifiedsRequestsCount %></span>
          <span class="stat-label">Classifieds Requests</span>
        </a>
      </div>
    </section>
  </main>
</body>
</html>
