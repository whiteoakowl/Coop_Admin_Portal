<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.4in; }</style>
</head>
<body class="admin-page roster-view-page attendance-print-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= view === 'playgroundLog' ? `${pgDayLabel} Playground — ${pgHourLabel}` : `${tabLabel} Attendance` %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <% if (view === 'playgroundLog') { %>
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub"><%= pgDayLabel %> Playground &mdash; <%= pgHourLabel %></p>
        </div>
      </div>
      <%- include('partials/playground-log-table', { pgDayLabel, pgHourLabel, selectedDate, selectedDateLabel, log }) %>
    <% } else { %>
      <% gridPages.forEach(function(pageGrid) { %>
        <div class="roster-print-chunk">
          <div class="print-header">
            <img src="/img/logo.png" alt="" />
            <div>
              <p class="print-header-title">Sanford Homeschoolers</p>
              <p class="print-header-sub"><%= tabLabel %> Attendance Spreadsheet</p>
            </div>
          </div>
          <%- include('partials/roster-archive-grid-table', { heading: tabLabel, grid: pageGrid }) %>
        </div>
      <% }); %>
    <% } %>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
