<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/parent/family-school">&larr; Family School Management</a></p>
    <div class="roster-toolbar no-print">
      <h1>Portfolio</h1>
    </div>

    <%# A real request: "add a subpage called portfolio. This will
        summarize all family school management features for each
        student and create a visual profile of everything." One student
        at a time, same per-student owner-select convention every other
        subpage (Attendance/Journal/Weekly Planner/Volunteer Hours)
        already uses. %>
    <% if (familyStudents.length === 0) { %>
      <p class="roster-empty">No students in your family yet.</p>
    <% } else { %>
      <form method="GET" action="/parent/family-school/portfolio" class="category-filter no-print">
        <label for="portfolio-student-select">Student</label>
        <select id="portfolio-student-select" name="studentId" onchange="this.form.submit()">
          <% familyStudents.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= studentId === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }); %>
        </select>
      </form>

      <div class="roster-btn-row roster-btn-row-fit-text no-print">
        <a class="icon-btn" href="/parent/family-school/portfolio/print?studentId=<%= studentId %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
        <a class="icon-btn" href="/parent/family-school/portfolio/download.pdf?studentId=<%= studentId %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
      </div>

      <%- include('partials/family-school-portfolio-body', { portfolio }) %>
    <% } %>
  </main>
</body>
</html>
