<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page roster-view-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= roster.name %> &mdash; Attendance Spreadsheet</p>
      </div>
    </div>
    <h1><%= roster.name %></h1>
    <p class="subtitle no-print">
      <a href="/admin/rosters/<%= roster.id %>/manage">Manage roster</a>
    </p>

    <div class="roster-toolbar">
      <div class="roster-btn-row no-print">
        <a class="roster-action-btn" href="/admin/logs?tab=checkinout">Check In/Out Log</a>
      </div>
      <div class="roster-btn-row no-print">
        <a class="roster-action-btn file-action-btn" href="/admin/roster/<%= roster.id %>/export.csv">Export</a>
        <button type="button" class="roster-action-btn file-action-btn" onclick="window.print()">Print</button>
      </div>
    </div>

    <div class="legend">
      <span class="legend-item"><span class="cell-tag cell-present">P</span> Present</span>
      <span class="legend-item"><span class="cell-tag cell-late">L</span> Late</span>
      <span class="legend-item"><span class="cell-tag cell-absent">A</span> Absent</span>
    </div>

    <div class="grid-box roster-grid-col" id="grid-box-attendance">
      <div class="grid-box-header">
        <h2>Attendance</h2>
      </div>
      <div class="roster-scroll">
        <table class="roster-table roster-table-detailed">
          <thead>
            <tr>
              <th class="roster-name-col">Name</th>
              <th class="roster-secondary-col">Arrival</th>
              <th class="roster-secondary-col">Departure</th>
              <% dateLabels.forEach(function(label) { %>
                <th><%= label %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% if (rows.length === 0) { %>
              <tr>
                <td colspan="<%= dateLabels.length + 3 %>" class="roster-empty">
                  <div class="roster-empty-state">
                    <svg class="icon roster-empty-icon"><use href="#icon-users"/></svg>
                    <p class="roster-empty-title">No members on this roster yet</p>
                    <p class="roster-empty-subtitle">Add students or parents to start tracking attendance.</p>
                    <a class="roster-action-btn roster-empty-btn" href="/admin/rosters/<%= roster.id %>/manage">+ Add Members</a>
                  </div>
                </td>
              </tr>
            <% } %>
            <% rows.forEach(function(row) { %>
              <tr>
                <td class="roster-name-col">
                  <button type="button" class="link-btn" title="View profile for <%= row.member.name %>" onclick="document.getElementById('profile-dialog-<%= row.member.id %>').showModal()"><%= row.member.name %></button>
                </td>
                <td class="roster-secondary-col"><%= row.arrivalLabel || '—' %></td>
                <td class="roster-secondary-col"><%= row.departureLabel || '—' %></td>
                <% row.cells.forEach(function(cell) { %>
                  <td>
                    <% if (!cell) { %>
                      <span class="cell-tag cell-blank">&nbsp;</span>
                    <% } else { %>
                      <div class="cell-detailed">
                        <span class="cell-tag cell-<%= cell.tag === 'P' ? 'present' : cell.tag === 'L' ? 'late' : 'absent' %>"><%= cell.tag %></span>
                        <% if (cell.checkInTime) { %><span class="cell-time">In <%= cell.checkInTime %></span><% } %>
                        <% if (cell.checkOutTime) { %><span class="cell-time">Out <%= cell.checkOutTime %><% if (cell.number) { %> #<%= cell.number %><% } %></span><% } %>
                      </div>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
              <dialog id="profile-dialog-<%= row.member.id %>" class="member-profile-dialog">
                <div class="member-profile-header">
                  <% if (row.member.photo_path) { %>
                    <img class="member-photo-preview" src="<%= row.member.photo_path %>" alt="" />
                  <% } %>
                  <div>
                    <h3><%= row.member.name %></h3>
                    <span class="badge-pill"><%= row.member.member_type === 'parent' ? 'Parent' : 'Student' %></span>
                  </div>
                </div>
                <dl class="member-profile-list">
                  <% if (row.member.address || row.member.city || row.member.state || row.member.zip) { %>
                    <dt>Address</dt>
                    <dd><%= [row.member.address, row.member.city, [row.member.state, row.member.zip].filter(Boolean).join(' ')].filter(Boolean).join(', ') %></dd>
                  <% } %>
                  <% if (row.member.phone) { %><dt>Phone</dt><dd><%= row.member.phone %></dd><% } %>
                  <% if (row.member.email) { %><dt>Email</dt><dd><%= row.member.email %></dd><% } %>
                  <% if (row.member.member_type !== 'parent') { %>
                    <% if (row.member.birthday) { %><dt>Birthday</dt><dd><%= row.member.birthday %></dd><% } %>
                    <% if (row.member.grade_level) { %><dt>Grade Level</dt><dd><%= row.member.grade_level %></dd><% } %>
                    <% if (row.parentName) { %><dt>Family</dt><dd><%= row.parentName %></dd><% } %>
                    <% if (row.member.medical_notes) { %><dt>Medical/Allergy Notes</dt><dd><%= row.member.medical_notes %></dd><% } %>
                  <% } %>
                </dl>
                <p class="hint">To make changes, edit this profile on the <a href="/admin/members/<%= row.member.id %>/edit">Members page</a>.</p>
                <div class="notes-dialog-actions">
                  <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                </div>
              </dialog>
            <% }); %>
          </tbody>
          <% if (rows.length > 0) { %>
            <tfoot>
              <tr class="roster-summary-row">
                <td class="roster-summary-label">Present</td>
                <td></td><td></td>
                <% summary.forEach(function(s) { %><td><span class="summary-badge summary-present"><%= s.present %></span></td><% }); %>
              </tr>
              <tr class="roster-summary-row">
                <td class="roster-summary-label">Late</td>
                <td></td><td></td>
                <% summary.forEach(function(s) { %><td><span class="summary-badge summary-late"><%= s.late %></span></td><% }); %>
              </tr>
              <tr class="roster-summary-row">
                <td class="roster-summary-label">Absent</td>
                <td></td><td></td>
                <% summary.forEach(function(s) { %><td><span class="summary-badge summary-absent"><%= s.absent %></span></td><% }); %>
              </tr>
            </tfoot>
          <% } %>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
