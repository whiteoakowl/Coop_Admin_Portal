<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/parent/classes/dashboard?<%= viewerQuery %>">&larr; Classroom Dashboard</a></p>
    <h1><%= cls.class_name %></h1>
    <%# A real request: "The top description above tabs should simply
        say, (member name) registered for this class." - replaces the
        older day/time/room summary line (that info now lives in the
        Details tab's own Schedule row below). A later real request
        ("it won't let me click on class lessons under classroom
        dashboard") added the selectedParent branch - this same page now
        also shows a family member's own TEACHING/ASSISTING class
        (?viewer=parent-<id>, no child/registration involved at all). %>
    <% if (selectedParent) { %>
      <p class="hint"><strong><%= selectedParent.name %></strong> teaches or assists this class.</p>
    <% } else { %>
      <p class="hint"><strong><%= selectedChild.name %></strong> registered for this class.</p>
    <% } %>

    <%# A real request: "Remove assignment tab from classroom dashboard" -
        Grades (below) already covers the one thing parents actually used
        Assignments for (seeing a scored assignment); the un-scored list
        this tab duplicated is gone. selectedParent's own teaching/
        assisting view never had Assignments/Grades/Attendance tabs at
        all - those are per-STUDENT academic records, meaningless for a
        teacher looking at their own class. %>
    <div class="view-tabs no-print">
      <a class="view-tab<%= tab === 'details' ? ' active' : '' %>" href="?tab=details&<%= viewerQuery %>">Details</a>
      <a class="view-tab<%= tab === 'lessons' ? ' active' : '' %>" href="?tab=lessons&<%= viewerQuery %>">Lessons</a>
      <% if (!selectedParent) { %>
        <a class="view-tab<%= tab === 'attendance' ? ' active' : '' %>" href="?tab=attendance&<%= viewerQuery %>">Attendance</a>
      <% } %>
      <% if (cls.allow_parent_chat) { %>
        <a class="view-tab<%= tab === 'chat' ? ' active' : '' %>" href="?tab=chat&<%= viewerQuery %>">Chat</a>
      <% } %>
      <% if (!selectedParent) { %>
        <a class="view-tab<%= tab === 'grades' ? ' active' : '' %>" href="?tab=grades&<%= viewerQuery %>">Grades</a>
      <% } %>
    </div>

    <div class="view-tab-panel">
      <% if (tab === 'details') { %>
        <%# A real request: "Details should have teachers, assistants,
            room number, start and end dates, start and end time, day of
            the week, class description, supply list" - redesigned per a
            later request to look like a provided reference image: a row
            of labeled icon fields (Schedule/Teacher(s)/Assistant(s)/
            Start Date/End Date/Grade-Age/Room/Enrolled) next to a Supply
            List box, with Class Description as its own box underneath.
            Reuses the same class-view-info-item/-label/-value classes
            views/parent-class-fragment.ejs's own class-info popup
            already established, just stacked one field per row instead
            of side-by-side, since there are too many fields here to fit
            a few per row cleanly. %>
        <div class="class-detail-v2">
          <div class="class-detail-v2-rows">
            <div class="class-view-info-item">
              <svg class="icon"><use href="#icon-calendar-check"/></svg>
              <div>
                <span class="class-view-info-label">Schedule</span>
                <strong class="class-view-info-value"><%= cls.dayLabel %> &middot; <%= cls.timeLabel %></strong>
              </div>
            </div>
            <div class="class-view-info-item">
              <svg class="icon"><use href="#icon-user"/></svg>
              <div>
                <span class="class-view-info-label">Teacher(s)</span>
                <strong class="class-view-info-value"><%= cls.teacherNames.length ? cls.teacherNames.join(', ') : 'None assigned' %></strong>
              </div>
            </div>
            <div class="class-view-info-item">
              <svg class="icon"><use href="#icon-users"/></svg>
              <div>
                <span class="class-view-info-label">Assistant(s)</span>
                <strong class="class-view-info-value"><%= cls.assistantNames && cls.assistantNames.length ? cls.assistantNames.join(', ') : 'None assigned' %></strong>
              </div>
            </div>
            <div class="class-view-info-item">
              <svg class="icon"><use href="#icon-calendar-check"/></svg>
              <div>
                <span class="class-view-info-label">Start Date</span>
                <strong class="class-view-info-value"><%= cls.start_date || 'Not set' %></strong>
              </div>
            </div>
            <div class="class-view-info-item">
              <svg class="icon"><use href="#icon-calendar-check"/></svg>
              <div>
                <span class="class-view-info-label">End Date</span>
                <strong class="class-view-info-value"><%= cls.end_date || 'Not set' %></strong>
              </div>
            </div>
            <div class="class-view-info-item">
              <svg class="icon"><use href="#icon-graduation-cap"/></svg>
              <div>
                <span class="class-view-info-label">Grade/Age</span>
                <strong class="class-view-info-value"><%= cls.gradeLabel || 'Not set' %></strong>
              </div>
            </div>
            <div class="class-view-info-item">
              <svg class="icon"><use href="#icon-map-pin"/></svg>
              <div>
                <span class="class-view-info-label">Room</span>
                <strong class="class-view-info-value"><%= cls.room || 'Not set' %></strong>
              </div>
            </div>
            <div class="class-view-info-item">
              <svg class="icon"><use href="#icon-users"/></svg>
              <div>
                <span class="class-view-info-label">Enrolled</span>
                <strong class="class-view-info-value"><%= cls.studentCount %><% if (cls.capacity != null) { %> / <%= cls.capacity %><% } %></strong>
              </div>
            </div>
            <% if (cls.price_cents != null) { %>
              <div class="class-view-info-item">
                <svg class="icon"><use href="#icon-tag"/></svg>
                <div>
                  <span class="class-view-info-label">Cost per Student</span>
                  <strong class="class-view-info-value">$<%= (cls.price_cents / 100).toFixed(2) %></strong>
                </div>
              </div>
            <% } %>
          </div>
          <div class="class-detail-v2-side">
            <h3><svg class="icon"><use href="#icon-clipboard-list"/></svg> Supply List</h3>
            <p class="hint" style="white-space: pre-wrap;"><%= cls.supply_list || 'No supplies required.' %></p>
          </div>
        </div>
        <% if (cls.description) { %>
          <div class="class-detail-v2-description-box">
            <h3><svg class="icon"><use href="#icon-megaphone"/></svg> Class Description</h3>
            <div class="hint forum-editable-display"><%- cls.description %></div>
          </div>
        <% } %>
      <% } else if (tab === 'grades') { %>
        <% const graded = assignments.filter(function(a) { return a.graded; }); %>
        <% if (graded.length === 0) { %>
          <p class="roster-empty">No grades recorded yet.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table">
              <thead>
                <tr><th>Assignment</th><th>Score</th><th>Feedback</th></tr>
              </thead>
              <tbody>
                <% graded.forEach(function(a) { %>
                  <tr>
                    <td class="roster-name-col"><strong><%= a.title %></strong></td>
                    <td><strong><%= a.points_earned %><% if (a.points_possible != null) { %> / <%= a.points_possible %><% } %></strong></td>
                    <td><%= a.feedback || '—' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      <% } else if (tab === 'lessons') { %>
        <%# selectedParent (a teacher/assistant viewing their own class, no
            child involved) never gets quiz-taking - allow_parent_complete_
            lessons only ever means "let a parent complete a LESSON ON
            BEHALF OF their child." %>
        <%- include('partials/lessons-view', { lessons, canTakeQuiz: !selectedParent && !!cls.allow_parent_complete_lessons, quizBasePath: '/parent', quizQuery: `?${viewerQuery}` }) %>
      <% } else if (tab === 'chat') { %>
        <%- include('partials/class-chat', { chatMessages, postUrl: `/parent/classes/dashboard/${cls.id}/chat?${viewerQuery}` }) %>
      <% } else if (tab === 'attendance') { %>
        <% if (attendance.length === 0) { %>
          <p class="roster-empty">No attendance recorded yet.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table class-attendance-table">
              <thead>
                <tr><th>Date</th><th>Status</th><th>Check-In</th><th>Check-Out</th></tr>
              </thead>
              <tbody>
                <% attendance.forEach(function(h) { %>
                  <tr>
                    <td><%= h.dateLabel %></td>
                    <td><span class="status-badge status-badge-<%= h.status %>"><%= h.statusLabel %></span></td>
                    <td><%= h.checkInTime || '—' %></td>
                    <td><%= h.checkOutTime || '—' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      <% } else { %>
        <p class="roster-empty">Coming soon.</p>
      <% } %>
    </div>
  </main>
</body>
</html>
