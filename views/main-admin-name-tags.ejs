<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Name Tags</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="view-tabs no-print">
      <a class="view-tab<%= tab === 'design' ? ' active' : '' %>" href="/main-admin/name-tags?tab=design">Design</a>
      <a class="view-tab<%= tab === 'print' ? ' active' : '' %>" href="/main-admin/name-tags?tab=print">Print</a>
      <a class="view-tab<%= tab === 'requests' ? ' active' : '' %>" href="/main-admin/name-tags?tab=requests">Requests</a>
    </div>

    <div class="view-tab-panel">
      <% if (tab === 'requests') { %>
        <div class="roster-toolbar no-print">
          <div class="category-filter" style="margin: 0;">
            <label for="date-select">Date</label>
            <select id="date-select" onchange="window.location = '/main-admin/name-tags?tab=requests<%= showArchived ? '&archived=1' : '' %>' + (this.value ? '&date=' + encodeURIComponent(this.value) : '')">
              <option value="">All dates</option>
              <% dates.forEach(function(d) { %>
                <option value="<%= d.date %>" <%= dateFilter === d.date ? 'selected' : '' %>><%= d.label %></option>
              <% }); %>
            </select>
          </div>
          <div class="roster-btn-row">
            <a
              class="roster-action-btn archived-toggle-btn<%= showArchived ? ' active' : '' %>"
              href="/main-admin/name-tags?tab=requests<%= showArchived ? '' : '&archived=1' %><%= dateFilter ? '&date=' + encodeURIComponent(dateFilter) : '' %>"
            >Archived</a>
            <a class="roster-action-btn file-action-btn" href="/main-admin/name-tags/requests/export.csv?archived=<%= showArchived ? 1 : 0 %><%= dateFilter ? '&date=' + encodeURIComponent(dateFilter) : '' %>">Export</a>
            <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
          </div>
        </div>

        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table logs-screen-table">
            <thead>
              <tr><th>Submitted</th><th>Name</th><th>Request</th><th>Day</th><th>Description</th><th></th></tr>
            </thead>
            <tbody>
              <% if (submissions.length === 0) { %>
                <tr><td colspan="6" class="roster-empty">No <%= showArchived ? 'archived' : '' %> name tag requests yet.</td></tr>
              <% } %>
              <% submissions.forEach(function(s) { %>
                <tr>
                  <td><%= s.timestamp %></td>
                  <td><%= s.memberName %></td>
                  <td><%= s.requestTypeLabel %></td>
                  <td><%= s.dayLabel %></td>
                  <td><%= s.description %></td>
                  <td class="no-print">
                    <form method="POST" action="/main-admin/name-tags/requests/<%= s.id %>/<%= showArchived ? 'unarchive' : 'archive' %>">
                      <button type="submit" class="btn-secondary condensed-btn"><%= showArchived ? 'Unarchive' : 'Archive' %></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>

        <table class="roster-table members-table condensed-table logs-print-table">
          <thead>
            <tr><th>Submitted</th><th>Name</th><th>Request</th><th>Day</th><th>Description</th></tr>
          </thead>
          <tbody>
            <% if (allSubmissions.length === 0) { %>
              <tr><td colspan="5" class="roster-empty">No <%= showArchived ? 'archived' : '' %> name tag requests yet.</td></tr>
            <% } %>
            <% allSubmissions.forEach(function(s) { %>
              <tr>
                <td><%= s.timestamp %></td>
                <td><%= s.memberName %></td>
                <td><%= s.requestTypeLabel %></td>
                <td><%= s.dayLabel %></td>
                <td><%= s.description %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else if (tab === 'design') { %>
        <div class="name-tag-design-toolbar">
          <select class="name-tag-type-select" id="design-type-select">
            <option value="student" <%= initialType === 'student' ? 'selected' : '' %>>Student Name Tag</option>
            <option value="parent" <%= initialType === 'parent' ? 'selected' : '' %>>Parent Name Tag</option>
            <option value="admin" <%= initialType === 'admin' ? 'selected' : '' %>>Admin Name Tag</option>
            <option value="scheduleCard" <%= initialType === 'scheduleCard' ? 'selected' : '' %>>Schedule Card</option>
            <option value="setupCleanup" <%= initialType === 'setupCleanup' ? 'selected' : '' %>>Setup/Cleanup Badge</option>
            <option value="custom" <%= initialType === 'custom' ? 'selected' : '' %>>Custom Badge</option>
          </select>
          <!-- name-tag-editor.js reads/drives this select directly; the
               visible control above delegates into it (see design-print-hub.js)
               so switching among Student/Parent/Admin/Setup-Cleanup/Custom
               still uses the editor's own type-switch logic unmodified. -->
          <select id="name-tag-type-select" hidden>
            <option value="student">Student</option>
            <option value="parent">Parent</option>
            <option value="admin">Admin</option>
            <option value="setupCleanup">Setup/Cleanup</option>
            <option value="custom">Custom</option>
          </select>

          <div id="design-name-tag-toolbar-controls" class="design-toolbar-inline">
            <div class="name-tag-toolbar-group">
              <button type="button" class="name-tag-icon-btn" id="undo-btn" aria-label="Undo" title="Undo"><svg class="icon"><use href="#icon-undo"/></svg></button>
              <button type="button" class="name-tag-icon-btn" id="redo-btn" aria-label="Redo" title="Redo"><svg class="icon"><use href="#icon-redo"/></svg></button>
            </div>
            <div class="name-tag-toolbar-group">
              <select class="name-tag-zoom-select" id="name-tag-zoom-select" aria-label="Zoom">
                <option value="0.25">25%</option>
                <option value="0.5">50%</option>
                <option value="0.75">75%</option>
                <option value="1" selected>100%</option>
                <option value="1.5">150%</option>
                <option value="2">200%</option>
              </select>
              <button type="button" class="name-tag-icon-btn" id="grid-toggle-btn" aria-label="Toggle Grid" title="Toggle Grid"><svg class="icon"><use href="#icon-grid"/></svg></button>
              <button type="button" class="name-tag-icon-btn" id="snap-toggle-btn" aria-label="Toggle Snap to Grid" title="Toggle Snap to Grid"><svg class="icon"><use href="#icon-magnet"/></svg></button>
            </div>
            <div class="name-tag-editor-actions">
              <button type="button" class="btn-secondary" id="reset-template-btn">Reset to Default</button>
              <button type="button" class="btn-secondary" id="copy-design-btn">Copy Design to All Name Tags</button>
              <button type="button" class="primary-btn" id="save-template-btn">Save Template</button>
              <span id="save-status" class="hint"></span>
            </div>
          </div>

          <div id="design-schedule-card-toolbar-controls" class="design-toolbar-inline" hidden>
            <div class="name-tag-toolbar-group">
              <button type="button" class="name-tag-icon-btn" id="schedule-card-undo-btn" aria-label="Undo" title="Undo"><svg class="icon"><use href="#icon-undo"/></svg></button>
              <button type="button" class="name-tag-icon-btn" id="schedule-card-redo-btn" aria-label="Redo" title="Redo"><svg class="icon"><use href="#icon-redo"/></svg></button>
            </div>
            <div class="name-tag-toolbar-group">
              <select class="name-tag-zoom-select" id="schedule-card-zoom-select" aria-label="Zoom">
                <option value="0.25">25%</option>
                <option value="0.5">50%</option>
                <option value="0.75">75%</option>
                <option value="1" selected>100%</option>
                <option value="1.5">150%</option>
                <option value="2">200%</option>
              </select>
              <button type="button" class="name-tag-icon-btn" id="schedule-card-grid-toggle-btn" aria-label="Toggle Grid" title="Toggle Grid"><svg class="icon"><use href="#icon-grid"/></svg></button>
              <button type="button" class="name-tag-icon-btn" id="schedule-card-snap-toggle-btn" aria-label="Toggle Snap to Grid" title="Toggle Snap to Grid"><svg class="icon"><use href="#icon-magnet"/></svg></button>
            </div>
            <div class="name-tag-editor-actions">
              <button type="button" class="btn-secondary" id="schedule-card-reset-btn">Reset to Default</button>
              <button type="button" class="primary-btn" id="schedule-card-save-btn">Save Template</button>
              <span id="schedule-card-save-status" class="hint"></span>
            </div>
          </div>
        </div>

        <div id="design-name-tag-section">
          <div class="name-tag-editor" id="name-tag-editor">
            <div class="name-tag-editor-body">
              <div class="name-tag-canvas-col">
                <div class="name-tag-canvas-zoom-wrap" id="name-tag-canvas-zoom-wrap">
                  <div class="badge-canvas name-tag-canvas" id="name-tag-canvas"></div>
                  <div class="name-tag-grid-overlay" id="name-tag-grid-overlay"></div>
                  <div class="name-tag-selection-overlay" id="name-tag-selection-overlay"></div>
                </div>
              </div>
              <div class="name-tag-editor-controls">
                <div class="name-tag-tool-icons" id="name-tag-tool-icons">
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-field" aria-label="Add Text" title="Add Text"><svg class="icon"><use href="#icon-type"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-shape" aria-label="Add Element" title="Add Element"><svg class="icon"><use href="#icon-square"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-image" aria-label="Add Image" title="Add Image"><svg class="icon"><use href="#icon-image"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-barcode" aria-label="Add Barcode" title="Add Barcode"><svg class="icon"><use href="#icon-barcode"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="background" aria-label="Change Background" title="Change Background"><svg class="icon"><use href="#icon-palette"/></svg></button>
                </div>
                <div class="name-tag-tool-panel" id="name-tag-tool-panel"></div>
                <div class="name-tag-properties" id="name-tag-properties"></div>
              </div>
            </div>
          </div>
        </div>

        <div id="design-schedule-card-section" hidden>
          <div class="name-tag-editor" id="schedule-card-editor">
            <div class="name-tag-editor-body">
              <div class="name-tag-canvas-col">
                <div class="name-tag-canvas-zoom-wrap" id="schedule-card-canvas-zoom-wrap">
                  <div class="badge-canvas name-tag-canvas" id="schedule-card-canvas"></div>
                  <div class="name-tag-grid-overlay" id="schedule-card-grid-overlay"></div>
                  <div class="name-tag-selection-overlay" id="schedule-card-selection-overlay"></div>
                </div>
              </div>
              <div class="name-tag-editor-controls">
                <div class="name-tag-tool-icons" id="schedule-card-tool-icons">
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-field" aria-label="Add Text" title="Add Text"><svg class="icon"><use href="#icon-type"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-table" aria-label="Add Schedule Table" title="Add Schedule Table"><svg class="icon"><use href="#icon-grid"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-shape" aria-label="Add Element" title="Add Element"><svg class="icon"><use href="#icon-square"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-image" aria-label="Add Image" title="Add Image"><svg class="icon"><use href="#icon-image"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="background" aria-label="Change Background" title="Change Background"><svg class="icon"><use href="#icon-palette"/></svg></button>
                </div>
                <div class="name-tag-tool-panel" id="schedule-card-tool-panel"></div>
                <div class="name-tag-properties" id="schedule-card-properties"></div>
              </div>
            </div>
          </div>
        </div>

        <script id="name-tag-data" type="application/json"><%- nameTagDataJson %></script>
        <script id="schedule-card-data" type="application/json"><%- scheduleCardDataJson %></script>
        <script src="/js/vendor/jsbarcode.min.js"></script>
        <script src="/js/name-tag-render-core.js"></script>
        <script src="/js/name-tag-render.js"></script>
        <script src="/js/badge-autofit.js"></script>
        <script src="/js/name-tag-editor.js"></script>
        <script src="/js/schedule-card-editor.js"></script>
        <script src="/js/design-print-hub.js"></script>
      <% } else { %>
        <div class="name-tag-design-toolbar">
          <select class="name-tag-type-select" id="print-type-select">
            <option value="scheduleCards">Schedule Cards</option>
            <option value="nameTags">Name Tags</option>
            <option value="cardsBoth">Name Tags + Schedule Cards</option>
            <option value="cardsDuplex">Name Tags + Schedule Cards (Front &amp; Back)</option>
            <option value="barcodes">Barcodes Only</option>
            <option value="barcodeLabels">Barcode Mailing Labels</option>
            <option value="setupCleanupBadges" <%= initialPrintPanel === 'setupCleanupBadges' ? 'selected' : '' %>>Setup/Cleanup Badges</option>
            <option value="bypassBadge" <%= initialPrintPanel === 'bypassBadge' ? 'selected' : '' %>>Setup/Cleanup Bypass Badges</option>
            <option value="customBadges" <%= initialPrintPanel === 'customBadges' ? 'selected' : '' %>>Custom Badges</option>
            <option value="classCheckinQr">Class Check-In QR Codes</option>
            <option value="playgroundQr">Playground Check-In QR Codes</option>
            <option value="libraryBarcodes">Library Barcodes</option>
          </select>
        </div>

        <div id="print-schedule-cards-section">
          <form method="POST" action="/main-admin/name-tags/print-cards" target="_blank" id="schedule-print-form" data-bulk-print-refresh>
            <div class="roster-toolbar no-print">
              <div class="schedule-filters">
                <select class="name-tag-bulk-filter-select" id="schedule-print-filter-select">
                  <option value="all">All</option>
                  <option value="student">Students Only</option>
                  <option value="primaryParent">Primary Parents Only</option>
                  <option value="parent">Parents Only</option>
                  <option value="admin">Admins Only</option>
                  <option value="teacher">Teachers Only</option>
                </select>
                <%- include('partials/family-filter-select', { id: 'schedule-print-family-select', families: families }) %>
                <div class="category-filter schedule-search">
                  <label for="schedule-print-search-input">Search</label>
                  <input type="search" id="schedule-print-search-input" placeholder="Search by member name&hellip;" />
                </div>
                <label class="checkbox-option schedule-print-select-all">
                  <input type="checkbox" id="schedule-print-select-all-checkbox" />
                  Select All
                </label>
              </div>
              <div class="roster-btn-row">
                <button type="submit" class="primary-btn">Print</button>
              </div>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'schedule-print-list' }) %>
            </div>
          </form>
        </div>

        <div id="print-name-tags-section" hidden>
          <form method="POST" action="/main-admin/name-tags/print" target="_blank" id="bulk-print-form" data-bulk-print-refresh>
            <div class="name-tag-bulk-filter">
              <select class="name-tag-bulk-filter-select" id="name-tag-bulk-filter-select">
                <option value="all">All</option>
                <option value="student">Students Only</option>
                <option value="primaryParent" selected>Primary Parents Only</option>
                <option value="parent">Parents Only</option>
                <option value="admin">Admins Only</option>
                <option value="teacher">Teachers Only</option>
              </select>
              <%- include('partials/family-filter-select', { id: 'name-tag-bulk-family-select', families: families }) %>
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="name-tag-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="name-tag-select-none-checkbox" />
                Select None
              </label>
              <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
              <button type="submit" formaction="/main-admin/name-tags/print-plain-parent" class="btn-secondary name-tag-bulk-submit" title="Selected parents only, no schedule or setup/cleanup team">Print Plain Parent Tags</button>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'name-tag-bulk-list', skipRows: true }) %>
            </div>
          </form>
        </div>

        <div id="print-cardsBoth-section" hidden>
          <form method="POST" action="/main-admin/name-tags/print-both" target="_blank" id="cards-both-print-form" data-bulk-print-refresh>
            <p class="hint">Prints each selected member's Name Tag and Schedule Card side by side.</p>
            <div class="name-tag-bulk-filter">
              <select class="name-tag-bulk-filter-select" id="cards-both-bulk-filter-select">
                <option value="all">All</option>
                <option value="student">Students Only</option>
                <option value="primaryParent">Primary Parents Only</option>
                <option value="parent">Parents Only</option>
                <option value="admin">Admins Only</option>
                <option value="teacher">Teachers Only</option>
              </select>
              <%- include('partials/family-filter-select', { id: 'cards-both-bulk-family-select', families: families }) %>
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="cards-both-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="cards-both-select-none-checkbox" />
                Select None
              </label>
              <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'cards-both-bulk-list', skipRows: true }) %>
            </div>
          </form>
        </div>

        <div id="print-cardsDuplex-section" hidden>
          <form method="POST" action="/main-admin/name-tags/print-duplex" target="_blank" id="cards-duplex-print-form" data-bulk-print-refresh>
            <p class="hint">Prints each selected member's Name Tag on the front of a sheet and their Schedule Card on the back, in matching positions - print double-sided (flip on the long edge) and cut apart for two-sided cards.</p>
            <div class="name-tag-bulk-filter">
              <select class="name-tag-bulk-filter-select" id="cards-duplex-bulk-filter-select">
                <option value="all">All</option>
                <option value="student">Students Only</option>
                <option value="primaryParent">Primary Parents Only</option>
                <option value="parent">Parents Only</option>
                <option value="admin">Admins Only</option>
                <option value="teacher">Teachers Only</option>
              </select>
              <%- include('partials/family-filter-select', { id: 'cards-duplex-bulk-family-select', families: families }) %>
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="cards-duplex-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="cards-duplex-select-none-checkbox" />
                Select None
              </label>
              <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'cards-duplex-bulk-list', skipRows: true }) %>
            </div>
          </form>
        </div>

        <div id="print-barcodes-section" hidden>
          <form method="POST" action="/main-admin/name-tags/print-barcodes" target="_blank" id="barcodes-print-form" data-bulk-print-refresh>
            <div class="name-tag-bulk-filter">
              <select class="name-tag-bulk-filter-select" id="barcodes-bulk-filter-select">
                <option value="all">All</option>
                <option value="student">Students Only</option>
                <option value="primaryParent">Primary Parents Only</option>
                <option value="parent">Parents Only</option>
                <option value="admin">Admins Only</option>
                <option value="teacher">Teachers Only</option>
              </select>
              <%- include('partials/family-filter-select', { id: 'barcodes-bulk-family-select', families: families }) %>
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="barcodes-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="barcodes-select-none-checkbox" />
                Select None
              </label>
              <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'barcodes-bulk-list', skipRows: true }) %>
            </div>
          </form>
        </div>

        <div id="print-barcodeLabels-section" hidden>
          <form method="POST" action="/main-admin/name-tags/print-barcode-labels" target="_blank" id="barcode-labels-print-form" data-bulk-print-refresh>
            <p class="hint">Barcode, name, and ID number per label - sized for Avery 08160-style address label sheets (1in x 2-5/8in, 30 per sheet).</p>
            <div class="name-tag-bulk-filter">
              <select class="name-tag-bulk-filter-select" id="barcode-labels-bulk-filter-select">
                <option value="all">All</option>
                <option value="student">Students Only</option>
                <option value="primaryParent">Primary Parents Only</option>
                <option value="parent">Parents Only</option>
                <option value="admin">Admins Only</option>
                <option value="teacher">Teachers Only</option>
              </select>
              <%- include('partials/family-filter-select', { id: 'barcode-labels-bulk-family-select', families: families }) %>
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="barcode-labels-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="barcode-labels-select-none-checkbox" />
                Select None
              </label>
              <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'barcode-labels-bulk-list', skipRows: true }) %>
            </div>
          </form>
        </div>

        <div id="print-setupCleanupBadges-section" hidden>
          <%- include('partials/misc-badge-print-panel', { type: 'setupCleanup', label: 'Setup/Cleanup', badges: setupCleanupBadges, basePath: '/main-admin/name-tags' }) %>
        </div>

        <%
        // A real request: "make bypass setup/cleanup cards it's own
        // selection for bulk printing in the dropdown menu. it should
        // print 8 cards to a sheet. same size as the name tags and
        // schedule cards." Not a pick-from-a-list panel like every other
        // one here - there's only ever one bypass badge, so this is just
        // "how many copies do you want" (routes/main-admin-name-tags.js's
        // /badges/bypass/print reuses the exact same main-admin-misc-
        // badges-print view/8-per-sheet grid every other misc badge
        // already prints through, so the size/layout is already right).
        %>
        <div id="print-bypassBadge-section" class="manage-section" hidden>
          <h2>Setup/Cleanup Bypass Badges</h2>
          <% if (!bypassBadge) { %>
            <p class="hint">No Setup/Cleanup bypass badge found.</p>
          <% } else { %>
            <p class="hint"><%= bypassBadge.description %></p>
            <form method="POST" action="/main-admin/name-tags/badges/bypass/print" target="_blank">
              <label>How many copies?
                <select name="quantity">
                  <% for (let n = 1; n <= 50; n++) { %>
                    <option value="<%= n %>" <%= n === 10 ? 'selected' : '' %>><%= n %></option>
                  <% } %>
                </select>
              </label>
              <div class="roster-btn-row">
                <button type="submit" class="primary-btn">Print</button>
              </div>
            </form>
          <% } %>
        </div>

        <div id="print-customBadges-section" hidden>
          <%- include('partials/misc-badge-print-panel', { type: 'custom', label: 'Custom', badges: customBadges, basePath: '/main-admin/name-tags' }) %>
        </div>

        <div id="print-classCheckinQr-section" hidden>
          <form method="POST" action="/main-admin/name-tags/print-classcheckin-qr" target="_blank" id="classcheckin-qr-print-form" data-bulk-print-refresh>
            <div class="name-tag-bulk-filter">
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="classcheckin-qr-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="classcheckin-qr-select-none-checkbox" />
                Select None
              </label>
              <button type="button" class="roster-action-btn" id="classcheckin-qr-filter-btn">Filter</button>
              <% if (classesForQr.length > 0) { %>
                <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
              <% } %>
            </div>
            <% if (classesForQr.length === 0) { %>
              <p class="roster-empty">No classes yet.</p>
            <% } else { %>
              <div class="roster-scroll print-picker-scroll">
                <table class="roster-table members-table condensed-table" id="classcheckin-qr-list">
                  <thead><tr><th></th><th>Class</th><th>Day</th><th>Room</th><th>Time</th></tr></thead>
                  <tbody>
                    <% classesForQr.forEach(function(c) { %>
                      <tr class="qr-picker-row" data-day="<%= c.day %>" data-room="<%= c.room || '' %>">
                        <td><input type="checkbox" name="classIds" value="<%= c.id %>" /></td>
                        <td><%= c.class_name %></td>
                        <td><%= c.dayLabel %></td>
                        <td><%= c.room || '—' %></td>
                        <td><%= c.timeLabel || '—' %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </form>

          <dialog id="classcheckin-qr-filter-dialog" class="qr-filter-dialog">
            <div class="qr-filter-dialog-header">
              <h2>Filter Classes</h2>
              <div class="qr-filter-dialog-actions">
                <button type="button" class="roster-action-btn" id="classcheckin-qr-filter-save-btn">Save</button>
                <button type="button" class="class-form-dialog-close" onclick="this.closest('dialog').close()" aria-label="Close"><svg class="icon"><use href="#icon-x-circle"/></svg></button>
              </div>
            </div>
            <div class="qr-filter-dialog-body">
              <label for="classcheckin-qr-filter-day-select">Day</label>
              <select id="classcheckin-qr-filter-day-select">
                <option value="">All Days</option>
                <option value="monday">Monday</option>
                <option value="wednesday">Wednesday</option>
              </select>
              <label for="classcheckin-qr-filter-room-select">Room</label>
              <select id="classcheckin-qr-filter-room-select">
                <option value="">All Rooms</option>
                <% qrRoomOptions.forEach(function(r) { %>
                  <option value="<%= r %>"><%= r %></option>
                <% }); %>
              </select>
            </div>
          </dialog>
        </div>

        <div id="print-playgroundQr-section" hidden>
          <p class="hint">Prints one QR code per playground hour, 4 to a page (one page per day) - anybody can scan one to check in or out, no roster required.</p>
          <a class="primary-btn" href="/main-admin/name-tags/print-playground-qr" target="_blank">Print Playground Check-In QR Codes</a>
        </div>

        <div id="print-libraryBarcodes-section" hidden>
          <form method="POST" action="/main-admin/name-tags/print-library-barcodes" target="_blank" id="library-barcodes-print-form" data-bulk-print-refresh>
            <div class="name-tag-bulk-filter">
              <select class="name-tag-bulk-filter-select" id="library-barcodes-filter-select">
                <option value="all">All Categories</option>
                <% libraryTypes.forEach(function(t) { %>
                  <option value="<%= t %>"><%= t %></option>
                <% }); %>
              </select>
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="library-barcodes-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="library-barcodes-select-none-checkbox" />
                Select None
              </label>
              <% if (libraryItems.length > 0) { %>
                <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
              <% } %>
            </div>
            <% if (libraryItems.length === 0) { %>
              <p class="roster-empty">No library items yet.</p>
            <% } else { %>
              <div class="roster-scroll print-picker-scroll">
                <table class="roster-table members-table condensed-table" id="library-barcodes-list">
                  <thead><tr><th></th><th>Title</th><th>Category</th></tr></thead>
                  <tbody>
                    <% libraryItems.forEach(function(item) { %>
                      <tr class="library-picker-row" data-type="<%= item.type || '' %>">
                        <td><input type="checkbox" name="itemIds" value="<%= item.id %>" /></td>
                        <td><%= item.title %></td>
                        <td><%= item.type || '—' %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </form>
        </div>

        <script src="/js/design-print-hub.js"></script>
        <script src="/js/bulk-print-refresh.js"></script>
      <% } %>
    </div>
  </main>
</body>
</html>
