<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Announcements' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/registration-windows', icon: 'clock', label: 'Registration' },
      { href: '/main-admin/diplomas', icon: 'badge', label: 'Diplomas' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%- include('partials/main-admin-settings-tabs', { activeSettingsTab: 'website' }) %>
    <h1>Website</h1>
    <p class="hint">Edit the public homepage's copy, announcements, and FAQs without touching code. <a href="/" target="_blank">View the live site &rarr;</a></p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <section class="portal-dashboard-card portal-dashboard-card-wide">
      <h2>Homepage Content</h2>
      <form method="POST" action="/main-admin/website/settings" class="member-form-grid">
        <label class="member-form-full">Organization Name
          <input type="text" name="org_name" value="<%= settings.org_name %>" required />
        </label>
        <label class="member-form-full">Tagline
          <input type="text" name="tagline" value="<%= settings.tagline %>" />
        </label>
        <label class="member-form-full">Hero Heading
          <input type="text" name="hero_heading" value="<%= settings.hero_heading %>" required />
        </label>
        <label class="member-form-full">Hero Body
          <textarea name="hero_body" rows="2"><%= settings.hero_body %></textarea>
        </label>
        <label class="member-form-full">Meeting Schedule
          <input type="text" name="meeting_schedule_text" value="<%= settings.meeting_schedule_text %>" />
        </label>
        <label class="member-form-full">About Section
          <textarea name="about_body" rows="3"><%= settings.about_body %></textarea>
        </label>
        <label class="member-form-full">Benefits Section
          <textarea name="benefits_body" rows="3"><%= settings.benefits_body %></textarea>
        </label>
        <label>Contact Email
          <input type="email" name="contact_email" value="<%= settings.contact_email || '' %>" />
        </label>
        <label>Contact Phone
          <input type="text" name="contact_phone" value="<%= settings.contact_phone || '' %>" />
        </label>
        <div class="member-form-full">
          <button type="submit" class="primary-btn">Save Homepage Content</button>
        </div>
      </form>
    </section>

    <%# A real request: "the public home page announcements should be
        listed under the announcements tab" - posting/managing them
        moved to /main-admin/announcements (its "Public" Send To
        option). %>
    <p class="hint">Public homepage announcements are now posted and managed from <a href="/main-admin/announcements">Announcements</a>.</p>

    <section class="portal-dashboard-card portal-dashboard-card-wide">
      <h2>FAQs</h2>
      <form method="POST" action="/main-admin/website/faqs" class="member-form-grid">
        <label class="member-form-full">Question
          <input type="text" name="question" required />
        </label>
        <label class="member-form-full">Answer
          <textarea name="answer" rows="2" required></textarea>
        </label>
        <div class="member-form-full">
          <button type="submit" class="roster-action-btn">Add FAQ</button>
        </div>
      </form>
      <% if (faqs.length === 0) { %>
        <p class="roster-empty">No FAQs yet.</p>
      <% } else { %>
        <div class="site-faq-list">
          <% faqs.forEach(function(faq) { %>
            <details class="site-faq-item">
              <summary><%= faq.question %></summary>
              <p><%= faq.answer %></p>
              <form method="POST" action="/main-admin/website/faqs/<%= faq.id %>/delete" data-confirm="Delete this FAQ?">
                <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
              </form>
            </details>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
