<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%- include('partials/main-admin-settings-tabs', { activeSettingsTab: 'website' }) %>
    <h1>Public Homepage</h1>
    <p><a href="/welcome" target="_blank">View the live site &rarr;</a></p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <section class="manage-section">
      <div class="grid-box-header">
        <h2>Site Info</h2>
      </div>
      <form method="POST" action="/main-admin/website/settings" class="member-form-grid">
        <label class="member-form-full">Organization Name
          <input type="text" name="org_name" value="<%= settings.org_name %>" required />
        </label>
        <label>Contact Email
          <input type="email" name="contact_email" value="<%= settings.contact_email || '' %>" />
        </label>
        <label>Contact Phone
          <input type="text" name="contact_phone" value="<%= settings.contact_phone || '' %>" />
        </label>
        <div class="member-form-full">
          <button type="submit" class="primary-btn">Save Site Info</button>
        </div>
      </form>
    </section>

    <%
      // A real request: "edit the entire homepage like you would on
      // Spotify or wix. Drag and drop images and text of different size
      // choices. Add buttons and links." This canvas used to be desktop-
      // only (a later real request, "Make the homepage design features
      // mobile friendly," reversed that - see public/css/styles.css's
      // own comment on this section for why it was safe to just remove
      // the restriction rather than build a second, separate mobile UI).
      // homepage_blocks (supabase/migrations/20261118010000_
      // homepage_builder.sql) is an ordered list of text/image/button
      // blocks - this canvas is the admin's own drag-and-drop editor for
      // that list; views/public-home.ejs renders the same list, in the
      // same order, on the real public page.
      var BLOCK_TYPE_LABELS = { text: 'Text', image: 'Image', button: 'Button' };
    %>
    <section class="manage-section homepage-builder-section">
      <div class="grid-box-header">
        <h2>Homepage Content</h2>
        <div class="roster-btn-row homepage-builder-add-row no-print">
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-block-dialog-text').showModal()">+ Text</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-block-dialog-image').showModal()">+ Image</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-block-dialog-button').showModal()">+ Button</button>
        </div>
      </div>

      <% if (blocks.length === 0) { %>
        <p class="roster-empty">No homepage content yet - add a text, image, or button block above.</p>
      <% } else { %>
        <div class="homepage-builder-canvas" data-homepage-blocks-container data-reorder-url="/main-admin/website/blocks/reorder">
          <% blocks.forEach(function(b) { %>
            <div class="homepage-builder-block" data-homepage-block-row="<%= b.id %>">
              <span data-homepage-block-drag-handle class="lesson-drag-handle" title="Drag to reorder">&#9776;</span>
              <div class="homepage-builder-block-preview">
                <span class="badge-pill badge-pill-gray homepage-builder-block-type"><%= BLOCK_TYPE_LABELS[b.block_type] %></span>
                <% if (b.block_type === 'text') { %>
                  <span class="homepage-builder-block-text-preview homepage-text-<%= b.text_size %>"><%= b.text_body || '(empty)' %></span>
                <% } else if (b.block_type === 'image') { %>
                  <% if (b.imageUrl) { %><img src="<%= b.imageUrl %>" alt="" class="homepage-builder-block-image-preview" /><% } else { %><span class="hint">No image chosen yet</span><% } %>
                <% } else if (b.block_type === 'button') { %>
                  <span class="homepage-builder-block-button-preview"><%= b.button_label || '(untitled button)' %> &rarr; <%= b.button_url || '(no link)' %></span>
                <% } %>
              </div>
              <div class="homepage-builder-block-actions">
                <button type="button" class="icon-btn" onclick="document.getElementById('edit-block-dialog-<%= b.id %>').showModal()" aria-label="Edit block" title="Edit"><svg class="icon"><use href="#icon-edit"/></svg></button>
                <form method="POST" action="/main-admin/website/blocks/<%= b.id %>/delete" data-confirm="Remove this block?" class="inline-block-form">
                  <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete block" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>

    <%# A real request: "Should be able to edit or add menu tabs to the
        homepage." A much simpler ordered list than the content blocks
        above (label + URL, no type to branch on) - reuses the exact same
        drag-reorder script (public/js/homepage-block-reorder.js is
        generic over its own data-homepage-block-row/data-homepage-
        blocks-container attributes), just pointed at its own reorder
        endpoint via data-reorder-url. %>
    <section class="manage-section homepage-builder-section">
      <div class="grid-box-header">
        <h2>Menu Tabs</h2>
        <div class="roster-btn-row no-print">
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-menu-item-dialog').showModal()">+ Menu Tab</button>
        </div>
      </div>
      <p class="hint">Shown as a row of links in the public homepage's own header. Leave empty for no menu.</p>

      <% if (menuItems.length === 0) { %>
        <p class="roster-empty">No menu tabs yet - add one above.</p>
      <% } else { %>
        <div class="homepage-builder-canvas" data-homepage-blocks-container data-reorder-url="/main-admin/website/menu-items/reorder">
          <% menuItems.forEach(function(item) { %>
            <div class="homepage-builder-block" data-homepage-block-row="<%= item.id %>">
              <span data-homepage-block-drag-handle class="lesson-drag-handle" title="Drag to reorder">&#9776;</span>
              <div class="homepage-builder-block-preview">
                <span class="homepage-builder-block-button-preview"><%= item.label %> &rarr; <%= item.url %></span>
              </div>
              <div class="homepage-builder-block-actions">
                <button type="button" class="icon-btn" onclick="document.getElementById('edit-menu-item-dialog-<%= item.id %>').showModal()" aria-label="Edit menu tab" title="Edit"><svg class="icon"><use href="#icon-edit"/></svg></button>
                <form method="POST" action="/main-admin/website/menu-items/<%= item.id %>/delete" data-confirm="Remove this menu tab?" class="inline-block-form">
                  <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete menu tab" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>

    <dialog id="add-menu-item-dialog" class="member-picker-dialog dialog-label-stack">
      <form method="POST" action="/main-admin/website/menu-items">
        <h3>Add Menu Tab</h3>
        <label>Label
          <input type="text" name="label" required />
        </label>
        <label>URL
          <input type="text" name="url" placeholder="https://... or /events" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Menu Tab</button>
        </div>
      </form>
    </dialog>

    <% menuItems.forEach(function(item) { %>
      <dialog id="edit-menu-item-dialog-<%= item.id %>" class="member-picker-dialog dialog-label-stack">
        <form method="POST" action="/main-admin/website/menu-items/<%= item.id %>/update">
          <h3>Edit Menu Tab</h3>
          <label>Label
            <input type="text" name="label" value="<%= item.label %>" required />
          </label>
          <label>URL
            <input type="text" name="url" value="<%= item.url %>" placeholder="https://... or /events" required />
          </label>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Save Changes</button>
          </div>
        </form>
      </dialog>
    <% }); %>

    <%# Per-block Edit dialogs. %>
    <% blocks.forEach(function(b) { %>
      <dialog id="edit-block-dialog-<%= b.id %>" class="member-picker-dialog dialog-label-stack">
        <form method="POST" action="/main-admin/website/blocks/<%= b.id %>/update" enctype="multipart/form-data">
          <h3>Edit <%= BLOCK_TYPE_LABELS[b.block_type] %> Block</h3>
          <% if (b.block_type === 'text') { %>
            <label>Text
              <textarea name="textBody" rows="3"><%= b.text_body || '' %></textarea>
            </label>
            <label>Size
              <select name="textSize">
                <option value="small" <%= b.text_size === 'small' ? 'selected' : '' %>>Small</option>
                <option value="medium" <%= b.text_size === 'medium' ? 'selected' : '' %>>Medium</option>
                <option value="large" <%= b.text_size === 'large' ? 'selected' : '' %>>Large</option>
              </select>
            </label>
          <% } else if (b.block_type === 'image') { %>
            <% if (b.imageUrl) { %><p class="hint">Current image: <img src="<%= b.imageUrl %>" alt="" class="homepage-builder-dialog-image-preview" /></p><% } %>
            <label>Replace Image <span class="hint">(optional - leave blank to keep the current one)</span>
              <input type="file" name="image" accept="image/*" />
            </label>
            <label>Alt Text <span class="hint">(describes the image for screen readers)</span>
              <input type="text" name="imageAlt" value="<%= b.image_alt || '' %>" />
            </label>
            <label>Size
              <select name="imageSize">
                <option value="small" <%= b.image_size === 'small' ? 'selected' : '' %>>Small</option>
                <option value="medium" <%= b.image_size === 'medium' ? 'selected' : '' %>>Medium</option>
                <option value="large" <%= b.image_size === 'large' ? 'selected' : '' %>>Large</option>
                <option value="full" <%= b.image_size === 'full' ? 'selected' : '' %>>Full Width</option>
              </select>
            </label>
          <% } else if (b.block_type === 'button') { %>
            <label>Button Text
              <input type="text" name="buttonLabel" value="<%= b.button_label || '' %>" />
            </label>
            <label>Link URL
              <input type="text" name="buttonUrl" value="<%= b.button_url || '' %>" placeholder="https://... or /register" />
            </label>
          <% } %>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Save Changes</button>
          </div>
        </form>
      </dialog>
    <% }); %>

    <%# Add Block dialogs - one per type, each a plain single-purpose
        form (no type picker to toggle) since the "+ Text/+ Image/
        + Button" buttons above already say which kind is being added. %>
    <dialog id="add-block-dialog-text" class="member-picker-dialog dialog-label-stack">
      <form method="POST" action="/main-admin/website/blocks">
        <input type="hidden" name="blockType" value="text" />
        <h3>Add Text Block</h3>
        <label>Text
          <textarea name="textBody" rows="3"></textarea>
        </label>
        <label>Size
          <select name="textSize">
            <option value="small">Small</option>
            <option value="medium" selected>Medium</option>
            <option value="large">Large</option>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Text Block</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-block-dialog-image" class="member-picker-dialog dialog-label-stack">
      <form method="POST" action="/main-admin/website/blocks" enctype="multipart/form-data">
        <input type="hidden" name="blockType" value="image" />
        <h3>Add Image Block</h3>
        <label>Image
          <input type="file" name="image" accept="image/*" required />
        </label>
        <label>Alt Text <span class="hint">(describes the image for screen readers)</span>
          <input type="text" name="imageAlt" />
        </label>
        <label>Size
          <select name="imageSize">
            <option value="small">Small</option>
            <option value="medium" selected>Medium</option>
            <option value="large">Large</option>
            <option value="full">Full Width</option>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Image Block</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-block-dialog-button" class="member-picker-dialog dialog-label-stack">
      <form method="POST" action="/main-admin/website/blocks">
        <input type="hidden" name="blockType" value="button" />
        <h3>Add Button Block</h3>
        <label>Button Text
          <input type="text" name="buttonLabel" required />
        </label>
        <label>Link URL
          <input type="text" name="buttonUrl" placeholder="https://... or /register" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Button Block</button>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/homepage-block-reorder.js"></script>
</body>
</html>
