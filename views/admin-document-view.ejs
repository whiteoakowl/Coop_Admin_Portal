<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main document-view-main">
    <div class="grid-box-header">
      <p class="subtitle"><a href="/admin/documents">&larr; All Documents</a></p>
      <button type="button" class="roster-action-btn" data-copy-link="<%= publicOrigin %>/documents/<%= doc.public_token %>">Copy Link</button>
    </div>
    <% if (doc.image_path) { %>
      <img class="document-view-image" src="/admin/documents/<%= doc.id %>/image" alt="" />
    <% } %>
    <h1><%= doc.title %></h1>
    <div class="document-view-frame-wrap">
      <iframe class="document-view-frame" src="/admin/documents/<%= doc.id %>/file" title="<%= doc.title %>"></iframe>
    </div>
  </main>
  <script src="/js/copy-link.js"></script>
</body>
</html>
