<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Vocabulary</h1>
    <p class="subtitle">Level: <span class="badge-pill badge-pill-orange"><%= levelLabel %></span> - based on your grade level on file.</p>

    <div class="vocabulary-game-stage">
      <div class="vocabulary-game-card" id="vg-card">
        <p class="vocabulary-game-progress" id="vg-progress"></p>
        <p class="vocabulary-game-clue" id="vg-clue"></p>
        <input type="text" id="vg-input" class="vocabulary-game-input" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Type the word..." />
        <p class="vocabulary-game-feedback" id="vg-feedback"></p>
        <button type="button" class="primary-btn" id="vg-submit">Submit</button>
      </div>

      <div class="vocabulary-game-card" id="vg-result" hidden>
        <h2>Round Complete!</h2>
        <p id="vg-result-text" class="vocabulary-game-result-text"></p>
        <button type="button" class="primary-btn" id="vg-again">Play Again</button>
      </div>
    </div>

    <h2 class="reading-achievements-heading-row">Top Players</h2>
    <% if (!topPlayers.length) { %>
      <p class="hint">No one has played yet - be the first!</p>
    <% } else { %>
      <ol class="reading-leaderboard-list">
        <% topPlayers.forEach((p) => { %>
          <li class="reading-leaderboard-row">
            <span class="reading-leaderboard-rank">#<%= p.rank %></span>
            <span><%= p.name %></span>
            <span class="reading-leaderboard-points"><%= p.points %> pts</span>
          </li>
        <% }) %>
      </ol>
    <% } %>
  </main>

  <script>
    var VOCABULARY_ROUND = <%- JSON.stringify(round) %>;
  </script>
  <script src="/js/vocabulary-game.js" defer></script>
</body>
</html>
