<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter portrait; margin: 0.5in; }</style>
</head>
<body class="admin-page setup-teams-print-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= dayLabel %> Setup/Cleanup Teams</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <% if (teams.length === 0) { %>
      <p class="roster-empty">No teams yet.</p>
    <% } %>

    <div class="team-card-grid setup-team-card-grid">
      <% teams.forEach(function(t, i) { %>
        <%# Same wrapper/classes as the live manage page's own print
            output (views/admin-setup.ejs) - see that file's comment for
            why data-shrink-to-fit-budget exists. Deliberately no editable
            form controls here at all (no <input>, no <select>, no edit/
            delete/remove buttons) - this page is read-only by design, so
            there's nothing for @media print to have to hide.
            print-header is repeated inside every card's own wrapper
            (a real request: "the logo header should be on every page")
            rather than once at the top of the document - one team per
            physical page means a single top-level header would only
            ever land on whichever page happens to hold it, not every
            page. Wrapped together with .team-col in one inner div (not
            as separate siblings of .team-print-page-fit) because
            print-shrink-to-fit.js's fitOne() shrinks exactly ONE element
            - wrap.firstElementChild - so header and card have to be that
            same single child to shrink as one unit together.
            data-shrink-to-fit-group="teams" is a real request: "all pages
            should have the same font size" - without it, a light team
            barely shrinks while a busy team shrinks a lot, so pages read
            at visibly different sizes; the shared group name makes every
            team's page level down to whichever one team needed the most
            shrinking, so all pages match. %>
        <div class="team-print-page-fit" data-shrink-to-fit-on-print data-shrink-to-fit-group="teams" data-shrink-to-fit-budget="9.2in">
          <div class="team-print-page-inner">
            <div class="print-header">
              <img src="/img/logo.png" alt="" />
              <div>
                <p class="print-header-title">Sanford Homeschoolers</p>
                <p class="print-header-sub"><%= dayLabel %> Setup/Cleanup Teams</p>
              </div>
            </div>
            <div class="team-col">
              <div class="team-info-card team-accent-<%= i % 5 %>">
                <span class="team-info-icon"><svg class="icon"><use href="#icon-broom"/></svg></span>
                <h3 class="team-info-title"><%= t.title %></h3>
                <% if (t.description) { %><p class="team-info-desc-print"><%= t.description %></p><% } %>
                <div class="team-print-meta">
                  <% if (t.leaderName) { %><span class="team-print-meta-item"><svg class="icon"><use href="#icon-user"/></svg> <%= t.leaderName %></span><% } %>
                  <% if (t.meeting_time) { %><span class="team-print-meta-item"><svg class="icon"><use href="#icon-clock"/></svg> <%= t.meeting_time %></span><% } %>
                  <% if (t.meeting_location) { %><span class="team-print-meta-item"><svg class="icon"><use href="#icon-map-pin"/></svg> <%= t.meeting_location %></span><% } %>
                </div>
              </div>
              <div class="team-members-card">
                <h4>Members</h4>
                <div class="team-card-members">
                  <% if (t.members.length === 0) { %>
                    <p class="team-card-empty">No members yet.</p>
                  <% } %>
                  <% t.members.forEach(function(m) { %>
                    <div class="team-member-row<%= absentIds.has(m.id) ? ' team-member-row-absent' : '' %>">
                      <span class="team-member-avatar"><%= m.name.charAt(0).toUpperCase() %></span>
                      <span class="team-member-name" title="<%= m.name %><%= absentIds.has(m.id) ? ' (absent today)' : '' %>"><%= m.name %><% if (m.infant) { %> <span class="team-member-flag">(infant)</span><% } %></span>
                    </div>
                  <% }); %>
                </div>
              </div>
              <% if (t.taskSection && t.taskSection.items.length > 0) { %>
                <div class="team-tasks-card">
                  <h4>Tasks</h4>
                  <ol class="team-tasks-list">
                    <% t.taskSection.items.forEach(function(item) { %>
                      <li><%= item.description %></li>
                    <% }); %>
                  </ol>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </main>
  <script src="/js/print-shrink-to-fit.js"></script>
  <script src="/js/print-auto.js"></script>
</body>
</html>
