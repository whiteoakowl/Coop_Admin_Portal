<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle no-print"><a href="/admin/lesson-plans/<%= plan.id %>">&larr; <%= plan.title %></a></p>
    <h1><%= plan.title %> Settings</h1>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <%# A real request: "the new page allows you change lesson plan
        settings. Check boxes lined up in a single row with text
        starting at the check box, they say allow teachers to edit/add
        to the lesson plan, all members to edit/add to the lesson
        plan." Genuinely new ground - see the lesson_plans_edit_
        permissions migration's own comment on why nothing reads these
        two flags yet; this is the admin-facing settings surface they're
        recorded from. %>
    <div class="manage-section">
      <h3>Edit Permissions</h3>
      <form method="POST" action="/admin/lesson-plans/<%= plan.id %>/settings" class="stack-form">
        <div class="checkbox-inline-row">
          <label class="checkbox-inline-label"><input type="checkbox" name="allowTeacherEdit" value="1" <%= plan.allow_teacher_edit ? 'checked' : '' %> /> Allow teachers to edit/add to the lesson plan</label>
          <label class="checkbox-inline-label"><input type="checkbox" name="allowMemberEdit" value="1" <%= plan.allow_member_edit ? 'checked' : '' %> /> Allow all members to edit/add to the lesson plan</label>
        </div>
        <button type="submit" class="primary-btn">Save Settings</button>
      </form>
    </div>

    <%# A real request: "Admins can create lessons plans and assign them
        to a class to be used as an option." A flat class picker (every
        class app-wide) - "Dropdown menu shows class titles, time and
        semester day in parenthesis." %>
    <div class="manage-section">
      <h3>Assign to a Co-op Class</h3>
      <p class="hint">Adds a new, independent copy of this lesson plan as a Lesson on the class you pick -
        editing it afterward (from either side) never changes this original.</p>
      <form method="POST" action="/admin/lesson-plans/<%= plan.id %>/assign" class="stack-form">
        <label>Class
          <select name="classId" required>
            <option value="">Choose a class&hellip;</option>
            <% classes.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.class_name %> (<%= c.timeLabel %>, <%= c.dayLabel %><% if (c.semesterTitle) { %> - <%= c.semesterTitle %><% } %>)</option>
            <% }); %>
          </select>
        </label>
        <button type="submit" class="primary-btn">Assign</button>
      </form>
    </div>
  </main>
</body>
</html>
