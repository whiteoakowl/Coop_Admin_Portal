<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="landing">
  <%- include('partials/icon-sprite') %>
  <div class="landing-corner-actions">
    <button type="button" class="admin-corner-link" id="fullscreen-toggle-btn">
      <svg class="icon"><use href="#icon-maximize"/></svg>
      <span id="fullscreen-toggle-label">Full Screen View</span>
    </button>
  </div>
  <main class="landing-wrap">
    <div class="landing-banner">
      <img class="landing-logo-sm" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <div class="landing-welcome">Welcome to Co-op!</div>
    </div>

    <div class="landing-grid landing-grid-two">
      <a class="landing-card landing-card-orange" href="/kiosk">
        <span class="landing-icon"><svg class="icon"><use href="#icon-check"/></svg></span>
        <span class="landing-label">Kiosk</span>
      </a>
      <a class="landing-card landing-card-purple" href="/admin/login">
        <span class="landing-icon"><svg class="icon"><use href="#icon-sliders"/></svg></span>
        <span class="landing-label">Admin Login</span>
      </a>
    </div>
  </main>
  <script src="/js/fullscreen-toggle.js"></script>
</body>
</html>
