<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="landing">
  <%- include('partials/icon-sprite') %>
  <a class="admin-corner-link" href="/admin">Admin</a>
  <main class="landing-wrap">
    <img class="landing-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />

    <div class="landing-columns">
      <div class="landing-column">
        <a class="landing-card" href="/kiosk/checkin">
          <span class="landing-icon"><svg class="icon"><use href="#icon-check-circle"/></svg></span>
          <span class="landing-label">Check in</span>
        </a>
        <a class="landing-card" href="/kiosk/checkout">
          <span class="landing-icon"><svg class="icon"><use href="#icon-log-out"/></svg></span>
          <span class="landing-label">Check out</span>
        </a>
      </div>
      <div class="landing-column">
        <a class="landing-card" href="/volunteers/monday">
          <span class="landing-icon"><svg class="icon"><use href="#icon-users"/></svg></span>
          <span class="landing-label">Monday Volunteers</span>
        </a>
        <a class="landing-card" href="/volunteers/wednesday">
          <span class="landing-icon"><svg class="icon"><use href="#icon-users"/></svg></span>
          <span class="landing-label">Wednesday Volunteers</span>
        </a>
      </div>
      <div class="landing-column">
        <a class="landing-card" href="/setup/monday">
          <span class="landing-icon"><svg class="icon"><use href="#icon-wrench"/></svg></span>
          <span class="landing-label">Monday Setup/Cleanup Teams</span>
        </a>
        <a class="landing-card" href="/setup/wednesday">
          <span class="landing-icon"><svg class="icon"><use href="#icon-wrench"/></svg></span>
          <span class="landing-label">Wednesday Setup/Cleanup Teams</span>
        </a>
      </div>
    </div>
  </main>
</body>
</html>
