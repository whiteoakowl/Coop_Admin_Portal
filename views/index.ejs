<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="landing">
  <main class="landing-wrap">
    <img class="landing-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
    <h1>Sanford Homeschoolers</h1>
    <p class="subtitle">Check-In / Check-Out System</p>

    <div class="landing-grid">
      <a class="landing-card" href="/kiosk/checkin">
        <span class="landing-icon">✅</span>
        <span class="landing-label">Check In</span>
        <span class="landing-desc">Scan your barcode to check in</span>
      </a>
      <a class="landing-card" href="/kiosk/checkout">
        <span class="landing-icon">🚪</span>
        <span class="landing-label">Check Out</span>
        <span class="landing-desc">Scan your barcode &amp; pick your number</span>
      </a>
      <a class="landing-card" href="/absence">
        <span class="landing-icon">📝</span>
        <span class="landing-label">Absence/Late Form</span>
        <span class="landing-desc">Can't make it, or running late? Let us know</span>
      </a>
      <a class="landing-card landing-card-admin" href="/admin">
        <span class="landing-icon">🔐</span>
        <span class="landing-label">Admin</span>
        <span class="landing-desc">Rosters &amp; member management</span>
      </a>
    </div>
  </main>
</body>
</html>
