<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="landing">
  <%- include('partials/icon-sprite') %>
  <main class="landing-wrap">
    <div class="landing-banner">
      <img class="landing-logo-sm" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <div class="landing-welcome">Welcome to Co-op!</div>
    </div>

    <div class="home-login-card">
      <h2 class="home-login-title">Member Login</h2>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/login" class="stack-form">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" required autofocus />

        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />

        <button type="submit" class="primary-btn">Log In</button>
      </form>

      <p class="home-login-hint">Don't have a login yet? Ask a co-op admin to set one up for you.</p>
    </div>

    <a class="home-staff-login" href="/admin/login">Staff Login</a>
  </main>
</body>
</html>
