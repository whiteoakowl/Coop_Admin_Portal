<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Design / Print</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="view-tabs no-print">
      <a class="view-tab<%= tab === 'design' ? ' active' : '' %>" href="/admin/design?tab=design">Design</a>
      <a class="view-tab<%= tab === 'print' ? ' active' : '' %>" href="/admin/design?tab=print">Print</a>
    </div>

    <div class="view-tab-panel">
      <% if (tab === 'design') { %>
        <div class="name-tag-design-toolbar">
          <select class="name-tag-type-select" id="design-type-select">
            <option value="student" <%= initialType === 'student' ? 'selected' : '' %>>Student Name Tag</option>
            <option value="parent" <%= initialType === 'parent' ? 'selected' : '' %>>Parent Name Tag</option>
            <option value="scheduleCard" <%= initialType === 'scheduleCard' ? 'selected' : '' %>>Schedule Card</option>
            <option value="setupCleanup" <%= initialType === 'setupCleanup' ? 'selected' : '' %>>Setup/Cleanup Badge</option>
            <option value="custom" <%= initialType === 'custom' ? 'selected' : '' %>>Custom Badge</option>
          </select>
          <!-- name-tag-editor.js reads/drives this select directly; the
               visible control above delegates into it (see design-print-hub.js)
               so switching among Student/Parent/Setup-Cleanup/Custom
               still uses the editor's own type-switch logic unmodified. -->
          <select id="name-tag-type-select" hidden>
            <option value="student">Student</option>
            <option value="parent">Parent</option>
            <option value="setupCleanup">Setup/Cleanup</option>
            <option value="custom">Custom</option>
          </select>

          <div id="design-name-tag-toolbar-controls" class="design-toolbar-inline">
            <div class="name-tag-toolbar-group">
              <button type="button" class="name-tag-icon-btn" id="undo-btn" aria-label="Undo" title="Undo"><svg class="icon"><use href="#icon-undo"/></svg></button>
              <button type="button" class="name-tag-icon-btn" id="redo-btn" aria-label="Redo" title="Redo"><svg class="icon"><use href="#icon-redo"/></svg></button>
            </div>
            <div class="name-tag-toolbar-group">
              <select class="name-tag-zoom-select" id="name-tag-zoom-select" aria-label="Zoom">
                <option value="0.25">25%</option>
                <option value="0.5">50%</option>
                <option value="0.75">75%</option>
                <option value="1" selected>100%</option>
                <option value="1.5">150%</option>
                <option value="2">200%</option>
              </select>
              <button type="button" class="name-tag-icon-btn" id="grid-toggle-btn" aria-label="Toggle Grid" title="Toggle Grid"><svg class="icon"><use href="#icon-grid"/></svg></button>
              <button type="button" class="name-tag-icon-btn" id="snap-toggle-btn" aria-label="Toggle Snap to Grid" title="Toggle Snap to Grid"><svg class="icon"><use href="#icon-magnet"/></svg></button>
            </div>
            <div class="name-tag-editor-actions">
              <button type="button" class="btn-secondary" id="reset-template-btn">Reset to Default</button>
              <button type="button" class="primary-btn" id="save-template-btn">Save Template</button>
              <span id="save-status" class="hint"></span>
            </div>
          </div>

          <div id="design-schedule-card-toolbar-controls" class="design-toolbar-inline" hidden>
            <div class="name-tag-toolbar-group">
              <button type="button" class="name-tag-icon-btn" id="schedule-card-undo-btn" aria-label="Undo" title="Undo"><svg class="icon"><use href="#icon-undo"/></svg></button>
              <button type="button" class="name-tag-icon-btn" id="schedule-card-redo-btn" aria-label="Redo" title="Redo"><svg class="icon"><use href="#icon-redo"/></svg></button>
            </div>
            <div class="name-tag-toolbar-group">
              <select class="name-tag-zoom-select" id="schedule-card-zoom-select" aria-label="Zoom">
                <option value="0.25">25%</option>
                <option value="0.5">50%</option>
                <option value="0.75">75%</option>
                <option value="1" selected>100%</option>
                <option value="1.5">150%</option>
                <option value="2">200%</option>
              </select>
              <button type="button" class="name-tag-icon-btn" id="schedule-card-grid-toggle-btn" aria-label="Toggle Grid" title="Toggle Grid"><svg class="icon"><use href="#icon-grid"/></svg></button>
              <button type="button" class="name-tag-icon-btn" id="schedule-card-snap-toggle-btn" aria-label="Toggle Snap to Grid" title="Toggle Snap to Grid"><svg class="icon"><use href="#icon-magnet"/></svg></button>
            </div>
            <div class="name-tag-editor-actions">
              <button type="button" class="btn-secondary" id="schedule-card-reset-btn">Reset to Default</button>
              <button type="button" class="primary-btn" id="schedule-card-save-btn">Save Template</button>
              <span id="schedule-card-save-status" class="hint"></span>
            </div>
          </div>
        </div>

        <div id="design-name-tag-section">
          <div class="name-tag-editor" id="name-tag-editor">
            <div class="name-tag-editor-body">
              <div class="name-tag-canvas-col">
                <div class="name-tag-canvas-zoom-wrap" id="name-tag-canvas-zoom-wrap">
                  <div class="badge-canvas name-tag-canvas" id="name-tag-canvas"></div>
                  <div class="name-tag-grid-overlay" id="name-tag-grid-overlay"></div>
                  <div class="name-tag-selection-overlay" id="name-tag-selection-overlay"></div>
                </div>
              </div>
              <div class="name-tag-editor-controls">
                <div class="name-tag-tool-icons" id="name-tag-tool-icons">
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-field" aria-label="Add Text" title="Add Text"><svg class="icon"><use href="#icon-type"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-shape" aria-label="Add Element" title="Add Element"><svg class="icon"><use href="#icon-square"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-image" aria-label="Add Image" title="Add Image"><svg class="icon"><use href="#icon-image"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-barcode" aria-label="Add Barcode" title="Add Barcode"><svg class="icon"><use href="#icon-barcode"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="background" aria-label="Change Background" title="Change Background"><svg class="icon"><use href="#icon-palette"/></svg></button>
                </div>
                <div class="name-tag-tool-panel" id="name-tag-tool-panel"></div>
                <div class="name-tag-properties" id="name-tag-properties"></div>
              </div>
            </div>
          </div>
        </div>

        <div id="design-schedule-card-section" hidden>
          <div class="name-tag-editor" id="schedule-card-editor">
            <div class="name-tag-editor-body">
              <div class="name-tag-canvas-col">
                <div class="name-tag-canvas-zoom-wrap" id="schedule-card-canvas-zoom-wrap">
                  <div class="badge-canvas name-tag-canvas" id="schedule-card-canvas"></div>
                  <div class="name-tag-grid-overlay" id="schedule-card-grid-overlay"></div>
                  <div class="name-tag-selection-overlay" id="schedule-card-selection-overlay"></div>
                </div>
              </div>
              <div class="name-tag-editor-controls">
                <div class="name-tag-tool-icons" id="schedule-card-tool-icons">
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-field" aria-label="Add Text" title="Add Text"><svg class="icon"><use href="#icon-type"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-table" aria-label="Add Schedule Table" title="Add Schedule Table"><svg class="icon"><use href="#icon-grid"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-shape" aria-label="Add Element" title="Add Element"><svg class="icon"><use href="#icon-square"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="add-image" aria-label="Add Image" title="Add Image"><svg class="icon"><use href="#icon-image"/></svg></button>
                  <button type="button" class="name-tag-tool-icon-btn" data-tool="background" aria-label="Change Background" title="Change Background"><svg class="icon"><use href="#icon-palette"/></svg></button>
                </div>
                <div class="name-tag-tool-panel" id="schedule-card-tool-panel"></div>
                <div class="name-tag-properties" id="schedule-card-properties"></div>
              </div>
            </div>
          </div>
        </div>

        <script id="name-tag-data" type="application/json"><%- nameTagDataJson %></script>
        <script id="schedule-card-data" type="application/json"><%- scheduleCardDataJson %></script>
        <script src="/js/vendor/jsbarcode.min.js"></script>
        <script src="/js/name-tag-render-core.js"></script>
        <script src="/js/name-tag-render.js"></script>
        <script src="/js/name-tag-editor.js"></script>
        <script src="/js/schedule-card-editor.js"></script>
        <script src="/js/design-print-hub.js"></script>
      <% } else { %>
        <div class="name-tag-design-toolbar">
          <select class="name-tag-type-select" id="print-type-select">
            <option value="scheduleCards">Schedule Cards</option>
            <option value="nameTags">Name Tags</option>
            <option value="cardsBoth">Name Tags + Schedule Cards</option>
            <option value="barcodes">Barcodes Only</option>
            <option value="setupCleanupBadges" <%= initialPrintPanel === 'setupCleanupBadges' ? 'selected' : '' %>>Setup/Cleanup Badges</option>
            <option value="customBadges" <%= initialPrintPanel === 'customBadges' ? 'selected' : '' %>>Custom Badges</option>
            <option value="schedules">Schedules</option>
            <option value="logs">Logs</option>
          </select>
        </div>

        <div id="print-schedule-cards-section">
          <form method="POST" action="/admin/schedule/print-cards" target="_blank" id="schedule-print-form">
            <div class="roster-toolbar no-print">
              <div class="schedule-filters">
                <div class="category-filter schedule-search">
                  <label for="schedule-print-search-input">Search</label>
                  <input type="search" id="schedule-print-search-input" placeholder="Search by member name&hellip;" />
                </div>
                <label class="checkbox-option schedule-print-select-all">
                  <input type="checkbox" id="schedule-print-select-all-checkbox" />
                  Select All
                </label>
              </div>
              <div class="roster-btn-row">
                <button type="submit" class="primary-btn">Print</button>
              </div>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'schedule-print-list' }) %>
            </div>
          </form>
        </div>

        <div id="print-name-tags-section" hidden>
          <form method="POST" action="/admin/name-tag/print" target="_blank" id="bulk-print-form">
            <div class="name-tag-bulk-filter">
              <select class="name-tag-bulk-filter-select" id="name-tag-bulk-filter-select">
                <option value="all">All</option>
                <option value="student">Students Only</option>
                <option value="parent">Parents Only</option>
              </select>
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="name-tag-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="name-tag-select-none-checkbox" />
                Select None
              </label>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'name-tag-bulk-list' }) %>
            </div>
            <div class="name-tag-bulk-submit-row">
              <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
            </div>
          </form>
        </div>

        <div id="print-cardsBoth-section" hidden>
          <form method="POST" action="/admin/design/print-both" target="_blank" id="cards-both-print-form">
            <p class="hint">Prints each selected member's Name Tag and Schedule Card side by side.</p>
            <div class="name-tag-bulk-filter">
              <select class="name-tag-bulk-filter-select" id="cards-both-bulk-filter-select">
                <option value="all">All</option>
                <option value="student">Students Only</option>
                <option value="parent">Parents Only</option>
              </select>
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="cards-both-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="cards-both-select-none-checkbox" />
                Select None
              </label>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'cards-both-bulk-list' }) %>
            </div>
            <div class="name-tag-bulk-submit-row">
              <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
            </div>
          </form>
        </div>

        <div id="print-barcodes-section" hidden>
          <form method="POST" action="/admin/name-tag/print-barcodes" target="_blank" id="barcodes-print-form">
            <div class="name-tag-bulk-filter">
              <select class="name-tag-bulk-filter-select" id="barcodes-bulk-filter-select">
                <option value="all">All</option>
                <option value="student">Students Only</option>
                <option value="parent">Parents Only</option>
              </select>
              <label class="checkbox-option name-tag-select-all">
                <input type="checkbox" id="barcodes-select-all-checkbox" />
                Select All
              </label>
              <label class="checkbox-option name-tag-select-none">
                <input type="checkbox" id="barcodes-select-none-checkbox" />
                Select None
              </label>
            </div>
            <div class="roster-scroll print-picker-scroll">
              <%- include('partials/print-picker-table', { members: members, listId: 'barcodes-bulk-list' }) %>
            </div>
            <div class="name-tag-bulk-submit-row">
              <button type="submit" class="primary-btn name-tag-bulk-submit">Print</button>
            </div>
          </form>
        </div>

        <div id="print-setupCleanupBadges-section" hidden>
          <%- include('partials/misc-badge-print-panel', { type: 'setupCleanup', label: 'Setup/Cleanup', badges: setupCleanupBadges }) %>
        </div>

        <div id="print-customBadges-section" hidden>
          <%- include('partials/misc-badge-print-panel', { type: 'custom', label: 'Custom', badges: customBadges }) %>
        </div>

        <div id="print-schedules-section" class="manage-section" hidden>
          <h2>Print Schedules</h2>
          <p class="hint">Print class schedule grids by day, or a filterable list of every member's individual schedule.</p>
          <div class="admin-card-grid">
            <a class="admin-card" href="/admin/class-schedule/monday/print" target="_blank">Monday Class Schedule</a>
            <a class="admin-card" href="/admin/class-schedule/wednesday/print" target="_blank">Wednesday Class Schedule</a>
            <a class="admin-card" href="/admin/schedule/print" target="_blank">Member Schedules List</a>
          </div>
        </div>

        <div id="print-logs-section" class="manage-section" hidden>
          <h2>Print Logs</h2>
          <p class="hint">Each log has its own Print button once opened, alongside its date filter.</p>
          <div class="admin-card-grid">
            <a class="admin-card" href="/admin/logs?tab=absence">Absence/Late Log</a>
            <a class="admin-card" href="/admin/logs?tab=checkinout">Check In/Out Log</a>
            <a class="admin-card" href="/admin/logs?tab=nametag">Name Tag Request Log</a>
          </div>
        </div>

        <script src="/js/design-print-hub.js"></script>
      <% } %>
    </div>
  </main>
</body>
</html>
