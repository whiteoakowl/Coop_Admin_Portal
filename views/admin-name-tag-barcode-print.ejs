<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main badge-print-main">
    <div class="print-preview-header no-print">
      <h1>Print Barcodes</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <% if (members.length === 0) { %>
      <p class="roster-empty">No members selected.</p>
    <% } %>

    <%
      // 3 across x 8 down fills a US Letter sheet with room for margins -
      // 24 per page.
      var pages = [];
      for (var i = 0; i < members.length; i += 24) pages.push(members.slice(i, i + 24));
    %>
    <% pages.forEach(function(pageMembers) { %>
      <div class="badge-sheet-page barcode-sheet">
        <% pageMembers.forEach(function(m) { %>
          <div class="barcode-cell">
            <%# Not badge-el-barcode (public/js/name-tag-render.js's shared
                selector) - this page renders its own barcodes, with a
                fixed bar width instead of that renderer's stretch-to-a-
                fixed-box sizing. See barcode-print-shrink-name.js. %>
            <svg class="barcode-cell-svg" data-barcode-value="<%= m.barcode %>"></svg>
            <div class="barcode-cell-name"><%= m.name %></div>
          </div>
        <% }); %>
      </div>
    <% }); %>
  </main>
  <script src="/js/vendor/jsbarcode.min.js"></script>
  <%# Not public/js/name-tag-render.js (the shared badge-el-barcode
      renderer) or public/js/print-auto.js like every other print-preview
      page - this one renders its own barcodes (fixed bar width) and
      triggers window.print() itself, only once that and the name-shrink
      pass have actually finished. See that script's own comment for why. %>
  <script src="/js/barcode-print-shrink-name.js"></script>
</body>
</html>
