<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/users', icon: 'user-check', label: 'Users' },
      { href: '/main-admin/roles', icon: 'sliders', label: 'Roles & Permissions' },
      { href: '/main-admin/website', icon: 'palette', label: 'Website' },
      { href: '/main-admin/events', icon: 'calendar-check', label: 'Events' },
      { href: '/main-admin/directory', icon: 'map-pin', label: 'Business Directory' },
      { href: '/main-admin/classifieds', icon: 'tag', label: 'Classifieds' },
      { href: '/main-admin/member-directory', icon: 'users', label: 'Member Directory' },
      { href: '/main-admin/forums', icon: 'users', label: 'Forums' },
      { href: '/main-admin/forms', icon: 'clipboard-list', label: 'Custom Forms' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= listing.business_name %></h1>
      <span class="badge-pill badge-pill-<%= listing.status === 'active' ? 'green' : listing.status === 'archived' ? 'gray' : 'orange' %>"><%= listing.status.charAt(0).toUpperCase() + listing.status.slice(1) %></span>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="roster-toolbar">
      <div class="roster-btn-row">
        <a class="roster-action-btn" href="/main-admin/directory">&larr; All Listings</a>
        <% if (listing.status !== 'active') { %>
          <form method="POST" action="/main-admin/directory/<%= listing.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="active" />
            <button type="submit" class="roster-action-btn">Approve</button>
          </form>
        <% } %>
        <% if (listing.status !== 'archived') { %>
          <form method="POST" action="/main-admin/directory/<%= listing.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="archived" />
            <button type="submit" class="roster-action-btn roster-action-btn-danger">Archive</button>
          </form>
        <% } %>
        <form method="POST" action="/main-admin/directory/<%= listing.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= listing.business_name %>&quot;? This cannot be undone.">
          <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
        </form>
      </div>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Details</h2></div>
      <form method="POST" action="/main-admin/directory/<%= listing.id %>" class="member-form-grid">
        <label class="member-form-full">Business Name
          <input type="text" name="businessName" value="<%= listing.business_name %>" required />
        </label>
        <label class="member-form-full">Description
          <textarea name="description" rows="3"><%= listing.description || '' %></textarea>
        </label>
        <label>Category
          <input type="text" name="category" value="<%= listing.category || '' %>" />
        </label>
        <label>Phone
          <input type="text" name="phone" value="<%= listing.phone || '' %>" />
        </label>
        <label>Email
          <input type="email" name="email" value="<%= listing.email || '' %>" />
        </label>
        <label>Website
          <input type="text" name="website" value="<%= listing.website || '' %>" />
        </label>
        <label class="member-form-full">Address
          <input type="text" name="address" value="<%= listing.address || '' %>" />
        </label>
        <label>Visibility
          <select name="visibility">
            <option value="members" <%= listing.visibility === 'members' ? 'selected' : '' %>>Members only</option>
            <option value="public" <%= listing.visibility === 'public' ? 'selected' : '' %>>Public</option>
          </select>
        </label>
        <div class="member-form-full">
          <button type="submit" class="primary-btn">Save</button>
        </div>
      </form>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Image</h2></div>
      <% if (imageUrl) { %>
        <img src="<%= imageUrl %>" alt="" style="max-width: 320px; border-radius: var(--radius); display: block; margin-bottom: 0.75rem;" />
      <% } %>
      <form method="POST" action="/main-admin/directory/<%= listing.id %>/image" enctype="multipart/form-data" class="training-resource-upload-form">
        <label>Choose an Image
          <input type="file" name="image" accept="image/*" required />
        </label>
        <button type="submit" class="btn-secondary">Upload</button>
      </form>
    </div>
  </main>
</body>
</html>
