<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Settings</h1>

    <%# A real request: "Family school management, settings tab, should
        move to settings gear. Family school management, parent portal
        have the same linked settings gear. This should also be a card
        view like admin gear settings." Same .team-card-grid/.team-info-
        card component views/main-admin-settings-hub.ejs already uses.
        settings-hub-card-grid is a second, narrower class alongside it
        just for the "shrink to 2 per row on mobile" CSS (styles.css) -
        .team-card-grid alone is shared with 24+ unrelated "pick one of
        these named things" pages (Training, Classifieds, Shop, etc.)
        that were never asked to shrink to a fixed column count. %>
    <div class="team-card-grid settings-hub-card-grid">
      <div class="team-col">
        <a class="team-info-card" href="/parent/family-school/settings">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-palette"/></svg></span>
          <h3 class="team-info-title">Family School Settings</h3>
          <p class="hint">School name, logo, colors, and NC Homeschool ID.</p>
        </a>
      </div>
      <%# A later real request: "a notifications settings card to
          control email, text and push notifications." Links straight
          to the existing, already-shared Notification Preferences page
          (/notifications/preferences) every portal account already has
          - no new page needed, just a card pointing at it from here. %>
      <div class="team-col">
        <a class="team-info-card" href="/notifications/preferences">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-bell"/></svg></span>
          <h3 class="team-info-title">Notifications</h3>
          <p class="hint">Choose which notification types reach you by email, text, or push.</p>
        </a>
      </div>
      <div class="team-col">
        <a class="team-info-card" href="/portal/settings">
          <span class="team-info-icon"><svg class="icon"><use href="#icon-lock"/></svg></span>
          <h3 class="team-info-title">My Privacy</h3>
          <p class="hint">Account-level settings - the same no matter which portal you're signed into.</p>
        </a>
      </div>
    </div>
  </main>
</body>
</html>
