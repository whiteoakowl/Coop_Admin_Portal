<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>My Event Registrations</h1>
    <p class="hint">Your family's current event registrations. To register for a new event, use <a href="/events">Events</a>.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (!hasChildren) { %>
      <p class="roster-empty">No family members are linked to your account yet. Contact an admin if this looks wrong.</p>
    <% } else if (groups.length === 0) { %>
      <p class="roster-empty">No one in your family is registered for an event yet.</p>
    <% } else { %>
      <div class="manage-classes-list">
        <% groups.forEach(function(group) { %>
          <p class="manage-classes-group-header"><%= group.member.name %></p>
          <% group.items.forEach(function(r) { %>
            <div class="manage-classes-row">
              <div class="manage-classes-row-info">
                <a class="manage-classes-row-title" href="/events/<%= r.event_id %>"><%= r.title %></a>
                <span class="manage-classes-row-meta">
                  <%= r.startsLabel %><% if (r.ticketTitle) { %> &middot; <%= r.ticketTitle %><% } %>
                </span>
              </div>
              <% if (r.status === 'waitlisted') { %>
                <span class="badge-pill">Waitlisted (#<%= r.waitlist_position %>)</span>
              <% } else { %>
                <span class="badge-pill badge-pill-present">Registered</span>
              <% } %>
              <% if (r.allowCancel) { %>
                <form method="POST" action="/events/<%= r.event_id %>/unregister" class="inline-block-form">
                  <input type="hidden" name="memberId" value="<%= r.member_id %>" />
                  <input type="hidden" name="redirectTo" value="/parent/events" />
                  <button type="submit" class="icon-btn icon-btn-danger" aria-label="Cancel <%= group.member.name %>'s registration in <%= r.title %>" title="Cancel"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </form>
              <% } %>
            </div>
          <% }); %>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
