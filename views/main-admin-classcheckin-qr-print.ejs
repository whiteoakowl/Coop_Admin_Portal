<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <%# A real bug report: "The print preview shows 4 nice class cards on one
      page ... When you go to the printer it is on two pages." Root cause:
      this @page rule's own 0.5in margin shrinks the browser's actual
      printable area to 7.5in x 10in, but .qr-sheet-page (styles.css) is
      sized to a full, un-shrunk 8.5in x 11in with its OWN 0.5in padding
      providing the visual margin - stacking both margins meant the page's
      bottom 0.5in of content had nowhere to go but a second physical page,
      even though the on-screen preview (which doesn't apply @page at all)
      looked like one page. margin: 0 here matches every other bulk print
      page in this app that sizes its own sheet div to the full 8.5x11in
      (see admin-name-tag-bulk-print.ejs, admin-schedule-print.ejs, etc.) -
      .qr-sheet-page's own padding is the only margin now, so the div's box
      exactly matches the physical page and both preview and printer agree. %>
  <style>@page { size: letter portrait; margin: 0; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1>Print Class Check-In QR Codes</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <% if (pages.length === 0) { %>
      <p class="roster-empty">No classes selected.</p>
    <% } %>

    <%
      // Portrait, evenly spaced, one page per (day, room) - a real
      // request: "printing QR sheets to scan for quick links to class
      // check in/out kiosk for teachers", later refined to "each page
      // should be all of the class qr codes for that classroom, that day"
      // (see routes/admin-design.js for how `pages` is grouped). Each QR
      // code encodes that one class's own Class Check-In quick link (the
      // same /kiosk/class-checkin/classes/:id/attendance page every class
      // card's own quick link opens), so a teacher can scan straight into
      // their class's own attendance screen without touching the kiosk's
      // own day-picker/hour-search.
    %>
    <% pages.forEach(function(page) { %>
      <div class="qr-sheet-page">
        <div class="print-header">
          <img src="/img/logo.png" alt="" />
          <div>
            <p class="print-header-title">Sanford Homeschoolers</p>
            <p class="print-header-sub"><%= page.room %> &middot; <%= page.dayLabel %></p>
          </div>
        </div>
        <div class="qr-sheet-grid">
          <% page.classes.forEach(function(cls) { %>
            <div class="qr-sheet-cell">
              <div class="qr-sheet-code" data-qr-value="<%= cls.checkInUrl %>"></div>
              <p class="qr-sheet-class-name"><%= cls.className %></p>
              <p class="qr-sheet-class-meta"><%= cls.dayLabel %><% if (cls.timeLabel) { %> &middot; <%= cls.timeLabel %><% } %></p>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </main>
  <script src="/js/vendor/qrcode.min.js"></script>
  <script src="/js/classcheckin-qr-print.js"></script>
  <script src="/js/print-auto.js"></script>
</body>
</html>
