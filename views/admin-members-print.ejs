<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <%
      // Same filter-label-parts shape as admin-members.ejs's own toolbar
      // Filter button, so this preview's heading reads the same way the
      // live page's own Filter button does.
      const selectedFamily = families.find(function (f) { return f.id === familyFilter; });
      const filterLabelParts = [];
      if (typeFilter === 'parent') filterLabelParts.push('Parent');
      else if (typeFilter === 'student') filterLabelParts.push('Student');
      else if (typeFilter === 'admin') filterLabelParts.push('Admin');
      if (dayFilter) filterLabelParts.push(dayLabels[dayFilter]);
      if (roleFilter === 'teacher') filterLabelParts.push('Teacher');
      else if (roleFilter === 'assistant') filterLabelParts.push('Class Assistant');
      if (selectedFamily) filterLabelParts.push(selectedFamily.name + ' Family');
    %>
    <div class="print-preview-header no-print">
      <h1>Members<% if (filterLabelParts.length > 0) { %> &mdash; <%= filterLabelParts.join(', ') %><% } %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Members</p>
      </div>
    </div>

    <%# Same plain Name/Type/Family/Roster/Grade/Birthday grid
        admin-members.ejs's own .members-print-table swaps in for its
        live card list on print - lifted here as-is since this page's
        whole purpose is that printout, not the interactive card list. %>
    <table class="roster-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th>Family</th>
          <th>Roster</th>
          <th>Grade</th>
          <th>Birthday</th>
        </tr>
      </thead>
      <tbody>
        <% members.forEach(function(m) { %>
          <tr>
            <td><%= m.name %><%= m.is_primary_parent ? ' (Primary)' : '' %><%= m.adminTitle ? ' (' + m.adminTitle + ')' : '' %></td>
            <td><%= m.member_type === 'parent' ? 'Parent' : m.member_type === 'admin' ? 'Admin' : 'Student' %></td>
            <td><%= m.familyName || '—' %></td>
            <td><%= m.rosters.length ? m.rosters.map(function(r) { return r.name; }).join(', ') : '—' %></td>
            <td><%= m.grade_level || '—' %></td>
            <td><%= m.birthdayLabel || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
