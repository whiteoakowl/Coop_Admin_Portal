<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Family School Management</h1>

    <% if (classes.length === 0) { %>
      <p class="roster-empty">No classes assigned to you yet.</p>
    <% } else { %>
      <div class="team-card-grid">
        <% classes.forEach(function(c) { %>
          <div class="team-col">
            <a class="team-info-card" href="/student/family-school/classes/<%= c.id %>">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
              <h3 class="team-info-title"><%= c.class_name %></h3>
              <% if (c.description) { %><p class="hint"><%= c.description %></p><% } %>
            </a>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
