<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%
  // A real bug report: "student portal, mobile. dashboard panel tab bar
  // should still be on the bottom. its not visible on calendar page."
  // /events is a genuinely public page (no requirePortalAuth - see
  // routes/events.js), so it can't assume a signed-in visitor belongs to
  // any one portal the way every other page in a specific portal can -
  // hence the plain public site-header below, not partials/portal-nav,
  // for a logged-out visitor or one signed in without a student role. A
  // signed-in student specifically gets their own portal-nav shell
  // instead (portalTitle: 'Student Portal' - the one title portal-nav.ejs
  // itself special-cases to STUDENT_NAV_LINKS/COMMUNITY_LINKS_STUDENT,
  // same as every native /student/* page), so their own bottom tab bar
  // (Home/Calendar/Chat/Classes/...) stays put here exactly like it does
  // everywhere else in their portal, instead of vanishing onto this one
  // shared page. Scoped to student accounts only - broadening this to
  // Parent/Teacher too would need their own (currently still per-page,
  // not centralized) navLinks arrays repeated here, a larger change than
  // this bug report asked for.
  const isStudentPortalAccount = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'student');
  %>
  <% if (isStudentPortalAccount) { %>
    <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>
  <% } else { %>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>
  <% } %>

  <main id="main-content" tabindex="-1"<% if (isStudentPortalAccount) { %> class="admin-main"<% } %>>
    <section class="site-section">
      <div class="site-section-inner">
        <h1>Events</h1>
        <p>Upcoming co-op events, fundraisers, and get-togethers.</p>

        <div class="roster-toolbar no-print">
          <div class="roster-btn-row">
            <div class="class-schedule-view-toggle" role="group" aria-label="List or calendar view">
              <a class="icon-btn<%= view === 'list' ? ' icon-btn-active' : '' %>" href="/events?view=list" aria-pressed="<%= view === 'list' %>" aria-label="List view" title="List view"><svg class="icon"><use href="#icon-clipboard-list"/></svg></a>
              <a class="icon-btn<%= view === 'calendar' ? ' icon-btn-active' : '' %>" href="/events?view=calendar" aria-pressed="<%= view === 'calendar' %>" aria-label="Calendar view" title="Calendar view"><svg class="icon"><use href="#icon-calendar-check"/></svg></a>
            </div>
            <a class="roster-action-btn print-action-btn" href="/events/print" target="_blank">Print</a>
            <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
              <a class="roster-action-btn" href="/events/submit">+ Submit an Event</a>
            <% } %>
          </div>
        </div>

        <% if (events.length === 0) { %>
          <p class="roster-empty">No upcoming events right now &mdash; check back soon.</p>
        <% } else if (view === 'calendar') { %>
          <div class="roster-toolbar no-print">
            <div class="roster-btn-row">
              <a class="roster-action-btn" href="/events?view=calendar&month=<%= calendar.prevParam %>">&larr; Prev</a>
              <strong><%= calendar.label %></strong>
              <a class="roster-action-btn" href="/events?view=calendar&month=<%= calendar.nextParam %>">Next &rarr;</a>
            </div>
          </div>
          <table class="roster-table condensed-table event-calendar-table">
            <thead><tr><th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th></tr></thead>
            <tbody>
              <% calendar.weeks.forEach(function(week) { %>
                <tr>
                  <% week.forEach(function(day) { %>
                    <td class="<%= day.inMonth ? '' : 'hint' %>">
                      <div><%= day.day %></div>
                      <% day.events.forEach(function(e) { %>
                        <a href="/events/<%= e.id %>" class="badge-pill" style="<%= e.categoryColor ? `background:${e.categoryColor};color:#fff;` : '' %> display:block; margin-top:2px;"><%= e.title %></a>
                      <% }); %>
                    </td>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } else { %>
          <div class="event-card-grid">
            <% events.forEach(function(e) { %>
              <a class="event-card" href="/events/<%= e.id %>">
                <% if (e.imageUrl) { %>
                  <div class="event-card-image"><img src="<%= e.imageUrl %>" alt="" /></div>
                <% } %>
                <div class="event-card-body">
                  <span class="event-card-date"><svg class="icon"><use href="#icon-calendar-check"/></svg> <%= e.startsLabel %></span>
                  <h3><%= e.title %></h3>
                  <% if (e.categoryName) { %><span class="badge-pill" style="background: <%= e.categoryColor %>; color: #fff;"><%= e.categoryName %></span><% } %>
                  <% if (e.location) { %><p class="event-card-location"><svg class="icon"><use href="#icon-map-pin"/></svg> <%= e.location %></p><% } %>
                </div>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>
