<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%
  // A real bug report: "student portal, mobile. dashboard panel tab bar
  // should still be on the bottom. its not visible on calendar page."
  // /events is a genuinely public page (no requirePortalAuth - see
  // routes/events.js), so it can't assume a signed-in visitor belongs to
  // any one portal the way every other page in a specific portal can -
  // hence the plain public site-header below, not partials/portal-nav,
  // for a logged-out visitor or one signed in without a student/parent
  // role. A signed-in student or parent specifically gets their own
  // portal-nav shell instead (portalTitle 'Student Portal'/'Parent
  // Portal' - the two titles portal-nav.ejs itself special-cases to
  // STUDENT_NAV_LINKS/PARENT_NAV_LINKS, same as every native /student/*
  // or /parent/* page), so their own bottom tab bar stays put here
  // exactly like it does everywhere else in their portal, instead of
  // vanishing onto this one shared page. Parent joined Student here once
  // a later real request ("Parent portal events, events page should show
  // the same event calendar that is on main admin portal") made Parent
  // Portal's own navLinks centralized too (PARENT_NAV_LINKS) - the exact
  // blocker this comment used to cite for not doing so ("would need
  // their own... navLinks arrays repeated here"). Teacher Portal's own
  // navLinks are still per-page, not centralized, so it's left out here
  // same as before.
  const hasStudentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'student');
  const hasParentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'parent');
  // A real bug report: "on the parent portal when you click on browse
  // events it switches to student portal. It should stay in parent
  // portal." A dual-role account (student AND parent) used to always
  // land here as Student Portal - portal-nav.ejs's own Parent/Student
  // nav links now tag their /events links with ?portal=parent|student
  // (routes/events.js's own portalParam) so this renders the nav shell
  // the visitor actually clicked from; falls back to the old guess
  // (Student, then Parent) only when that param is missing entirely -
  // e.g. a bookmarked/typed-in-by-hand /events URL.
  const requestedPortal = typeof portalParam !== 'undefined' ? portalParam : null;
  let effectivePortal = null;
  if (requestedPortal === 'parent' && hasParentRole) effectivePortal = 'parent';
  else if (requestedPortal === 'student' && hasStudentRole) effectivePortal = 'student';
  else if (hasStudentRole) effectivePortal = 'student';
  else if (hasParentRole) effectivePortal = 'parent';
  const usesPortalNavShell = effectivePortal !== null;
  const portalQuerySuffix = effectivePortal ? `&portal=${effectivePortal}` : '';
  %>
  <% if (effectivePortal === 'student') { %>
    <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>
  <% } else if (effectivePortal === 'parent') { %>
    <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>
  <% } else { %>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>
  <% } %>

  <main id="main-content" tabindex="-1"<% if (usesPortalNavShell) { %> class="admin-main"<% } %>>
    <section class="site-section">
      <div class="site-section-inner">
        <h1><%= effectivePortal === 'parent' ? 'Event Calendar' : effectivePortal === 'student' ? 'Calendar' : 'Events' %></h1>

        <div class="roster-toolbar no-print">
          <div class="roster-btn-row">
            <div class="class-schedule-view-toggle" role="group" aria-label="List or calendar view">
              <a class="icon-btn<%= view === 'list' ? ' icon-btn-active' : '' %>" href="/events?view=list<%= portalQuerySuffix %>" aria-pressed="<%= view === 'list' %>" aria-label="List view" title="List view"><svg class="icon"><use href="#icon-clipboard-list"/></svg></a>
              <a class="icon-btn<%= view === 'calendar' ? ' icon-btn-active' : '' %>" href="/events?view=calendar<%= portalQuerySuffix %>" aria-pressed="<%= view === 'calendar' %>" aria-label="Calendar view" title="Calendar view"><svg class="icon"><use href="#icon-calendar-check"/></svg></a>
            </div>
            <a class="roster-action-btn print-action-btn" href="/events/print" target="_blank">Print</a>
            <%# A real request: "my event registrations should be a
                button on the event calendar page. No subpages" - dropped
                back out of portal-nav.ejs's own Events subpages array;
                this button (Parent Portal only) is the only way there
                now. %>
            <% if (effectivePortal === 'parent') { %>
              <a class="roster-action-btn" href="/parent/events">My Event Registrations</a>
            <% } %>
            <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
              <a class="roster-action-btn" href="/events/submit">+ Submit an Event</a>
            <% } %>
          </div>
        </div>

        <%# A real bug report: "the event calendar should show regardless
            if there are events on the calendar or not" - calendar view
            used to be skipped entirely (an empty-state message shown
            instead) whenever there were zero upcoming events, same as
            list view. Calendar view now always renders the grid (an
            empty month reads the same way an empty list view does - see
            partials/event-calendar-grid's own empty-day cells), and only
            list view falls back to the empty-state message. %>
        <% if (view === 'calendar') { %>
          <%- include('partials/event-calendar-grid', {
            calendar: calendar,
            monthLinkBase: `/events?view=calendar${portalQuerySuffix}`,
            eventHref: function (e) { return `/events/${e.id}${effectivePortal ? '?portal=' + effectivePortal : ''}`; },
          }) %>
        <% } else if (events.length === 0) { %>
          <p class="roster-empty">No upcoming events right now &mdash; check back soon.</p>
        <% } else { %>
          <div class="event-card-grid">
            <% events.forEach(function(e) { %>
              <button type="button" class="event-card event-card-clickable" data-view-event="<%= e.id %>">
                <% if (e.imageUrl) { %>
                  <div class="event-card-image"><img src="<%= e.imageUrl %>" alt="" /></div>
                <% } %>
                <div class="event-card-body">
                  <span class="event-card-date"><svg class="icon"><use href="#icon-calendar-check"/></svg> <%= e.startsLabel %></span>
                  <h3><%= e.title %></h3>
                  <% if (e.categoryName) { %><span class="badge-pill" style="background: <%= e.categoryColor %>; color: #fff;"><%= e.categoryName %></span><% } %>
                  <% if (e.location) { %><p class="event-card-location"><svg class="icon"><use href="#icon-map-pin"/></svg> <%= e.location %></p><% } %>
                </div>
              </button>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <dialog id="event-card-dialog" class="parent-class-dialog event-card-dialog"></dialog>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/events-card-view.js"></script>
</body>
</html>
