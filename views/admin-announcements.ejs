<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Communication</h1>
    <div class="view-tabs">
      <a class="view-tab active" href="/admin/announcements">Announcements</a>
      <a class="view-tab" href="/admin/announcements/email">Email</a>
      <a class="view-tab" href="/admin/announcements/text">Text</a>
    </div>

    <p class="hint">
      Sends a notification to signed-in members - it shows up as an Announcement on their portal home page (Parent,
      Student, or Teacher Portal). Check "Public Homepage" to also post to the public homepage, for anyone, signed in
      or not. Choose as many recipients as you like.
    </p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/admin/announcements" class="stack-form member-form-page-panel">
      <label class="member-form-full">Title
        <input type="text" name="title" placeholder="e.g. Wednesday session cancelled" required />
      </label>
      <div class="member-form-full" data-forum-editor>
        <label>Message</label>
        <%- include('partials/forum-editor-toolbar') %>
        <div class="forum-editable" data-forum-editable contenteditable="true"></div>
        <input type="hidden" name="body" data-forum-body-input />
      </div>
      <div class="member-form-full">
        <span class="checkbox-group-label">Send to</span>
        <div class="checkbox-group">
          <label><input type="checkbox" name="targets" value="everyone" /> Everyone (all active members)</label>
          <% roles.forEach(function(r) { %>
            <label><input type="checkbox" name="targets" value="<%= r.key %>" /> <%= r.label %></label>
          <% }); %>
          <label><input type="checkbox" name="targets" value="public" /> Public Homepage</label>
        </div>
      </div>
      <div class="member-form-footer">
        <div class="member-form-footer-edit">
          <button type="submit" class="primary-btn">Send Announcement</button>
        </div>
      </div>
    </form>

    <h2>Past Announcements</h2>
    <% if (log.length === 0) { %>
      <p class="roster-empty">No announcements sent yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table condensed-table">
          <thead><tr><th>Title</th><th>Message</th><th>Portals</th><th>Recipients</th><th>Sent</th></tr></thead>
          <tbody>
            <% log.forEach(function(s) { %>
              <tr>
                <td class="roster-name-col"><%= s.title %></td>
                <td class="forum-editable-display"><%- s.body %></td>
                <td><%= targetLabels(s.targets).join(', ') %></td>
                <td><%= s.recipient_count %></td>
                <td><%= s.created_at %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
  <script src="/js/forum-editor.js"></script>
</body>
</html>
