<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%
    // A real bug report: "parent portal, when you click on an event its
    // should be a normal page with the dashboard panel and header still
    // like the other pages" + "backing out of an event takes you to
    // student portal. It should stay in parent portal." /events/:id is a
    // genuinely public page (no requirePortalAuth - see routes/events.js),
    // so it can't assume a signed-in visitor belongs to one portal the way
    // a native /parent/* or /student/* page can - same shape as events-
    // list.ejs's own fix for /events itself (see its own comment for the
    // full history). A signed-in student or parent gets their real portal
    // nav shell here too, using the same ?portal=parent|student param
    // (routes/events.js's own portalPrefix keeps it attached across every
    // register/cancel/volunteer/claim action that redirects back to this
    // same page) so a dual-role account never gets bounced to the wrong
    // portal mid-visit.
    const hasStudentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'student');
    const hasParentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'parent');
    const requestedPortal = typeof portalParam !== 'undefined' ? portalParam : null;
    let effectivePortal = null;
    if (requestedPortal === 'parent' && hasParentRole) effectivePortal = 'parent';
    else if (requestedPortal === 'student' && hasStudentRole) effectivePortal = 'student';
    else if (hasStudentRole) effectivePortal = 'student';
    else if (hasParentRole) effectivePortal = 'parent';
    const usesPortalNavShell = effectivePortal !== null;
    const backHref = effectivePortal ? `/events?view=calendar&portal=${effectivePortal}` : '/events';
  %>
  <% if (effectivePortal === 'student') { %>
    <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>
  <% } else if (effectivePortal === 'parent') { %>
    <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>
  <% } else { %>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>
  <% } %>

  <main id="main-content" tabindex="-1"<% if (usesPortalNavShell) { %> class="admin-main"<% } %>>
    <section class="site-section">
      <div class="site-section-inner">
        <p><a href="<%= backHref %>">&larr; All Events</a></p>

        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

        <% if (event.imageUrl) { %>
          <img src="<%= event.imageUrl %>" alt="" style="width: 100%; max-height: 320px; object-fit: cover; border-radius: var(--radius); margin-bottom: 1.25rem;" />
        <% } %>

        <div class="grid-box-header">
          <h1><%= event.title %></h1>
          <%
            // A real request: "If a member is added as an organizer for
            // an event, on parent portal when they click on the event it
            // will show an edit event button at the top to allow them to
            // change details." Straight to the same Main Admin builder
            // page an admin uses - routes/admin-events.js's own
            // requireMainAdminOrEventOrganizer lets an organizer-parent
            // in there too, with Finance frozen and no Cancel/Delete/
            // Publish (its own comment covers the full scope).
          %>
          <% if (typeof isOrganizer !== 'undefined' && isOrganizer) { %>
            <a class="primary-btn" href="/main-admin/events/<%= event.id %>/builder">Edit Event</a>
          <% } %>
        </div>
        <% if (event.categoryName) { %><span class="badge-pill" style="background: <%= event.categoryColor %>; color: #fff;"><%= event.categoryName %></span><% } %>
        <%
          // A real request: "if the event starts and ends the same day we
          // only need to see one date. Time should be stacked under date
          // with a clock icon. Location should be stacked under time. All
          // three spaced nicely and not overlapping."
          var dateLine = sameDay || !endsDateLabel ? startsDateLabel : `${startsDateLabel} – ${endsDateLabel}`;
          var timeLine = endsTimeLabel ? `${startsTimeLabel} – ${endsTimeLabel}` : startsTimeLabel;
        %>
        <div class="event-hero-meta-stack">
          <p class="site-hero-meta"><svg class="icon"><use href="#icon-calendar-check"/></svg> <%= dateLine %></p>
          <p class="site-hero-meta"><svg class="icon"><use href="#icon-clock"/></svg> <%= timeLine %></p>
          <% if (event.location) { %><p class="site-hero-meta"><svg class="icon"><use href="#icon-map-pin"/></svg> <%= event.location %></p><% } %>
          <% if (priceLabel) { %><p class="site-hero-meta"><svg class="icon"><use href="#icon-tag"/></svg> <%= priceLabel %></p><% } %>
          <%
            // A real request: "Organized by should be a drop down to
            // choose Sanford Homeschoolers or a parent name. Can select
            // multiple. Will show on parent portal who Organized the
            // event and their email address." A null memberId row is the
            // fixed "Sanford Homeschoolers" option - see utils/events.js's
            // own organizersForEvent/event_organizers migration.
            var organizerLines = (typeof organizers !== 'undefined' ? organizers : []).map(function(o) {
              return o.memberId ? (o.name + (o.email ? ' (' + o.email + ')' : '')) : 'Sanford Homeschoolers';
            });
          %>
          <% if (organizerLines.length) { %>
            <p class="site-hero-meta"><svg class="icon"><use href="#icon-user"/></svg> Organized by <%= organizerLines.join(', ') %></p>
          <% } %>
        </div>
        <%
          // A real request: "Event details should also be card style like
          // the other text information for events" - later refined to
          // "instead of card for all those event viewing sections make
          // the details and activities, extra notes, parking etc all on
          // one card. Bold font for each section title. Registration card
          // below it." One shared .manage-section card holds Details plus
          // every included optional info section, each its own bold
          // title instead of a separate card per section.
          var infoSections = [
            { label: 'Activity Information', text: event.activity_info, included: event.include_activity_info },
            { label: 'Meetup and Parking Information', text: event.meetup_parking_info, included: event.include_meetup_parking_info },
            { label: 'What to Bring', text: event.what_to_bring, included: event.include_what_to_bring },
            { label: 'Extra Notes', text: event.extra_notes, included: event.include_extra_notes },
          ];
          var visibleInfoSections = infoSections.filter(function(section) { return section.included && section.text; });
        %>
        <% if (event.description || visibleInfoSections.length) { %>
          <div class="manage-section event-details-card">
            <% if (event.description) { %>
              <h3>Details</h3>
              <div class="forum-editable-display"><%- event.description %></div>
            <% } %>
            <% visibleInfoSections.forEach(function(section) { %>
              <h3><%= section.label %></h3>
              <%# A real request: "Activity information, meet-up and
                  parking, what to bring and notes should match font and
                  size of the details section." Reusing the exact same
                  .forum-editable-display class as the Details description
                  above (instead of a bare <p>) guarantees identical
                  typography - same selector, not two parallel rules that
                  could drift apart later. %>
              <div class="forum-editable-display" style="white-space: pre-wrap;"><%= section.text %></div>
            <% }); %>
          </div>
        <% } %>

        <% if (!portalAccount) { %>
          <p class="hint"><a href="/login?next=<%= encodeURIComponent('/events/' + event.id) %>">Log in</a> to register, volunteer, or claim a donation item.</p>
        <% } else { %>

          <div class="manage-section event-register-card">
            <div class="grid-box-header"><h2>Register</h2></div>
            <% if (event.capacity != null) { %><p class="hint"><%= event.registrationCount %>/<%= event.capacity %> registered<% if (event.waitlistCount) { %> &middot; <%= event.waitlistCount %> waitlisted<% } %></p><% } %>
            <% if (event.family_capacity != null) { %><p class="hint"><%= event.familyCount %>/<%= event.family_capacity %> families registered</p><% } %>
            <% if (event.payment_instructions_title || event.payment_instructions_text) { %>
              <div class="alert alert-info">
                <% if (event.payment_instructions_title) { %><strong><%= event.payment_instructions_title %></strong><% } %>
                <% if (event.payment_instructions_text) { %><p style="margin: 0.35rem 0 0;"><%= event.payment_instructions_text %></p><% } %>
              </div>
            <% } %>
            <% if (!isRegistrationWindowOpen) { %>
              <p class="hint">
                <% if (event.registration_opens_at) { %>Registration opens <%= event.registration_opens_at %>.<% } %>
                <% if (event.registration_closes_at) { %> Registration closed <%= event.registration_closes_at %>.<% } %>
              </p>
            <% } else {
              // A real request: "when you click register next to a
              // member the page will not refresh. The button will turn
              // white and say registered, unless there is a popup for
              // tickets [or extra fields]. Then that would happen first
              // then it would say registered. Add check boxes next to
              // each member to be able to register multiple family
              // members at once [and] select the button register
              // selected." One shared row list (name + a small Register
              // button, same "clean column, grays out ineligible
              // members" look the plain case always had) handles both
              // cases now - needsDialog just decides whether clicking
              // Register fires the AJAX call straight away or opens
              // event-register-dialog first to collect the ticket/extra-
              // field answers registerForEvent needs. Checkboxes + a
              // bulk "Register Selected" button only make sense when
              // there's nothing per-member to ask first, so they're
              // scoped to the no-ticket/no-extra-field case.
              // A real request: "if these items are selected when editing
              // the event with options added. Then member should be
              // asked when clicking register along with the extra fields
              // questions" - Volunteer/Donations/Food each now also
              // trigger the dialog whenever the section is on and has at
              // least one real option, same as tickets/extra fields.
              var needsDialog = (event.ticketTypes && event.ticketTypes.length > 0) || (event.extraFields && event.extraFields.length > 0) ||
                (event.volunteers_enabled && event.volunteerRoles && event.volunteerRoles.length > 0) ||
                (event.donations_enabled && event.donationItems && event.donationItems.length > 0) ||
                (event.food_enabled && event.foodItems && event.foodItems.length > 0);
              // A real request: "register selected, [but] if all members
              // from that family are selected [and already registered],
              // will say unregister selected" - the bulk button now
              // covers BOTH directions (public/js/events-detail-register.js
              // flips its own label/action based on what's checked), so it
              // needs to show whenever there's more than one member to act
              // on at all, not just when there's more than one still
              // unregistered.
              var eligibleCount = family.filter(function(m) { return eligibleForRegistration.has(m.id); }).length;
            %>
              <% if (!needsDialog && eligibleCount > 1) { %>
                <div class="roster-btn-row" style="margin-bottom: 0.75rem;">
                  <button type="button" id="event-register-selected-btn" class="roster-action-btn" disabled>Register Selected</button>
                </div>
              <% } %>
              <div class="event-register-member-list" id="event-register-member-list" data-event-id="<%= event.id %>" data-needs-dialog="<%= needsDialog ? '1' : '0' %>">
                <% family.forEach(function(m) {
                  var isRegistered = registeredMemberIds.indexOf(m.id) !== -1;
                  var isEligible = eligibleForRegistration.has(m.id);
                %>
                  <div class="event-register-member-row<%= isEligible ? '' : ' event-register-member-row-ineligible' %>" data-member-id="<%= m.id %>" data-member-name="<%= m.name %>" data-registered="<%= isRegistered ? '1' : '0' %>">
                    <span class="event-register-member-info">
                      <%# A real request: a registered member also gets a
                          checkbox now (not just an unregistered one), so
                          they can be picked up by the same bulk button for
                          a bulk "Unregister Selected". %>
                      <% if (!needsDialog && isEligible) { %>
                        <input type="checkbox" class="event-register-member-checkbox" value="<%= m.id %>" />
                      <% } %>
                      <span class="event-register-member-name"><%= m.name %></span>
                    </span>
                    <span class="event-register-member-actions">
                      <% if (isRegistered) { %>
                        <button type="button" class="roster-action-btn roster-action-btn-small roster-action-btn-registered js-event-unregister-btn">Unregister</button>
                      <% } else if (isEligible) { %>
                        <button type="button" class="roster-action-btn roster-action-btn-small js-event-register-btn">Register</button>
                      <% } else { %>
                        <span class="hint">Not eligible</span>
                      <% } %>
                    </span>
                  </div>
                <% }); %>
              </div>
              <% if (needsDialog) { %>
                <%
                  // A real request: "after asking about signups, food,
                  // etc. you are taken to a ticket view and selection
                  // screen. After selecting the ticket you want you click
                  // submit and you are taken to a payment screen. We stop
                  // there because there is no processor for payment yet.
                  // For now it creates an invoice and registration is
                  // completed." The old single-screen dialog (extra
                  // fields/volunteer/donation/food + a plain ticket
                  // dropdown, one Register button) is now a sequence of
                  // .register-dialog-step panels inside the same dialog/
                  // form (events-detail-register.js just shows/hides them
                  // and validates whichever one is currently visible on
                  // Next) - a details step (extra fields + volunteer/
                  // donation/food, when any exist), then a ticket step
                  // (when the event has ticket types), then a payment
                  // step (when there's anything to charge at all - either
                  // ticket types or the event's own flat price_cents).
                  // Whichever of these actually renders is always the
                  // final step whose submit button really posts the form -
                  // registerForEvent's existing charge logic (utils/
                  // events.js's own chargeForConfirmedRegistration) is
                  // already the "invoice" this creates, so nothing new was
                  // needed server-side for that part.
                  var dialogHasDetails = !!((event.extraFields && event.extraFields.length) ||
                    (event.volunteers_enabled && event.volunteerRoles && event.volunteerRoles.length) ||
                    (event.donations_enabled && event.donationItems && event.donationItems.length) ||
                    (event.food_enabled && event.foodItems && event.foodItems.length));
                  var dialogHasTicket = !!(event.ticketTypes && event.ticketTypes.length);
                  var dialogHasPayment = dialogHasTicket || event.price_cents != null;
                %>
                <dialog id="event-register-dialog" class="notes-dialog event-register-dialog">
                  <form id="event-register-dialog-form" method="POST" action="/events/<%= event.id %>/register" class="member-form-grid">
                    <h3 class="member-form-full">Register <span id="event-register-dialog-member-name"></span></h3>
                    <input type="hidden" name="memberId" id="event-register-dialog-member-id" />
                    <p class="alert alert-error member-form-full" id="event-register-dialog-error" hidden></p>

                    <% if (dialogHasDetails) { %>
                      <div class="register-dialog-step" data-step="details">
                        <%# A real request: "extra fields is where you can
                            add extra form type questions for people
                            signing up for an event" - answers[] here comes
                            from that per-event event_extra_fields list,
                            named answers[f<fieldId>] - the "f" prefix
                            keeps qs's body parser from reading a purely-
                            numeric bracket key as an ARRAY index instead
                            of an object key. %>
                        <% (event.extraFields || []).forEach(function(field) { %>
                          <label class="member-form-full"><%= field.label %><% if (field.required) { %> *<% } %>
                            <% if (field.field_type === 'textarea') { %>
                              <textarea name="answers[f<%= field.id %>]" rows="2" <%= field.required ? 'required' : '' %>></textarea>
                            <% } else if (field.field_type === 'select') { %>
                              <select name="answers[f<%= field.id %>]" <%= field.required ? 'required' : '' %>>
                                <option value="">Select one</option>
                                <% (field.options || '').split('\n').filter(Boolean).forEach(function(opt) { %>
                                  <option value="<%= opt %>"><%= opt %></option>
                                <% }); %>
                              </select>
                            <% } else if (field.field_type === 'checkbox') { %>
                              <input type="checkbox" name="answers[f<%= field.id %>]" value="Yes" <%= field.required ? 'required' : '' %> />
                            <% } else { %>
                              <input type="text" name="answers[f<%= field.id %>]" <%= field.required ? 'required' : '' %> />
                            <% } %>
                          </label>
                        <% }); %>
                        <%# A real request: "if these items are selected
                            when editing the event with options added.
                            Then member should be asked when clicking
                            register along with the extra fields
                            questions." Only still-open roles/items are
                            offered - one already full/fully claimed has
                            nothing left to pick. %>
                        <% if (event.volunteers_enabled && event.volunteerRoles.length) { %>
                          <div class="member-form-full">
                            <span class="class-form-field-label">Volunteer<% if (event.volunteer_selection_count) { %> (select at least <%= event.volunteer_selection_count %>)<% } %></span>
                            <% event.volunteerRoles.filter(function(role) { return role.filled < role.slots_needed; }).forEach(function(role) { %>
                              <label class="checkbox-option"><input type="checkbox" name="volunteerRoleIds" value="<%= role.id %>" /> <%= role.role_name %></label>
                            <% }); %>
                          </div>
                        <% } %>
                        <% if (event.donations_enabled && event.donationItems.length) { %>
                          <div class="member-form-full">
                            <span class="class-form-field-label">Donations Needed<% if (event.donation_selection_count) { %> (select at least <%= event.donation_selection_count %>)<% } %></span>
                            <% event.donationItems.filter(function(item) { return item.quantity_needed - item.quantityClaimed > 0; }).forEach(function(item) { %>
                              <label class="checkbox-option"><input type="checkbox" name="donationItemIds" value="<%= item.id %>" /> <%= item.item_name %></label>
                            <% }); %>
                          </div>
                        <% } %>
                        <% if (event.food_enabled && event.foodItems.length) { %>
                          <div class="member-form-full">
                            <span class="class-form-field-label">Food Sign-Up<% if (event.food_selection_count) { %> (select at least <%= event.food_selection_count %>)<% } %></span>
                            <% event.foodItems.filter(function(item) { return item.quantity_needed - item.quantityClaimed > 0; }).forEach(function(item) { %>
                              <label class="checkbox-option"><input type="checkbox" name="foodItemIds" value="<%= item.id %>" /> <%= item.item_name %></label>
                            <% }); %>
                          </div>
                        <% } %>
                        <div class="notes-dialog-actions member-form-full">
                          <button type="button" class="btn-secondary" id="event-register-dialog-cancel">Cancel</button>
                          <% if (dialogHasPayment) { %>
                            <button type="button" class="primary-btn js-dialog-next">Next</button>
                          <% } else { %>
                            <button type="submit" class="primary-btn">Register</button>
                          <% } %>
                        </div>
                      </div>
                    <% } %>

                    <% if (dialogHasTicket) { %>
                      <%# "You are taken to a ticket view and selection
                          screen" - a real step of its own now, radio cards
                          instead of the old plain <select>, so the chosen
                          ticket's price can also drive the Payment step's
                          summary text just below. %>
                      <div class="register-dialog-step" data-step="ticket" <%= dialogHasDetails ? 'hidden' : '' %>>
                        <h3 class="member-form-full">Select Your Ticket</h3>
                        <div class="member-form-full ticket-select-list">
                          <% event.ticketTypes.forEach(function(t, i) { %>
                            <label class="ticket-select-option">
                              <input type="radio" name="ticketTypeId" value="<%= t.id %>" data-price-label="<%= t.title %> &ndash; $<%= (t.price_cents / 100).toFixed(2) %> / <%= t.price_per %>" <%= i === 0 ? 'checked' : '' %> required />
                              <span class="ticket-select-info">
                                <strong><%= t.title %></strong>
                                <span class="hint">$<%= (t.price_cents / 100).toFixed(2) %> / <%= t.price_per %></span>
                              </span>
                            </label>
                          <% }); %>
                        </div>
                        <div class="notes-dialog-actions member-form-full">
                          <% if (dialogHasDetails) { %>
                            <button type="button" class="btn-secondary js-dialog-back">Back</button>
                          <% } else { %>
                            <button type="button" class="btn-secondary" id="event-register-dialog-cancel">Cancel</button>
                          <% } %>
                          <button type="button" class="primary-btn js-dialog-next">Next</button>
                        </div>
                      </div>
                    <% } %>

                    <% if (dialogHasPayment) { %>
                      <%# "Click submit and you are taken to a payment
                          screen. We stop there because there is no
                          processor for payment yet. For now it creates an
                          invoice and registration is completed." This
                          step is always last - its submit really posts
                          the form (events-detail-register.js's existing
                          submit handler), which is what actually runs
                          registerForEvent and its charge/"invoice". %>
                      <div class="register-dialog-step" data-step="payment" hidden>
                        <h3 class="member-form-full">Payment</h3>
                        <p class="member-form-full" id="event-register-payment-summary">
                          <% if (!dialogHasTicket) { %>$<%= (event.price_cents / 100).toFixed(2) %> / <%= event.price_per %><% } %>
                        </p>
                        <p class="hint member-form-full">Online payment isn't set up yet. Clicking Complete Registration below will finish your registration and create an invoice for this amount &ndash; we'll follow up separately on how to pay it.</p>
                        <div class="notes-dialog-actions member-form-full">
                          <button type="button" class="btn-secondary js-dialog-back">Back</button>
                          <button type="submit" class="primary-btn">Complete Registration</button>
                        </div>
                      </div>
                    <% } %>
                  </form>
                </dialog>

                <%# "Message that says thank you for registering for the
                    event!" - shown once the dialog's own AJAX submit
                    succeeds (events-detail-register.js), in place of just
                    silently closing the dialog. %>
                <dialog id="event-register-thankyou-dialog" class="notes-dialog">
                  <h3>Thank You!</h3>
                  <p>Thank you for registering for <strong><%= event.title %></strong>!</p>
                  <% if (dialogHasPayment) { %>
                    <p class="hint">An invoice has been created for your registration &ndash; we'll follow up separately on how to pay it.</p>
                  <% } %>
                  <div class="notes-dialog-actions">
                    <button type="button" class="primary-btn" onclick="this.closest('dialog').close()">Close</button>
                  </div>
                </dialog>
              <% } %>
            <% } %>

            <%# A real request: "if it allows for showing who has
                registered that will be listed below the register button" -
                show_registrants_to_members is the existing builder
                checkbox (views/admin-events-builder.ejs) that used to be
                stored but never actually read anywhere; registrants (from
                routes/events.js's own GET /:id) is only ever populated
                when it's on. %>
            <% if (event.show_registrants_to_members && registrants && registrants.length) { %>
              <div class="manage-section" style="margin-top: 1rem;">
                <h3>Who's Registered</h3>
                <ul class="portal-dashboard-list">
                  <% registrants.forEach(function(r) { %>
                    <li><%= r.memberName %><% if (r.status === 'waitlisted') { %> <span class="hint">(waitlisted)</span><% } %></li>
                  <% }); %>
                </ul>
              </div>
            <% } %>

            <%# A real request: "guest check in shouldn't be [on the Main
                Admin Attendance page]. that should be under settings for
                each individual event only. to allow guest to signup, then
                they will appear on the event roster." allow_guest_register
                is that same existing per-event "Guests can register"
                checkbox (views/admin-events-builder.ejs) - this is its
                only actual signup path now that the admin-side manual add
                is gone. Applies regardless of whether the event has Extra
                Fields, so it lives outside that if/else rather than nested
                in one branch of it. %>
            <% if (isRegistrationWindowOpen && event.allow_guest_register) { %>
              <div class="manage-section" style="margin-top: 1rem;">
                <h3>Bringing a Guest?</h3>
                <% if (myGuestRegistrations.length) { %>
                  <div class="roster-btn-row">
                    <% myGuestRegistrations.forEach(function(g) { %>
                      <form method="POST" action="/events/<%= event.id %>/unregister-guest" class="inline-block-form">
                        <input type="hidden" name="guestId" value="<%= g.id %>" />
                        <button type="submit" class="roster-action-btn roster-action-btn-danger"><%= g.guest_name %>: Cancel</button>
                      </form>
                    <% }); %>
                  </div>
                <% } %>
                <form method="POST" action="/events/<%= event.id %>/register-guest" class="member-form-grid">
                  <label>Guest Name
                    <input type="text" name="guestName" required />
                  </label>
                  <label>Email <span class="hint">(optional)</span>
                    <input type="email" name="guestEmail" />
                  </label>
                  <label>Phone <span class="hint">(optional)</span>
                    <input type="text" name="guestPhone" />
                  </label>
                  <div class="member-form-full">
                    <button type="submit" class="roster-action-btn">+ Register a Guest</button>
                  </div>
                </form>
              </div>
            <% } %>
          </div>

          <%
            // A real request: "after registering there will be a card
            // below the registration card that says my registration...
            // listing everyone signed up by this family in a single
            // organized column, no register buttons next to members
            // there. Then list volunteer positions signed up for,
            // donations signed up for and food signed up for. Then a
            // button that says edit registration." Only shown once the
            // family actually has at least one active registration.
          %>
          <% if (myRegistrations.length) { %>
            <div class="manage-section event-my-registration-card">
              <div class="grid-box-header">
                <h2>My Registration</h2>
                <button type="button" class="roster-action-btn roster-action-btn-fit" onclick="document.getElementById('edit-registration-dialog').showModal()">Edit Registration</button>
              </div>
              <div class="event-my-registration-column">
                <% myRegistrations.forEach(function(r) {
                  var m = family.find(function(fm) { return fm.id === r.member_id; });
                %>
                  <p class="event-my-registration-row"><%= m ? m.name : 'Member' %><% if (r.status === 'waitlisted') { %> <span class="hint">(waitlisted)</span><% } %></p>
                <% }); %>
              </div>
              <% if (myVolunteerSignups.length) { %>
                <h3>Volunteer Positions Signed Up For</h3>
                <ul class="portal-dashboard-list">
                  <% myVolunteerSignups.forEach(function(s) {
                    var m = family.find(function(fm) { return fm.id === s.member_id; });
                  %>
                    <li><%= s.roleName %> &mdash; <%= m ? m.name : 'Member' %></li>
                  <% }); %>
                </ul>
              <% } %>
              <% if (myDonationClaims.length) { %>
                <h3>Donations Signed Up For</h3>
                <ul class="portal-dashboard-list">
                  <% myDonationClaims.forEach(function(c) {
                    var m = family.find(function(fm) { return fm.id === c.member_id; });
                  %>
                    <li><%= c.itemName %><% if (c.quantity_claimed > 1) { %> (<%= c.quantity_claimed %>)<% } %> &mdash; <%= m ? m.name : 'Member' %></li>
                  <% }); %>
                </ul>
              <% } %>
              <% if (myFoodClaims.length) { %>
                <h3>Food Signed Up For</h3>
                <ul class="portal-dashboard-list">
                  <% myFoodClaims.forEach(function(c) {
                    var m = family.find(function(fm) { return fm.id === c.member_id; });
                  %>
                    <li><%= c.itemName %><% if (c.quantity_claimed > 1) { %> (<%= c.quantity_claimed %>)<% } %> &mdash; <%= m ? m.name : 'Member' %></li>
                  <% }); %>
                </ul>
              <% } %>
            </div>

            <%# A real request: "click and see a popup that allows you to
                view what's left on those lists, unassigned what they
                signed up for and register for something else" - reuses
                the exact same Volunteer/Donations/Food section partials
                rendered below (same remaining counts, same Sign Up/
                Cancel toggle), just inside a dialog. %>
            <dialog id="edit-registration-dialog" class="member-picker-dialog event-registration-edit-dialog">
              <h3>Edit Registration</h3>
              <%- include('partials/event-volunteer-section', { event: event, family: family, volunteeredKey: volunteeredKey }) %>
              <%- include('partials/event-donation-section', { event: event, family: family }) %>
              <%- include('partials/event-food-section', { event: event, family: family }) %>
              <div class="notes-dialog-actions">
                <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
              </div>
            </dialog>
          <% } %>

          <%- include('partials/event-volunteer-section', { event: event, family: family, volunteeredKey: volunteeredKey }) %>
          <%- include('partials/event-donation-section', { event: event, family: family }) %>
          <%- include('partials/event-food-section', { event: event, family: family }) %>

          <%# A real request: "be able to attach these lists to events" -
              Main Admin's own Sign-Up Lists/Volunteer Lists (routes/
              main-admin-volunteers.js), shown here exactly like the
              Donations/Food sections above once attached to this event. %>
          <% attachedSignUpLists.forEach(function(list) { %>
            <div class="manage-section">
              <div class="grid-box-header"><h2><%= list.title %><% if (!list.is_open) { %> <span class="badge-pill badge-pill-gray">Closed</span><% } %></h2></div>
              <% if (list.description) { %><p class="hint"><%= list.description %></p><% } %>
              <div class="training-lesson-list">
                <% list.items.forEach(function(item) { %>
                  <% var remaining = item.quantity_needed - item.quantityClaimed; %>
                  <div class="training-lesson-row">
                    <div class="training-lesson-row-main">
                      <svg class="icon"><use href="#icon-badge"/></svg>
                      <div class="training-lesson-info">
                        <strong><%= item.item_name %></strong>
                        <span class="hint"><%= remaining %> still needed<% if (item.notes) { %> &middot; <%= item.notes %><% } %></span>
                      </div>
                      <% if (list.is_open && remaining > 0) { %>
                        <form method="POST" action="/events/<%= event.id %>/signup-list-items/<%= item.id %>/claim" class="training-lesson-actions">
                          <select name="memberId">
                            <% family.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
                          </select>
                          <input type="number" name="quantity" min="1" value="1" max="<%= remaining %>" style="width: 4rem;" />
                          <button type="submit" class="roster-action-btn">Sign Up</button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>

          <% attachedVolunteerLists.forEach(function(list) { %>
            <div class="manage-section">
              <div class="grid-box-header"><h2><%= list.title %><% if (!list.is_open) { %> <span class="badge-pill badge-pill-gray">Closed</span><% } %></h2></div>
              <% if (list.description) { %><p class="hint"><%= list.description %></p><% } %>
              <div class="training-lesson-list">
                <% list.shifts.forEach(function(shift) { %>
                  <% var mySignups = shift.signups.filter(function(s) { return familyIds.indexOf(s.member_id) !== -1; }); %>
                  <div class="training-lesson-row">
                    <div class="training-lesson-row-main">
                      <svg class="icon"><use href="#icon-badge"/></svg>
                      <div class="training-lesson-info">
                        <strong><%= shift.job_name %></strong>
                        <span class="hint">
                          <% if (shift.shift_date) { %><%= shift.shift_date %><% } %>
                          <% if (shift.start_time || shift.end_time) { %> <%= shift.start_time || '' %><% if (shift.end_time) { %> - <%= shift.end_time %><% } %><% } %>
                          &middot; <%= shift.signups.length %>/<%= shift.slots_needed %> filled
                        </span>
                      </div>
                      <div class="training-lesson-actions">
                        <% family.forEach(function(m) { %>
                          <% if (mySignups.some(function(s) { return s.member_id === m.id; })) { %>
                            <form method="POST" action="/events/<%= event.id %>/volunteer-list-shifts/<%= shift.id %>/cancel" class="inline-block-form">
                              <input type="hidden" name="memberId" value="<%= m.id %>" />
                              <button type="submit" class="roster-action-btn roster-action-btn-danger"><%= m.name %>: Cancel</button>
                            </form>
                          <% } else if (list.is_open && shift.signups.length < shift.slots_needed) { %>
                            <form method="POST" action="/events/<%= event.id %>/volunteer-list-shifts/<%= shift.id %>/signup" class="inline-block-form">
                              <input type="hidden" name="memberId" value="<%= m.id %>" />
                              <button type="submit" class="roster-action-btn"><%= m.name %>: Sign Up</button>
                            </form>
                          <% } %>
                        <% }); %>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </section>
  </main>
  <script src="/js/events-preserve-portal.js"></script>
  <script src="/js/events-detail-register.js"></script>
</body>
</html>
