<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <p class="subtitle"><a href="/admin/rosters">&larr; All Rosters</a></p>

    <div class="manage-header-row">
      <form method="POST" action="/admin/rosters/<%= roster.id %>/rename" class="edit-name-form manage-title-form">
        <input type="text" name="name" value="<%= roster.name %>" class="manage-title-input" required />
        <button type="submit" class="link-btn">Save</button>
      </form>
      <form method="POST" action="/admin/rosters/<%= roster.id %>/category" class="inline-block-form">
        <select name="category" onchange="this.form.submit()">
          <option value="">No category</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c %>" <%= roster.category === c ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
      </form>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="manage-section">
      <h2>Session Dates (<%= dates.length %>)</h2>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <tbody>
            <% if (dates.length === 0) { %>
              <tr><td class="roster-empty">No dates yet.</td></tr>
            <% } %>
            <% dates.forEach(function(d) { %>
              <tr>
                <td><%= d.label %></td>
                <td class="actions-cell">
                  <form method="POST" action="/admin/rosters/<%= roster.id %>/dates/<%= d.date %>/remove" class="inline-block-form" onsubmit="return confirm('Remove <%= d.label %>? Any attendance recorded for this date on this roster will be deleted too.');">
                    <button type="submit" class="link-btn link-btn-danger">Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <form method="POST" action="/admin/rosters/<%= roster.id %>/dates/add" class="date-add-form">
        <div class="date-list-wrap">
          <div class="date-list">
            <div class="date-list-row">
              <input type="date" name="dates" />
              <button type="button" class="date-list-remove" aria-label="Remove date">&times;</button>
            </div>
          </div>
          <button type="button" class="btn-secondary date-list-add">+ Add another date</button>
        </div>
        <button type="submit" class="btn-secondary">Add Dates</button>
      </form>
    </div>

    <div class="manage-section">
      <h2>Members (<%= members.length %>)</h2>
      <div class="quick-add-row">
        <form method="POST" action="/admin/rosters/<%= roster.id %>/import" enctype="multipart/form-data" class="inline-form-flat">
          <input type="file" name="file" accept=".csv,.txt" required />
          <button type="submit" class="btn-secondary">Import from File</button>
        </form>
        <form method="POST" action="/admin/rosters/<%= roster.id %>/add-member" class="inline-form-flat">
          <select name="memberId" required>
            <option value="">Add existing member&hellip;</option>
            <% availableMembers.forEach(function(m) { %>
              <option value="<%= m.id %>"><%= m.name %></option>
            <% }); %>
          </select>
          <button type="submit" class="btn-secondary">Add</button>
        </form>
      </div>

      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr><th>Name</th><th>Barcode</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% if (members.length === 0) { %>
              <tr><td colspan="3" class="roster-empty">No members yet.</td></tr>
            <% } %>
            <% members.forEach(function(m) { %>
              <tr>
                <td><%= m.name %></td>
                <td class="mono"><%= m.barcode %></td>
                <td class="actions-cell">
                  <form method="POST" action="/admin/rosters/<%= roster.id %>/remove-member/<%= m.id %>" class="inline-block-form">
                    <button type="submit" class="link-btn">Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
  <script src="/js/date-list.js"></script>
</body>
</html>
