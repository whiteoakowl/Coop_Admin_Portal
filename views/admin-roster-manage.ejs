<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <p class="subtitle"><a href="/admin/rosters">&larr; All Rosters</a></p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="manage-header-row edit-section">
      <form method="POST" action="/admin/rosters/<%= roster.id %>/settings" class="manage-header-form">
        <input type="text" name="name" value="<%= roster.name %>" class="manage-title-input" required disabled />
        <select name="category" disabled>
          <option value="">Category: (Wednesday or Monday)</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c %>" <%= roster.category === c ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
        <select name="scheduleDay" title="Which day's class schedule to base Arrival/Departure times on" disabled>
          <option value="" <%= !roster.schedule_day ? 'selected' : '' %>>Arrival/Departure: Both days</option>
          <option value="monday" <%= roster.schedule_day === 'monday' ? 'selected' : '' %>>Arrival/Departure: Monday schedule</option>
          <option value="wednesday" <%= roster.schedule_day === 'wednesday' ? 'selected' : '' %>>Arrival/Departure: Wednesday schedule</option>
        </select>
        <button type="button" class="primary-btn" data-edit-toggle-edit>Edit</button>
        <button type="button" class="btn-secondary" data-edit-toggle-cancel hidden>Cancel</button>
        <button type="submit" class="primary-btn" data-edit-toggle-save hidden>Save Changes</button>
      </form>
    </div>

    <div class="manage-section">
      <h2>Session Dates (<%= dates.length %>)</h2>
      <div class="quick-add-row">
        <button type="button" class="primary-btn" onclick="document.getElementById('edit-dates-dialog').showModal()">Edit Session Dates</button>
      </div>

      <dialog id="edit-dates-dialog" class="member-picker-dialog">
        <h3>Session Dates</h3>
        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table">
            <tbody>
              <% if (dates.length === 0) { %>
                <tr><td class="roster-empty">No dates yet.</td></tr>
              <% } %>
              <% dates.forEach(function(d) { %>
                <tr>
                  <td><%= d.label %></td>
                  <td class="actions-cell">
                    <form method="POST" action="/admin/rosters/<%= roster.id %>/dates/<%= d.date %>/remove" class="inline-block-form" onsubmit="return confirm('Remove <%= d.label %>? Any attendance recorded for this date on this roster will be deleted too.');">
                      <button type="submit" class="link-btn link-btn-danger">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <form method="POST" action="/admin/rosters/<%= roster.id %>/dates/add">
          <div class="date-list-wrap">
            <label class="roster-checkbox-label">Add Dates</label>
            <div class="date-list">
              <div class="date-list-row">
                <input type="date" name="dates" />
                <button type="button" class="date-list-remove" aria-label="Remove date">&times;</button>
              </div>
            </div>
            <button type="button" class="btn-secondary date-list-add">+ Add another date</button>
          </div>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
            <button type="submit" class="primary-btn">Save</button>
          </div>
        </form>
      </dialog>
    </div>

    <div class="manage-section">
      <h2>Members (<%= members.length %>)</h2>
      <div class="quick-add-row">
        <button type="button" class="btn-secondary" onclick="document.getElementById('add-member-dialog').showModal()">+ Add Member</button>
        <button type="button" class="btn-secondary file-action-btn" onclick="document.getElementById('import-dialog').showModal()">Import</button>
      </div>

      <dialog id="add-member-dialog" class="member-picker-dialog">
        <form method="POST" action="/admin/rosters/<%= roster.id %>/add-member">
          <h3>Add Members</h3>
          <% if (availableMembers.length === 0) { %>
            <p class="hint">Everyone in Members is already on this roster. Add new members on the <a href="/admin/members">Members page</a>.</p>
          <% } else { %>
            <div class="member-picker-list">
              <% availableMembers.forEach(function(m) { %>
                <label class="member-picker-row">
                  <input type="checkbox" name="memberIds" value="<%= m.id %>" />
                  <span><%= m.name %></span>
                </label>
              <% }); %>
            </div>
          <% } %>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <% if (availableMembers.length > 0) { %>
              <button type="submit" class="primary-btn">Add Selected</button>
            <% } %>
          </div>
        </form>
      </dialog>

      <dialog id="import-dialog" class="member-picker-dialog">
        <form method="POST" action="/admin/rosters/<%= roster.id %>/import" enctype="multipart/form-data">
          <h3>Import</h3>
          <p class="hint">Only names already in <a href="/admin/members">Members</a> will be added. New people must be added there first.</p>
          <a class="btn-secondary import-sample-link" href="/admin/import-template/names.xlsx">Download Sample File</a>
          <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Import</button>
          </div>
        </form>
      </dialog>

      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr><th>Name</th><th>Type</th><th>Grade</th><th>Age</th><th>Birthday</th><th>Email</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% if (members.length === 0) { %>
              <tr><td colspan="7" class="roster-empty">No members yet.</td></tr>
            <% } %>
            <% members.forEach(function(m) { %>
              <tr>
                <td><%= m.name %></td>
                <td><span class="badge-pill"><%= m.member_type === 'parent' ? 'Parent' : m.member_type === 'admin' ? 'Admin' : 'Student' %></span></td>
                <td><%= m.grade_level || '—' %></td>
                <td><%= m.age != null ? m.age : '—' %></td>
                <td><%= m.birthday || '—' %></td>
                <td><%= m.email || '—' %></td>
                <td class="actions-cell">
                  <form method="POST" action="/admin/rosters/<%= roster.id %>/remove-member/<%= m.id %>" class="inline-block-form">
                    <button type="submit" class="icon-btn" aria-label="Remove <%= m.name %>" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
  <script src="/js/date-list.js"></script>
  <script src="/js/edit-toggle.js"></script>
</body>
</html>
