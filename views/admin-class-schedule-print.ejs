<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter landscape; margin: 0.4in; }</style>
</head>
<body class="admin-page class-schedule-print-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= dayLabel %> Class Schedule</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub"><%= dayLabel %> Class Schedule</p>
        </div>
      </div>

      <div class="class-schedule-print-grid">
        <% grid.forEach(function(hour) { %>
          <div class="class-schedule-print-hour">
            <h2><%= hour.label %></h2>
            <% if (hour.classes.length === 0) { %>
              <p class="class-schedule-print-empty">No classes</p>
            <% } else { %>
              <% hour.classes.forEach(function(cls) { %>
                <div class="class-schedule-print-card" style="border-left-color: <%= cls.color %>; background: color-mix(in srgb, <%= cls.color %> 12%, white);">
                  <h3><%= cls.class_name %></h3>
                  <p class="class-card-meta">
                    <% if (cls.room) { %><span>Room <%= cls.room %></span><% } %>
                    <% if (cls.age_group) { %><span><%= cls.age_group %></span><% } %>
                    <span><%= cls.students.length %> student<%= cls.students.length === 1 ? '' : 's' %></span>
                  </p>
                  <% if (cls.staff.length > 0) { %>
                    <p class="class-schedule-print-staff">
                      <%= cls.staff.map(function(s) { return s.name + (s.role === 'assistant' ? ' (A)' : ''); }).join(', ') %>
                    </p>
                  <% } %>
                </div>
              <% }); %>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </main>
</body>
</html>
