<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.4in; }</style>
</head>
<body class="admin-page class-schedule-print-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= dayLabel %> Class Schedule</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub"><%= dayLabel %> Class Schedule</p>
        </div>
      </div>

      <div class="class-schedule-print-fit" data-shrink-to-fit>
        <table class="class-schedule-print-grid">
          <thead>
            <tr>
              <th class="class-schedule-print-room-col">Room</th>
              <% roomGrid.hours.forEach(function(h) { %><th><%= h.label %></th><% }); %>
            </tr>
          </thead>
          <tbody>
            <% roomGrid.rows.forEach(function(row) { %>
              <tr>
                <td class="class-schedule-print-room-col"><%= row.room %></td>
                <% row.cells.forEach(function(cell) { %>
                  <td colspan="<%= cell.span %>">
                    <% if (cell.classes.length === 0) { %>
                      &nbsp;
                    <% } else { %>
                      <% cell.classes.forEach(function(cls) { %>
                        <%
                          var teachers = cls.staff.filter(function(s) { return s.role !== 'assistant'; }).map(function(s) { return s.name; });
                          var assistants = cls.staff.filter(function(s) { return s.role === 'assistant'; }).map(function(s) { return s.name; });
                        %>
                        <div class="class-schedule-print-card" style="border-left-color: <%= cls.color %>; background: color-mix(in srgb, <%= cls.color %> 12%, white);">
                          <h3><%= cls.class_name %></h3>
                          <% if (cls.age_group) { %><p class="class-schedule-print-grade"><%= cls.age_group %></p><% } %>
                          <% if (teachers.length > 0) { %><p class="class-schedule-print-staff">Teacher: <%= teachers.join(', ') %></p><% } %>
                          <% if (assistants.length > 0) { %><p class="class-schedule-print-staff">Assistant: <%= assistants.join(', ') %></p><% } %>
                        </div>
                      <% }); %>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
  <script src="/js/print-shrink-to-fit.js"></script>
  <script src="/js/print-auto.js"></script>
</body>
</html>
