<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Dashboard</h1>

    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-value"><%= memberCount %></span>
        <span class="stat-label">Active Members</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= todayPresent %></span>
        <span class="stat-label">Checked In Today</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= todayLate %></span>
        <span class="stat-label">Late Today</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= todayAbsent %></span>
        <span class="stat-label">Absent Today</span>
      </div>
    </div>

    <h2>Kiosk Links</h2>
    <div class="admin-card-grid">
      <a class="admin-card" href="/kiosk/checkin" target="_blank">Check-In Kiosk</a>
      <a class="admin-card" href="/kiosk/checkout" target="_blank">Check-Out Kiosk</a>
      <a class="admin-card" href="/absence" target="_blank">Absence/Late Form (public link)</a>
    </div>
  </main>
</body>
</html>
