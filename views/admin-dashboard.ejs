<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Dashboard</h1>
    <p class="subtitle">Signed in as <%= username %> &middot; <%= today %></p>

    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-value"><%= memberCount %></span>
        <span class="stat-label">Active Members</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= todayPresent %></span>
        <span class="stat-label">Checked In Today</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= todayCheckouts %></span>
        <span class="stat-label">Checked Out Today</span>
      </div>
    </div>

    <h2>Rosters</h2>
    <% if (categories.length > 0) { %>
      <div class="category-filter">
        <label for="category-select">Category</label>
        <select id="category-select" onchange="window.location = this.value ? '/admin?category=' + encodeURIComponent(this.value) : '/admin'">
          <option value="">All categories</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c %>" <%= selectedCategory === c ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
      </div>
    <% } %>
    <div class="admin-card-grid">
      <% rosters.forEach(function(r) { %>
        <a class="admin-card" href="/admin/roster/<%= r.id %>">
          <%= r.name %>
          <span class="admin-card-sub"><%= r.category ? r.category + ' &middot; ' : '' %><%= r.memberCount %> member<%= r.memberCount === 1 ? '' : 's' %></span>
        </a>
      <% }); %>
      <a class="admin-card admin-card-muted" href="/admin/rosters">+ Manage / Create Rosters</a>
    </div>

    <h2>Kiosk Links</h2>
    <div class="admin-card-grid">
      <a class="admin-card" href="/kiosk/checkin" target="_blank">Check-In Kiosk</a>
      <a class="admin-card" href="/kiosk/checkout" target="_blank">Check-Out Kiosk</a>
      <a class="admin-card" href="/absence" target="_blank">Absence/Late Form (public link)</a>
    </div>
  </main>
</body>
</html>
