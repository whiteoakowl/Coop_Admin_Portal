<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Dashboard</h1>

    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-value"><%= memberCount %></span>
        <span class="stat-label">Active Members</span>
      </div>
    </div>

    <h2 class="dashboard-section-title">Today's Attendance</h2>
    <div class="dashboard-analytics-grid">
      <%- include('partials/dashboard-type-stats', { label: 'Students', stats: studentStats }) %>
      <%- include('partials/dashboard-type-stats', { label: 'Parents', stats: parentStats }) %>
    </div>
  </main>
</body>
</html>
