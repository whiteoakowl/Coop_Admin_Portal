<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Dashboard</h1>

    <div class="totals-card">
      <div class="totals-item">
        <span class="stat-value"><%= mondayStudentCount %></span>
        <span class="stat-label">Monday Students</span>
      </div>
      <div class="totals-item">
        <span class="stat-value"><%= mondayParentCount %></span>
        <span class="stat-label">Monday Parents</span>
      </div>
      <div class="totals-item">
        <span class="stat-value"><%= wednesdayStudentCount %></span>
        <span class="stat-label">Wednesday Students</span>
      </div>
      <div class="totals-item">
        <span class="stat-value"><%= wednesdayParentCount %></span>
        <span class="stat-label">Wednesday Parents</span>
      </div>
      <div class="totals-item">
        <span class="stat-value"><%= memberCount %></span>
        <span class="stat-label">Total Members</span>
      </div>
      <div class="totals-item">
        <span class="stat-value"><%= familyCount %></span>
        <span class="stat-label">Total Families</span>
      </div>
    </div>

    <h2 class="dashboard-section-title">Today's Attendance</h2>
    <div class="dashboard-analytics-grid">
      <%- include('partials/dashboard-type-stats', { label: 'Parents', stats: parentStats }) %>
      <%- include('partials/dashboard-type-stats', { label: 'Students', stats: studentStats }) %>
    </div>

    <h2 class="dashboard-section-title">Alert Log</h2>
    <div class="alert-log">
      <% if (alerts.length === 0) { %>
        <p class="roster-empty">No active alerts today.</p>
      <% } else { %>
        <ul class="alert-log-list">
          <% alerts.forEach(function(a) { %>
            <li class="alert-log-item alert-log-item-<%= a.severity %>">
              <svg class="icon alert-log-icon"><use href="#<%= a.severity === 'danger' ? 'icon-x-circle' : 'icon-info-circle' %>"/></svg>
              <div class="alert-log-body">
                <span class="alert-log-day"><%= a.dayLabel %></span>
                <span class="alert-log-message"><a href="<%= a.link %>"><%= a.message %></a></span>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </main>
</body>
</html>
