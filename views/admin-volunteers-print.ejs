<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.4in; }</style>
</head>
<body class="admin-page floater-assignments-print-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= dayLabel %> Floater Assignments<% if (selectedDateLabel) { %> &mdash; <%= selectedDateLabel %><% } %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <% if (hourSections.length === 0) { %>
      <p class="roster-empty">Add a position above first (e.g. Front Desk, Hallway Monitor).</p>
    <% } else { %>
      <%
      // Read-only counterpart to the live manage page's own floater-chart-
      // cards partial (partials/floater-chart-cards.ejs) - same hour/slot
      // shape, same page-per-hour print wrapper and print-header, just the
      // Floater column swapped for plain text instead of an Assign/Unassign
      // form, since this page has nothing editable to offer.
      var FLOATER_ACCENTS = ['blue', 'green', 'orange', 'purple'];
      %>
      <div class="floater-cards-grid floater-chart-cards-grid">
        <% hourSections.forEach(function(hour, idx) { %>
          <% var accent = FLOATER_ACCENTS[idx % FLOATER_ACCENTS.length]; %>
          <div class="floater-print-page">
            <div class="print-header">
              <img src="/img/logo.png" alt="" />
              <div>
                <p class="print-header-title">Sanford Homeschoolers</p>
                <p class="print-header-sub"><%= dayLabel %> Floater Assignments<% if (selectedDateLabel) { %> &mdash; <%= selectedDateLabel %><% } %></p>
              </div>
            </div>
            <div class="floater-card floater-card-<%= accent %>">
              <div class="floater-card-header">
                <span class="floater-card-icon"><svg class="icon"><use href="#icon-clock"/></svg></span>
                <h3><%= hour.label %></h3>
              </div>
              <table class="floater-card-table floater-chart-table">
                <thead><tr><th>Position</th><th>Room</th><th>Floater</th></tr></thead>
                <tbody>
                  <% hour.slots.forEach(function(slot) { %>
                    <tr>
                      <td class="floater-card-position">
                        <%= slot.label %>
                        <% if ((slot.slotType === 'class' || slot.slotType === 'vacancy') && slot.reason) { %><span class="floater-slot-reason"><%= slot.reason %></span><% } %>
                      </td>
                      <td><%= slot.room || '—' %></td>
                      <td><%= slot.assigned ? slot.assigned.name : (slot.noneAvailable ? 'No available floaters' : 'Unassigned') %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
              <div class="floater-card-footer">
                <svg class="icon"><use href="#icon-users"/></svg>
                <%= hour.slots.length %> Position<%= hour.slots.length === 1 ? '' : 's' %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
