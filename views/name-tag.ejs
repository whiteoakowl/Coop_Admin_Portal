<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="form-wrap">
    <a href="/kiosk" class="kiosk-home"><svg class="icon"><use href="#icon-home"/></svg> Return to Home Screen</a>
    <div class="kiosk-header">
      <img class="form-logo" src="/img/logo-owl.png" alt="Sanford Homeschoolers" />
      <h1>Name Tag Form</h1>
    </div>

    <% if (result) { %>
      <div class="alert <%= result.ok ? 'alert-success' : 'alert-error' %>"><%= result.message %></div>
    <% } %>

    <form method="POST" action="/name-tag/submit" id="name-tag-form" class="form-outer-panel" data-redirect-home="<%= result && result.redirectHome ? '1' : '' %>">
      <%
        // activeMemberOptions (routes/name-tag.js) offers every active
        // member - parent, admin, or student - not just parents, so each
        // row's own label reflects its real type instead of assuming
        // everyone picked is a parent.
        var TYPE_LABELS = { parent: 'Parent', admin: 'Admin', student: 'Student' };
        function typeLabel(m) { return TYPE_LABELS[m.member_type] || 'Member'; }
      %>
      <div class="form-section">
        <h2>Your Name</h2>
        <div class="stack-form">
          <select id="memberId" name="memberId" required>
            <option value="">Select your name&hellip;</option>
            <% members.forEach(function(m) { %>
              <option value="<%= m.id %>" <%= String(formValues.memberId) === String(m.id) ? 'selected' : '' %>><%= m.name %> (<%= typeLabel(m) %>)</option>
            <% }); %>
          </select>
        </div>

        <button type="button" id="select-all-btn" class="btn-secondary select-all-btn" hidden>Select All</button>
        <div id="name-tag-member-groups">
          <% members.forEach(function(m) { %>
            <% var family = familyByMember[m.id] || []; %>
            <div class="absence-children-group" data-member-id="<%= m.id %>" <%= String(formValues.memberId) === String(m.id) ? '' : 'hidden' %>>
              <div class="checkbox-group">
                <label class="checkbox-option">
                  <input type="checkbox" name="memberIds" value="<%= m.id %>" <%= formValues.memberIds.map(String).includes(String(m.id)) ? 'checked' : '' %> />
                  <%= m.name %> (<%= typeLabel(m) %>)
                </label>
                <% family.forEach(function(f) { %>
                  <label class="checkbox-option">
                    <input type="checkbox" name="memberIds" value="<%= f.id %>" <%= formValues.memberIds.map(String).includes(String(f.id)) ? 'checked' : '' %> />
                    <%= f.name %><% if (f.member_type !== 'student') { %> (<%= typeLabel(f) %>)<% } %>
                  </label>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>
        <p id="member-required-msg" class="hint absence-required-msg" hidden>Please select at least one name.</p>
      </div>

      <div class="form-section">
        <h2>What Do You Need?</h2>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="requestType" value="lost_tag" <%= formValues.requestType === 'lost_tag' ? 'checked' : '' %> required />
            Lost Name Tag
          </label>
          <label class="radio-option">
            <input type="radio" name="requestType" value="schedule_change" <%= formValues.requestType === 'schedule_change' ? 'checked' : '' %> />
            Schedule Change
          </label>
        </div>
      </div>

      <div class="form-section">
        <h2>Day</h2>
        <div class="radio-group">
          <label class="radio-option">
            <input type="radio" name="day" value="monday" <%= formValues.day === 'monday' ? 'checked' : '' %> required />
            Monday
          </label>
          <label class="radio-option">
            <input type="radio" name="day" value="wednesday" <%= formValues.day === 'wednesday' ? 'checked' : '' %> />
            Wednesday
          </label>
          <label class="radio-option">
            <input type="radio" name="day" value="both" <%= formValues.day === 'both' ? 'checked' : '' %> />
            Both
          </label>
        </div>
      </div>

      <div class="form-section">
        <h2>Description</h2>
        <div class="stack-form">
          <textarea id="description" name="description" rows="3" placeholder="Add any details (optional)"><%= formValues.description %></textarea>
        </div>
      </div>

      <button type="submit" class="primary-btn">Submit</button>
    </form>
  </main>
  <script src="/js/name-tag.js"></script>
  <script src="/js/fullscreen-nav.js"></script>
</body>
</html>
