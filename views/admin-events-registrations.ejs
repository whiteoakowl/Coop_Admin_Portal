<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%
    // See admin-events-builder.ejs's own comment - this same page now
    // also renders for an organizer-parent (routes/admin-events.js's own
    // requireMainAdminOrEventOrganizer), whose real portal is always
    // Parent Portal.
    var organizerView = typeof isOrganizerView !== 'undefined' && isOrganizerView;
  %>
  <%- include('partials/portal-nav', {
    portalTitle: organizerView ? 'Parent Portal' : 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Registrations &mdash; <%= event.title %></h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%# A real request: "remove back to all events button. edit event
        should just be a blue text link with back arrow on its own row.
        add registration, print, export, import buttons should all be on
        their own row below/stacked under the edit event link" - same
        plain <p><a>&larr; ...</a></p> convention as admin-events-
        builder.ejs's own "All Events" link, replacing this page's own
        roster-action-btn pair that used to share the toolbar row with
        Add Registration/Print/Export/Import. %>
    <p><a href="/main-admin/events/<%= event.id %>/builder">&larr; Edit Event</a></p>
    <div class="roster-toolbar">
      <div class="roster-btn-row">
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-registration-dialog').showModal()">+ Add Registration</button>
        <a class="roster-action-btn print-action-btn" href="/main-admin/events/<%= event.id %>/registrations/print" target="_blank">Print</a>
        <a class="roster-action-btn file-action-btn" href="/main-admin/events/<%= event.id %>/registrations/export.csv">Export</a>
        <button type="button" class="roster-action-btn file-action-btn" onclick="document.getElementById('import-registrations-dialog').showModal()">Import</button>
      </div>
      <%# A real request: "when you click attendance it should show a
          purple check in and purple check out button. when you click
          each button it should show the same mobile barcode, barcode or
          ID check in buttons just like the class check in page." Same
          .class-checkin-btn look/markup as views/kiosk-class-checkin-
          attendance.ejs's own pair. %>
      <div class="class-checkin-actions">
        <a class="class-checkin-btn" href="/main-admin/events/<%= event.id %>/checkin-scan?mode=checkin">
          <svg class="icon"><use href="#icon-check"/></svg> Check In
        </a>
        <a class="class-checkin-btn" href="/main-admin/events/<%= event.id %>/checkin-scan?mode=checkout">
          <svg class="icon"><use href="#icon-log-out"/></svg> Check Out
        </a>
      </div>
    </div>

    <%
      // A real request, with a reference screenshot: "counts for
      // registered, canceled, checked in etc should look like this
      // single card image. Use my pastel website colors. Orange. Blue,
      // purple and green." All 4 statuses live on ONE card, each its own
      // tinted column (icon+title header, then Family/Student/Parent
      // rows below) - this app's own established soft-tint palette
      // (green-bg/orange-bg/brand-soft/purple-soft - the same tokens
      // .event-register-card and the team-accent-N cards already use)
      // instead of the reference's own bold red/blue/green/purple - red
      // isn't one of "my" 4 named colors, so Canceled is orange here.
      var regSummaryCards = [
        { key: 'registered', label: 'Registered', icon: 'icon-users', accent: 'green' },
        { key: 'canceled', label: 'Canceled', icon: 'icon-x-circle', accent: 'orange' },
        { key: 'checkedIn', label: 'Checked In', icon: 'icon-check-circle', accent: 'blue' },
        { key: 'checkedOut', label: 'Checked Out', icon: 'icon-log-out', accent: 'purple' },
      ];
    %>
    <div class="manage-section reg-summary-card">
      <div class="reg-summary-cols">
        <% regSummaryCards.forEach(function(card) { %>
          <div class="reg-summary-col reg-summary-col-<%= card.accent %>">
            <div class="reg-summary-col-header">
              <svg class="icon"><use href="#<%= card.icon %>"/></svg>
              <span><%= card.label %></span>
            </div>
            <div class="reg-summary-row">
              <svg class="icon"><use href="#icon-users"/></svg>
              <span class="reg-summary-row-label">Family</span>
              <span class="reg-summary-row-value"><%= totals[card.key].family %></span>
            </div>
            <div class="reg-summary-row">
              <svg class="icon"><use href="#icon-graduation-cap"/></svg>
              <span class="reg-summary-row-label">Student</span>
              <span class="reg-summary-row-value"><%= totals[card.key].student %></span>
            </div>
            <div class="reg-summary-row">
              <svg class="icon"><use href="#icon-user"/></svg>
              <span class="reg-summary-row-label">Parent</span>
              <span class="reg-summary-row-value"><%= totals[card.key].parent %></span>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <% if (familyGroups.length === 0) { %>
      <p class="roster-empty">No one has registered yet.</p>
    <% } else { %>
      <div class="legend">
        <span class="legend-item"><span class="cell-tag cell-present">P</span> Present</span>
        <span class="legend-item"><span class="cell-tag cell-late">L</span> Late</span>
        <span class="legend-item"><span class="cell-tag cell-absent">A</span> Absent</span>
      </div>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table registrations-table">
          <thead>
            <tr>
              <%# A real request: "roster will show primary member name
                  sub categories students and other guests in that
                  family. next column paid amount, date and time
                  registered, signedup/canceled/wait list column that
                  changes as their status changes, then a column for
                  volunteer signup." "Signup lists" and "questions"
                  columns aren't included yet - neither one has any real
                  data behind it in this app yet (signup lists are a
                  separate, not-yet-built feature; there's no per-event
                  custom-question feature at all), so there is nothing
                  "applicable" to show in either one for any event today.

                  A later real request: "column titles should be two
                  rows to condense." Each multi-word header gets an
                  explicit <br> instead of relying on natural wrapping
                  (which would only kick in once a column is already
                  narrow, defeating the point) - .registrations-table th
                  below allows that wrap and gives each header a tighter
                  max-width so the column itself shrinks to match. %>
              <th class="roster-name-col">Name</th>
              <th>Status</th>
              <th>Paid</th>
              <th>Registered</th>
              <th>P/A/L</th>
              <th>Checked<br>In</th>
              <th>Checked<br>Out</th>
              <% if (event.volunteers_enabled) { %><th>Volunteer<br>Signup</th><% } %>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <%
              // Price display: this event has one flat price (no per-
              // registration payment tracking exists anywhere in this
              // schema - Accounting is its own separate, un-integrated
              // feature), charged once per family for 'family' pricing
              // (shown only on the group's own primary row) or once per
              // confirmed person for 'person' pricing (shown on every
              // confirmed row) - waitlisted/cancelled rows owe nothing
              // yet either way.
              function priceFor(status, isFirstInGroup) {
                if (event.price_cents == null || status !== 'confirmed') return null;
                if (event.price_per === 'family' && !isFirstInGroup) return null;
                return '$' + (event.price_cents / 100).toFixed(2);
              }
            %>
            <% familyGroups.forEach(function(group) { %>
              <% var isFirst = true; %>
              <% group.members.forEach(function(r) { %>
                <% var price = priceFor(r.status, isFirst); %>
                <tr data-registration-row="<%= r.id %>" class="<%= isFirst ? 'roster-group-start' : 'roster-group-member' %>">
                  <td class="roster-name-col"><%= isFirst ? '' : '↳ ' %><%= r.memberName %></td>
                  <td>
                    <% if (r.status === 'confirmed') { %>
                      <span class="badge-pill badge-pill-green">Signed Up</span>
                    <% } else if (r.status === 'waitlisted') { %>
                      <span class="badge-pill badge-pill-orange">Waitlisted<% if (r.waitlist_position) { %> (#<%= r.waitlist_position %>)<% } %></span>
                    <% } else { %>
                      <span class="badge-pill badge-pill-gray">Cancelled</span>
                    <% } %>
                  </td>
                  <td><%= price || '—' %></td>
                  <td><%= r.createdAtLabel %></td>
                  <td>
                    <select class="roster-cell-select roster-cell-select-<%= r.attendance_status || 'blank' %>" data-status-endpoint="/main-admin/events/<%= event.id %>/registrations/<%= r.id %>/status" aria-label="P/A/L for <%= r.memberName %>">
                      <option value="" <%= !r.attendance_status ? 'selected' : '' %>>—</option>
                      <option value="present" <%= r.attendance_status === 'present' ? 'selected' : '' %>>P</option>
                      <option value="late" <%= r.attendance_status === 'late' ? 'selected' : '' %>>L</option>
                      <option value="absent" <%= r.attendance_status === 'absent' ? 'selected' : '' %>>A</option>
                    </select>
                  </td>
                  <td><%= r.checkedInAtLabel || '—' %></td>
                  <td><%= r.checkedOutAtLabel || '—' %></td>
                  <% if (event.volunteers_enabled) { %>
                    <td><%= (volunteerSignupsByMember.get(r.member_id) || []).join(', ') || '—' %></td>
                  <% } %>
                  <%# A real request: "there should also be a cancel button
                      next to each member. When you click cancel they
                      remain on the roster and simply show as canceled."
                      Cancel only makes sense once (nothing to cancel once
                      already cancelled); the trash icon always shows -
                      deleting an already-cancelled row is how it actually
                      disappears off the roster for good. Both are plain
                      buttons (not <form> submits) wired up by this page's
                      own inline script below, so clicking either updates
                      this row (or removes it) in place instead of a full
                      page reload. %>
                  <td>
                    <%# A real request: "cancel buttons the text should
                        fit properly in the box. and the button should
                        sit next to the trash button." roster-action-btn-
                        fit drops the base .roster-action-btn's min-width:
                        5.5rem/flex:1 0 auto (sized for a wide toolbar row),
                        which was stretching this button well past its own
                        "Cancel" text and crowding out the trash icon
                        beside it. %>
                    <div class="roster-btn-row roster-btn-row-nowrap">
                      <% if (r.status !== 'cancelled') { %>
                        <button type="button" class="roster-action-btn roster-action-btn-small roster-action-btn-fit js-registration-cancel" data-cancel-endpoint="/main-admin/events/<%= event.id %>/registrations/<%= r.id %>/cancel" data-member-name="<%= r.memberName %>">Cancel</button>
                      <% } %>
                      <button type="button" class="icon-btn icon-btn-danger js-registration-delete" data-delete-endpoint="/main-admin/events/<%= event.id %>/registrations/<%= r.id %>/delete" data-member-name="<%= r.memberName %>" aria-label="Delete registration for <%= r.memberName %>" title="Delete Registration"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </div>
                  </td>
                </tr>
                <% isFirst = false; %>
              <% }); %>
              <% group.guests.forEach(function(g) { %>
                <tr data-guest-row="<%= g.id %>" class="<%= isFirst ? 'roster-group-start' : 'roster-group-member' %>">
                  <td class="roster-name-col"><%= isFirst ? '' : '↳ ' %><%= g.guest_name %> <span class="badge-pill">Guest</span></td>
                  <td>
                    <% if (g.status === 'confirmed') { %>
                      <span class="badge-pill badge-pill-green">Signed Up</span>
                    <% } else { %>
                      <span class="badge-pill badge-pill-gray">Cancelled</span>
                    <% } %>
                    <% if (canRegisterGuests && g.status === 'confirmed') { %>
                      <form method="POST" action="/main-admin/events/<%= event.id %>/guests/<%= g.id %>/cancel" class="inline-block-form" data-confirm="Cancel guest &quot;<%= g.guest_name %>&quot;?">
                        <button type="submit" class="roster-action-btn roster-action-btn-danger">Cancel</button>
                      </form>
                    <% } %>
                  </td>
                  <td><%= priceFor(g.status, isFirst) || '—' %></td>
                  <td><%= g.createdAtLabel %></td>
                  <td>
                    <select class="roster-cell-select roster-cell-select-<%= g.attendance_status || 'blank' %>" data-status-endpoint="/main-admin/events/<%= event.id %>/guests/<%= g.id %>/status" aria-label="P/A/L for <%= g.guest_name %>">
                      <option value="" <%= !g.attendance_status ? 'selected' : '' %>>—</option>
                      <option value="present" <%= g.attendance_status === 'present' ? 'selected' : '' %>>P</option>
                      <option value="late" <%= g.attendance_status === 'late' ? 'selected' : '' %>>L</option>
                      <option value="absent" <%= g.attendance_status === 'absent' ? 'selected' : '' %>>A</option>
                    </select>
                  </td>
                  <td><%= g.checkedInAtLabel || '—' %></td>
                  <td><%= g.checkedOutAtLabel || '—' %></td>
                  <% if (event.volunteers_enabled) { %><td>—</td><% } %>
                  <td></td>
                </tr>
                <% isFirst = false; %>
              <% }); %>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <%
    // "Pop up with menu of members with check boxes and filter for
    // family name in ABC order. Able to select multiple boxes and save
    // all at once." eligibleMembers already arrives sorted family-first
    // A-Z (utils/events.js's own eligibleMembersForRegistration); the
    // family dropdown below just offers a way to narrow that same list
    // down to one family, built from its own distinct family names, also
    // A-Z.
    var registrationFamilyNames = Array.from(new Set(eligibleMembers.filter(function(m) { return m.familyName; }).map(function(m) { return m.familyName; }))).sort(function(a, b) { return a.localeCompare(b, undefined, { sensitivity: 'base' }); });
    %>
    <dialog id="add-registration-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/registrations/add" id="add-registration-form">
        <h3>Add Registration</h3>
        <% if (eligibleMembers.length === 0) { %>
          <p class="hint">Everyone active is already registered for this event.</p>
        <% } else { %>
          <%# A real request: "after selecting the family and then the
              members of that family signing up, the popup window will
              then go through all of the signup, extra question and
              tickets choices for that event as if the actual member is
              signing up." Step 1 (pick members) is unchanged; Continue
              builds Step 2 below (public/js/admin-event-add-registration.js)
              with each selected member's OWN ticket choice and OWN
              each_member-scoped answers - a family-scoped field only
              ever gets cloned into whichever selected member actually
              IS a parent/admin, same scope rule the public registration
              form enforces (utils/events.js's own extraFieldsForMemberType). %>
          <div id="add-registration-step-pick">
            <label>Filter by Family
              <select id="add-registration-family-filter">
                <option value="">All Families</option>
                <% registrationFamilyNames.forEach(function(name) { %>
                  <option value="<%= name %>"><%= name %></option>
                <% }); %>
              </select>
            </label>
            <div class="member-picker-list" id="add-registration-member-list">
              <% eligibleMembers.forEach(function(m) { %>
                <label class="member-picker-row" data-family="<%= m.familyName || '' %>">
                  <input type="checkbox" name="pickedMemberIds" value="<%= m.id %>" data-member-name="<%= m.name %>" data-member-type="<%= m.memberType %>" />
                  <span><%= m.name %><% if (m.familyName) { %> <span class="hint">(<%= m.familyName %>)</span><% } %></span>
                </label>
              <% }); %>
            </div>
          </div>

          <div id="add-registration-step-details" hidden>
            <div id="add-registration-member-details"></div>
            <% if (attachedVolunteerLists.length) { %>
              <% attachedVolunteerLists.forEach(function(list) { %>
                <label><%= list.title %> Shift <span class="hint">(optional - applies to everyone selected above)</span>
                  <select name="volunteerShiftId">
                    <option value="">None</option>
                    <% list.shifts.forEach(function(s) { %>
                      <option value="<%= s.id %>"><%= s.job_name %><% if (s.shift_date) { %> - <%= s.shift_date %><% } %> (<%= s.signups.length %>/<%= s.slots_needed %>)</option>
                    <% }); %>
                  </select>
                </label>
              <% }); %>
            <% } %>
            <% if (attachedSignUpLists.length) { %>
              <% attachedSignUpLists.forEach(function(list) { %>
                <label><%= list.title %> Item <span class="hint">(optional - one each, applies to everyone selected above)</span>
                  <select name="signupItemId">
                    <option value="">None</option>
                    <% list.items.forEach(function(item) { %>
                      <option value="<%= item.id %>"><%= item.item_name %> (<%= item.quantityClaimed %>/<%= item.quantity_needed %>)</option>
                    <% }); %>
                  </select>
                </label>
              <% }); %>
            <% } %>
          </div>

          <%# Cloned once per selected member by public/js/admin-event-
              add-registration.js when Continue is clicked - never
              submitted itself (a bare <template>'s content isn't part
              of the form). %>
          <template id="add-registration-ticket-template">
            <% if (event.ticketTypes && event.ticketTypes.length) { %>
              <label class="member-form-full">Ticket
                <select data-ticket-input required>
                  <option value="">Select a ticket</option>
                  <% event.ticketTypes.forEach(function(t) { %>
                    <option value="<%= t.id %>"><%= t.title %> &ndash; $<%= (t.price_cents / 100).toFixed(2) %> / <%= t.price_per %></option>
                  <% }); %>
                </select>
              </label>
            <% } %>
          </template>
          <template id="add-registration-fields-template">
            <% (event.extraFields || []).forEach(function(field) { %>
              <label class="member-form-full" data-field-id="<%= field.id %>" data-field-scope="<%= field.scope %>"><%= field.label %><% if (field.required) { %> *<% } %>
                <% if (field.field_type === 'textarea') { %>
                  <textarea data-answer-input rows="2" <%= field.required ? 'required' : '' %>></textarea>
                <% } else if (field.field_type === 'select') { %>
                  <select data-answer-input <%= field.required ? 'required' : '' %>>
                    <option value="">Select one</option>
                    <% (field.options || '').split('\n').filter(Boolean).forEach(function(opt) { %>
                      <option value="<%= opt %>"><%= opt %></option>
                    <% }); %>
                  </select>
                <% } else if (field.field_type === 'checkbox') { %>
                  <input type="checkbox" data-answer-input value="Yes" <%= field.required ? 'required' : '' %> />
                <% } else { %>
                  <input type="text" data-answer-input <%= field.required ? 'required' : '' %> />
                <% } %>
              </label>
            <% }); %>
          </template>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <% if (eligibleMembers.length > 0) { %>
            <button type="button" class="btn-secondary" id="add-registration-back-btn" hidden>Back</button>
            <button type="button" class="primary-btn" id="add-registration-continue-btn">Continue</button>
            <button type="submit" class="primary-btn" id="add-registration-save-btn" hidden>Save</button>
          <% } %>
        </div>
      </form>
    </dialog>

    <dialog id="import-registrations-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/registrations/import" enctype="multipart/form-data">
        <h3>Import Registrations</h3>
        <p class="hint">A spreadsheet with one "Member Code or Name" column. <a href="/main-admin/events/<%= event.id %>/registrations/import-template.xlsx">Download a template</a>.</p>
        <label>File
          <input type="file" name="file" accept=".csv,.xlsx,.xls" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Import</button>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/admin-event-add-registration.js"></script>
  <script>
    // P/A/L roster grid (item 11) - each select auto-saves on change, same
    // "no separate Edit/Save step" pattern public/js/attendance-grid.js
    // uses for class attendance, but posting a plain `status` field to
    // this page's own per-row endpoint instead of that script's class-
    // attendance-specific `status:<memberId>:<date>` body key.
    (function () {
      var csrf = document.querySelector('meta[name="csrf-token"]');
      document.querySelectorAll('.roster-cell-select').forEach(function (sel) {
        sel.addEventListener('change', function () {
          sel.className = 'roster-cell-select roster-cell-select-' + (sel.value || 'blank');
          fetch(sel.dataset.statusEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf ? csrf.content : '' },
            body: 'status=' + encodeURIComponent(sel.value) + '&_csrf=' + encodeURIComponent(csrf ? csrf.content : ''),
          });
        });
      });
    })();

    // Real requests: "there should also be a cancel button next to each
    // member. When you click cancel they remain on the roster and simply
    // show as canceled" + "when you click the trash button it will delete
    // their name from the roster completely and unregister them. Page does
    // not refresh." window.confirmAction (public/js/confirm-dialog.js) is
    // the same sitewide "are you sure?" popup every data-confirm form uses,
    // just the Promise-returning flavor meant for a plain fetch()-driven
    // button like these instead of a real <form> submit.
    (function () {
      var csrf = document.querySelector('meta[name="csrf-token"]');
      function post(endpoint) {
        return fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf ? csrf.content : '' },
          body: '_csrf=' + encodeURIComponent(csrf ? csrf.content : ''),
        });
      }

      document.querySelectorAll('.js-registration-cancel').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var confirmed = await window.confirmAction({
            message: 'Cancel ' + btn.dataset.memberName + '’s registration? They will remain on the roster, shown as Cancelled.',
            safe: true,
            yesLabel: 'Yes, Cancel',
          });
          if (!confirmed) return;
          await post(btn.dataset.cancelEndpoint);
          var row = btn.closest('tr');
          row.children[1].innerHTML = '<span class="badge-pill badge-pill-gray">Cancelled</span>';
          btn.remove();
        });
      });

      document.querySelectorAll('.js-registration-delete').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var confirmed = await window.confirmAction({
            message: 'Permanently delete ' + btn.dataset.memberName + '’s registration? They will be removed from the roster completely - this cannot be undone.',
            yesLabel: 'Yes, Delete',
          });
          if (!confirmed) return;
          await post(btn.dataset.deleteEndpoint);
          btn.closest('tr').remove();
        });
      });
    })();
  </script>
</body>
</html>
