<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Registrations &mdash; <%= event.title %></h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="roster-toolbar">
      <div class="roster-btn-row">
        <a class="roster-action-btn" href="/main-admin/events/<%= event.id %>/builder">&larr; Back to Event</a>
      </div>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Scan to Check In / Out</h2></div>
      <p class="hint">Scan a member's name tag barcode (or type their member ID) to toggle them Present on the roster below.</p>
      <div class="class-form-row">
        <div class="class-form-field">
          <input type="text" id="event-scan-input" data-event-id="<%= event.id %>" autocomplete="off" placeholder="Scan or type barcode&hellip;" />
        </div>
        <div class="class-form-field">
          <select id="event-scan-mode">
            <option value="checkin">Check In</option>
            <option value="checkout">Check Out</option>
          </select>
        </div>
      </div>
      <p id="event-scan-feedback" class="hint" aria-live="polite"></p>
    </div>

    <% if (registrations.length === 0 && guestRegistrations.length === 0) { %>
      <p class="roster-empty">No one has registered yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Status</th>
              <th>Registered</th>
              <th>Checked In</th>
              <th>P/A/L</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% registrations.forEach(function(r) { %>
              <tr data-registration-row="<%= r.id %>">
                <td class="roster-name-col"><%= r.memberName %></td>
                <td>
                  <% if (r.status === 'confirmed') { %>
                    <span class="badge-pill badge-pill-green">Confirmed</span>
                  <% } else if (r.status === 'waitlisted') { %>
                    <span class="badge-pill badge-pill-orange">Waitlisted<% if (r.waitlist_position) { %> (#<%= r.waitlist_position %>)<% } %></span>
                  <% } else { %>
                    <span class="badge-pill badge-pill-gray">Cancelled</span>
                  <% } %>
                </td>
                <td><%= r.created_at %></td>
                <td>
                  <% if (r.checked_in_at && r.checked_out_at) { %>
                    <span class="badge-pill badge-pill-gray">Checked Out</span>
                  <% } else if (r.checked_in_at) { %>
                    <span class="badge-pill badge-pill-green">Present</span>
                  <% } else { %>
                    <span class="badge-pill badge-pill-gray">Absent</span>
                  <% } %>
                </td>
                <td>
                  <select class="roster-cell-select roster-cell-select-<%= r.attendance_status || 'blank' %>" data-status-endpoint="/main-admin/events/<%= event.id %>/registrations/<%= r.id %>/status" aria-label="P/A/L for <%= r.memberName %>">
                    <option value="" <%= !r.attendance_status ? 'selected' : '' %>>—</option>
                    <option value="present" <%= r.attendance_status === 'present' ? 'selected' : '' %>>P</option>
                    <option value="late" <%= r.attendance_status === 'late' ? 'selected' : '' %>>L</option>
                    <option value="absent" <%= r.attendance_status === 'absent' ? 'selected' : '' %>>A</option>
                  </select>
                </td>
                <td>
                  <% if (r.status === 'confirmed') { %>
                    <div class="roster-btn-row">
                      <form method="POST" action="/main-admin/events/<%= event.id %>/registrations/<%= r.id %>/checkin" class="inline-block-form">
                        <input type="hidden" name="present" value="1" />
                        <button type="submit" class="roster-action-btn">Check In</button>
                      </form>
                      <form method="POST" action="/main-admin/events/<%= event.id %>/registrations/<%= r.id %>/checkout" class="inline-block-form">
                        <button type="submit" class="roster-action-btn">Check Out</button>
                      </form>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }); %>
            <% guestRegistrations.forEach(function(g) { %>
              <tr>
                <td class="roster-name-col"><%= g.guest_name %> <span class="badge-pill">Guest</span></td>
                <td><span class="badge-pill badge-pill-green">Confirmed</span></td>
                <td><%= g.created_at %></td>
                <td>
                  <% if (g.checked_in_at && g.checked_out_at) { %>
                    <span class="badge-pill badge-pill-gray">Checked Out</span>
                  <% } else if (g.checked_in_at) { %>
                    <span class="badge-pill badge-pill-green">Present</span>
                  <% } else { %>
                    <span class="badge-pill badge-pill-gray">Absent</span>
                  <% } %>
                </td>
                <td>
                  <select class="roster-cell-select roster-cell-select-<%= g.attendance_status || 'blank' %>" data-status-endpoint="/main-admin/events/<%= event.id %>/guests/<%= g.id %>/status" aria-label="P/A/L for <%= g.guest_name %>">
                    <option value="" <%= !g.attendance_status ? 'selected' : '' %>>—</option>
                    <option value="present" <%= g.attendance_status === 'present' ? 'selected' : '' %>>P</option>
                    <option value="late" <%= g.attendance_status === 'late' ? 'selected' : '' %>>L</option>
                    <option value="absent" <%= g.attendance_status === 'absent' ? 'selected' : '' %>>A</option>
                  </select>
                </td>
                <td>
                  <div class="roster-btn-row">
                    <form method="POST" action="/main-admin/events/<%= event.id %>/guests/<%= g.id %>/checkin" class="inline-block-form">
                      <input type="hidden" name="present" value="1" />
                      <button type="submit" class="roster-action-btn">Check In</button>
                    </form>
                    <form method="POST" action="/main-admin/events/<%= event.id %>/guests/<%= g.id %>/checkout" class="inline-block-form">
                      <button type="submit" class="roster-action-btn">Check Out</button>
                    </form>
                    <% if (canRegisterGuests) { %>
                      <form method="POST" action="/main-admin/events/<%= event.id %>/guests/<%= g.id %>/cancel" class="inline-block-form" data-confirm="Cancel guest &quot;<%= g.guest_name %>&quot;?">
                        <button type="submit" class="roster-action-btn roster-action-btn-danger">Cancel</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (canRegisterGuests) { %>
      <div class="manage-section">
        <div class="grid-box-header">
          <h2>Guest Registration</h2>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-guest-dialog').showModal()">+ Register Guest</button>
        </div>
        <p class="hint">A guest has no member record - a lightweight walk-in registration. Check-in for guests is manual only (no name tag barcode exists to scan).</p>
      </div>

      <dialog id="add-guest-dialog" class="member-picker-dialog">
        <form method="POST" action="/main-admin/events/<%= event.id %>/guests">
          <h3>Register a Guest</h3>
          <label>Name
            <input type="text" name="guestName" required />
          </label>
          <label>Email <span class="hint">(optional)</span>
            <input type="email" name="guestEmail" />
          </label>
          <label>Phone <span class="hint">(optional)</span>
            <input type="text" name="guestPhone" />
          </label>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Register</button>
          </div>
        </form>
      </dialog>
    <% } %>
  </main>
  <script>
    (function () {
      var input = document.getElementById('event-scan-input');
      var mode = document.getElementById('event-scan-mode');
      var feedback = document.getElementById('event-scan-feedback');
      var csrf = document.querySelector('meta[name="csrf-token"]');
      if (!input) return;
      input.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        var barcode = input.value.trim();
        input.value = '';
        if (!barcode) return;
        fetch('/main-admin/events/' + input.dataset.eventId + '/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf ? csrf.content : '' },
          body: JSON.stringify({ barcode: barcode, mode: mode.value }),
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            feedback.textContent = data.message || '';
            feedback.style.color = data.ok ? '' : 'var(--red)';
            if (data.ok) setTimeout(function () { window.location.reload(); }, 600);
          })
          .catch(function () {
            feedback.textContent = 'Something went wrong - please try again.';
          });
      });
    })();

    // P/A/L roster grid (item 11) - each select auto-saves on change, same
    // "no separate Edit/Save step" pattern public/js/attendance-grid.js
    // uses for class attendance, but posting a plain `status` field to
    // this page's own per-row endpoint instead of that script's class-
    // attendance-specific `status:<memberId>:<date>` body key.
    (function () {
      var csrf = document.querySelector('meta[name="csrf-token"]');
      document.querySelectorAll('.roster-cell-select').forEach(function (sel) {
        sel.addEventListener('change', function () {
          sel.className = 'roster-cell-select roster-cell-select-' + (sel.value || 'blank');
          fetch(sel.dataset.statusEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf ? csrf.content : '' },
            body: 'status=' + encodeURIComponent(sel.value) + '&_csrf=' + encodeURIComponent(csrf ? csrf.content : ''),
          });
        });
      });
    })();
  </script>
</body>
</html>
