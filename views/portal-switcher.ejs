<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="form-wrap form-wrap-roster">
    <div class="form-outer-panel">
      <div class="kiosk-header">
        <img class="form-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
        <div class="kiosk-header-text">
          <h1>My Portals</h1>
          <%# A real request: "Portal choosing screen. Delete all
              descriptions" removed the page's own hint entirely; a later
              real request ("Under my portals add the description.
              Please choose a portal below:") brought back a single
              page-level one - each card's own role.description is still
              gone, and .portal-picker-title's own CSS below still
              carries the centering/larger-text part. %>
          <p class="kiosk-subhead">Please choose a portal below:</p>
        </div>
      </div>
      <div class="portal-picker-grid">
        <% roles.forEach(function(role) { %>
          <a class="portal-picker-card" href="<%= portalHomeRoutes[role.key] || '/portal' %>">
            <span class="portal-picker-title"><%= role.label %></span>
            <%# A real request: "Add description under each portal title.
                On choose portal page [...exact wording per portal]" -
                role.description is the same column rolesForAccount
                already selects (utils/portalAuth.js), just rendered here
                again after the earlier "delete all descriptions" request
                removed only this line (see this file's own header
                comment above). %>
            <% if (role.description) { %><span class="portal-picker-description"><%= role.description %></span><% } %>
          </a>
        <% }); %>
      </div>
    </div>
  </main>
</body>
</html>
