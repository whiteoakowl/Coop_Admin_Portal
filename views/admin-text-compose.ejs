<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <p><a href="/admin/announcements/text">&larr; Back</a></p>
    <h1>Compose Text</h1>
    <p class="hint"><%= recipients.length %> recipient<%= recipients.length === 1 ? '' : 's' %>: <%= recipients.map(function(r) { return r.name; }).join(', ') %></p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/admin/announcements/text/send" enctype="multipart/form-data" id="text-compose-form" class="stack-form member-form-page-panel">
      <% recipients.forEach(function(r) { %>
        <input type="hidden" name="recipientIds" value="<%= r.accountId %>" />
      <% }); %>

      <label class="member-form-full">Message
        <textarea name="body" id="text-body" rows="4" required maxlength="<%= maxLength %>" data-sms-char-counter="text-char-count" placeholder="e.g. Wednesday session is cancelled today."></textarea>
      </label>
      <p class="hint" id="text-char-count">0 / <%= maxLength %> characters</p>

      <%# A real request: "It should have an option to upload a photo." -
          same optional MMS image attachment the Members page's own quick-
          text popup already offers (public/js/member-text-notify.js),
          just a bulk send instead of one recipient. %>
      <label class="member-form-full">Image (optional)
        <input type="file" name="image" accept="image/*" />
      </label>

      <div class="member-form-full">
        <span class="checkbox-group-label">Send</span>
        <label class="checkbox-option">
          <input type="radio" name="sendOption" value="now" checked data-send-option />
          Send right away
        </label>
        <label class="checkbox-option">
          <input type="radio" name="sendOption" value="schedule" data-send-option />
          Schedule for later
        </label>
        <input type="datetime-local" name="scheduledAt" id="text-scheduled-at" disabled />
      </div>

      <div class="member-form-footer">
        <div class="member-form-footer-edit">
          <button type="submit" class="primary-btn">Send Text</button>
        </div>
      </div>
    </form>
  </main>
  <script src="/js/sms-char-counter.js"></script>
  <script>
    document.querySelectorAll('[data-send-option]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        document.getElementById('text-scheduled-at').disabled = document.querySelector('[data-send-option]:checked').value !== 'schedule';
      });
    });
  </script>
</body>
</html>
