<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main badge-print-main">
    <div class="print-preview-header no-print">
      <h1>Print Schedules</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <% if (rows.length === 0) { %>
        <p class="roster-empty">No schedules match your filters.</p>
      <% } else if (compact) { %>
        <%
          // One row per family member instead of a full card per member -
          // a family of even 3-4 people already runs the normal per-member
          // layout below past a single printed page, so "View All" needs
          // its own dense table: name above the row, Monday and Wednesday
          // each condensed into that one row's cell.
          function classLines(dayRows) {
            return dayRows.filter(function (c) { return c.class_name || c.time || c.room; });
          }
        %>
        <table class="roster-table schedule-print-compact-table">
          <thead><tr><th>Name</th><th>Monday</th><th>Wednesday</th></tr></thead>
          <tbody>
            <% rows.forEach(function(r) { %>
              <tr>
                <td class="schedule-print-compact-name"><%= r.member.name %></td>
                <% [r.monday, r.wednesday].forEach(function (dayRows) { %>
                  <% var lines = classLines(dayRows); %>
                  <td>
                    <% if (lines.length === 0) { %>
                      <span class="schedule-print-compact-empty">—</span>
                    <% } else { %>
                      <% lines.forEach(function (c) { %>
                        <div class="schedule-print-compact-line">
                          <span class="schedule-print-compact-time"><%= c.time || '—' %></span>
                          <%= c.class_name || '—' %><% if (c.room) { %> (<%= c.room %>)<% } %>
                        </div>
                      <% }); %>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <% rows.forEach(function(r) { %>
          <div class="schedule-print-card">
            <h2><%= r.member.name %></h2>
            <% [['Monday', r.monday], ['Wednesday', r.wednesday]].forEach(function (entry) { %>
              <% var label = entry[0], dayRows = entry[1]; %>
              <h3><%= label %></h3>
              <table class="roster-table schedule-print-table">
                <thead><tr><th>#</th><th>Time</th><th>Class Name</th><th>Room</th></tr></thead>
                <tbody>
                  <% dayRows.forEach(function (c, i) { %>
                    <tr>
                      <td><%= i + 1 %></td>
                      <td><%= c.time || '—' %></td>
                      <td><%= c.class_name || '—' %></td>
                      <td><%= c.room || '—' %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% }); %>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
