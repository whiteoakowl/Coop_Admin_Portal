<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Announcements' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/registration-windows', icon: 'clock', label: 'Registration' },
      { href: '/main-admin/diplomas', icon: 'badge', label: 'Diplomas' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Announcements</h1>
    <p class="hint">
      Sends a notification to signed-in members - it shows up as an Announcement on their portal home page (Parent
      Portal today). Choose "Public" below to post to the public homepage instead, for anyone, signed in or not.
    </p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/main-admin/announcements" class="stack-form member-form-page-panel">
      <label class="member-form-full">Title
        <input type="text" name="title" placeholder="e.g. Wednesday session cancelled" required />
      </label>
      <div class="member-form-full" data-forum-editor>
        <label>Message</label>
        <%- include('partials/forum-editor-toolbar') %>
        <div class="forum-editable" data-forum-editable contenteditable="true"></div>
        <input type="hidden" name="body" data-forum-body-input />
      </div>
      <label class="member-form-full">Send to
        <select name="roleKey">
          <option value="">Everyone (all active members)</option>
          <% roles.forEach(function(r) { %>
            <option value="<%= r.key %>"><%= r.label %> only</option>
          <% }); %>
          <option value="public">Public (posts to the homepage)</option>
        </select>
      </label>
      <div class="member-form-footer">
        <div class="member-form-footer-edit">
          <button type="submit" class="primary-btn">Send Announcement</button>
        </div>
      </div>
    </form>

    <h2>Recently Sent</h2>
    <% if (sent.length === 0) { %>
      <p class="roster-empty">No announcements sent yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table condensed-table">
          <thead><tr><th>Title</th><th>Message</th><th>Recipients</th><th>Sent</th></tr></thead>
          <tbody>
            <% sent.forEach(function(s) { %>
              <tr>
                <td class="roster-name-col"><%= s.title %></td>
                <td class="forum-editable-display"><%- s.body %></td>
                <td><%= s.recipientCount %></td>
                <td><%= s.created_at %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <%# Relocated from Main Admin > Website - see this page's own hint
        text above. %>
    <h2>Public Homepage Announcements</h2>
    <% if (publicAnnouncements.length === 0) { %>
      <p class="roster-empty">No public announcements yet.</p>
    <% } else { %>
      <div class="site-announcement-list">
        <% publicAnnouncements.forEach(function(a) { %>
          <div class="site-announcement-card">
            <span class="site-announcement-date"><%= a.is_public ? 'Public' : 'Members Only' %></span>
            <h3><%= a.title %></h3>
            <div class="forum-editable-display"><%- a.body %></div>
            <form method="POST" action="/main-admin/website/announcements/<%= a.id %>/delete" data-confirm="Delete this announcement?">
              <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
  <script src="/js/forum-editor.js"></script>
</body>
</html>
