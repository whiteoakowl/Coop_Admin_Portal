<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Parent Portal',
    navLinks: [
      { href: '/parent', icon: 'home', label: 'Home' },
      { href: '/parent/library', icon: 'book', label: 'Library' },
      { href: '/parent/academics', icon: 'clipboard-list', label: 'Academics' },
      { href: '/parent/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/parent/reading', icon: 'book', label: 'Reading Challenge' },
      { href: '/parent/achievements', icon: 'star', label: 'Achievements' },
      { href: '/parent/leaderboard', icon: 'trophy', label: 'Leaderboard' },
    ],
    classLinks: [
      {
        icon: 'graduation-cap',
        label: 'Classes',
        subpages: [
          { href: '/parent/classes', label: 'Class Registration' },
          { href: '/parent/classes/manage', label: 'Manage Classes' },
          { href: '/name-tag', label: 'Name Tag Request' },
          { href: '/absence', label: 'Absence/Late Form' },
          { href: '/parent/handbook', label: 'Policy Handbook' },
        ],
      },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Manage Classes</h1>
    <p class="hint">Your family's current class registrations. To register for a new class, use <a href="/parent/classes">Class Registration</a>.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (!hasChildren) { %>
      <p class="roster-empty">No students are linked to your family yet. Contact an admin if this looks wrong.</p>
    <% } else if (entries.length === 0) { %>
      <p class="roster-empty">No one in your family is registered for a class yet.</p>
    <% } else { %>
      <div class="manage-classes-grid">
        <% entries.forEach(function(entry) { %>
          <div class="manage-class-card">
            <div class="manage-class-card-color-bar" style="background: <%= entry.cls.color %>;"></div>
            <div class="manage-class-card-body">
              <p class="manage-class-card-child"><%= entry.child.name %></p>
              <h3 class="manage-class-card-title"><%= entry.cls.class_name %></h3>
              <p class="manage-class-card-meta"><%= entry.cls.dayLabel %> &middot; <%= entry.cls.timeLabel %></p>
              <p class="manage-class-card-meta"><%= entry.cls.room || 'No room set' %></p>
              <p class="manage-class-card-meta"><%= entry.cls.teacherNames.length ? entry.cls.teacherNames.join(', ') : 'No teacher assigned' %></p>
              <% if (entry.waitlistPosition != null) { %>
                <span class="badge-pill">Waitlisted (#<%= entry.waitlistPosition %>)</span>
              <% } else { %>
                <span class="badge-pill badge-pill-present">Registered</span>
              <% } %>
            </div>
            <% if (entry.cls.allow_cancel) { %>
              <form method="POST" action="/parent/classes/<%= entry.cls.id %>/unregister" class="manage-class-card-actions">
                <input type="hidden" name="studentId" value="<%= entry.child.id %>" />
                <input type="hidden" name="day" value="<%= entry.cls.day %>" />
                <input type="hidden" name="returnTo" value="manage" />
                <button type="submit" class="roster-action-btn roster-action-btn-danger">Cancel</button>
              </form>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
