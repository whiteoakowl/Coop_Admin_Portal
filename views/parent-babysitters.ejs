<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1>Babysitter Directory</h1>
      <% if (children.length > 0) { %>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('babysitter-dialog').showModal()">Add/Edit Babysitters</button>
      <% } %>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (directory.length === 0) { %>
      <p class="roster-empty">No approved babysitter profiles yet.</p>
    <% } else { %>
      <div class="portal-dashboard-grid">
        <% directory.forEach(function(p) { %>
          <section class="portal-dashboard-card">
            <% if (p.photo_key) { %><img src="/babysitters/<%= p.id %>/photo" alt="" class="babysitter-photo-preview" /><% } %>
            <h2><%= p.member_name %></h2>
            <p class="hint"><%= p.age_grade || '' %></p>
            <% if (p.availability) { %><p><strong>Availability:</strong> <%= p.availability %></p><% } %>
            <% if (p.experience) { %><p><strong>Experience:</strong> <%= p.experience %></p><% } %>
            <% if (p.certifications) { %><p><strong>Certifications:</strong> <%= p.certifications %></p><% } %>
            <% if (p.hourly_rate) { %><p><strong>Rate:</strong> <%= p.hourly_rate %></p><% } %>
            <% if (p.contact_method) { %><p><strong>Contact:</strong> <%= p.contact_method %></p><% } %>
          </section>
        <% }); %>
      </div>
    <% } %>
  </main>

  <% if (children.length > 0) { %>
    <dialog id="babysitter-dialog" class="member-picker-dialog dialog-label-stack">
      <form method="POST" action="/parent/babysitters" enctype="multipart/form-data" onsubmit="this.action = '/parent/babysitters/' + this.studentId.value;">
        <h3>Add/Edit Babysitters</h3>
        <p class="hint">Every new profile, and every edit to an existing one, needs Main Admin's approval before it appears in the directory above.</p>
        <label>Student
          <select name="studentId" id="babysitter-student-select" required>
            <% children.forEach(function(child) { %><option value="<%= child.id %>"><%= child.name %></option><% }); %>
          </select>
        </label>
        <label>Age/Grade
          <input type="text" name="ageGrade" id="babysitter-field-ageGrade" placeholder="e.g. 15 / 9th grade" />
        </label>
        <label>Availability
          <textarea name="availability" id="babysitter-field-availability" rows="2" placeholder="e.g. Weekends, evenings after 5pm"></textarea>
        </label>
        <label>Experience
          <textarea name="experience" id="babysitter-field-experience" rows="2" placeholder="Babysitting experience, ages watched, etc."></textarea>
        </label>
        <label>Certifications
          <input type="text" name="certifications" id="babysitter-field-certifications" placeholder="e.g. CPR certified, Red Cross Babysitting Course" />
        </label>
        <label>Hourly Rate
          <input type="text" name="hourlyRate" id="babysitter-field-hourlyRate" placeholder="e.g. $12/hr" />
        </label>
        <label>Contact Method
          <input type="text" name="contactMethod" id="babysitter-field-contactMethod" placeholder="e.g. Text (555) 555-1234" />
        </label>
        <label>Photo <span class="hint">(optional - replaces the current photo, if any)</span>
          <input type="file" name="photo" accept="image/*" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Submit for Review</button>
        </div>
      </form>
    </dialog>
    <script id="babysitter-profile-data" type="application/json"><%- profileDataJson %></script>
    <script src="/js/parent-babysitter-form.js" defer></script>
  <% } %>
</body>
</html>
