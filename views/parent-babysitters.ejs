<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Parent Portal',
    navLinks: [
      { href: '/parent', icon: 'home', label: 'Home' },
      { href: '/parent/library', icon: 'book', label: 'Library' },
      { href: '/parent/academics', icon: 'clipboard-list', label: 'Academics' },
      { href: '/parent/babysitters', icon: 'user', label: 'Babysitters' },
    ],
    classLinks: [
      { href: '/parent/classes', icon: 'graduation-cap', label: 'Classes' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Babysitter Directory</h1>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (children.length > 0) { %>
      <h2>My Children's Profiles</h2>
      <p class="hint">Every new profile, and every edit to an existing one, needs Main Admin's approval before it appears in the directory below.</p>
      <% children.forEach(function(child) { %>
        <% var profile = profileByChildId[child.id]; %>
        <details class="manage-section" <%= children.length === 1 ? 'open' : '' %>>
          <summary>
            <strong><%= child.name %></strong>
            <% if (profile) { %>
              <span class="badge-pill <%= profile.status === 'approved' ? 'badge-pill-present' : profile.status === 'pending' ? 'badge-pill-pending' : 'badge-pill-absent' %>">
                <%= profile.status %>
              </span>
            <% } %>
          </summary>
          <form method="POST" action="/parent/babysitters/<%= child.id %>" enctype="multipart/form-data" class="stack-form member-form-page-panel">
            <label class="member-form-full">Age/Grade
              <input type="text" name="ageGrade" value="<%= profile ? profile.age_grade || '' : '' %>" placeholder="e.g. 15 / 9th grade" />
            </label>
            <label class="member-form-full">Availability
              <textarea name="availability" rows="2" placeholder="e.g. Weekends, evenings after 5pm"><%= profile ? profile.availability || '' : '' %></textarea>
            </label>
            <label class="member-form-full">Experience
              <textarea name="experience" rows="2" placeholder="Babysitting experience, ages watched, etc."><%= profile ? profile.experience || '' : '' %></textarea>
            </label>
            <label class="member-form-full">Certifications
              <input type="text" name="certifications" value="<%= profile ? profile.certifications || '' : '' %>" placeholder="e.g. CPR certified, Red Cross Babysitting Course" />
            </label>
            <label class="member-form-full">Hourly Rate
              <input type="text" name="hourlyRate" value="<%= profile ? profile.hourly_rate || '' : '' %>" placeholder="e.g. $12/hr" />
            </label>
            <label class="member-form-full">Contact Method
              <input type="text" name="contactMethod" value="<%= profile ? profile.contact_method || '' : '' %>" placeholder="e.g. Text (555) 555-1234" />
            </label>
            <label class="member-form-full">Photo
              <% if (profile && profile.photo_key) { %>
                <img src="/babysitters/<%= profile.id %>/photo" alt="" class="babysitter-photo-preview" />
              <% } %>
              <input type="file" name="photo" accept="image/*" />
            </label>
            <div class="member-form-footer">
              <div class="member-form-footer-edit">
                <button type="submit" class="primary-btn"><%= profile ? 'Save Changes' : 'Submit Profile' %></button>
              </div>
            </div>
          </form>
        </details>
      <% }); %>
    <% } %>

    <h2>Directory</h2>
    <% if (directory.length === 0) { %>
      <p class="roster-empty">No approved babysitter profiles yet.</p>
    <% } else { %>
      <div class="portal-dashboard-grid">
        <% directory.forEach(function(p) { %>
          <section class="portal-dashboard-card">
            <% if (p.photo_key) { %><img src="/babysitters/<%= p.id %>/photo" alt="" class="babysitter-photo-preview" /><% } %>
            <h2><%= p.member_name %></h2>
            <p class="hint"><%= p.age_grade || '' %></p>
            <% if (p.availability) { %><p><strong>Availability:</strong> <%= p.availability %></p><% } %>
            <% if (p.experience) { %><p><strong>Experience:</strong> <%= p.experience %></p><% } %>
            <% if (p.certifications) { %><p><strong>Certifications:</strong> <%= p.certifications %></p><% } %>
            <% if (p.hourly_rate) { %><p><strong>Rate:</strong> <%= p.hourly_rate %></p><% } %>
            <% if (p.contact_method) { %><p><strong>Contact:</strong> <%= p.contact_method %></p><% } %>
          </section>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
