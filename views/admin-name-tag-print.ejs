<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main badge-print-main">
    <div class="print-preview-header no-print">
      <h1><%= typeof heading !== 'undefined' && heading ? heading : 'Name Tag' %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <%- include('partials/name-tag-badge', { html: html, bgCss: bgCss, badgeWidth: badgeWidth, badgeHeight: badgeHeight }) %>
    </div>
  </main>
  <script src="/js/vendor/jsbarcode.min.js"></script>
  <script src="/js/name-tag-render.js"></script>
  <script src="/js/print-auto.js"></script>
</body>
</html>
