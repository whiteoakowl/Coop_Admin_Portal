<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Check In/Out Log</p>
      </div>
    </div>
    <div class="roster-toolbar">
      <div>
        <p class="subtitle no-print"><a href="/admin/rosters">&larr; Attendance</a></p>
        <h1>Check In/Out Log</h1>
      </div>
      <div class="roster-btn-row no-print">
        <button type="button" class="roster-action-btn" onclick="window.print()">Print</button>
      </div>
    </div>

    <div class="category-filter no-print">
      <label for="date-select">Date</label>
      <select id="date-select" onchange="window.location = '/admin/checkinout-log' + (this.value ? '?date=' + encodeURIComponent(this.value) : '')">
        <option value="">All dates</option>
        <% dates.forEach(function(d) { %>
          <option value="<%= d.date %>" <%= dateFilter === d.date ? 'selected' : '' %>><%= d.label %></option>
        <% }); %>
      </select>
    </div>

    <div class="roster-scroll">
      <table class="roster-table members-table condensed-table">
        <thead>
          <tr><th>Name</th><th>Roster</th><th>Date</th><th>Check-In Time</th><th>Check-Out Time</th><th>Number</th></tr>
        </thead>
        <tbody>
          <% if (rows.length === 0) { %>
            <tr><td colspan="6" class="roster-empty">No check-ins recorded yet.</td></tr>
          <% } %>
          <% rows.forEach(function(r) { %>
            <tr>
              <td><%= r.memberName %></td>
              <td><%= r.rosterName %></td>
              <td><%= r.dateLabel %></td>
              <td><%= r.checkInTime %></td>
              <td><%= r.checkOutTime %></td>
              <td><%= r.number %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
