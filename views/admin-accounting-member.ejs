<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= member.name %></h1>
      <span class="badge-pill badge-pill-<%= balanceCents > 0 ? 'orange' : 'green' %>"><%= formatCents(balanceCents) %> due</span>
      <% if (member.parked) { %><span class="badge-pill badge-pill-gray" title="Auto-parked: an auto-park invoice is overdue and unpaid">Parked</span><% } %>
    </div>
    <p><a href="/main-admin/accounting">&larr; All Accounts</a></p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (typeof autoprint !== 'undefined' && autoprint) { %>
      <script>window.addEventListener('load', () => window.print());</script>
    <% } %>

    <%# A real request: "filter dropdown to view which account year.
        Current, all or the individual years for accounting." Filters
        all three tables below at once - a plain GET so the page (and
        any Print/Autoprint) always reflects exactly what's in the URL. %>
    <form method="GET" class="roster-btn-row no-print" style="margin-bottom: 1rem;">
      <label>Account Year
        <select name="year" onchange="this.form.submit()">
          <option value="current" <%= yearFilter === 'current' ? 'selected' : '' %>>Current Year</option>
          <option value="all" <%= yearFilter === 'all' ? 'selected' : '' %>>All Years</option>
          <% years.forEach(function(y) { %>
            <option value="<%= y %>" <%= yearFilter === y ? 'selected' : '' %>><%= y %></option>
          <% }); %>
        </select>
      </label>
    </form>

    <div class="manage-section">
      <div class="grid-box-header">
        <h2>Invoices</h2>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-charge-dialog').showModal()">+ Add Charge</button>
      </div>
      <% if (invoices.length === 0) { %>
        <p class="roster-empty">No invoices for this period.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table accounting-table-mobile-fit accounting-table-mobile-fit-tighter">
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Paid</th>
                <th>Status</th>
                <th>Date</th>
                <th></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% invoices.forEach(function(c) { %>
                <tr>
                  <td>#<%= c.id %></td>
                  <td><%= c.description %></td>
                  <td><%= formatCents(c.amount_cents) %></td>
                  <td><%= formatCents(c.amountPaid) %></td>
                  <td><span class="badge-pill badge-pill-<%= c.status === 'paid' ? 'green' : c.status === 'cancelled' || c.status === 'refunded' ? 'gray' : 'orange' %>"><%= c.status.replace('_', ' ') %></span></td>
                  <td><%= c.created_at %></td>
                  <td class="roster-btn-row member-invoice-actions">
                    <% if (c.status !== 'cancelled') { %>
                      <button type="button" class="roster-action-btn roster-action-btn-fit" onclick="document.getElementById('payment-dialog-<%= c.id %>').showModal()">Record Payment</button>
                      <form method="POST" action="/main-admin/accounting/charges/<%= c.id %>/cancel" class="inline-block-form" data-confirm="Cancel this charge?">
                        <button type="submit" class="roster-action-btn roster-action-btn-danger roster-action-btn-fit">Cancel</button>
                      </form>
                    <% } %>
                  </td>
                  <td class="roster-btn-row accounting-row-icons">
                    <a class="icon-btn" href="/main-admin/accounting/invoices/<%= c.id %>/edit" aria-label="Edit invoice #<%= c.id %>" title="Edit"><svg class="icon"><use href="#icon-edit"/></svg></a>
                    <form method="POST" action="/main-admin/accounting/invoices/<%= c.id %>/delete" class="inline-block-form" data-confirm="Delete invoice #<%= c.id %>? This also removes any payments recorded against it.">
                      <input type="hidden" name="back" value="member" />
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete invoice #<%= c.id %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Payments</h2></div>
      <% if (paymentRows.length === 0) { %>
        <p class="roster-empty">No payments for this period.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table accounting-table-mobile-fit accounting-table-mobile-fit-tighter">
            <thead>
              <tr>
                <th>For</th>
                <th>Amount</th>
                <th>Note</th>
                <th>Date</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% paymentRows.forEach(function(p) { %>
                <tr>
                  <td><%= p.chargeDescription %></td>
                  <td><%= formatCents(p.amount_cents) %></td>
                  <td><%= p.note || '' %></td>
                  <td><%= p.created_at %></td>
                  <td>
                    <form method="POST" action="/main-admin/accounting/payments/<%= p.id %>/delete" class="inline-block-form" data-confirm="Delete this payment of <%= formatCents(p.amount_cents) %>?">
                      <input type="hidden" name="back" value="member" />
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete payment" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Adjustments, Credits &amp; Refunds</h2></div>
      <% if (refundRows.length === 0 && cancelledCharges.length === 0) { %>
        <p class="roster-empty">No adjustments for this period.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table accounting-table-mobile-fit accounting-table-mobile-fit-tighter">
            <thead>
              <tr>
                <th>Type</th>
                <th>For</th>
                <th>Amount</th>
                <th>Date</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% refundRows.forEach(function(p) { %>
                <tr>
                  <td><span class="badge-pill badge-pill-gray"><%= p.adjustment_type ? p.adjustment_type.charAt(0).toUpperCase() + p.adjustment_type.slice(1) : 'Refund' %></span></td>
                  <td><%= p.chargeDescription %></td>
                  <td><%= formatCents(p.amount_cents) %></td>
                  <td><%= p.created_at %></td>
                  <td>
                    <form method="POST" action="/main-admin/accounting/payments/<%= p.id %>/delete" class="inline-block-form" data-confirm="Delete this refund of <%= formatCents(Math.abs(p.amount_cents)) %>?">
                      <input type="hidden" name="back" value="member" />
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete refund" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
              <% cancelledCharges.forEach(function(c) { %>
                <tr>
                  <td><span class="badge-pill badge-pill-gray">Cancelled Charge</span></td>
                  <td><%= c.description %></td>
                  <td><%= formatCents(c.amount_cents) %></td>
                  <td><%= c.created_at %></td>
                  <td>
                    <form method="POST" action="/main-admin/accounting/invoices/<%= c.id %>/delete" class="inline-block-form" data-confirm="Delete this cancelled charge?">
                      <input type="hidden" name="back" value="member" />
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete cancelled charge" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <dialog id="add-charge-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/accounting/members/<%= member.id %>/charges">
        <h3>Add Charge</h3>
        <label>Description
          <input type="text" name="description" placeholder="e.g. Registration Fee" required />
        </label>
        <label>Amount ($)
          <input type="number" name="amount" min="0.01" step="0.01" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <% invoices.forEach(function(c) { %>
      <% if (c.status !== 'cancelled') { %>
        <dialog id="payment-dialog-<%= c.id %>" class="member-picker-dialog">
          <form method="POST" action="/main-admin/accounting/charges/<%= c.id %>/payments" data-toggle-form>
            <h3>Record Payment &mdash; <%= c.description %></h3>
            <label>Direction
              <select name="direction" data-toggle-select>
                <option value="payment">Payment received</option>
                <option value="refund">Refund issued</option>
              </select>
            </label>
            <%# A real request: "accounting adjustment categories refund,
                exemption, credit, discount" - only meaningful once
                Direction above is "Refund issued"; data-toggle-select/
                data-toggle-field (public/js/lesson-content-form.js's own
                generic field-visibility toggle, reused here) hides this
                field entirely for a plain payment. %>
            <label data-toggle-field="refund" style="display: none;">Adjustment Type
              <select name="adjustmentType">
                <option value="refund">Refund</option>
                <option value="exemption">Exemption</option>
                <option value="credit">Credit</option>
                <option value="discount">Discount</option>
              </select>
            </label>
            <label>Amount ($)
              <input type="number" name="amount" min="0.01" step="0.01" required />
            </label>
            <label>Method
              <select name="method">
                <% methods.forEach(function(meth) { %><option value="<%= meth %>"><%= meth %></option><% }); %>
              </select>
            </label>
            <label>Note
              <input type="text" name="note" placeholder="e.g. Check #123, Venmo @handle" />
            </label>
            <div class="notes-dialog-actions">
              <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
              <button type="submit" class="primary-btn">Record</button>
            </div>
          </form>
        </dialog>
      <% } %>
    <% }); %>
  </main>
  <script src="/js/lesson-content-form.js"></script>
</body>
</html>
