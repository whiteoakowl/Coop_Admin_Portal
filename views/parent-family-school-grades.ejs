<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/parent/family-school">&larr; Family School Management</a></p>
    <div class="roster-toolbar no-print">
      <h1>Family Grades</h1>
    </div>

    <%# "Add the following buttons to each page. Export, print, download,
        filter. Make sure they are the similar size, same height, fit to
        text." Same restructure as Family Attendance's own toolbar - see
        that view's comment. Export is this one selected student's
        grades; Download is every family student's - see routes/parent-
        family-school.js's own /grades/export.csv and /grades/download.csv. %>
    <% if (familyStudents.length > 0) { %>
      <div class="roster-btn-row roster-btn-row-fit-text no-print">
        <a class="icon-btn" href="/parent/family-school/grades/export.csv?studentId=<%= selectedStudentId %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <button type="button" class="icon-btn" onclick="window.print()" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></button>
        <a class="icon-btn" href="/parent/family-school/grades/download.csv" aria-label="Download CSV" title="Download CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <details class="filter-details">
          <summary class="roster-action-btn">Filter</summary>
          <form method="GET" action="/parent/family-school/grades" class="filter-panel">
            <label for="grades-student-select">Student</label>
            <select id="grades-student-select" name="studentId" onchange="this.form.submit()">
              <% familyStudents.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= selectedStudentId === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }); %>
            </select>
          </form>
        </details>
      </div>
    <% } %>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (familyStudents.length === 0) { %>
      <p class="roster-empty">No students in your family yet.</p>
    <% } else if (grades.length === 0) { %>
      <p class="roster-empty">No gradable assignments yet. Add an "Assignment (student uploads work back)" content item to a lesson to see it here.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table table-stack-mobile">
          <thead>
            <tr><th>Class</th><th>Lesson</th><th>Assignment</th><th>Due</th><th>Submitted</th><th>Grade</th></tr>
          </thead>
          <tbody>
            <% grades.forEach(function(g) { %>
              <tr>
                <td data-label="Class" class="table-stack-heading"><%= g.class_name %></td>
                <td data-label="Lesson"><%= g.lesson_title %></td>
                <td data-label="Assignment"><%= g.item_title || '(untitled)' %><% if (g.points_possible != null) { %> <span class="hint">(<%= g.points_possible %> pts)</span><% } %></td>
                <td data-label="Due"><%= g.dueDateLabel || '—' %></td>
                <td data-label="Submitted"><%= g.submission_id ? 'Yes' : 'Not yet' %></td>
                <td data-label="Grade" class="table-stack-full">
                  <% if (!g.submission_id) { %>
                    <span class="hint">Nothing submitted yet</span>
                  <% } else { %>
                    <form method="POST" action="/parent/family-school/grades/<%= g.content_item_id %>/<%= selectedStudentId %>" class="member-form-grid">
                      <label>Points Earned
                        <input type="number" name="pointsEarned" min="0" step="0.01" value="<%= g.points_earned != null ? g.points_earned : '' %>" />
                      </label>
                      <label>Letter/Percent Grade
                        <input type="text" name="gradeLetter" value="<%= g.grade_letter || '' %>" placeholder="e.g. A-, 92%" />
                      </label>
                      <label class="member-form-full">Feedback
                        <textarea name="feedback" rows="2"><%= g.feedback || '' %></textarea>
                      </label>
                      <div class="member-form-full">
                        <button type="submit" class="roster-action-btn">Save Grade</button>
                      </div>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
