<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Teacher Portal',
    navLinks: [
      { href: '/teacher', icon: 'home', label: 'Home' },
      { href: '/teacher/attendance', icon: 'calendar-check', label: 'Attendance' },
      { href: '/teacher/classes', icon: 'graduation-cap', label: 'Classes' },
      { href: '/forums', icon: 'users', label: 'Chat' },
      { href: '/training', icon: 'graduation-cap', label: 'Training' },
      { href: '/teacher/assignments', icon: 'clipboard-list', label: 'Assignments' },
      { href: '/forums', icon: 'mail', label: 'Messages' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Assignments</h1>
    <p class="hint">Every assignment across your classes. Add new ones from a class's own roster page.</p>

    <% if (assignmentsByClass.length === 0) { %>
      <p class="roster-empty">You're not staffed on any classes yet.</p>
    <% } else { %>
      <% assignmentsByClass.forEach(function(group) { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2><%= group.cls.class_name %></h2>
            <a class="roster-action-btn" href="/teacher/classes/<%= group.cls.id %>">View Roster</a>
          </div>
          <% if (group.assignments.length === 0) { %>
            <p class="roster-empty">No assignments yet.</p>
          <% } else { %>
            <div class="training-lesson-list">
              <% group.assignments.forEach(function(a) { %>
                <div class="training-lesson-row">
                  <div class="training-lesson-row-main">
                    <svg class="icon"><use href="#icon-clipboard-list"/></svg>
                    <div class="training-lesson-info">
                      <strong><%= a.title %></strong>
                      <span class="hint">
                        <% if (a.dueDateLabel) { %>Due <%= a.dueDateLabel %><% } else { %>No due date<% } %>
                        <% if (a.points_possible) { %> &middot; <%= a.points_possible %> points<% } %>
                      </span>
                    </div>
                    <a class="roster-action-btn" href="/teacher/assignments/<%= a.id %>">Grade</a>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </main>
</body>
</html>
