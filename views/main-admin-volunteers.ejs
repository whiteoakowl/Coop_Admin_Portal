<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1><%= activeTab === 'signup-lists' ? 'Sign-Up Lists' : activeTab === 'volunteer-lists' ? 'Volunteer Lists' : 'Committees' %></h1>

    <%# A real request: "instead of the tabs on each page, make them
        subpages under each menu tab" (desktop, see views/partials/
        portal-nav.ejs) / "when you click the tab below a menu will pop
        up" (mobile, see public/js/page-tabs.js) - same tab links either
        way, just moved out of this inline strip. %>
    <%# Committees/Sign-Up Lists/Volunteer Lists now live as subpages
        under the orange bar's own Volunteers item (views/partials/
        portal-nav.ejs) instead of a trigger+dialog here. %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (activeTab === 'committees') { %>
      <%# A real request: "add committee button shrink to fit to text, on
          the same row add an export, pdf and print icon" - same roster-
          btn-row-fit-text/roster-action-btn-fit + icon-btn Export/PDF/
          Print group already used on the per-committee detail page
          (views/main-admin-committee-detail.ejs's own grid-box-header),
          just reused here for the committee list as a whole (routes/
          main-admin-volunteers.js's own GET /committees/print,
          /committees/download.pdf, /committees/export.csv). %>
      <div class="grid-box-header">
        <h2>Committees</h2>
        <div class="roster-btn-row roster-btn-row-fit-text">
          <button type="button" class="roster-action-btn roster-action-btn-fit" onclick="document.getElementById('add-committee-dialog').showModal()">+ Add Committee</button>
        </div>
        <div class="roster-btn-row">
          <a class="icon-btn roster-action-btn-fit" href="/main-admin/volunteers/committees/print" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
          <a class="icon-btn roster-action-btn-fit" href="/main-admin/volunteers/committees/download.pdf" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
          <a class="icon-btn roster-action-btn-fit" href="/main-admin/volunteers/committees/export.csv" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        </div>
      </div>

      <% if (committees.length === 0) { %>
        <p class="roster-empty">No committees yet &mdash; add one above.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table committees-table">
            <thead><tr><th>Name</th><th>Leader</th><th>Volunteers</th><th>Enabled</th><th></th></tr></thead>
            <tbody>
              <% committees.forEach(function(c) { %>
                <tr>
                  <td class="roster-name-col"><a href="/main-admin/volunteers/committees/<%= c.id %>"><%= c.name %></a></td>
                  <td><%= c.leaderName || '—' %></td>
                  <td><%= c.signupCount %></td>
                  <td>
                    <form method="POST" action="/main-admin/volunteers/committees/<%= c.id %>/enabled" class="inline-block-form">
                      <input type="hidden" name="enabled" value="<%= c.enabled ? '0' : '1' %>" />
                      <label class="checkbox-option">
                        <input type="checkbox" onchange="this.form.requestSubmit()" <%= c.enabled ? 'checked' : '' %> />
                      </label>
                    </form>
                  </td>
                  <td>
                    <%# A real request: "edit and trash button should fit
                        properly in their bubble button colors" - the
                        base .roster-action-btn's flex:1 0 auto/min-width
                        was stretching both buttons evenly across the
                        row, leaving the trash icon floating in an
                        oversized pill. roster-btn-row-nowrap sizes every
                        child to its own content instead, and the trash
                        action switches to the small icon-only button
                        every other delete action in the app already
                        uses. %>
                    <div class="roster-btn-row roster-btn-row-nowrap">
                      <a class="roster-action-btn roster-action-btn-fit" href="/main-admin/volunteers/committees/<%= c.id %>">Edit</a>
                      <form method="POST" action="/main-admin/volunteers/committees/<%= c.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= c.name %>&quot;? This cannot be undone.">
                        <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= c.name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <dialog id="add-committee-dialog" class="member-picker-dialog">
        <%# A real request: "the pop up there should be adequate space
            between titles, text bars and buttons." Same .stack-form fix
            as views/parent-family-school-classes.ejs's own add-class-
            dialog (that comment explains it in full): .member-picker-
            dialog's own label spacing alone (display:block; margin-
            bottom:0.5rem) read as cramped next to this dialog's sibling
            Add Sign-Up/Volunteer List dialogs further down, which already
            layer .stack-form's own margin-top:0.75rem between rows and
            .notes-dialog-actions' own margin-top on top of that. %>
        <form method="POST" action="/main-admin/volunteers/committees" class="stack-form">
          <h3>Add Committee</h3>
          <label>Name
            <input type="text" name="name" required />
          </label>
          <label>Description
            <textarea name="description" rows="3"></textarea>
          </label>
          <%# A real request: "adding a leader should be a drop down list
              of admin positions. Choose an admin and the leaders name and
              email address appears below," with a single leader per
              committee - one <option> per current position holder
              (grouped under their own position via <optgroup>), not one
              option per position title, since a position can be held by
              more than one person and only one of them ends up "the
              leader" here. public/js/committee-leader-picker.js echoes
              the picked option's own name/email into the readout below. %>
          <div class="committee-leader-picker">
            <label>Leader
              <select name="leaderMemberId" class="committee-leader-select">
                <option value="">No leader</option>
                <% leaderPositions.forEach(function(p) { %>
                  <% if (leaderPositionMembers[p.id] && leaderPositionMembers[p.id].length) { %>
                    <optgroup label="<%= p.title %>">
                      <% leaderPositionMembers[p.id].forEach(function(m) { %>
                        <option value="<%= m.id %>" data-email="<%= m.email || '' %>"><%= m.name %></option>
                      <% }); %>
                    </optgroup>
                  <% } %>
                <% }); %>
              </select>
            </label>
            <p class="hint committee-leader-email"></p>
          </div>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Create</button>
          </div>
        </form>
      </dialog>
      <script src="/js/committee-leader-picker.js"></script>
    <% } else if (activeTab === 'signup-lists') { %>
      <%# A real request: "add list button should fit to text, on the
          same row add import, pdf and print icons." Same roster-btn-row-
          fit-text/roster-action-btn-fit + icon-btn group as Committees'
          own toolbar above; Import is a new capability (no existing
          bulk-create-sign-up-lists route to reuse) - same plain upload-
          and-append pattern as routes/admin-misc-badges.js's own Import
          (routes/main-admin-volunteers.js's own POST /signup-lists/
          import), PDF/Print mirror the per-list detail page's own
          download.pdf/print routes, just for the list as a whole. %>
      <div class="grid-box-header">
        <h2>Sign-Up Lists</h2>
        <div class="roster-btn-row roster-btn-row-fit-text">
          <button type="button" class="roster-action-btn roster-action-btn-fit" onclick="document.getElementById('add-signup-list-dialog').showModal()">+ Add List</button>
        </div>
        <div class="roster-btn-row">
          <button type="button" class="icon-btn roster-action-btn-fit" onclick="document.getElementById('signup-lists-import-dialog').showModal()" aria-label="Import" title="Import"><svg class="icon"><use href="#icon-upload"/></svg></button>
          <a class="icon-btn roster-action-btn-fit" href="/main-admin/volunteers/signup-lists/download.pdf" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
          <a class="icon-btn roster-action-btn-fit" href="/main-admin/volunteers/signup-lists/print" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
        </div>
      </div>

      <dialog id="signup-lists-import-dialog" class="member-picker-dialog">
        <form method="POST" action="/main-admin/volunteers/signup-lists/import" enctype="multipart/form-data">
          <h3>Import Sign-Up Lists</h3>
          <a class="btn-secondary import-sample-link" href="/main-admin/volunteers/signup-lists/import-template.xlsx">Download Sample File</a>
          <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Import</button>
          </div>
        </form>
      </dialog>
      <% if (signUpLists.length === 0) { %>
        <p class="roster-empty">No sign-up lists yet &mdash; add one above.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table committees-table">
            <thead><tr><th>Title</th><th>Event</th><th>Enabled</th><th></th></tr></thead>
            <tbody>
              <% signUpLists.forEach(function(l) { %>
                <tr>
                  <td class="roster-name-col"><a href="/main-admin/volunteers/signup-lists/<%= l.id %>"><%= l.title %></a></td>
                  <td><%= l.eventTitle || '—' %></td>
                  <td>
                    <%# A real request: "add enable column with check box
                        next to each signup list on the table... removed
                        disable signups button in edit because now we
                        have an enable check box on the list page next
                        to each list." Same pattern as Committees' own
                        Enabled checkbox. %>
                    <form method="POST" action="/main-admin/volunteers/signup-lists/<%= l.id %>/enabled" class="inline-block-form">
                      <input type="hidden" name="enabled" value="<%= l.is_open ? '0' : '1' %>" />
                      <label class="checkbox-option">
                        <input type="checkbox" onchange="this.form.requestSubmit()" <%= l.is_open ? 'checked' : '' %> />
                      </label>
                    </form>
                  </td>
                  <td>
                    <div class="roster-btn-row roster-btn-row-nowrap">
                      <form method="POST" action="/main-admin/volunteers/signup-lists/<%= l.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= l.title %>&quot;? This cannot be undone.">
                        <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= l.title %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <dialog id="add-signup-list-dialog" class="member-picker-dialog dialog-label-stack">
        <form method="POST" action="/main-admin/volunteers/signup-lists">
          <h3>Add Sign-Up List</h3>
          <label>Title
            <input type="text" name="title" required />
          </label>
          <label>Description
            <textarea name="description" rows="3"></textarea>
          </label>
          <label><span>Attach to Event <span class="hint">(optional)</span></span>
            <select name="eventId">
              <option value="">None</option>
              <% events.forEach(function(e) { %><option value="<%= e.id %>"><%= e.title %></option><% }); %>
            </select>
          </label>
          <label><span>Attach to Member <span class="hint">(optional)</span></span>
            <select name="memberId">
              <option value="">None</option>
              <% memberOptions.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
            </select>
          </label>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Create</button>
          </div>
        </form>
      </dialog>
    <% } else { %>
      <div class="grid-box-header">
        <h2>Volunteer Lists</h2>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-volunteer-list-dialog').showModal()">+ Add List</button>
      </div>
      <% if (volunteerLists.length === 0) { %>
        <p class="roster-empty">No volunteer lists yet &mdash; add one above.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table committees-table">
            <thead><tr><th>Title</th><th>Event</th><th>Enabled</th><th></th></tr></thead>
            <tbody>
              <% volunteerLists.forEach(function(l) { %>
                <tr>
                  <td class="roster-name-col"><a href="/main-admin/volunteers/volunteer-lists/<%= l.id %>"><%= l.title %></a></td>
                  <td><%= l.eventTitle || '—' %></td>
                  <td>
                    <%# Same Enabled-checkbox pattern as Sign-Up Lists
                        above - a real request: "same for volunteer
                        lists page." %>
                    <form method="POST" action="/main-admin/volunteers/volunteer-lists/<%= l.id %>/enabled" class="inline-block-form">
                      <input type="hidden" name="enabled" value="<%= l.is_open ? '0' : '1' %>" />
                      <label class="checkbox-option">
                        <input type="checkbox" onchange="this.form.requestSubmit()" <%= l.is_open ? 'checked' : '' %> />
                      </label>
                    </form>
                  </td>
                  <td>
                    <div class="roster-btn-row roster-btn-row-nowrap">
                      <form method="POST" action="/main-admin/volunteers/volunteer-lists/<%= l.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= l.title %>&quot;? This cannot be undone.">
                        <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= l.title %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <dialog id="add-volunteer-list-dialog" class="member-picker-dialog dialog-label-stack">
        <form method="POST" action="/main-admin/volunteers/volunteer-lists">
          <h3>Add Volunteer List</h3>
          <label>Title
            <input type="text" name="title" required />
          </label>
          <label>Description
            <textarea name="description" rows="3"></textarea>
          </label>
          <label><span>Attach to Event <span class="hint">(optional)</span></span>
            <select name="eventId">
              <option value="">None</option>
              <% events.forEach(function(e) { %><option value="<%= e.id %>"><%= e.title %></option><% }); %>
            </select>
          </label>
          <label><span>Attach to Member <span class="hint">(optional)</span></span>
            <select name="memberId">
              <option value="">None</option>
              <% memberOptions.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
            </select>
          </label>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Create</button>
          </div>
        </form>
      </dialog>
    <% } %>
  </main>
</body>
</html>
