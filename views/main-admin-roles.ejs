<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%- include('partials/main-admin-settings-tabs', { activeSettingsTab: 'roles' }) %>
    <h1>Roles &amp; Permissions</h1>
    <p class="hint">Each role grants access to its own portal, plus whichever capabilities are checked below. Main Admin's own permissions are locked to everything - it's the platform's control center.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="main-admin-role-list">
      <% roles.forEach(function(role) { %>
        <section class="portal-dashboard-card">
          <% if (role.key === 'main_admin') { %>
            <h2><%= role.label %> <span class="hint">&middot; portal key: <%= role.key %></span></h2>
            <p class="hint">Main Admin always has every permission.</p>
          <% } else { %>
            <h2>
              <button type="button" class="member-name-link" onclick="document.getElementById('role-permissions-dialog-<%= role.id %>').showModal()"><%= role.label %></button>
              <span class="hint">&middot; portal key: <%= role.key %></span>
            </h2>

            <dialog id="role-permissions-dialog-<%= role.id %>" class="member-picker-dialog role-permissions-dialog">
              <form method="POST" action="/main-admin/roles/<%= role.id %>/permissions">
                <h3><%= role.label %> Permissions</h3>
                <div class="permission-checkbox-grid">
                  <% permissions.forEach(function(perm) { %>
                    <label class="checkbox-option" title="<%= perm.description || '' %>">
                      <input type="checkbox" name="permissionIds" value="<%= perm.id %>" <%= grantedKey.indexOf(role.id + ':' + perm.id) !== -1 ? 'checked' : '' %> />
                      <%= perm.label %>
                    </label>
                  <% }); %>
                </div>
                <div class="notes-dialog-actions">
                  <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                  <button type="submit" class="primary-btn">Save</button>
                </div>
              </form>
            </dialog>
          <% } %>
        </section>
      <% }); %>
    </div>
  </main>
</body>
</html>
