<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Member Directory',
    navLinks: [
      { href: '/portal', icon: 'home', label: 'My Portals' },
      { href: '/member-directory', icon: 'users', label: 'Directory' },
      { href: '/member-directory/mine', icon: 'lock', label: 'My Privacy' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p><a href="/member-directory">&larr; All Members</a></p>

    <% if (member.photoUrl) { %>
      <img src="<%= member.photoUrl %>" alt="" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin-bottom: 1rem;" />
    <% } %>

    <h1><%= member.name %></h1>
    <% if (member.familyName) { %><p class="hint"><%= member.familyName %> family</p><% } %>
    <% if (member.gradeLevel) { %><p class="hint">Grade <%= member.gradeLevel %></p><% } %>
    <% if (member.phone) { %><p><svg class="icon"><use href="#icon-phone"/></svg> <%= member.phone %></p><% } %>
    <% if (member.email) { %><p><svg class="icon"><use href="#icon-mail"/></svg> <%= member.email %></p><% } %>
    <% if (member.address) { %><p><svg class="icon"><use href="#icon-map-pin"/></svg> <%= member.address %></p><% } %>
  </main>
</body>
</html>
