<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Rosters</h1>
    <p class="subtitle">Create as many rosters as you need. Each roster has its own title, dates, and member list.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <details class="add-member-details">
      <summary class="btn-primary-summary">+ New Roster</summary>
      <form method="POST" action="/admin/rosters" enctype="multipart/form-data" class="inline-form">
        <div class="inline-form-row">
          <label>
            Roster Title
            <input type="text" name="name" placeholder="e.g. Wednesday Youth" required />
          </label>
          <label>
            Category <span class="hint">(optional)</span>
            <input type="text" name="category" list="category-options" placeholder="e.g. Youth, Adults, Sports" />
            <datalist id="category-options">
              <% categories.forEach(function(c) { %><option value="<%= c %>"></option><% }); %>
            </datalist>
          </label>
        </div>

        <label class="roster-checkbox-label">Session Dates</label>
        <div class="date-list-wrap">
          <div class="date-list">
            <div class="date-list-row">
              <input type="date" name="dates" />
              <button type="button" class="date-list-remove" aria-label="Remove date">&times;</button>
            </div>
          </div>
          <button type="button" class="btn-secondary date-list-add">+ Add another date</button>
        </div>

        <label class="roster-checkbox-label">Import Member Names <span class="hint">(optional &mdash; one name per line)</span></label>
        <input type="file" name="file" accept=".csv,.txt" />

        <button type="submit" class="primary-btn">Create Roster</button>
      </form>
    </details>

    <div class="category-filter">
      <label for="category-select">Filter by category</label>
      <select id="category-select" onchange="window.location = this.value ? '/admin/rosters?category=' + encodeURIComponent(this.value) : '/admin/rosters'">
        <option value="">All categories</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c %>" <%= selectedCategory === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </div>

    <div class="admin-card-grid">
      <% rosters.forEach(function(r) { %>
        <div class="admin-card roster-card <%= r.active ? '' : 'row-inactive' %>">
          <div class="roster-card-top">
            <strong><%= r.name %></strong>
            <% if (r.category) { %><span class="badge-pill"><%= r.category %></span><% } %>
          </div>
          <div class="roster-card-meta">
            <%= r.memberCount %> member<%= r.memberCount === 1 ? '' : 's' %> &middot;
            <%= r.dateCount %> date<%= r.dateCount === 1 ? '' : 's' %><%= r.active ? '' : ' &middot; archived' %>
          </div>
          <div class="roster-card-actions">
            <a class="link-btn" href="/admin/roster/<%= r.id %>">View Roster</a>
            <a class="link-btn" href="/admin/rosters/<%= r.id %>/manage">Manage</a>
            <form method="POST" action="/admin/rosters/<%= r.id %>/toggle-active" class="inline-block-form">
              <button type="submit" class="link-btn"><%= r.active ? 'Archive' : 'Unarchive' %></button>
            </form>
            <form method="POST" action="/admin/rosters/<%= r.id %>/delete" class="inline-block-form" onsubmit="return confirm('Permanently delete &quot;<%= r.name %>&quot; and all its attendance history? This cannot be undone.');">
              <button type="submit" class="link-btn link-btn-danger">Delete</button>
            </form>
          </div>
        </div>
      <% }); %>
      <% if (rosters.length === 0) { %>
        <p class="hint">No rosters yet<%= selectedCategory ? ' in this category' : '' %>.</p>
      <% } %>
    </div>
  </main>
  <script src="/js/date-list.js"></script>
</body>
</html>
