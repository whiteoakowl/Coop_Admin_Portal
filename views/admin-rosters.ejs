<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.4in; }</style>
</head>
<body class="admin-page roster-view-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= view === 'classList' ? 'Class Rosters' : view === 'archive' ? 'Attendance Archive' : view === 'playgroundList' ? 'Playground' : view === 'playgroundLog' ? `${pgDayLabel} Playground — ${pgHourLabel}` : tabLabel %> &mdash; Attendance Spreadsheet</p>
      </div>
    </div>
    <h1>Attendance</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="view-tabs no-print">
      <a class="view-tab<%= topTab === 'monday' ? ' active' : '' %>" href="/admin/rosters?tab=monday-student">Monday</a>
      <a class="view-tab<%= topTab === 'wednesday' ? ' active' : '' %>" href="/admin/rosters?tab=wednesday-student">Wednesday</a>
      <a class="view-tab<%= topTab === 'classes' ? ' active' : '' %>" href="/admin/rosters?tab=classes">Classes</a>
      <a class="view-tab<%= topTab === 'playground' ? ' active' : '' %>" href="/admin/rosters?tab=playground">Playground</a>
      <a class="view-tab<%= topTab === 'archive' ? ' active' : '' %>" href="/admin/rosters?tab=archive">Archive</a>
    </div>

    <% if (view === 'classList') { %>
      <div class="view-tab-panel">
        <div class="roster-toolbar no-print">
          <div class="category-filter" style="margin: 0;">
            <label for="class-roster-day-select">Day</label>
            <%# Each filter's onchange rebuilds the URL from BOTH selects'
                current values, not just its own - so picking an Hour
                keeps whatever Day is already chosen, and vice versa
                (either filter, or both together). %>
            <select id="class-roster-day-select" onchange="window.location = '/admin/rosters?tab=classes' + (this.value ? '&day=' + this.value : '') + (document.getElementById('class-roster-hour-select').value ? '&hour=' + document.getElementById('class-roster-hour-select').value : '')">
              <option value="" <%= !dayFilter ? 'selected' : '' %>>Monday &amp; Wednesday</option>
              <option value="monday" <%= dayFilter === 'monday' ? 'selected' : '' %>>Monday</option>
              <option value="wednesday" <%= dayFilter === 'wednesday' ? 'selected' : '' %>>Wednesday</option>
            </select>
          </div>
          <div class="category-filter" style="margin: 0;">
            <label for="class-roster-hour-select">Hour</label>
            <select id="class-roster-hour-select" onchange="window.location = '/admin/rosters?tab=classes' + (document.getElementById('class-roster-day-select').value ? '&day=' + document.getElementById('class-roster-day-select').value : '') + (this.value ? '&hour=' + this.value : '')">
              <option value="" <%= !hourFilter ? 'selected' : '' %>>All Hours</option>
              <% hourPositions.forEach(function(h) { %>
                <option value="<%= h %>" <%= hourFilter === h ? 'selected' : '' %>>Hour <%= h %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <% if (classes.length === 0) { %>
          <p class="roster-empty">No classes yet &mdash; add one on the <a href="/admin/schedule">Schedules</a> page.</p>
        <% } else { %>
          <div class="class-roster-list">
            <% classes.forEach(function(c) { %>
              <a class="class-roster-row-btn" href="/admin/rosters?tab=class-<%= c.id %>" style="border-left: 5px solid <%= c.color %>;">
                <span class="class-roster-row-name"><%= c.class_name %></span>
                <span class="class-roster-row-meta">
                  <% if (c.gradeLabel) { %><span><%= c.gradeLabel %></span><% } %>
                  <span><%= c.dayLabel %></span>
                  <span><%= c.timeLabel %></span>
                  <span>Teacher: <%= c.teacherNames.length ? c.teacherNames.join(', ') : '—' %></span>
                  <% if (c.assistantNames.length > 0) { %><span>Assistant: <%= c.assistantNames.join(', ') %></span><% } %>
                </span>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    <% } else if (view === 'playgroundList') { %>
      <div class="view-tab-panel">
        <p class="hint">Anybody can check in and out of the playground &mdash; there's no fixed roster. Pick an hour to see who's checked in and out for a session date.</p>
        <% [['monday', 'Monday'], ['wednesday', 'Wednesday']].forEach(function(pair) { %>
          <h3 class="class-schedule-hour-label"><%= pair[1] %></h3>
          <div class="class-roster-list">
            <% playgroundEntries.filter(function(e) { return e.day === pair[0]; }).forEach(function(e) { %>
              <a class="class-roster-row-btn" href="/admin/rosters?tab=playground-<%= e.day %>-<%= e.hour %>">
                <span class="class-roster-row-name"><%= e.hourLabel %></span>
                <span class="class-roster-row-meta"><span><%= e.dayLabel %> Playground</span></span>
              </a>
            <% }); %>
          </div>
        <% }); %>
      </div>
    <% } else if (view === 'playgroundLog') { %>
      <div class="view-tab-panel">
        <p class="subtitle no-print"><a href="/admin/rosters?tab=playground">&larr; All Playground Hours</a></p>
        <div class="roster-toolbar no-print">
          <div class="category-filter" style="margin: 0;">
            <label for="playground-date-select">Session Date</label>
            <select id="playground-date-select" onchange="window.location = '/admin/rosters?tab=playground-<%= pgDay %>-<%= pgHour %>' + (this.value ? '&date=' + this.value : '')">
              <% if (pgDates.length === 0) { %>
                <option value="">No session dates yet</option>
              <% } %>
              <% pgDates.forEach(function(d) { %>
                <option value="<%= d.date %>" <%= d.date === selectedDate ? 'selected' : '' %>><%= d.label %></option>
              <% }); %>
            </select>
          </div>
          <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
        </div>

        <div class="grid-box roster-grid-col">
          <div class="grid-box-header">
            <h2><%= pgDayLabel %> Playground &mdash; <%= pgHourLabel %></h2>
          </div>
          <div class="roster-scroll">
            <table class="roster-table roster-table-detailed">
              <thead>
                <tr>
                  <th class="roster-name-col">Name</th>
                  <th>Checked In</th>
                  <th>Checked Out</th>
                </tr>
              </thead>
              <tbody>
                <% if (!selectedDate) { %>
                  <tr><td colspan="3" class="roster-empty">No session dates yet for <%= pgDayLabel %> &mdash; add one under the <%= pgDayLabel %> Student roster's Edit Dates.</td></tr>
                <% } else if (log.length === 0) { %>
                  <tr><td colspan="3" class="roster-empty">Nobody has checked in to the playground on <%= selectedDateLabel %> yet.</td></tr>
                <% } %>
                <% log.forEach(function(row) { %>
                  <tr>
                    <td class="roster-name-col"><%= row.name %></td>
                    <td><%= row.checkInTime || '—' %></td>
                    <td><%= row.checkOutTime || '—' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } else if (view === 'archive') { %>
      <div class="view-tab-panel">
        <div class="roster-toolbar no-print">
          <div class="category-filter" style="margin: 0;">
            <label for="roster-archive-day-select">Day</label>
            <select id="roster-archive-day-select" onchange="window.location = '/admin/rosters?tab=archive' + (this.value ? '&day=' + this.value : '')">
              <option value="" <%= !dayFilter ? 'selected' : '' %>>Monday &amp; Wednesday</option>
              <option value="monday" <%= dayFilter === 'monday' ? 'selected' : '' %>>Monday</option>
              <option value="wednesday" <%= dayFilter === 'wednesday' ? 'selected' : '' %>>Wednesday</option>
            </select>
          </div>
        </div>
        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table">
            <thead>
              <tr>
                <th>Archived</th>
                <th>Day</th>
                <th>Session Dates</th>
                <th>Parents</th>
                <th>Students</th>
                <th>Classes</th>
              </tr>
            </thead>
            <tbody>
              <% if (archives.length === 0) { %>
                <tr><td colspan="6" class="roster-empty">No archives yet<%= dayFilter ? ' for this day' : '' %> &mdash; use the Archive button on the Monday/Wednesday rosters to save and clear a term's attendance.</td></tr>
              <% } %>
              <% archives.forEach(function(a) { %>
                <tr>
                  <td><button type="button" class="member-name-link" data-view-archive-id="<%= a.id %>"><%= a.archivedAtLabel %></button></td>
                  <td><%= a.day === 'monday' ? 'Monday' : 'Wednesday' %></td>
                  <td><%= a.dateCount %></td>
                  <td><%= a.parentCount %></td>
                  <td><%= a.studentCount %></td>
                  <td><%= a.classCount %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <dialog id="roster-archive-view-dialog" class="roster-archive-view-dialog"></dialog>
      </div>
    <% } else { %>
    <% if (classId) { %><p class="subtitle no-print"><a href="/admin/rosters?tab=classes">&larr; All Class Rosters</a></p><% } %>

    <div class="roster-toolbar no-print">
      <div class="roster-toolbar-left">
        <% if (!classId) { %>
          <div class="day-toggle">
            <a class="day-toggle-option<%= tab === day + '-parent' ? ' active' : '' %>" href="/admin/rosters?tab=<%= day %>-parent">Parent</a>
            <a class="day-toggle-option<%= tab === day + '-student' ? ' active' : '' %>" href="/admin/rosters?tab=<%= day %>-student">Student</a>
          </div>
        <% } %>
        <span id="roster-save-status" class="volunteer-save-status"></span>
      </div>
      <div class="roster-btn-row">
        <% if (!classId) { %>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('edit-dates-dialog').showModal()">Edit Dates</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-member-dialog').showModal()">+ Add Member</button>
        <% } %>
        <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
        <button type="button" class="roster-action-btn" data-open-allergy-log><svg class="icon"><use href="#icon-medical-bag"/></svg> Allergies/Medical</button>
        <% if (!classId) { %>
          <form method="POST" action="/admin/rosters/<%= day %>/resync" class="inline-block-form" data-confirm="Resync <%= dayLabel %> Parent/Student rosters and floater auto-assignment from the current class schedule and staffing? Anyone automatically added who no longer belongs (for example, a non-primary parent added under old logic) will be removed. Anyone added by hand via + Add Member is left untouched." data-confirm-yes-label="Yes, Resync" data-confirm-icon="icon-rotate" data-confirm-safe="1">
            <input type="hidden" name="tab" value="<%= tab %>" />
            <button type="submit" class="roster-action-btn">Resync</button>
          </form>
          <form method="POST" action="/admin/rosters/<%= day %>/archive" class="inline-block-form" data-confirm="Archive all current session dates and attendance for <%= dayLabel %> Parent, Student, and every <%= dayLabel %> class into one permanent record? This clears the live roster's dates and attendance so it can start fresh for a new term &mdash; roster membership is not affected." data-confirm-yes-label="Yes, Archive" data-confirm-icon="icon-save" data-confirm-safe="1">
            <button type="submit" class="roster-action-btn">Archive</button>
          </form>
        <% } %>
      </div>
    </div>

    <dialog id="allergy-log-dialog" class="class-view-dialog allergy-log-dialog"></dialog>

    <dialog id="edit-dates-dialog" class="member-picker-dialog">
      <h3>Session Dates</h3>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <tbody>
            <% if (dates.length === 0) { %>
              <tr><td class="roster-empty">No dates yet.</td></tr>
            <% } %>
            <% dates.forEach(function(d) { %>
              <tr>
                <td><%= d.label %></td>
                <td class="actions-cell">
                  <form method="POST" action="/admin/rosters/<%= tab %>/dates/<%= d.date %>/remove" class="inline-block-form" data-confirm="Remove <%= d.label %>? Any attendance recorded for this date will be deleted too.">
                    <button type="submit" class="link-btn link-btn-danger">Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <form method="POST" action="/admin/rosters/<%= tab %>/dates/add">
        <div class="date-list-wrap">
          <label class="roster-checkbox-label">Add Dates</label>
          <div class="date-list">
            <div class="date-list-row">
              <input type="date" name="dates" />
              <button type="button" class="date-list-remove" aria-label="Remove date">&times;</button>
            </div>
          </div>
          <button type="button" class="btn-secondary date-list-add">+ Add another date</button>
        </div>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
          <button type="submit" class="primary-btn">Save</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-member-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/rosters/<%= tab %>/add-member">
        <h3>Add Members &mdash; <%= tabLabel %></h3>
        <% if (availableMembers.length === 0) { %>
          <p class="hint">Everyone eligible is already on this roster. Add new members on the <a href="/admin/members">Members page</a>.</p>
        <% } else { %>
          <div class="member-picker-list">
            <% availableMembers.forEach(function(m) { %>
              <label class="member-picker-row">
                <input type="checkbox" name="memberIds" value="<%= m.id %>" />
                <span><%= m.name %></span>
              </label>
            <% }); %>
          </div>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <% if (availableMembers.length > 0) { %>
            <button type="submit" class="primary-btn">Add Selected</button>
          <% } %>
        </div>
      </form>
    </dialog>

    <div class="grid-box roster-grid-col" id="grid-box-attendance">
      <div class="grid-box-header">
        <h2><%= tabLabel %> Attendance</h2>
      </div>
      <div class="legend">
        <span class="legend-item"><span class="cell-tag cell-present">P</span> Present</span>
        <span class="legend-item"><span class="cell-tag cell-late">L</span> Late</span>
        <span class="legend-item"><span class="cell-tag cell-absent">A</span> Absent</span>
      </div>
      <%
        // A real bug report: with many session dates and/or a big roster,
        // printing this grid (window.print() on this same live page - see
        // the Print button above) spilled columns and rows across several
        // physical pages instead of shrinking to fit one, the way this
        // app's other print surfaces already do. data-shrink-to-fit-on-
        // print (not the plain data-shrink-to-fit every OTHER print
        // surface uses) is what makes that safe on a page that's also
        // interactively used on screen with its own .roster-scroll
        // horizontal scrollbar - see print-shrink-to-fit.js's own
        // comment on why the two need different event wiring.
      %>
      <div class="roster-grid-print-fit" data-shrink-to-fit-on-print>
      <div class="roster-scroll">
        <table class="roster-table roster-table-detailed">
          <thead>
            <tr>
              <th class="roster-name-col">Name</th>
              <% dateLabels.forEach(function(label) { %>
                <th><%= label %></th>
              <% }); %>
              <th class="no-print"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% if (rows.length === 0) { %>
              <tr>
                <td colspan="<%= dateLabels.length + 2 %>" class="roster-empty">
                  <div class="roster-empty-state">
                    <svg class="icon roster-empty-icon"><use href="#icon-users"/></svg>
                    <p class="roster-empty-title">No members on this roster yet</p>
                    <p class="roster-empty-subtitle">Membership fills in automatically from class schedules.</p>
                  </div>
                </td>
              </tr>
            <% } %>
            <% rows.forEach(function(row) { %>
              <tr>
                <td class="roster-name-col">
                  <button type="button" class="link-btn" title="View profile for <%= row.member.name %>" onclick="document.getElementById('profile-dialog-<%= row.member.id %>').showModal()"><%= row.member.name %></button><%- include('partials/medical-flag', { member: row.member }) %>
                  <div class="roster-name-times">
                    <span class="roster-name-time">Arrival: <%= row.arrivalLabel || '—' %></span>
                    <span class="roster-name-time">Departure: <%= row.departureLabel || '—' %></span>
                  </div>
                </td>
                <% row.cells.forEach(function(cell) { %>
                  <td>
                    <div class="cell-detailed">
                      <select class="roster-cell-select roster-cell-select-<%= cell.status || 'blank' %>" data-tab="<%= tab %>" data-member="<%= row.member.id %>" data-date="<%= cell.date %>" data-original="<%= cell.status || '' %>" aria-label="Attendance status for <%= row.member.name %> on <%= cell.date %>">
                        <option value="" <%= !cell.status ? 'selected' : '' %>>—</option>
                        <option value="present" <%= cell.status === 'present' ? 'selected' : '' %>>P</option>
                        <option value="late" <%= cell.status === 'late' ? 'selected' : '' %>>L</option>
                        <option value="absent" <%= cell.status === 'absent' ? 'selected' : '' %>>A</option>
                      </select>
                      <span class="print-only-tag cell-tag cell-<%= cell.tag === 'P' ? 'present' : cell.tag === 'L' ? 'late' : cell.tag === 'A' ? 'absent' : 'blank' %>"><%= cell.tag || '' %></span>
                      <% if (cell.checkInTime) { %><span class="cell-time">In <%= cell.checkInTime %></span><% } %>
                      <% if (cell.checkOutTime) { %><span class="cell-time">Out <%= cell.checkOutTime %><% if (cell.number) { %> #<%= cell.number %><% } %></span><% } %>
                      <% if (cell.cleanupTaskNumber) { %><span class="cell-time">Cleanup #<%= cell.cleanupTaskNumber %></span><% } %>
                    </div>
                  </td>
                <% }); %>
                <td class="actions-cell no-print">
                  <form method="POST" action="/admin/rosters/<%= tab %>/remove-member/<%= row.member.id %>" class="inline-block-form" data-confirm="Remove <%= row.member.name %> from this roster?">
                    <button type="submit" class="icon-btn roster-remove-btn" aria-label="Remove <%= row.member.name %>" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                </td>
              </tr>
              <dialog id="profile-dialog-<%= row.member.id %>" class="member-profile-dialog">
                <div class="member-profile-header">
                  <% if (row.member.photo_path) { %>
                    <img class="member-photo-preview" src="<%= photoUrl(row.member.photo_path) %>" alt="" />
                  <% } %>
                  <div>
                    <h3><%= row.member.name %><%- include('partials/medical-flag', { member: row.member }) %></h3>
                    <span class="badge-pill"><%= row.member.member_type === 'parent' ? 'Parent' : 'Student' %></span>
                  </div>
                </div>
                <dl class="member-profile-list">
                  <% if (row.member.address || row.member.city || row.member.state || row.member.zip) { %>
                    <dt>Address</dt>
                    <dd><%= [row.member.address, row.member.city, [row.member.state, row.member.zip].filter(Boolean).join(' ')].filter(Boolean).join(', ') %></dd>
                  <% } %>
                  <% if (row.member.phone) { %><dt>Phone</dt><dd><%= row.member.phone %></dd><% } %>
                  <% if (row.member.email) { %><dt>Email</dt><dd><%= row.member.email %></dd><% } %>
                  <% if (row.member.member_type !== 'parent') { %>
                    <% if (row.member.birthday) { %><dt>Birthday</dt><dd><%= row.member.birthday %></dd><% } %>
                    <% if (row.member.grade_level) { %><dt>Grade Level</dt><dd><%= row.member.grade_level %></dd><% } %>
                    <% if (row.parentName) { %><dt>Family</dt><dd><%= row.parentName %></dd><% } %>
                    <% if (row.member.medical_notes) { %><dt>Medical/Allergy Notes</dt><dd><%= row.member.medical_notes %></dd><% } %>
                  <% } %>
                </dl>
                <p class="hint">To make changes, edit this profile on the <a href="/admin/members/<%= row.member.id %>/edit">Members page</a>.</p>
                <div class="notes-dialog-actions">
                  <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                </div>
              </dialog>
            <% }); %>
          </tbody>
          <% if (rows.length > 0) { %>
            <tfoot>
              <tr class="roster-summary-row">
                <td class="roster-summary-label">Present</td>
                <% summary.forEach(function(s) { %><td><span class="summary-badge summary-present"><%= s.present %></span></td><% }); %>
                <td class="no-print"></td>
              </tr>
              <tr class="roster-summary-row">
                <td class="roster-summary-label">Late</td>
                <% summary.forEach(function(s) { %><td><span class="summary-badge summary-late"><%= s.late %></span></td><% }); %>
                <td class="no-print"></td>
              </tr>
              <tr class="roster-summary-row">
                <td class="roster-summary-label">Absent</td>
                <% summary.forEach(function(s) { %><td><span class="summary-badge summary-absent"><%= s.absent %></span></td><% }); %>
                <td class="no-print"></td>
              </tr>
            </tfoot>
          <% } %>
        </table>
      </div>
      </div>
    </div>

    <% if (!classId) { %>
    <div class="manage-section no-print">
      <h2><%= dayLabel %> Alerts<% if (!alertDateLabel) { %> <span class="hint">(no session today)</span><% } else { %> <span class="hint">&mdash; <%= alertDateLabel %></span><% } %></h2>

      <h3 class="class-schedule-hour-label">Absence Forms</h3>
      <% if (absenceAlerts.absences.length === 0) { %>
        <p class="roster-empty">No absence forms submitted<%= alertDateLabel ? ' for today' : '' %>.</p>
      <% } else { %>
        <ul class="pending-approvals-list">
          <% absenceAlerts.absences.forEach(function(a) { %>
            <li><strong><%= a.memberName %></strong> &mdash; <%= a.reasonLabel %><% if (a.description && a.description !== '—') { %>: <%= a.description %><% } %></li>
          <% }); %>
        </ul>
      <% } %>

      <h3 class="class-schedule-hour-label">Late Forms</h3>
      <% if (absenceAlerts.lates.length === 0) { %>
        <p class="roster-empty">No late forms submitted<%= alertDateLabel ? ' for today' : '' %>.</p>
      <% } else { %>
        <ul class="pending-approvals-list">
          <% absenceAlerts.lates.forEach(function(a) { %>
            <li><strong><%= a.memberName %></strong> &mdash; <%= a.reasonLabel %><% if (a.description && a.description !== '—') { %>: <%= a.description %><% } %></li>
          <% }); %>
        </ul>
      <% } %>

      <h3 class="class-schedule-hour-label">Class Cancellation Risk</h3>
      <% if (classesAtRisk.length === 0) { %>
        <p class="roster-empty">No classes are at risk of low attendance.</p>
      <% } else { %>
        <ul class="pending-approvals-list">
          <% classesAtRisk.forEach(function(c) { %>
            <li><strong><%= c.className %></strong> (<%= c.hourLabel %>) &mdash; <%= c.expectedCount %> of <%= c.enrolledCount %> expected</li>
          <% }); %>
        </ul>
      <% } %>

      <h3 class="class-schedule-hour-label">Substitutes Needed</h3>
      <% if (classesNeedingStaff.length === 0) { %>
        <p class="roster-empty">Every class has a teacher and an assistant assigned.</p>
      <% } else { %>
        <ul class="pending-approvals-list">
          <% classesNeedingStaff.forEach(function(c) { %>
            <li>
              <strong><%= c.className %></strong> (<%= c.hourLabel %>) &mdash;
              <% if (c.missingTeacher) { %><span class="badge-pill badge-pill-absent">Teacher</span><% } %>
              <% if (c.missingAssistant) { %><span class="badge-pill badge-pill-pending">Assistant</span><% } %>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
    <% } %>
    <% } %>
  </main>
  <script src="/js/date-list.js"></script>
  <script src="/js/attendance-grid.js"></script>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/allergy-log-popup.js"></script>
  <script src="/js/roster-archive-view.js"></script>
  <script src="/js/print-shrink-to-fit.js"></script>
</body>
</html>
