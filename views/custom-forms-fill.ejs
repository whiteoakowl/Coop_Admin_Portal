<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<%
// Per-form theme (a real request: "full editing features and view just
// like jotform, exactly" - Jotform's own Theme tab, scoped to what this
// app needs: a primary color + a button shape). Applied as CSS custom
// properties scoped to this one page, so it never leaks into the rest
// of the portal - see public/css/styles.css's own .cf-* rules for what
// reads --cf-primary/--cf-radius.
var buttonRadius = form.theme_button_style === 'pill' ? '999px' : form.theme_button_style === 'square' ? '4px' : '10px';
%>
<body style="--cf-primary: <%= form.theme_primary_color %>; --cf-radius: <%= buttonRadius %>;">
  <%- include('partials/portal-nav', {
    portalTitle: 'Forms',
    navLinks: [
      { href: '/portal', icon: 'home', label: 'My Portals' },
      { href: '/forms', icon: 'clipboard-list', label: 'Forms' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1><%= form.title %></h1>
    <p><a href="/forms">&larr; All Forms</a></p>
    <% if (form.description) { %><p class="hint"><%= form.description %></p><% } %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (pages.length > 1) { %>
      <%# Multi-page progress indicator - a real request: "multi-page/
          section forms... with a progress indicator." Hidden entirely
          for the common single-page form (see the length check above),
          so a short form still looks exactly like it always has. %>
      <nav class="cf-progress no-print" aria-label="Form progress" data-cf-progress>
        <% pages.forEach(function(page, i) { %>
          <span class="cf-progress-step<%= i === 0 ? ' cf-progress-step-active' : '' %>" data-cf-progress-step="<%= page.id %>">
            <span class="cf-progress-dot"><%= i + 1 %></span>
            <span class="cf-progress-label"><%= page.title || ('Page ' + (i + 1)) %></span>
          </span>
        <% }); %>
      </nav>
    <% } %>

    <form method="POST" action="/forms/<%= form.id %>/submit" enctype="multipart/form-data" class="member-form-grid cf-form" id="cf-fill-form" data-cf-form>
      <label class="member-form-full">Who is this for?
        <select name="memberId" required>
          <% family.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
        </select>
      </label>

      <% pages.forEach(function(page, pageIndex) { %>
        <section
          class="cf-page<%= pageIndex === 0 ? ' cf-page-active' : '' %>"
          data-cf-page="<%= page.id %>"
          data-cf-page-index="<%= pageIndex %>"
          <% if (page.conditionalLogicParsed) { %>data-cf-condition='<%- JSON.stringify(page.conditionalLogicParsed) %>'<% } %>
        >
          <% if (pages.length > 1 && (page.title || page.description)) { %>
            <div class="member-form-full cf-page-heading">
              <% if (page.title) { %><h2><%= page.title %></h2><% } %>
              <% if (page.description) { %><p class="hint"><%= page.description %></p><% } %>
            </div>
          <% } %>

          <% page.fields.forEach(function(field) { %>
            <%- include('partials/custom-form-field', { field: field, ratingMax: ratingMax }) %>
          <% }); %>

          <div class="member-form-full cf-page-nav no-print">
            <% if (pageIndex > 0) { %><button type="button" class="btn-secondary" data-cf-prev>&larr; Back</button><% } %>
            <% if (pageIndex < pages.length - 1) { %>
              <button type="button" class="primary-btn cf-btn" data-cf-next>Next &rarr;</button>
            <% } else { %>
              <button type="submit" class="primary-btn cf-btn">Submit</button>
            <% } %>
          </div>
        </section>
      <% }); %>
    </form>
  </main>
  <script src="/js/custom-form-runtime.js"></script>
</body>
</html>
