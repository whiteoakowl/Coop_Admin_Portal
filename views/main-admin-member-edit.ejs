<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/main-admin/members">&larr; Members</a></p>
    <h1><%= title %></h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="member-form-page-panel">
      <%# A real request: "This page should look exactly like the
          membership request form. The additional parent sections and
          information, children sections and information. With family
          information below. Save and cancel buttons and the bottom of
          the page, same size, same row, side by side." See partials/
          member-edit-fields.ejs's own header comment for why the first
          part is a separate, shared partial (same one Parent Portal's
          own self-edit page and Co-op Admin's Edit Member page use),
          partials/member-edit-family-sections.ejs's own for the
          Additional Parents/Children sections (replacing the old inline
          "Family Members" quick-edit table and "Add to This Family"
          quick-add dialog - both fully superseded by +Add Adult/+Add
          Child there, which cover the same job with the full field set),
          and partials/member-edit-admin-section.ejs's own for the
          admin-only "family information" section at the bottom. %>
      <form
        method="POST"
        action="/main-admin/members/<%= member.id %>/edit"
        enctype="multipart/form-data"
        id="member-form"
        class="member-edit-form member-edit-form-page"
        data-add-family-url="/main-admin/members/families/new"
      >
        <%- include('partials/member-edit-fields', { member, gradeLevels, showPassword: true, confirmPassword: false, portalAccount, parentFields, childFields, generalFields, customFieldValues }) %>
        <%- include('partials/member-edit-family-sections', { familyAdults, familyChildren, familyChildFields }) %>
        <%- include('partials/member-edit-admin-section', { member, families, memberFamilyId, allSections, memberSectionIds, allRoles, portalRoleIds, portalAccount, hasPasswordField: true }) %>

        <div class="member-form-footer">
          <div class="member-form-footer-edit">
            <a class="btn-secondary" href="/main-admin/members">Cancel</a>
            <button type="submit" class="primary-btn"><svg class="icon"><use href="#icon-save"/></svg> Save Member</button>
          </div>
        </div>
      </form>

      <%# Outside #member-form on purpose - a <form> can't nest inside
          another <form> (the browser silently drops the inner tag), so
          this dialog's own form has to live as a sibling, not a
          descendant, of the main Edit Member form. See data-add-family-*
          in public/js/member-form.js. %>
      <dialog class="member-picker-dialog" data-add-family-dialog>
        <form data-add-family-form>
          <h3>Add Family</h3>
          <label>Family Last Name
            <input type="text" name="name" placeholder="e.g. Anderson" required />
          </label>
          <p class="alert alert-error" data-add-family-error hidden></p>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Add Family</button>
          </div>
        </form>
      </dialog>
    </div>
  </main>
  <script src="/js/member-form.js"></script>
  <script src="/js/member-family-edit-form.js"></script>
  <script src="/js/filter-details-dismiss.js"></script>
</body>
</html>
