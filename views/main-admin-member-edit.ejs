<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/main-admin/members">&larr; Members</a></p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="member-form-page-panel">
      <form
        method="POST"
        action="/main-admin/members/<%= member.id %>/edit"
        enctype="multipart/form-data"
        id="member-form"
        class="member-edit-form member-edit-form-page"
        data-add-family-url="/main-admin/members/families/new"
      >
        <%- include('partials/member-form-fields', { member, mode, families, memberFamilyId, setupTeams, memberCleanupTeamIds, gradeLevels, adminPositions, memberAdminPositionIds, allowAdminType: true }) %>

        <%# A real request: "when editing a member profile, there is a
            button that says add parent/student. when you click this
            button it will ask student or parent, name, if student then
            it asks birthday and grade. save." A quick-add dialog (see
            data-quick-add-member-dialog below, outside #member-form for
            the same reason the Add Family dialog is) that always adds
            onto this member's own family - each new person still gets
            their own individual profile via utils/memberIntake.js, just
            like the full Add Member form does. %>
        <div class="manage-section">
          <h2><svg class="icon"><use href="#icon-users"/></svg> Add to This Family</h2>
          <% if (memberFamilyId) { %>
            <p class="hint">Add another parent or student to this family - they get their own individual profile.</p>
            <button type="button" class="btn-secondary" data-quick-add-member-open>+ Add Parent/Student</button>
          <% } else { %>
            <p class="hint">Choose or add a family above and save, then come back here to add more parents or students to it.</p>
          <% } %>
        </div>

        <%# A real request (Approvals tab): "you can click the name and
            view their membership form and edit, add portal settings etc.
            save." A real later request: "No creating users. All Members
            should already have an account. Each member profile should
            have a space for password." - so this box covers BOTH a member
            who already has a portal account (change their password,
            manage roles) and one who doesn't yet (set a password here to
            create their account on Save, using the Email field above as
            their login - see routes/main-admin-members.js's own
            POST /:id/edit). %>
        <div class="manage-section">
          <h2><svg class="icon"><use href="#icon-sliders"/></svg> Portal Settings</h2>

          <%# A real request: "there should not be an edit permissions
              button [on the profile page], it should just show the
              member's sections and portal permissions. When you click
              the edit button... that is where you can control portal
              settings per member." Sections scope what an admin can see/
              manage - independent of whether this member has a portal
              login of their own, unlike Portal Roles below. %>
          <p><strong>Sections</strong></p>
          <% if (allSections.length === 0) { %>
            <p class="hint">No sections defined yet.</p>
          <% } else { %>
            <div class="grade-pill-grid">
              <% allSections.forEach(function(s) { %>
                <label class="grade-pill"><input type="checkbox" name="sectionIds" value="<%= s.id %>" <%= memberSectionIds.has(s.id) ? 'checked' : '' %> /> <%= s.name %></label>
              <% }); %>
            </div>
          <% } %>

          <% if (portalAccount) { %>
            <p class="hint">Account: <%= portalAccount.email %> &middot; Status: <%= portalAccount.status %></p>
          <% } else { %>
            <p class="hint">No portal account yet. Set a password below to create one, using this member's Email address above as their login.</p>
          <% } %>
          <label class="member-form-full"><%= portalAccount ? 'New Password (leave blank to keep the current one)' : 'Password' %>
            <input type="password" name="password" autocomplete="new-password" minlength="8" placeholder="<%= portalAccount ? 'Leave blank to keep unchanged' : 'At least 8 characters' %>" />
          </label>
          <p><strong>Portal Roles</strong></p>
          <% if (allRoles.length === 0) { %>
            <p class="hint">No roles defined yet.</p>
          <% } else { %>
            <div class="grade-pill-grid">
              <% allRoles.forEach(function(r) { %>
                <label class="grade-pill"><input type="checkbox" name="roleIds" value="<%= r.id %>" <%= portalRoleIds.has(r.id) ? 'checked' : '' %> /> <%= r.label %></label>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="member-form-footer">
          <div class="member-form-footer-edit">
            <a class="btn-secondary" href="/main-admin/members">Cancel</a>
            <button type="submit" class="primary-btn"><svg class="icon"><use href="#icon-save"/></svg> Save Member</button>
          </div>
        </div>
      </form>

      <%# Outside #member-form on purpose - see views/admin-member-edit.ejs's
          own identical comment on why this dialog can't nest inside the
          main form. %>
      <dialog class="member-picker-dialog" data-add-family-dialog>
        <form data-add-family-form>
          <h3>Add Family</h3>
          <label>Family Last Name
            <input type="text" name="name" placeholder="e.g. Anderson" required />
          </label>
          <p class="alert alert-error" data-add-family-error hidden></p>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Add Family</button>
          </div>
        </form>
      </dialog>

      <%# "add parent/student ... it will ask student or parent, name, if
          student then it asks birthday and grade. save." A plain form
          POST (no fetch) to routes/main-admin-members.js's own
          /:id/quick-add-family-member - simplest way to show the result
          (a fresh page load re-rendering this same Edit Profile page with
          a success/error banner), consistent with how every other action
          on this page already reports back. %>
      <dialog class="member-picker-dialog" data-quick-add-member-dialog>
        <form method="POST" action="/main-admin/members/<%= member.id %>/quick-add-family-member" data-quick-add-member-form>
          <h3>Add Parent/Student</h3>
          <div class="member-type-toggle" role="group" aria-label="Member type">
            <label class="member-type-toggle-btn member-type-toggle-student">
              <input type="radio" name="memberType" value="student" checked data-quick-add-type />
              <svg class="icon"><use href="#icon-graduation-cap"/></svg> Student
            </label>
            <label class="member-type-toggle-btn member-type-toggle-parent">
              <input type="radio" name="memberType" value="parent" data-quick-add-type />
              <svg class="icon"><use href="#icon-user"/></svg> Parent
            </label>
          </div>
          <label>Name
            <input type="text" name="name" placeholder="Full name" required />
          </label>
          <div data-quick-add-student-fields>
            <label>Birthday
              <input type="date" name="birthday" />
            </label>
            <label>Grade Level
              <select name="gradeLevel">
                <option value="">Select grade level</option>
                <% gradeLevels.forEach(function(g) { %><option value="<%= g %>"><%= g %></option><% }); %>
              </select>
            </label>
          </div>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Save</button>
          </div>
        </form>
      </dialog>
    </div>
  </main>
  <script src="/js/member-form.js"></script>
</body>
</html>
