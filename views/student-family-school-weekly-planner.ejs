<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Weekly Planner</h1>

    <%# Read-only - a student's own weeks, plus every Whole Family week
        (routes/student-family-school.js's own GET /family-school/
        weekly-planner), never a "Parent" week. %>
    <div class="roster-btn-row roster-btn-row-fit-text">
      <% weeks.forEach(function(w) { %>
        <a class="btn-secondary<% if (selectedWeek && selectedWeek.id === w.id) { %> active<% } %>" href="?weekId=<%= w.id %>"><%= w.title %></a>
      <% }); %>
    </div>

    <% if (!selectedWeek) { %>
      <% if (weeks.length === 0) { %>
        <p class="roster-empty">No weeks planned yet.</p>
      <% } else { %>
        <p class="roster-empty">Pick a week above to see its grid.</p>
      <% } %>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table condensed-table fs-weekly-plan-grid">
          <thead>
            <tr>
              <%# A real request: "Only parents can see this check box,
                  not student portal. When parent checks this box, the
                  student portal will say, complete with a check mark."
                  Read-only here, same as everything else on this
                  student-facing mirror - a badge, never the checkbox
                  itself. %>
              <% grid.forEach(function(d) { %>
                <th>
                  <div class="fs-weekly-plan-day-title-row">
                    <span><%= d.dateLabel %></span>
                    <% if (d.completed) { %><span class="badge-pill badge-pill-green"><svg class="icon"><use href="#icon-check"/></svg> Complete</span><% } %>
                  </div>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <tr>
              <% grid.forEach(function(d) { %>
                <td>
                  <div class="fs-weekly-plan-day-label-mobile fs-weekly-plan-day-title-row">
                    <span><%= d.dateLabel %></span>
                    <% if (d.completed) { %><span class="badge-pill badge-pill-green"><svg class="icon"><use href="#icon-check"/></svg> Complete</span><% } %>
                  </div>
                  <% if (d.assignments.length === 0) { %>
                    <p class="roster-empty">Nothing yet.</p>
                  <% } else { %>
                    <ul class="fs-weekly-plan-assignment-list">
                      <% d.assignments.forEach(function(a) { %>
                        <li class="<%= a.completed ? 'fs-weekly-plan-assignment-done' : '' %>">
                          <span class="fs-weekly-plan-assignment-text">
                            <%= a.completed ? '☑' : '☐' %>
                            <% if (a.subject) { %><strong><%= a.subject %>:</strong> <% } %><%= a.title %>
                            <% if (a.description) { %><br /><span class="hint"><%= a.description %></span><% } %>
                            <% if (a.link_url) { %> &middot; <a href="<%= a.link_url %>" target="_blank" rel="noopener">Link</a><% } %>
                            <% if (a.fileUrl) { %> &middot; <a href="<%= a.fileUrl %>" target="_blank" rel="noopener"><%= a.file_name %></a><% } %>
                            <% if (a.grade) { %> <span class="badge-pill">Grade: <%= a.grade %></span><% } %>
                          </span>
                        </li>
                      <% }); %>
                    </ul>
                  <% } %>
                </td>
              <% }); %>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="manage-section">
        <h2>This Week by Subject</h2>
        <%- include('partials/family-school-subject-chart', { subjectBreakdown }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
