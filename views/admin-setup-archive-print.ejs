<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= dayLabel %> Setup/Cleanup Assignments &mdash; <%= dateLabel %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <%# A real request: "make sure it prints one team per page" - see
        admin-setup-assignments.ejs's own comment (and partials/setup-
        assignment-cards.ejs's header comment) for the full explanation.
        This page's own top-level .print-header is gone the same way -
        each team now repeats its own copy instead. %>
    <div class="print-page volunteer-archive-print-page">
      <%- include('partials/setup-assignment-cards', { cards, day, dayLabel, selectedDate: date, dateLabel, editable: false }) %>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
