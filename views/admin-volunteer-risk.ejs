<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= dayLabel %> Class Cancellation Risk</p>
      </div>
    </div>

    <h1>Class Cancellation Risk</h1>

    <%# Floater Assignments/Floater Teams/Class Cancellation Risk now live
        as subpages under the orange bar's own Floater Assignments item
        (views/partials/admin-nav.ejs) instead of a trigger+dialog here. %>

    <div class="view-tab-panel">
      <div class="roster-toolbar no-print">
        <%- include('partials/schedule-combo-picker', { combos, basePrefix: '/admin/volunteers', pathSuffix: '/risk', selectedComboId }) %>
        <%# A real request: "export, import, print and pdf icons should
            be in a row side by side. Not in a single column" - see
            views/admin-design.ejs's own matching comment. %>
        <div class="roster-btn-row" data-fixed-columns="3">
          <a class="icon-btn" href="/admin/volunteers/<%= day %>/risk/export.csv?semesterId=<%= semesterId %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
          <%# A real request: "All print button should show a print preview
              full real page on a page with a print button." %>
          <a class="icon-btn" href="/admin/volunteers/<%= day %>/risk/print?semesterId=<%= semesterId %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
          <a class="icon-btn" href="/admin/volunteers/<%= day %>/risk/download.pdf?semesterId=<%= semesterId %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
        </div>
      </div>

      <%- include('partials/class-risk-table', { classesAtRisk, dayLabel }) %>
    </div>
  </main>
</body>
</html>
