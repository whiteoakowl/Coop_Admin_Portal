<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= dayLabel %> Floater Assignments &mdash; <%= dateLabel %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page volunteer-archive-print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub"><%= dayLabel %> Floater Assignments &mdash; <%= dateLabel %></p>
        </div>
      </div>

      <%- include('partials/floater-assignment-cards', { cards: cards }) %>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
