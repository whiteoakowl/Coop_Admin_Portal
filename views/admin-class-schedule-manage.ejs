<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle no-print"><a href="/admin/schedule?tab=<%= cls.day %>">&larr; <%= dayLabel %> Class Schedule</a></p>

    <div class="roster-toolbar">
      <div><h1><%= cls.class_name %></h1></div>
      <div class="roster-btn-row no-print">
        <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/delete" data-confirm="Delete &quot;<%= cls.class_name %>&quot;? This cannot be undone.">
          <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete Class</button>
        </form>
      </div>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%# A real request: "when you click a classes it should take you to
        the classes full settings page with tabs for all of that classes
        features. Admin and teachers can change classes information or
        upload assignments, grades etc." Same ?tab= server-round-trip
        pattern every other tabbed page in this app already uses (see
        views/admin-events-list.ejs). %>
    <div class="view-tabs no-print">
      <a class="view-tab<%= activeTab === 'details' ? ' active' : '' %>" href="?tab=details">Details</a>
      <a class="view-tab<%= activeTab === 'staffRoster' ? ' active' : '' %>" href="?tab=staffRoster">Staff &amp; Roster</a>
      <a class="view-tab<%= activeTab === 'assignments' ? ' active' : '' %>" href="?tab=assignments">Lessons</a>
      <a class="view-tab<%= activeTab === 'grades' ? ' active' : '' %>" href="?tab=grades">Grades</a>
      <a class="view-tab<%= activeTab === 'chat' ? ' active' : '' %>" href="?tab=chat">Chat</a>
    </div>

    <% if (activeTab === 'details') { %>
        <div class="manage-section">
          <h2>Class Details</h2>
          <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>" enctype="multipart/form-data" class="member-form-grid">
            <label>Class Name
              <input type="text" name="className" value="<%= cls.class_name %>" required />
            </label>
            <div class="member-form-full">
              <span class="roster-checkbox-label">Class Photo</span>
              <%# A real request: "the class photo should automatically show
                  the image under class settings before saving" - same
                  data-class-image-input/data-class-image-preview + always-
                  rendered (display toggled, not conditionally rendered) img
                  pattern public/js/class-image-preview.js and the Event
                  Image upload already use, so the just-chosen file shows
                  immediately without waiting for the form to actually save. %>
              <img src="<%= classImageUrl || '' %>" alt="" data-class-image-preview style="max-width: 240px; border-radius: var(--radius); display: <%= classImageUrl ? 'block' : 'none' %>; margin-bottom: 0.5rem;" />
              <input type="file" name="image" accept="image/*" data-class-image-input />
            </div>
            <div>
              <label class="roster-checkbox-label">Color</label>
              <div class="class-color-swatches">
                <% (typeof colorPalette !== 'undefined' ? colorPalette : [cls.color]).forEach(function(c) { %>
                  <label class="class-color-swatch">
                    <input type="radio" name="color" value="<%= c %>" <%= (cls.color || '').toLowerCase() === c.toLowerCase() ? 'checked' : '' %> />
                    <span class="class-color-swatch-fill" style="background: <%= c %>;"></span>
                    <svg class="icon"><use href="#icon-check"/></svg>
                  </label>
                <% }); %>
              </div>
            </div>
            <label>Class Hour
              <select name="hourPosition" required>
                <% hours.forEach(function(h) { %>
                  <option value="<%= h.position %>" <%= cls.hour_position === h.position ? 'selected' : '' %>><%= h.label %></option>
                <% }); %>
              </select>
            </label>
            <label>Room
              <input type="text" name="room" value="<%= cls.room || '' %>" />
            </label>
            <label>Start Time
              <input type="text" name="startTime" value="<%= cls.start_time || '' %>" placeholder="9:00 AM" />
            </label>
            <label>End Time
              <input type="text" name="endTime" value="<%= cls.end_time || '' %>" placeholder="10:00 AM" />
            </label>

            <div class="member-form-full">
              <label class="roster-checkbox-label">Grade <span class="hint">(select all that apply)</span></label>
              <%- include('partials/multi-select-checkbox', {
                name: 'ageGroup',
                options: gradeLevels.map(function(g) { return { value: g, label: g }; }),
                selected: selectedGrades,
                placeholder: 'All grades',
              }) %>
            </div>

            <%# A real request: "grade selection and age selection should
                be separate menus of choices" %>
            <div class="member-form-full">
              <label class="roster-checkbox-label">Age <span class="hint">(select all that apply)</span></label>
              <%- include('partials/multi-select-checkbox', {
                name: 'numericAges',
                options: ageOptions.map(function(a) { return { value: a, label: a }; }),
                selected: selectedAges,
                placeholder: 'All ages',
              }) %>
            </div>

            <div class="member-form-full" data-forum-editor>
              <label>Class Description <span class="hint">(shown to parents browsing classes)</span></label>
              <%- include('partials/forum-editor-toolbar') %>
              <div class="forum-editable" data-forum-editable contenteditable="true"><%- cls.description || '' %></div>
              <input type="hidden" name="description" data-forum-body-input />
            </div>

            <div class="member-form-full class-edit-slots-row">
              <label># of Students Allowed <span class="hint">(blank = unlimited)</span>
                <input type="number" name="capacity" min="0" value="<%= cls.capacity != null ? cls.capacity : '' %>" />
              </label>
              <label># of Teachers Allowed <span class="hint">(optional)</span>
                <input type="number" name="teacherSlots" min="0" value="<%= cls.teacher_slots != null ? cls.teacher_slots : '' %>" />
              </label>
              <label># of Class Assistants Allowed <span class="hint">(optional)</span>
                <input type="number" name="assistantSlots" min="0" value="<%= cls.assistant_slots != null ? cls.assistant_slots : '' %>" />
              </label>
              <label>Minimum Students Needed <span class="hint">(optional)</span>
                <input type="number" name="minCapacity" min="0" value="<%= cls.min_capacity != null ? cls.min_capacity : '' %>" />
              </label>
            </div>

            <label>Price ($) <span class="hint">(blank = free)</span>
              <input type="number" name="priceDollars" min="0" step="0.01" value="<%= cls.price_cents != null ? (cls.price_cents / 100).toFixed(2) : '' %>" />
            </label>
            <label>Charged per
              <select name="pricePer">
                <option value="students" <%= cls.price_per !== 'students_and_staff' ? 'selected' : '' %>>Students</option>
                <option value="students_and_staff" <%= cls.price_per === 'students_and_staff' ? 'selected' : '' %>>Students and Teachers/Assistants</option>
              </select>
            </label>

            <% if (typeof sections !== 'undefined' && sections.length) { %>
              <div class="member-form-full">
                <label class="roster-checkbox-label">Sections <span class="hint">(leave all unchecked to allow every section)</span></label>
                <div class="grade-pill-grid">
                  <% sections.forEach(function(s) { %>
                    <label class="grade-pill"><input type="checkbox" name="sectionIds" value="<%= s.id %>" <%= (typeof selectedSectionIds !== 'undefined' && selectedSectionIds.includes(s.id)) ? 'checked' : '' %> /> <%= s.name %></label>
                  <% }); %>
                </div>
              </div>
            <% } %>

            <button type="submit" class="primary-btn member-form-full">Save Changes</button>
          </form>
        </div>
    <% } else if (activeTab === 'staffRoster') { %>
      <div class="class-manage-roster-col">
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Teachers &amp; Assistants (<%= cls.staff.length %>)</h2>
            <button type="button" class="btn-secondary no-print" onclick="document.getElementById('add-staff-dialog').showModal()">+ Add Teacher/Assistant</button>
          </div>
          <div class="roster-log-list">
            <% if (cls.staff.length === 0) { %>
              <p class="roster-log-empty">No teachers/assistants yet.</p>
            <% } %>
            <% cls.staff.forEach(function(s) { %>
              <div class="roster-log-row">
                <span class="roster-log-name"><a class="member-name-link" href="/admin/members/<%= s.id %>"><%= s.name %></a></span>
                <span class="roster-log-meta">
                  <span class="badge-pill"><%= s.role === 'assistant' ? 'Assistant' : 'Teacher' %></span>
                </span>
                <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/staff/<%= s.id %>/remove" class="inline-block-form no-print" data-confirm="Remove <%= s.name %> from this class?">
                  <button type="submit" class="icon-btn" aria-label="Remove <%= s.name %>" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </form>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Student Roster (<%= enrolledStudents.length %>)</h2>
            <button type="button" class="btn-secondary no-print" onclick="document.getElementById('add-students-dialog').showModal()">+ Add Students</button>
          </div>
          <div class="roster-log-list">
            <% if (enrolledStudents.length === 0) { %>
              <p class="roster-log-empty">No students enrolled yet.</p>
            <% } %>
            <% enrolledStudents.forEach(function(s) { %>
              <%- include('partials/roster-student-row', { s: s, classId: cls.id, removeAction: '/admin/class-schedule/classes/' + cls.id + '/enrollment/' + s.id + '/remove' }) %>
            <% }); %>
          </div>
          <%- include('partials/roster-student-profile-dialog', { classId: cls.id }) %>
        </div>
      </div>
    <% } else if (activeTab === 'assignments') { %>
      <div class="manage-section">
        <div class="grid-box-header">
          <h2>Lessons (<%= assignments.length %>)</h2>
          <a class="btn-secondary" href="/admin/class-schedule/quiz-review">Quiz Review</a>
        </div>
        <% if (assignments.length === 0) { %>
          <p class="roster-empty">No lessons yet.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table">
              <thead>
                <tr><th></th><th>Title</th><th>Open</th><th>Due</th><th>Points</th><th></th></tr>
              </thead>
              <tbody data-lesson-reorder-tbody data-class-id="<%= cls.id %>">
                <% assignments.forEach(function(a) { %>
                  <tr data-lesson-reorder-row="<%= a.id %>">
                    <td class="roster-drag-col"><span data-lesson-reorder-handle class="lesson-drag-handle" title="Drag to reorder">&#9776;</span></td>
                    <td class="roster-name-col"><%= a.title %></td>
                    <td><%= a.open_date ? a.open_date : '—' %></td>
                    <td><%= a.dueDateLabel || '—' %></td>
                    <td><%= a.points_possible != null ? a.points_possible : '—' %></td>
                    <td><a class="roster-action-btn" href="/admin/class-schedule/assignments/<%= a.id %>">Manage</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>

        <div class="portal-dashboard-card portal-dashboard-card-wide">
          <h3>New Lesson</h3>
          <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/assignments" class="member-form-grid">
            <label class="member-form-full">Title
              <input type="text" name="title" required />
            </label>
            <label class="member-form-full">Description
              <textarea name="description" rows="2"></textarea>
            </label>
            <label>Open Date
              <input type="date" name="openDate" />
            </label>
            <label>Due Date
              <input type="date" name="dueDate" />
            </label>
            <label>Points Possible
              <input type="number" name="pointsPossible" min="0" />
            </label>
            <div class="member-form-full">
              <button type="submit" class="primary-btn">Add Lesson</button>
            </div>
          </form>
        </div>
      </div>
      <script src="/js/lesson-drag-reorder.js"></script>
    <% } else if (activeTab === 'grades') { %>
      <div class="manage-section">
        <div class="grid-box-header">
          <h2>Grades</h2>
        </div>
        <% if (assignments.length === 0) { %>
          <p class="roster-empty">No lessons to grade yet - add one from the Lessons tab.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table">
              <thead>
                <tr><th>Lesson</th><th>Due</th><th>Graded</th><th></th></tr>
              </thead>
              <tbody>
                <% assignments.forEach(function(a) { %>
                  <tr>
                    <td class="roster-name-col"><%= a.title %></td>
                    <td><%= a.dueDateLabel || '—' %></td>
                    <td><%= a.gradedCount %> / <%= a.studentCount %></td>
                    <td><a class="roster-action-btn" href="/admin/class-schedule/assignments/<%= a.id %>">Manage</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    <% } else if (activeTab === 'chat') { %>
      <div class="manage-section">
        <div class="grid-box-header">
          <h2>Chat</h2>
        </div>
        <%- include('partials/class-chat', { chatMessages, postUrl: `/admin/class-schedule/classes/${cls.id}/chat` }) %>
      </div>
    <% } %>

    <dialog id="add-students-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/enrollment/add">
        <h3>Add Students</h3>
        <% if (availableStudents.length === 0) { %>
          <p class="hint">Every active student is already enrolled.</p>
        <% } else { %>
          <div class="member-picker-list">
            <% availableStudents.forEach(function(s) { %>
              <label class="member-picker-row">
                <input type="checkbox" name="studentIds" value="<%= s.id %>" />
                <span><%= s.name %></span>
              </label>
            <% }); %>
          </div>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <% if (availableStudents.length > 0) { %>
            <button type="submit" class="primary-btn">Add Selected</button>
          <% } %>
        </div>
      </form>
    </dialog>

    <dialog id="add-staff-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/staff/add">
        <h3>Add Teacher/Assistant</h3>
        <% if (availableStaff.length === 0) { %>
          <p class="hint">Every eligible parent/student is already assigned to this class.</p>
        <% } else { %>
          <label>Member
            <select name="memberId" required>
              <% availableStaff.forEach(function(p) { %>
                <option value="<%= p.id %>"><%= p.name %><%= p.member_type === 'student' ? ' (Student)' : '' %></option>
              <% }); %>
            </select>
          </label>
          <div class="radio-group">
            <label class="radio-option"><input type="radio" name="role" value="teacher" checked /> Teacher</label>
            <label class="radio-option"><input type="radio" name="role" value="assistant" /> Assistant</label>
          </div>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <% if (availableStaff.length > 0) { %>
            <button type="submit" class="primary-btn">Add</button>
          <% } %>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/forum-editor.js"></script>
  <script src="/js/multi-select-checkbox.js"></script>
  <script src="/js/class-image-preview.js"></script>
</body>
</html>
