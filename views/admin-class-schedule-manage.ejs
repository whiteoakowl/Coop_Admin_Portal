<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle no-print"><a href="/admin/schedule?tab=<%= cls.day %>">&larr; <%= dayLabel %> Class Schedule</a></p>

    <div class="roster-toolbar">
      <div><h1><%= cls.class_name %></h1></div>
      <div class="roster-btn-row no-print">
        <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/delete" data-confirm="Delete &quot;<%= cls.class_name %>&quot;? This cannot be undone.">
          <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete Class</button>
        </form>
      </div>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%# A real request: "when you click a classes it should take you to
        the classes full settings page with tabs for all of that classes
        features. Admin and teachers can change classes information or
        upload assignments, grades etc." Same ?tab= server-round-trip
        pattern every other tabbed page in this app already uses (see
        views/admin-events-list.ejs). %>
    <div class="view-tabs no-print">
      <a class="view-tab<%= activeTab === 'details' ? ' active' : '' %>" href="?tab=details">Details</a>
      <a class="view-tab<%= activeTab === 'staffRoster' ? ' active' : '' %>" href="?tab=staffRoster">Staff &amp; Roster</a>
      <a class="view-tab<%= activeTab === 'assignments' ? ' active' : '' %>" href="?tab=assignments">Lessons</a>
      <a class="view-tab<%= activeTab === 'grades' ? ' active' : '' %>" href="?tab=grades">Grades</a>
      <a class="view-tab<%= activeTab === 'chat' ? ' active' : '' %>" href="?tab=chat">Chat</a>
    </div>

    <% if (activeTab === 'details') { %>
        <div class="manage-section">
          <h2>Class Details</h2>
          <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>" enctype="multipart/form-data" class="member-form-grid">
            <label>Class Name
              <input type="text" name="className" value="<%= cls.class_name %>" required />
            </label>
            <div class="member-form-full">
              <span class="roster-checkbox-label">Class Photo</span>
              <%# A real request: "the class photo should automatically show
                  the image under class settings before saving" - same
                  data-class-image-input/data-class-image-preview + always-
                  rendered (display toggled, not conditionally rendered) img
                  pattern public/js/class-image-preview.js and the Event
                  Image upload already use, so the just-chosen file shows
                  immediately without waiting for the form to actually save. %>
              <img src="<%= classImageUrl || '' %>" alt="" data-class-image-preview style="max-width: 240px; border-radius: var(--radius); display: <%= classImageUrl ? 'block' : 'none' %>; margin-bottom: 0.5rem;" />
              <input type="file" name="image" accept="image/*" data-class-image-input />
            </div>
            <div>
              <label class="roster-checkbox-label">Color</label>
              <div class="class-color-swatches">
                <% (typeof colorPalette !== 'undefined' ? colorPalette : [cls.color]).forEach(function(c) { %>
                  <label class="class-color-swatch">
                    <input type="radio" name="color" value="<%= c %>" <%= (cls.color || '').toLowerCase() === c.toLowerCase() ? 'checked' : '' %> />
                    <span class="class-color-swatch-fill" style="background: <%= c %>;"></span>
                    <svg class="icon"><use href="#icon-check"/></svg>
                  </label>
                <% }); %>
              </div>
            </div>
            <%# A real request: "class hour and room option should be on
                the same row next to eachother." %>
            <div class="member-form-full class-edit-slots-row">
              <label>Class Hour
                <select name="hourPosition" required>
                  <% hours.forEach(function(h) { %>
                    <option value="<%= h.position %>" <%= cls.hour_position === h.position ? 'selected' : '' %>><%= h.label %></option>
                  <% }); %>
                </select>
              </label>
              <label>Room
                <input type="text" name="room" value="<%= cls.room || '' %>" />
              </label>
            </div>

            <%# A real request: "start time and end time on the same
                row." %>
            <div class="member-form-full class-edit-slots-row">
              <label>Start Time
                <input type="text" name="startTime" value="<%= cls.start_time || '' %>" placeholder="9:00 AM" />
              </label>
              <label>End Time
                <input type="text" name="endTime" value="<%= cls.end_time || '' %>" placeholder="10:00 AM" />
              </label>
            </div>

            <%# A real request: "start date and end date on the same
                row." The class's own overall term/session date range,
                separate from Start/End Time above (its daily time slot). %>
            <div class="member-form-full class-edit-slots-row">
              <label>Start Date
                <input type="date" name="startDate" value="<%= cls.start_date || '' %>" />
              </label>
              <label>End Date
                <input type="date" name="endDate" value="<%= cls.end_date || '' %>" />
              </label>
            </div>

            <%# A real request: "lock class by grade check mark should be
                near title. Check event settings for the grade and age
                picker settings title layout" - same title-then-lock-
                then-picker order Events' own Lock by Grade/Age already
                uses (views/admin-events-builder.ejs). %>
            <div class="member-form-full">
              <span class="roster-checkbox-label">Grade <span class="hint">(select all that apply)</span></span>
              <%# Checked by default, matching the old always-on behavior
                  from before grade/age locks could be turned off
                  independently. %>
              <label class="checkbox-option"><input type="checkbox" name="lockByGrade" value="1" <%= cls.lock_by_grade == false || Number(cls.lock_by_grade) === 0 ? '' : 'checked' %> /> Lock class by grade</label>
              <%- include('partials/multi-select-checkbox', {
                name: 'ageGroup',
                options: gradeLevels.map(function(g) { return { value: g, label: g }; }),
                selected: selectedGrades,
                placeholder: 'All grades',
              }) %>
            </div>

            <%# A real request: "grade selection and age selection should
                be separate menus of choices" %>
            <div class="member-form-full">
              <span class="roster-checkbox-label">Age <span class="hint">(select all that apply)</span></span>
              <label class="checkbox-option"><input type="checkbox" name="lockByAge" value="1" <%= cls.lock_by_age == false || Number(cls.lock_by_age) === 0 ? '' : 'checked' %> /> Lock class by age</label>
              <%- include('partials/multi-select-checkbox', {
                name: 'numericAges',
                options: ageOptions.map(function(a) { return { value: a, label: a }; }),
                selected: selectedAges,
                placeholder: 'All ages',
              }) %>
            </div>

            <label>Semester <span class="hint">(optional)</span>
              <select name="semesterId">
                <option value="">No Semester</option>
                <% (typeof semesters !== 'undefined' ? semesters : []).forEach(function(s) { %>
                  <option value="<%= s.id %>" <%= cls.semester_id === s.id ? 'selected' : '' %>><%= s.title %></option>
                <% }); %>
              </select>
            </label>

            <%# A real request: "close register checkbox should be near,
                parents can use class chat" - grouped with the other two
                per-class portal-behavior checkboxes instead of sitting
                alone right after the Age picker. registration_open reads
                as "closed" while the underlying column is "open", so the
                two are inverted in the POST handler. %>
            <div class="member-form-full">
              <label class="checkbox-option"><input type="checkbox" name="closeRegistration" value="1" <%= cls.registration_open ? '' : 'checked' %> /> Close Registration</label>
              <label class="checkbox-option"><input type="checkbox" name="allowParentCompleteLessons" value="1" <%= cls.allow_parent_complete_lessons ? 'checked' : '' %> /> Parents Can Complete Lessons</label>
              <label class="checkbox-option"><input type="checkbox" name="allowParentChat" value="1" <%= cls.allow_parent_chat ? 'checked' : '' %> /> Parents Can Use Class Chat</label>
            </div>

            <div class="member-form-full" data-forum-editor>
              <label>Class Description <span class="hint">(shown to parents browsing classes)</span></label>
              <%- include('partials/forum-editor-toolbar') %>
              <div class="forum-editable" data-forum-editable contenteditable="true"><%- cls.description || '' %></div>
              <input type="hidden" name="description" data-forum-body-input />
            </div>

            <label class="member-form-full">Supply List <span class="hint">(shown on the class's own Details page)</span>
              <textarea name="supplyList" rows="3"><%= cls.supply_list || '' %></textarea>
            </label>

            <%# A real request: "# of students, # of teachers, # of class
                assistants options should move to the top of staff and
                roster page", later followed by "minimum and maximum
                student settings, same row next to each other" - Minimum
                Students Needed moved from here onto that same Slots form
                (staffRoster tab) too, so it can actually sit next to
                Maximum Students on one row instead of just being
                conceptually paired while living on two different tabs. %>

            <label>Price ($) <span class="hint">(blank = free)</span>
              <input type="number" name="priceDollars" min="0" step="0.01" value="<%= cls.price_cents != null ? (cls.price_cents / 100).toFixed(2) : '' %>" />
            </label>
            <label>Charged per
              <select name="pricePer">
                <option value="students" <%= cls.price_per !== 'students_and_staff' ? 'selected' : '' %>>Students</option>
                <option value="students_and_staff" <%= cls.price_per === 'students_and_staff' ? 'selected' : '' %>>Students and Teachers/Assistants</option>
              </select>
            </label>
            <%# A real request: "after charge per add a dropdown choice
                for account category." Reuses Events' own admin-managed
                accounting category list (utils/events.js's own
                listAccountingCategories), managed from Events' own
                Settings tab - see the migration's own comment for why a
                second, parallel list wasn't worth standing up here. %>
            <label>Account Category <span class="hint">(optional)</span>
              <select name="accountingCategoryId">
                <option value="">None</option>
                <% accountingCategories.forEach(function(c) { %>
                  <option value="<%= c.id %>" <%= cls.accounting_category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </label>

            <%# A real request: "duplicate class button should be on the
                same row as save button. Both buttons fit to text better
                and better balanced." Duplicate Class is a plain dialog-
                opener (no submission of its own), so it can sit right
                inside this form next to the real Save Changes submit
                button without needing its own separate section below. %>
            <div class="member-form-full class-details-save-row">
              <button type="submit" class="primary-btn">Save Changes</button>
              <button type="button" class="roster-action-btn" onclick="document.getElementById('duplicate-class-dialog').showModal()">Duplicate Class</button>
            </div>
          </form>
        </div>

        <dialog id="duplicate-class-dialog" class="member-picker-dialog">
          <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/duplicate">
            <h3>Duplicate Class</h3>
            <label class="checkbox-option"><input type="checkbox" name="copyStaff" value="1" /> Also copy the same teachers and class assistants</label>
            <label>Add the duplicate to
              <select name="targetComboId" required>
                <% combos.forEach(function(combo) { %>
                  <option value="<%= combo.id %>"><%= combo.label %></option>
                <% }); %>
              </select>
            </label>
            <div class="notes-dialog-actions">
              <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
              <button type="submit" class="primary-btn">Duplicate</button>
            </div>
          </form>
        </dialog>
    <% } else if (activeTab === 'staffRoster') { %>
      <div class="class-manage-roster-col">
        <%# A real request: "# of students, # of teachers, # of class
            assistants options should move to the top of staff and
            roster page" - moved off the Class Details tab, its own
            small scoped save (utils/classSchedule.js's own
            updateClassSlots) so it doesn't need to resupply every other
            Class Details field just to change a slot count. %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Slots</h2>
          </div>
          <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/slots" class="member-form-grid">
            <%# A real request: "minimum and maximum student settings,
                same row next to each other" - Minimum Students Needed
                moved here from the Class Details tab so it can actually
                sit beside Maximum (# of Students Allowed). %>
            <div class="member-form-full class-edit-slots-row">
              <label>Minimum Students <span class="hint">(optional)</span>
                <input type="number" name="minCapacity" min="0" value="<%= cls.min_capacity != null ? cls.min_capacity : '' %>" />
              </label>
              <label>Maximum Students <span class="hint">(blank = unlimited)</span>
                <input type="number" name="capacity" min="0" value="<%= cls.capacity != null ? cls.capacity : '' %>" />
              </label>
            </div>
            <%# A real request: "maximum teachers and max class assistants
                next to each other." %>
            <div class="member-form-full class-edit-slots-row">
              <label># of Teachers Needed <span class="hint">(optional)</span>
                <input type="number" name="teacherSlots" min="0" value="<%= cls.teacher_slots != null ? cls.teacher_slots : '' %>" />
              </label>
              <label># of Class Assistants Needed <span class="hint">(optional)</span>
                <input type="number" name="assistantSlots" min="0" value="<%= cls.assistant_slots != null ? cls.assistant_slots : '' %>" />
              </label>
            </div>
            <div class="member-form-full">
              <button type="submit" class="primary-btn">Save Slots</button>
            </div>
          </form>
        </div>

        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Teachers &amp; Assistants (<%= cls.staff.length %>)</h2>
            <button type="button" class="btn-secondary no-print" onclick="document.getElementById('add-staff-dialog').showModal()">+ Add Teacher/Assistant</button>
          </div>
          <div class="roster-log-list">
            <% if (cls.staff.length === 0) { %>
              <p class="roster-log-empty">No teachers/assistants yet.</p>
            <% } %>
            <% cls.staff.forEach(function(s) { %>
              <div class="roster-log-row">
                <span class="roster-log-name"><a class="member-name-link" href="/admin/members/<%= s.id %>"><%= s.name %></a></span>
                <span class="roster-log-meta">
                  <span class="badge-pill"><%= s.role === 'assistant' ? 'Assistant' : 'Teacher' %></span>
                </span>
                <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/staff/<%= s.id %>/remove" class="inline-block-form no-print" data-confirm="Remove <%= s.name %> from this class?">
                  <button type="submit" class="icon-btn" aria-label="Remove <%= s.name %>" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </form>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Student Roster (<span id="student-roster-count"><%= enrolledStudents.length %></span>)</h2>
            <button type="button" class="btn-secondary no-print" onclick="document.getElementById('add-students-dialog').showModal()">+ Add Students</button>
          </div>
          <div class="roster-log-list" id="student-roster-list">
            <p class="roster-log-empty" id="student-roster-empty" <% if (enrolledStudents.length > 0) { %>hidden<% } %>>No students enrolled yet.</p>
            <% enrolledStudents.forEach(function(s) { %>
              <%- include('partials/roster-student-row', { s: s, classId: cls.id, removeAction: '/admin/class-schedule/classes/' + cls.id + '/enrollment/' + s.id + '/remove' }) %>
            <% }); %>
          </div>
          <%- include('partials/roster-student-profile-dialog', { classId: cls.id }) %>
        </div>
      </div>
    <% } else if (activeTab === 'assignments') { %>
      <div class="manage-section">
        <div class="grid-box-header">
          <h2>Lessons (<%= assignments.length %>)</h2>
          <div class="roster-btn-row">
            <%# A real request: "Add a new lesson should be a button, when
                you click it there is a popup to add information" -
                replaces the old always-visible inline "New Lesson" card
                at the bottom of this tab. %>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-lesson-dialog').showModal()">+ New Lesson</button>
            <a class="btn-secondary" href="/admin/class-schedule/quiz-review">Quiz Review</a>
          </div>
        </div>
        <% if (assignments.length === 0) { %>
          <p class="roster-empty">No lessons yet.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table">
              <thead>
                <tr><th></th><th>Title</th><th>Open</th><th>Due</th><th>Points</th><th>Completed</th><th></th></tr>
              </thead>
              <tbody data-lesson-reorder-tbody data-class-id="<%= cls.id %>">
                <% assignments.forEach(function(a) { %>
                  <tr data-lesson-reorder-row="<%= a.id %>">
                    <td class="roster-drag-col"><span data-lesson-reorder-handle class="lesson-drag-handle" title="Drag to reorder">&#9776;</span></td>
                    <td class="roster-name-col"><%= a.title %></td>
                    <td><%= a.open_date ? a.open_date : '—' %></td>
                    <td><%= a.dueDateLabel || '—' %></td>
                    <td><%= a.points_possible != null ? a.points_possible : '—' %></td>
                    <%# A real request: "On lesson list show percentage of
                        how many people in the class completed the
                        assignments" - see completionStatsForAssignments'
                        own comment (utils/academics.js) for what
                        "completed" means here; "—" for a lesson with no
                        quiz content to complete at all. %>
                    <td><%= a.completionPercent != null ? a.completionPercent + '%' : '—' %></td>
                    <td><a class="roster-action-btn" href="/admin/class-schedule/assignments/<%= a.id %>">Manage</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <dialog id="add-lesson-dialog" class="class-form-dialog">
        <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/assignments">
          <div class="class-form-dialog-header">
            <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
            <h3>New Lesson</h3>
            <button type="button" class="class-form-dialog-close" onclick="this.closest('dialog').close()" aria-label="Close"><svg class="icon"><use href="#icon-x-circle"/></svg></button>
          </div>
          <div class="member-form-grid">
            <label class="member-form-full">Title
              <input type="text" name="title" required />
            </label>
            <label class="member-form-full">Description
              <textarea name="description" rows="2"></textarea>
            </label>
            <label>Open Date
              <input type="date" name="openDate" />
            </label>
            <label>Due Date
              <input type="date" name="dueDate" />
            </label>
            <label>Points Possible
              <input type="number" name="pointsPossible" min="0" />
            </label>
            <div class="member-form-full">
              <button type="submit" class="primary-btn">Add Lesson</button>
            </div>
          </div>
        </form>
      </dialog>
      <script src="/js/lesson-drag-reorder.js"></script>
    <% } else if (activeTab === 'grades') { %>
      <div class="manage-section">
        <div class="grid-box-header">
          <h2>Grades</h2>
        </div>
        <% if (assignments.length === 0) { %>
          <p class="roster-empty">No lessons to grade yet - add one from the Lessons tab.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table">
              <thead>
                <tr><th>Lesson</th><th>Due</th><th>Graded</th><th></th></tr>
              </thead>
              <tbody>
                <% assignments.forEach(function(a) { %>
                  <tr>
                    <td class="roster-name-col"><%= a.title %></td>
                    <td><%= a.dueDateLabel || '—' %></td>
                    <td><%= a.gradedCount %> / <%= a.studentCount %></td>
                    <td><a class="roster-action-btn" href="/admin/class-schedule/assignments/<%= a.id %>">Manage</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    <% } else if (activeTab === 'chat') { %>
      <div class="manage-section">
        <div class="grid-box-header">
          <h2>Chat</h2>
        </div>
        <%- include('partials/class-chat', { chatMessages, postUrl: `/admin/class-schedule/classes/${cls.id}/chat` }) %>
      </div>
    <% } %>

    <%# A real request: "If you add someone to a class roster the page
        should not refresh. The person should appear on the list." Kept
        as a real <form> (id="add-students-form") so it still works with
        no JS at all, just plain-submitted instead of fetch()-intercepted
        - public/js/class-roster-ajax.js below. %>
    <dialog id="add-students-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/enrollment/add" id="add-students-form">
        <h3>Add Students</h3>
        <p class="hint" id="add-students-empty-hint" <% if (availableStudents.length > 0) { %>hidden<% } %>>Every active student is already enrolled.</p>
        <div class="member-picker-list" id="add-students-list">
          <% availableStudents.forEach(function(s) { %>
            <label class="member-picker-row" data-student-id="<%= s.id %>">
              <input type="checkbox" name="studentIds" value="<%= s.id %>" />
              <span><%= s.name %></span>
            </label>
          <% }); %>
        </div>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn" id="add-students-submit" <% if (availableStudents.length === 0) { %>hidden<% } %>>Add Selected</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-staff-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/class-schedule/classes/<%= cls.id %>/staff/add">
        <h3>Add Teacher/Assistant</h3>
        <% if (availableStaff.length === 0) { %>
          <p class="hint">Every eligible parent/student is already assigned to this class.</p>
        <% } else { %>
          <label>Member
            <select name="memberId" required>
              <% availableStaff.forEach(function(p) { %>
                <option value="<%= p.id %>"><%= p.name %><%= p.member_type === 'student' ? ' (Student)' : '' %></option>
              <% }); %>
            </select>
          </label>
          <div class="radio-group">
            <label class="radio-option"><input type="radio" name="role" value="teacher" checked /> Teacher</label>
            <label class="radio-option"><input type="radio" name="role" value="assistant" /> Assistant</label>
          </div>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <% if (availableStaff.length > 0) { %>
            <button type="submit" class="primary-btn">Add</button>
          <% } %>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/forum-editor.js"></script>
  <script src="/js/multi-select-checkbox.js"></script>
  <script src="/js/class-image-preview.js"></script>
</body>
</html>
