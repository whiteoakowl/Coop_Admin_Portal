<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Badge - <%= member.name %></title>
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="stylesheet" href="/css/styles.css" />
  <script src="/vendor/jsbarcode.min.js"></script>
</head>
<body class="badge-page">
  <div class="badge-card">
    <img class="badge-logo" src="/img/logo.png" alt="" />
    <div class="badge-name"><%= member.name %></div>
    <svg id="barcode"></svg>
    <div class="badge-code"><%= member.barcode %></div>
  </div>
  <button class="primary-btn no-print" onclick="window.print()">Print</button>
  <script>
    JsBarcode('#barcode', <%- JSON.stringify(member.barcode) %>, {
      format: 'CODE128',
      width: 2,
      height: 70,
      displayValue: false,
      margin: 10,
    });
  </script>
</body>
</html>
