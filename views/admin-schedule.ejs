<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page schedule-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Schedule</p>
      </div>
    </div>
    <h1>Schedules</h1>

    <div class="view-tabs no-print">
      <a class="view-tab<%= topTab === 'schedules' ? ' active' : '' %>" href="/admin/schedule?tab=monday">Class Schedules</a>
      <% if (isFullAdmin) { %>
        <a class="view-tab<%= topTab === 'students' ? ' active' : '' %>" href="/admin/schedule?tab=students">Student Schedules</a>
        <a class="view-tab<%= topTab === 'parents' ? ' active' : '' %>" href="/admin/schedule?tab=parents">Parent Schedules</a>
        <a class="view-tab<%= topTab === 'archive' ? ' active' : '' %>" href="/admin/schedule?tab=archive">Archive</a>
        <a class="view-tab<%= topTab === 'settings' ? ' active' : '' %>" href="/admin/schedule?tab=settings">Settings</a>
      <% } %>
    </div>

    <div class="view-tab-panel">
      <% if (tab === 'monday' || tab === 'wednesday') { %>
        <div class="day-toggle no-print schedule-day-toggle">
          <a class="day-toggle-option<%= tab === 'monday' ? ' active' : '' %>" href="/admin/schedule?tab=monday">Monday</a>
          <a class="day-toggle-option<%= tab === 'wednesday' ? ' active' : '' %>" href="/admin/schedule?tab=wednesday">Wednesday</a>
        </div>
        <%- include('partials/class-schedule-grid', { day, dayLabel, error, notice, selectedDate, hours, roomGrid, rooms, gradeLevels, colorPalette, availableStaff, sections, absentIds, basePath: `/admin/schedule?tab=${tab}`, readOnly: !isFullAdmin }) %>
      <% } else if (tab === 'archive') { %>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

        <div class="day-toggle no-print schedule-day-toggle">
          <a class="day-toggle-option<%= archiveType === 'class' ? ' active' : '' %>" href="/admin/schedule?tab=archive&type=class">Class</a>
          <a class="day-toggle-option<%= archiveType === 'student' ? ' active' : '' %>" href="/admin/schedule?tab=archive&type=student">Student</a>
          <a class="day-toggle-option<%= archiveType === 'parent' ? ' active' : '' %>" href="/admin/schedule?tab=archive&type=parent">Parent</a>
        </div>

        <% if (archiveType === 'class') { %>
          <div class="roster-toolbar no-print">
            <div class="roster-btn-row">
              <a class="roster-action-btn file-action-btn" href="/admin/class-schedule/archive/export.csv">Export</a>
              <% if (archives.length > 0) { %>
                <form method="POST" action="/admin/class-schedule/archive/delete-all" class="inline-block-form" data-confirm="Permanently delete all <%= archives.length %> archived class(es)? This cannot be undone.">
                  <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete All</button>
                </form>
              <% } %>
            </div>
          </div>

          <% if (archives.length === 0) { %>
            <p class="roster-empty">No archived classes yet. Select classes on a day's grid and use "Archive" to move them here.</p>
          <% } else { %>
            <div class="roster-scroll">
              <table class="roster-table">
                <thead>
                  <tr>
                    <th>Day</th>
                    <th>Class Name</th>
                    <th>Room</th>
                    <th>Grade</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Teachers</th>
                    <th>Assistants</th>
                    <th>Students</th>
                    <th>Archived At</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% archives.forEach(function(a) { %>
                    <tr>
                      <td><%= dayLabels[a.day] || a.day %></td>
                      <td><%= a.class_name %></td>
                      <td><%= a.room || '—' %></td>
                      <td><%= a.age_group || '—' %></td>
                      <td><%= a.start_time || '—' %></td>
                      <td><%= a.end_time || '—' %></td>
                      <td><%= a.teachers || '—' %></td>
                      <td><%= a.assistants || '—' %></td>
                      <td><%= a.student_count %></td>
                      <td><%= a.archived_at %></td>
                      <td class="actions-cell">
                        <form method="POST" action="/admin/class-schedule/archive/<%= a.id %>/delete" class="inline-block-form" data-confirm="Permanently delete this archived class (&quot;<%= a.class_name %>&quot;)? This cannot be undone.">
                          <button type="submit" class="icon-btn" aria-label="Delete archived <%= a.class_name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        <% } else { %>
          <div class="roster-toolbar no-print">
            <div class="roster-btn-row">
              <a class="roster-action-btn file-action-btn" href="/admin/schedule/archive/<%= archiveType %>/export.csv">Export</a>
              <% if (archives.length > 0) { %>
                <form method="POST" action="/admin/schedule/archive/<%= archiveType %>/delete-all" class="inline-block-form" data-confirm="Permanently delete all <%= archives.length %> archived <%= archiveType %> schedule(s)? This cannot be undone.">
                  <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete All</button>
                </form>
              <% } %>
            </div>
          </div>

          <% if (archives.length === 0) { %>
            <p class="roster-empty">No archived <%= archiveType %> schedules yet. Select cards on the <%= archiveType === 'student' ? 'Student' : 'Parent' %> Schedules tab and use "Archive" to move them here.</p>
          <% } else { %>
            <div class="roster-scroll">
              <table class="roster-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Monday Schedule</th>
                    <th>Wednesday Schedule</th>
                    <th>Archived At</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% archives.forEach(function(a) { %>
                    <tr>
                      <td><%= a.member_name %></td>
                      <td><%= a.monday_schedule || '—' %></td>
                      <td><%= a.wednesday_schedule || '—' %></td>
                      <td><%= a.archived_at %></td>
                      <td class="actions-cell">
                        <form method="POST" action="/admin/schedule/archive/<%= a.id %>/delete" class="inline-block-form" data-confirm="Permanently delete this archived schedule (&quot;<%= a.member_name %>&quot;)? This cannot be undone.">
                          <button type="submit" class="icon-btn" aria-label="Delete archived schedule for <%= a.member_name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        <% } %>
      <% } else if (tab === 'settings') { %>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

        <p class="hint">Registration and cancellation settings for every class, across both days - toggle a checkbox to save it immediately. Open a class's own card on its Monday/Wednesday Schedules tab to edit its name, room, time, roster, or pricing.</p>

        <% if (classes.length === 0) { %>
          <p class="roster-empty">No classes yet - add one from the Monday or Wednesday Schedules tab.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table class-settings-table">
              <thead>
                <tr>
                  <th>Day</th>
                  <th>Class</th>
                  <th>Open for Registration</th>
                  <th>Parents Can Register</th>
                  <th>Teachers/Assistants Can Self Sign-Up</th>
                  <th>Students Can Self-Register</th>
                  <th>Members Can Cancel</th>
                  <th>Auto-Refund on Cancel</th>
                </tr>
              </thead>
              <tbody>
                <% classes.forEach(function(c) { %>
                  <tr>
                    <td><%= dayLabels[c.day] || c.day %></td>
                    <td><%= c.class_name %></td>
                    <td><input type="checkbox" data-class-settings-toggle data-class-id="<%= c.id %>" data-field="registrationOpen" <%= c.registration_open ? 'checked' : '' %> aria-label="Open for parent registration - <%= c.class_name %>" /></td>
                    <td><input type="checkbox" data-class-settings-toggle data-class-id="<%= c.id %>" data-field="allowParentRegister" <%= c.allow_parent_register ? 'checked' : '' %> aria-label="Parents can register - <%= c.class_name %>" /></td>
                    <td><input type="checkbox" data-class-settings-toggle data-class-id="<%= c.id %>" data-field="allowTeacherRegister" <%= c.allow_teacher_register ? 'checked' : '' %> aria-label="Teachers/assistants can self sign-up - <%= c.class_name %>" /></td>
                    <td><input type="checkbox" data-class-settings-toggle data-class-id="<%= c.id %>" data-field="allowStudentRegister" <%= c.allow_student_register ? 'checked' : '' %> aria-label="Students can self-register - <%= c.class_name %>" /></td>
                    <td><input type="checkbox" data-class-settings-toggle data-class-id="<%= c.id %>" data-field="allowCancel" <%= c.allow_cancel ? 'checked' : '' %> aria-label="Members can cancel their registration - <%= c.class_name %>" /></td>
                    <td><input type="checkbox" data-class-settings-toggle data-class-id="<%= c.id %>" data-field="autoRefundOnCancel" <%= c.auto_refund_on_cancel ? 'checked' : '' %> aria-label="Auto-refund a paid charge on cancel - <%= c.class_name %>" /></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <p class="hint no-print" id="class-settings-save-status" role="status"></p>
        <% } %>
      <% } else { %>
        <%
          function buildQuery(overrides) {
            const params = new URLSearchParams();
            params.set('tab', tab);
            if (selectedMemberId) params.set('memberId', selectedMemberId);
            Object.keys(overrides || {}).forEach(function (k) {
              if (overrides[k] === null || overrides[k] === undefined) params.delete(k);
              else params.set(k, overrides[k]);
            });
            return '?' + params.toString();
          }
        %>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

        <div class="roster-toolbar no-print">
          <div class="schedule-filters">
            <div class="category-filter schedule-search">
              <label for="schedule-name-select"><%= tab === 'parents' ? 'Parent' : 'Student' %> Name</label>
              <select id="schedule-name-select" onchange="window.location = '/admin/schedule?tab=<%= tab %>' + (this.value ? '&memberId=' + this.value : '')">
                <option value="">All <%= tab === 'parents' ? 'parents' : 'students' %></option>
                <% allNames.forEach(function(n) { %>
                  <option value="<%= n.id %>" <%= selectedMemberId === n.id ? 'selected' : '' %>><%= n.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="class-schedule-archive-controls" data-archive-controls="schedule-archive-form-<%= tab %>" hidden>
              <label class="checkbox-option class-schedule-select-all">
                <input type="checkbox" data-select-all-for="schedule-archive-form-<%= tab %>" />
                Select All
              </label>
              <button type="submit" form="schedule-archive-form-<%= tab %>" class="roster-action-btn">Archive Selected</button>
            </div>
          </div>

          <div class="roster-btn-row">
            <button type="button" class="roster-action-btn file-action-btn" onclick="document.getElementById('schedule-import-dialog').showModal()">Import</button>
            <a class="roster-action-btn file-action-btn" href="/admin/schedule/export.csv<%= buildQuery({}) %>">Export</a>
            <a class="roster-action-btn print-action-btn" href="/admin/schedule/print<%= buildQuery({}) %>" target="_blank">Print</a>
            <button type="button" class="roster-action-btn" data-archive-toggle="schedule-archive-form-<%= tab %>" aria-pressed="false">Archive</button>
          </div>
        </div>

        <form
          id="schedule-archive-form-<%= tab %>"
          method="POST"
          action="/admin/schedule/<%= tab %>/archive"
          data-confirm="Are you sure you want to archive the selected <%= tab === 'parents' ? 'parent' : 'student' %> schedule(s)?"
          data-confirm-yes-label="Yes, Archive"
          data-confirm-icon="icon-save"
          data-confirm-safe="1"
        ></form>

        <dialog id="schedule-import-dialog" class="member-picker-dialog">
          <form method="POST" action="/admin/schedule/<%= tab %>/import" enctype="multipart/form-data">
            <h3>Import <%= tab === 'parents' ? 'Parent' : 'Student' %> Schedules</h3>
            <a class="btn-secondary import-sample-link" href="/admin/schedule/<%= tab %>/import-template.xlsx">Download Sample File</a>
            <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
            <div class="notes-dialog-actions">
              <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
              <button type="submit" class="primary-btn">Import</button>
            </div>
          </form>
        </dialog>

        <% if (rows.length === 0) { %>
          <div class="roster-empty-state">
            <svg class="icon roster-empty-icon"><use href="#icon-clock"/></svg>
            <p class="roster-empty-title">No schedules found</p>
          </div>
        <% } else { %>
          <div class="schedule-card-grid">
            <% rows.forEach(function(r) { %>
              <div class="schedule-card-grid-item">
                <input type="checkbox" name="memberIds" value="<%= r.member.id %>" form="schedule-archive-form-<%= tab %>" class="archive-select-checkbox no-print" aria-label="Select <%= r.member.name %> for archiving" hidden />
                <a class="schedule-card-grid-name" href="/admin/schedule/member/<%= r.member.id %>/manage"><%= r.member.name %></a>
                <%- include('partials/name-tag-badge', { html: r.scheduleCardHtml, bgCss: scheduleCardBgCss, badgeWidth: cardWidth, badgeHeight: cardHeight }) %>
              </div>
            <% }); %>
          </div>
          <%
            // "Select All" (public/js/archive-select-toggle.js) only ever
            // checks checkboxes actually present in the DOM - and this grid
            // only renders one page's worth of members at a time (see the
            // route's own PAGE_SIZE slice), so on a multi-page list it used
            // to silently select just the current page, not everyone. Only
            // relevant on the real "every active member" view (no single-
            // person filter picked from the Name dropdown above, which
            // already shows just the one match with no pagination at all) -
            // these extra boxes carry the rest of that same, already-known
            // allNames list (every active member of this type, unfiltered
            // by page) so "Select All" can reach them too, without needing
            // a server round trip or a separate "select every page" concept
            // on the archive route itself.
            var pageIds = rows.map(function (r) { return r.member.id; });
          %>
          <% if (!selectedMemberId) { %>
            <% allNames.forEach(function(n) { %>
              <% if (pageIds.indexOf(n.id) === -1) { %>
                <input type="checkbox" name="memberIds" value="<%= n.id %>" form="schedule-archive-form-<%= tab %>" class="archive-offpage-checkbox" aria-hidden="true" hidden />
              <% } %>
            <% }); %>
          <% } %>
        <% } %>

        <% if (totalPages > 1) { %>
          <div class="schedule-pagination no-print">
            <a class="btn-secondary<%= page <= 1 ? ' btn-disabled' : '' %>" href="<%= buildQuery({ page: Math.max(1, page - 1) }) %>">&larr; Previous</a>
            <span class="hint">Page <%= page %> of <%= totalPages %> (<%= totalCount %> total)</span>
            <a class="btn-secondary<%= page >= totalPages ? ' btn-disabled' : '' %>" href="<%= buildQuery({ page: Math.min(totalPages, page + 1) }) %>">Next &rarr;</a>
          </div>
        <% } %>
      <% } %>
    </div>
  </main>
  <script src="/js/badge-autofit.js"></script>
  <script src="/js/schedule.js"></script>
  <script src="/js/archive-select-toggle.js"></script>
  <script src="/js/forum-editor.js"></script>
  <script src="/js/class-settings-autosave.js"></script>
</body>
</html>
