<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/users', icon: 'user-check', label: 'Users' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Announcements' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/sections', icon: 'grid', label: 'Sections' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/roles', icon: 'sliders', label: 'Roles & Permissions' },
      { href: '/main-admin/website', icon: 'palette', label: 'Website' },
      { href: '/main-admin/events', icon: 'calendar-check', label: 'Events' },
      { href: '/main-admin/directory', icon: 'map-pin', label: 'Business Directory' },
      { href: '/main-admin/classifieds', icon: 'tag', label: 'Classifieds' },
      { href: '/main-admin/member-directory', icon: 'users', label: 'Member Directory' },
      { href: '/main-admin/forums', icon: 'users', label: 'Chat' },
      { href: '/main-admin/forms', icon: 'clipboard-list', label: 'Custom Forms' },
      { href: '/main-admin/accounting', icon: 'file-text', label: 'Accounting' },
      { href: '/main-admin/store', icon: 'tag', label: 'Store' },
      { href: '/main-admin/newsletter', icon: 'mail', label: 'Newsletter' },
      { href: '/main-admin/notifications', icon: 'bell', label: 'Notifications' },
      { href: '/main-admin/photos', icon: 'image', label: 'Photos' },
      { href: '/main-admin/publications', icon: 'book', label: 'Publications' },
      { href: '/main-admin/audit-log', icon: 'file-text', label: 'Audit Log' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Events</h1>
    <p class="hint">Create and manage co-op events - registration, volunteer roles, and donation requests.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="roster-toolbar">
      <div class="roster-btn-row">
        <button type="button" class="roster-action-btn" onclick="document.getElementById('new-event-dialog').showModal()">+ New Event</button>
        <a class="roster-action-btn" href="/main-admin/events/categories">Categories</a>
        <a class="roster-action-btn" href="/main-admin/events/pending">Submitted Events<% if (pendingCount) { %> <span class="badge-pill badge-pill-orange"><%= pendingCount %></span><% } %></a>
      </div>
    </div>

    <% if (events.length === 0) { %>
      <p class="roster-empty">No events yet &mdash; create one above.</p>
    <% } %>

    <div class="team-card-grid">
      <% events.forEach(function(e) { %>
        <div class="team-col">
          <div class="team-info-card">
            <span class="team-info-icon" style="<%= e.categoryColor ? `color: ${e.categoryColor};` : '' %>"><svg class="icon"><use href="#icon-calendar-check"/></svg></span>
            <h3 class="team-info-title"><a href="/main-admin/events/<%= e.id %>/builder"><%= e.title %></a></h3>
            <span class="badge-pill badge-pill-<%= e.status === 'published' ? 'green' : e.status === 'cancelled' ? 'gray' : 'orange' %>"><%= e.status.charAt(0).toUpperCase() + e.status.slice(1) %></span>
            <% if (e.approval_status === 'pending') { %><span class="badge-pill badge-pill-orange">Pending Approval</span><% } %>
            <% if (e.categoryName) { %><span class="badge-pill" style="background: <%= e.categoryColor %>; color: #fff;"><%= e.categoryName %></span><% } %>
            <p class="hint"><%= e.visibility === 'public' ? 'Public' : 'Members only' %></p>
            <div class="roster-btn-row">
              <a class="roster-action-btn" href="/main-admin/events/<%= e.id %>/builder">Edit</a>
              <a class="roster-action-btn" href="/main-admin/events/<%= e.id %>/registrations">Registrations</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <dialog id="new-event-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events">
        <h3>New Event</h3>
        <label>Title
          <input type="text" name="title" placeholder="e.g. Fall Family Picnic" required />
        </label>
        <label>Starts
          <input type="datetime-local" name="startsAt" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
