<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Communication' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/events', icon: 'calendar-check', label: 'Events' },
      { href: '/main-admin/directory', icon: 'map-pin', label: 'Business Directory' },
      { href: '/main-admin/classifieds', icon: 'tag', label: 'Classifieds' },
      { href: '/main-admin/member-directory', icon: 'users', label: 'Member Directory' },
      { href: '/main-admin/forums', icon: 'users', label: 'Chat' },
      { href: '/main-admin/forms', icon: 'clipboard-list', label: 'Custom Forms' },
      { href: '/main-admin/accounting', icon: 'file-text', label: 'Accounting' },
      { href: '/main-admin/store', icon: 'tag', label: 'Store' },
      { href: '/main-admin/newsletter', icon: 'mail', label: 'Newsletter' },
      { href: '/main-admin/notifications', icon: 'bell', label: 'Notifications' },
      { href: '/main-admin/photos', icon: 'image', label: 'Photos' },
      { href: '/main-admin/publications', icon: 'book', label: 'Publications' },
      { href: '/main-admin/audit-log', icon: 'file-text', label: 'Audit Log' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1>Events</h1>
      <% if (activeTab === 'calendar' || activeTab === 'drafts') { %>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('new-event-dialog').showModal()">+ New Event</button>
      <% } %>
    </div>
    <p class="hint">Create and manage co-op events - registration, volunteer roles, and donation requests.</p>

    <%
      // A real request: "Main Admin Events: Calendar/Drafts/Requests/
      // Event Attendance/Archive/Settings tabs" (see routes/admin-
      // events.js's own header comment for what each tab covers), and a
      // follow-up: "on mobile, replace the tabs with stacked expandable
      // bars - click the title to expand it." Desktop keeps the usual
      // .view-tabs pill strip; on mobile it's replaced with this same
      // list of tabs rendered as full-width bars stacked top to bottom,
      // with the current tab's bar shown "expanded" (open, its content
      // directly beneath it) and every other tab shown as a closed bar
      // you tap to navigate to and expand - see the two
      // .event-mobile-accordion blocks below (one for the bars before
      // the active tab, one for the bars after) sandwiching the exact
      // same content this page already rendered for the desktop tab
      // panel, so there's no second copy of any tab's markup to keep in
      // sync.
      const eventTabDefs = [
        { key: 'calendar', label: 'Calendar' },
        { key: 'drafts', label: 'Drafts' },
        { key: 'requests', label: 'Requests' },
        { key: 'attendance', label: 'Event Attendance' },
        { key: 'archive', label: 'Archive' },
        { key: 'settings', label: 'Settings' },
      ];
      const activeTabIndex = eventTabDefs.findIndex(function(t) { return t.key === activeTab; });
    %>
    <div class="view-tabs event-tabs-desktop">
      <% eventTabDefs.forEach(function(t) { %>
        <a href="/main-admin/events?tab=<%= t.key %>" class="view-tab <%= activeTab === t.key ? 'active' : '' %>"><%= t.label %><% if (t.key === 'requests' && pendingCount > 0 && activeTab !== 'requests') { %> <span class="badge-pill badge-pill-orange"><%= pendingCount %></span><% } %></a>
      <% }); %>
    </div>
    <div class="event-mobile-accordion no-print">
      <% eventTabDefs.slice(0, activeTabIndex + 1).forEach(function(t) { %>
        <% if (t.key === activeTab) { %>
          <div class="event-accordion-bar event-accordion-bar-active">
            <span><%= t.label %><% if (t.key === 'requests' && pendingCount > 0) { %> <span class="badge-pill badge-pill-orange"><%= pendingCount %></span><% } %></span>
            <svg class="icon event-accordion-chevron"><use href="#icon-chevron-down"/></svg>
          </div>
        <% } else { %>
          <a class="event-accordion-bar" href="/main-admin/events?tab=<%= t.key %>">
            <span><%= t.label %><% if (t.key === 'requests' && pendingCount > 0) { %> <span class="badge-pill badge-pill-orange"><%= pendingCount %></span><% } %></span>
            <svg class="icon event-accordion-chevron event-accordion-chevron-closed"><use href="#icon-chevron-down"/></svg>
          </a>
        <% } %>
      <% }); %>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (activeTab === 'calendar') { %>
      <div class="roster-toolbar event-calendar-toolbar">
        <div class="event-calendar-month-nav">
          <h2 class="event-calendar-month-label"><%= calendar.label %></h2>
          <div class="roster-btn-row">
            <a class="roster-action-btn" href="/main-admin/events?tab=calendar&view=<%= calendarView %>&month=<%= calendar.prevParam %>">&larr; Prev</a>
            <a class="roster-action-btn" href="/main-admin/events?tab=calendar&view=<%= calendarView %>&month=<%= calendar.nextParam %>">Next &rarr;</a>
          </div>
        </div>
        <div class="roster-btn-row">
          <a class="roster-action-btn archived-toggle-btn<%= calendarView === 'calendar' ? ' active' : '' %>" href="/main-admin/events?tab=calendar&view=calendar&month=<%= monthParam %>">Calendar View</a>
          <a class="roster-action-btn archived-toggle-btn<%= calendarView === 'list' ? ' active' : '' %>" href="/main-admin/events?tab=calendar&view=list&month=<%= monthParam %>">List View</a>
        </div>
      </div>

      <% if (calendarView === 'list') { %>
        <% if (calendarList.length === 0) { %>
          <p class="roster-empty">No published events this month.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table condensed-table">
              <thead><tr><th>Title</th><th>Starts</th><th>Location</th><th>Category</th></tr></thead>
              <tbody>
                <% calendarList.forEach(function(e) { %>
                  <tr>
                    <td class="roster-name-col"><a href="/main-admin/events/<%= e.id %>/builder"><%= e.title %></a></td>
                    <td><%= e.startsLabel %></td>
                    <td><%= e.location || '—' %></td>
                    <td><% if (e.categoryColor) { %><span class="badge-pill" style="background:<%= e.categoryColor %>;color:#fff;"><%= e.categoryName || '' %></span><% } else { %>—<% } %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      <% } else { %>
        <% if (calendar.weeks.every(function(w) { return w.every(function(d) { return d.events.length === 0; }); })) { %>
          <p class="roster-empty">No published events this month.</p>
        <% } %>
        <table class="roster-table condensed-table event-calendar-table">
          <thead><tr><th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th></tr></thead>
          <tbody>
            <% calendar.weeks.forEach(function(week) { %>
              <tr>
                <% week.forEach(function(day) { %>
                  <td class="<%= day.inMonth ? '' : 'hint' %>">
                    <div><%= day.day %></div>
                    <% day.events.forEach(function(e) { %>
                      <a href="/main-admin/events/<%= e.id %>/builder" class="badge-pill" style="<%= e.categoryColor ? `background:${e.categoryColor};color:#fff;` : '' %> display:block; margin-top:2px;"><%= e.title %></a>
                    <% }); %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    <% } else if (activeTab === 'drafts') { %>
      <% if (drafts.length === 0) { %>
        <p class="roster-empty">No drafts &mdash; create an event above.</p>
      <% } else { %>
        <div class="team-card-grid">
          <% drafts.forEach(function(e) { %>
            <div class="team-col">
              <div class="team-info-card">
                <span class="team-info-icon" style="<%= e.categoryColor ? `color: ${e.categoryColor};` : '' %>"><svg class="icon"><use href="#icon-calendar-check"/></svg></span>
                <h3 class="team-info-title"><a href="/main-admin/events/<%= e.id %>/builder"><%= e.title %></a></h3>
                <span class="badge-pill badge-pill-orange">Draft</span>
                <% if (e.categoryName) { %><span class="badge-pill" style="background: <%= e.categoryColor %>; color: #fff;"><%= e.categoryName %></span><% } %>
                <p class="hint"><%= e.visibility === 'public' ? 'Public' : 'Members only' %></p>
                <div class="roster-btn-row">
                  <a class="roster-action-btn" href="/main-admin/events/<%= e.id %>/builder">Edit</a>
                  <form method="POST" action="/main-admin/events/<%= e.id %>/status" class="inline-block-form">
                    <input type="hidden" name="status" value="published" />
                    <button type="submit" class="roster-action-btn">Publish</button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } else if (activeTab === 'requests') { %>
      <p class="hint">Events members submitted for approval. Approving doesn't publish it - it just lets it into Drafts to edit and publish.</p>
      <% if (requests.length === 0) { %>
        <p class="roster-empty">Nothing waiting on approval right now.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table">
            <thead><tr><th>Title</th><th>Starts</th><th>Location</th><th></th></tr></thead>
            <tbody>
              <% requests.forEach(function(e) { %>
                <tr>
                  <td class="roster-name-col"><a href="/main-admin/events/<%= e.id %>/builder"><%= e.title %></a></td>
                  <td><%= e.startsLabel %></td>
                  <td><%= e.location || '—' %></td>
                  <td>
                    <div class="roster-btn-row">
                      <form method="POST" action="/main-admin/events/<%= e.id %>/decide" class="inline-block-form">
                        <input type="hidden" name="decision" value="approve" />
                        <button type="submit" class="roster-action-btn">Approve</button>
                      </form>
                      <form method="POST" action="/main-admin/events/<%= e.id %>/decide" class="inline-block-form">
                        <input type="hidden" name="decision" value="reject" />
                        <button type="submit" class="roster-action-btn roster-action-btn-danger">Reject</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } else if (activeTab === 'attendance') { %>
      <% if (attendance.length === 0) { %>
        <p class="roster-empty">No published events yet.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table">
            <thead><tr><th>Title</th><th>Starts</th><th>Registered</th><th></th></tr></thead>
            <tbody>
              <% attendance.forEach(function(e) { %>
                <tr>
                  <td class="roster-name-col"><%= e.title %></td>
                  <td><%= e.startsLabel %></td>
                  <td><%= e.registrationCount || 0 %></td>
                  <td><a class="roster-action-btn" href="/main-admin/events/<%= e.id %>/registrations">Attendance</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } else if (activeTab === 'archive') { %>
      <% if (archived.length === 0) { %>
        <p class="roster-empty">Nothing archived.</p>
      <% } else { %>
        <div class="team-card-grid">
          <% archived.forEach(function(e) { %>
            <div class="team-col">
              <div class="team-info-card">
                <span class="team-info-icon"><svg class="icon"><use href="#icon-calendar-check"/></svg></span>
                <h3 class="team-info-title"><a href="/main-admin/events/<%= e.id %>/builder"><%= e.title %></a></h3>
                <span class="badge-pill badge-pill-gray">Cancelled</span>
                <div class="roster-btn-row">
                  <form method="POST" action="/main-admin/events/<%= e.id %>/status" class="inline-block-form">
                    <input type="hidden" name="status" value="draft" />
                    <button type="submit" class="roster-action-btn">Restore</button>
                  </form>
                  <form method="POST" action="/main-admin/events/<%= e.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= e.title %>&quot;? This cannot be undone.">
                    <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } else { %>
      <p class="hint">A fixed list an event picks one of, so the calendar can filter/color-code events consistently.</p>
      <form method="POST" action="/main-admin/events/categories" class="stack-form member-form-page-panel">
        <div class="member-form-grid">
          <label>Category Name
            <input type="text" name="name" placeholder="e.g. Field Trip" required />
          </label>
          <label>Color
            <input type="color" name="color" value="#EE9A4D" />
          </label>
        </div>
        <div class="member-form-footer">
          <div class="member-form-footer-edit">
            <button type="submit" class="primary-btn">+ Add Category</button>
          </div>
        </div>
      </form>

      <% if (categories.length === 0) { %>
        <p class="roster-empty">No categories yet - add one above.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table">
            <thead><tr><th>Color</th><th>Name</th><th></th></tr></thead>
            <tbody>
              <% categories.forEach(function(c) { %>
                <tr>
                  <td>
                    <form method="POST" action="/main-admin/events/categories/<%= c.id %>/update" class="inline-block-form">
                      <input type="hidden" name="name" value="<%= c.name %>" />
                      <input type="color" name="color" value="<%= c.color %>" onchange="this.form.submit()" aria-label="Color for <%= c.name %>" />
                    </form>
                  </td>
                  <td><%= c.name %></td>
                  <td>
                    <form method="POST" action="/main-admin/events/categories/<%= c.id %>/delete" class="inline-block-form" data-confirm="Delete this category? Events using it will just show no category.">
                      <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } %>

    <div class="event-mobile-accordion no-print">
      <% eventTabDefs.slice(activeTabIndex + 1).forEach(function(t) { %>
        <a class="event-accordion-bar" href="/main-admin/events?tab=<%= t.key %>">
          <span><%= t.label %><% if (t.key === 'requests' && pendingCount > 0) { %> <span class="badge-pill badge-pill-orange"><%= pendingCount %></span><% } %></span>
          <svg class="icon event-accordion-chevron event-accordion-chevron-closed"><use href="#icon-chevron-down"/></svg>
        </a>
      <% }); %>
    </div>

    <%# A real request: "the create event form needs a lot more detail
        fields." The rest (volunteer roles, donation items, sections,
        pricing/registration window) stay in the builder, reached right
        after Create - those make more sense to add once the event
        already exists, not crammed into this quick-create popup. %>
    <dialog id="new-event-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events">
        <h3>New Event</h3>
        <label>Title
          <input type="text" name="title" placeholder="e.g. Fall Family Picnic" required />
        </label>
        <label>Description
          <textarea name="description" rows="2" placeholder="What's happening, who it's for, what to bring"></textarea>
        </label>
        <label>Location
          <input type="text" name="location" placeholder="e.g. Fellowship Hall" />
        </label>
        <div class="class-form-row">
          <div class="class-form-field">
            <span class="class-form-field-label">Starts</span>
            <input type="datetime-local" name="startsAt" required />
          </div>
          <div class="class-form-field">
            <span class="class-form-field-label">Ends</span>
            <input type="datetime-local" name="endsAt" />
          </div>
        </div>
        <label>Category
          <select name="categoryId">
            <option value="">None</option>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }); %>
          </select>
        </label>
        <label>Visibility
          <select name="visibility">
            <option value="members">Members only</option>
            <option value="public">Public</option>
          </select>
        </label>
        <label>Capacity (people) <span class="hint">(blank = no limit)</span>
          <input type="number" name="capacity" min="1" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
