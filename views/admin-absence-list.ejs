<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Absence/Late Form</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="quick-add-row">
      <button type="button" class="btn-secondary" onclick="document.getElementById('add-member-dialog').showModal()">+ Add Member</button>
      <button type="button" class="btn-secondary" onclick="document.getElementById('import-dialog').showModal()">Import from File</button>
    </div>

    <dialog id="add-member-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/absence-list/add-member">
        <h3>Add Members</h3>
        <% if (availableMembers.length === 0) { %>
          <p class="hint">Everyone in Members is already on this list. Add new members on the <a href="/admin/members">Members page</a>.</p>
        <% } else { %>
          <div class="member-picker-list">
            <% availableMembers.forEach(function(m) { %>
              <label class="member-picker-row">
                <input type="checkbox" name="memberIds" value="<%= m.id %>" />
                <span><%= m.name %></span>
              </label>
            <% }); %>
          </div>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <% if (availableMembers.length > 0) { %>
            <button type="submit" class="primary-btn">Add Selected</button>
          <% } %>
        </div>
      </form>
    </dialog>

    <dialog id="import-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/absence-list/import" enctype="multipart/form-data">
        <h3>Import from File</h3>
        <p class="hint">Only names already in <a href="/admin/members">Members</a> will be added. New people must be added there first. <a href="/admin/import-template/names.xlsx">Download an example spreadsheet</a>.</p>
        <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Import</button>
        </div>
      </form>
    </dialog>

    <div class="roster-scroll">
      <table class="roster-table members-table condensed-table">
        <thead>
          <tr><th>Name</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% if (members.length === 0) { %>
            <tr><td colspan="2" class="roster-empty">No one on the list yet.</td></tr>
          <% } %>
          <% members.forEach(function(m) { %>
            <tr>
              <td><%= m.name %></td>
              <td class="actions-cell">
                <form method="POST" action="/admin/absence-list/remove-member/<%= m.id %>" class="inline-block-form">
                  <button type="submit" class="link-btn link-btn-danger">Remove</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <h2>Submissions</h2>
    <div class="category-filter">
      <label for="date-select">Date</label>
      <select id="date-select" onchange="window.location = '/admin/absence-list' + (this.value ? '?date=' + encodeURIComponent(this.value) : '')">
        <option value="">All dates</option>
        <% submissionDates.forEach(function(d) { %>
          <option value="<%= d.date %>" <%= dateFilter === d.date ? 'selected' : '' %>><%= d.label %></option>
        <% }); %>
      </select>
    </div>
    <div class="roster-scroll">
      <table class="roster-table members-table condensed-table">
        <thead>
          <tr><th>Name</th><th>Roster</th><th>Date</th><th>Status</th><th>Reason</th><th>Description</th></tr>
        </thead>
        <tbody>
          <% if (submissions.length === 0) { %>
            <tr><td colspan="6" class="roster-empty">No absence or late submissions<%= dateFilter ? ' for this date' : ' yet' %>.</td></tr>
          <% } %>
          <% submissions.forEach(function(s) { %>
            <tr>
              <td><%= s.memberName %></td>
              <td><%= s.rosterName %></td>
              <td><%= s.dateLabel %></td>
              <td><span class="status-badge <%= s.statusLabel === 'Late' ? 'status-badge-late' : 'status-badge-absent' %>"><%= s.statusLabel %></span></td>
              <td><%= s.reasonLabel %></td>
              <td><%= s.description %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
