<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Absence/Late List</h1>
    <p class="subtitle">Only people added here can be selected on the public Absence/Late form &mdash; just like adding someone to a roster.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="quick-add-row">
      <form method="POST" action="/admin/absence-list/add-person" class="inline-form-flat">
        <input type="text" name="name" placeholder="New person's name" required />
        <button type="submit" class="btn-secondary">+ Add Person</button>
      </form>
      <form method="POST" action="/admin/absence-list/add-member" class="inline-form-flat">
        <select name="memberId" required>
          <option value="">Add existing member&hellip;</option>
          <% availableMembers.forEach(function(m) { %>
            <option value="<%= m.id %>"><%= m.name %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn-secondary">Add</button>
      </form>
      <form method="POST" action="/admin/absence-list/import" enctype="multipart/form-data" class="inline-form-flat">
        <input type="file" name="file" accept=".csv,.txt" required />
        <button type="submit" class="btn-secondary">Import from File</button>
      </form>
    </div>

    <div class="roster-scroll">
      <table class="roster-table members-table condensed-table">
        <thead>
          <tr><th>Name</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% if (members.length === 0) { %>
            <tr><td colspan="2" class="roster-empty">No one on the list yet.</td></tr>
          <% } %>
          <% members.forEach(function(m) { %>
            <tr>
              <td><%= m.name %></td>
              <td class="actions-cell">
                <form method="POST" action="/admin/absence-list/remove-member/<%= m.id %>" class="inline-block-form">
                  <button type="submit" class="link-btn link-btn-danger">Remove</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
