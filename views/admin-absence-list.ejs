<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Absence/Late List</h1>
    <p class="subtitle">Everyone here can be selected on the public Absence/Late form.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="quick-add-row">
      <form method="POST" action="/admin/members" class="inline-form-flat">
        <input type="hidden" name="returnTo" value="/admin/absence-list" />
        <input type="text" name="name" placeholder="Person's name" required />
        <button type="submit" class="btn-secondary">+ Add Person</button>
      </form>
      <form method="POST" action="/admin/members/import" enctype="multipart/form-data" class="inline-form-flat">
        <input type="hidden" name="returnTo" value="/admin/absence-list" />
        <input type="file" name="file" accept=".csv,.txt" required />
        <button type="submit" class="btn-secondary">Import from File</button>
      </form>
    </div>

    <div class="roster-scroll">
      <table class="roster-table members-table">
        <thead>
          <tr><th>Name</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% if (members.length === 0) { %>
            <tr><td colspan="3" class="roster-empty">No one on the list yet.</td></tr>
          <% } %>
          <% members.forEach(function(m) { %>
            <tr class="<%= m.active ? '' : 'row-inactive' %>">
              <td><%= m.name %></td>
              <td><%= m.active ? 'Active' : 'Removed' %></td>
              <td class="actions-cell">
                <form method="POST" action="/admin/members/<%= m.id %>/toggle-active" class="inline-block-form">
                  <input type="hidden" name="returnTo" value="/admin/absence-list" />
                  <button type="submit" class="link-btn <%= m.active ? 'link-btn-danger' : '' %>"><%= m.active ? 'Remove' : 'Restore' %></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
