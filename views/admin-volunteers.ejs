<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main" data-day="<%= day %>">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= dayLabel %> Floater Assignments</p>
      </div>
    </div>

    <h1>Floater Assignments</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%- include('partials/floater-tabs', { day, activeFloaterTab: 'assignments' }) %>

    <div class="view-tab-panel">
      <div class="roster-toolbar no-print">
        <div class="roster-toolbar-left">
          <div class="day-toggle">
            <a class="day-toggle-option<%= day === 'monday' ? ' active' : '' %>" href="/admin/volunteers/monday/manage">Monday</a>
            <a class="day-toggle-option<%= day === 'wednesday' ? ' active' : '' %>" href="/admin/volunteers/wednesday/manage">Wednesday</a>
          </div>
        </div>
        <div class="roster-btn-row">
          <a class="roster-action-btn file-action-btn" href="/admin/volunteers/<%= day %>/export.csv">Export</a>
          <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
          <a class="roster-action-btn" href="/admin/volunteers/<%= day %>/archive">Archive</a>
        </div>
      </div>

      <div class="grid-box-header">
        <h2><%= dayLabel %> Floater Assignments</h2>
        <div class="roster-btn-row no-print">
          <button type="button" class="btn-secondary" onclick="document.getElementById('edit-dates-dialog').showModal()">Edit Dates</button>
          <button type="button" class="btn-secondary" onclick="document.getElementById('add-job-dialog').showModal()">+ Add Position</button>
        </div>
      </div>

      <div class="roster-toolbar no-print">
        <div class="category-filter" style="margin: 0;">
          <label for="chart-date-select">Choose Date</label>
          <select id="chart-date-select" onchange="window.location = '/admin/volunteers/<%= day %>/manage' + (this.value ? '?date=' + this.value : '')">
            <% if (upcomingDates.length === 0) { %><option value="">No upcoming dates</option><% } %>
            <% upcomingDates.forEach(function(d) { %>
              <option value="<%= d.date %>" <%= selectedDate === d.date ? 'selected' : '' %>><%= d.label %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <% if (dates.length === 0) { %>
        <p class="roster-empty">Add session dates above first.</p>
      <% } else if (!selectedDate) { %>
        <p class="roster-empty">No upcoming session dates - add one above, or see past dates on the <a href="/admin/volunteers/<%= day %>/archive">Archive</a> tab.</p>
      <% } else { %>
        <%- include('partials/floater-chart-cards', { day, selectedDate, hourSections }) %>
      <% } %>
    </div>

    <dialog id="edit-dates-dialog" class="volunteer-edit-dialog">
      <h3>Edit Session Dates</h3>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <tbody>
            <% if (dates.length === 0) { %>
              <tr><td class="roster-empty">No dates yet.</td></tr>
            <% } %>
            <% dates.forEach(function(d) { %>
              <tr>
                <td><%= d.label %></td>
                <td class="actions-cell">
                  <form method="POST" action="/admin/volunteers/<%= day %>/dates/<%= d.date %>/remove?dialog=dates" class="inline-block-form" data-confirm="Remove <%= d.label %>? Any position/room assignments for this date will be deleted too.">
                    <button type="submit" class="link-btn link-btn-danger">Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <form method="POST" action="/admin/volunteers/<%= day %>/dates/add?dialog=dates" class="volunteer-date-add-form">
        <input type="date" name="dates" onchange="if (this.value) this.form.requestSubmit();" />
      </form>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
      </div>
    </dialog>

    <dialog id="add-job-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/volunteers/<%= day %>/substitutes/permanent-jobs/new">
        <h3>Add Position</h3>
        <p class="hint">Add one position to as many hours as it runs - each hour gets its own row on the chart.</p>
        <input type="hidden" name="date" value="<%= selectedDate %>" />
        <input type="text" name="title" placeholder="Position title (e.g. Front Desk)" required />
        <input type="text" name="room" placeholder="Room # (optional)" />
        <span class="class-card-pill-label">Hours:</span>
        <div class="checkbox-row">
          <% hours.forEach(function(h) { %>
            <label class="checkbox-option">
              <input type="checkbox" name="hourPositions" value="<%= h.position %>" />
              <%= h.label %>
            </label>
          <% }); %>
        </div>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Position</button>
        </div>
      </form>
    </dialog>

    <% if (openDialog) { %>
      <script>document.getElementById('edit-<%= openDialog %>-dialog').showModal();</script>
    <% } %>
  </main>
  <script src="/js/date-list.js"></script>
</body>
</html>
