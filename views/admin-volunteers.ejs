<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main" data-day="<%= day %>">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= dayLabel %> Floater Assignments</p>
      </div>
    </div>

    <h1>Volunteers</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%- include('partials/floater-tabs', { day, activeFloaterTab: day }) %>

    <div class="view-tab-panel">
      <div class="roster-toolbar no-print">
        <div class="category-filter" style="margin: 0;">
          <select onchange="window.location = this.value">
            <option value="/admin/volunteers/monday/manage" <%= day === 'monday' ? 'selected' : '' %>>Viewing Monday</option>
            <option value="/admin/volunteers/wednesday/manage" <%= day === 'wednesday' ? 'selected' : '' %>>Viewing Wednesday</option>
          </select>
        </div>
        <div class="roster-btn-row">
          <a class="roster-action-btn file-action-btn" href="/admin/volunteers/<%= day %>/export.csv">Export</a>
          <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
        </div>
      </div>

      <div class="manage-section">
        <div class="grid-box-header">
          <h2><%= dayLabel %> Floater Assignments Chart</h2>
          <div class="roster-btn-row no-print">
            <button type="button" class="btn-secondary" onclick="document.getElementById('edit-dates-dialog').showModal()">Edit Dates</button>
            <button type="button" class="btn-secondary" onclick="document.getElementById('add-job-dialog').showModal()">+ Add Position</button>
          </div>
        </div>

        <% if (dates.length === 0) { %>
          <p class="roster-empty">Add session dates above first.</p>
        <% } else if (grid.length === 0) { %>
          <p class="roster-empty">Add a position above first (e.g. Front Desk, Hallway Monitor).</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="job-grid-table">
              <thead>
                <tr>
                  <th class="job-grid-position-col">Position</th>
                  <th class="job-grid-room-col">Room</th>
                  <% dateLabels.forEach(function(label) { %><th><%= label %></th><% }); %>
                </tr>
              </thead>
              <tbody>
                <% grid.forEach(function(hour) { %>
                  <tr class="job-grid-hour-row"><td colspan="<%= dateLabels.length + 2 %>"><%= hour.label %></td></tr>
                  <% hour.jobs.forEach(function(job) { %>
                    <tr>
                      <td class="job-grid-position-col"><%= job.title %></td>
                      <td class="job-grid-room-col"><%= job.room || '—' %></td>
                      <% job.cells.forEach(function(cell) { %>
                        <td>
                          <div
                            class="job-assign-cell"
                            data-hour="<%= hour.position %>"
                            data-date="<%= cell.date %>"
                            data-job-id="<%= job.id %>"
                            data-member-id="<%= cell.assigned ? cell.assigned.id : '' %>"
                          >
                            <span class="job-assign-name<%= cell.assigned ? '' : ' job-assign-name-empty' %>"><%= cell.assigned ? cell.assigned.name + (cell.assigned.infant ? ' (infant)' : '') : 'Unassigned' %></span>
                            <button type="button" class="btn-secondary job-assign-edit-btn no-print" data-mode="edit">Edit</button>
                          </div>
                        </td>
                      <% }); %>
                    </tr>
                  <% }); %>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <dialog id="edit-dates-dialog" class="volunteer-edit-dialog">
      <h3>Edit Session Dates</h3>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <tbody>
            <% if (dates.length === 0) { %>
              <tr><td class="roster-empty">No dates yet.</td></tr>
            <% } %>
            <% dates.forEach(function(d) { %>
              <tr>
                <td><%= d.label %></td>
                <td class="actions-cell">
                  <form method="POST" action="/admin/volunteers/<%= day %>/dates/<%= d.date %>/remove?dialog=dates" class="inline-block-form" onsubmit="return confirm('Remove <%= d.label %>? Any position/room assignments for this date will be deleted too.');">
                    <button type="submit" class="link-btn link-btn-danger">Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <form method="POST" action="/admin/volunteers/<%= day %>/dates/add?dialog=dates" class="volunteer-date-add-form">
        <input type="date" name="dates" onchange="if (this.value) this.form.submit();" />
      </form>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
      </div>
    </dialog>

    <dialog id="add-job-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/volunteers/<%= day %>/substitutes/permanent-jobs/new">
        <h3>Add Position</h3>
        <p class="hint">Add one position to as many hours as it runs - each hour gets its own row on the chart.</p>
        <input type="hidden" name="date" value="<%= selectedDate %>" />
        <input type="text" name="title" placeholder="Position title (e.g. Front Desk)" required />
        <input type="text" name="room" placeholder="Room # (optional)" />
        <span class="class-card-pill-label">Hours:</span>
        <div class="checkbox-row">
          <% hours.forEach(function(h) { %>
            <label class="checkbox-option">
              <input type="checkbox" name="hourPositions" value="<%= h.position %>" />
              <%= h.label %>
            </label>
          <% }); %>
        </div>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Position</button>
        </div>
      </form>
    </dialog>

    <% if (openDialog) { %>
      <script>document.getElementById('edit-<%= openDialog %>-dialog').showModal();</script>
    <% } %>

    <h2 class="dashboard-section-title">Substitutes Needed</h2>
    <div class="roster-toolbar no-print">
      <div class="category-filter" style="margin: 0;">
        <label for="sub-date-select">For Date</label>
        <input
          type="date"
          id="sub-date-select"
          value="<%= selectedDate %>"
          onchange="window.location = '/admin/volunteers/<%= day %>/manage' + (this.value ? '?date=' + this.value : '')"
        />
      </div>
    </div>

    <% if (!selectedDate) { %>
      <p class="roster-empty">Pick a date above to see who needs a substitute.</p>
    <% } %>
    <% var anySlots = board.some(function(h) { return h.slots.length > 0; }); %>
    <% if (selectedDate && !anySlots) { %>
      <p class="roster-empty">Nobody needs a substitute for <%= selectedDate %>.</p>
    <% } %>
    <% board.forEach(function(hour) { %>
      <% if (hour.slots.length === 0) return; %>
      <div class="sub-needed-grid">
        <% hour.slots.forEach(function(slot) { %>
          <div class="sub-needed-card">
            <div class="sub-needed-header">
              <svg class="icon"><use href="#icon-redo"/></svg>
              <h3>Substitute Needed</h3>
              <span class="badge-pill sub-needed-hour-pill"><svg class="icon"><use href="#icon-clock"/></svg> <%= hour.label %></span>
            </div>
            <div class="sub-needed-position">
              <span class="sub-needed-position-icon"><svg class="icon"><use href="#<%= slot.slotType === 'job' ? 'icon-tag' : 'icon-book' %>"/></svg></span>
              <div>
                <strong><%= slot.label %><% if (slot.room) { %> &mdash; Room <%= slot.room %><% } else if (slot.detail && slot.slotType === 'class') { %> &mdash; <%= slot.detail %><% } %></strong>
                <p><%= slot.slotType === 'job' ? 'Permanent Staff Position' : slot.reason %></p>
              </div>
            </div>

            <% if (slot.slotType === 'job') { %>
              <div class="sub-needed-banner sub-needed-banner-ok"><svg class="icon"><use href="#icon-check-circle"/></svg> Normally staffed each session</div>
            <% } %>

            <% if (slot.assigned && slot.assigned.status === 'approved') { %>
              <div class="sub-needed-banner sub-needed-banner-ok"><svg class="icon"><use href="#icon-check-circle"/></svg> Assigned: <%= slot.assigned.name %><% if (slot.assigned.infant) { %> (infant)<% } %></div>
              <form method="POST" action="/admin/volunteers/<%= day %>/substitutes/unassign" class="inline-block-form">
                <input type="hidden" name="date" value="<%= selectedDate %>" />
                <input type="hidden" name="slotType" value="<%= slot.slotType %>" />
                <input type="hidden" name="slotId" value="<%= slot.slotId %>" />
                <button type="submit" class="btn-secondary">Unassign</button>
              </form>
            <% } else { %>
              <% if (slot.assigned) { %>
                <div class="sub-needed-banner sub-needed-banner-pending"><svg class="icon"><use href="#icon-info-circle"/></svg> Needs Approval: <%= slot.assigned.name %><% if (slot.assigned.infant) { %> (infant)<% } %></div>
                <p class="hint">Auto-picked by the ranked sub system.</p>
                <div class="class-schedule-signup-form">
                  <form method="POST" action="/admin/volunteers/<%= day %>/substitutes/approve" class="inline-block-form">
                    <input type="hidden" name="date" value="<%= selectedDate %>" />
                    <input type="hidden" name="slotType" value="<%= slot.slotType %>" />
                    <input type="hidden" name="slotId" value="<%= slot.slotId %>" />
                    <button type="submit" class="primary-btn">Approve</button>
                  </form>
                  <form method="POST" action="/admin/volunteers/<%= day %>/substitutes/unassign" class="inline-block-form">
                    <input type="hidden" name="date" value="<%= selectedDate %>" />
                    <input type="hidden" name="slotType" value="<%= slot.slotType %>" />
                    <input type="hidden" name="slotId" value="<%= slot.slotId %>" />
                    <button type="submit" class="btn-secondary">Unassign</button>
                  </form>
                </div>
              <% } else { %>
                <div class="sub-needed-banner sub-needed-banner-warn"><svg class="icon"><use href="#icon-info-circle"/></svg> No unassigned floaters are currently available for <%= hour.label %>.</div>
              <% } %>

              <div class="sub-needed-assign-box">
                <label for="assign-select-<%= slot.slotType %>-<%= slot.slotId %>">Assign Available Substitute</label>
                <form method="POST" action="/admin/volunteers/<%= day %>/substitutes/assign">
                  <input type="hidden" name="date" value="<%= selectedDate %>" />
                  <input type="hidden" name="slotType" value="<%= slot.slotType %>" />
                  <input type="hidden" name="slotId" value="<%= slot.slotId %>" />
                  <input type="hidden" name="isOverride" value="1" />
                  <select name="memberId" id="assign-select-<%= slot.slotType %>-<%= slot.slotId %>" required>
                    <option value="" disabled selected>Choose someone&hellip;</option>
                    <% (hour.suggestedFloaters || []).forEach(function(p) { %><option value="<%= p.id %>"><%= p.name %><% if (infantByMemberId[p.id]) { %> (infant)<% } %></option><% }); %>
                    <% if (hour.suggestedFloaters && hour.suggestedFloaters.length > 0) { %><option disabled>&mdash;&mdash;&mdash;</option><% } %>
                    <% allParents.forEach(function(p) { %><option value="<%= p.id %>"><%= p.name %></option><% }); %>
                  </select>
                  <button type="submit" class="primary-btn">Assign Substitute</button>
                </form>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% }); %>
  </main>
  <script src="/js/date-list.js"></script>
  <script type="application/json" id="floaters-by-hour-data"><%- floatersByHourJson %></script>
  <script src="/js/floater-grid.js"></script>
</body>
</html>
