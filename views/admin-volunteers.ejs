<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.4in; }</style>
</head>
<body class="admin-page floater-assignments-print-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main" data-day="<%= day %>" data-semester-id="<%= semesterId %>">
    <h1>Floater Assignments</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%# Floater Assignments/Floater Teams/Class Cancellation Risk now live
        as subpages under the orange bar's own Floater Assignments item
        (views/partials/admin-nav.ejs) instead of a trigger+dialog here. %>

    <div class="view-tab-panel">
      <div class="grid-box-header">
        <h2><%= dayLabel %> Floater Assignments</h2>
        <%# A real request: "export and print buttons should be in a row
            under the add/edit dates, add/edit position buttons" - same
            .roster-action-btn class/size as those buttons, in the same
            row rather than up in the toolbar with the semester/day picker. %>
        <div class="roster-btn-row roster-btn-row-fit-text floater-assignments-btn-row no-print">
          <button type="button" class="roster-action-btn" onclick="document.getElementById('edit-dates-dialog').showModal()">Add/Edit Dates</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-job-dialog').showModal()">+ Add/Edit Permanent Positions</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-temp-job-dialog').showModal()">+ Add/Edit Temporary Position</button>
          <%# A real request: "Add a button that says text notification.
              When you click this button a check box appears next to
              each floater assignment. When you click the check boxes
              then click text notifications. It send a notification
              showing the floater position, hour and room number." See
              public/js/floater-text-notify.js. %>
          <button type="button" class="roster-action-btn no-print" id="floater-text-notify-btn">Text Notification</button>
        </div>
        <%# A real request: "export, import, print and pdf icons should
            be in a row side by side. Not in a single column" - see
            views/admin-design.ejs's own matching comment. %>
        <div class="roster-btn-row no-print" data-fixed-columns="3">
          <a class="icon-btn" href="/admin/volunteers/<%= day %>/export.csv?semesterId=<%= semesterId %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
          <%# A real request: "All print button should show a print preview
              full real page on a page with a print button." Same selected-
              date/combo this manage page is on, not a fixed "today" -
              routes/admin-volunteers.js's own /manage/print route resolves
              selectedDate the exact same way this page's own GET route
              does if the query param is left off. %>
          <a class="icon-btn" href="/admin/volunteers/<%= day %>/manage/print?date=<%= selectedDate %>&semesterId=<%= semesterId %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
          <a class="icon-btn" href="/admin/volunteers/<%= day %>/manage/download.pdf?date=<%= selectedDate %>&semesterId=<%= semesterId %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
        </div>
      </div>

      <%# A real request: "choose a date and semester/day drop down
          should be on the same row, shrink to fit... this row should be
          under the icons." The semester/day combo picker used to sit in
          its own toolbar row ABOVE the title/buttons/icons block - it
          now joins Choose Date in this one row instead, which already
          sat right below the icons. .filter-row is the existing
          "two or more filter dropdowns that belong together" shared
          convention (public/css/styles.css) - floater-assignments-
          filter-row is just this page's own hook for the mobile shrink-
          to-fit rule, same page-scoped pattern as .fs-annual-planner-
          add-btn elsewhere. %>
      <div class="filter-row floater-assignments-filter-row no-print">
        <%- include('partials/schedule-combo-picker', { combos, basePrefix: '/admin/volunteers', pathSuffix: '/manage', selectedComboId }) %>
        <div class="category-filter">
          <label for="chart-date-select">Choose Date</label>
          <select id="chart-date-select" onchange="window.fullscreenNavigate('/admin/volunteers/<%= day %>/manage?semesterId=<%= semesterId %>' + (this.value ? '&date=' + this.value : ''))">
            <% if (activeDates.length === 0) { %><option value="">No dates</option><% } %>
            <% activeDates.forEach(function(d) { %>
              <option value="<%= d.date %>" <%= selectedDate === d.date ? 'selected' : '' %>><%= d.label %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <% if (dates.length === 0) { %>
        <p class="roster-empty">Add session dates above first.</p>
      <% } else if (!selectedDate) { %>
        <p class="roster-empty">No dates available - add one above.</p>
      <% } else { %>
        <div id="floater-assign-status" class="alert alert-error no-print" hidden></div>
        <div id="floater-cards-container" data-selected-date="<%= selectedDate %>">
          <%- include('partials/floater-chart-cards', { day, dayLabel, selectedDate, hourSections, semesterId }) %>
        </div>
      <% } %>
    </div>

    <dialog id="edit-dates-dialog" class="volunteer-edit-dialog">
      <h3>Edit Session Dates</h3>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <tbody>
            <% if (dates.length === 0) { %>
              <tr><td class="roster-empty">No dates yet.</td></tr>
            <% } %>
            <% dates.forEach(function(d) { %>
              <tr>
                <td><%= d.label %></td>
                <td class="actions-cell">
                  <form method="POST" action="/admin/volunteers/<%= day %>/dates/<%= d.date %>/remove?dialog=dates&semesterId=<%= semesterId %>" class="inline-block-form" data-confirm="Remove <%= d.label %>? Any position/room assignments for this date will be deleted too.">
                    <button type="submit" class="link-btn link-btn-danger">Remove</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <form method="POST" action="/admin/volunteers/<%= day %>/dates/add?dialog=dates&semesterId=<%= semesterId %>" class="volunteer-date-add-form">
        <input type="date" name="dates" onchange="if (this.value) this.form.requestSubmit();" />
      </form>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
      </div>
    </dialog>

    <%# A real request: "Add position button should say add/edit position.
        When you click it will show a list of the permanent positions
        added and stacked underneath the position it will say what hours
        have been selected with check boxes. Should be able to change
        name of positions, room number and check or uncheck boxes as
        necessary. Orange save button top right closes the window and
        applies the changes." One form posts every group at once (see
        routes/admin-substitutes.js's /permanent-jobs/save-groups) rather
        than each position having its own Save, so unchecking hours on
        several positions and adding a brand new one all lands in a
        single request. %>
    <dialog id="add-job-dialog" class="volunteer-edit-dialog position-editor-dialog">
      <form method="POST" action="/admin/volunteers/<%= day %>/substitutes/permanent-jobs/save-groups?dialog=job&semesterId=<%= semesterId %>">
        <div class="qr-filter-dialog-header">
          <h3>Add/Edit Permanent Positions</h3>
          <div class="qr-filter-dialog-actions">
            <button type="submit" class="primary-btn">Save</button>
            <button type="button" class="class-form-dialog-close" onclick="this.closest('dialog').close()" aria-label="Close"><svg class="icon"><use href="#icon-x-circle"/></svg></button>
          </div>
        </div>
        <input type="hidden" name="date" value="<%= selectedDate %>" />
        <div class="roster-scroll position-group-list">
          <% positionGroups.forEach(function(g) { %>
            <div class="position-group">
              <div class="position-group-fields">
                <input type="text" name="groups[<%= g.keyId %>][title]" value="<%= g.title %>" placeholder="Position title" />
                <input type="text" name="groups[<%= g.keyId %>][room]" value="<%= g.room %>" placeholder="Room # (optional)" />
                <%# A real request: "next to each position in that pop up
                    there should be a trashcan symbol to remove that
                    position." formaction/formmethod override this one
                    submit button's target to the group-delete route
                    instead of the enclosing form's own Save action
                    (save-groups) - no separate <form> needed (dialogs
                    can't nest forms), same technique admin-name-tag.ejs's
                    "Print Barcodes Only" button already uses. %>
                <button
                  type="submit"
                  formaction="/admin/volunteers/<%= day %>/substitutes/permanent-jobs/group/<%= g.keyId %>/delete?dialog=job&semesterId=<%= semesterId %>"
                  formmethod="POST"
                  formnovalidate
                  class="icon-btn icon-btn-danger"
                  aria-label="Delete <%= g.title %>"
                  title="Delete Position"
                ><svg class="icon"><use href="#icon-trash"/></svg></button>
              </div>
              <div class="checkbox-row">
                <% hours.forEach(function(h) { %>
                  <label class="checkbox-option">
                    <input type="checkbox" name="groups[<%= g.keyId %>][hours][]" value="<%= h.position %>" <%= g.hours.includes(h.position) ? 'checked' : '' %> />
                    <%= h.label %>
                  </label>
                <% }); %>
              </div>
            </div>
          <% }); %>
          <div class="position-group">
            <span class="class-card-pill-label">Add New Position</span>
            <div class="position-group-fields">
              <input type="text" name="groups[new][title]" placeholder="Position title (e.g. Front Desk)" />
              <input type="text" name="groups[new][room]" placeholder="Room # (optional)" />
            </div>
            <div class="checkbox-row">
              <% hours.forEach(function(h) { %>
                <label class="checkbox-option">
                  <input type="checkbox" name="groups[new][hours][]" value="<%= h.position %>" />
                  <%= h.label %>
                </label>
              <% }); %>
            </div>
          </div>
        </div>
      </form>
    </dialog>

    <%# Temporary Position - a real request: "add a button on floater
        assignment page that is just like the add/edit permanent position
        button. except this will be called add/edit temporary position.
        same popup and format. however, when a job is added using this
        temporary button the job is only available that day." Same shape
        as add-job-dialog above (one save-groups form for every group at
        once), just scoped to the currently selected date - see
        routes/admin-substitutes.js's /temporary-jobs/save-groups. %>
    <dialog id="add-temp-job-dialog" class="volunteer-edit-dialog position-editor-dialog">
      <form method="POST" action="/admin/volunteers/<%= day %>/substitutes/temporary-jobs/save-groups?dialog=temp-job&semesterId=<%= semesterId %>">
        <div class="qr-filter-dialog-header">
          <h3>Add/Edit Temporary Position</h3>
          <div class="qr-filter-dialog-actions">
            <button type="submit" class="primary-btn">Save</button>
            <button type="button" class="class-form-dialog-close" onclick="this.closest('dialog').close()" aria-label="Close"><svg class="icon"><use href="#icon-x-circle"/></svg></button>
          </div>
        </div>
        <input type="hidden" name="date" value="<%= selectedDate %>" />
        <div class="roster-scroll position-group-list">
          <% temporaryPositionGroups.forEach(function(g) { %>
            <div class="position-group">
              <div class="position-group-fields">
                <input type="text" name="groups[<%= g.keyId %>][title]" value="<%= g.title %>" placeholder="Position title" />
                <input type="text" name="groups[<%= g.keyId %>][room]" value="<%= g.room %>" placeholder="Room # (optional)" />
                <button
                  type="submit"
                  formaction="/admin/volunteers/<%= day %>/substitutes/temporary-jobs/group/<%= g.keyId %>/delete?dialog=temp-job&semesterId=<%= semesterId %>"
                  formmethod="POST"
                  formnovalidate
                  class="icon-btn icon-btn-danger"
                  aria-label="Delete <%= g.title %>"
                  title="Delete Position"
                ><svg class="icon"><use href="#icon-trash"/></svg></button>
              </div>
              <div class="checkbox-row">
                <% hours.forEach(function(h) { %>
                  <label class="checkbox-option">
                    <input type="checkbox" name="groups[<%= g.keyId %>][hours][]" value="<%= h.position %>" <%= g.hours.includes(h.position) ? 'checked' : '' %> />
                    <%= h.label %>
                  </label>
                <% }); %>
              </div>
            </div>
          <% }); %>
          <div class="position-group">
            <span class="class-card-pill-label">Add New Temporary Position</span>
            <div class="position-group-fields">
              <input type="text" name="groups[new][title]" placeholder="Position title (e.g. Front Desk)" />
              <input type="text" name="groups[new][room]" placeholder="Room # (optional)" />
            </div>
            <div class="checkbox-row">
              <% hours.forEach(function(h) { %>
                <label class="checkbox-option">
                  <input type="checkbox" name="groups[new][hours][]" value="<%= h.position %>" />
                  <%= h.label %>
                </label>
              <% }); %>
            </div>
          </div>
        </div>
      </form>
    </dialog>

    <%# A real request: "click send text notification button. A pop up
        appears showing an example of the text message that you can
        edit and add an optional image. Buttons send now or cancel."
        public/js/floater-text-notify.js builds the recipient list and
        a starter example message from whichever checkboxes are
        checked, fills this dialog in, then shows it instead of posting
        straight away - Send Now is what actually fires the request
        (multipart/form-data, since the image rides along as a real
        file). %>
    <dialog id="floater-text-notify-dialog" class="class-form-dialog" data-message-template="<%= floaterMessageTemplate %>">
      <form id="floater-text-notify-form" class="stack-form">
        <div class="class-form-dialog-header">
          <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-mail"/></svg></span>
          <h3>Send Text Notification</h3>
        </div>
        <p class="hint" id="floater-text-notify-recipients-hint"></p>
        <label>Message
          <textarea name="message" id="floater-text-notify-message" rows="4" required></textarea>
        </label>
        <label>Image (optional)
          <input type="file" name="image" accept="image/*" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn" id="floater-text-notify-send-btn">Send Now</button>
        </div>
      </form>
    </dialog>

    <%# Reopens the dialog a redirect (Save, or a position's own trash-icon
        delete below) just came back from, instead of leaving the admin at
        a closed manage page. Dialog ids aren't uniform ("dates" ->
        edit-dates-dialog, but "job" -> add-job-dialog, matching the "+
        Add/Edit Permanent Positions" button's own onclick target above) - a real bug
        this session found while wiring the delete button's own reopen: the
        old guessed id (interpolating "job" into an edit-<name>-dialog
        pattern) silently found nothing and .showModal() on null threw, so
        Save never actually reopened the position dialog either. %>
    <% if (openDialog) { %>
      <% const dialogIds = { dates: 'edit-dates-dialog', job: 'add-job-dialog', 'temp-job': 'add-temp-job-dialog' }; %>
      <script>document.getElementById('<%= dialogIds[openDialog] %>').showModal();</script>
    <% } %>
  </main>
  <script src="/js/date-list.js"></script>
  <script src="/js/floater-assign.js"></script>
  <script src="/js/floater-text-notify.js"></script>
</body>
</html>
