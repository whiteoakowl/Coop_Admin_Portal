<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <%# A real request: "faq should be it's own tab under settings, not
      under website tab." Split out of the Website page (views/main-
      admin-website.ejs used to render this same section) - unchanged
      CRUD/data (the faqs table, routes/main-admin.js's own add/delete),
      just its own tab/route now. %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <%- include('partials/main-admin-settings-tabs', { activeSettingsTab: 'faq' }) %>
    <h1>FAQ</h1>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <section class="portal-dashboard-card portal-dashboard-card-wide">
      <form method="POST" action="/main-admin/faq/add" class="member-form-grid">
        <label class="member-form-full">Question
          <input type="text" name="question" required />
        </label>
        <label class="member-form-full">Answer
          <textarea name="answer" rows="2" required></textarea>
        </label>
        <div class="member-form-full">
          <button type="submit" class="roster-action-btn">Add FAQ</button>
        </div>
      </form>
      <% if (faqs.length === 0) { %>
        <p class="roster-empty">No FAQs yet.</p>
      <% } else { %>
        <div class="site-faq-list">
          <% faqs.forEach(function(faq) { %>
            <details class="site-faq-item">
              <summary><%= faq.question %></summary>
              <p><%= faq.answer %></p>
              <form method="POST" action="/main-admin/faq/<%= faq.id %>/delete" data-confirm="Delete this FAQ?">
                <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
              </form>
            </details>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
