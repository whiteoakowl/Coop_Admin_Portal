<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.4in; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1>Missed Duty / No-Show Log<%= dateFilter ? ` — ${dateFilterLabel}` : '' %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub">Missed Duty / No-Show Log &mdash; <%= dateFilterLabel %></p>
        </div>
      </div>

      <table class="roster-table members-table condensed-table">
        <thead>
          <tr><th>Date</th><th>Name</th><th>Family</th><th>Flagged For</th><th>Missed Setup/Cleanup Total</th><th>No-Show Total</th></tr>
        </thead>
        <tbody>
          <% if (allSubmissions.length === 0) { %>
            <tr><td colspan="6" class="roster-empty">No missed setup/cleanup scans or no-shows<%= dateFilter ? ' for this date' : ' yet' %>.</td></tr>
          <% } %>
          <% allSubmissions.forEach(function(r) { %>
            <tr>
              <td><%= r.dateLabel %></td>
              <td><%= r.memberName %></td>
              <td><%= r.familyName || '—' %></td>
              <td><%= [r.missedScan ? 'Missed Setup/Cleanup' : null, r.noShow ? 'No-Show' : null].filter(Boolean).join(' + ') %></td>
              <td><%= r.scanCount %></td>
              <td><%= r.noShowCount %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
