<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p><a href="/main-admin/photos">&larr; All Albums</a></p>
    <div class="roster-toolbar">
      <div><h1><%= album.title %></h1></div>
      <% if (photos.length > 0) { %>
        <div class="roster-btn-row">
          <a class="roster-action-btn" href="/photos/<%= album.id %>/download">Download Album</a>
        </div>
      <% } %>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Details</h2></div>
      <form method="POST" action="/main-admin/photos/<%= album.id %>" class="member-form-grid">
        <label class="member-form-full">Title
          <input type="text" name="title" value="<%= album.title %>" required />
        </label>
        <label class="member-form-full">Description
          <textarea name="description" rows="2"><%= album.description || '' %></textarea>
        </label>
        <label>Visibility
          <select name="visibility">
            <option value="members" <%= album.visibility === 'members' ? 'selected' : '' %>>Members Only</option>
            <option value="public" <%= album.visibility === 'public' ? 'selected' : '' %>>Public</option>
          </select>
        </label>
        <%# A real request: "add a check box permission for members can
            add photos. If that box is not checked than the album will
            be view only on parent and student portals." %>
        <label class="checkbox-option member-form-full">
          <input type="checkbox" name="allowMemberUploads" value="1" <%= album.allow_member_uploads ? 'checked' : '' %> />
          Members can add photos
        </label>
        <div class="member-form-full">
          <%# A real request: "delete albums button should be clean next
              to save. Archive button added next to it in the same
              row." Same roster-btn-row-nowrap fit-to-content fix used
              elsewhere in this app, so Save/Archive/Delete each size to
              their own text instead of stretching evenly. %>
          <div class="roster-btn-row roster-btn-row-nowrap">
            <button type="submit" class="primary-btn">Save</button>
            <button type="submit" form="archive-album-form" class="roster-action-btn">Archive</button>
            <button type="submit" form="delete-album-form" class="roster-action-btn roster-action-btn-danger">Delete</button>
          </div>
        </div>
      </form>
      <form method="POST" id="archive-album-form" action="/main-admin/photos/<%= album.id %>/archive" data-confirm="Archive &quot;<%= album.title %>&quot;? Members will no longer be able to view or add to it."></form>
      <form method="POST" id="delete-album-form" action="/main-admin/photos/<%= album.id %>/delete" data-confirm="Delete &quot;<%= album.title %>&quot; and all its photos? This cannot be undone."></form>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Cover Photo</h2></div>
      <%# A real request: "allow to upload a cover photo when editing.
          Make sure it save properly." A direct upload instead of the
          roundabout "add it to the gallery below, then Set as Cover"
          flow. %>
      <% if (album.cover_image_key) { %>
        <img src="/photos/<%= album.id %>/cover" alt="" style="width: 160px; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); margin-bottom: 0.75rem;" />
      <% } %>
      <form method="POST" action="/main-admin/photos/<%= album.id %>/cover" enctype="multipart/form-data" class="member-form-grid">
        <label class="member-form-full">Cover Image
          <input type="file" name="coverImage" accept="image/*" required />
        </label>
        <div class="member-form-full">
          <button type="submit" class="primary-btn">Upload Cover Photo</button>
        </div>
      </form>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Add Photos</h2></div>
      <form method="POST" action="/main-admin/photos/<%= album.id %>/photos" enctype="multipart/form-data" class="member-form-grid">
        <label class="member-form-full">Images (JPG/PNG, up to 20 at once)
          <input type="file" name="images" accept="image/*" multiple required />
        </label>
        <label class="member-form-full">Caption (applied to all uploaded in this batch)
          <input type="text" name="caption" />
        </label>
        <div class="member-form-full">
          <button type="submit" class="primary-btn">Upload</button>
        </div>
      </form>
    </div>

    <div class="manage-section">
      <div class="grid-box-header"><h2>Photos</h2></div>
      <% if (photos.length === 0) { %>
        <p class="roster-empty">No photos yet.</p>
      <% } else { %>
        <div class="team-card-grid">
          <% photos.forEach(function(p) { %>
            <div class="team-col">
              <div class="team-info-card">
                <img src="/photos/<%= album.id %>/image/<%= p.id %>" alt="<%= p.caption || '' %>" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); margin-bottom: 0.5rem;" />
                <% if (p.caption) { %><p class="hint"><%= p.caption %></p><% } %>
                <% if (p.status === 'pending') { %><span class="badge-pill badge-pill-orange">Pending Review</span><% } %>
                <% if (p.status === 'rejected') { %><span class="badge-pill badge-pill-gray">Rejected</span><% } %>
                <% if (album.cover_image_key === p.image_key) { %><span class="badge-pill badge-pill-green">Cover</span><% } %>
                <div class="roster-btn-row">
                  <% if (p.status === 'pending') { %>
                    <form method="POST" action="/main-admin/photos/<%= album.id %>/photos/<%= p.id %>/decide" class="inline-block-form">
                      <input type="hidden" name="decision" value="approve" />
                      <button type="submit" class="roster-action-btn">Approve</button>
                    </form>
                    <form method="POST" action="/main-admin/photos/<%= album.id %>/photos/<%= p.id %>/decide" class="inline-block-form">
                      <input type="hidden" name="decision" value="reject" />
                      <button type="submit" class="roster-action-btn roster-action-btn-danger">Reject</button>
                    </form>
                  <% } %>
                  <% if (album.cover_image_key !== p.image_key && p.status === 'approved') { %>
                    <form method="POST" action="/main-admin/photos/<%= album.id %>/photos/<%= p.id %>/cover" class="inline-block-form">
                      <button type="submit" class="roster-action-btn">Set as Cover</button>
                    </form>
                  <% } %>
                  <form method="POST" action="/main-admin/photos/<%= album.id %>/photos/<%= p.id %>/delete" class="inline-block-form">
                    <button type="submit" class="roster-action-btn roster-action-btn-danger">Remove</button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
