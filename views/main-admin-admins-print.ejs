<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.4in; }</style>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Main Admin' }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1>Admins</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub">Admins</p>
        </div>
      </div>

      <table class="roster-table condensed-table admins-table">
        <thead><tr><th>Admin Position</th><th>Admin Name</th><th>Phone</th><th>Email</th></tr></thead>
        <tbody>
          <% if (rows.length === 0) { %>
            <tr><td colspan="4" class="roster-empty">No admin positions added yet.</td></tr>
          <% } %>
          <% rows.forEach(function(row) { %>
            <tr>
              <td><%= row.position.title %></td>
              <td><%= row.member ? row.member.name : '—' %></td>
              <td><%= (row.member && row.member.phone) || '—' %></td>
              <td><%= (row.member && row.member.email) || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
