<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/parent/family-school">&larr; Family School Management</a></p>
    <%# A real request: "Teacher journal should be called daily learning
        log." %>
    <div class="roster-toolbar no-print">
      <h1>Daily Learning Log</h1>
    </div>

    <%# "Add the following buttons to each page. Export, print, download,
        filter. Make sure they are the similar size, same height, fit to
        text." Same restructure as Family Attendance's own toolbar - see
        that view's comment. Export is this one selected student's
        journal entries; Download is every family student's - see
        routes/parent-family-school.js's own /journal/export.csv and
        /journal/download.csv. %>
    <% if (familyStudents.length > 0) { %>
      <div class="roster-btn-row roster-btn-row-fit-text no-print">
        <a class="icon-btn" href="/parent/family-school/journal/export.csv?studentId=<%= selectedStudentId %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <button type="button" class="icon-btn" onclick="window.print()" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></button>
        <a class="icon-btn" href="/parent/family-school/journal/download.csv" aria-label="Download CSV" title="Download CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <details class="filter-details">
          <summary class="roster-action-btn">Filter</summary>
          <form method="GET" action="/parent/family-school/journal" class="filter-panel">
            <label for="journal-student-select">Student</label>
            <select id="journal-student-select" name="studentId" onchange="this.form.submit()">
              <% familyStudents.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= selectedStudentId === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }); %>
            </select>
          </form>
        </details>
      </div>
    <% } %>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (familyStudents.length === 0) { %>
      <p class="roster-empty">No students in your family yet.</p>
    <% } else { %>
      <%# "Add journal/notes entry by date and by student in the family.
          Full edit description typing box." Same rich-text contenteditable
          editor the rest of this app uses for a real description field. %>
      <div class="manage-section">
        <div class="grid-box-header">
          <h2>New Entry</h2>
        </div>
        <form method="POST" action="/parent/family-school/journal" enctype="multipart/form-data" class="member-form-grid">
          <input type="hidden" name="studentId" value="<%= selectedStudentId %>" />
          <label class="member-form-full">Date
            <input type="date" name="entryDate" value="<%= new Date().toISOString().slice(0, 10) %>" required />
          </label>
          <div class="member-form-full" data-forum-editor>
            <label>Notes</label>
            <%- include('partials/forum-editor-toolbar') %>
            <div class="forum-editable" data-forum-editable contenteditable="true"></div>
            <input type="hidden" name="body" data-forum-body-input />
          </div>
          <%# A real request: "Be able to upload images or documents to
              daily learning log." Up to 5 files at once - see
              routes/parent-family-school.js's own uploadJournalAttachments. %>
          <label class="member-form-full">Attachments <span class="hint">(optional - images or documents, up to 5 files)</span>
            <input type="file" name="attachments" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp" multiple />
          </label>
          <div class="member-form-full">
            <button type="submit" class="primary-btn">Add Journal Entry</button>
          </div>
        </form>
      </div>

      <%# "Then a log below showing all entries." Newest first
          (journalEntriesForStudent's own ORDER BY). %>
      <div class="manage-section">
        <div class="grid-box-header">
          <h2>Log (<%= entries.length %>)</h2>
        </div>
        <% if (entries.length === 0) { %>
          <p class="roster-empty">No journal entries yet.</p>
        <% } else { %>
          <div class="fs-journal-log">
            <% entries.forEach(function(e) { %>
              <div class="fs-journal-entry">
                <div class="fs-journal-entry-header">
                  <strong><%= e.entry_date %></strong>
                  <form method="POST" action="/parent/family-school/journal/<%= e.id %>/delete" onsubmit="return confirm('Remove this journal entry?');" class="inline-block-form">
                    <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete entry" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                </div>
                <div class="forum-editable-display"><%- e.body %></div>
                <% if (e.attachments && e.attachments.length > 0) { %>
                  <div class="fs-journal-attachments">
                    <% e.attachments.forEach(function(a) { %>
                      <div class="fs-journal-attachment">
                        <% if ((a.content_type || '').startsWith('image/')) { %>
                          <a href="<%= a.url %>" target="_blank" class="fs-journal-attachment-image-link">
                            <img src="<%= a.url %>" alt="<%= a.file_name %>" class="fs-journal-attachment-image" />
                          </a>
                        <% } else { %>
                          <a href="<%= a.url %>" target="_blank" class="fs-journal-attachment-file-link">
                            <svg class="icon"><use href="#icon-file-text"/></svg> <%= a.file_name %>
                          </a>
                        <% } %>
                        <form method="POST" action="/parent/family-school/journal/<%= e.id %>/attachments/<%= a.id %>/delete" onsubmit="return confirm('Remove this attachment?');" class="inline-block-form">
                          <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete attachment" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                        </form>
                      </div>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    <% } %>
  </main>
</body>
</html>
