<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1>Custom Forms</h1>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('new-form-dialog').showModal()">+ New Form</button>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (forms.length === 0) { %>
      <p class="roster-empty">No forms yet &mdash; create one above.</p>
    <% } %>

    <div class="team-card-grid">
      <% forms.forEach(function(f) { %>
        <div class="team-col">
          <div class="team-info-card">
            <span class="team-info-icon"><svg class="icon"><use href="#icon-clipboard-list"/></svg></span>
            <h3 class="team-info-title"><a href="/main-admin/forms/<%= f.id %>/builder"><%= f.title %></a></h3>
            <span class="badge-pill badge-pill-<%= f.status === 'published' ? 'green' : f.status === 'closed' ? 'gray' : 'orange' %>"><%= f.status.charAt(0).toUpperCase() + f.status.slice(1) %></span>
            <p class="hint"><%= f.submissionCount %> submission<%= f.submissionCount == 1 ? '' : 's' %></p>
            <div class="roster-btn-row">
              <a class="roster-action-btn" href="/main-admin/forms/<%= f.id %>/builder">Edit</a>
              <a class="roster-action-btn" href="/main-admin/forms/<%= f.id %>/submissions">Submissions</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <dialog id="new-form-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/forms">
        <h3>New Form</h3>
        <label>Title
          <input type="text" name="title" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
