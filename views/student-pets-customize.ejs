<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>
  <%- include('partials/pet-sprites') %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <% if (!isNew) { %><p><a href="/student/pets">&larr; Back to My Pet</a></p><% } %>
    <h1><%= isNew ? 'Choose Your Pet' : 'Edit Your Pet' %></h1>
    <p class="hint">Use the arrows to pick a pet, then name it and save!</p>

    <div class="pet-stage">
      <div class="pet-picker-row">
        <button type="button" class="pet-trait-arrow pet-picker-arrow" id="pet-picker-prev" data-dir="-1" aria-label="Previous pet"><svg class="icon"><use href="#icon-chevron-down"/></svg></button>
        <div class="pet-stage-frame" id="pet-preview-frame">
          <img id="pet-preview-img" class="pet-display-photo" alt="" hidden="hidden" />
          <svg id="pet-preview" class="pet-display" viewBox="0 0 120 120" hidden="hidden">
            <use id="pet-preview-body" href="#pet-body-dog"/>
            <use id="pet-preview-ears" href="#pet-ears-floppy"/>
            <use id="pet-preview-eyes" href="#pet-eyes-round"/>
            <use id="pet-preview-mouth" href="#pet-mouth-smile"/>
            <use id="pet-preview-accessory" href="#pet-accessory-none"/>
          </svg>
        </div>
        <button type="button" class="pet-trait-arrow pet-picker-arrow" id="pet-picker-next" data-dir="1" aria-label="Next pet"><svg class="icon"><use href="#icon-chevron-down"/></svg></button>
      </div>
      <p class="pet-picker-label" id="pet-picker-label"></p>
    </div>

    <form method="POST" action="/student/pets/customize" id="pet-customize-form" class="stack-form member-form-page-panel">
      <label class="member-form-full">Pet Name
        <input type="text" name="name" id="pet-name-input" maxlength="40" placeholder="Name your pet" value="<%= petName %>" required />
      </label>

      <input type="hidden" name="look" id="pet-input-look" />

      <div class="member-form-footer">
        <div class="member-form-footer-edit">
          <button type="button" class="btn-secondary" id="pet-randomize-btn"><svg class="icon"><use href="#icon-shuffle"/></svg> Surprise Me</button>
          <button type="submit" class="primary-btn"><svg class="icon"><use href="#icon-lock"/></svg> Save Pet</button>
        </div>
      </div>
    </form>
  </main>

  <script>
    (function () {
      var LOOKS = <%- JSON.stringify(looks) %>;
      var currentLook = <%- JSON.stringify(currentLook) %>;

      var index = Math.max(0, LOOKS.findIndex(function (l) { return l.key === currentLook; }));

      var frame = document.getElementById('pet-preview-frame');
      var imgEl = document.getElementById('pet-preview-img');
      var svgEl = document.getElementById('pet-preview');

      function cycle(dir) {
        index = (index + dir + LOOKS.length) % LOOKS.length;
        render();
      }

      function render() {
        var look = LOOKS[index];
        document.getElementById('pet-picker-label').textContent = look.label;
        document.getElementById('pet-input-look').value = look.key;

        // SVGElement doesn't reliably reflect the `.hidden` IDL property
        // to the actual `hidden` content attribute the way HTMLElement
        // does (a real cross-browser gotcha, found by the black-cat
        // body silently failing to un-hide) - setAttribute/removeAttribute
        // work correctly on both element types, so use those instead.
        if (look.image) {
          imgEl.src = look.image;
          imgEl.alt = look.label;
          imgEl.removeAttribute('hidden');
          svgEl.setAttribute('hidden', '');
          frame.className = 'pet-stage-frame pet-stage-frame--photo';
        } else {
          var svg = look.svg;
          document.getElementById('pet-preview-body').setAttribute('href', '#pet-body-' + svg.species);
          document.getElementById('pet-preview-ears').setAttribute('href', '#pet-ears-' + svg.ears);
          document.getElementById('pet-preview-eyes').setAttribute('href', '#pet-eyes-' + svg.eyes);
          document.getElementById('pet-preview-mouth').setAttribute('href', '#pet-mouth-' + svg.mouth);
          document.getElementById('pet-preview-accessory').setAttribute('href', '#pet-accessory-' + svg.accessory);
          svgEl.style.color = svg.hex;
          svgEl.style.setProperty('--eye-color', svg.eyeColor);
          imgEl.setAttribute('hidden', '');
          svgEl.removeAttribute('hidden');
          frame.className = 'pet-stage-frame ' + svg.roomTheme;
        }

        // Smooth transition between choices (a real request: "smooth
        // transitions") - a quick pop on whichever element is visible.
        var visible = look.image ? imgEl : svgEl;
        visible.classList.remove('pet-preview-pop');
        void visible.offsetWidth;
        visible.classList.add('pet-preview-pop');
      }

      document.getElementById('pet-picker-prev').addEventListener('click', function () { cycle(-1); });
      document.getElementById('pet-picker-next').addEventListener('click', function () { cycle(1); });
      document.getElementById('pet-randomize-btn').addEventListener('click', function () {
        index = Math.floor(Math.random() * LOOKS.length);
        render();
      });

      render();
    })();
  </script>
</body>
</html>
