<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1>Documents</h1>
      <%# A real request: "document upload is currently under settings.
          It should move to the documents page and be a button called
          add/edit documents." Replaces the old Settings > Documents tab
          (views/admin-settings.ejs) entirely - upload and the existing
          list (with Copy Link/delete) live in this one popup. A later
          real request moved per-document editing onto each card's own
          edit icon instead (see the visibility dialog below) - "Add/edit
          documents should only say add documents" - this popup is upload-
          only now. %>
      <button type="button" class="primary-btn" onclick="document.getElementById('manage-documents-dialog').showModal()">Add Documents</button>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (documents.length === 0) { %>
      <p class="hint">No documents uploaded yet. Add one with Add Documents above.</p>
    <% } else { %>
      <%
        var docColors = ['landing-card-orange', 'landing-card-purple', 'landing-card-green'];
      %>
      <div class="landing-grid documents-grid landing-card-rect">
        <% documents.forEach(function(d, i) { %>
          <div class="document-card-wrap">
            <%# A real request: "on the document click card with title
                below it, all one card" - the image (when set) replaces
                the generic file icon, title stays below it either way. %>
            <a class="landing-card <%= docColors[i % docColors.length] %>" href="/admin/documents/<%= d.id %>/view">
              <% if (d.image_path) { %>
                <img class="landing-card-image" src="/admin/documents/<%= d.id %>/image" alt="" />
              <% } else { %>
                <span class="landing-icon"><svg class="icon"><use href="#icon-file-text"/></svg></span>
              <% } %>
              <span class="landing-label"><%= d.title %></span>
            </a>
            <%# A real request: "edit icon top right corner of every
                document... when clicking edit icon you can control which
                portals can view the documents" - a sibling of the card's
                own <a> (not nested inside it) so clicking the icon never
                also navigates to the document's view page. %>
            <button type="button" class="document-card-edit-btn" aria-label="Edit who can view &quot;<%= d.title %>&quot;" title="Edit visibility" onclick="document.getElementById('doc-roles-dialog-<%= d.id %>').showModal()">
              <svg class="icon"><use href="#icon-edit"/></svg>
            </button>
          </div>
        <% }); %>
      </div>

      <% documents.forEach(function(d) { %>
        <dialog id="doc-roles-dialog-<%= d.id %>" class="member-picker-dialog">
          <h3>Who Can View &quot;<%= d.title %>&quot;?</h3>
          <form method="POST" action="/admin/documents/<%= d.id %>/roles">
            <p class="hint">Leave every box unchecked to show this document to every portal (today's default). Check one or more to limit it to just those portals.</p>
            <div class="checkbox-group-boxed">
              <% roles.forEach(function(r) { %>
                <label class="checkbox-option"><input type="checkbox" name="roleKeys" value="<%= r.key %>" <%= d.roleKeys.includes(r.key) ? 'checked' : '' %> /> <%= r.label %></label>
              <% }); %>
            </div>
            <div class="notes-dialog-actions">
              <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
              <button type="submit" class="primary-btn">Save</button>
            </div>
          </form>
        </dialog>
      <% }); %>
    <% } %>

    <dialog id="manage-documents-dialog" class="member-picker-dialog">
      <h3>Add Documents</h3>

      <div class="manage-section">
        <h4>Upload Document</h4>
        <p class="hint">Add a PDF or Word document to show as a card on this page. An optional image shows on its line below and on its own card.</p>
        <% if (storageConfigured) { %>
          <form id="document-upload-form" data-direct-upload="true" data-upload-base="/admin/documents" class="stack-form stack-form-narrow">
            <label for="docTitle">Title</label>
            <input id="docTitle" name="title" type="text" placeholder="e.g. Parent Handbook" />

            <label for="docFile">File (PDF or Word)</label>
            <input id="docFile" name="file" type="file" accept=".pdf,.doc,.docx" required />

            <label for="docImage">Image (optional)</label>
            <input id="docImage" name="image" type="file" accept="image/*" />

            <button type="submit" class="primary-btn">Upload</button>
            <p class="hint" data-upload-status></p>
          </form>
        <% } else { %>
          <form method="POST" action="/admin/documents/upload" enctype="multipart/form-data" class="stack-form stack-form-narrow">
            <label for="docTitle">Title</label>
            <input id="docTitle" name="title" type="text" placeholder="e.g. Parent Handbook" />

            <label for="docFile">File (PDF or Word)</label>
            <input id="docFile" name="file" type="file" accept=".pdf,.doc,.docx" required />

            <label for="docImage">Image (optional)</label>
            <input id="docImage" name="image" type="file" accept="image/*" />

            <button type="submit" class="primary-btn">Upload</button>
          </form>
        <% } %>
      </div>

      <div class="manage-section">
        <h4>Uploaded Documents</h4>
        <% if (documents.length === 0) { %>
          <p class="hint">No documents uploaded yet.</p>
        <% } else { %>
          <div class="store-options-list">
            <% documents.forEach(function(d) { %>
              <div class="document-manage-row">
                <% if (d.image_path) { %>
                  <img class="document-manage-row-thumb" src="/admin/documents/<%= d.id %>/image" alt="" />
                <% } %>
                <div class="document-manage-row-info">
                  <span class="document-manage-row-title"><%= d.title %></span>
                  <span class="hint"><%= d.original_name %></span>
                </div>
                <div class="roster-btn-row">
                  <button type="button" class="roster-action-btn" data-copy-link="<%= publicOrigin %>/documents/<%= d.public_token %>">Copy Link</button>
                  <form method="POST" action="/admin/documents/<%= d.id %>/delete" data-confirm="Delete &quot;<%= d.title %>&quot;?">
                    <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= d.title %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>

      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
      </div>
    </dialog>
  </main>
  <script src="/js/document-upload.js"></script>
  <script src="/js/copy-link.js"></script>
</body>
</html>
