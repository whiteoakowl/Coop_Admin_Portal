<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main badge-print-main">
    <div class="print-preview-header no-print">
      <h1><%= memberName %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <% cards.forEach(function(c) { %>
        <div class="member-card-print-block">
          <h2 class="no-print"><%= c.heading %></h2>
          <%- include('partials/name-tag-badge', { html: c.html, bgCss: c.bgCss, badgeWidth: c.width, badgeHeight: c.height }) %>
        </div>
      <% }); %>
    </div>
  </main>
  <script src="/js/vendor/jsbarcode.min.js"></script>
  <script src="/js/name-tag-render.js"></script>
  <script src="/js/print-auto.js"></script>
</body>
</html>
