<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle no-print"><a href="/admin/orientation">&larr; Orientation Tracking</a></p>
    <h1>Orientation Settings</h1>
    <%# A real request: "Add button for orientation settings to Link
        training... with each circle check mark column", later refined
        to "the links for the column check boxes should be dropdown
        menus of trainings that have been created" - link an actual
        Training from the Training module to a column: completing it
        there automatically checks that column for that member
        (utils/orientation.js's own applyTrainingCompletion, called from
        utils/training.js whenever a training is finalized as passed),
        and that column's header on the main Orientation Tracking list
        links straight to it instead of being a plain label. %>
    <p class="hint">Link an actual Training from the Training module to each orientation column. Leave one set to "No linked training" to keep that column a plain label with no auto-check.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <form method="POST" action="/admin/orientation/settings" class="member-form-grid">
      <% [
        ['video', 'Parent Orientation'],
        ['teacherTraining', 'Teacher Orientation'],
        ['tour', 'Tour'],
        ['openHouse', 'Open House'],
      ].forEach(function(pair) { var field = pair[0], label = pair[1]; %>
        <label class="member-form-full"><%= label %> - Linked Training
          <select name="<%= field %>TrainingId">
            <option value="">No linked training</option>
            <% trainings.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= trainingLinks[field] === t.id ? 'selected' : '' %>><%= t.title %></option>
            <% }); %>
          </select>
        </label>
      <% }); %>
      <div class="member-form-full">
        <button type="submit" class="primary-btn">Save Orientation Settings</button>
      </div>
    </form>
  </main>
</body>
</html>
