<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/users', icon: 'user-check', label: 'Users' },
      { href: '/main-admin/roles', icon: 'sliders', label: 'Roles & Permissions' },
      { href: '/main-admin/website', icon: 'palette', label: 'Website' },
      { href: '/main-admin/events', icon: 'calendar-check', label: 'Events' },
      { href: '/main-admin/directory', icon: 'map-pin', label: 'Business Directory' },
      { href: '/main-admin/classifieds', icon: 'tag', label: 'Classifieds' },
      { href: '/main-admin/member-directory', icon: 'users', label: 'Member Directory' },
      { href: '/main-admin/forums', icon: 'users', label: 'Forums' },
      { href: '/main-admin/forms', icon: 'clipboard-list', label: 'Custom Forms' },
      { href: '/main-admin/accounting', icon: 'file-text', label: 'Accounting' },
      { href: '/main-admin/store', icon: 'tag', label: 'Store' },
      { href: '/main-admin/newsletter', icon: 'mail', label: 'Newsletter' },
      { href: '/main-admin/notifications', icon: 'bell', label: 'Notifications' },
      { href: '/main-admin/photos', icon: 'image', label: 'Photos' },
      { href: '/main-admin/publications', icon: 'book', label: 'Publications' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1>Publications</h1>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('new-pub-dialog').showModal()">+ New Article</button>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <table class="roster-table members-table condensed-table">
      <thead>
        <tr><th>Title</th><th>Status</th><th>Visibility</th><th></th></tr>
      </thead>
      <tbody>
        <% items.forEach(function(i) { %>
          <tr>
            <td><a href="/main-admin/publications/<%= i.id %>/edit"><%= i.title %></a></td>
            <td><span class="badge-pill badge-pill-<%= i.status === 'published' ? 'green' : 'gray' %>"><%= i.status.charAt(0).toUpperCase() + i.status.slice(1) %></span></td>
            <td><%= i.visibility === 'public' ? 'Public' : 'Members Only' %></td>
            <td><a class="roster-action-btn" href="/main-admin/publications/<%= i.id %>/edit">Edit</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <dialog id="new-pub-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/publications">
        <h3>New Article</h3>
        <label>Title
          <input type="text" name="title" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create Draft</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
