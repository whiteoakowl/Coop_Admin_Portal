<!doctype html>
<html lang="en">
<head>
  <% if (typeof pdfBaseUrl !== 'undefined' && pdfBaseUrl) { %><base href="<%= pdfBaseUrl %>/"><% } %>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0.5in; }</style>
</head>
<body class="admin-page">
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1>Family Grades</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Family Grades</p>
      </div>
    </div>

    <% if (mode === 'single') { %>
      <h2><%= studentLabel %></h2>
      <% if (grades.length === 0) { %>
        <p class="roster-empty">No gradable assignments yet.</p>
      <% } else { %>
        <table class="roster-table">
          <thead><tr><th>Class</th><th>Lesson</th><th>Assignment</th><th>Due</th><th>Submitted</th><th>Grade</th></tr></thead>
          <tbody>
            <% grades.forEach(function(g) { %>
              <tr>
                <td><%= g.class_name %></td>
                <td><%= g.lesson_title %></td>
                <td><%= g.item_title || '(untitled)' %></td>
                <td><%= g.dueDateLabel || '—' %></td>
                <td><%= g.submission_id ? 'Yes' : 'Not yet' %></td>
                <td><%= g.grade_letter || (g.points_earned != null ? g.points_earned + (g.points_possible != null ? '/' + g.points_possible : '') : '—') %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    <% } else { %>
      <%# Download PDF mode - every family student's own grades, the
          same scope family-grades-all.csv used before this became a
          PDF (routes/parent-family-school.js's own /grades/download.pdf). %>
      <% familyRows.forEach(function(group) { %>
        <div class="fs-print-family-section">
          <h2><%= group.student.name %></h2>
          <% if (group.grades.length === 0) { %>
            <p class="roster-empty">No gradable assignments yet.</p>
          <% } else { %>
            <table class="roster-table">
              <thead><tr><th>Class</th><th>Lesson</th><th>Assignment</th><th>Due</th><th>Submitted</th><th>Points</th><th>Grade</th></tr></thead>
              <tbody>
                <% group.grades.forEach(function(g) { %>
                  <tr>
                    <td><%= g.class_name %></td>
                    <td><%= g.lesson_title %></td>
                    <td><%= g.item_title || '(untitled)' %></td>
                    <td><%= g.dueDateLabel || '—' %></td>
                    <td><%= g.submission_id ? 'Yes' : 'Not yet' %></td>
                    <td><%= g.points_earned != null ? g.points_earned : '—' %><% if (g.points_possible != null) { %>/<%= g.points_possible %><% } %></td>
                    <td><%= g.grade_letter || '—' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </main>
</body>
</html>
