<!doctype html>
<html lang="en">
<head>
  <% if (typeof pdfBaseUrl !== 'undefined' && pdfBaseUrl) { %><base href="<%= pdfBaseUrl %>/"><% } %>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter landscape; margin: 0.4in; }</style>
</head>
<body class="admin-page">
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= week.title %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>
    <%# A real request: "Print should show the whole week on one page
        clean. Title should be the students name and the date range for
        the week." %>
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title"><%= ownerLabel %></p>
        <p class="print-header-sub"><%= week.title %> &mdash; <%= dateRangeLabel %></p>
      </div>
    </div>

    <table class="roster-table fs-weekly-plan-grid fs-weekly-plan-print-grid">
      <thead>
        <tr>
          <% dates.forEach(function(d) { %><th><%= d.dateLabel %></th><% }); %>
        </tr>
      </thead>
      <tbody>
        <tr>
          <% dates.forEach(function(d) { %>
            <td>
              <% if (d.assignments.length === 0) { %>
                <p class="roster-empty">&nbsp;</p>
              <% } else { %>
                <ul class="fs-weekly-plan-assignment-list">
                  <% d.assignments.forEach(function(a) { %>
                    <li><% if (a.subject) { %><strong><%= a.subject %>:</strong> <% } %><%= a.title %></li>
                  <% }); %>
                </ul>
              <% } %>
            </td>
          <% }); %>
        </tr>
      </tbody>
    </table>
  </main>
</body>
</html>
