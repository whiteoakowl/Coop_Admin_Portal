<!doctype html>
<html lang="en">
<head>
  <% if (typeof pdfBaseUrl !== 'undefined' && pdfBaseUrl) { %><base href="<%= pdfBaseUrl %>/"><% } %>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter landscape; margin: 0.4in; }</style>
</head>
<body class="admin-page">
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= week.title %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>
    <%# A real request: "Print should show the whole week on one page
        clean. Title should be the students name and the date range for
        the week." %>
    <%- include('partials/family-school-print-header', { familySettings, subtitle: `${ownerLabel} — ${week.title} — ${dateRangeLabel}` }) %>

    <table class="roster-table fs-weekly-plan-grid fs-weekly-plan-print-grid">
      <thead>
        <tr>
          <%# "Check box on each day for teacher to confirm the day is
              complete" - printed as a plain checkmark prefix, read-only
              here same as every other checkbox on paper. %>
          <% dates.forEach(function(d) { %><th><% if (d.completed) { %>&#9745; <% } %><%= d.dateLabel %></th><% }); %>
        </tr>
      </thead>
      <tbody>
        <tr>
          <% dates.forEach(function(d) { %>
            <td>
              <% if (d.assignments.length === 0) { %>
                <p class="roster-empty">&nbsp;</p>
              <% } else { %>
                <ul class="fs-weekly-plan-assignment-list">
                  <% d.assignments.forEach(function(a) { %>
                    <li>
                      <%= a.completed ? '☑' : '☐' %>
                      <% if (a.subject) { %><strong><%= a.subject %>:</strong> <% } %><%= a.title %>
                      <% if (a.grade) { %> (Grade: <%= a.grade %>)<% } %>
                      <% if (a.description) { %><br /><span class="hint"><%= a.description %></span><% } %>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </td>
          <% }); %>
        </tr>
      </tbody>
    </table>

    <div class="manage-section">
      <h2>This Week by Subject</h2>
      <%- include('partials/family-school-subject-chart', { subjectBreakdown }) %>
    </div>
  </main>
</body>
</html>
