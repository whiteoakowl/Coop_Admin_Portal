<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Members</h1>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (notice) { %>
      <div class="alert alert-success"><%= notice %></div>
    <% } %>

    <div class="quick-add-row">
      <form method="POST" action="/admin/members" class="inline-form-flat">
        <input type="text" name="name" placeholder="Member's name" required />
        <button type="submit">+ Add Member</button>
      </form>
      <form method="POST" action="/admin/members/import" enctype="multipart/form-data" class="inline-form-flat">
        <input type="file" name="file" accept=".csv,.txt" required />
        <button type="submit">Import from File</button>
      </form>
    </div>

    <div class="roster-scroll">
      <table class="roster-table members-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Barcode</th>
            <th>Rosters</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% members.forEach(function(m) { %>
            <tr>
              <td>
                <form method="POST" action="/admin/members/<%= m.id %>/edit" class="edit-name-form">
                  <input type="text" name="name" value="<%= m.name %>" onblur="if (this.value.trim() && this.value !== this.defaultValue) this.form.submit();" />
                </form>
              </td>
              <td class="mono"><%= m.barcode %></td>
              <td>
                <% if (m.rosters.length === 0) { %>
                  <span class="hint">none</span>
                <% } else { %>
                  <% m.rosters.forEach(function(r) { %>
                    <span class="badge-pill"><%= r.name %></span>
                  <% }); %>
                <% } %>
              </td>
              <td class="actions-cell">
                <button
                  type="button"
                  class="icon-btn<%= m.notes ? ' icon-btn-active' : '' %>"
                  onclick="document.getElementById('notes-dialog-<%= m.id %>').showModal()"
                  aria-label="Notes for <%= m.name %>"
                  title="Notes"
                >📝</button>
                <dialog id="notes-dialog-<%= m.id %>" class="notes-dialog">
                  <form method="POST" action="/admin/members/<%= m.id %>/notes">
                    <h3>Notes &mdash; <%= m.name %></h3>
                    <textarea name="notes" rows="5" placeholder="Write a note about this member&hellip;"><%= m.notes || '' %></textarea>
                    <div class="notes-dialog-actions">
                      <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                      <button type="submit" class="primary-btn">Save</button>
                    </div>
                  </form>
                </dialog>
                <form method="POST" action="/admin/members/<%= m.id %>/delete" id="delete-form-<%= m.id %>"></form>
                <select class="member-action-select" onchange="
                    if (this.value === 'manage') { location.href = '/admin/members/<%= m.id %>/manage'; }
                    else if (this.value === 'delete') {
                      if (confirm('Permanently delete this member? This removes them from all rosters, volunteer lists, the absence list, and all attendance history. This cannot be undone.')) {
                        document.getElementById('delete-form-<%= m.id %>').submit();
                      }
                    }
                    this.selectedIndex = 0;
                  ">
                  <option value="" selected disabled>Actions&hellip;</option>
                  <option value="manage">Manage</option>
                  <option value="delete">Delete</option>
                </select>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
