<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Members</h1>
    <p class="subtitle">The full member list. Every member here is available on the Absence/Late form, and can be added to any roster.</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (notice) { %>
      <div class="alert alert-success"><%= notice %></div>
    <% } %>

    <div class="quick-add-row">
      <form method="POST" action="/admin/members" class="inline-form-flat">
        <input type="text" name="name" placeholder="Member's name" required />
        <button type="submit" class="btn-secondary">+ Add Member</button>
      </form>
      <form method="POST" action="/admin/members/import" enctype="multipart/form-data" class="inline-form-flat">
        <input type="file" name="file" accept=".csv,.txt" required />
        <button type="submit" class="btn-secondary">Import from File</button>
      </form>
    </div>

    <div class="roster-scroll">
      <table class="roster-table members-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Barcode</th>
            <th>Rosters</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% members.forEach(function(m) { %>
            <tr class="<%= m.active ? '' : 'row-inactive' %>">
              <td>
                <form method="POST" action="/admin/members/<%= m.id %>/edit" class="edit-name-form">
                  <input type="text" name="name" value="<%= m.name %>" />
                  <button type="submit" class="link-btn">Save</button>
                </form>
              </td>
              <td class="mono"><%= m.barcode %></td>
              <td>
                <% if (m.rosters.length === 0) { %>
                  <span class="hint">none</span>
                <% } else { %>
                  <% m.rosters.forEach(function(r) { %>
                    <span class="badge-pill"><%= r.name %></span>
                  <% }); %>
                <% } %>
                <a class="link-btn" href="/admin/rosters">manage</a>
              </td>
              <td><%= m.active ? 'Active' : 'Inactive' %></td>
              <td class="actions-cell">
                <a class="link-btn" href="/admin/members/<%= m.id %>/badge" target="_blank">Print Badge</a>
                <form method="POST" action="/admin/members/<%= m.id %>/toggle-active" class="inline-block-form">
                  <button type="submit" class="link-btn"><%= m.active ? 'Deactivate' : 'Reactivate' %></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
