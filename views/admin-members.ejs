<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Members</p>
      </div>
    </div>
    <h1>Members</h1>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (notice) { %>
      <div class="alert alert-success"><%= notice %></div>
    <% } %>

    <div class="quick-add-row no-print">
      <a class="btn-secondary" href="/admin/members/new">+ Add Member</a>
      <button type="button" class="btn-secondary" onclick="document.getElementById('import-dialog').showModal()">Import from File</button>
      <button type="button" class="btn-secondary" onclick="window.print()">Print</button>
    </div>

    <dialog id="import-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/members/import" enctype="multipart/form-data">
        <h3>Import from File</h3>
        <p class="hint">Upload a .csv, .txt, or .xlsx file. Not sure of the format? <a href="/admin/members/import-template.xlsx">Download an example spreadsheet</a>.</p>
        <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Import</button>
        </div>
      </form>
    </dialog>

    <div class="roster-scroll">
      <table class="roster-table members-table">
        <thead>
          <tr>
            <th class="members-col-photo"></th>
            <th>Name</th>
            <th>Type</th>
            <th class="members-col-parent">Parent</th>
            <th class="members-col-rosters">Rosters</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% members.forEach(function(m) { %>
            <tr>
              <td class="members-col-photo">
                <% if (m.photo_path) { %>
                  <img class="member-thumb" src="<%= m.photo_path %>" alt="" />
                <% } else { %>
                  <span class="member-thumb-placeholder"><%= m.name.charAt(0).toUpperCase() %></span>
                <% } %>
              </td>
              <td><a href="/admin/members/<%= m.id %>/edit"><%= m.name %></a></td>
              <td><span class="badge-pill"><%= m.member_type === 'parent' ? 'Parent' : m.member_type === 'admin' ? 'Admin' : 'Student' %></span></td>
              <td class="members-col-parent"><%= m.parentName || '—' %></td>
              <td class="members-col-rosters">
                <% if (m.rosters.length === 0) { %>
                  <span class="hint">none</span>
                <% } else { %>
                  <% m.rosters.forEach(function(r) { %>
                    <span class="badge-pill"><%= r.name %></span>
                  <% }); %>
                <% } %>
              </td>
              <td class="actions-cell">
                <div class="actions-btn-row">
                  <button
                    type="button"
                    class="icon-btn<%= m.notes ? ' icon-btn-active' : '' %>"
                    onclick="document.getElementById('notes-dialog-<%= m.id %>').showModal()"
                    aria-label="Notes for <%= m.name %>"
                    title="Notes"
                  ><svg class="icon"><use href="#icon-edit"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    onclick="var d = document.getElementById('badge-dialog-<%= m.id %>'); d.showModal(); renderNameTagBarcodes(d);"
                    aria-label="View name tag for <%= m.name %>"
                    title="View Name Tag"
                  ><svg class="icon"><use href="#icon-badge"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    onclick="if (confirm('Permanently delete this member? This removes them from all rosters, volunteer lists, and all attendance history. This cannot be undone.')) { document.getElementById('delete-form-<%= m.id %>').submit(); }"
                    aria-label="Delete <%= m.name %>"
                    title="Delete"
                  ><svg class="icon"><use href="#icon-trash"/></svg></button>
                </div>
                <dialog id="notes-dialog-<%= m.id %>" class="notes-dialog">
                  <form method="POST" action="/admin/members/<%= m.id %>/notes">
                    <h3>Notes &mdash; <%= m.name %></h3>
                    <textarea name="notes" rows="5" placeholder="Write a note about this member&hellip;"><%= m.notes || '' %></textarea>
                    <div class="notes-dialog-actions">
                      <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                      <button type="submit" class="primary-btn">Save</button>
                    </div>
                  </form>
                </dialog>
                <dialog id="badge-dialog-<%= m.id %>" class="badge-preview-dialog">
                  <h3>Name Tag &mdash; <%= m.name %></h3>
                  <%- include('partials/name-tag-badge', { layout: m.badgeLayout, data: m.badgeData, badgeWidth: badgeWidth, badgeHeight: badgeHeight }) %>
                  <div class="notes-dialog-actions">
                    <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                    <button type="button" class="primary-btn" onclick="window.open('/admin/members/<%= m.id %>/name-tag/print', '_blank')">Print</button>
                  </div>
                </dialog>
                <form method="POST" action="/admin/members/<%= m.id %>/delete" id="delete-form-<%= m.id %>"></form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/js/vendor/jsbarcode.min.js"></script>
  <script src="/js/name-tag-render.js"></script>
</body>
</html>
