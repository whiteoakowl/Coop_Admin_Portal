<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Members</p>
      </div>
    </div>
    <h1>Members</h1>

    <%
      // Export still needs every filter dimension on its own URL.
      function memberHref(overrides) {
        var params = Object.assign({ type: typeFilter, family: familyFilter, day: dayFilter, role: roleFilter, q: q }, overrides);
        var qs = Object.keys(params).filter(function (k) { return params[k]; }).map(function (k) { return k + '=' + encodeURIComponent(params[k]); }).join('&');
        return '/admin/members' + (qs ? '?' + qs : '');
      }

      // A real request: "filter button and search bar on co-op admin
      // portal members should be the same as main admin portal members" -
      // same orange Filter-button-opens-a-dialog shape as Main Admin's own
      // Members page (views/partials/members-type-filter.ejs), with Roster
      // Day and Role folded in as two more dropdowns alongside Type/Family
      // since this page (unlike Main Admin's) filters by those too.
      // Print preview (below) carries every filter dimension this page
      // has, same shape as Export CSV's own inline querystring above.
      var printQs = [typeFilter ? 'type=' + typeFilter : '', familyFilter ? 'family=' + familyFilter : '', dayFilter ? 'day=' + dayFilter : '', roleFilter ? 'role=' + roleFilter : '', q ? 'q=' + encodeURIComponent(q) : ''].filter(Boolean).join('&');
      const selectedFamily = families.find(function (f) { return f.id === familyFilter; });
      const filterLabelParts = [];
      if (typeFilter === 'parent') filterLabelParts.push('Parent');
      else if (typeFilter === 'student') filterLabelParts.push('Student');
      else if (typeFilter === 'admin') filterLabelParts.push('Admin');
      if (dayFilter) filterLabelParts.push(dayLabels[dayFilter]);
      if (roleFilter === 'teacher') filterLabelParts.push('Teacher');
      else if (roleFilter === 'assistant') filterLabelParts.push('Class Assistant');
      if (selectedFamily) filterLabelParts.push(selectedFamily.name + ' Family');
    %>

    <% if (error) { %>
      <div class="alert alert-error no-print"><%= error %></div>
    <% } %>
    <% if (notice) { %>
      <div class="alert alert-success no-print"><%= notice %></div>
    <% } %>

    <%# Members/Archived now lives as subpages under the orange bar's own
        Members item (views/partials/admin-nav.ejs's own
        adminFullAdminNavLinks/mobile-subpages-tab.ejs) instead of a
        trigger+dialog here. %>

    <div class="members-search-filter-row no-print">
      <form method="GET" action="/admin/members" class="members-search-bar">
        <input type="hidden" name="type" value="<%= typeFilter %>" />
        <input type="hidden" name="family" value="<%= familyFilter || '' %>" />
        <input type="hidden" name="day" value="<%= dayFilter %>" />
        <input type="hidden" name="role" value="<%= roleFilter %>" />
        <svg class="icon"><use href="#icon-search"/></svg>
        <input type="search" name="q" value="<%= q %>" placeholder="Search members&hellip;" aria-label="Search members" />
      </form>
    </div>

    <dialog id="members-filter-dialog" class="member-picker-dialog">
      <form method="GET" action="/admin/members">
        <h3>Filter Members</h3>
        <div class="radio-group">
          <label class="checkbox-option"><input type="radio" name="type" value="" <%= !typeFilter ? 'checked' : '' %> /> All</label>
          <label class="checkbox-option"><input type="radio" name="type" value="parent" <%= typeFilter === 'parent' ? 'checked' : '' %> /> Parent</label>
          <label class="checkbox-option"><input type="radio" name="type" value="student" <%= typeFilter === 'student' ? 'checked' : '' %> /> Student</label>
          <label class="checkbox-option"><input type="radio" name="type" value="admin" <%= typeFilter === 'admin' ? 'checked' : '' %> /> Admin</label>
        </div>
        <div class="category-filter">
          <label for="members-filter-day-select">Roster Day</label>
          <select id="members-filter-day-select" name="day">
            <option value="">Any Day</option>
            <% activeDays.forEach(function(d) { %>
              <option value="<%= d %>" <%= dayFilter === d ? 'selected' : '' %>><%= dayLabels[d] %></option>
            <% }); %>
          </select>
        </div>
        <div class="category-filter">
          <label for="members-filter-role-select">Role</label>
          <select id="members-filter-role-select" name="role">
            <option value="">Any Role</option>
            <option value="teacher" <%= roleFilter === 'teacher' ? 'selected' : '' %>>Teacher</option>
            <option value="assistant" <%= roleFilter === 'assistant' ? 'selected' : '' %>>Class Assistant</option>
          </select>
        </div>
        <% if (families.length > 0) { %>
          <div class="category-filter">
            <label for="members-filter-family-select">Family</label>
            <select id="members-filter-family-select" name="family">
              <option value="">All Families</option>
              <% families.forEach(function(f) { %>
                <option value="<%= f.id %>" <%= familyFilter === f.id ? 'selected' : '' %>><%= f.name %> Family</option>
              <% }); %>
            </select>
          </div>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Apply Filter</button>
        </div>
      </form>
    </dialog>

    <div class="roster-toolbar no-print" id="members-toolbar">
      <%# Role permissions, Import, and Add/Edit Member all live only on
          the Main Admin Portal's own Members page now - a real request:
          "the buttons on the members page will read Export, Print,
          Edit." A later real request: "export, print and edit buttons
          should be similar size and on the same row, for mobile" - no
          data-fixed-columns here means roster-btn-row-grid.js's own
          adaptive layout takes over, and 3 buttons already fits in one
          row at its own "≤4 columns" cap. %>
      <div class="roster-btn-row">
        <button type="button" class="roster-action-btn" onclick="document.getElementById('members-filter-dialog').showModal()">
          <svg class="icon"><use href="#icon-filter"/></svg>
          Filter<% if (filterLabelParts.length > 0) { %>: <%= filterLabelParts.join(', ') %><% } %>
        </button>
        <a class="roster-action-btn" href="/admin/members/grade-level-report">Grade Level Report</a>
      </div>
      <div class="roster-btn-row">
        <%# A real request: "change export and print buttons to icons" -
            same icon-btn + icon-download/icon-printer pattern already
            used elsewhere (e.g. views/admin-accounting-list.ejs's own
            toolbar). %>
        <a class="icon-btn" href="/admin/members/export.csv<%= (typeFilter || familyFilter) ? '?' : '' %><%= typeFilter ? 'type=' + typeFilter : '' %><%= (typeFilter && familyFilter) ? '&' : '' %><%= familyFilter ? 'family=' + familyFilter : '' %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <%# A real request: "all print button should show a print preview
            full real page on a page with a print button" - opens the
            dedicated admin-members-print.ejs view in a new tab instead of
            printing this interactive card list in place (see routes/
            admin-members.js's own GET /members/print). Carries every
            filter dimension this page has, same as Export CSV above. %>
        <a class="icon-btn" href="/admin/members/print<%= printQs ? '?' + printQs : '' %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
        <a class="icon-btn" href="/admin/members/download.pdf<%= printQs ? '?' + printQs : '' %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
      </div>

      <%# A real request: "Add a column of check boxes in the first
          column of every member. In the title row of this column is a
          single check box, selecting the box will select all and
          deselecting the box will uncheck all. Add a bulk action button
          to this page. When you select members and then click bulk
          action it will have a drop down menu asking if you want to
          delete the members, email them, text them." Replaces the old
          "Edit" toggle (checkboxes/this row used to be hidden until that
          was clicked) - permanently visible now, same shape Main
          Admin's own Members page uses. No Archive here - a real
          request: "remove member archive page, it is not needed on
          co-op admin, only main admin." Email/Text route straight to
          the compose screen (routes/admin-announcements.js's own
          /email/compose, /text/compose - see utils/emailComposer.js's
          own resolveRecipients()), no confirm needed; Delete still
          confirms first (public/js/members-bulk-actions.js). %>
      <div class="class-schedule-archive-controls">
        <label class="checkbox-option class-schedule-select-all">
          <input type="checkbox" data-select-all-for="members-bulk-form" />
          Select All
        </label>
        <select data-bulk-action-select form="members-bulk-form" aria-label="Bulk Action">
          <option value="">Bulk Action</option>
          <option
            value="delete"
            data-bulk-action="/admin/members/bulk-delete"
            data-bulk-confirm="Permanently delete the selected member(s)? This removes them from all rosters, volunteer lists, and all attendance history. This cannot be undone."
            data-bulk-confirm-yes-label="Yes, Delete"
          >Delete</option>
          <option value="email" data-bulk-action="/admin/announcements/email/compose">Email</option>
          <option value="text" data-bulk-action="/admin/announcements/text/compose">Text</option>
        </select>
      </div>
    </div>

    <form
      id="members-bulk-form"
      method="POST"
      action="/admin/members/bulk-delete"
    ></form>

    <%# A real request: "Co-op admin portal, members, remove manage
        families button and features. This is only done on main admin
        portal." Family creation from the Add/Edit Member form's own "+
        Add New Family" inline dialog is unaffected (POST /admin/members/
        families/new still exists for that) - only this page's own
        standalone add/rename/delete-families dialog is gone; that whole
        feature now lives exclusively on Main Admin's own Members page. %>

    <div class="members-section-label-row">
      <span class="members-section-label">MEMBERS</span>
      <span class="members-count-pill"><%= allMembersForPrint.length %> member<%= allMembersForPrint.length === 1 ? '' : 's' %></span>
    </div>

    <% if (members.length === 0) { %>
      <p class="roster-empty">No members match this filter yet.</p>
    <% } else { %>
      <div id="members-table">
        <% members.forEach(function(m) { %>
          <% var familySize = members.filter(function(x) { return x.family_id != null && x.family_id === m.family_id; }).length; %>
          <% var isFamilyHead = m.is_primary_parent || m.family_id == null || familySize < 2; %>
          <div
            class="member-row-card"
            data-family-key="<%= m.family_id != null ? 'f' + m.family_id : 'solo' + m.id %>"
            data-family-member="<%= isFamilyHead ? '' : '1' %>"
          >
            <%# A real request: "arrow for dropdown stays on left side" -
                moved from the end of .member-row-actions to the front of
                the card, ahead of the avatar. %>
            <% if (isFamilyHead && familySize > 1) { %>
              <button type="button" class="family-accordion-toggle" aria-expanded="false" aria-label="Show <%= familySize - 1 %> more family member<%= familySize - 1 === 1 ? '' : 's' %>">
                <svg class="icon"><use href="#icon-chevron-down"/></svg>
              </button>
            <% } else { %>
              <span class="member-row-chevron-spacer"></span>
            <% } %>
            <input type="checkbox" name="memberIds" value="<%= m.id %>" form="members-bulk-form" class="archive-select-checkbox no-print" aria-label="Select <%= m.name %>" />
            <span class="member-avatar member-avatar-<%= avatarColorFor(m.family_id != null ? m.family_id : m.id) %>">
              <% if (m.photo_path) { %>
                <img src="<%= photoUrl(m.photo_path) %>" alt="" />
              <% } else { %>
                <%= m.name.charAt(0).toUpperCase() %>
              <% } %>
            </span>
            <div class="member-row-body">
              <div class="member-row-topline">
                <a class="member-row-name-link" href="/admin/members/<%= m.id %>"><%= m.name %></a><%- include('partials/medical-flag', { member: m }) %>
                <%# A real request: "Admins will simply get a star next to
                    their member name" - member_type === 'admin' is now
                    fully derived from holding an Admin Position (utils/
                    adminPositions.js's own syncMemberAdminStatus), never
                    a manually-chosen checkbox on this form. %>
                <% if (m.member_type === 'admin') { %>
                  <span class="member-admin-star" title="Admin"><svg class="icon"><use href="#icon-star"/></svg></span>
                <% } %>
                <%# A real request: "member rows remove primary column.
                    it can already be seen when viewing the profile" - the
                    profile page already shows Primary Parent status. %>
                <span class="badge-pill badge-pill-<%= avatarColorFor(m.family_id != null ? m.family_id : m.id) %> member-role-badge"><svg class="icon"><use href="#icon-star"/></svg> <%= m.member_type === 'parent' ? 'Parent' : m.member_type === 'admin' ? 'Admin' : 'Student' %></span>
                <%# A real request: "this will then add their admin title
                    label next to their name on member lists." %>
                <% if (m.adminTitle) { %><span class="badge-pill" title="Admin Position"><%= m.adminTitle %></span><% } %>
              </div>
              <%# A real request: "icons in a row below the name" - every
                  small fact line (grade/age or family, roster) used to be
                  its own stacked row; now they share one wrapping row so
                  the card reads as name+badges on line one, everything
                  else compact underneath. %>
              <% if ((m.member_type === 'student' && (m.grade_level || m.age !== null)) || m.familyName || m.rosters.length > 0) { %>
                <div class="member-row-icon-row">
                  <% if (m.member_type === 'student' && (m.grade_level || m.age !== null)) { %>
                    <span class="member-row-subline">
                      <svg class="icon"><use href="#icon-graduation-cap"/></svg>
                      <%= [m.grade_level || null, m.age !== null ? (m.age + (m.age === 1 ? ' year old' : ' years old')) : null].filter(Boolean).join(' · ') %>
                    </span>
                  <% } else if (m.familyName) { %>
                    <span class="member-row-subline"><svg class="icon"><use href="#icon-home"/></svg> <%= m.familyName %></span>
                  <% } %>
                  <% if (m.rosters.length > 0) { %>
                    <span class="member-row-subline">
                      <svg class="icon"><use href="#icon-calendar-check"/></svg>
                      <%= m.rosters.map(function(r) { return r.name; }).join(', ') %>
                    </span>
                  <% } %>
                </div>
              <% } %>
            </div>
            <div class="member-row-actions no-print">
              <% if (m.email) { %>
                <a class="icon-btn" href="mailto:<%= m.email %>" aria-label="Email <%= m.name %>" title="Email <%= m.name %>"><svg class="icon"><use href="#icon-mail"/></svg></a>
              <% } else { %>
                <span class="icon-btn icon-btn-disabled" aria-hidden="true" title="No email on file"><svg class="icon"><use href="#icon-mail"/></svg></span>
              <% } %>
              <%# A real request: "add an icon that shows sending
                  something. when you click it a pop up will appear
                  and ask, do you want to add this name tag to the
                  request log? yes, no buttons, close windows." Follow-up
                  request: "if they are already on the log, it should
                  say, this member is already on the name tags request
                  log. and the popup closes" - swaps in the sitewide
                  dialog's info-only mode instead of the Add confirm. %>
              <% if (pendingNameTagMemberIds.has(m.id)) { %>
                <button
                  type="button"
                  class="icon-btn"
                  data-info-message="This member is already on the name tags request log."
                  data-info-icon="icon-send"
                  aria-label="Add name tag request for <%= m.name %>"
                  title="Add to Name Tag Request Log"
                ><svg class="icon"><use href="#icon-send"/></svg></button>
              <% } else { %>
                <button
                  type="button"
                  class="icon-btn"
                  data-name-tag-request-url="/admin/members/<%= m.id %>/request-name-tag"
                  aria-label="Add name tag request for <%= m.name %>"
                  title="Add to Name Tag Request Log"
                ><svg class="icon"><use href="#icon-send"/></svg></button>
              <% } %>
              <%# A real request: "all icons should show, no three dot
                  option" - Notes/Cards/Schedule/Delete used to live
                  behind a "More" (⋮) overflow menu; each is now its own
                  icon button, same .icon-btn treatment as Email/Send
                  beside them. Their click behavior is unchanged - each
                  one's own global delegated listener (public/js/members-
                  dialogs.js, member-row-actions.js) matches by data
                  attribute, not by living inside any particular menu. %>
              <button type="button" class="icon-btn" onclick="document.getElementById('notes-dialog-<%= m.id %>').showModal()" aria-label="Notes for <%= m.name %><%= m.notes ? ' (saved)' : '' %>" title="Notes<%= m.notes ? ' (saved)' : '' %>">
                <svg class="icon"><use href="#icon-edit"/></svg>
              </button>
              <button type="button" class="icon-btn" data-view-cards="<%= m.id %>" aria-label="View cards for <%= m.name %>" title="View Cards">
                <svg class="icon"><use href="#icon-badge"/></svg>
              </button>
              <button type="button" class="icon-btn" data-view-schedule="<%= m.id %>" aria-label="View schedule for <%= m.name %>" title="View Schedule">
                <svg class="icon"><use href="#icon-clock"/></svg>
              </button>
              <button
                type="button"
                class="icon-btn icon-btn-danger"
                data-member-delete-url="/admin/members/<%= m.id %>/delete"
                data-member-delete-name="<%= m.name %>"
                data-member-delete-message="Permanently delete <%= m.name %>? This removes them from all rosters, volunteer lists, and all attendance history. This cannot be undone."
                aria-label="Delete <%= m.name %>"
                title="Delete"
              ><svg class="icon"><use href="#icon-trash"/></svg></button>
            </div>
            <dialog id="notes-dialog-<%= m.id %>" class="notes-dialog">
              <form method="POST" action="/admin/members/<%= m.id %>/notes">
                <h3>Notes &mdash; <%= m.name %></h3>
                <textarea name="notes" rows="5" placeholder="Write a note about this member&hellip;"><%= m.notes || '' %></textarea>
                <div class="notes-dialog-actions">
                  <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                  <button type="submit" class="primary-btn">Save</button>
                </div>
              </form>
            </dialog>
            <%# Cards/Schedule content is fetched on open (see
                public/js/members-dialogs.js + routes/admin-members.js)
                rather than rendered here for every row - these start
                empty and get their innerHTML swapped in on demand. %>
            <dialog id="cards-dialog-<%= m.id %>" class="badge-preview-dialog"></dialog>
            <dialog id="schedule-dialog-<%= m.id %>" class="schedule-preview-dialog"></dialog>
          </div>
        <% }); %>
      </div>
    <% } %>

    <%
      // "Select All" (public/js/archive-select-toggle.js) only ever checks
      // checkboxes actually present in the DOM, and this list only
      // renders one page's worth of members at a time (see the route's
      // own pagination) - without these, Select All on a multi-page list
      // would silently reach just the current page. Carries the rest of
      // allMembersForPrint (every member matching the current type/family/
      // day/role filter, unpaginated) so Select All can reach every page,
      // same pattern as admin-schedule.ejs's own off-page checkboxes.
      var pageIds = members.map(function (m) { return m.id; });
    %>
    <% allMembersForPrint.forEach(function(m) { %>
      <% if (pageIds.indexOf(m.id) === -1) { %>
        <input type="checkbox" name="memberIds" value="<%= m.id %>" form="members-bulk-form" class="archive-offpage-checkbox" aria-hidden="true" hidden />
      <% } %>
    <% }); %>

    <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>

    <%# Printing shows this plain grid instead of the interactive card list
        above (screen icons/dropdowns don't belong on paper) - see
        .members-print-table in styles.css. Uses allMembersForPrint (every
        filtered member), not the paginated `members` the on-screen list
        above uses, so a printed roster always shows the whole list
        regardless of which page happened to be open on screen. %>
    <table class="roster-table members-print-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th>Family</th>
          <th>Roster</th>
          <th>Grade</th>
          <th>Birthday</th>
        </tr>
      </thead>
      <tbody>
        <% allMembersForPrint.forEach(function(m) { %>
          <tr>
            <td><%= m.name %><%= m.is_primary_parent ? ' (Primary)' : '' %><%= m.adminTitle ? ' (' + m.adminTitle + ')' : '' %></td>
            <td><%= m.member_type === 'parent' ? 'Parent' : m.member_type === 'admin' ? 'Admin' : 'Student' %></td>
            <td><%= m.familyName || '—' %></td>
            <td><%= m.rosters.length ? m.rosters.map(function(r) { return r.name; }).join(', ') : '—' %></td>
            <td><%= m.grade_level || '—' %></td>
            <td><%= m.birthdayLabel || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
  <script src="/js/vendor/jsbarcode.min.js"></script>
  <script src="/js/name-tag-render.js"></script>
  <script src="/js/badge-autofit.js"></script>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/members-dialogs.js"></script>
  <script src="/js/member-name-tag-request.js"></script>
  <script src="/js/members-family-accordion.js"></script>
  <script src="/js/archive-select-toggle.js"></script>
  <script src="/js/members-bulk-actions.js"></script>
  <script src="/js/member-row-actions.js"></script>
</body>
</html>
