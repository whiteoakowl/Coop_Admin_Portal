<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Members</p>
      </div>
    </div>
    <h1>Members</h1>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (notice) { %>
      <div class="alert alert-success"><%= notice %></div>
    <% } %>

    <div class="roster-toolbar no-print">
      <div class="category-filter" style="margin: 0;">
        <label for="type-select">Filter by type</label>
        <select id="type-select" onchange="window.location = '/admin/members' + (this.value ? '?type=' + this.value : '')">
          <option value="" <%= !typeFilter ? 'selected' : '' %>>All</option>
          <option value="parent" <%= typeFilter === 'parent' ? 'selected' : '' %>>Parent</option>
          <option value="student" <%= typeFilter === 'student' ? 'selected' : '' %>>Student</option>
          <option value="admin" <%= typeFilter === 'admin' ? 'selected' : '' %>>Admin</option>
        </select>
      </div>
      <div class="roster-btn-row">
        <a class="roster-action-btn" href="/admin/members/new">+ Add Member</a>
        <button type="button" class="roster-action-btn file-action-btn" onclick="document.getElementById('import-dialog').showModal()">Import</button>
        <a class="roster-action-btn file-action-btn" href="/admin/members/export.csv<%= typeFilter ? '?type=' + typeFilter : '' %>">Export</a>
        <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
      </div>
    </div>

    <dialog id="import-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/members/import" enctype="multipart/form-data">
        <h3>Import</h3>
        <p class="hint">Upload a .csv, .txt, or .xlsx file with the columns below.</p>
        <a class="btn-secondary import-sample-link" href="/admin/members/import-template.xlsx">Download Sample File</a>
        <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Import</button>
        </div>
      </form>
    </dialog>

    <div class="roster-scroll">
      <table class="roster-table members-table">
        <thead>
          <tr>
            <th class="members-col-photo"></th>
            <th>Name</th>
            <th>Type</th>
            <th class="members-col-parent">Family</th>
            <th class="members-col-rosters">Rosters</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% members.forEach(function(m) { %>
            <tr>
              <td class="members-col-photo">
                <% if (m.photo_path) { %>
                  <img class="member-thumb" src="<%= m.photo_path %>" alt="" />
                <% } else { %>
                  <span class="member-thumb-placeholder"><%= m.name.charAt(0).toUpperCase() %></span>
                <% } %>
              </td>
              <td><a href="/admin/members/<%= m.id %>/edit"><%= m.name %></a></td>
              <td><span class="badge-pill"><%= m.member_type === 'parent' ? 'Parent' : m.member_type === 'admin' ? 'Admin' : 'Student' %></span></td>
              <td class="members-col-parent"><%= m.familyNames.length ? m.familyNames.join(', ') : '—' %></td>
              <td class="members-col-rosters">
                <% if (m.rosters.length === 0) { %>
                  <span class="hint">none</span>
                <% } else { %>
                  <% m.rosters.forEach(function(r) { %>
                    <span class="badge-pill"><%= r.name %></span>
                  <% }); %>
                <% } %>
              </td>
              <td class="actions-cell">
                <div class="actions-btn-row">
                  <button
                    type="button"
                    class="icon-btn<%= m.notes ? ' icon-btn-active' : '' %>"
                    onclick="document.getElementById('notes-dialog-<%= m.id %>').showModal()"
                    aria-label="Notes for <%= m.name %>"
                    title="Notes"
                  ><svg class="icon"><use href="#icon-edit"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    onclick="var d = document.getElementById('cards-dialog-<%= m.id %>'); d.showModal(); renderNameTagBarcodes(d);"
                    aria-label="View cards for <%= m.name %>"
                    title="View Cards"
                  ><svg class="icon"><use href="#icon-badge"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    onclick="document.getElementById('schedule-dialog-<%= m.id %>').showModal()"
                    aria-label="View schedule for <%= m.name %>"
                    title="View Schedule"
                  ><svg class="icon"><use href="#icon-clock"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    onclick="if (confirm('Permanently delete this member? This removes them from all rosters, volunteer lists, and all attendance history. This cannot be undone.')) { document.getElementById('delete-form-<%= m.id %>').submit(); }"
                    aria-label="Delete <%= m.name %>"
                    title="Delete"
                  ><svg class="icon"><use href="#icon-trash"/></svg></button>
                </div>
                <dialog id="notes-dialog-<%= m.id %>" class="notes-dialog">
                  <form method="POST" action="/admin/members/<%= m.id %>/notes">
                    <h3>Notes &mdash; <%= m.name %></h3>
                    <textarea name="notes" rows="5" placeholder="Write a note about this member&hellip;"><%= m.notes || '' %></textarea>
                    <div class="notes-dialog-actions">
                      <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                      <button type="submit" class="primary-btn">Save</button>
                    </div>
                  </form>
                </dialog>
                <dialog id="cards-dialog-<%= m.id %>" class="badge-preview-dialog">
                  <h3>Cards &mdash; <%= m.name %></h3>
                  <form method="GET" action="/admin/members/<%= m.id %>/cards/print" target="_blank">
                    <div class="cards-preview-option">
                      <label class="checkbox-option"><input type="checkbox" name="cards" value="nameTag" checked /> Name Tag</label>
                      <%- include('partials/name-tag-badge', { html: m.badgeHtml, bgCss: m.badgeBgCss, badgeWidth: badgeWidth, badgeHeight: badgeHeight }) %>
                    </div>
                    <div class="cards-preview-option">
                      <label class="checkbox-option"><input type="checkbox" name="cards" value="scheduleCard" checked /> Schedule Card</label>
                      <%- include('partials/name-tag-badge', { html: m.scheduleCardHtml, bgCss: m.scheduleCardBgCss, badgeWidth: cardWidth, badgeHeight: cardHeight }) %>
                    </div>
                    <div class="notes-dialog-actions">
                      <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                      <button type="submit" class="primary-btn">Print</button>
                    </div>
                  </form>
                </dialog>
                <dialog id="schedule-dialog-<%= m.id %>" class="schedule-preview-dialog">
                  <h3>Class Schedule &mdash; <%= m.name %></h3>
                  <% [['Monday', m.schedule.monday], ['Wednesday', m.schedule.wednesday]].forEach(function(entry) { %>
                    <% var dayLabel = entry[0], dayRows = entry[1]; %>
                    <h4><%= dayLabel %></h4>
                    <table class="roster-table schedule-print-table">
                      <thead><tr><th>Class</th><th>Time</th><th>Class Name</th><th>Room</th></tr></thead>
                      <tbody>
                        <% dayRows.forEach(function(c, i) { %>
                          <tr>
                            <td>Class <%= i + 1 %></td>
                            <td><%= c.time || '—' %></td>
                            <td><%= c.class_name || '—' %></td>
                            <td><%= c.room || '—' %></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  <% }); %>
                  <div class="notes-dialog-actions">
                    <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                    <a class="primary-btn" href="/admin/schedule/print?memberId=<%= m.id %>" target="_blank">Print</a>
                  </div>
                </dialog>
                <form method="POST" action="/admin/members/<%= m.id %>/delete" id="delete-form-<%= m.id %>"></form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/js/vendor/jsbarcode.min.js"></script>
  <script src="/js/name-tag-render.js"></script>
</body>
</html>
