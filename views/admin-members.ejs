<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Members</h1>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <details class="add-member-details">
      <summary class="btn-primary-summary">+ Add Member</summary>
      <form method="POST" action="/admin/members" class="inline-form">
        <div class="inline-form-row">
          <label>
            Name
            <input type="text" name="name" required />
          </label>
          <label>
            Barcode <span class="hint">(leave blank to auto-generate)</span>
            <input type="text" name="barcode" placeholder="auto-generated" />
          </label>
        </div>
        <label class="roster-checkbox-label">Add to Roster(s)</label>
        <div class="checkbox-row">
          <% allRosters.forEach(function(r) { %>
            <label class="checkbox-pill">
              <input type="checkbox" name="rosterIds" value="<%= r.id %>" />
              <%= r.name %> (<%= r.day[0].toUpperCase() + r.day.slice(1) %>)
            </label>
          <% }); %>
          <% if (allRosters.length === 0) { %>
            <span class="hint">No rosters yet &mdash; <a href="/admin/rosters">create one first</a>.</span>
          <% } %>
        </div>
        <button type="submit" class="primary-btn">Add Member</button>
      </form>
    </details>

    <div class="roster-scroll">
      <table class="roster-table members-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Barcode</th>
            <th>Rosters</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% members.forEach(function(m) { %>
            <tr class="<%= m.active ? '' : 'row-inactive' %>">
              <td>
                <form method="POST" action="/admin/members/<%= m.id %>/edit" class="edit-name-form">
                  <input type="text" name="name" value="<%= m.name %>" />
                  <button type="submit" class="link-btn">Save</button>
                </form>
              </td>
              <td class="mono"><%= m.barcode %></td>
              <td>
                <% if (m.rosters.length === 0) { %>
                  <span class="hint">none</span>
                <% } else { %>
                  <% m.rosters.forEach(function(r) { %>
                    <span class="badge-pill"><%= r.name %></span>
                  <% }); %>
                <% } %>
                <a class="link-btn" href="/admin/rosters">manage</a>
              </td>
              <td><%= m.active ? 'Active' : 'Inactive' %></td>
              <td class="actions-cell">
                <a class="link-btn" href="/admin/members/<%= m.id %>/badge" target="_blank">Print Badge</a>
                <form method="POST" action="/admin/members/<%= m.id %>/toggle-active" class="inline-block-form">
                  <button type="submit" class="link-btn"><%= m.active ? 'Deactivate' : 'Reactivate' %></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
