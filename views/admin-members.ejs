<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Members</p>
      </div>
    </div>
    <h1>Members</h1>

    <% if (error) { %>
      <div class="alert alert-error no-print"><%= error %></div>
    <% } %>
    <% if (notice) { %>
      <div class="alert alert-success no-print"><%= notice %></div>
    <% } %>

    <div class="roster-toolbar no-print">
      <div class="category-filter" style="margin: 0;">
        <label for="type-select">Filter by type or family</label>
        <select id="type-select" onchange="window.location = this.value">
          <option value="/admin/members" <%= (!typeFilter && !familyFilter) ? 'selected' : '' %>>All</option>
          <option value="/admin/members?type=parent" <%= typeFilter === 'parent' ? 'selected' : '' %>>Parent</option>
          <option value="/admin/members?type=student" <%= typeFilter === 'student' ? 'selected' : '' %>>Student</option>
          <% if (families.length > 0) { %>
            <optgroup label="Family">
              <% families.forEach(function(f) { %>
                <option value="/admin/members?family=<%= f.id %>" <%= familyFilter === f.id ? 'selected' : '' %>><%= f.name %></option>
              <% }); %>
            </optgroup>
          <% } %>
        </select>
      </div>
      <%# Edit mode's Select All + Delete/Archive/Restore Selected controls
          - hidden until the "Edit" toggle button below is clicked (see
          public/js/archive-select-toggle.js, reused as-is from the Class/
          Student/Parent Schedule archive grids). %>
      <div class="class-schedule-archive-controls" data-archive-controls="members-bulk-form" hidden>
        <label class="checkbox-option class-schedule-select-all">
          <input type="checkbox" data-select-all-for="members-bulk-form" />
          Select All
        </label>
        <button
          type="submit"
          form="members-bulk-form"
          data-bulk-action="/admin/members/bulk-delete"
          class="roster-action-btn roster-action-btn-danger"
          data-bulk-confirm="Permanently delete the selected member(s)? This removes them from all rosters, volunteer lists, and all attendance history. This cannot be undone."
          data-bulk-confirm-yes-label="Yes, Delete"
        >Delete Selected</button>
        <% if (showArchived) { %>
          <button
            type="submit"
            form="members-bulk-form"
            data-bulk-action="/admin/members/bulk-unarchive"
            class="roster-action-btn"
            data-bulk-confirm="Restore the selected member(s) to the active Members list?"
            data-bulk-confirm-yes-label="Yes, Restore"
            data-bulk-confirm-safe="1"
          >Restore Selected</button>
        <% } else { %>
          <button
            type="submit"
            form="members-bulk-form"
            data-bulk-action="/admin/members/bulk-archive"
            class="roster-action-btn"
            data-bulk-confirm="Archive the selected member(s)? They'll be hidden from the active Members list, but nothing is deleted."
            data-bulk-confirm-yes-label="Yes, Archive"
            data-bulk-confirm-safe="1"
          >Archive Selected</button>
        <% } %>
      </div>
      <div class="roster-btn-row">
        <a class="roster-action-btn" href="/admin/members/new">+ Add Member</a>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-family-dialog').showModal()">+ Add Family</button>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('edit-families-dialog').showModal()">Edit Families</button>
        <button type="button" class="roster-action-btn file-action-btn" onclick="document.getElementById('import-dialog').showModal()">Import</button>
        <button type="button" class="roster-action-btn file-action-btn" onclick="document.getElementById('mass-import-dialog').showModal()">Mass Import Families</button>
        <a class="roster-action-btn file-action-btn" href="/admin/members/export.csv<%= (typeFilter || familyFilter) ? '?' : '' %><%= typeFilter ? 'type=' + typeFilter : '' %><%= (typeFilter && familyFilter) ? '&' : '' %><%= familyFilter ? 'family=' + familyFilter : '' %>">Export</a>
        <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
        <button type="button" class="roster-action-btn" data-archive-toggle="members-bulk-form" aria-pressed="false">Edit</button>
        <a
          class="roster-action-btn"
          href="/admin/members?<%= typeFilter ? 'type=' + typeFilter + '&' : '' %><%= familyFilter ? 'family=' + familyFilter + '&' : '' %><%= showArchived ? '' : 'archived=1' %>"
        ><%= showArchived ? 'View Active' : 'View Archived' %></a>
      </div>
    </div>

    <form
      id="members-bulk-form"
      method="POST"
      action="/admin/members/bulk-delete"
    ></form>

    <dialog id="add-family-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/members/families/new">
        <h3>Add Family</h3>
        <p class="hint">A family must be added here before it shows up on a member's "Choose a Family" dropdown.</p>
        <label>Family Last Name
          <input type="text" name="name" placeholder="e.g. Anderson" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Family</button>
        </div>
      </form>
    </dialog>

    <%# Rename or delete a family "name" itself - distinct from the
        per-member "Choose a Family" dropdown on the Add/Edit Member form,
        which only assigns/clears one member's own family_id. Deleting a
        family here only ungroups its members (families.id has ON DELETE
        SET NULL on members.family_id) - it never deletes a member. %>
    <dialog id="edit-families-dialog" class="member-picker-dialog">
      <h3>Edit Families</h3>
      <% if (families.length === 0) { %>
        <p class="hint">No families added yet.</p>
      <% } else { %>
        <ul class="edit-families-list" id="edit-families-list">
          <% families.forEach(function(f) { %>
            <li class="edit-families-row" data-family-id="<%= f.id %>">
              <form method="POST" action="/admin/members/families/<%= f.id %>/rename" class="edit-families-rename-form">
                <input type="text" name="name" value="<%= f.name %>" required aria-label="Rename &quot;<%= f.name %>&quot; family" />
                <button type="submit" class="btn-secondary">Save</button>
              </form>
              <span class="hint"><%= f.memberCount %> member<%= f.memberCount == 1 ? '' : 's' %></span>
              <%# Deliberately a plain button, not a submitting form - see
                  public/js/edit-families.js. A real page navigation here
                  would close this whole dialog on every single delete,
                  which is exactly the friction an admin clearing out
                  several old families at once doesn't want. %>
              <button
                type="button"
                class="icon-btn"
                data-delete-family="<%= f.id %>"
                data-family-name="<%= f.name %>"
                data-member-count="<%= f.memberCount %>"
                aria-label="Delete &quot;<%= f.name %>&quot; family"
                title="Delete Family"
              ><svg class="icon"><use href="#icon-trash"/></svg></button>
            </li>
          <% }); %>
        </ul>
        <p class="hint" id="edit-families-empty" hidden>No families added yet.</p>
      <% } %>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
      </div>
    </dialog>

    <dialog id="import-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/members/import" enctype="multipart/form-data">
        <h3>Import</h3>
        <a class="btn-secondary import-sample-link" href="/admin/members/import-template.xlsx">Download Sample File</a>
        <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Import</button>
        </div>
      </form>
    </dialog>

    <dialog id="mass-import-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/members/mass-import" enctype="multipart/form-data">
        <h3>Mass Import Families</h3>
        <a class="btn-secondary import-sample-link" href="/admin/members/mass-import/sample.xlsx">Download Sample File</a>
        <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Import Families</button>
        </div>
      </form>
    </dialog>

    <div class="roster-scroll">
      <table class="roster-table members-table members-list-table">
        <thead>
          <tr>
            <th class="no-print members-col-select"><span class="sr-only">Select</span></th>
            <th class="members-col-photo"><span class="sr-only">Photo</span></th>
            <th>Name</th>
            <th>Type</th>
            <th class="members-col-parent">Family</th>
            <th class="members-col-rosters">Rosters</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% members.forEach(function(m) { %>
            <tr class="<%= m.is_primary_parent ? 'row-primary-parent' : '' %>" data-family-key="<%= m.family_id != null ? 'f' + m.family_id : 'solo' + m.id %>">
              <td class="no-print members-col-select">
                <input type="checkbox" name="memberIds" value="<%= m.id %>" form="members-bulk-form" class="archive-select-checkbox no-print" aria-label="Select <%= m.name %>" hidden />
              </td>
              <td class="members-col-photo">
                <% if (m.photo_path) { %>
                  <img class="member-thumb" src="<%= photoUrl(m.photo_path) %>" alt="" />
                <% } else { %>
                  <span class="member-thumb-placeholder"><%= m.name.charAt(0).toUpperCase() %></span>
                <% } %>
              </td>
              <td class="members-col-name">
                <a class="member-name-link" href="/admin/members/<%= m.id %>"><%= m.name %></a><%- include('partials/medical-flag', { member: m }) %>
                <% if (m.is_primary_parent) { %><span class="primary-parent-badge">Primary</span><% } %>
                <% if (m.member_type === 'student' && (m.grade_level || m.age !== null)) { %>
                  <span class="member-row-subline">
                    <%= [m.grade_level || null, m.age !== null ? (m.age + (m.age === 1 ? ' year old' : ' years old')) : null].filter(Boolean).join(' · ') %>
                  </span>
                <% } %>
              </td>
              <td><span class="badge-pill"><%= m.member_type === 'parent' ? 'Parent' : 'Student' %></span></td>
              <td class="members-col-parent"><%= m.familyName || '—' %></td>
              <td class="members-col-rosters">
                <% if (m.rosters.length === 0) { %>
                  <span class="hint">none</span>
                <% } else { %>
                  <% m.rosters.forEach(function(r) { %>
                    <span class="badge-pill"><%= r.name %></span>
                  <% }); %>
                <% } %>
              </td>
              <td class="actions-cell">
                <div class="actions-btn-row">
                  <button
                    type="button"
                    class="icon-btn<%= m.notes ? ' icon-btn-active' : '' %>"
                    onclick="document.getElementById('notes-dialog-<%= m.id %>').showModal()"
                    aria-label="Notes for <%= m.name %>"
                    title="Notes"
                  ><svg class="icon"><use href="#icon-edit"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    data-view-cards="<%= m.id %>"
                    aria-label="View cards for <%= m.name %>"
                    title="View Cards"
                  ><svg class="icon"><use href="#icon-badge"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    data-view-schedule="<%= m.id %>"
                    aria-label="View schedule for <%= m.name %>"
                    title="View Schedule"
                  ><svg class="icon"><use href="#icon-clock"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    onclick="document.getElementById('delete-form-<%= m.id %>').requestSubmit();"
                    aria-label="Delete <%= m.name %>"
                    title="Delete"
                  ><svg class="icon"><use href="#icon-trash"/></svg></button>
                </div>
                <dialog id="notes-dialog-<%= m.id %>" class="notes-dialog">
                  <form method="POST" action="/admin/members/<%= m.id %>/notes">
                    <h3>Notes &mdash; <%= m.name %></h3>
                    <textarea name="notes" rows="5" placeholder="Write a note about this member&hellip;"><%= m.notes || '' %></textarea>
                    <div class="notes-dialog-actions">
                      <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                      <button type="submit" class="primary-btn">Save</button>
                    </div>
                  </form>
                </dialog>
                <%# Cards/Schedule content is fetched on open (see
                    public/js/members-dialogs.js + routes/admin-members.js)
                    rather than rendered here for every row - these start
                    empty and get their innerHTML swapped in on demand. %>
                <dialog id="cards-dialog-<%= m.id %>" class="badge-preview-dialog"></dialog>
                <dialog id="schedule-dialog-<%= m.id %>" class="schedule-preview-dialog"></dialog>
                <form method="POST" action="/admin/members/<%= m.id %>/delete" id="delete-form-<%= m.id %>" data-confirm="Permanently delete <%= m.name %>? This removes them from all rosters, volunteer lists, and all attendance history. This cannot be undone."></form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <%
      // "Select All" (public/js/archive-select-toggle.js) only ever checks
      // checkboxes actually present in the DOM, and this table only
      // renders one page's worth of members at a time (see the route's
      // own pagination) - without these, Select All on a multi-page list
      // would silently reach just the current page. Carries the rest of
      // allMembersForPrint (every member matching the current type/family/
      // archived filter, unpaginated) so Select All can reach every page,
      // same pattern as admin-schedule.ejs's own off-page checkboxes.
      var pageIds = members.map(function (m) { return m.id; });
    %>
    <% allMembersForPrint.forEach(function(m) { %>
      <% if (pageIds.indexOf(m.id) === -1) { %>
        <input type="checkbox" name="memberIds" value="<%= m.id %>" form="members-bulk-form" class="archive-offpage-checkbox" aria-hidden="true" hidden />
      <% } %>
    <% }); %>

    <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>

    <%# Printing shows this plain grid instead of the interactive table
        above (screen icons/dropdowns don't belong on paper) - see
        .members-print-table in styles.css. Uses allMembersForPrint (every
        filtered member), not the paginated `members` the on-screen table
        above uses, so a printed roster always shows the whole list
        regardless of which page happened to be open on screen. %>
    <table class="roster-table members-print-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th>Family</th>
          <th>Roster</th>
          <th>Grade</th>
          <th>Birthday</th>
        </tr>
      </thead>
      <tbody>
        <% allMembersForPrint.forEach(function(m) { %>
          <tr>
            <td><%= m.name %><%= m.is_primary_parent ? ' (Primary)' : '' %></td>
            <td><%= m.member_type === 'parent' ? 'Parent' : 'Student' %></td>
            <td><%= m.familyName || '—' %></td>
            <td><%= m.rosters.length ? m.rosters.map(function(r) { return r.name; }).join(', ') : '—' %></td>
            <td><%= m.grade_level || '—' %></td>
            <td><%= m.birthday || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
  <script src="/js/vendor/jsbarcode.min.js"></script>
  <script src="/js/name-tag-render.js"></script>
  <script src="/js/badge-autofit.js"></script>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/members-dialogs.js"></script>
  <script src="/js/members-family-collapse.js"></script>
  <script src="/js/archive-select-toggle.js"></script>
  <script src="/js/members-bulk-actions.js"></script>
  <script src="/js/edit-families.js"></script>
</body>
</html>
