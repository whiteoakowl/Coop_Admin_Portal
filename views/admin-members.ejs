<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Members</p>
      </div>
    </div>
    <h1>Members</h1>

    <% if (error) { %>
      <div class="alert alert-error no-print"><%= error %></div>
    <% } %>
    <% if (notice) { %>
      <div class="alert alert-success no-print"><%= notice %></div>
    <% } %>

    <div class="roster-toolbar no-print">
      <div class="category-filter" style="margin: 0;">
        <label for="type-select">Filter by type</label>
        <select id="type-select" onchange="window.location = '/admin/members' + (this.value ? '?type=' + this.value : '')">
          <option value="" <%= !typeFilter ? 'selected' : '' %>>All</option>
          <option value="parent" <%= typeFilter === 'parent' ? 'selected' : '' %>>Parent</option>
          <option value="student" <%= typeFilter === 'student' ? 'selected' : '' %>>Student</option>
        </select>
      </div>
      <div class="roster-btn-row">
        <a class="roster-action-btn" href="/admin/members/new">+ Add Member</a>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-family-dialog').showModal()">+ Add Family</button>
        <button type="button" class="roster-action-btn file-action-btn" onclick="document.getElementById('import-dialog').showModal()">Import</button>
        <button type="button" class="roster-action-btn file-action-btn" onclick="document.getElementById('mass-import-dialog').showModal()">Mass Import Families</button>
        <a class="roster-action-btn file-action-btn" href="/admin/members/export.csv<%= typeFilter ? '?type=' + typeFilter : '' %>">Export</a>
        <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
      </div>
    </div>

    <dialog id="add-family-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/members/families/new">
        <h3>Add Family</h3>
        <p class="hint">A family must be added here before it shows up on a member's "Choose a Family" dropdown.</p>
        <label>Family Last Name
          <input type="text" name="name" placeholder="e.g. Anderson" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Family</button>
        </div>
      </form>
    </dialog>

    <dialog id="import-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/members/import" enctype="multipart/form-data">
        <h3>Import</h3>
        <p class="hint">Upload a .csv, .txt, or .xlsx file with the columns below.</p>
        <a class="btn-secondary import-sample-link" href="/admin/members/import-template.xlsx">Download Sample File</a>
        <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Import</button>
        </div>
      </form>
    </dialog>

    <dialog id="mass-import-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/members/mass-import" enctype="multipart/form-data">
        <h3>Mass Import Families</h3>
        <p class="hint">
          One row per family. The family name comes from the Primary Parent's last name; the 2nd Parent (if any) and every
          Child 1&ndash;8 with a name filled in are connected to that same family. Address/City/State/Zip/Phone are applied to
          every member of the family, including the kids - each parent's own email goes on just their profile. Every new
          member gets their own auto-generated 6-digit Member ID, which is also what their barcode encodes.
        </p>
        <a class="btn-secondary import-sample-link" href="/admin/members/mass-import/sample.xlsx">Download Sample File</a>
        <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Import Families</button>
        </div>
      </form>
    </dialog>

    <div class="roster-scroll">
      <table class="roster-table members-table members-list-table">
        <thead>
          <tr>
            <th class="members-col-photo"><span class="sr-only">Photo</span></th>
            <th>Name</th>
            <th>Type</th>
            <th class="members-col-parent">Family</th>
            <th class="members-col-rosters">Rosters</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% members.forEach(function(m) { %>
            <tr class="<%= m.is_primary_parent ? 'row-primary-parent' : '' %>">
              <td class="members-col-photo">
                <% if (m.photo_path) { %>
                  <img class="member-thumb" src="<%= m.photo_path %>" alt="" />
                <% } else { %>
                  <span class="member-thumb-placeholder"><%= m.name.charAt(0).toUpperCase() %></span>
                <% } %>
              </td>
              <td class="members-col-name">
                <a class="member-name-link" href="/admin/members/<%= m.id %>"><%= m.name %></a><%- include('partials/medical-flag', { member: m }) %>
                <% if (m.is_primary_parent) { %><span class="primary-parent-badge">Primary</span><% } %>
                <% if (m.member_type === 'student' && (m.grade_level || m.age !== null)) { %>
                  <span class="member-row-subline">
                    <%= [m.grade_level || null, m.age !== null ? (m.age + (m.age === 1 ? ' year old' : ' years old')) : null].filter(Boolean).join(' · ') %>
                  </span>
                <% } %>
              </td>
              <td><span class="badge-pill"><%= m.member_type === 'parent' ? 'Parent' : 'Student' %></span></td>
              <td class="members-col-parent"><%= m.familyName || '—' %></td>
              <td class="members-col-rosters">
                <% if (m.rosters.length === 0) { %>
                  <span class="hint">none</span>
                <% } else { %>
                  <% m.rosters.forEach(function(r) { %>
                    <span class="badge-pill"><%= r.name %></span>
                  <% }); %>
                <% } %>
              </td>
              <td class="actions-cell">
                <div class="actions-btn-row">
                  <button
                    type="button"
                    class="icon-btn<%= m.notes ? ' icon-btn-active' : '' %>"
                    onclick="document.getElementById('notes-dialog-<%= m.id %>').showModal()"
                    aria-label="Notes for <%= m.name %>"
                    title="Notes"
                  ><svg class="icon"><use href="#icon-edit"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    data-view-cards="<%= m.id %>"
                    aria-label="View cards for <%= m.name %>"
                    title="View Cards"
                  ><svg class="icon"><use href="#icon-badge"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    data-view-schedule="<%= m.id %>"
                    aria-label="View schedule for <%= m.name %>"
                    title="View Schedule"
                  ><svg class="icon"><use href="#icon-clock"/></svg></button>
                  <button
                    type="button"
                    class="icon-btn"
                    onclick="document.getElementById('delete-form-<%= m.id %>').requestSubmit();"
                    aria-label="Delete <%= m.name %>"
                    title="Delete"
                  ><svg class="icon"><use href="#icon-trash"/></svg></button>
                </div>
                <dialog id="notes-dialog-<%= m.id %>" class="notes-dialog">
                  <form method="POST" action="/admin/members/<%= m.id %>/notes">
                    <h3>Notes &mdash; <%= m.name %></h3>
                    <textarea name="notes" rows="5" placeholder="Write a note about this member&hellip;"><%= m.notes || '' %></textarea>
                    <div class="notes-dialog-actions">
                      <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                      <button type="submit" class="primary-btn">Save</button>
                    </div>
                  </form>
                </dialog>
                <%# Cards/Schedule content is fetched on open (see
                    public/js/members-dialogs.js + routes/admin-members.js)
                    rather than rendered here for every row - these start
                    empty and get their innerHTML swapped in on demand. %>
                <dialog id="cards-dialog-<%= m.id %>" class="badge-preview-dialog"></dialog>
                <dialog id="schedule-dialog-<%= m.id %>" class="schedule-preview-dialog"></dialog>
                <form method="POST" action="/admin/members/<%= m.id %>/delete" id="delete-form-<%= m.id %>" data-confirm="Permanently delete <%= m.name %>? This removes them from all rosters, volunteer lists, and all attendance history. This cannot be undone."></form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>

    <%# Printing shows this plain grid instead of the interactive table
        above (screen icons/dropdowns don't belong on paper) - see
        .members-print-table in styles.css. Uses allMembersForPrint (every
        filtered member), not the paginated `members` the on-screen table
        above uses, so a printed roster always shows the whole list
        regardless of which page happened to be open on screen. %>
    <table class="roster-table members-print-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th>Family</th>
          <th>Roster</th>
          <th>Grade</th>
          <th>Birthday</th>
        </tr>
      </thead>
      <tbody>
        <% allMembersForPrint.forEach(function(m) { %>
          <tr>
            <td><%= m.name %><%= m.is_primary_parent ? ' (Primary)' : '' %></td>
            <td><%= m.member_type === 'parent' ? 'Parent' : 'Student' %></td>
            <td><%= m.familyName || '—' %></td>
            <td><%= m.rosters.length ? m.rosters.map(function(r) { return r.name; }).join(', ') : '—' %></td>
            <td><%= m.grade_level || '—' %></td>
            <td><%= m.birthday || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
  <script src="/js/vendor/jsbarcode.min.js"></script>
  <script src="/js/name-tag-render.js"></script>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/members-dialogs.js"></script>
</body>
</html>
