<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub">Members</p>
      </div>
    </div>
    <h1>Members</h1>

    <%
      // Builds an /admin/members URL preserving every filter dimension
      // except whatever's passed in overrides - one helper instead of
      // hand-concatenating type/family/day/archived/q query strings at
      // every link on this page (tabs, filter dropdown, Export).
      function memberHref(overrides) {
        var params = Object.assign({ type: typeFilter, family: familyFilter, day: dayFilter, archived: showArchived ? '1' : '', q: q }, overrides);
        var qs = Object.keys(params).filter(function (k) { return params[k]; }).map(function (k) { return k + '=' + encodeURIComponent(params[k]); }).join('&');
        return '/admin/members' + (qs ? '?' + qs : '');
      }
    %>

    <% if (error) { %>
      <div class="alert alert-error no-print"><%= error %></div>
    <% } %>
    <% if (notice) { %>
      <div class="alert alert-success no-print"><%= notice %></div>
    <% } %>

    <button type="button" class="page-tabs-trigger no-print"><span class="page-tabs-trigger-label"><%= showArchived ? 'Archived' : 'Members' %></span> <svg class="icon"><use href="#icon-chevron-down"/></svg></button>
    <dialog class="view-tabs page-tabs-dialog no-print">
      <a class="view-tab<%= !showArchived ? ' active' : '' %>" href="<%= memberHref({ archived: '' }) %>">Members</a>
      <a class="view-tab<%= showArchived ? ' active' : '' %>" href="<%= memberHref({ archived: '1' }) %>">Archived</a>
      <button type="button" class="page-tabs-dialog-close" onclick="this.closest('dialog').close()">Close</button>
    </dialog>

    <form method="GET" action="/admin/members" class="members-search-bar no-print">
      <input type="hidden" name="type" value="<%= typeFilter %>" />
      <input type="hidden" name="family" value="<%= familyFilter || '' %>" />
      <input type="hidden" name="day" value="<%= dayFilter %>" />
      <input type="hidden" name="archived" value="<%= showArchived ? '1' : '' %>" />
      <svg class="icon"><use href="#icon-search"/></svg>
      <input type="search" name="q" value="<%= q %>" placeholder="Search members&hellip;" aria-label="Search members" />
    </form>

    <div class="roster-toolbar no-print" id="members-toolbar">
      <%# Role permissions, Import, and Add/Edit Member all live only on
          the Main Admin Portal's own Members page now - a real request:
          "the buttons on the members page will read Export, Print,
          Edit." data-fixed-columns keeps these 3 reading as two neat
          rows on mobile instead of one wide row (see roster-btn-row-
          grid.js's own comment on the attribute). %>
      <div class="roster-btn-row" data-fixed-columns="2">
        <a class="roster-action-btn file-action-btn" href="/admin/members/export.csv<%= (typeFilter || familyFilter) ? '?' : '' %><%= typeFilter ? 'type=' + typeFilter : '' %><%= (typeFilter && familyFilter) ? '&' : '' %><%= familyFilter ? 'family=' + familyFilter : '' %>">Export</a>
        <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
        <button type="button" class="roster-action-btn" data-archive-toggle="members-bulk-form" aria-pressed="false">Edit</button>
      </div>

      <%# Edit mode's Select All + Delete/Archive/Restore Selected controls
          - hidden until the "Edit" toggle button above is clicked (see
          public/js/archive-select-toggle.js, reused as-is from the Class/
          Student/Parent Schedule archive grids). %>
      <div class="class-schedule-archive-controls" data-archive-controls="members-bulk-form" hidden>
        <label class="checkbox-option class-schedule-select-all">
          <input type="checkbox" data-select-all-for="members-bulk-form" />
          Select All
        </label>
        <button
          type="submit"
          form="members-bulk-form"
          data-bulk-action="/admin/members/bulk-delete"
          class="roster-action-btn roster-action-btn-danger"
          data-bulk-confirm="Permanently delete the selected member(s)? This removes them from all rosters, volunteer lists, and all attendance history. This cannot be undone."
          data-bulk-confirm-yes-label="Yes, Delete"
        >Delete Selected</button>
        <% if (showArchived) { %>
          <button
            type="submit"
            form="members-bulk-form"
            data-bulk-action="/admin/members/bulk-unarchive"
            class="roster-action-btn"
            data-bulk-confirm="Restore the selected member(s) to the active Members list?"
            data-bulk-confirm-yes-label="Yes, Restore"
            data-bulk-confirm-safe="1"
          >Restore Selected</button>
        <% } else { %>
          <button
            type="submit"
            form="members-bulk-form"
            data-bulk-action="/admin/members/bulk-archive"
            class="roster-action-btn"
            data-bulk-confirm="Archive the selected member(s)? They'll be hidden from the active Members list, but nothing is deleted."
            data-bulk-confirm-yes-label="Yes, Archive"
            data-bulk-confirm-safe="1"
          >Archive Selected</button>
        <% } %>
      </div>

      <%# A real request: "filter by family should be under the buttons.
          it should just say filter." Single dropdown, same "one filter
          dimension at a time" model the type/family split already used -
          now with a Roster Day group alongside Type/Family. %>
      <div class="category-filter" style="margin: 0;">
        <label for="type-select">Filter</label>
        <select id="type-select" onchange="window.fullscreenNavigate(this.value)">
          <option value="<%= memberHref({ type: '', family: '', day: '' }) %>" <%= (!typeFilter && !familyFilter && !dayFilter) ? 'selected' : '' %>>All</option>
          <option value="<%= memberHref({ type: 'parent', family: '', day: '' }) %>" <%= typeFilter === 'parent' ? 'selected' : '' %>>Parent</option>
          <option value="<%= memberHref({ type: 'student', family: '', day: '' }) %>" <%= typeFilter === 'student' ? 'selected' : '' %>>Student</option>
          <option value="<%= memberHref({ type: 'admin', family: '', day: '' }) %>" <%= typeFilter === 'admin' ? 'selected' : '' %>>Admin</option>
          <optgroup label="Roster Day">
            <option value="<%= memberHref({ type: '', family: '', day: 'monday' }) %>" <%= dayFilter === 'monday' ? 'selected' : '' %>>Monday</option>
            <option value="<%= memberHref({ type: '', family: '', day: 'wednesday' }) %>" <%= dayFilter === 'wednesday' ? 'selected' : '' %>>Wednesday</option>
          </optgroup>
          <% if (families.length > 0) { %>
            <optgroup label="Family">
              <% families.forEach(function(f) { %>
                <option value="<%= memberHref({ type: '', family: f.id, day: '' }) %>" <%= familyFilter === f.id ? 'selected' : '' %>><%= f.name %></option>
              <% }); %>
            </optgroup>
          <% } %>
        </select>
      </div>
    </div>

    <form
      id="members-bulk-form"
      method="POST"
      action="/admin/members/bulk-delete"
    ></form>

    <%# A real request, with a reference screenshot: an "Add a Family"
        card above the member list - opens the same family-name dialog
        both portals already post to (POST /admin/members/families/new). %>
    <button type="button" class="members-add-family-card no-print" onclick="document.getElementById('add-family-dialog').showModal()">
      <span class="members-add-family-icon"><svg class="icon"><use href="#icon-users"/></svg></span>
      <span class="members-add-family-text">
        <span class="members-add-family-title">Add a Family</span>
        <span class="members-add-family-subtitle">Create a family group and invite members</span>
      </span>
      <svg class="icon"><use href="#icon-chevron-down"/></svg>
    </button>
    <dialog id="add-family-dialog" class="notes-dialog">
      <form method="POST" action="/admin/members/families/new">
        <h3>Add a Family</h3>
        <label class="member-form-full">Family Name
          <input type="text" name="name" placeholder="e.g. Smith" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Family</button>
        </div>
      </form>
    </dialog>

    <div class="members-section-label-row">
      <span class="members-section-label"><%= showArchived ? 'ARCHIVED' : 'MEMBERS' %></span>
      <span class="members-count-pill"><%= allMembersForPrint.length %> member<%= allMembersForPrint.length === 1 ? '' : 's' %></span>
    </div>

    <% if (members.length === 0) { %>
      <p class="roster-empty"><%= showArchived ? 'No archived members.' : 'No members match this filter yet.' %></p>
    <% } else { %>
      <div id="members-table">
        <% members.forEach(function(m) { %>
          <% var familySize = members.filter(function(x) { return x.family_id != null && x.family_id === m.family_id; }).length; %>
          <% var isFamilyHead = m.is_primary_parent || m.family_id == null || familySize < 2; %>
          <div
            class="member-row-card"
            data-family-key="<%= m.family_id != null ? 'f' + m.family_id : 'solo' + m.id %>"
            data-family-member="<%= isFamilyHead ? '' : '1' %>"
          >
            <input type="checkbox" name="memberIds" value="<%= m.id %>" form="members-bulk-form" class="archive-select-checkbox no-print" aria-label="Select <%= m.name %>" hidden />
            <span class="member-avatar member-avatar-<%= avatarColorFor(m.family_id != null ? m.family_id : m.id) %>">
              <% if (m.photo_path) { %>
                <img src="<%= photoUrl(m.photo_path) %>" alt="" />
              <% } else { %>
                <%= m.name.charAt(0).toUpperCase() %>
              <% } %>
            </span>
            <div class="member-row-body">
              <div class="member-row-topline">
                <a class="member-row-name-link" href="/admin/members/<%= m.id %>"><%= m.name %></a><%- include('partials/medical-flag', { member: m }) %>
                <span class="badge-pill badge-pill-<%= avatarColorFor(m.family_id != null ? m.family_id : m.id) %> member-role-badge"><svg class="icon"><use href="#icon-star"/></svg> <%= m.member_type === 'parent' ? 'Parent' : m.member_type === 'admin' ? 'Admin' : 'Student' %></span>
                <% if (m.is_primary_parent) { %><span class="primary-parent-badge">Primary</span><% } %>
                <%# A real request: "this will then add their admin title
                    label next to their name on member lists." %>
                <% if (m.adminTitle) { %><span class="badge-pill" title="Admin Position"><%= m.adminTitle %></span><% } %>
              </div>
              <%# A real request: "icons in a row below the name" - every
                  small fact line (grade/age or family, roster) used to be
                  its own stacked row; now they share one wrapping row so
                  the card reads as name+badges on line one, everything
                  else compact underneath. %>
              <% if ((m.member_type === 'student' && (m.grade_level || m.age !== null)) || m.familyName || m.rosters.length > 0) { %>
                <div class="member-row-icon-row">
                  <% if (m.member_type === 'student' && (m.grade_level || m.age !== null)) { %>
                    <span class="member-row-subline">
                      <svg class="icon"><use href="#icon-graduation-cap"/></svg>
                      <%= [m.grade_level || null, m.age !== null ? (m.age + (m.age === 1 ? ' year old' : ' years old')) : null].filter(Boolean).join(' · ') %>
                    </span>
                  <% } else if (m.familyName) { %>
                    <span class="member-row-subline"><svg class="icon"><use href="#icon-home"/></svg> <%= m.familyName %></span>
                  <% } %>
                  <% if (m.rosters.length > 0) { %>
                    <span class="member-row-subline">
                      <svg class="icon"><use href="#icon-calendar-check"/></svg>
                      <%= m.rosters.map(function(r) { return r.name; }).join(', ') %>
                    </span>
                  <% } %>
                </div>
              <% } %>
            </div>
            <div class="member-row-actions no-print">
              <% if (m.email) { %>
                <a class="icon-btn" href="mailto:<%= m.email %>" aria-label="Email <%= m.name %>" title="Email <%= m.name %>"><svg class="icon"><use href="#icon-mail"/></svg></a>
              <% } else { %>
                <span class="icon-btn icon-btn-disabled" aria-hidden="true" title="No email on file"><svg class="icon"><use href="#icon-mail"/></svg></span>
              <% } %>
              <%# A real request: "add an icon that shows sending
                  something. when you click it a pop up will appear
                  and ask, do you want to add this name tag to the
                  request log? yes, no buttons, close windows." Follow-up
                  request: "if they are already on the log, it should
                  say, this member is already on the name tags request
                  log. and the popup closes" - swaps in the sitewide
                  dialog's info-only mode instead of the Add confirm. %>
              <% if (pendingNameTagMemberIds.has(m.id)) { %>
                <button
                  type="button"
                  class="icon-btn"
                  data-info-message="This member is already on the name tags request log."
                  data-info-icon="icon-send"
                  aria-label="Add name tag request for <%= m.name %>"
                  title="Add to Name Tag Request Log"
                ><svg class="icon"><use href="#icon-send"/></svg></button>
              <% } else { %>
                <button
                  type="button"
                  class="icon-btn"
                  data-name-tag-request-url="/admin/members/<%= m.id %>/request-name-tag"
                  aria-label="Add name tag request for <%= m.name %>"
                  title="Add to Name Tag Request Log"
                ><svg class="icon"><use href="#icon-send"/></svg></button>
              <% } %>
              <details class="member-row-menu">
                <summary class="icon-btn" aria-label="More actions for <%= m.name %>" title="More"><svg class="icon"><use href="#icon-more"/></svg></summary>
                <div class="member-row-menu-list">
                  <button type="button" class="member-row-menu-item" onclick="document.getElementById('notes-dialog-<%= m.id %>').showModal()">
                    <svg class="icon"><use href="#icon-edit"/></svg> Notes<%= m.notes ? ' (saved)' : '' %>
                  </button>
                  <button type="button" class="member-row-menu-item" data-view-cards="<%= m.id %>">
                    <svg class="icon"><use href="#icon-badge"/></svg> View Cards
                  </button>
                  <button type="button" class="member-row-menu-item" data-view-schedule="<%= m.id %>">
                    <svg class="icon"><use href="#icon-clock"/></svg> View Schedule
                  </button>
                  <button
                    type="button"
                    class="member-row-menu-item member-row-menu-item-danger"
                    data-member-delete-url="/admin/members/<%= m.id %>/delete"
                    data-member-delete-name="<%= m.name %>"
                    data-member-delete-message="Permanently delete <%= m.name %>? This removes them from all rosters, volunteer lists, and all attendance history. This cannot be undone."
                  ><svg class="icon"><use href="#icon-trash"/></svg> Delete</button>
                </div>
              </details>
              <% if (isFamilyHead && familySize > 1) { %>
                <button type="button" class="family-accordion-toggle" aria-expanded="false" aria-label="Show <%= familySize - 1 %> more family member<%= familySize - 1 === 1 ? '' : 's' %>">
                  <svg class="icon"><use href="#icon-chevron-down"/></svg>
                </button>
              <% } else { %>
                <span class="member-row-chevron-spacer"></span>
              <% } %>
            </div>
            <dialog id="notes-dialog-<%= m.id %>" class="notes-dialog">
              <form method="POST" action="/admin/members/<%= m.id %>/notes">
                <h3>Notes &mdash; <%= m.name %></h3>
                <textarea name="notes" rows="5" placeholder="Write a note about this member&hellip;"><%= m.notes || '' %></textarea>
                <div class="notes-dialog-actions">
                  <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                  <button type="submit" class="primary-btn">Save</button>
                </div>
              </form>
            </dialog>
            <%# Cards/Schedule content is fetched on open (see
                public/js/members-dialogs.js + routes/admin-members.js)
                rather than rendered here for every row - these start
                empty and get their innerHTML swapped in on demand. %>
            <dialog id="cards-dialog-<%= m.id %>" class="badge-preview-dialog"></dialog>
            <dialog id="schedule-dialog-<%= m.id %>" class="schedule-preview-dialog"></dialog>
          </div>
        <% }); %>
      </div>
    <% } %>

    <%
      // "Select All" (public/js/archive-select-toggle.js) only ever checks
      // checkboxes actually present in the DOM, and this list only
      // renders one page's worth of members at a time (see the route's
      // own pagination) - without these, Select All on a multi-page list
      // would silently reach just the current page. Carries the rest of
      // allMembersForPrint (every member matching the current type/family/
      // archived filter, unpaginated) so Select All can reach every page,
      // same pattern as admin-schedule.ejs's own off-page checkboxes.
      var pageIds = members.map(function (m) { return m.id; });
    %>
    <% allMembersForPrint.forEach(function(m) { %>
      <% if (pageIds.indexOf(m.id) === -1) { %>
        <input type="checkbox" name="memberIds" value="<%= m.id %>" form="members-bulk-form" class="archive-offpage-checkbox" aria-hidden="true" hidden />
      <% } %>
    <% }); %>

    <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>

    <%# Printing shows this plain grid instead of the interactive card list
        above (screen icons/dropdowns don't belong on paper) - see
        .members-print-table in styles.css. Uses allMembersForPrint (every
        filtered member), not the paginated `members` the on-screen list
        above uses, so a printed roster always shows the whole list
        regardless of which page happened to be open on screen. %>
    <table class="roster-table members-print-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th>Family</th>
          <th>Roster</th>
          <th>Grade</th>
          <th>Birthday</th>
        </tr>
      </thead>
      <tbody>
        <% allMembersForPrint.forEach(function(m) { %>
          <tr>
            <td><%= m.name %><%= m.is_primary_parent ? ' (Primary)' : '' %><%= m.adminTitle ? ' (' + m.adminTitle + ')' : '' %></td>
            <td><%= m.member_type === 'parent' ? 'Parent' : m.member_type === 'admin' ? 'Admin' : 'Student' %></td>
            <td><%= m.familyName || '—' %></td>
            <td><%= m.rosters.length ? m.rosters.map(function(r) { return r.name; }).join(', ') : '—' %></td>
            <td><%= m.grade_level || '—' %></td>
            <td><%= m.birthdayLabel || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
  <script src="/js/vendor/jsbarcode.min.js"></script>
  <script src="/js/name-tag-render.js"></script>
  <script src="/js/badge-autofit.js"></script>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/members-dialogs.js"></script>
  <script src="/js/member-name-tag-request.js"></script>
  <script src="/js/members-family-accordion.js"></script>
  <script src="/js/archive-select-toggle.js"></script>
  <script src="/js/members-bulk-actions.js"></script>
  <script src="/js/member-row-actions.js"></script>
</body>
</html>
