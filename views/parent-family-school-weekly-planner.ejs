<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%# "Week 1 title on the title bar of week schedule." %>
    <div class="roster-toolbar no-print">
      <h1>Weekly Planner<% if (selectedWeek) { %> &mdash; <%= selectedWeek.title %><% } %></h1>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <%# A real request: "Weeks are blue buttons. Delete the blue
        buttons. The filter button changes students and week view."
        The old quick week-switching tabs row (a .btn-secondary per
        week) is gone - the Filter popover below already picks the
        student/year/week, so it was pure duplication of that same
        choice. A further real request: "all pages filter button
        first, all import, export, pdf and print icons should be in a
        row next to each other... placed to the left above the
        tables/lists" - one single toolbar row: Filter, then the icons
        (only meaningful once a week is selected), then + Add Week. %>
    <div class="roster-toolbar no-print">
      <div class="roster-btn-row roster-btn-row-fit-text">
        <details class="filter-details" data-filter-details>
          <summary class="roster-action-btn">Filter</summary>
          <form method="GET" action="/parent/family-school/weekly-planner" class="filter-panel">
            <label for="weekly-planner-owner-select">Student
              <select id="weekly-planner-owner-select" name="owner">
                <% familyStudents.forEach(function(s) { %>
                  <option value="<%= s.id %>" <%= ownerParam === String(s.id) ? 'selected' : '' %>><%= s.name %></option>
                <% }); %>
                <option value="parent" <%= ownerParam === 'parent' ? 'selected' : '' %>>Parent</option>
                <option value="family" <%= ownerParam === 'family' ? 'selected' : '' %>>Whole Family</option>
              </select>
            </label>
            <label for="weekly-planner-school-year-select">School Year
              <select id="weekly-planner-school-year-select" name="schoolYear">
                <option value="all" <%= schoolYearFilter === 'all' ? 'selected' : '' %>>All Years</option>
                <% weekSchoolYearOptions.forEach(function(y) { %>
                  <option value="<%= y %>" <%= schoolYearFilter === y ? 'selected' : '' %>><%= y %></option>
                <% }); %>
              </select>
            </label>
            <label for="weekly-planner-week-select">Week
              <select id="weekly-planner-week-select" name="weekId">
                <option value="">Choose a week&hellip;</option>
                <% weeks.forEach(function(w) { %>
                  <option value="<%= w.id %>" <%= selectedWeek && selectedWeek.id === w.id ? 'selected' : '' %>><%= w.title %></option>
                <% }); %>
              </select>
            </label>
            <button type="submit" class="primary-btn">Apply</button>
          </form>
        </details>
        <% if (selectedWeek) { %>
          <a class="icon-btn" href="/parent/family-school/weekly-planner/export.csv?weekId=<%= selectedWeek.id %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
          <a class="icon-btn" href="/parent/family-school/weekly-planner/print?weekId=<%= selectedWeek.id %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
          <a class="icon-btn" href="/parent/family-school/weekly-planner/download.pdf?weekId=<%= selectedWeek.id %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
        <% } %>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-week-dialog').showModal()">+ Add Week</button>
      </div>
    </div>

    <% if (!selectedWeek) { %>
      <% if (weeks.length === 0) { %>
        <p class="roster-empty">No weeks yet. Click "+ Add Week" to create one.</p>
      <% } else { %>
        <p class="roster-empty">Pick a week above to see its grid.</p>
      <% } %>
    <% } else { %>
      <%# A real request: "a label that says the week title with an
          edit icon on it. When you click the edit icon it allows you
          to edit the week such as the dates, title, description or
          delete the week completely. Remove the trash button on
          weekly planner view." Replaces the old bare trash-icon row -
          editing (including deleting) now all happens through the one
          Edit Week dialog below. A later real request: "Weekly
          planner, week title and edit icon should be in a blue button
          looking box to the left." - fs-weekly-plan-week-title-row
          turns this same row into that solid blue box instead of a
          plain row (it already sits at the left by default). %>
      <div class="roster-btn-row roster-btn-row-fit-text no-print fs-weekly-plan-row-spaced fs-weekly-plan-week-title-row">
        <span class="fs-weekly-plan-week-title"><%= selectedWeek.title %></span>
        <button type="button" class="icon-btn" aria-label="Edit week" title="Edit week" onclick="document.getElementById('edit-week-dialog').showModal()"><svg class="icon"><use href="#icon-edit"/></svg></button>
      </div>

      <div class="roster-scroll">
        <table class="roster-table condensed-table fs-weekly-plan-grid">
          <thead>
            <tr>
              <%# A real request: "Day completed check box should be on
                  the title bar next to each date." Replaces the old
                  separate "Day complete" checkbox+label row inside the
                  cell body below with one inline checkbox right next to
                  the date itself, in the header that's already each
                  day's own title bar. %>
              <% grid.forEach(function(d) { %>
                <th>
                  <div class="fs-weekly-plan-day-title-row">
                    <span><%= d.dateLabel %></span>
                    <form method="POST" action="/parent/family-school/weekly-planner/dates/<%= d.id %>/toggle-complete" class="inline-block-form fs-weekly-plan-day-complete-inline-form">
                      <input type="checkbox" class="fs-weekly-plan-day-complete-checkbox" <%= d.completed ? 'checked' : '' %> onchange="this.form.requestSubmit()" aria-label="Mark <%= d.dateLabel %> complete" title="Day complete" />
                    </form>
                  </div>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <tr>
              <%# "Allow to drag and drop lessons and assignments between
                  days." Every day's own content (whether it already has
                  assignments or not) is wrapped in one drop-target div
                  tagged with its own week-date id, so an empty day is
                  just as valid a drop target as one that already has a
                  list - public/js/weekly-planner-dragdrop.js. %>
              <% grid.forEach(function(d) { %>
                <td>
                  <%# Hidden on desktop (the real <th> above already
                      shows this day's label, checkbox included) - shown
                      only in the mobile stacked layout below, where
                      each day becomes its own full-width block with no
                      column headers left to read. Same inline checkbox,
                      same "plain form, no fetch" convention as every
                      other checkbox toggle in this app. %>
                  <div class="fs-weekly-plan-day-label-mobile fs-weekly-plan-day-title-row">
                    <span><%= d.dateLabel %></span>
                    <form method="POST" action="/parent/family-school/weekly-planner/dates/<%= d.id %>/toggle-complete" class="inline-block-form fs-weekly-plan-day-complete-inline-form">
                      <input type="checkbox" class="fs-weekly-plan-day-complete-checkbox" <%= d.completed ? 'checked' : '' %> onchange="this.form.requestSubmit()" aria-label="Mark <%= d.dateLabel %> complete" title="Day complete" />
                    </form>
                  </div>
                  <div class="fs-weekly-plan-dropzone" data-week-date-id="<%= d.id %>">
                    <% if (d.assignments.length === 0) { %>
                      <p class="roster-empty fs-weekly-plan-empty-hint">Nothing yet.</p>
                    <% } %>
                    <ul class="fs-weekly-plan-assignment-list" <%= d.assignments.length === 0 ? 'hidden' : '' %>>
                      <% d.assignments.forEach(function(a) { %>
                        <li data-assignment-id="<%= a.id %>" class="<%= a.completed ? 'fs-weekly-plan-assignment-done' : '' %>">
                          <span class="lesson-drag-handle fs-weekly-plan-drag-handle" data-assignment-drag-handle title="Drag to move to another day">&#9776;</span>
                          <%# "Check boxes next to each assignment." %>
                          <form method="POST" action="/parent/family-school/weekly-planner/assignments/<%= a.id %>/toggle-complete" class="inline-block-form">
                            <input type="checkbox" <%= a.completed ? 'checked' : '' %> onchange="this.form.requestSubmit()" aria-label="Mark <%= a.title %> complete" title="Mark complete" />
                          </form>
                          <span class="fs-weekly-plan-assignment-text">
                            <% if (a.subject) { %><strong><%= a.subject %>:</strong> <% } %><%= a.title %>
                            <% if (a.description) { %><br /><span class="hint"><%= a.description %></span><% } %>
                            <% if (a.link_url) { %> &middot; <a href="<%= a.link_url %>" target="_blank" rel="noopener">Link</a><% } %>
                            <% if (a.fileUrl) { %> &middot; <a href="<%= a.fileUrl %>" target="_blank" rel="noopener"><%= a.file_name %></a><% } %>
                            <% if (a.grade) { %> <span class="badge-pill">Grade: <%= a.grade %></span><% } %>
                          </span>
                          <%# "Add edit icon and delete to all weekly
                              planner assignments. No refresh page when
                              delete" - public/js/weekly-planner-
                              assignment-edit.js. %>
                          <button type="button" class="icon-btn" aria-label="Edit assignment" title="Edit"
                            data-edit-assignment="<%= a.id %>"
                            data-subject="<%= a.subject || '' %>"
                            data-title="<%= a.title %>"
                            data-description="<%= a.description || '' %>"
                            data-link="<%= a.link_url || '' %>"
                            data-grade="<%= a.grade || '' %>"><svg class="icon"><use href="#icon-edit"/></svg></button>
                          <button type="button" class="icon-btn icon-btn-danger" aria-label="Delete assignment" title="Delete"
                            data-delete-assignment="<%= a.id %>"
                            data-assignment-title="<%= a.title %>"><svg class="icon"><use href="#icon-trash"/></svg></button>
                        </li>
                      <% }); %>
                    </ul>
                  </div>
                  <%# "Add two buttons add class assignment and add new
                      assignment." Two separate dialogs below (one per
                      day, same as before this split) instead of the one
                      combined dialog this used to open. %>
                  <div class="roster-btn-row roster-btn-row-fit-text fs-weekly-plan-add-btn-row">
                    <button type="button" class="roster-action-btn fs-weekly-plan-add-btn" onclick="document.getElementById('add-class-assignment-dialog-<%= d.id %>').showModal()">+ Class Assignment</button>
                    <button type="button" class="roster-action-btn fs-weekly-plan-add-btn" onclick="document.getElementById('add-new-assignment-dialog-<%= d.id %>').showModal()">+ New Assignment</button>
                  </div>
                </td>
              <% }); %>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="manage-section">
        <h2>This Week by Subject</h2>
        <%- include('partials/family-school-subject-chart', { subjectBreakdown }) %>
      </div>

      <%# "Add two buttons add class assignment and add new assignment.
          When adding a new class assignment popup, it should show a
          dropdown of classes, lessons and assignments to choose from
          that the parent has created and assigned to the student."
          Dropdown-only - no freeform subject/title fields here, unlike
          before this split. One pair of dialogs per date column, same
          as before. %>
      <% grid.forEach(function(d) { %>
        <dialog id="add-class-assignment-dialog-<%= d.id %>" class="class-form-dialog">
          <form method="POST" action="/parent/family-school/weekly-planner/dates/<%= d.id %>/assignments" class="stack-form">
            <div class="class-form-dialog-header">
              <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
              <h3>Add Class Assignment &mdash; <%= d.dateLabel %></h3>
            </div>
            <% if (assignmentOptions.length > 0) { %>
              <label>Choose a class assignment
                <select name="contentItemId" required>
                  <option value="">Select one&hellip;</option>
                  <% assignmentOptions.forEach(function(a) { %>
                    <option value="<%= a.id %>"><%= a.class_name %> &mdash; <%= a.title %></option>
                  <% }); %>
                </select>
              </label>
            <% } else { %>
              <p class="hint">No class assignments created yet - add one under Family Classes first.</p>
            <% } %>
            <div class="notes-dialog-actions">
              <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
              <button type="submit" class="primary-btn" <%= assignmentOptions.length === 0 ? 'disabled' : '' %>>Save</button>
            </div>
          </form>
        </dialog>
      <% }); %>

      <%# "When clicking the add new assignment button you can add a
          fresh and new assignment and it will ask title, description,
          link, upload, grade, subject." multipart/form-data for the
          upload field - routes/parent-family-school.js's own
          uploadWeekAssignmentFile (multer) only engages for this
          dialog's own multipart POST, leaving the Class Assignment
          dialog's plain urlencoded POST above untouched. %>
      <% grid.forEach(function(d) { %>
        <dialog id="add-new-assignment-dialog-<%= d.id %>" class="class-form-dialog">
          <form method="POST" action="/parent/family-school/weekly-planner/dates/<%= d.id %>/assignments" enctype="multipart/form-data" class="stack-form">
            <div class="class-form-dialog-header">
              <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
              <h3>Add New Assignment &mdash; <%= d.dateLabel %></h3>
            </div>
            <label>Title
              <input type="text" name="title" placeholder="e.g. Chapter 3 worksheet" required />
            </label>
            <label>Subject
              <input type="text" name="subject" placeholder="e.g. Math" />
            </label>
            <label>Description
              <textarea name="description" rows="2" placeholder="Details about this assignment"></textarea>
            </label>
            <label>Link
              <input type="url" name="link" placeholder="https://&hellip;" />
            </label>
            <label>Upload
              <input type="file" name="upload" />
            </label>
            <label>Grade
              <input type="text" name="grade" placeholder="e.g. A, 95%, Pass" />
            </label>
            <div class="notes-dialog-actions">
              <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
              <button type="submit" class="primary-btn">Save</button>
            </div>
          </form>
        </dialog>
      <% }); %>

      <%# A real request: "a label that says the week title with an
          edit icon on it. When you click the edit icon it allows you
          to edit the week such as the dates, title, description or
          delete the week completely." Pre-filled server-side straight
          from selectedWeek/grid (there's only ever one week open on
          this page at a time, unlike the per-assignment Edit dialog
          above, which needs JS to repopulate itself per row) - same
          up-to-7-dates shape as Add Week, with Delete Week folded in
          as this dialog's own danger action instead of a bare icon
          sitting in the main toolbar. %>
      <dialog id="edit-week-dialog" class="class-form-dialog">
        <%# A <form> can't contain another <form> - a browser's HTML
            parser silently drops a nested one, which left the "Delete
            Week" button submitting this SAME edit form instead (and
            the real edit form's own closing tag got consumed by the
            delete form's stray </form>, so "Save Changes" ended up
            outside any form at all and stopped submitting anything).
            Fixed by keeping Delete Week's own <form> as a sibling
            after this one closes, and pointing "Save Changes" back at
            the edit form by id (the standard HTML `form` attribute)
            instead of relying on DOM nesting. %>
        <form method="POST" action="/parent/family-school/weekly-planner/<%= selectedWeek.id %>/edit" id="edit-week-form" class="stack-form">
          <div class="class-form-dialog-header">
            <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
            <h3>Edit Week</h3>
          </div>
          <label>Title
            <input type="text" name="title" value="<%= selectedWeek.title %>" required />
          </label>
          <label>Description
            <textarea name="description" rows="2" placeholder="Details about this week"><%= selectedWeek.description || '' %></textarea>
          </label>
          <% for (var i = 0; i < 7; i++) { %>
            <label>Date <%= i + 1 %><% if (i > 0) { %> <span class="hint">(optional)</span><% } %>
              <input type="date" name="date" value="<%= grid[i] ? grid[i].date : '' %>" <%= i === 0 ? 'required' : '' %> />
            </label>
          <% } %>
        </form>
        <div class="notes-dialog-actions">
          <form method="POST" action="/parent/family-school/weekly-planner/<%= selectedWeek.id %>/delete" data-confirm="Delete &quot;<%= selectedWeek.title %>&quot;? This removes every assignment in it too." class="inline-block-form">
            <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete Week</button>
          </form>
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" form="edit-week-form" class="primary-btn">Save Changes</button>
        </div>
      </dialog>
    <% } %>

    <%# "Add week button. Popup allows you to choose up to 7 dates. And
        add a title such as week 1, week 2 etc. Create and cancel
        buttons." Exactly 7 plain date inputs sharing the one "date"
        name (read back as an array - routes/parent-family-school.js's
        own POST /weekly-planner) rather than a custom multi-date-picker
        widget, matching this app's plain-HTML-forms style everywhere
        else. Only the first is required - "up to 7" allows fewer. %>
    <dialog id="add-week-dialog" class="class-form-dialog">
      <form method="POST" action="/parent/family-school/weekly-planner" class="stack-form">
        <div class="class-form-dialog-header">
          <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
          <h3>Add Week</h3>
        </div>
        <input type="hidden" name="ownerType" value="<%= owner.ownerType %>" />
        <% if (owner.ownerType === 'student') { %><input type="hidden" name="studentId" value="<%= owner.studentId %>" /><% } %>
        <label>Title
          <input type="text" name="title" placeholder="e.g. Week 1" required />
        </label>
        <% for (var i = 0; i < 7; i++) { %>
          <label>Date <%= i + 1 %><% if (i > 0) { %> <span class="hint">(optional)</span><% } %>
            <input type="date" name="date" <%= i === 0 ? 'required' : '' %> />
          </label>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create</button>
        </div>
      </form>
    </dialog>

    <%# A real request: "Add edit icon and delete to all weekly planner
        assignments." One shared dialog (not one per assignment) -
        public/js/weekly-planner-assignment-edit.js populates it and
        sets the form's action from the clicked assignment's own Edit
        button before showing it, same convention as Annual Planner's
        own Edit Curriculum dialog. %>
    <dialog id="edit-assignment-dialog" class="class-form-dialog">
      <form method="POST" action="" class="stack-form" id="edit-assignment-form">
        <div class="class-form-dialog-header">
          <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
          <h3>Edit Assignment</h3>
        </div>
        <label>Title
          <input type="text" name="title" placeholder="e.g. Chapter 3 worksheet" required />
        </label>
        <label>Subject
          <input type="text" name="subject" placeholder="e.g. Math" />
        </label>
        <label>Description
          <textarea name="description" rows="2" placeholder="Details about this assignment"></textarea>
        </label>
        <label>Link
          <input type="url" name="link" placeholder="https://&hellip;" />
        </label>
        <label>Grade
          <input type="text" name="grade" placeholder="e.g. A, 95%, Pass" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Save Changes</button>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/weekly-planner-dragdrop.js"></script>
  <script src="/js/weekly-planner-assignment-edit.js"></script>
  <script src="/js/filter-details-dismiss.js"></script>
</body>
</html>
