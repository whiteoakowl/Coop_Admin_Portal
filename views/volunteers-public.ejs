<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="kiosk" data-idle-redirect="20000">
  <%- include('partials/icon-sprite') %>
  <a class="kiosk-home" href="/"><svg class="icon"><use href="#icon-home"/></svg> Return to Home Screen</a>
  <div class="kiosk-header">
    <img class="kiosk-logo" src="/img/logo.png" alt="" />
    <h1><%= dayLabel %> Floater Assignments</h1>
  </div>

  <% if (!scheduledToday) { %>
    <div class="kiosk-wrap">
      <div class="kiosk-panel kiosk-panel-muted">
        <p class="kiosk-message">No floater assignments for today.</p>
      </div>
    </div>
  <% } else { %>
    <div class="volunteer-public-grid">
      <% grid.sections.forEach(function(section) { %>
        <% if (section.members.length > 0) { %>
          <div class="volunteer-public-card">
            <h2 class="volunteer-public-section"><%= section.label %></h2>
            <table class="volunteer-public-table">
              <thead>
                <tr><th>Name</th><th>Volunteer Position</th><th>Location</th></tr>
              </thead>
              <tbody>
                <% section.members.forEach(function(row) { %>
                  <tr>
                    <td><%= row.member.name %></td>
                    <td><% if (row.cells[0].position) { %><span class="volunteer-bubble volunteer-bubble-position"><%= row.cells[0].position %></span><% } %></td>
                    <td><% if (row.cells[0].room) { %><span class="volunteer-bubble volunteer-bubble-room"><%= row.cells[0].room %></span><% } %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      <% }); %>
    </div>
  <% } %>
  <script src="/js/idle-redirect.js"></script>
</body>
</html>
