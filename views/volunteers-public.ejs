<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<%# A real request: "Quicklinks have been created for member to quickly
    view ... floater assignments ... When they go to these quick links
    they should be stand alone pages not connected to the kiosk. Member
    should not be able to access the kiosk by going to these pages."
    fromKiosk (routes/volunteers.js's own isFromKiosk) is only true when
    this page was reached from the Kiosk home screen's own link
    (?kiosk=1) - a direct Quick Link/QR code visit gets neither the
    idle-redirect timer nor the Return to Home Screen link. %>
<body class="kiosk"<% if (fromKiosk) { %> data-idle-redirect="20000"<% } %>>
  <%- include('partials/icon-sprite') %>
  <% if (fromKiosk) { %>
    <a class="kiosk-home" href="/kiosk"><svg class="icon"><use href="#icon-home"/></svg> Return to Home Screen</a>
  <% } %>
  <div class="kiosk-header">
    <img class="kiosk-logo" src="/img/logo.png" alt="" />
    <div class="kiosk-header-text">
      <h1><%= dayLabel %> Floater Assignments</h1>
      <% if (dateLabel) { %><p class="kiosk-subhead"><%= dateLabel %></p><% } %>
    </div>
  </div>

  <% if (!date) { %>
    <div class="kiosk-wrap">
      <div class="kiosk-panel kiosk-panel-muted">
        <p class="kiosk-message">No upcoming floater assignments.</p>
      </div>
    </div>
  <% } else { %>
    <div class="kiosk-wrap volunteer-public-wrap">
      <%- include('partials/floater-assignment-cards', { cards: cards, dayLabel: dayLabel, dateLabel: dateLabel, kiosk: true }) %>
    </div>
  <% } %>
  <script src="/js/idle-redirect.js"></script>
  <script src="/js/fullscreen-nav.js"></script>
</body>
</html>
