<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/portal-nav', { portalTitle }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Contact Admins</h1>
    <p class="subtitle">Contact leadership teams for support with classes, finances, events, volunteer positions, attendance, yearbook, and general co-op questions.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="manage-section">
      <h2>Send Message</h2>
      <% if (departments.length === 0) { %>
        <p class="hint">No admin departments are set up to receive messages yet.</p>
      <% } else { %>
        <form method="POST" action="/contact-admins<%= portalQueryString %>" class="stack-form dialog-label-stack">
          <label>Department
            <select name="positionId" required>
              <option value="">Choose a department&hellip;</option>
              <% departments.forEach(function(d) { %>
                <option value="<%= d.id %>"><%= d.title %></option>
              <% }); %>
            </select>
          </label>
          <label>Your Email
            <input type="email" value="<%= senderEmail %>" readonly />
          </label>
          <label>Message Title
            <input type="text" name="title" placeholder="Enter message title" required />
          </label>
          <label>Message
            <textarea name="message" rows="5" placeholder="Type your message here..." required></textarea>
          </label>
          <button type="submit" class="primary-btn">Submit Message</button>
        </form>
      <% } %>
    </div>
  </main>
</body>
</html>
