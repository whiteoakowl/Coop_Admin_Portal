<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Submissions &mdash; <%= form.title %></h1>

    <div class="roster-toolbar">
      <div class="roster-btn-row">
        <a class="roster-action-btn" href="/main-admin/forms/<%= form.id %>/builder">&larr; Back to Form</a>
        <a class="roster-action-btn" href="/main-admin/forms/<%= form.id %>/submissions/export">Export CSV</a>
      </div>
    </div>

    <% if (submissions.length === 0) { %>
      <p class="roster-empty">No submissions yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>Member</th>
              <th>Submitted</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% submissions.forEach(function(s) { %>
              <tr>
                <td class="roster-name-col"><%= s.memberName %></td>
                <td><%= s.submitted_at %></td>
                <td><a href="/main-admin/forms/<%= form.id %>/submissions/<%= s.id %>">View</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
