<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Communication' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/diplomas', icon: 'badge', label: 'Diplomas' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Text/Email</h1>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="roster-btn-row">
      <a class="roster-action-btn" href="/main-admin/announcements/text-email/filter">Filter</a>
      <a class="roster-action-btn" href="/main-admin/announcements/text-email/send-text">Send Text</a>
      <a class="roster-action-btn" href="/main-admin/announcements/text-email/send-email">Send Email</a>
    </div>
    <p class="hint">
      <% if (recipientCount > 0) { %>
        Filtered to <%= recipientCount %> recipient<%= recipientCount === 1 ? '' : 's' %> - Send Text/Send Email will go to that filtered list. <a href="/main-admin/announcements/text-email/filter">Change</a>
      <% } else { %>
        No filter applied - Send Text/Send Email will go to every active member. <a href="/main-admin/announcements/text-email/filter">Filter recipients</a>
      <% } %>
    </p>

    <h2>Past &amp; Scheduled Texts</h2>
    <% if (textCampaigns.length === 0) { %>
      <p class="roster-empty">No texts sent yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table condensed-table table-stack-mobile">
          <thead><tr><th>Message</th><th>Status</th><th>Recipients</th><th>Scheduled</th><th>Sent</th><th></th></tr></thead>
          <tbody>
            <% textCampaigns.forEach(function(c) { %>
              <tr>
                <td class="roster-name-col table-stack-heading"><%= c.body %></td>
                <td data-label="Status"><span class="badge-pill badge-pill-<%= c.status === 'sent' ? 'green' : 'orange' %>"><%= c.status.charAt(0).toUpperCase() + c.status.slice(1) %></span></td>
                <td data-label="Recipients"><%= c.recipient_count %></td>
                <td data-label="Scheduled"><%= c.scheduled_at || '' %></td>
                <td data-label="Sent"><%= c.sent_at || '' %></td>
                <td>
                  <% if (c.status === 'scheduled') { %>
                    <form method="POST" action="/main-admin/announcements/text/<%= c.id %>/send" data-confirm="Send this text now?">
                      <button type="submit" class="roster-action-btn">Send Now</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <h2>Past &amp; Scheduled Emails</h2>
    <% if (emailCampaigns.length === 0) { %>
      <p class="roster-empty">No emails sent yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table condensed-table table-stack-mobile">
          <thead><tr><th>Subject</th><th>Status</th><th>Recipients</th><th>Scheduled</th><th>Sent</th><th></th></tr></thead>
          <tbody>
            <% emailCampaigns.forEach(function(c) { %>
              <tr>
                <td class="roster-name-col table-stack-heading"><%= c.subject %></td>
                <td data-label="Status"><span class="badge-pill badge-pill-<%= c.status === 'sent' ? 'green' : 'orange' %>"><%= c.status.charAt(0).toUpperCase() + c.status.slice(1) %></span></td>
                <td data-label="Recipients"><%= c.recipient_count %></td>
                <td data-label="Scheduled"><%= c.scheduled_at || '' %></td>
                <td data-label="Sent"><%= c.sent_at || '' %></td>
                <td>
                  <% if (c.status === 'scheduled') { %>
                    <form method="POST" action="/main-admin/announcements/email/<%= c.id %>/send" data-confirm="Send this email now?">
                      <button type="submit" class="roster-action-btn">Send Now</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
