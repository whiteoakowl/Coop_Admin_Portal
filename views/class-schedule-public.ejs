<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="kiosk" data-idle-redirect="20000">
  <%- include('partials/icon-sprite') %>
  <a class="kiosk-home" href="/kiosk"><svg class="icon"><use href="#icon-home"/></svg> Return to Home Screen</a>
  <div class="kiosk-header">
    <img class="kiosk-logo" src="/img/logo.png" alt="" />
    <h1><%= dayLabel %> Class Schedule</h1>
  </div>

  <div class="class-schedule-public-daytabs">
    <a class="view-tab<%= day === 'monday' ? ' active' : '' %>" href="/class-schedule/monday">Monday</a>
    <a class="view-tab<%= day === 'wednesday' ? ' active' : '' %>" href="/class-schedule/wednesday">Wednesday</a>
  </div>

  <div class="class-schedule-public-grid">
    <% grid.forEach(function(hour) { %>
      <div class="class-schedule-public-hour">
        <h2 class="class-schedule-hour-label"><%= hour.label %></h2>
        <% if (hour.classes.length === 0) { %>
          <p class="roster-empty">No classes this hour.</p>
        <% } else { %>
          <div class="class-card-row">
            <% hour.classes.forEach(function(cls) { %>
              <div class="class-card class-card-public" style="border-left-color: <%= cls.color %>; background: color-mix(in srgb, <%= cls.color %> 12%, white);">
                <h3><%= cls.class_name %></h3>
                <p class="class-card-meta">
                  <% if (cls.room) { %><span>Room <%= cls.room %></span><% } %>
                  <% if (cls.age_group) { %><span><%= cls.age_group %></span><% } %>
                  <span><%= cls.students.length %> student<%= cls.students.length === 1 ? '' : 's' %></span>
                </p>
                <% if (cls.students.length > 0) { %>
                  <p class="class-card-staff">
                    <span class="class-card-pill-label">Students:</span>
                    <% cls.students.forEach(function(s) { %>
                      <span class="badge-pill<%= absentIds.has(s.id) ? ' badge-pill-absent' : '' %>"><%= s.name %></span>
                    <% }); %>
                  </p>
                <% } %>
                <p class="class-card-staff">
                  <span class="class-card-pill-label">Staff:</span>
                  <% if (cls.staff.length === 0) { %>
                    <span class="hint">No teachers/assistants yet.</span>
                  <% } else { %>
                    <% cls.staff.forEach(function(s) { %>
                      <span class="badge-pill"><%= s.name %><%= s.role === 'assistant' ? ' (Assistant)' : '' %></span>
                    <% }); %>
                  <% } %>
                </p>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    <% }); %>
  </div>
  <script src="/js/idle-redirect.js"></script>
  <script src="/js/fullscreen-nav.js"></script>
</body>
</html>
