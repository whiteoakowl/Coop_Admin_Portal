<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="roster-toolbar no-print">
      <h1>Volunteer Hours</h1>
    </div>

    <%# A real request: "All one row filter button, icons, add hours
        button. Shrink to fit mobile." One single roster-btn-row-fit-
        text row, Filter first, then icons, then Add Hours, same order
        every other Family School Management toolbar now follows. The
        Filter <details> carries data-filter-details so public/js/
        filter-details-dismiss.js (loaded below) actually closes it on
        an outside click - a real bug report: "when you select filter no
        matter what you do the filter stays open." %>
    <% if (familyStudents.length > 0) { %>
      <div class="roster-btn-row roster-btn-row-fit-text fs-toolbar-row-spaced no-print">
        <details class="filter-details" data-filter-details>
          <summary class="roster-action-btn">Filter</summary>
          <form method="GET" action="/parent/family-school/volunteer-hours" class="filter-panel">
            <label for="volunteer-hours-student-select">Student</label>
            <select id="volunteer-hours-student-select" name="studentId" onchange="this.form.submit()">
              <% familyStudents.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= selectedStudentId === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }); %>
            </select>
            <%# A real request: "Filter buttons should have student
                dropdown choice and school year choice." %>
            <label for="volunteer-hours-school-year-select">School Year</label>
            <select id="volunteer-hours-school-year-select" name="schoolYear" onchange="this.form.submit()">
              <option value="all" <%= schoolYearFilter === 'all' ? 'selected' : '' %>>All Years</option>
              <% volunteerHoursSchoolYearOptions.forEach(function(y) { %>
                <option value="<%= y %>" <%= schoolYearFilter === y ? 'selected' : '' %>><%= y %></option>
              <% }); %>
            </select>
          </form>
        </details>
        <a class="icon-btn" href="/parent/family-school/volunteer-hours/export.csv?studentId=<%= selectedStudentId %>&schoolYear=<%= schoolYearFilter %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <a class="icon-btn" href="/parent/family-school/volunteer-hours/print?studentId=<%= selectedStudentId %>&schoolYear=<%= schoolYearFilter %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
        <a class="icon-btn" href="/parent/family-school/volunteer-hours/download.pdf?schoolYear=<%= schoolYearFilter %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-volunteer-hours-dialog').showModal()">+ Add Hours</button>
      </div>
    <% } %>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (familyStudents.length === 0) { %>
      <p class="roster-empty">No students in your family yet.</p>
    <% } else { %>
      <%# "Then a log below showing all entries." Newest first
          (volunteerHoursForStudent's own ORDER BY). %>
      <div class="roster-scroll">
        <table class="roster-table condensed-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Hours</th>
              <th>Activity</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (entries.length === 0) { %>
              <tr><td colspan="4"><p class="roster-empty">No volunteer hours logged yet.</p></td></tr>
            <% } else { %>
              <% entries.forEach(function(e) { %>
                <tr>
                  <td><%= e.hour_date %></td>
                  <td><%= e.hours %></td>
                  <td><%= e.activity_description || '—' %></td>
                  <td>
                    <form method="POST" action="/parent/family-school/volunteer-hours/<%= e.id %>/delete" onsubmit="return confirm('Remove this entry?');" class="inline-block-form">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete entry" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
      <%# A real request: "Volunteer hours total should be at the
          bottom right of the table" - same right-aligned totals-row
          convention Accounting's own tables already use. %>
      <p class="accounting-section-total">Total Hours: <%= totalHours %></p>

      <dialog id="add-volunteer-hours-dialog" class="class-form-dialog">
        <form method="POST" action="/parent/family-school/volunteer-hours" class="stack-form">
          <div class="class-form-dialog-header">
            <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-check-circle"/></svg></span>
            <h3>Add Volunteer Hours</h3>
          </div>
          <input type="hidden" name="studentId" value="<%= selectedStudentId %>" />
          <label>Date
            <input type="date" name="hourDate" value="<%= new Date().toISOString().slice(0, 10) %>" required />
          </label>
          <label>Hours
            <input type="number" name="hours" step="0.25" min="0.25" required />
          </label>
          <label>Activity
            <textarea name="activityDescription" rows="2" placeholder="What did they volunteer for?"></textarea>
          </label>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Save</button>
          </div>
        </form>
      </dialog>
    <% } %>
  </main>
  <script src="/js/filter-details-dismiss.js"></script>
</body>
</html>
