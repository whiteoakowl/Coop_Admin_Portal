<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
    </a>
    <div class="site-header-actions">
      <a class="btn-secondary" href="/directory">All Listings</a>
      <a class="primary-btn" href="/portal">My Portals</a>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="site-section">
      <div class="site-section-inner">
        <div class="grid-box-header">
          <h1>My Directory Listings</h1>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('new-listing-dialog').showModal()">+ Submit a Listing</button>
        </div>

        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

        <% if (listings.length === 0) { %>
          <p class="roster-empty">You haven't submitted any listings yet.</p>
        <% } %>

        <div class="training-lesson-list">
          <% listings.forEach(function(l) { %>
            <div class="training-lesson-row">
              <div class="training-lesson-row-main">
                <svg class="icon"><use href="#icon-map-pin"/></svg>
                <div class="training-lesson-info">
                  <strong><%= l.business_name %></strong>
                  <span class="badge-pill badge-pill-<%= l.status === 'active' ? 'green' : l.status === 'archived' ? 'gray' : 'orange' %>"><%= l.status.charAt(0).toUpperCase() + l.status.slice(1) %></span>
                  <% if (l.status === 'pending') { %><span class="hint">Awaiting admin review</span><% } %>
                </div>
                <div class="training-lesson-actions roster-btn-row">
                  <button type="button" class="roster-action-btn" onclick="document.getElementById('edit-listing-dialog-<%= l.id %>').showModal()">Edit</button>
                  <% if (l.status !== 'archived') { %>
                    <form method="POST" action="/directory/<%= l.id %>/archive" class="inline-block-form">
                      <button type="submit" class="roster-action-btn roster-action-btn-danger">Withdraw</button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>

            <dialog id="edit-listing-dialog-<%= l.id %>" class="member-picker-dialog">
              <form method="POST" action="/directory/<%= l.id %>/update">
                <h3>Edit Listing</h3>
                <label>Business Name
                  <input type="text" name="businessName" value="<%= l.business_name %>" required />
                </label>
                <label>Description
                  <textarea name="description" rows="3"><%= l.description || '' %></textarea>
                </label>
                <%# Categories are admin-managed only (Main Admin >
                    Business Directory > Directory tab's own +Add Category
                    popup) - a select, not free text. %>
                <label>Category
                  <select name="categoryId">
                    <option value="">Uncategorized</option>
                    <% categories.forEach(function(c) { %>
                      <option value="<%= c.id %>" <%= l.category_id === c.id ? 'selected' : '' %>><%= c.title %></option>
                    <% }); %>
                  </select>
                </label>
                <label>Phone
                  <input type="text" name="phone" value="<%= l.phone || '' %>" />
                </label>
                <label>Email
                  <input type="email" name="email" value="<%= l.email || '' %>" />
                </label>
                <label>Website
                  <input type="text" name="website" value="<%= l.website || '' %>" />
                </label>
                <label>Address
                  <input type="text" name="address" value="<%= l.address || '' %>" />
                </label>
                <label>Visibility
                  <select name="visibility">
                    <option value="members" <%= l.visibility === 'members' ? 'selected' : '' %>>Members only</option>
                    <option value="public" <%= l.visibility === 'public' ? 'selected' : '' %>>Public</option>
                  </select>
                </label>
                <div class="notes-dialog-actions">
                  <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
                  <button type="submit" class="primary-btn">Save</button>
                </div>
              </form>
            </dialog>
          <% }); %>
        </div>
      </div>
    </section>

    <dialog id="new-listing-dialog" class="member-picker-dialog">
      <form method="POST" action="/directory">
        <h3>Submit a Listing</h3>
        <label>Which family member owns this business?
          <select name="memberId" required>
            <% family.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
          </select>
        </label>
        <label>Business Name
          <input type="text" name="businessName" required />
        </label>
        <label>Description
          <textarea name="description" rows="3"></textarea>
        </label>
        <label>Category
          <select name="categoryId">
            <option value="">Uncategorized</option>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.title %></option>
            <% }); %>
          </select>
        </label>
        <label>Phone
          <input type="text" name="phone" />
        </label>
        <label>Email
          <input type="email" name="email" />
        </label>
        <label>Website
          <input type="text" name="website" />
        </label>
        <label>Address
          <input type="text" name="address" />
        </label>
        <label>Visibility
          <select name="visibility">
            <option value="members">Members only</option>
            <option value="public">Public</option>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Submit for Review</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
