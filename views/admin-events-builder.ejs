<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= event.title %></h1>
      <span class="badge-pill badge-pill-<%= event.status === 'published' ? 'green' : event.status === 'cancelled' ? 'gray' : 'orange' %>"><%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %></span>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (event.approval_status === 'pending') { %>
      <div class="alert alert-error">
        This event was submitted by a member and is awaiting approval.
        <a href="/main-admin/events?tab=requests">Review it on the Requests tab &rarr;</a>
      </div>
    <% } %>

    <div class="roster-toolbar">
      <div class="roster-btn-row roster-btn-row-fit-text">
        <a class="roster-action-btn" href="/main-admin/events">&larr; All Events</a>
        <a class="roster-action-btn" href="/main-admin/events/<%= event.id %>/registrations">Registrations (<%= event.registrationCount %><% if (event.waitlistCount) { %> + <%= event.waitlistCount %> waitlisted<% } %>)</a>
        <% if (event.status !== 'published') { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="published" />
            <button type="submit" class="roster-action-btn">Publish</button>
          </form>
        <% } %>
        <% if (event.status !== 'cancelled') { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="cancelled" />
            <button type="submit" class="roster-action-btn roster-action-btn-danger">Cancel Event</button>
          </form>
        <% } else { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="draft" />
            <button type="submit" class="roster-action-btn">Move to Draft</button>
          </form>
        <% } %>
        <% if (event.status === 'draft') { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= event.title %>&quot;? This cannot be undone.">
            <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
          </form>
        <% } %>
      </div>
    </div>

    <%
    // A real request: "once the event is created when you click to edit
    // the event it show the following tabs at the top, event details,
    // volunteers, donations, food, settings. permissions will show up
    // again under settings tab on individual event editing." Same
    // `.view-tabs`/`?tab=` pattern the Events list page's own tab strip
    // now uses.
    var builderTabDefs = [
      { key: 'details', label: 'Event Details' },
      { key: 'volunteers', label: 'Volunteers' },
      { key: 'donations', label: 'Donations' },
      { key: 'food', label: 'Food' },
      { key: 'settings', label: 'Settings' },
    ];
    %>
    <div class="view-tabs">
      <% builderTabDefs.forEach(function(t) { %>
        <a href="/main-admin/events/<%= event.id %>/builder?tab=<%= t.key %>" class="view-tab <%= activeTab === t.key ? 'active' : '' %>"><%= t.label %></a>
      <% }); %>
    </div>

    <% if (activeTab === 'details') { %>
      <div class="manage-section">
        <form method="POST" action="/main-admin/events/<%= event.id %>" enctype="multipart/form-data" class="member-form-grid">
          <label class="member-form-full">Title
            <input type="text" name="title" value="<%= event.title %>" required />
          </label>
          <label>Event Slug
            <input type="text" name="slug" value="<%= event.slug || '' %>" placeholder="your-event-slug" />
          </label>
          <label>Event Type
            <select name="eventType">
              <option value="">Select event type</option>
              <% eventTypes.forEach(function(t) { %>
                <option value="<%= t %>" <%= event.event_type === t ? 'selected' : '' %>><%= t %></option>
              <% }); %>
            </select>
          </label>
          <label class="member-form-full">Short Description <span class="hint">(50-150 characters, shown wherever the event is listed)</span>
            <textarea name="shortDescription" rows="2" maxlength="150"><%= event.short_description || '' %></textarea>
          </label>
          <div class="member-form-full" data-forum-editor>
            <label>Description</label>
            <%- include('partials/forum-editor-toolbar') %>
            <div class="forum-editable" data-forum-editable contenteditable="true"><%- event.description || '' %></div>
            <input type="hidden" name="description" data-forum-body-input />
          </div>
          <label>Category (legacy text - prefer the dropdown below)
            <input type="text" name="category" value="<%= event.category || '' %>" placeholder="e.g. Social, Fundraiser" />
          </label>
          <label>Category
            <select name="categoryId">
              <option value="">None</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= event.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Location (legacy text - prefer the dropdown below)
            <input type="text" name="location" value="<%= event.location || '' %>" />
          </label>
          <label>Location
            <select name="locationId">
              <option value="">None</option>
              <% locations.forEach(function(l) { %>
                <option value="<%= l.id %>" <%= event.location_id === l.id ? 'selected' : '' %>><%= l.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Starts
            <input type="datetime-local" name="startsAt" value="<%= event.starts_at ? event.starts_at.replace(' ', 'T').slice(0, 16) : '' %>" required />
          </label>
          <label>Ends
            <input type="datetime-local" name="endsAt" value="<%= event.ends_at ? event.ends_at.replace(' ', 'T').slice(0, 16) : '' %>" />
          </label>
          <label>Registration Opens
            <input type="datetime-local" name="registrationOpensAt" value="<%= event.registration_opens_at ? event.registration_opens_at.replace(' ', 'T').slice(0, 16) : '' %>" />
          </label>
          <label>Registration Closes
            <input type="datetime-local" name="registrationClosesAt" value="<%= event.registration_closes_at ? event.registration_closes_at.replace(' ', 'T').slice(0, 16) : '' %>" />
          </label>
          <label>Visibility
            <select name="visibility">
              <option value="members" <%= event.visibility === 'members' ? 'selected' : '' %>>Members only</option>
              <option value="public" <%= event.visibility === 'public' ? 'selected' : '' %>>Public</option>
            </select>
          </label>
          <%
          // A real request: "capacity totals dropdown choosing family or
          // person capacity" - one number plus a type picker instead of
          // two separate numeric fields (routes/admin-events.js's own
          // capacityFieldsFromBody maps this back onto whichever of
          // capacity/family_capacity the type actually means).
          %>
          <label>Capacity <span class="hint">(blank = no limit)</span>
            <input type="number" name="capacityValue" min="1" value="<%= event.family_capacity ?? event.capacity ?? '' %>" placeholder="No limit" />
          </label>
          <label>Capacity Counted By
            <select name="capacityType">
              <option value="person" <%= event.family_capacity == null ? 'selected' : '' %>>Person</option>
              <option value="family" <%= event.family_capacity != null ? 'selected' : '' %>>Family</option>
            </select>
          </label>
          <label>Organized By
            <input type="text" name="organizedBy" value="<%= event.organized_by || '' %>" placeholder="e.g., Sanford Homeschoolers" />
          </label>
          <label>Price ($) <span class="hint">(blank = free)</span>
            <input type="number" name="priceDollars" min="0" step="0.01" value="<%= event.price_cents != null ? (event.price_cents / 100).toFixed(2) : '' %>" />
          </label>
          <label>Charged per
            <select name="pricePer">
              <option value="person" <%= event.price_per !== 'family' ? 'selected' : '' %>>Person</option>
              <option value="family" <%= event.price_per === 'family' ? 'selected' : '' %>>Family</option>
            </select>
          </label>
          <div class="member-form-full">
            <span class="roster-checkbox-label">Tags <span class="hint">(helps people find your event)</span></span>
            <div data-tag-input="tags" class="tag-input-wrap">
              <% selectedTags.forEach(function(t) { %>
                <span class="tag-input-chip-initial" data-initial-tag="<%= t %>"></span>
              <% }); %>
              <input type="text" class="tag-input-field" placeholder="Add tags and press Enter" />
            </div>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">Event Image</span>
            <% if (imageUrl) { %>
              <img src="<%= imageUrl %>" alt="" style="max-width: 240px; border-radius: var(--radius); display: block; margin-bottom: 0.5rem;" />
            <% } %>
            <input type="file" name="image" accept="image/*" />
          </div>

          <div class="member-form-full">
            <button type="submit" class="primary-btn">Save Event Details</button>
          </div>
        </form>
      </div>
    <% } else if (activeTab === 'volunteers' || activeTab === 'donations' || activeTab === 'food') { %>
      <%
      // A real request: "on the volunteer, donations and food pages.
      // there will be a check box for, do you want to include this
      // section? then a dropdown menu of numbers 1-50 that ask, how many
      // volunteer/donation/food items should each family/individual
      // registration select in order to sign up for this event?" Same
      // shape for all three sections, so one shared block renders
      // whichever one is active instead of writing this out 3 times.
      var sectionInfo = {
        volunteers: { enabled: !!event.volunteers_enabled, count: event.volunteer_selection_count, items: event.volunteerRoles, noun: 'volunteer' },
        donations: { enabled: !!event.donations_enabled, count: event.donation_selection_count, items: event.donationItems, noun: 'donation' },
        food: { enabled: !!event.food_enabled, count: event.food_selection_count, items: event.foodItems, noun: 'food' },
      }[activeTab];
      %>
      <div class="manage-section">
        <form method="POST" action="/main-admin/events/<%= event.id %>/<%= activeTab %>-settings" class="member-form-grid">
          <label class="checkbox-option member-form-full">
            <input type="checkbox" name="enabled" value="1" <%= sectionInfo.enabled ? 'checked' : '' %> />
            Do you want to include this section?
          </label>
          <label>How many <%= sectionInfo.noun %> items should each family/individual registration select in order to sign up for this event?
            <select name="selectionCount">
              <option value="">No minimum</option>
              <% for (let n = 1; n <= 50; n++) { %>
                <option value="<%= n %>" <%= sectionInfo.count === n ? 'selected' : '' %>><%= n %></option>
              <% } %>
            </select>
          </label>
          <div class="member-form-full">
            <button type="submit" class="primary-btn">Save</button>
          </div>
        </form>
      </div>

      <% if (activeTab === 'volunteers') { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Volunteer Roles (<%= event.volunteerRoles.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-role-dialog').showModal()">+ Add Role</button>
          </div>

          <% if (event.volunteerRoles.length === 0) { %>
            <p class="roster-empty">No volunteer roles yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.volunteerRoles.forEach(function(role) { %>
              <div class="training-lesson-row">
                <div class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-users"/></svg>
                  <div class="training-lesson-info">
                    <strong><%= role.role_name %></strong>
                    <span class="hint">
                      <%= role.filled %>/<%= role.slots_needed %> filled
                      <% if (role.time_label) { %> &middot; <%= role.time_label %><% } %>
                      <% if (role.location) { %> &middot; <%= role.location %><% } %>
                    </span>
                    <% if (role.signups.length) { %>
                      <span class="hint"><%= role.signups.map(function(s) { return s.memberName; }).join(', ') %></span>
                    <% } %>
                  </div>
                  <div class="training-lesson-actions">
                    <form method="POST" action="/main-admin/events/<%= event.id %>/volunteer-roles/<%= role.id %>/delete" class="inline-block-form" data-confirm="Remove volunteer role &quot;<%= role.role_name %>&quot;?">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= role.role_name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } else if (activeTab === 'donations') { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Donation Items (<%= event.donationItems.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-item-dialog').showModal()">+ Add Item</button>
          </div>

          <% if (event.donationItems.length === 0) { %>
            <p class="roster-empty">No donation items yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.donationItems.forEach(function(item) { %>
              <div class="training-lesson-row">
                <div class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <div class="training-lesson-info">
                    <strong><%= item.item_name %></strong>
                    <span class="hint">
                      <%= item.quantityClaimed %>/<%= item.quantity_needed %> claimed
                      <% if (item.deadline) { %> &middot; needed by <%= item.deadline %><% } %>
                    </span>
                    <% if (item.claims.length) { %>
                      <span class="hint"><%= item.claims.map(function(c) { return c.memberName + ' (' + c.quantity_claimed + ')'; }).join(', ') %></span>
                    <% } %>
                  </div>
                  <div class="training-lesson-actions">
                    <form method="POST" action="/main-admin/events/<%= event.id %>/donation-items/<%= item.id %>/delete" class="inline-block-form" data-confirm="Remove donation item &quot;<%= item.item_name %>&quot;?">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= item.item_name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } else { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Food Items (<%= event.foodItems.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-food-item-dialog').showModal()">+ Add Item</button>
          </div>

          <% if (event.foodItems.length === 0) { %>
            <p class="roster-empty">No food items yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.foodItems.forEach(function(item) { %>
              <div class="training-lesson-row">
                <div class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <div class="training-lesson-info">
                    <strong><%= item.item_name %></strong>
                    <span class="hint">
                      <%= item.quantityClaimed %>/<%= item.quantity_needed %> claimed
                      <% if (item.deadline) { %> &middot; needed by <%= item.deadline %><% } %>
                    </span>
                    <% if (item.claims.length) { %>
                      <span class="hint"><%= item.claims.map(function(c) { return c.memberName + ' (' + c.quantity_claimed + ')'; }).join(', ') %></span>
                    <% } %>
                  </div>
                  <div class="training-lesson-actions">
                    <form method="POST" action="/main-admin/events/<%= event.id %>/food-items/<%= item.id %>/delete" class="inline-block-form" data-confirm="Remove food item &quot;<%= item.item_name %>&quot;?">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= item.item_name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <%
      // Settings tab - a real request: "permissions will show up again
      // under settings tab on individual event editing."
      %>
      <div class="manage-section">
        <form method="POST" action="/main-admin/events/<%= event.id %>/permissions" class="member-form-grid">
          <div class="member-form-full">
            <span class="roster-checkbox-label">Grades <span class="hint">(leave all unchecked to allow every grade)</span></span>
            <div class="grade-pill-grid">
              <% gradeOptions.forEach(function(g) { %>
                <label class="grade-pill"><input type="checkbox" name="ageGroup" value="<%= g %>" <%= selectedGrades.includes(g) ? 'checked' : '' %> /> <%= g %></label>
              <% }); %>
            </div>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">Who Can Register</span>
            <div class="class-form-row">
              <div class="class-form-field">
                <input type="hidden" name="allowAdultRegister" value="off" />
                <label class="grade-pill"><input type="checkbox" name="allowAdultRegister" value="1" <%= event.allow_adult_register ? 'checked' : '' %> /> Parents/adults can register</label>
              </div>
              <div class="class-form-field">
                <input type="hidden" name="allowChildRegister" value="off" />
                <label class="grade-pill"><input type="checkbox" name="allowChildRegister" value="1" <%= event.allow_child_register ? 'checked' : '' %> /> Kids can register</label>
              </div>
              <div class="class-form-field">
                <label class="grade-pill"><input type="checkbox" name="allowGuestRegister" value="1" <%= event.allow_guest_register ? 'checked' : '' %> /> Guests can register</label>
              </div>
            </div>
          </div>

          <% if (sections.length) { %>
            <div class="member-form-full">
              <span class="roster-checkbox-label">Sections <span class="hint">(leave all unchecked to allow every section - restricts BOTH viewing and registering)</span></span>
              <div class="grade-pill-grid">
                <% sections.forEach(function(s) { %>
                  <label class="grade-pill"><input type="checkbox" name="sectionIds" value="<%= s.id %>" <%= event.sectionIds.includes(s.id) ? 'checked' : '' %> /> <%= s.name %></label>
                <% }); %>
              </div>
            </div>
          <% } %>

          <div class="member-form-full">
            <button type="submit" class="primary-btn">Save Settings</button>
          </div>
        </form>
      </div>
    <% } %>

    <dialog id="add-role-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/volunteer-roles">
        <h3>Add Volunteer Role</h3>
        <label>Role Name
          <input type="text" name="roleName" placeholder="e.g. Setup Crew" required />
        </label>
        <label>Slots Needed
          <input type="number" name="slotsNeeded" min="1" value="1" required />
        </label>
        <label>Time
          <input type="text" name="timeLabel" placeholder="e.g. 8:00-9:00am" />
        </label>
        <label>Location
          <input type="text" name="location" />
        </label>
        <label>Description
          <textarea name="description" rows="2"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-item-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/donation-items">
        <h3>Add Donation Item</h3>
        <label>Item Name
          <input type="text" name="itemName" placeholder="e.g. 2-liter sodas" required />
        </label>
        <label>Quantity Needed
          <input type="number" name="quantityNeeded" min="1" value="1" required />
        </label>
        <label>Needed By
          <input type="date" name="deadline" />
        </label>
        <label>Notes
          <textarea name="notes" rows="2"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-food-item-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/food-items">
        <h3>Add Food Item</h3>
        <label>Item Name
          <input type="text" name="itemName" placeholder="e.g. Side dish for 8" required />
        </label>
        <label>Quantity Needed
          <input type="number" name="quantityNeeded" min="1" value="1" required />
        </label>
        <label>Needed By
          <input type="date" name="deadline" />
        </label>
        <label>Notes
          <textarea name="notes" rows="2"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/forum-editor.js"></script>
  <script src="/js/tag-input.js"></script>
</body>
</html>
