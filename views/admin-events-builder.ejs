<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%
    // A real request: "If a member is added as an organizer for an
    // event, on parent portal when they click on the event it will show
    // an edit event button... Members are not allowed to change anything
    // on the financial tab... Everything except Finance, including
    // Attendance" (confirmed scope). This same page now also renders for
    // an organizer-parent (routes/admin-events.js's own
    // requireMainAdminOrEventOrganizer sets req.isOrganizerView) -
    // organizers are always parent-type members (utils/members.js's own
    // activeParentOptionsWithEmail, the only picker that feeds event_
    // organizers), so their own nav shell is always Parent Portal.
    var organizerView = typeof isOrganizerView !== 'undefined' && isOrganizerView;
  %>
  <%- include('partials/portal-nav', {
    portalTitle: organizerView ? 'Parent Portal' : 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= event.title %></h1>
      <span class="badge-pill badge-pill-<%= event.status === 'published' ? 'green' : event.status === 'cancelled' ? 'gray' : 'orange' %>"><%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %></span>
    </div>
    <%# A real request: "back to all events button should just be a link
        click in a row above the buttons like other pages" - same
        <p><a>&larr; ...</a></p> convention every other single-record edit
        page in this app already uses (see e.g. admin-accounting-member.ejs's
        own "All Accounting" link), instead of a roster-action-btn sharing
        the toolbar row below. An organizer-parent has no Main Admin
        Events list to go back to - back to the event's own public page
        instead. %>
    <% if (organizerView) { %>
      <p><a href="/events/<%= event.id %>?portal=parent">&larr; Back to Event</a></p>
    <% } else { %>
      <p><a href="/main-admin/events">&larr; All Events</a></p>
    <% } %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (!organizerView && event.approval_status === 'pending') { %>
      <div class="alert alert-error">
        This event was submitted by a member and is awaiting approval.
        <a href="/main-admin/events?tab=requests">Review it on the Requests tab &rarr;</a>
      </div>
    <% } %>

    <%# An organizer-parent only ever gets Copy Event Link here - Publish/
        Cancel/Move to Draft/Delete stay Main-Admin-only (confirmed
        scope: "No - Copy Link only"). %>
    <div class="roster-toolbar">
      <%# A real request: "get rid of registrations button, it's all under
          attendance tab" - the Attendance link in the tab strip below
          (same /main-admin/events/:id/registrations URL) already covers
          this; the old "Registrations (N + M waitlisted)" button here just
          duplicated it. Copy Link renamed "Copy Event Link" (a real
          request), and now shares this one row with Cancel Event/Delete
          Event with nothing else crowding it out. %>
      <div class="roster-btn-row roster-btn-row-fit-text">
        <button type="button" class="roster-action-btn" data-copy-link="<%= eventLink %>">Copy Event Link</button>
        <% if (!organizerView) { %>
        <% if (event.status !== 'published') { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="published" />
            <button type="submit" class="roster-action-btn">Publish</button>
          </form>
        <% } %>
        <% if (event.status !== 'cancelled') { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="cancelled" />
            <button type="submit" class="roster-action-btn roster-action-btn-danger">Cancel Event</button>
          </form>
        <% } else { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="draft" />
            <button type="submit" class="roster-action-btn">Move to Draft</button>
          </form>
        <% } %>
        <form method="POST" action="/main-admin/events/<%= event.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= event.title %>&quot;? This cannot be undone.">
          <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete Event</button>
        </form>
        <% } %>
      </div>
    </div>

    <%
    // A real request: "once the event is created when you click to edit
    // the event it show the following tabs at the top, event details,
    // volunteers, donations, food, settings. permissions will show up
    // again under settings tab on individual event editing." Same
    // `.view-tabs`/`?tab=` pattern the Events list page's own tab strip
    // now uses. A later real request: "editing event should have little
    // tabs at the top. details, finance, settings, attendance" - Details
    // (renamed from "Event Details") and a new Finance tab (Price/Charged
    // Per, split out of Details) join Volunteers/Settings rather than
    // replacing them; Attendance is its own link at the end, straight to
    // the existing Registrations page (views/admin-events-registrations.
    // ejs already has the full check-in/checkout view this asked for)
    // rather than a duplicate of that page rebuilt as a tab. A still
    // later real request folded Donations/Food/Extra Fields into
    // Volunteers as a pill toggle (see activeSection below) instead of
    // each keeping its own top-level tab.
    var builderTabDefs = [
      { key: 'details', label: 'Details' },
      { key: 'finance', label: 'Finance' },
      { key: 'volunteers', label: 'Resources/Fields' },
      { key: 'settings', label: 'Settings' },
    ];
    %>
    <%# One specific event's own builder tabs - no top-level nav entry to
        attach a popup to (reached by clicking into an event, not from the
        nav), so this stays the plain connected file-tab strip every other
        tabbed page used before the orange-bar popup existed, instead of a
        popup with nothing to open it from. data-builder-nav-link is
        public/js/event-builder-tab-guard.js's own hook - "warning pop up
        when clicking to each page/tab that you must save your changes on
        that page before going to the next" for any of this page's own
        forms with an unsaved edit. %>
    <div class="view-tabs no-print">
      <% builderTabDefs.forEach(function(t) { %>
        <a href="/main-admin/events/<%= event.id %>/builder?tab=<%= t.key %>" class="view-tab <%= activeTab === t.key ? 'active' : '' %>" data-builder-nav-link><%= t.label %></a>
      <% }); %>
      <a href="/main-admin/events/<%= event.id %>/registrations" class="view-tab" data-builder-nav-link>Attendance</a>
    </div>

    <dialog id="tab-unsaved-dialog" class="notes-dialog">
      <h3>Unsaved Changes</h3>
      <p>You must save your changes on this page before going to the next. Continue anyway and lose your changes, or cancel and stay here?</p>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
        <button type="button" class="primary-btn" data-tab-guard-continue>Continue</button>
      </div>
    </dialog>

    <% if (activeTab === 'details') { %>
      <div class="manage-section">
        <form method="POST" action="/main-admin/events/<%= event.id %>" class="member-form-grid" id="details-form">
          <label class="member-form-full">Title
            <input type="text" name="title" value="<%= event.title %>" required />
          </label>
          <label>Event Slug
            <input type="text" name="slug" value="<%= event.slug || '' %>" placeholder="your-event-slug" />
          </label>
          <label>Event Type
            <select name="eventType">
              <option value="">Select event type</option>
              <% eventTypes.forEach(function(t) { %>
                <option value="<%= t %>" <%= event.event_type === t ? 'selected' : '' %>><%= t %></option>
              <% }); %>
            </select>
          </label>
          <label class="member-form-full">Short Description <span class="hint">(50-150 characters, shown wherever the event is listed)</span>
            <textarea name="shortDescription" rows="2" maxlength="150"><%= event.short_description || '' %></textarea>
          </label>
          <label>Category
            <select name="categoryId">
              <option value="">None</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= event.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Location Details
            <input type="text" name="location" value="<%= event.location || '' %>" />
          </label>
          <label>Location
            <select name="locationId">
              <option value="">None</option>
              <% locations.forEach(function(l) { %>
                <option value="<%= l.id %>" <%= event.location_id === l.id ? 'selected' : '' %>><%= l.name %></option>
              <% }); %>
            </select>
          </label>
          <%
            // A real request: "date picker should be a calendar. Start and
            // end time should be separate drop down menus" - a plain
            // calendar date input plus a time-of-day <select> pair
            // (partials/date-range-picker.ejs), recombined into the same
            // startsAt/endsAt "YYYY-MM-DDTHH:MM" value this form has
            // always submitted (see public/js/event-date-time-picker.js)
            // so nothing server-side needs to change.
            var startsDate = event.starts_at ? event.starts_at.slice(0, 10) : '';
            var startsTime = event.starts_at ? event.starts_at.slice(11, 16) : '';
            var endsDate = event.ends_at ? event.ends_at.slice(0, 10) : '';
            var endsTime = event.ends_at ? event.ends_at.slice(11, 16) : '';
          %>
          <%- include('partials/date-range-picker', {
            startGroup: 'starts', endGroup: 'ends',
            startDateLabel: 'Start Date', endDateLabel: 'End Date',
            startTimeLabel: 'Start Time', endTimeLabel: 'End Time',
            startDate: startsDate, startTime: startsTime, endDate: endsDate, endTime: endsTime,
            startFieldName: 'startsAt', endFieldName: 'endsAt',
            startRequired: true,
          }) %>
          <%
            // A real request: "Organized by should be a drop down to
            // choose Sanford Homeschoolers or a parent name. Can select
            // multiple. Will show on parent portal who Organized the
            // event and their email address." Same multi-select-checkbox
            // control the Grade/Age pickers already use (a real request
            // of its own) - see utils/events.js's own organizersForEvent/
            // setEventOrganizers for how these values round-trip.
            var organizerOptions = [{ value: 'org', label: 'Sanford Homeschoolers' }].concat(
              parentOrganizerOptions.map(function(p) { return { value: 'member:' + p.id, label: p.name }; })
            );
          %>
          <div class="member-form-full">
            <span class="roster-checkbox-label">Organized By</span>
            <%- include('partials/multi-select-checkbox', {
              name: 'organizers',
              options: organizerOptions,
              selected: selectedOrganizers,
              placeholder: 'Select organizer(s)…',
            }) %>
          </div>
          <div class="member-form-full">
            <span class="roster-checkbox-label">Tags <span class="hint">(helps people find your event)</span></span>
            <div data-tag-input="tags" class="tag-input-wrap">
              <% selectedTags.forEach(function(t) { %>
                <span class="tag-input-chip-initial" data-initial-tag="<%= t %>"></span>
              <% }); %>
              <input type="text" class="tag-input-field" placeholder="Add tags and press Enter" />
            </div>
          </div>
          <div class="member-form-full" data-forum-editor>
            <label>Description</label>
            <%- include('partials/forum-editor-toolbar') %>
            <div class="forum-editable" data-forum-editable contenteditable="true"><%- event.description || '' %></div>
            <input type="hidden" name="description" data-forum-body-input />
          </div>

          <%
            // A real request: "event editing under details add another
            // text box that says activity information, another text box
            // below that saying meetup and parking information, another
            // text box under that saying what to bring. Under that a text
            // box that says extra notes. Next to each of these title is a
            // check box and question that says include this section? If
            // the box is checked then the information filled out and the
            // section will appear on the event for members to see."
            var infoSections = [
              { key: 'activityInfo', label: 'Activity Information', text: event.activity_info, included: event.include_activity_info },
              { key: 'meetupParkingInfo', label: 'Meetup and Parking Information', text: event.meetup_parking_info, included: event.include_meetup_parking_info },
              { key: 'whatToBring', label: 'What to Bring', text: event.what_to_bring, included: event.include_what_to_bring },
              { key: 'extraNotes', label: 'Extra Notes', text: event.extra_notes, included: event.include_extra_notes },
            ];
          %>
          <% infoSections.forEach(function(section) { %>
            <div class="member-form-full">
              <label class="checkbox-option event-info-section-checkbox">
                <input type="checkbox" name="include<%= section.key.charAt(0).toUpperCase() + section.key.slice(1) %>" value="1" <%= section.included ? 'checked' : '' %> />
                <span><%= section.label %> <span class="hint">&mdash; Include this section?</span></span>
              </label>
              <textarea name="<%= section.key %>" rows="3"><%= section.text || '' %></textarea>
            </div>
          <% }); %>

        </form>

        <%# A real request: "when you upload a photo for an individual
            event it automatically shows the photo so we don't need the
            upload button, just choose file." The separate Upload button
            is gone - public/js/event-image-preview.js now submits this
            form itself the moment a file is chosen, straight to the
            dedicated POST /:id/image route (still a separate form from
            Details above - an HTML form can't nest inside another), the
            same real upload/redirect round trip a manual Upload click
            used to trigger. This also fixes the real bug that request
            named: "when you click save the photo disappears" - clicking
            the file input's own instant local-object-URL preview looked
            like the photo was already saved, but nothing had actually
            been posted to the server yet; clicking Save Event Details
            only ever submitted the Details form, never this one, so the
            image was never persisted and vanished on the next page load.
            Auto-submitting removes that whole gap - there's no longer a
            "chosen but not yet uploaded" state to get stuck in. %>
        <div class="member-form-full">
          <span class="roster-checkbox-label">Event Image</span>
          <img src="<%= imageUrl || '' %>" alt="" data-event-image-preview style="max-width: 240px; border-radius: var(--radius); display: <%= imageUrl ? 'block' : 'none' %>; margin-bottom: 0.5rem;" />
          <form method="POST" action="/main-admin/events/<%= event.id %>/image" enctype="multipart/form-data" class="roster-btn-row">
            <input type="file" name="image" accept="image/*" required data-event-image-input />
          </form>
        </div>

        <%# A real request: "save event details button should be the very
            last button on the page and dark blue, like we used on other
            pages." Linked to the Details form above via form="details-
            form" (an HTML form can't nest inside another - see the Image
            form's own comment above - so this can't be a normal
            descendant of that form and still sit after the Image
            section), the same standard way a submit button can live
            outside its own <form> tag; public/js/event-builder-tab-
            guard.js's own dirty-tracking listens on the <form> element
            itself, not this button, so it isn't affected by the button
            no longer being a DOM descendant. %>
        <div class="member-form-full">
          <button type="submit" form="details-form" class="primary-btn primary-btn-dark">Save Event Details</button>
        </div>
      </div>
    <% } else if (activeTab === 'finance') { %>
      <%# A real request: "editing event should have little tabs at the
          top. details, finance, settings, attendance" - Price/Charged Per
          split out of Event Details into their own tab. A later real
          request: "accounting category drop is all that is now needed
          above ticket types" - the flat Price/Charged Per fields that
          used to sit here are gone; each Ticket Type below now carries
          its own price and person/family basis instead. %>
      <%
        // A real request: "Members are not allowed to change anything on
        // the financial tab. They can click on the tab but everything
        // will be frozen and not clickable." An organizer-parent still
        // sees this whole tab (so they can check pricing/payment info)
        // but every field/button in it is disabled - a disabled <button
        // onclick="..."> never fires its handler, so the Add Ticket
        // Type dialog and every delete icon are frozen the same way.
        var financeDisabled = organizerView ? 'disabled' : '';
      %>
      <div class="manage-section">
        <form method="POST" action="/main-admin/events/<%= event.id %>/finance" class="member-form-grid">
          <%# A real request: "add a drop down menu for choosing
              accounting category" - the list itself is managed from the
              Events list page's own Settings tab (Add/Edit Accounting
              Category), same place/pattern as Categories/Locations. %>
          <label>Accounting Category
            <select name="accountingCategoryId" <%= financeDisabled %>>
              <option value="">None</option>
              <% accountingCategories.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= event.accounting_category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </label>
          <%# A real request: "Price, charged per person, and payment title
              are not needed. All pricing will happen with adding ticket
              pricing, even if it is only one ticket." Reverses an earlier
              fix that restored these two fields (event.price_cents/
              price_per) after a bug report that they'd gone missing -
              confirmed here as deliberate: every event's pricing now goes
              through at least one Ticket Type below, even a single one,
              rather than a flat price on the event itself. The columns/
              charge-fallback logic in utils/events.js are left alone (an
              event with zero ticket types still has no way to collect a
              price - exactly the point), only the now-unwanted form
              fields are gone. %>
          <%# A real request: "adding a the title payment instructions
              with a text field below it. This will appear when members
              are choosing their tickets." Same title+free-text shape as
              the existing membership-application payment info - shown to
              a registrant on the event's own public page next to its
              Price/Ticket Types, not a real checkout. A later real
              request ("...and payment title [is not needed]") dropped
              just the Title half - the free-text field alone still shows
              on the public page with no heading above it. %>
          <label class="member-form-full">Payment Instructions
            <textarea name="paymentInstructionsText" rows="3" placeholder="e.g. Pay by cash, check, or Venmo @coopname at drop-off." <%= financeDisabled %>><%= event.payment_instructions_text || '' %></textarea>
          </label>
          <% if (!organizerView) { %>
          <div class="member-form-full">
            <button type="submit" class="primary-btn">Save Finance</button>
          </div>
          <% } %>
        </form>
      </div>

      <%# A real request: "add ticket types, price, title and permissions
          person or family." Admin-side only for now (a scoping question
          confirmed this) - registration doesn't yet let a registrant pick
          one and be charged accordingly. Same +Add/list/delete shape as
          Volunteer Roles/Donation Items/Food Items below. %>
      <div class="manage-section">
          <div class="grid-box-header">
            <h2>Ticket Types (<%= event.ticketTypes.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-ticket-type-dialog').showModal()" <%= financeDisabled %>>+ Add Ticket Type</button>
          </div>

          <% if (event.ticketTypes.length === 0) { %>
            <p class="roster-empty">No ticket types yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.ticketTypes.forEach(function(t) { %>
              <%# A real request: "add a ticket type the chart below that
                  shows tickets. All information should fit on one row in
                  mobile. Click on the ticket to edit and save, close or
                  delete. Remove trashcan from ticket list. You can only
                  delete in the edit popup window." The whole row is now a
                  plain button opening this ticket's own edit dialog below
                  - no per-row trash icon any more, and title/price/per/
                  physical-ticket are one single-line, truncating string
                  (.ticket-type-row-label, public/css/styles.css) instead
                  of the generic two-line .training-lesson-info stack, so
                  it never wraps to a second line even on a narrow phone. %>
              <button
                type="button"
                class="training-lesson-row ticket-type-row"
                onclick="document.getElementById('edit-ticket-type-dialog-<%= t.id %>').showModal()"
                <%= financeDisabled %>
              >
                <span class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <span class="ticket-type-row-label">
                    <strong><%= t.title %></strong> &middot; $<%= (t.price_cents / 100).toFixed(2) %>/<%= t.price_per %><% if (t.includes_physical_ticket) { %> &middot; Physical ticket<% } %>
                  </span>
                </span>
              </button>

              <dialog id="edit-ticket-type-dialog-<%= t.id %>" class="member-picker-dialog">
                <form method="POST" action="/main-admin/events/<%= event.id %>/ticket-types/<%= t.id %>/update">
                  <h3>Edit Ticket Type</h3>
                  <label>Title
                    <input type="text" name="title" value="<%= t.title %>" placeholder="e.g. Adult, Child, VIP" required />
                  </label>
                  <label>Price ($)
                    <input type="number" name="priceDollars" min="0" step="0.01" value="<%= (t.price_cents / 100).toFixed(2) %>" required />
                  </label>
                  <label>Charged per
                    <select name="pricePer">
                      <option value="person" <%= t.price_per === 'person' ? 'selected' : '' %>>Person</option>
                      <option value="family" <%= t.price_per === 'family' ? 'selected' : '' %>>Family</option>
                    </select>
                  </label>
                  <label class="checkbox-option">
                    <input type="checkbox" name="includesPhysicalTicket" value="1" <%= t.includes_physical_ticket ? 'checked' : '' %> />
                    Include physical ticket
                  </label>
                  <div class="notes-dialog-actions">
                    <button
                      type="button"
                      class="link-btn link-btn-danger"
                      onclick="window.confirmAction({ message: 'Remove this ticket type? This cannot be undone.', yesLabel: 'Yes, Delete' }).then(ok => { if (ok) { this.form.action = '/main-admin/events/<%= event.id %>/ticket-types/<%= t.id %>/delete'; this.form.submit(); } })"
                    >Delete Ticket Type</button>
                    <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                    <button type="submit" class="primary-btn">Save</button>
                  </div>
                </form>
              </dialog>
            <% }); %>
          </div>
        </div>
    <% } else if (activeTab === 'volunteers') { %>
      <%
      // A real request: "volunteers, food, donations and extra fields
      // tabs should be under one tab called, Volunteers. There will then
      // be a pill toggle on this page for volunteers, food, donations and
      // extra fields." Same `?section=` pattern as `?tab=`, just one
      // level down - pillSectionDefs drives both the toggle and which of
      // the four panels below actually renders. A later real request
      // ("the pill toggle... should be a drop down menu instead") swapped
      // the pill strip itself for a plain <select>, same
      // onchange="window.location = ..." pattern this app's other
      // filter dropdowns already use (e.g. parent-library.ejs's own type
      // filter) - navigating to a different ?section= is still just a
      // GET, so nothing about activeSection's own meaning below changed.
      var pillSectionDefs = [
        { key: 'volunteers', label: 'Volunteers' },
        { key: 'food', label: 'Food' },
        { key: 'donations', label: 'Donations' },
        { key: 'extraFields', label: 'Extra Fields' },
      ];
      %>
      <div class="category-filter no-print" style="margin-bottom: 1rem;">
        <label for="event-section-select">Section</label>
        <select id="event-section-select" onchange="window.location = '/main-admin/events/<%= event.id %>/builder?tab=volunteers&section=' + encodeURIComponent(this.value)">
          <% pillSectionDefs.forEach(function(s) { %>
            <option value="<%= s.key %>" <%= activeSection === s.key ? 'selected' : '' %>><%= s.label %></option>
          <% }); %>
        </select>
      </div>

      <% if (activeSection === 'volunteers' || activeSection === 'donations' || activeSection === 'food') { %>
        <%
        // A real request: "on the volunteer, donations and food pages.
        // there will be a check box for, do you want to include this
        // section? then a dropdown menu of numbers 1-50 that ask, how many
        // volunteer/donation/food items should each family/individual
        // registration select in order to sign up for this event?" Same
        // shape for all three sections, so one shared block renders
        // whichever one is active instead of writing this out 3 times.
        var sectionInfo = {
          volunteers: { enabled: !!event.volunteers_enabled, count: event.volunteer_selection_count, items: event.volunteerRoles, noun: 'volunteer', scope: event.volunteer_requirement_scope },
          donations: { enabled: !!event.donations_enabled, count: event.donation_selection_count, items: event.donationItems, noun: 'donation', scope: event.donation_requirement_scope },
          food: { enabled: !!event.food_enabled, count: event.food_selection_count, items: event.foodItems, noun: 'food', scope: event.food_requirement_scope },
        }[activeSection];
        %>
        <div class="manage-section">
          <form method="POST" action="/main-admin/events/<%= event.id %>/<%= activeSection %>-settings" class="member-form-grid">
            <%# A real request: "do you want to include this section
                check box... should say Include this section?" %>
            <label class="checkbox-option member-form-full">
              <input type="checkbox" name="enabled" value="1" <%= sectionInfo.enabled ? 'checked' : '' %> />
              Include this section?
            </label>
            <label>How many <%= sectionInfo.noun %> items should each family/individual registration select in order to sign up for this event?
              <select name="selectionCount">
                <option value="">No minimum</option>
                <% for (let n = 1; n <= 50; n++) { %>
                  <option value="<%= n %>" <%= sectionInfo.count === n ? 'selected' : '' %>><%= n %></option>
                <% } %>
              </select>
            </label>
            <%# A real request: "there should also be a question that says
                Require for each attendees or each family. Radio buttons
                that say attendees, and family." 'family' means only one
                person across the whole registering family needs to meet
                the selection count above; 'attendee' means every
                registering member individually does (enforced in
                utils/events.js's registerForEvent). %>
            <div class="member-form-full">
              <span class="class-form-field-label">Require for each:</span>
              <div class="checkbox-group">
                <label class="checkbox-option"><input type="radio" name="requirementScope" value="attendee" <%= sectionInfo.scope === 'attendee' ? 'checked' : '' %> /> Attendees</label>
                <label class="checkbox-option"><input type="radio" name="requirementScope" value="family" <%= sectionInfo.scope !== 'attendee' ? 'checked' : '' %> /> Family</label>
              </div>
            </div>
            <div class="member-form-full">
              <button type="submit" class="primary-btn">Save</button>
            </div>
          </form>
        </div>
      <% } %>

      <% if (activeSection === 'volunteers') { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Volunteer Roles (<%= event.volunteerRoles.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-role-dialog').showModal()">+ Add Role</button>
          </div>

          <% if (event.volunteerRoles.length === 0) { %>
            <p class="roster-empty">No volunteer roles yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.volunteerRoles.forEach(function(role) { %>
              <%# Same click-the-row-to-edit shape as Ticket Types/Extra
                  Fields - a real request: "click on each item created in
                  these sections to edit, include trash button, clear the
                  member signed up, edit number required or description."
                  No per-row trash icon any more - Save/Close/Delete all
                  live in this role's own edit dialog below.
                  .ticket-type-row-label keeps name/count/time/members all
                  on one truncating line even on a narrow phone, same as
                  Ticket Types - a real request: "view of all signup
                  options on their individual edit pages in mobile should
                  be on the same row. Item name, 1/1 filled, time (if
                  there is one), member name signed up." %>
              <button type="button" class="training-lesson-row ticket-type-row" onclick="document.getElementById('edit-role-dialog-<%= role.id %>').showModal()">
                <span class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-users"/></svg>
                  <span class="ticket-type-row-label">
                    <strong><%= role.role_name %></strong> &middot; <%= role.filled %>/<%= role.slots_needed %> filled
                    <% if (role.time_label) { %> &middot; <%= role.time_label %><% } %>
                    <% if (role.signups.length) { %> &middot; <%= role.signups.map(function(s) { return s.memberName; }).join(', ') %><% } %>
                  </span>
                </span>
              </button>

              <dialog id="edit-role-dialog-<%= role.id %>" class="member-picker-dialog">
                <form method="POST" action="/main-admin/events/<%= event.id %>/volunteer-roles/<%= role.id %>/update">
                  <h3>Edit Volunteer Role</h3>
                  <label>Role Name
                    <input type="text" name="roleName" value="<%= role.role_name %>" required />
                  </label>
                  <label>Slots Needed
                    <input type="number" name="slotsNeeded" min="1" value="<%= role.slots_needed %>" required />
                  </label>
                  <label>Time
                    <input type="text" name="timeLabel" value="<%= role.time_label || '' %>" placeholder="e.g. 8:00-9:00am" />
                  </label>
                  <label>Location
                    <input type="text" name="location" value="<%= role.location || '' %>" />
                  </label>
                  <label>Description
                    <textarea name="description" rows="2"><%= role.description || '' %></textarea>
                  </label>
                  <% if (role.signups.length) { %>
                    <div class="member-form-full">
                      <span class="class-form-field-label">Signed up</span>
                      <div class="training-quiz-question-list">
                        <% role.signups.forEach(function(s) { %>
                          <div class="training-quiz-question-row">
                            <span><%= s.memberName %></span>
                            <span class="training-quiz-question-actions">
                              <button
                                type="button"
                                class="link-btn link-btn-danger"
                                onclick="window.confirmAction({ message: 'Clear <%= s.memberName %> from this role?', yesLabel: 'Yes, Clear' }).then(ok => { if (ok) { this.form.action = '/main-admin/events/<%= event.id %>/volunteer-roles/<%= role.id %>/signups/<%= s.member_id %>/clear'; this.form.submit(); } })"
                              >Clear</button>
                            </span>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% } %>
                  <div class="notes-dialog-actions">
                    <button
                      type="button"
                      class="link-btn link-btn-danger"
                      onclick="window.confirmAction({ message: 'Remove this volunteer role? This cannot be undone.', yesLabel: 'Yes, Delete' }).then(ok => { if (ok) { this.form.action = '/main-admin/events/<%= event.id %>/volunteer-roles/<%= role.id %>/delete'; this.form.submit(); } })"
                    >Delete Volunteer Role</button>
                    <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                    <button type="submit" class="primary-btn">Save</button>
                  </div>
                </form>
              </dialog>
            <% }); %>
          </div>
        </div>
      <% } else if (activeSection === 'donations') { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Donation Items (<%= event.donationItems.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-item-dialog').showModal()">+ Add Item</button>
          </div>

          <% if (event.donationItems.length === 0) { %>
            <p class="roster-empty">No donation items yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.donationItems.forEach(function(item) { %>
              <button type="button" class="training-lesson-row ticket-type-row" onclick="document.getElementById('edit-item-dialog-<%= item.id %>').showModal()">
                <span class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <span class="ticket-type-row-label">
                    <strong><%= item.item_name %></strong> &middot; <%= item.quantityClaimed %>/<%= item.quantity_needed %> claimed
                    <% if (item.deadline) { %> &middot; needed by <%= item.deadline %><% } %>
                    <% if (item.claims.length) { %> &middot; <%= item.claims.map(function(c) { return c.memberName; }).join(', ') %><% } %>
                  </span>
                </span>
              </button>

              <dialog id="edit-item-dialog-<%= item.id %>" class="member-picker-dialog">
                <form method="POST" action="/main-admin/events/<%= event.id %>/donation-items/<%= item.id %>/update">
                  <h3>Edit Donation Item</h3>
                  <label>Item Name
                    <input type="text" name="itemName" value="<%= item.item_name %>" required />
                  </label>
                  <label>Quantity Needed
                    <input type="number" name="quantityNeeded" min="1" value="<%= item.quantity_needed %>" required />
                  </label>
                  <label>Needed By
                    <input type="date" name="deadline" value="<%= item.deadline || '' %>" />
                  </label>
                  <label>Notes
                    <textarea name="notes" rows="2"><%= item.notes || '' %></textarea>
                  </label>
                  <% if (item.claims.length) { %>
                    <div class="member-form-full">
                      <span class="class-form-field-label">Claimed</span>
                      <div class="training-quiz-question-list">
                        <% item.claims.forEach(function(c) { %>
                          <div class="training-quiz-question-row">
                            <span><%= c.memberName %> (<%= c.quantity_claimed %>)</span>
                            <span class="training-quiz-question-actions">
                              <button
                                type="button"
                                class="link-btn link-btn-danger"
                                onclick="window.confirmAction({ message: 'Clear <%= c.memberName %>&#39;s claim?', yesLabel: 'Yes, Clear' }).then(ok => { if (ok) { this.form.action = '/main-admin/events/<%= event.id %>/donation-items/<%= item.id %>/claims/<%= c.id %>/clear'; this.form.submit(); } })"
                              >Clear</button>
                            </span>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% } %>
                  <div class="notes-dialog-actions">
                    <button
                      type="button"
                      class="link-btn link-btn-danger"
                      onclick="window.confirmAction({ message: 'Remove this donation item? This cannot be undone.', yesLabel: 'Yes, Delete' }).then(ok => { if (ok) { this.form.action = '/main-admin/events/<%= event.id %>/donation-items/<%= item.id %>/delete'; this.form.submit(); } })"
                    >Delete Donation Item</button>
                    <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                    <button type="submit" class="primary-btn">Save</button>
                  </div>
                </form>
              </dialog>
            <% }); %>
          </div>
        </div>
      <% } else if (activeSection === 'food') { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Food Items (<%= event.foodItems.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-food-item-dialog').showModal()">+ Add Item</button>
          </div>

          <% if (event.foodItems.length === 0) { %>
            <p class="roster-empty">No food items yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.foodItems.forEach(function(item) { %>
              <button type="button" class="training-lesson-row ticket-type-row" onclick="document.getElementById('edit-food-item-dialog-<%= item.id %>').showModal()">
                <span class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <span class="ticket-type-row-label">
                    <strong><%= item.item_name %></strong> &middot; <%= item.quantityClaimed %>/<%= item.quantity_needed %> claimed
                    <% if (item.deadline) { %> &middot; needed by <%= item.deadline %><% } %>
                    <% if (item.claims.length) { %> &middot; <%= item.claims.map(function(c) { return c.memberName; }).join(', ') %><% } %>
                  </span>
                </span>
              </button>

              <dialog id="edit-food-item-dialog-<%= item.id %>" class="member-picker-dialog">
                <form method="POST" action="/main-admin/events/<%= event.id %>/food-items/<%= item.id %>/update">
                  <h3>Edit Food Item</h3>
                  <label>Item Name
                    <input type="text" name="itemName" value="<%= item.item_name %>" required />
                  </label>
                  <label>Quantity Needed
                    <input type="number" name="quantityNeeded" min="1" value="<%= item.quantity_needed %>" required />
                  </label>
                  <label>Needed By
                    <input type="date" name="deadline" value="<%= item.deadline || '' %>" />
                  </label>
                  <label>Notes
                    <textarea name="notes" rows="2"><%= item.notes || '' %></textarea>
                  </label>
                  <% if (item.claims.length) { %>
                    <div class="member-form-full">
                      <span class="class-form-field-label">Claimed</span>
                      <div class="training-quiz-question-list">
                        <% item.claims.forEach(function(c) { %>
                          <div class="training-quiz-question-row">
                            <span><%= c.memberName %> (<%= c.quantity_claimed %>)</span>
                            <span class="training-quiz-question-actions">
                              <button
                                type="button"
                                class="link-btn link-btn-danger"
                                onclick="window.confirmAction({ message: 'Clear <%= c.memberName %>&#39;s claim?', yesLabel: 'Yes, Clear' }).then(ok => { if (ok) { this.form.action = '/main-admin/events/<%= event.id %>/food-items/<%= item.id %>/claims/<%= c.id %>/clear'; this.form.submit(); } })"
                              >Clear</button>
                            </span>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% } %>
                  <div class="notes-dialog-actions">
                    <button
                      type="button"
                      class="link-btn link-btn-danger"
                      onclick="window.confirmAction({ message: 'Remove this food item? This cannot be undone.', yesLabel: 'Yes, Delete' }).then(ok => { if (ok) { this.form.action = '/main-admin/events/<%= event.id %>/food-items/<%= item.id %>/delete'; this.form.submit(); } })"
                    >Delete Food Item</button>
                    <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                    <button type="submit" class="primary-btn">Save</button>
                  </div>
                </form>
              </dialog>
            <% }); %>
          </div>
        </div>
      <% } else { %>
        <%
        // Extra Fields pill - a real request: "extra fields is where you
        // can add extra form type questions for people signing up for an
        // event." Answered once per registration on the public event page
        // (views/events-detail.ejs) and stored in event_registration_
        // answers - see utils/events.js's own comment on why this is its
        // own small system rather than reusing Custom Forms.
        %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Extra Fields (<%= event.extraFields.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-extra-field-dialog').showModal()">+ Add Field</button>
          </div>

          <% if (event.extraFields.length === 0) { %>
            <p class="roster-empty">No extra fields yet - registrants only see the standard signup form.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.extraFields.forEach(function(field) { %>
              <%# Same click-the-row-to-edit shape as Ticket Types above -
                  no per-row trash icon, Save/Close/Delete all live in
                  this field's own edit dialog. %>
              <button type="button" class="training-lesson-row ticket-type-row" onclick="document.getElementById('edit-extra-field-dialog-<%= field.id %>').showModal()">
                <span class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <span class="ticket-type-row-label">
                    <strong><%= field.label %></strong> &middot; <%= field.field_type %><% if (field.required) { %> &middot; required<% } %> &middot; <%= field.scope === 'family' ? 'family' : 'each member' %>
                    <% if (field.field_type === 'select' && field.options) { %> &middot; <%= field.options.split('\n').join(', ') %><% } %>
                  </span>
                </span>
              </button>

              <dialog id="edit-extra-field-dialog-<%= field.id %>" class="member-picker-dialog">
                <form method="POST" action="/main-admin/events/<%= event.id %>/extra-fields/<%= field.id %>/update">
                  <h3>Edit Extra Field</h3>
                  <label>Question / Label
                    <input type="text" name="label" value="<%= field.label %>" placeholder="e.g. T-shirt size" required />
                  </label>
                  <label>Field Type
                    <select name="fieldType" onchange="document.getElementById('edit-extra-field-options-row-<%= field.id %>').style.display = this.value === 'select' ? '' : 'none'">
                      <% extraFieldTypes.forEach(function(t) { %>
                        <option value="<%= t %>" <%= field.field_type === t ? 'selected' : '' %>><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
                      <% }); %>
                    </select>
                  </label>
                  <label id="edit-extra-field-options-row-<%= field.id %>" style="<%= field.field_type === 'select' ? '' : 'display: none;' %>">Choices <span class="hint">(one per line)</span>
                    <textarea name="options" rows="3" placeholder="Small&#10;Medium&#10;Large"><%= field.options || '' %></textarea>
                  </label>
                  <label class="checkbox-option">
                    <input type="checkbox" name="required" value="1" <%= field.required ? 'checked' : '' %> />
                    Required to register
                  </label>
                  <%# A real request: "requires for each member or family.
                      If required for family is selected only the parent
                      will be asked to choose or fill out those extra
                      fields. If for each member is selected then it will
                      ask that for each member." %>
                  <label>Ask this of
                    <select name="scope">
                      <option value="each_member" <%= field.scope !== 'family' ? 'selected' : '' %>>Each member registering</option>
                      <option value="family" <%= field.scope === 'family' ? 'selected' : '' %>>Only the parent (once per family)</option>
                    </select>
                  </label>
                  <div class="notes-dialog-actions">
                    <button
                      type="button"
                      class="link-btn link-btn-danger"
                      onclick="window.confirmAction({ message: 'Remove this extra field? This cannot be undone.', yesLabel: 'Yes, Delete' }).then(ok => { if (ok) { this.form.action = '/main-admin/events/<%= event.id %>/extra-fields/<%= field.id %>/delete'; this.form.submit(); } })"
                    >Delete Extra Field</button>
                    <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
                    <button type="submit" class="primary-btn">Save</button>
                  </div>
                </form>
              </dialog>
            <% }); %>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <%
      // Settings tab - a real request: "permissions will show up again
      // under settings tab on individual event editing." A later real
      // request redesigned this tab: "event setting check boxes or
      // yes/no in a column on the left, question to the right" - each
      // yes/no question below is its own .checkbox-option row (checkbox
      // first, label text after - already this app's standard "checkbox
      // to the left of its own text" shape everywhere else), stacked one
      // per line via .checkbox-group-stack so every row's checkbox lines
      // up in one column. A still later real request: "make two bold
      // text titled sections for the check boxes. Registration settings
      // [...] all go under that section. All other check box questions
      // go under general settings section. Close signups check box
      // should be by itself above registration settings. Both capacity
      // features should move to register settings" - Close Event stands
      // alone, then Registration Settings (its own reworded question
      // list, plus Registration Opens/Closes/Capacity/Capacity Counted
      // By moved in from their own standalone spot below), then General
      // Settings for the remaining three. .roster-checkbox-label is the
      // same bold-section-title class the Grade Level/Age/Sections
      // headings below already use, not a new one. allow_refund_on_cancel
      // is stored, ready to wire up once a real refund feature exists,
      // same pattern allow_signup_for_others_in_group below now also
      // uses (a real "register another family in your group" feature
      // doesn't exist yet either).
      %>
      <div class="manage-section">
        <form method="POST" action="/main-admin/events/<%= event.id %>/permissions" class="member-form-grid event-settings-form">
          <%# A real request: "is this a public event check box should be
              at the top next to close event." %>
          <div class="member-form-full checkbox-group checkbox-group-stack">
            <label class="checkbox-option"><input type="checkbox" name="isClosed" value="1" <%= event.is_closed ? 'checked' : '' %> /> Close event?</label>
            <label class="checkbox-option"><input type="checkbox" name="isPublicEvent" value="1" <%= event.visibility === 'public' ? 'checked' : '' %> /> Is this a public event?</label>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">Registration Settings</span>
            <div class="checkbox-group checkbox-group-stack">
              <%# "who can register for this event" - moved in from its
                  own separate "Who Can Register" section further down,
                  same fields/hidden-fallback pattern, just relocated. %>
              <input type="hidden" name="allowAdultRegister" value="off" />
              <label class="checkbox-option"><input type="checkbox" name="allowAdultRegister" value="1" <%= event.allow_adult_register ? 'checked' : '' %> /> Include parents in the list of possible registrants when signing up?</label>
              <label class="checkbox-option"><input type="checkbox" name="trackParticipantsOnly" value="1" <%= event.track_participants_only ? 'checked' : '' %> /> Track "Participants" (only Participants count against Max Allowed)</label>
              <label class="checkbox-option"><input type="checkbox" name="showRegistrantsToMembers" value="1" <%= event.show_registrants_to_members ? 'checked' : '' %> /> Allow registrants to view a list of others who have signed up</label>
              <label class="checkbox-option"><input type="checkbox" name="allowSignupForOthersInGroup" value="1" <%= event.allow_signup_for_others_in_group ? 'checked' : '' %> /> Allow registrants to "Sign Up For" on behalf of other families in your group</label>
              <input type="hidden" name="allowChildRegister" value="off" />
              <label class="checkbox-option"><input type="checkbox" name="allowChildRegister" value="1" <%= event.allow_child_register ? 'checked' : '' %> /> Allow children access to the signup page?</label>
              <label class="checkbox-option"><input type="checkbox" name="allowGuestRegister" value="1" <%= event.allow_guest_register ? 'checked' : '' %> /> Allow non-members (guests) to register</label>
              <input type="hidden" name="allowWaitlistSignups" value="off" />
              <label class="checkbox-option"><input type="checkbox" name="allowWaitlistSignups" value="1" <%= event.allow_waitlist_signups ? 'checked' : '' %> /> Allow waiting list signups (only applicable when Max Allowed is reached)</label>
            </div>

            <%# A real request: "both capacity features should move to
                register settings under event edit settings tab" -
                Registration Opens/Closes/Capacity/Capacity Counted By,
                previously their own standalone spot on this same tab,
                moved in under this section. Capacity's number and
                "counted by" type stay paired (routes/admin-events.js's
                capacityFieldsFromBody needs both from the same
                submission to compute capacity/family_capacity correctly). %>
            <%
              // A real request: "individual event settings date should be
              // calendar picker times should be clock picker separate" +
              // later "event edit settings, date and time laid out the
              // same way" as the Details tab's own Starts/Ends fields
              // above (partials/date-range-picker.ejs).
              var opensDate = event.registration_opens_at ? event.registration_opens_at.slice(0, 10) : '';
              var opensTime = event.registration_opens_at ? event.registration_opens_at.slice(11, 16) : '';
              var closesDate = event.registration_closes_at ? event.registration_closes_at.slice(0, 10) : '';
              var closesTime = event.registration_closes_at ? event.registration_closes_at.slice(11, 16) : '';
            %>
            <%# A real request: "registration dates and times should be
                modern font settings." %>
            <div class="registration-dates-modern">
              <%- include('partials/date-range-picker', {
                startGroup: 'regOpens', endGroup: 'regCloses',
                startDateLabel: 'Registration Opens Date', endDateLabel: 'Registration Closes Date',
                startTimeLabel: 'Registration Opens Time', endTimeLabel: 'Registration Closes Time',
                startDate: opensDate, startTime: opensTime, endDate: closesDate, endTime: closesTime,
                startFieldName: 'registrationOpensAt', endFieldName: 'registrationClosesAt',
              }) %>
            </div>
            <label>Capacity <span class="hint">(blank = no limit)</span>
              <input type="number" name="capacityValue" min="1" value="<%= event.family_capacity ?? event.capacity ?? '' %>" placeholder="No limit" />
            </label>
            <label>Capacity Counted By
              <select name="capacityType">
                <option value="person" <%= event.family_capacity == null ? 'selected' : '' %>>Person</option>
                <option value="family" <%= event.family_capacity != null ? 'selected' : '' %>>Family</option>
              </select>
            </label>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">General Settings</span>
            <div class="checkbox-group checkbox-group-stack">
              <label class="checkbox-option"><input type="checkbox" name="allowRefundOnCancel" value="1" <%= event.allow_refund_on_cancel ? 'checked' : '' %> /> Allow refunds when a member cancels their registration?</label>
              <input type="hidden" name="allowRegistrationCancellations" value="off" />
              <label class="checkbox-option"><input type="checkbox" name="allowRegistrationCancellations" value="1" <%= event.allow_registration_cancellations ? 'checked' : '' %> /> Allow registration cancellations?</label>
            </div>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">Grade Level <span class="hint">(leave all unchecked to allow every grade)</span></span>
            <label class="checkbox-option"><input type="checkbox" name="lockRegistrationToGrade" value="1" <%= event.lock_registration_to_grade ? 'checked' : '' %> /> Lock registration to grade level</label>
            <%- include('partials/multi-select-checkbox', {
              name: 'ageGroup',
              options: gradeOptions.map(function(g) { return { value: g, label: g }; }),
              selected: selectedGrades,
              placeholder: 'All grades',
            }) %>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">Age <span class="hint">(leave all unchecked to allow every age)</span></span>
            <label class="checkbox-option"><input type="checkbox" name="lockRegistrationToAge" value="1" <%= event.lock_registration_to_age ? 'checked' : '' %> /> Lock registration to age level</label>
            <%- include('partials/multi-select-checkbox', {
              name: 'ageGroupRestriction',
              options: ageGroupOptions.map(function(g) { return { value: g, label: g }; }),
              selected: selectedAgeGroups,
              placeholder: 'All ages',
            }) %>
          </div>

          <%# A real request: "sections with the giant check boxes and
              titles above that needs to be deleted" - the old broad
              multi-section restriction block (checked a pile of grade-
              pill-styled boxes, restricting both viewing AND registering
              at once) is gone. The two narrower single-section gates
              below cover that same need per-purpose instead. An event
              that already had this old restriction keeps it enforced
              (utils/events.js's eventVisibleToFamily/registerForEvent
              still read it) - there's just no UI left to set a NEW one,
              so routes/admin-events.js's own Settings save no longer
              touches event_sections at all (never silently clearing a
              still-enforced old restriction just because this form has
              no field for it any more). %>
          <% if (sections.length) { %>
            <%# A real request: "lock registration to section should look
                just like the lock by age feature. Same dropdown menu
                with check boxes." Still a single section underneath
                (singleSelect: true keeps it that way even though the
                widget looks multi-select, same as Lock by Age/Grade
                above) - routes/admin-events.js takes whichever one
                checkbox comes through. %>
            <div class="member-form-full">
              <label class="checkbox-option"><input type="checkbox" name="lockRegistrationToSection" value="1" <%= event.lock_registration_to_section ? 'checked' : '' %> /> Lock registration to section</label>
              <%- include('partials/multi-select-checkbox', {
                name: 'registrationSectionId',
                options: sections.map(function(s) { return { value: s.id, label: s.name }; }),
                selected: event.registration_section_id ? [String(event.registration_section_id)] : [],
                placeholder: 'No section',
                singleSelect: true,
              }) %>
            </div>

            <div class="member-form-full">
              <label class="checkbox-option"><input type="checkbox" name="lockVisibilityToSection" value="1" <%= event.lock_visibility_to_section ? 'checked' : '' %> /> Lock registration to only be viewable to one section</label>
              <%- include('partials/multi-select-checkbox', {
                name: 'visibilitySectionId',
                options: sections.map(function(s) { return { value: s.id, label: s.name }; }),
                selected: event.visibility_section_id ? [String(event.visibility_section_id)] : [],
                placeholder: 'No section',
                singleSelect: true,
              }) %>
            </div>
          <% } %>

          <div class="member-form-full">
            <button type="submit" class="primary-btn">Save Settings</button>
          </div>
        </form>
      </div>
    <% } %>

    <dialog id="add-ticket-type-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/ticket-types">
        <h3>Add Ticket Type</h3>
        <label>Title
          <input type="text" name="title" placeholder="e.g. Adult, Child, VIP" required />
        </label>
        <label>Price ($)
          <input type="number" name="priceDollars" min="0" step="0.01" value="0.00" required />
        </label>
        <label>Charged per
          <select name="pricePer">
            <option value="person">Person</option>
            <option value="family">Family</option>
          </select>
        </label>
        <%# A real request: "add a checkbox for include physical ticket.
            Members will be able to print tickets with a barcode for
            check in and out. Barcode is the same as their member ID
            number barcode used for classes." %>
        <label class="checkbox-option">
          <input type="checkbox" name="includesPhysicalTicket" value="1" />
          Include physical ticket
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-role-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/volunteer-roles">
        <h3>Add Volunteer Role</h3>
        <label>Role Name
          <input type="text" name="roleName" placeholder="e.g. Setup Crew" required />
        </label>
        <label>Slots Needed
          <input type="number" name="slotsNeeded" min="1" value="1" required />
        </label>
        <label>Time
          <input type="text" name="timeLabel" placeholder="e.g. 8:00-9:00am" />
        </label>
        <label>Location
          <input type="text" name="location" />
        </label>
        <label>Description
          <textarea name="description" rows="2"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-item-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/donation-items">
        <h3>Add Donation Item</h3>
        <label>Item Name
          <input type="text" name="itemName" placeholder="e.g. 2-liter sodas" required />
        </label>
        <label>Quantity Needed
          <input type="number" name="quantityNeeded" min="1" value="1" required />
        </label>
        <label>Needed By
          <input type="date" name="deadline" />
        </label>
        <label>Notes
          <textarea name="notes" rows="2"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-food-item-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/food-items">
        <h3>Add Food Item</h3>
        <label>Item Name
          <input type="text" name="itemName" placeholder="e.g. Side dish for 8" required />
        </label>
        <label>Quantity Needed
          <input type="number" name="quantityNeeded" min="1" value="1" required />
        </label>
        <label>Needed By
          <input type="date" name="deadline" />
        </label>
        <label>Notes
          <textarea name="notes" rows="2"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-extra-field-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/extra-fields">
        <h3>Add Extra Field</h3>
        <label>Question / Label
          <input type="text" name="label" placeholder="e.g. T-shirt size" required />
        </label>
        <label>Field Type
          <select name="fieldType" onchange="document.getElementById('extra-field-options-row').style.display = this.value === 'select' ? '' : 'none'">
            <% extraFieldTypes.forEach(function(t) { %>
              <option value="<%= t %>"><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
            <% }); %>
          </select>
        </label>
        <label id="extra-field-options-row" style="display: none;">Choices <span class="hint">(one per line)</span>
          <textarea name="options" rows="3" placeholder="Small&#10;Medium&#10;Large"></textarea>
        </label>
        <label class="checkbox-option">
          <input type="checkbox" name="required" value="1" />
          Required to register
        </label>
        <label>Ask this of
          <select name="scope">
            <option value="each_member">Each member registering</option>
            <option value="family">Only the parent (once per family)</option>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/forum-editor.js"></script>
  <script src="/js/tag-input.js"></script>
  <script src="/js/event-builder-tab-guard.js"></script>
  <script src="/js/copy-link.js"></script>
  <script src="/js/multi-select-checkbox.js"></script>
  <script src="/js/event-image-preview.js"></script>
  <script src="/js/event-date-time-picker.js"></script>
</body>
</html>
