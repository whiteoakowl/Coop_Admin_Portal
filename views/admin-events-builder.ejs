<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= event.title %></h1>
      <span class="badge-pill badge-pill-<%= event.status === 'published' ? 'green' : event.status === 'cancelled' ? 'gray' : 'orange' %>"><%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %></span>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (event.approval_status === 'pending') { %>
      <div class="alert alert-error">
        This event was submitted by a member and is awaiting approval.
        <a href="/main-admin/events?tab=requests">Review it on the Requests tab &rarr;</a>
      </div>
    <% } %>

    <div class="roster-toolbar">
      <div class="roster-btn-row roster-btn-row-fit-text">
        <a class="roster-action-btn" href="/main-admin/events">&larr; All Events</a>
        <a class="roster-action-btn" href="/main-admin/events/<%= event.id %>/registrations">Registrations (<%= event.registrationCount %><% if (event.waitlistCount) { %> + <%= event.waitlistCount %> waitlisted<% } %>)</a>
        <%# A real request: "copy link should be at the top with the rest
            of the buttons not on the settings page" - moved here from its
            old home on the Settings tab, same data-copy-link pattern
            (public/js/copy-link.js). %>
        <button type="button" class="roster-action-btn" data-copy-link="<%= eventLink %>">Copy Link</button>
        <% if (event.status !== 'published') { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="published" />
            <button type="submit" class="roster-action-btn">Publish</button>
          </form>
        <% } %>
        <% if (event.status !== 'cancelled') { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="cancelled" />
            <button type="submit" class="roster-action-btn roster-action-btn-danger">Cancel Event</button>
          </form>
        <% } else { %>
          <form method="POST" action="/main-admin/events/<%= event.id %>/status" class="inline-block-form">
            <input type="hidden" name="status" value="draft" />
            <button type="submit" class="roster-action-btn">Move to Draft</button>
          </form>
        <% } %>
        <form method="POST" action="/main-admin/events/<%= event.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= event.title %>&quot;? This cannot be undone.">
          <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete Event" title="Delete Event"><svg class="icon"><use href="#icon-trash"/></svg></button>
        </form>
      </div>
    </div>

    <%
    // A real request: "once the event is created when you click to edit
    // the event it show the following tabs at the top, event details,
    // volunteers, donations, food, settings. permissions will show up
    // again under settings tab on individual event editing." Same
    // `.view-tabs`/`?tab=` pattern the Events list page's own tab strip
    // now uses. A later real request: "editing event should have little
    // tabs at the top. details, finance, settings, attendance" - Details
    // (renamed from "Event Details") and a new Finance tab (Price/Charged
    // Per, split out of Details) join Volunteers/Settings rather than
    // replacing them; Attendance is its own link at the end, straight to
    // the existing Registrations page (views/admin-events-registrations.
    // ejs already has the full check-in/checkout view this asked for)
    // rather than a duplicate of that page rebuilt as a tab. A still
    // later real request folded Donations/Food/Extra Fields into
    // Volunteers as a pill toggle (see activeSection below) instead of
    // each keeping its own top-level tab.
    var builderTabDefs = [
      { key: 'details', label: 'Details' },
      { key: 'finance', label: 'Finance' },
      { key: 'volunteers', label: 'Resources/Fields' },
      { key: 'settings', label: 'Settings' },
    ];
    %>
    <%# One specific event's own builder tabs - no top-level nav entry to
        attach a popup to (reached by clicking into an event, not from the
        nav), so this stays the plain connected file-tab strip every other
        tabbed page used before the orange-bar popup existed, instead of a
        popup with nothing to open it from. data-builder-nav-link is
        public/js/event-builder-tab-guard.js's own hook - "warning pop up
        when clicking to each page/tab that you must save your changes on
        that page before going to the next" for any of this page's own
        forms with an unsaved edit. %>
    <div class="view-tabs no-print">
      <% builderTabDefs.forEach(function(t) { %>
        <a href="/main-admin/events/<%= event.id %>/builder?tab=<%= t.key %>" class="view-tab <%= activeTab === t.key ? 'active' : '' %>" data-builder-nav-link><%= t.label %></a>
      <% }); %>
      <a href="/main-admin/events/<%= event.id %>/registrations" class="view-tab" data-builder-nav-link>Attendance</a>
    </div>

    <dialog id="tab-unsaved-dialog" class="notes-dialog">
      <h3>Unsaved Changes</h3>
      <p>You must save your changes on this page before going to the next. Continue anyway and lose your changes, or cancel and stay here?</p>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
        <button type="button" class="primary-btn" data-tab-guard-continue>Continue</button>
      </div>
    </dialog>

    <% if (activeTab === 'details') { %>
      <div class="manage-section">
        <form method="POST" action="/main-admin/events/<%= event.id %>" class="member-form-grid" id="details-form">
          <label class="member-form-full">Title
            <input type="text" name="title" value="<%= event.title %>" required />
          </label>
          <label>Event Slug
            <input type="text" name="slug" value="<%= event.slug || '' %>" placeholder="your-event-slug" />
          </label>
          <label>Event Type
            <select name="eventType">
              <option value="">Select event type</option>
              <% eventTypes.forEach(function(t) { %>
                <option value="<%= t %>" <%= event.event_type === t ? 'selected' : '' %>><%= t %></option>
              <% }); %>
            </select>
          </label>
          <label class="member-form-full">Short Description <span class="hint">(50-150 characters, shown wherever the event is listed)</span>
            <textarea name="shortDescription" rows="2" maxlength="150"><%= event.short_description || '' %></textarea>
          </label>
          <div class="member-form-full" data-forum-editor>
            <label>Description</label>
            <%- include('partials/forum-editor-toolbar') %>
            <div class="forum-editable" data-forum-editable contenteditable="true"><%- event.description || '' %></div>
            <input type="hidden" name="description" data-forum-body-input />
          </div>
          <label>Category
            <select name="categoryId">
              <option value="">None</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= event.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Location Details
            <input type="text" name="location" value="<%= event.location || '' %>" />
          </label>
          <label>Location
            <select name="locationId">
              <option value="">None</option>
              <% locations.forEach(function(l) { %>
                <option value="<%= l.id %>" <%= event.location_id === l.id ? 'selected' : '' %>><%= l.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Starts
            <input type="datetime-local" name="startsAt" value="<%= event.starts_at ? event.starts_at.replace(' ', 'T').slice(0, 16) : '' %>" required />
          </label>
          <label>Ends
            <input type="datetime-local" name="endsAt" value="<%= event.ends_at ? event.ends_at.replace(' ', 'T').slice(0, 16) : '' %>" />
          </label>
          <label>Organized By
            <input type="text" name="organizedBy" value="<%= event.organized_by || '' %>" placeholder="e.g., Sanford Homeschoolers" />
          </label>
          <div class="member-form-full">
            <span class="roster-checkbox-label">Tags <span class="hint">(helps people find your event)</span></span>
            <div data-tag-input="tags" class="tag-input-wrap">
              <% selectedTags.forEach(function(t) { %>
                <span class="tag-input-chip-initial" data-initial-tag="<%= t %>"></span>
              <% }); %>
              <input type="text" class="tag-input-field" placeholder="Add tags and press Enter" />
            </div>
          </div>

        </form>

        <%# A real request: "uploading image should have an upload button
            to the right of choose file. it still says something went
            wrong trying to upload a photo. after you hit upload photo
            button it should show the image before saving." A separate
            form from Details above (an HTML form can't nest inside
            another), posting straight to the dedicated POST /:id/image
            route - the image saves and shows immediately once Upload is
            clicked, with no need to also click Save Event Details.
            public/js/event-image-preview.js shows the chosen file
            instantly (before that round trip even finishes) via a local
            object URL; the img tag then also carries the real, already-
            uploaded image on every later page load. The "something went
            wrong" report was routes/admin-events.js's own uploadEventImage
            wrapper missing - a too-large file made upload.single() throw
            a MulterError that fell through to the generic error page
            instead of a friendly "too large" redirect (same fix already
            applied to routes/admin-documents.js and utils/memberIntake.js).
            A later real request: "upload photo button should be smaller,
            fit to text and sit clean next to choose file bar" -
            .roster-action-btn's own flex: 1 0 auto (meant for a ROW of
            SEVERAL buttons sharing space evenly) stretched this lone
            button to fill the entire rest of the row next to the file
            input; .roster-btn-row-fit-text doesn't help here since it's
            a mobile-only (max-width: 640px) override, so the button gets
            its own inline flex: 0 0 auto instead, sized to its own text
            on every screen size. %>
        <div class="member-form-full">
          <span class="roster-checkbox-label">Event Image</span>
          <img src="<%= imageUrl || '' %>" alt="" data-event-image-preview style="max-width: 240px; border-radius: var(--radius); display: <%= imageUrl ? 'block' : 'none' %>; margin-bottom: 0.5rem;" />
          <form method="POST" action="/main-admin/events/<%= event.id %>/image" enctype="multipart/form-data" class="roster-btn-row">
            <input type="file" name="image" accept="image/*" required data-event-image-input />
            <button type="submit" class="roster-action-btn" style="flex: 0 0 auto; min-width: 0;">Upload</button>
          </form>
        </div>

        <%# A real request: "save event details button should be the very
            last button on the page and dark blue, like we used on other
            pages." Linked to the Details form above via form="details-
            form" (an HTML form can't nest inside another - see the Image
            form's own comment above - so this can't be a normal
            descendant of that form and still sit after the Image
            section), the same standard way a submit button can live
            outside its own <form> tag; public/js/event-builder-tab-
            guard.js's own dirty-tracking listens on the <form> element
            itself, not this button, so it isn't affected by the button
            no longer being a DOM descendant. %>
        <div class="member-form-full">
          <button type="submit" form="details-form" class="primary-btn primary-btn-dark">Save Event Details</button>
        </div>
      </div>
    <% } else if (activeTab === 'finance') { %>
      <%# A real request: "editing event should have little tabs at the
          top. details, finance, settings, attendance" - Price/Charged Per
          split out of Event Details into their own tab. A later real
          request: "accounting category drop is all that is now needed
          above ticket types" - the flat Price/Charged Per fields that
          used to sit here are gone; each Ticket Type below now carries
          its own price and person/family basis instead. %>
      <div class="manage-section">
        <form method="POST" action="/main-admin/events/<%= event.id %>/finance" class="member-form-grid">
          <%# A real request: "add a drop down menu for choosing
              accounting category" - the list itself is managed from the
              Events list page's own Settings tab (Add/Edit Accounting
              Category), same place/pattern as Categories/Locations. %>
          <label>Accounting Category
            <select name="accountingCategoryId">
              <option value="">None</option>
              <% accountingCategories.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= event.accounting_category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </label>
          <%# A real request: "adding a the title payment instructions
              with a text field below it. This will appear when members
              are choosing their tickets." Same title+free-text shape as
              the existing membership-application payment info - shown to
              a registrant on the event's own public page next to its
              Price/Ticket Types, not a real checkout. %>
          <label class="member-form-full">Payment Instructions Title
            <input type="text" name="paymentInstructionsTitle" value="<%= event.payment_instructions_title || '' %>" placeholder="e.g. How to Pay" />
          </label>
          <label class="member-form-full">Payment Instructions
            <textarea name="paymentInstructionsText" rows="3" placeholder="e.g. Pay by cash, check, or Venmo @coopname at drop-off."><%= event.payment_instructions_text || '' %></textarea>
          </label>
          <div class="member-form-full">
            <button type="submit" class="primary-btn">Save Finance</button>
          </div>
        </form>
      </div>

      <%# A real request: "add ticket types, price, title and permissions
          person or family." Admin-side only for now (a scoping question
          confirmed this) - registration doesn't yet let a registrant pick
          one and be charged accordingly. Same +Add/list/delete shape as
          Volunteer Roles/Donation Items/Food Items below. %>
      <div class="manage-section">
          <div class="grid-box-header">
            <h2>Ticket Types (<%= event.ticketTypes.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-ticket-type-dialog').showModal()">+ Add Ticket Type</button>
          </div>

          <% if (event.ticketTypes.length === 0) { %>
            <p class="roster-empty">No ticket types yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.ticketTypes.forEach(function(t) { %>
              <div class="training-lesson-row">
                <div class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <div class="training-lesson-info">
                    <strong><%= t.title %></strong>
                    <span class="hint">$<%= (t.price_cents / 100).toFixed(2) %> per <%= t.price_per %></span>
                  </div>
                  <div class="training-lesson-actions">
                    <form method="POST" action="/main-admin/events/<%= event.id %>/ticket-types/<%= t.id %>/delete" class="inline-block-form" data-confirm="Remove ticket type &quot;<%= t.title %>&quot;?">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= t.title %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
    <% } else if (activeTab === 'volunteers') { %>
      <%
      // A real request: "volunteers, food, donations and extra fields
      // tabs should be under one tab called, Volunteers. There will then
      // be a pill toggle on this page for volunteers, food, donations and
      // extra fields." Same `?section=` pattern as `?tab=`, just one
      // level down - pillSectionDefs drives both the toggle strip and
      // which of the four panels below actually renders.
      var pillSectionDefs = [
        { key: 'volunteers', label: 'Volunteers' },
        { key: 'food', label: 'Food' },
        { key: 'donations', label: 'Donations' },
        { key: 'extraFields', label: 'Extra Fields' },
      ];
      %>
      <div class="day-toggle no-print" style="margin-bottom: 1rem;">
        <% pillSectionDefs.forEach(function(s) { %>
          <a href="/main-admin/events/<%= event.id %>/builder?tab=volunteers&section=<%= s.key %>" class="day-toggle-option <%= activeSection === s.key ? 'active' : '' %>"><%= s.label %></a>
        <% }); %>
      </div>

      <% if (activeSection === 'volunteers' || activeSection === 'donations' || activeSection === 'food') { %>
        <%
        // A real request: "on the volunteer, donations and food pages.
        // there will be a check box for, do you want to include this
        // section? then a dropdown menu of numbers 1-50 that ask, how many
        // volunteer/donation/food items should each family/individual
        // registration select in order to sign up for this event?" Same
        // shape for all three sections, so one shared block renders
        // whichever one is active instead of writing this out 3 times.
        var sectionInfo = {
          volunteers: { enabled: !!event.volunteers_enabled, count: event.volunteer_selection_count, items: event.volunteerRoles, noun: 'volunteer' },
          donations: { enabled: !!event.donations_enabled, count: event.donation_selection_count, items: event.donationItems, noun: 'donation' },
          food: { enabled: !!event.food_enabled, count: event.food_selection_count, items: event.foodItems, noun: 'food' },
        }[activeSection];
        %>
        <div class="manage-section">
          <form method="POST" action="/main-admin/events/<%= event.id %>/<%= activeSection %>-settings" class="member-form-grid">
            <label class="checkbox-option member-form-full">
              <input type="checkbox" name="enabled" value="1" <%= sectionInfo.enabled ? 'checked' : '' %> />
              Do you want to include this section?
            </label>
            <label>How many <%= sectionInfo.noun %> items should each family/individual registration select in order to sign up for this event?
              <select name="selectionCount">
                <option value="">No minimum</option>
                <% for (let n = 1; n <= 50; n++) { %>
                  <option value="<%= n %>" <%= sectionInfo.count === n ? 'selected' : '' %>><%= n %></option>
                <% } %>
              </select>
            </label>
            <div class="member-form-full">
              <button type="submit" class="primary-btn">Save</button>
            </div>
          </form>
        </div>
      <% } %>

      <% if (activeSection === 'volunteers') { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Volunteer Roles (<%= event.volunteerRoles.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-role-dialog').showModal()">+ Add Role</button>
          </div>

          <% if (event.volunteerRoles.length === 0) { %>
            <p class="roster-empty">No volunteer roles yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.volunteerRoles.forEach(function(role) { %>
              <div class="training-lesson-row">
                <div class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-users"/></svg>
                  <div class="training-lesson-info">
                    <strong><%= role.role_name %></strong>
                    <span class="hint">
                      <%= role.filled %>/<%= role.slots_needed %> filled
                      <% if (role.time_label) { %> &middot; <%= role.time_label %><% } %>
                      <% if (role.location) { %> &middot; <%= role.location %><% } %>
                    </span>
                    <% if (role.signups.length) { %>
                      <span class="hint"><%= role.signups.map(function(s) { return s.memberName; }).join(', ') %></span>
                    <% } %>
                  </div>
                  <div class="training-lesson-actions">
                    <form method="POST" action="/main-admin/events/<%= event.id %>/volunteer-roles/<%= role.id %>/delete" class="inline-block-form" data-confirm="Remove volunteer role &quot;<%= role.role_name %>&quot;?">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= role.role_name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } else if (activeSection === 'donations') { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Donation Items (<%= event.donationItems.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-item-dialog').showModal()">+ Add Item</button>
          </div>

          <% if (event.donationItems.length === 0) { %>
            <p class="roster-empty">No donation items yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.donationItems.forEach(function(item) { %>
              <div class="training-lesson-row">
                <div class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <div class="training-lesson-info">
                    <strong><%= item.item_name %></strong>
                    <span class="hint">
                      <%= item.quantityClaimed %>/<%= item.quantity_needed %> claimed
                      <% if (item.deadline) { %> &middot; needed by <%= item.deadline %><% } %>
                    </span>
                    <% if (item.claims.length) { %>
                      <span class="hint"><%= item.claims.map(function(c) { return c.memberName + ' (' + c.quantity_claimed + ')'; }).join(', ') %></span>
                    <% } %>
                  </div>
                  <div class="training-lesson-actions">
                    <form method="POST" action="/main-admin/events/<%= event.id %>/donation-items/<%= item.id %>/delete" class="inline-block-form" data-confirm="Remove donation item &quot;<%= item.item_name %>&quot;?">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= item.item_name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } else if (activeSection === 'food') { %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Food Items (<%= event.foodItems.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-food-item-dialog').showModal()">+ Add Item</button>
          </div>

          <% if (event.foodItems.length === 0) { %>
            <p class="roster-empty">No food items yet.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.foodItems.forEach(function(item) { %>
              <div class="training-lesson-row">
                <div class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <div class="training-lesson-info">
                    <strong><%= item.item_name %></strong>
                    <span class="hint">
                      <%= item.quantityClaimed %>/<%= item.quantity_needed %> claimed
                      <% if (item.deadline) { %> &middot; needed by <%= item.deadline %><% } %>
                    </span>
                    <% if (item.claims.length) { %>
                      <span class="hint"><%= item.claims.map(function(c) { return c.memberName + ' (' + c.quantity_claimed + ')'; }).join(', ') %></span>
                    <% } %>
                  </div>
                  <div class="training-lesson-actions">
                    <form method="POST" action="/main-admin/events/<%= event.id %>/food-items/<%= item.id %>/delete" class="inline-block-form" data-confirm="Remove food item &quot;<%= item.item_name %>&quot;?">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= item.item_name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } else { %>
        <%
        // Extra Fields pill - a real request: "extra fields is where you
        // can add extra form type questions for people signing up for an
        // event." Answered once per registration on the public event page
        // (views/events-detail.ejs) and stored in event_registration_
        // answers - see utils/events.js's own comment on why this is its
        // own small system rather than reusing Custom Forms.
        %>
        <div class="manage-section">
          <div class="grid-box-header">
            <h2>Extra Fields (<%= event.extraFields.length %>)</h2>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-extra-field-dialog').showModal()">+ Add Field</button>
          </div>

          <% if (event.extraFields.length === 0) { %>
            <p class="roster-empty">No extra fields yet - registrants only see the standard signup form.</p>
          <% } %>

          <div class="training-lesson-list">
            <% event.extraFields.forEach(function(field) { %>
              <div class="training-lesson-row">
                <div class="training-lesson-row-main">
                  <svg class="icon"><use href="#icon-badge"/></svg>
                  <div class="training-lesson-info">
                    <strong><%= field.label %></strong>
                    <span class="hint">
                      <%= field.field_type %><% if (field.required) { %> &middot; required<% } %>
                      <% if (field.field_type === 'select' && field.options) { %> &middot; <%= field.options.split('\n').join(', ') %><% } %>
                    </span>
                  </div>
                  <div class="training-lesson-actions">
                    <form method="POST" action="/main-admin/events/<%= event.id %>/extra-fields/<%= field.id %>/delete" class="inline-block-form" data-confirm="Remove extra field &quot;<%= field.label %>&quot;?">
                      <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= field.label %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <%
      // Settings tab - a real request: "permissions will show up again
      // under settings tab on individual event editing." A later real
      // request redesigned this tab: "event setting check boxes or
      // yes/no in a column on the left, question to the right" - each
      // yes/no question below is its own .checkbox-option row (checkbox
      // first, label text after - already this app's standard "checkbox
      // to the left of its own text" shape everywhere else), stacked one
      // per line via .checkbox-group-stack so every row's checkbox lines
      // up in one column. A still later real request: "make two bold
      // text titled sections for the check boxes. Registration settings
      // [...] all go under that section. All other check box questions
      // go under general settings section. Close signups check box
      // should be by itself above registration settings. Both capacity
      // features should move to register settings" - Close Event stands
      // alone, then Registration Settings (its own reworded question
      // list, plus Registration Opens/Closes/Capacity/Capacity Counted
      // By moved in from their own standalone spot below), then General
      // Settings for the remaining three. .roster-checkbox-label is the
      // same bold-section-title class the Grade Level/Age/Sections
      // headings below already use, not a new one. allow_refund_on_cancel
      // is stored, ready to wire up once a real refund feature exists,
      // same pattern allow_signup_for_others_in_group below now also
      // uses (a real "register another family in your group" feature
      // doesn't exist yet either).
      %>
      <div class="manage-section">
        <form method="POST" action="/main-admin/events/<%= event.id %>/permissions" class="member-form-grid">
          <div class="member-form-full checkbox-group checkbox-group-stack">
            <label class="checkbox-option"><input type="checkbox" name="isClosed" value="1" <%= event.is_closed ? 'checked' : '' %> /> Close event?</label>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">Registration Settings</span>
            <div class="checkbox-group checkbox-group-stack">
              <%# "who can register for this event" - moved in from its
                  own separate "Who Can Register" section further down,
                  same fields/hidden-fallback pattern, just relocated. %>
              <input type="hidden" name="allowAdultRegister" value="off" />
              <label class="checkbox-option"><input type="checkbox" name="allowAdultRegister" value="1" <%= event.allow_adult_register ? 'checked' : '' %> /> Include parents in the list of possible registrants when signing up?</label>
              <label class="checkbox-option"><input type="checkbox" name="trackParticipantsOnly" value="1" <%= event.track_participants_only ? 'checked' : '' %> /> Track "Participants" (only Participants count against Max Allowed)</label>
              <label class="checkbox-option"><input type="checkbox" name="showRegistrantsToMembers" value="1" <%= event.show_registrants_to_members ? 'checked' : '' %> /> Allow registrants to view a list of others who have signed up</label>
              <label class="checkbox-option"><input type="checkbox" name="allowSignupForOthersInGroup" value="1" <%= event.allow_signup_for_others_in_group ? 'checked' : '' %> /> Allow registrants to "Sign Up For" on behalf of other families in your group</label>
              <input type="hidden" name="allowChildRegister" value="off" />
              <label class="checkbox-option"><input type="checkbox" name="allowChildRegister" value="1" <%= event.allow_child_register ? 'checked' : '' %> /> Allow children access to the signup page?</label>
              <label class="checkbox-option"><input type="checkbox" name="allowGuestRegister" value="1" <%= event.allow_guest_register ? 'checked' : '' %> /> Allow registration on behalf of people outside your group</label>
              <input type="hidden" name="allowWaitlistSignups" value="off" />
              <label class="checkbox-option"><input type="checkbox" name="allowWaitlistSignups" value="1" <%= event.allow_waitlist_signups ? 'checked' : '' %> /> Allow waiting list signups (only applicable when Max Allowed is reached)</label>
            </div>

            <%# A real request: "both capacity features should move to
                register settings under event edit settings tab" -
                Registration Opens/Closes/Capacity/Capacity Counted By,
                previously their own standalone spot on this same tab,
                moved in under this section. Capacity's number and
                "counted by" type stay paired (routes/admin-events.js's
                capacityFieldsFromBody needs both from the same
                submission to compute capacity/family_capacity correctly). %>
            <label>Registration Opens
              <input type="datetime-local" name="registrationOpensAt" value="<%= event.registration_opens_at ? event.registration_opens_at.replace(' ', 'T').slice(0, 16) : '' %>" />
            </label>
            <label>Registration Closes
              <input type="datetime-local" name="registrationClosesAt" value="<%= event.registration_closes_at ? event.registration_closes_at.replace(' ', 'T').slice(0, 16) : '' %>" />
            </label>
            <label>Capacity <span class="hint">(blank = no limit)</span>
              <input type="number" name="capacityValue" min="1" value="<%= event.family_capacity ?? event.capacity ?? '' %>" placeholder="No limit" />
            </label>
            <label>Capacity Counted By
              <select name="capacityType">
                <option value="person" <%= event.family_capacity == null ? 'selected' : '' %>>Person</option>
                <option value="family" <%= event.family_capacity != null ? 'selected' : '' %>>Family</option>
              </select>
            </label>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">General Settings</span>
            <div class="checkbox-group checkbox-group-stack">
              <%# "Is this a public event?" moves here from Details' own
                  Visibility dropdown (dead code - that route never read
                  it, so it was removed rather than duplicated). %>
              <label class="checkbox-option"><input type="checkbox" name="isPublicEvent" value="1" <%= event.visibility === 'public' ? 'checked' : '' %> /> Is this a public event?</label>
              <label class="checkbox-option"><input type="checkbox" name="allowRefundOnCancel" value="1" <%= event.allow_refund_on_cancel ? 'checked' : '' %> /> Allow refunds when a member cancels their registration?</label>
              <input type="hidden" name="allowRegistrationCancellations" value="off" />
              <label class="checkbox-option"><input type="checkbox" name="allowRegistrationCancellations" value="1" <%= event.allow_registration_cancellations ? 'checked' : '' %> /> Allow registration cancellations?</label>
            </div>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">Grade Level <span class="hint">(leave all unchecked to allow every grade)</span></span>
            <label class="checkbox-option"><input type="checkbox" name="lockRegistrationToGrade" value="1" <%= event.lock_registration_to_grade ? 'checked' : '' %> /> Lock registration to grade level</label>
            <%- include('partials/multi-select-checkbox', {
              name: 'ageGroup',
              options: gradeOptions.map(function(g) { return { value: g, label: g }; }),
              selected: selectedGrades,
              placeholder: 'All grades',
            }) %>
          </div>

          <div class="member-form-full">
            <span class="roster-checkbox-label">Age <span class="hint">(leave all unchecked to allow every age)</span></span>
            <label class="checkbox-option"><input type="checkbox" name="lockRegistrationToAge" value="1" <%= event.lock_registration_to_age ? 'checked' : '' %> /> Lock registration to age level</label>
            <%- include('partials/multi-select-checkbox', {
              name: 'ageGroupRestriction',
              options: ageGroupOptions.map(function(g) { return { value: g, label: g }; }),
              selected: selectedAgeGroups,
              placeholder: 'All ages',
            }) %>
          </div>

          <% if (sections.length) { %>
            <div class="member-form-full">
              <span class="roster-checkbox-label">Sections <span class="hint">(leave all unchecked to allow every section - restricts BOTH viewing and registering)</span></span>
              <div class="grade-pill-grid">
                <% sections.forEach(function(s) { %>
                  <label class="grade-pill"><input type="checkbox" name="sectionIds" value="<%= s.id %>" <%= event.sectionIds.includes(s.id) ? 'checked' : '' %> /> <%= s.name %></label>
                <% }); %>
              </div>
            </div>

            <%# A real request: "checkbox lock registration to section,
                drop down of sections" and "lock registration to only be
                viewable to one section check box and dropdown" - two
                narrower single-section gates alongside the multi-section
                restriction above (utils/events.js's registerForEvent/
                eventVisibleToFamily enforce both). %>
            <div class="member-form-full">
              <label class="checkbox-option"><input type="checkbox" name="lockRegistrationToSection" value="1" <%= event.lock_registration_to_section ? 'checked' : '' %> /> Lock registration to section</label>
              <select name="registrationSectionId">
                <option value="">None</option>
                <% sections.forEach(function(s) { %>
                  <option value="<%= s.id %>" <%= event.registration_section_id === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="member-form-full">
              <label class="checkbox-option"><input type="checkbox" name="lockVisibilityToSection" value="1" <%= event.lock_visibility_to_section ? 'checked' : '' %> /> Lock registration to only be viewable to one section</label>
              <select name="visibilitySectionId">
                <option value="">None</option>
                <% sections.forEach(function(s) { %>
                  <option value="<%= s.id %>" <%= event.visibility_section_id === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }); %>
              </select>
            </div>
          <% } %>

          <div class="member-form-full">
            <button type="submit" class="primary-btn">Save Settings</button>
          </div>
        </form>
      </div>
    <% } %>

    <dialog id="add-ticket-type-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/ticket-types">
        <h3>Add Ticket Type</h3>
        <label>Title
          <input type="text" name="title" placeholder="e.g. Adult, Child, VIP" required />
        </label>
        <label>Price ($)
          <input type="number" name="priceDollars" min="0" step="0.01" value="0.00" required />
        </label>
        <label>Charged per
          <select name="pricePer">
            <option value="person">Person</option>
            <option value="family">Family</option>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-role-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/volunteer-roles">
        <h3>Add Volunteer Role</h3>
        <label>Role Name
          <input type="text" name="roleName" placeholder="e.g. Setup Crew" required />
        </label>
        <label>Slots Needed
          <input type="number" name="slotsNeeded" min="1" value="1" required />
        </label>
        <label>Time
          <input type="text" name="timeLabel" placeholder="e.g. 8:00-9:00am" />
        </label>
        <label>Location
          <input type="text" name="location" />
        </label>
        <label>Description
          <textarea name="description" rows="2"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-item-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/donation-items">
        <h3>Add Donation Item</h3>
        <label>Item Name
          <input type="text" name="itemName" placeholder="e.g. 2-liter sodas" required />
        </label>
        <label>Quantity Needed
          <input type="number" name="quantityNeeded" min="1" value="1" required />
        </label>
        <label>Needed By
          <input type="date" name="deadline" />
        </label>
        <label>Notes
          <textarea name="notes" rows="2"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-food-item-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/food-items">
        <h3>Add Food Item</h3>
        <label>Item Name
          <input type="text" name="itemName" placeholder="e.g. Side dish for 8" required />
        </label>
        <label>Quantity Needed
          <input type="number" name="quantityNeeded" min="1" value="1" required />
        </label>
        <label>Needed By
          <input type="date" name="deadline" />
        </label>
        <label>Notes
          <textarea name="notes" rows="2"></textarea>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-extra-field-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/events/<%= event.id %>/extra-fields">
        <h3>Add Extra Field</h3>
        <label>Question / Label
          <input type="text" name="label" placeholder="e.g. T-shirt size" required />
        </label>
        <label>Field Type
          <select name="fieldType" onchange="document.getElementById('extra-field-options-row').style.display = this.value === 'select' ? '' : 'none'">
            <% extraFieldTypes.forEach(function(t) { %>
              <option value="<%= t %>"><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
            <% }); %>
          </select>
        </label>
        <label id="extra-field-options-row" style="display: none;">Choices <span class="hint">(one per line)</span>
          <textarea name="options" rows="3" placeholder="Small&#10;Medium&#10;Large"></textarea>
        </label>
        <label class="checkbox-option">
          <input type="checkbox" name="required" value="1" />
          Required to register
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add</button>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/forum-editor.js"></script>
  <script src="/js/tag-input.js"></script>
  <script src="/js/event-builder-tab-guard.js"></script>
  <script src="/js/copy-link.js"></script>
  <script src="/js/multi-select-checkbox.js"></script>
  <script src="/js/event-image-preview.js"></script>
</body>
</html>
