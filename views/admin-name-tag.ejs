<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <h1>Name Tag Requests</h1>

    <div class="category-filter">
      <label for="date-select">Date</label>
      <select id="date-select" onchange="window.location = '/admin/name-tag' + (this.value ? '?date=' + encodeURIComponent(this.value) : '')">
        <option value="">All dates</option>
        <% dates.forEach(function(d) { %>
          <option value="<%= d.date %>" <%= dateFilter === d.date ? 'selected' : '' %>><%= d.label %></option>
        <% }); %>
      </select>
    </div>

    <div class="roster-scroll">
      <table class="roster-table members-table condensed-table">
        <thead>
          <tr><th>Submitted</th><th>Name</th><th>Request</th><th>Day</th><th>Description</th></tr>
        </thead>
        <tbody>
          <% if (submissions.length === 0) { %>
            <tr><td colspan="5" class="roster-empty">No name tag requests yet.</td></tr>
          <% } %>
          <% submissions.forEach(function(s) { %>
            <tr>
              <td><%= s.timestamp %></td>
              <td><%= s.memberName %></td>
              <td><%= s.requestTypeLabel %></td>
              <td><%= s.dayLabel %></td>
              <td><%= s.description %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
