<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="event-wizard-header">
      <div>
        <h1>Create New Event</h1>
        <p class="hint">Fill in the details below to create your event.</p>
      </div>
      <%# A real request: "After creating an event you can click create
          draft only, no immediate publishing. Then you can go in and use
          the full editing features." Publish now only happens from the
          per-event builder's own toolbar (routes/admin-events.js's
          already-existing POST /:id/status), once there's a real event to
          review first. %>
      <div class="event-wizard-header-actions">
        <button type="submit" form="event-wizard-form" name="status" value="draft" class="primary-btn">Create Draft</button>
      </div>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <%# A real request chain: originally a 3-step Details/Tickets/
        Permissions wizard, then Tickets was retired (a real Ticket Type
        needs the event to already exist - that happens after creation,
        on the Finance tab), then finally: "no permissions page when
        creating the event. Access to permissions for an event will come
        after creation of the event. So event creation will now just be
        one page." Permissions (Grade Restriction/Who Can Register/
        Sections) is folded into this same page below instead of its own
        step - no more step circles/Back-Continue navigation needed for
        just one page. %>
    <form id="event-wizard-form" method="POST" action="/main-admin/events" enctype="multipart/form-data">
      <div class="manage-section">
        <h2>Event Details</h2>
        <div class="member-form-grid">
          <label class="member-form-full">Event Title <span class="required-star">*</span>
            <input type="text" name="title" placeholder="e.g., Annual Science Fair 2026" required data-slug-source />
          </label>
          <label>Event URL
            <div class="event-url-field">
              <span class="event-url-base"><%= origin %>/events/</span>
              <input type="text" name="slug" placeholder="your-event-slug" data-slug-target />
            </div>
          </label>
          <label>Event Category
            <select name="categoryId">
              <option value="">Select a category</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Event Type
            <select name="eventType">
              <option value="">Select event type</option>
              <% eventTypes.forEach(function(t) { %>
                <option value="<%= t %>"><%= t %></option>
              <% }); %>
            </select>
          </label>
          <div class="member-form-full">
            <label>Short Description <span class="required-star">*</span> <span class="hint">(50-150 characters)</span></label>
            <div class="class-form-textarea-wrap">
              <textarea name="shortDescription" rows="2" maxlength="150" placeholder="A short summary of your event" required oninput="this.nextElementSibling.textContent = this.value.length + '/150'"></textarea>
              <span class="class-form-char-count">0/150</span>
            </div>
          </div>
          <div class="member-form-full" data-forum-editor>
            <label>Event Description <span class="required-star">*</span></label>
            <%- include('partials/forum-editor-toolbar') %>
            <div class="forum-editable" data-forum-editable contenteditable="true"></div>
            <input type="hidden" name="description" data-forum-body-input required />
          </div>
        </div>

        <h3 class="event-wizard-subheading">Date &amp; Time</h3>
        <%# A real request: "dates and times options should be separated.
            Date should be a calendar picker, time should be a clock
            picker" - the exact same partials/date-range-picker.ejs
            (calendar date input + time-of-day <select>, recombined
            client-side by public/js/event-date-time-picker.js into the
            same startsAt/endsAt/registrationOpensAt/registrationClosesAt
            "YYYY-MM-DDTHH:MM" hidden value this form always submitted)
            the per-event builder's own Details/Settings tabs already use -
            see that partial's own header comment. %>
        <div class="member-form-grid">
          <%- include('partials/date-range-picker', {
            startGroup: 'starts', endGroup: 'ends',
            startDateLabel: 'Start Date', endDateLabel: 'End Date',
            startTimeLabel: 'Start Time', endTimeLabel: 'End Time',
            startDate: '', startTime: '', endDate: '', endTime: '',
            startFieldName: 'startsAt', endFieldName: 'endsAt',
            startRequired: true,
          }) %>
          <%- include('partials/date-range-picker', {
            startGroup: 'regOpens', endGroup: 'regCloses',
            startDateLabel: 'Registration Opens Date', endDateLabel: 'Registration Closes Date',
            startTimeLabel: 'Registration Opens Time', endTimeLabel: 'Registration Closes Time',
            startDate: '', startTime: '', endDate: '', endTime: '',
            startFieldName: 'registrationOpensAt', endFieldName: 'registrationClosesAt',
          }) %>
        </div>

        <h3 class="event-wizard-subheading">Location &amp; Capacity</h3>
        <div class="member-form-grid">
          <label class="member-form-full">Location (legacy text - prefer the dropdown below)
            <input type="text" name="location" placeholder="e.g., Community Center, 123 Main St" />
          </label>
          <label class="member-form-full">Location
            <select name="locationId">
              <option value="">None</option>
              <% locations.forEach(function(l) { %>
                <option value="<%= l.id %>"><%= l.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Visibility
            <select name="visibility">
              <option value="members">Members only</option>
              <option value="public">Public</option>
            </select>
          </label>
          <label>Capacity <span class="hint">(blank = no limit)</span>
            <input type="number" name="capacityValue" min="1" placeholder="No limit" />
          </label>
          <label>Capacity Counted By
            <select name="capacityType">
              <option value="person">Person</option>
              <option value="family">Family</option>
            </select>
          </label>
          <label>Organized By
            <input type="text" name="organizedBy" placeholder="e.g., Sanford Homeschoolers" />
          </label>
        </div>

        <%# A real request: "remove volunteer signups from page 1. That
            feature is only available under its own tab after initially
            creating the event." The "Add a Volunteer List / Add a Signup
            List" dropdowns that used to live here are gone - the
            per-event builder's own Volunteers/Resources tab is where
            volunteer roles (and, for a pre-existing standalone list,
            whatever a future admin-facing attach flow looks like) are
            managed from now on, same as every other section. %>

        <h3 class="event-wizard-subheading">Event Image</h3>
        <label class="member-form-full">Choose an Image <span class="hint">(optional)</span>
          <input type="file" name="image" accept="image/*" />
        </label>

        <div class="member-form-full">
          <span class="roster-checkbox-label">Tags <span class="hint">(helps people find your event)</span></span>
          <div data-tag-input="tags" class="tag-input-wrap">
            <input type="text" class="tag-input-field" placeholder="Add tags and press Enter" />
          </div>
        </div>

        <%# A real request: "no permissions page when creating the event.
            Access to permissions for an event will come after creation of
            the event." Folded directly onto this one page instead of its
            own step - every field here already has the exact same
            sensible defaults (allow adults/kids, no grade or section
            restriction) when a raw create POST doesn't send them at all,
            same as this page now never does; the per-event builder's own
            Settings tab is where they're ever changed again. %>
        <h3 class="event-wizard-subheading">Permissions</h3>
        <div class="member-form-full">
          <span class="roster-checkbox-label">Grade Restriction <span class="hint">(leave all unchecked to allow every grade)</span></span>
          <%- include('partials/multi-select-checkbox', {
            name: 'ageGroup',
            options: gradeOptions.map(function(g) { return { value: g, label: g }; }),
            selected: [],
            placeholder: 'All grades',
          }) %>
        </div>

        <%
        // A real request: "guests can register should only be a check box
        // under who can register with parent and student options."
        %>
        <h3 class="event-wizard-subheading">Who Can Register</h3>
        <div class="class-form-row">
          <div class="class-form-field">
            <input type="hidden" name="allowAdultRegister" value="off" />
            <label class="grade-pill"><input type="checkbox" name="allowAdultRegister" value="1" checked /> Parents/adults can register</label>
          </div>
          <div class="class-form-field">
            <input type="hidden" name="allowChildRegister" value="off" />
            <label class="grade-pill"><input type="checkbox" name="allowChildRegister" value="1" checked /> Kids can register</label>
          </div>
          <div class="class-form-field">
            <label class="grade-pill"><input type="checkbox" name="allowGuestRegister" value="1" /> Guests can register</label>
          </div>
        </div>

        <% if (sections.length) { %>
          <h3 class="event-wizard-subheading">Sections <span class="hint">(leave all unchecked to allow every section - restricts BOTH viewing and registering)</span></h3>
          <div class="grade-pill-grid">
            <% sections.forEach(function(s) { %>
              <label class="grade-pill"><input type="checkbox" name="sectionIds" value="<%= s.id %>" /> <%= s.name %></label>
            <% }); %>
          </div>
        <% } %>

        <%# A real request: "Don't ask for volunteer, food, extra fields or
            donations during initial event creation... Then you can go in
            and use the full editing features and add donations,
            volunteers, extra fields and food." Removed the Event Sections
            checkbox trio that used to sit here - Volunteers/Donations
            still default to on and Food to off either way
            (routes/admin-events.js's own registrationFieldsFromBody reads
            them as unset, not unchecked, when this page never submits
            these fields at all), and every section's own on/off switch,
            plus its actual items (volunteer roles, donation items, food
            items, ticket types), are all one stop on the full builder
            this draft opens into next. %>
        <p class="hint">Creating the draft below takes you to this event's full editor, where Settings, Finance (including Ticket Types), Attendance, and Volunteers/Donations/Food/Extra Fields are all ready to fill in - and where you can publish it when it's ready.</p>

        <%# A real request: "Save/continue and cancel buttons should be the
            same height and font size" - both are now plain siblings in
            the same row (no more Back button to tell apart from Cancel),
            and public/css/styles.css's own .event-wizard-footer-right
            rule gives .btn-secondary the same box model as .primary-btn
            right here so neither reads as the "smaller" option. %>
        <div class="event-wizard-footer">
          <a class="btn-secondary" href="/main-admin/events">Cancel</a>
          <div class="event-wizard-footer-right">
            <button type="submit" name="status" value="draft" class="primary-btn">Create Draft</button>
          </div>
        </div>
      </div>
    </form>
  </main>
  <script src="/js/forum-editor.js"></script>
  <script src="/js/tag-input.js"></script>
  <script src="/js/event-wizard.js"></script>
  <script src="/js/multi-select-checkbox.js"></script>
  <script src="/js/event-date-time-picker.js"></script>
</body>
</html>
