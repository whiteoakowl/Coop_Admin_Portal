<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <p class="subtitle"><a href="/admin/setup">&larr; Setup/Cleanup</a></p>
    <h1><%= dayLabel %> Setup/Cleanup Teams</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="manage-section">
      <h2>New Team</h2>
      <form method="POST" action="/admin/setup/<%= day %>/teams" class="volunteer-sections-form">
        <input type="text" name="title" placeholder="Team title (e.g. Chairs &amp; Tables)" required />
        <input type="text" name="description" placeholder="Short description (optional)" />
        <button type="submit">Create Team</button>
      </form>
    </div>

    <% if (teams.length === 0) { %>
      <p class="roster-empty">No teams yet - create one above.</p>
    <% } %>

    <% teams.forEach(function(t) { %>
      <div class="manage-section setup-team-card">
        <div class="setup-team-header">
          <form method="POST" action="/admin/setup/<%= day %>/teams/<%= t.id %>/edit" class="setup-team-edit-form">
            <input
              type="text"
              name="title"
              value="<%= t.title %>"
              class="setup-team-title-input"
              onblur="if (this.value.trim() && this.value !== this.defaultValue) this.form.submit();"
            />
            <input
              type="text"
              name="description"
              value="<%= t.description || '' %>"
              class="setup-team-desc-input"
              placeholder="Short description"
              onblur="if (this.value !== this.defaultValue) this.form.submit();"
            />
          </form>
          <form method="POST" action="/admin/setup/<%= day %>/teams/<%= t.id %>/delete" class="inline-block-form" onsubmit="return confirm('Delete team &quot;<%= t.title %>&quot;? This cannot be undone.');">
            <button type="submit" class="link-btn link-btn-danger">Delete Team</button>
          </form>
        </div>

        <div class="checkbox-row">
          <% if (t.members.length === 0) { %><span class="hint">No members yet.</span><% } %>
          <% t.members.forEach(function(m) { %>
            <span class="badge-pill">
              <%= m.name %>
              <form method="POST" action="/admin/setup/<%= day %>/teams/<%= t.id %>/remove-member/<%= m.id %>" class="inline-block-form">
                <button type="submit" class="badge-pill-x" aria-label="Remove <%= m.name %>">&times;</button>
              </form>
            </span>
          <% }); %>
        </div>
        <form method="POST" action="/admin/setup/<%= day %>/teams/<%= t.id %>/add-member" class="inline-form-flat">
          <select name="memberId" required>
            <option value="">Add member&hellip;</option>
            <% t.availableMembers.forEach(function(m) { %>
              <option value="<%= m.id %>"><%= m.name %></option>
            <% }); %>
          </select>
          <button type="submit">Add</button>
        </form>
      </div>
    <% }); %>
  </main>
</body>
</html>
