<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Store',
    navLinks: [
      { href: '/portal', icon: 'home', label: 'My Portals' },
      { href: '/store', icon: 'tag', label: 'Store' },
      { href: '/store/orders', icon: 'file-text', label: 'My Orders' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Store</h1>

    <% if (products.length === 0) { %>
      <p class="roster-empty">Nothing for sale online right now.</p>
    <% } else { %>
      <div class="event-card-grid">
        <% products.forEach(function(p) { %>
          <a class="event-card" href="/store/<%= p.id %>">
            <% if (p.imageUrl) { %>
              <div class="event-card-image"><img src="<%= p.imageUrl %>" alt="" /></div>
            <% } %>
            <div class="event-card-body">
              <span class="event-card-date">$<%= (p.price_cents / 100).toFixed(2) %></span>
              <h3><%= p.name %></h3>
              <% if (p.inventory_count != null) { %><p class="event-card-location"><%= p.inventory_count %> left</p><% } %>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
