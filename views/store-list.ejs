<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<%
  // A real bug report: "Parent portal, clicking on store changes the
  // portal dashboard menu, it's going somewhere else." /store is shared
  // across every portal (any signed-in account, requirePortalAuth), but
  // unconditionally hardcoded portalTitle:'Store' - losing a parent's
  // (or student's) own portal nav shell every time, same class of bug
  // /events and /forums both had before their own fixes. A signed-in
  // parent/student now gets their real portal nav shell instead; anyone
  // else (teacher/coop_admin/main_admin browsing the member store) still
  // gets this page's own generic 3-link fallback below.
%>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: sharedPortalTitle('Store'),
    navLinks: [
      { href: '/portal', icon: 'home', label: 'My Portals' },
      { href: '/store', icon: 'tag', label: 'Store' },
      { href: '/store/orders', icon: 'file-text', label: 'My Orders' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Store</h1>

    <%# A real request: "add a subpage called settings. This where general
        store settings will happen" - "Shop open for online purchases?"
        closes the whole member storefront without archiving every
        product one at a time (routes/store.js). %>
    <% if (storeClosed) { %>
      <p class="roster-empty">The shop is currently closed. Check back soon!</p>
    <% } else { %>
      <% if (welcomeMessage) { %>
        <p class="store-welcome-message"><%= welcomeMessage %></p>
      <% } %>
      <% if (products.length === 0) { %>
        <p class="roster-empty">Nothing for sale online right now.</p>
      <% } else { %>
      <%# A real request: "storefront view of product should look exactly
          like this" (reference image) - a vertical card: a tall photo on
          top (with a soft tinted background behind it even when there's
          no real photo yet), name, a price/in-stock row (a dot + text,
          not a pill badge), and a full-width rounded View button. %>
      <div class="store-product-grid">
        <% products.forEach(function(p) { %>
          <a class="store-product-card" href="/store/<%= p.id %>">
            <div class="store-product-card-image-wrap">
              <% if (p.imageUrl) { %>
                <img class="store-product-card-image" src="<%= p.imageUrl %>" alt="" />
              <% } %>
            </div>
            <div class="store-product-card-body">
              <h3 class="store-product-card-name"><%= p.name %></h3>
              <div class="store-product-card-price-row">
                <span class="store-product-card-price">$<%= (p.price_cents / 100).toFixed(2) %></span>
                <span class="store-product-card-stock <%= p.inStock ? 'store-in-stock' : 'store-out-of-stock' %>">
                  <span class="store-stock-dot"></span><%= p.inStock ? 'In Stock' : 'Out of Stock' %>
                </span>
              </div>
              <span class="store-product-card-cta">View</span>
            </div>
          </a>
        <% }); %>
      </div>
      <% } %>
    <% } %>
  </main>
</body>
</html>
