<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/users', icon: 'user-check', label: 'Users' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Announcements' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/sections', icon: 'grid', label: 'Sections' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/roles', icon: 'sliders', label: 'Roles & Permissions' },
      { href: '/main-admin/website', icon: 'palette', label: 'Website' },
      { href: '/main-admin/registration-windows', icon: 'clock', label: 'Registration' },
      { href: '/main-admin/diplomas', icon: 'badge', label: 'Diplomas' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Diplomas</h1>
    <p class="hint">Issue a diploma to a student - it shows up on their Student Portal (and their parents') immediately, with a print-friendly view.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <section class="portal-dashboard-card portal-dashboard-card-wide">
      <h2>Issue a Diploma</h2>
      <form method="POST" action="/main-admin/diplomas" class="member-form-grid">
        <label class="member-form-full">Student
          <select name="studentId" required>
            <option value="" disabled selected>Select a student&hellip;</option>
            <% students.forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }); %>
          </select>
        </label>
        <label class="member-form-full">Title
          <input type="text" name="title" value="Diploma of Completion" />
        </label>
        <label>Issue Date
          <input type="date" name="issuedDate" required />
        </label>
        <label class="member-form-full">Body Text <span class="hint">(optional - shown on the printed diploma)</span>
          <textarea name="bodyText" rows="3"></textarea>
        </label>
        <div class="member-form-full">
          <button type="submit" class="primary-btn">Issue Diploma</button>
        </div>
      </form>
    </section>

    <section class="portal-dashboard-section">
      <h2>Issued Diplomas</h2>
      <% if (diplomas.length === 0) { %>
        <p class="roster-empty">No diplomas issued yet.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table">
            <thead>
              <tr>
                <th>Student</th>
                <th>Title</th>
                <th>Issued</th>
              </tr>
            </thead>
            <tbody>
              <% diplomas.forEach(function(d) { %>
                <tr>
                  <td class="roster-name-col"><%= d.student_name %></td>
                  <td><%= d.title %></td>
                  <td><%= d.issued_date %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
