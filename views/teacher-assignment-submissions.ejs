<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Teacher Portal',
    navLinks: [
      { href: '/teacher', icon: 'home', label: 'Home' },
      { href: '/teacher/attendance', icon: 'calendar-check', label: 'Attendance' },
      { href: '/teacher/classes', icon: 'graduation-cap', label: 'Classes' },
      { href: '/forums', icon: 'users', label: 'Chat' },
      { href: '/training', icon: 'graduation-cap', label: 'Training' },
      { href: '/teacher/assignments', icon: 'clipboard-list', label: 'Assignments' },
      { href: '/forums', icon: 'mail', label: 'Messages' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="hint"><a href="/teacher/assignments/<%= assignment.id %>">&larr; <%= assignment.title %></a></p>
    <h1><%= contentItem.title || 'Assignment Submission' %></h1>
    <% if (contentItem.body) { %><div class="hint forum-editable-display"><%- contentItem.body %></div><% } %>
    <p class="hint">
      <% if (contentItem.points_possible != null) { %>Out of <%= contentItem.points_possible %> points<% } %>
    </p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="manage-section">
      <div class="grid-box-header">
        <h2>Submissions</h2>
      </div>

      <% if (rows.length === 0) { %>
        <p class="roster-empty">No students enrolled in this class yet.</p>
      <% } else { %>
        <form method="POST" action="/teacher/content/<%= contentItem.id %>/submissions">
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table">
              <thead>
                <tr>
                  <th>Student</th>
                  <th>Submitted</th>
                  <th>Points Earned</th>
                  <th>Grade</th>
                  <th>Feedback</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function(r) { %>
                  <tr>
                    <td class="roster-name-col"><%= r.student_name %></td>
                    <td>
                      <% if (r.fileUrl) { %>
                        <a href="<%= r.fileUrl %>" target="_blank" rel="noopener"><%= r.file_name || 'Uploaded file' %></a>
                        <% if (r.status === 'graded') { %> <span class="badge-pill badge-pill-green">Graded</span><% } %>
                      <% } else { %>
                        <span class="hint">Not submitted yet</span>
                      <% } %>
                    </td>
                    <td>
                      <input type="number" name="points_<%= r.student_id %>" min="0" step="0.5" value="<%= r.points_earned != null ? r.points_earned : '' %>" style="width: 6rem;" <%= r.submission_id ? '' : 'disabled' %> />
                    </td>
                    <td>
                      <input type="text" name="grade_<%= r.student_id %>" value="<%= r.grade_letter || '' %>" placeholder="e.g. A-" style="width: 5rem;" <%= r.submission_id ? '' : 'disabled' %> />
                    </td>
                    <td>
                      <input type="text" name="feedback_<%= r.student_id %>" value="<%= r.feedback || '' %>" <%= r.submission_id ? '' : 'disabled' %> />
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <div style="margin-top: 1rem;">
            <button type="submit" class="primary-btn">Save Grades</button>
          </div>
        </form>
      <% } %>
    </div>
  </main>
</body>
</html>
