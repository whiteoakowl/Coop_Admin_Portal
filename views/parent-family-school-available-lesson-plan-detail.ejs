<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle no-print"><a href="/parent/family-school/classes/available-lesson-plans">&larr; Available Lesson Plans</a></p>
    <h1><%= plan.title %></h1>
    <% if (plan.description) { %><p class="hint"><%= plan.description %></p><% } %>
    <% if (plan.grade_level) { %><span class="team-info-pill"><%= plan.grade_level %></span><% } %>
    <% if (plan.subject) { %><span class="team-info-pill"><%= plan.subject %></span><% } %>

    <%# "click on each class, view the lessons and assignments outline
        and click on each assignment/lesson to view what is there."
        Read-only - every content item links into its own read-only
        viewer, nothing on this page is ever editable. %>
    <div class="manage-section">
      <h2>Lessons &amp; Assignments</h2>
      <% if (contentItems.length === 0) { %>
        <p class="hint">Nothing has been added to this lesson plan yet.</p>
      <% } else { %>
        <%
          var CONTENT_TYPE_ICONS = {
            video: 'video', text: 'file-text', file: 'file-text', quiz: 'list-check',
            assignment_upload: 'clipboard-list', assignment_submission: 'clipboard-list',
          };
          var CONTENT_TYPE_LABELS = {
            video: 'Video', text: 'Text', file: 'File', quiz: 'Quiz',
            assignment_upload: 'Assignment', assignment_submission: 'Assignment',
          };
        %>
        <ol class="lesson-outline-list">
          <% contentItems.forEach(function(item) { %>
            <li>
              <a class="lesson-outline-item" href="/parent/family-school/classes/available-lesson-plans/<%= plan.id %>/content/<%= item.id %>">
                <svg class="icon"><use href="#icon-<%= CONTENT_TYPE_ICONS[item.type] || 'file-text' %>"/></svg>
                <span><%= item.title || '(untitled)' %></span>
                <span class="hint"><%= CONTENT_TYPE_LABELS[item.type] || item.type %></span>
              </a>
            </li>
          <% }); %>
        </ol>
      <% } %>
    </div>
  </main>
</body>
</html>
