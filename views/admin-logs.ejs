<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= tab === 'absence' ? 'Absence/Late Log' : tab === 'checkinout' ? 'Co-op Check-In/Out Log' : tab === 'classcheckinout' ? 'Class Check-In/Out Log' : tab === 'classrisk' ? 'Class Cancellation Risk' : tab === 'substitutes' ? 'Substitutes Needed' : tab === 'allergies' ? 'Allergies/Medical Log' : 'Name Tag Requests' %></p>
      </div>
    </div>
    <h1>Logs</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="view-tabs no-print">
      <a class="view-tab<%= tab === 'absence' ? ' active' : '' %>" href="/admin/logs?tab=absence">Absence/Late Log</a>
      <a class="view-tab<%= tab === 'checkinout' ? ' active' : '' %>" href="/admin/logs?tab=checkinout">Co-op Check-In/Out Log</a>
      <a class="view-tab<%= tab === 'classcheckinout' ? ' active' : '' %>" href="/admin/logs?tab=classcheckinout">Class Check-In/Out Log</a>
      <a class="view-tab<%= tab === 'nametag' ? ' active' : '' %>" href="/admin/logs?tab=nametag">Name Tag Requests</a>
      <a class="view-tab<%= tab === 'classrisk' ? ' active' : '' %>" href="/admin/logs?tab=classrisk">Class Cancellation Risk</a>
      <a class="view-tab<%= tab === 'substitutes' ? ' active' : '' %>" href="/admin/logs?tab=substitutes">Substitutes Needed</a>
      <a class="view-tab<%= tab === 'allergies' ? ' active' : '' %>" href="/admin/logs?tab=allergies">Allergies/Medical</a>
    </div>
    <div class="view-tab-panel">
      <% if (tab === 'absence') { %>
        <div class="roster-toolbar no-print">
          <div class="category-filter" style="margin: 0;">
            <label for="date-select">Date</label>
            <select id="date-select" onchange="window.location = '/admin/logs?tab=absence' + (this.value ? '&date=' + encodeURIComponent(this.value) : '')">
              <option value="">All dates</option>
              <% dates.forEach(function(d) { %>
                <option value="<%= d.date %>" <%= dateFilter === d.date ? 'selected' : '' %>><%= d.label %></option>
              <% }); %>
            </select>
          </div>
          <div class="roster-btn-row">
            <a class="roster-action-btn file-action-btn" href="/admin/logs/absence/export.csv<%= dateFilter ? '?date=' + encodeURIComponent(dateFilter) : '' %>">Export</a>
            <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
          </div>
        </div>

        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table logs-screen-table">
            <thead>
              <tr><th>Name</th><th>Roster</th><th>Date</th><th>Status</th><th>Reason</th><th>Description</th></tr>
            </thead>
            <tbody>
              <% if (submissions.length === 0) { %>
                <tr><td colspan="6" class="roster-empty">No absence or late submissions<%= dateFilter ? ' for this date' : ' yet' %>.</td></tr>
              <% } %>
              <% submissions.forEach(function(s) { %>
                <tr>
                  <td><%= s.memberName %></td>
                  <td><%= s.rosterName %></td>
                  <td><%= s.dateLabel %></td>
                  <td><span class="status-badge <%= s.statusLabel === 'Late' ? 'status-badge-late' : 'status-badge-absent' %>"><%= s.statusLabel %></span></td>
                  <td><%= s.reasonLabel %></td>
                  <td><%= s.description %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>

        <%# Print always shows every filtered submission, not just whichever
            page is open on screen - see .logs-screen-table/.logs-print-table
            in styles.css (same reasoning/pattern as Members' own
            .members-list-table/.members-print-table split). %>
        <table class="roster-table members-table condensed-table logs-print-table">
          <thead>
            <tr><th>Name</th><th>Roster</th><th>Date</th><th>Status</th><th>Reason</th><th>Description</th></tr>
          </thead>
          <tbody>
            <% if (allSubmissions.length === 0) { %>
              <tr><td colspan="6" class="roster-empty">No absence or late submissions<%= dateFilter ? ' for this date' : ' yet' %>.</td></tr>
            <% } %>
            <% allSubmissions.forEach(function(s) { %>
              <tr>
                <td><%= s.memberName %></td>
                <td><%= s.rosterName %></td>
                <td><%= s.dateLabel %></td>
                <td><span class="status-badge <%= s.statusLabel === 'Late' ? 'status-badge-late' : 'status-badge-absent' %>"><%= s.statusLabel %></span></td>
                <td><%= s.reasonLabel %></td>
                <td><%= s.description %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else if (tab === 'checkinout' || tab === 'classcheckinout') { %>
        <div class="roster-toolbar no-print">
          <div class="category-filter" style="margin: 0;">
            <label for="date-select">Date</label>
            <select id="date-select" onchange="window.location = '/admin/logs?tab=<%= tab %>' + (this.value ? '&date=' + encodeURIComponent(this.value) : '')">
              <option value="">All dates</option>
              <% dates.forEach(function(d) { %>
                <option value="<%= d.date %>" <%= dateFilter === d.date ? 'selected' : '' %>><%= d.label %></option>
              <% }); %>
            </select>
          </div>
          <div class="roster-btn-row">
            <a class="roster-action-btn file-action-btn" href="/admin/logs/<%= tab %>/export.csv<%= dateFilter ? '?date=' + encodeURIComponent(dateFilter) : '' %>">Export</a>
            <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
          </div>
        </div>

        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table logs-screen-table">
            <thead>
              <tr><th>Name</th><th>Roster</th><th>Date</th><th>Check-In Time</th><th>Check-Out Time</th><th>Number</th></tr>
            </thead>
            <tbody>
              <% if (rows.length === 0) { %>
                <tr><td colspan="6" class="roster-empty">No check-ins recorded yet.</td></tr>
              <% } %>
              <% rows.forEach(function(r) { %>
                <tr>
                  <td><%= r.memberName %></td>
                  <td><%= r.rosterName %></td>
                  <td><%= r.dateLabel %></td>
                  <td><%= r.checkInTime %></td>
                  <td><%= r.checkOutTime %></td>
                  <td><%= r.number %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>

        <table class="roster-table members-table condensed-table logs-print-table">
          <thead>
            <tr><th>Name</th><th>Roster</th><th>Date</th><th>Check-In Time</th><th>Check-Out Time</th><th>Number</th></tr>
          </thead>
          <tbody>
            <% if (allRows.length === 0) { %>
              <tr><td colspan="6" class="roster-empty">No check-ins recorded yet.</td></tr>
            <% } %>
            <% allRows.forEach(function(r) { %>
              <tr>
                <td><%= r.memberName %></td>
                <td><%= r.rosterName %></td>
                <td><%= r.dateLabel %></td>
                <td><%= r.checkInTime %></td>
                <td><%= r.checkOutTime %></td>
                <td><%= r.number %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else if (tab === 'nametag') { %>
        <div class="roster-toolbar no-print">
          <div class="category-filter" style="margin: 0;">
            <label for="date-select">Date</label>
            <select id="date-select" onchange="window.location = '/admin/logs?tab=nametag<%= showArchived ? '&archived=1' : '' %>' + (this.value ? '&date=' + encodeURIComponent(this.value) : '')">
              <option value="">All dates</option>
              <% dates.forEach(function(d) { %>
                <option value="<%= d.date %>" <%= dateFilter === d.date ? 'selected' : '' %>><%= d.label %></option>
              <% }); %>
            </select>
          </div>
          <div class="roster-btn-row">
            <a
              class="roster-action-btn archived-toggle-btn<%= showArchived ? ' active' : '' %>"
              href="/admin/logs?tab=nametag<%= showArchived ? '' : '&archived=1' %><%= dateFilter ? '&date=' + encodeURIComponent(dateFilter) : '' %>"
            >Archived</a>
            <a class="roster-action-btn file-action-btn" href="/admin/logs/nametag/export.csv?archived=<%= showArchived ? 1 : 0 %><%= dateFilter ? '&date=' + encodeURIComponent(dateFilter) : '' %>">Export</a>
            <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
          </div>
        </div>

        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table logs-screen-table">
            <thead>
              <tr><th>Submitted</th><th>Name</th><th>Request</th><th>Day</th><th>Description</th><th>Submitted</th><th></th></tr>
            </thead>
            <tbody>
              <% if (submissions.length === 0) { %>
                <tr><td colspan="7" class="roster-empty">No <%= showArchived ? 'archived' : '' %> name tag requests yet.</td></tr>
              <% } %>
              <% submissions.forEach(function(s) { %>
                <tr>
                  <td><%= s.timestamp %></td>
                  <td><%= s.memberName %></td>
                  <td><%= s.requestTypeLabel %></td>
                  <td><%= s.dayLabel %></td>
                  <td><%= s.description %></td>
                  <%# A real request: "add the date and timestamp to the end
                      of the row, before the archive icon button" - same
                      value as the row's own leading Submitted column,
                      repeated here so it's still visible without scrolling
                      back to the left edge on a narrow/scrolled table. %>
                  <td><%= s.timestamp %></td>
                  <td class="no-print">
                    <form method="POST" action="/admin/logs/nametag/<%= s.id %>/<%= showArchived ? 'unarchive' : 'archive' %>">
                      <button type="submit" class="btn-secondary condensed-btn"><%= showArchived ? 'Unarchive' : 'Archive' %></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>

        <%# No Archive/Unarchive column here - it's an on-screen-only action,
            already .no-print'd out of the screen table above, so the
            print-only table simply never has that column in the first
            place. %>
        <table class="roster-table members-table condensed-table logs-print-table">
          <thead>
            <tr><th>Submitted</th><th>Name</th><th>Request</th><th>Day</th><th>Description</th></tr>
          </thead>
          <tbody>
            <% if (allSubmissions.length === 0) { %>
              <tr><td colspan="5" class="roster-empty">No <%= showArchived ? 'archived' : '' %> name tag requests yet.</td></tr>
            <% } %>
            <% allSubmissions.forEach(function(s) { %>
              <tr>
                <td><%= s.timestamp %></td>
                <td><%= s.memberName %></td>
                <td><%= s.requestTypeLabel %></td>
                <td><%= s.dayLabel %></td>
                <td><%= s.description %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else if (tab === 'classrisk') { %>
        <div class="roster-toolbar no-print">
          <div class="day-toggle">
            <a class="day-toggle-option<%= day === 'monday' ? ' active' : '' %>" href="/admin/logs?tab=classrisk&day=monday">Monday</a>
            <a class="day-toggle-option<%= day === 'wednesday' ? ' active' : '' %>" href="/admin/logs?tab=classrisk&day=wednesday">Wednesday</a>
          </div>
          <div class="roster-btn-row">
            <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
          </div>
        </div>
        <%- include('partials/class-risk-table', { classesAtRisk, dayLabel }) %>
      <% } else if (tab === 'substitutes') { %>
        <div class="roster-toolbar no-print">
          <div class="filter-row">
            <div class="day-toggle">
              <%# The whole href is built in JS and output as a single
                  expression - not literal "&day=..." text mixed with a
                  separately-interpolated "&date=..." piece - so EJS's
                  auto-escaping applies uniformly across the full query
                  string instead of only to the dynamic part. %>
              <a class="day-toggle-option<%= day === 'monday' ? ' active' : '' %>" href="<%= '/admin/logs?tab=substitutes&day=monday' + (dateFilter ? '&date=' + dateFilter : '') %>">Monday</a>
              <a class="day-toggle-option<%= day === 'wednesday' ? ' active' : '' %>" href="<%= '/admin/logs?tab=substitutes&day=wednesday' + (dateFilter ? '&date=' + dateFilter : '') %>">Wednesday</a>
            </div>
            <div class="category-filter">
              <label for="sub-log-date">For Date</label>
              <input
                type="date"
                id="sub-log-date"
                value="<%= dateFilter %>"
                onchange="window.location = '/admin/logs?tab=substitutes&day=<%= day %>' + (this.value ? '&date=' + this.value : '')"
              />
            </div>
          </div>
          <div class="roster-btn-row">
            <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
          </div>
        </div>

        <% var anySlots = board.some(function(h) { return h.slots.length > 0; }); %>
        <% if (!dateFilter) { %>
          <p class="roster-empty">Pick a date above to see who needs a substitute.</p>
        <% } else if (!anySlots) { %>
          <p class="roster-empty">Nobody needed a substitute on <%= dayLabel %>, <%= dateFilter %>.</p>
        <% } %>
        <% board.forEach(function(hour) { %>
          <% if (hour.slots.length === 0) return; %>
          <h3 class="class-schedule-hour-label"><%= hour.label %></h3>
          <div class="roster-scroll">
            <table class="roster-table members-table condensed-table">
              <thead><tr><th>Position</th><th>Reason</th><th>Status</th><th>Assigned</th></tr></thead>
              <tbody>
                <% hour.slots.forEach(function(slot) { %>
                  <tr>
                    <td><%= slot.label %><% if (slot.detail) { %> <span class="hint">(<%= slot.detail %>)</span><% } %></td>
                    <td><%= slot.reason %></td>
                    <td>
                      <% if (!slot.assigned) { %>
                        <span class="badge-pill badge-pill-absent">Needs Substitute</span>
                      <% } else if (slot.overdue) { %>
                        <span class="badge-pill badge-pill-absent">No-show &mdash; Needs Sub Again</span>
                      <% } else if (slot.assigned.status === 'pending') { %>
                        <span class="badge-pill badge-pill-pending">Awaiting Approval</span>
                      <% } else { %>
                        <span class="badge-pill badge-pill-present">Filled</span>
                      <% } %>
                    </td>
                    <td><%= slot.assigned ? slot.assigned.name + (slot.assigned.infant ? ' (infant)' : '') : '—' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% }); %>
      <% } else if (tab === 'allergies') { %>
        <div class="roster-toolbar no-print">
          <div></div>
          <div class="roster-btn-row">
            <a class="roster-action-btn file-action-btn" href="/admin/logs/allergies/export.csv">Export</a>
            <a class="roster-action-btn print-action-btn" href="/admin/logs/allergies/print" target="_blank">Print</a>
          </div>
        </div>
        <%- include('partials/allergy-log-fragment', { medicalMembers }) %>
      <% } %>
    </div>
  </main>
</body>
</html>
