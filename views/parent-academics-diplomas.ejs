<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Diplomas</h1>
    <p class="hint">Design and print a diploma for your own student - pick a template and color, then edit the name, dates, and signatures. Saving again replaces its design - each student has one diploma.</p>

    <% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (diplomas.length === 0) { %>
      <p class="roster-empty">No students are linked to your family yet. Contact an admin if this looks wrong.</p>
    <% } %>

    <%# The per-student designer itself (card + Edit Design dialog) is
        shared with Main Admin's own Diplomas page (any student, not
        just one's own children) - see views/partials/diploma-student-
        builder.ejs. %>
    <% diplomas.forEach(function(rec) { %>
      <%- include('partials/diploma-student-builder', { rec, todayISO, DIPLOMA_TEMPLATES, basePath: '/parent/academics/diplomas' }) %>
    <% }); %>
  </main>
  <script src="/js/diploma-designer.js"></script>
</body>
</html>
