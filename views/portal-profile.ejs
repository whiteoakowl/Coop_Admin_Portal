<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page portal-page">
  <%- include('partials/icon-sprite') %>
  <%- include('partials/portal-topbar') %>
  <main class="portal-main">
    <div class="portal-header">
      <div>
        <p class="subtitle"><a href="<%= portalRole === 'coop_admin' ? '/admin' : '/portal' %>">&larr; Back</a></p>
        <h1>Profile</h1>
      </div>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="manage-section">
      <h2>Account</h2>
      <p><strong><%= member.name %></strong></p>
      <p class="hint">Username: <%= member.username %></p>
      <p class="hint"><%= member.member_type === 'parent' ? 'Parent' : member.member_type === 'admin' ? 'Admin' : 'Student' %></p>
    </div>

    <div class="manage-section">
      <h2>Change Password</h2>
      <form method="POST" action="/portal/profile/password" class="stack-form stack-form-narrow">
        <label for="currentPassword">Current Password</label>
        <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />

        <label for="newPassword">New Password</label>
        <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required minlength="8" />

        <button type="submit" class="primary-btn">Update Password</button>
      </form>
    </div>

    <div class="manage-section">
      <form method="POST" action="/portal/logout" class="logout-form">
        <button type="submit" class="btn-secondary">
          <svg class="icon"><use href="#icon-log-out"/></svg>
          Log Out
        </button>
      </form>
    </div>
  </main>
</body>
</html>
