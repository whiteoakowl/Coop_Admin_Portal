<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="profile-page">
  <%
    // Same bug class as accounting-home.ejs's own comment - this is the
    // literal "Account" bug from the report ("clicking on account it
    // takes you somewhere else and the dashboard changes"). Kept navLinks
    // as the fallback for non-parent/student accounts (teacher, main
    // admin, ...) that also have their own profile.
  %>
  <%- include('partials/portal-nav', {
    portalTitle: sharedPortalTitle('My Profile'),
    navLinks: [
      { href: '/portal', icon: 'home', label: 'My Portals' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <% if (activeTab !== 'profile') { %><h1>My Profile</h1><% } %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%# A real request: "Clicking on the profile icon at the top on every
        portal should be the member's full profile membership form so
        that they can edit it. It will also have a tab for schedules,
        event signups." A later real request: "when parent portal clicks
        the profile button, keep the current profile view. When you
        click the edit profile button it should look exactly like the
        membership request form" - the Profile tab is now the exact same
        read-only partials/member-profile-card.ejs banner every other
        portal's own Member Profile page already uses (its own "Edit"
        link goes to routes/portal-auth.js's own GET /portal/profile/edit),
        instead of an inline edit form - no more Password tab either
        (that field lives on the new Edit Profile page now, same as the
        public membership form's own Password field). %>
    <div class="view-tabs no-print">
      <a class="view-tab<%= activeTab === 'profile' ? ' active' : '' %>" href="/portal/profile?tab=profile">Profile</a>
      <a class="view-tab<%= activeTab === 'schedules' ? ' active' : '' %>" href="/portal/profile?tab=schedules">Schedules</a>
      <a class="view-tab<%= activeTab === 'signups' ? ' active' : '' %>" href="/portal/profile?tab=signups">Event Signups</a>
    </div>

    <% if (activeTab === 'profile') { %>
      <%- include('partials/member-profile-card', {
        member,
        familyName,
        famParents,
        famChildren,
        memberSections,
        memberPortalRoles,
        backHref: '/portal',
        backLabel: 'My Portals',
        editHref: '/portal/profile/edit',
        familyMemberHref: function(id) { return '/portal/family/' + id; },
      }) %>
    <% } else if (activeTab === 'schedules') { %>
      <%# A real request: "Schedules tab should be organized by family
          member and then by day under each family member." One section
          per family member (self first, then the rest - same order the
          Profile tab's own My Family list uses), each with its own
          day-by-day class tables instead of one flat table with a Name
          column. %>
      <% if (!schedule.some(function(m) { return m.days.length > 0; })) { %>
        <p class="hint">No class schedule on file yet.</p>
      <% } else { %>
        <% schedule.forEach(function(memberSchedule) { %>
          <div class="form-section">
            <h2><%= memberSchedule.memberName %></h2>
            <% if (memberSchedule.days.length === 0) { %>
              <p class="hint">No classes scheduled.</p>
            <% } else { %>
              <% memberSchedule.days.forEach(function(d) { %>
                <h3 class="profile-schedule-day-heading"><%= dayLabels[d.day] || d.day %></h3>
                <div class="roster-scroll">
                  <table class="roster-table profile-schedule-table">
                    <thead><tr><th>Time</th><th>Class</th><th>Room</th><th>Role</th></tr></thead>
                    <tbody>
                      <% d.classes.forEach(function(row) { %>
                        <tr>
                          <td><%= row.start_time || '' %><% if (row.end_time) { %>&ndash;<%= row.end_time %><% } %></td>
                          <td><%= row.class_name %></td>
                          <td><%= row.room || '' %></td>
                          <td><%= row.role %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% }); %>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    <% } else { %>
      <%# A real request: "Event signup tab should be organized by month
          and then by event with drop down from the event to show who
          signed up and what you may have signed up for like food,
          volunteer etc." One section per month, one plain <details>/
          <summary> card per event inside it (same no-JS click-to-expand
          idiom events-detail.ejs's own "Who's Registered" list already
          uses) - expanding shows this family's own registrations plus
          any sign-up-list item or volunteer shift claims tied to that
          event. %>
      <% if (signups.length === 0) { %>
        <p class="hint">No event sign-ups on file yet.</p>
      <% } else { %>
        <% signups.forEach(function(month) { %>
          <div class="form-section">
            <h2><%= month.monthLabel %></h2>
            <% month.events.forEach(function(ev) { %>
              <details class="manage-section">
                <summary><strong><%= ev.title %></strong> <span class="hint"><%= (ev.starts_at || '').slice(0, 10) %></span></summary>
                <% if (ev.registrations.length > 0) { %>
                  <p class="hint">Registered:</p>
                  <ul class="member-profile-plain-list">
                    <% ev.registrations.forEach(function(r) { %>
                      <li><%= r.memberName %> <span class="badge-pill <%= r.status === 'confirmed' ? 'badge-pill-green' : 'badge-pill-orange' %>"><%= r.status.charAt(0).toUpperCase() + r.status.slice(1) %></span></li>
                    <% }); %>
                  </ul>
                <% } %>
                <% if (ev.items.length > 0) { %>
                  <p class="hint">Signed up to bring:</p>
                  <ul class="member-profile-plain-list">
                    <% ev.items.forEach(function(it) { %>
                      <li><%= it.memberName %> &mdash; <%= it.itemName %><% if (it.quantityClaimed > 1) { %> (x<%= it.quantityClaimed %>)<% } %></li>
                    <% }); %>
                  </ul>
                <% } %>
                <% if (ev.shifts.length > 0) { %>
                  <p class="hint">Volunteer shifts:</p>
                  <ul class="member-profile-plain-list">
                    <% ev.shifts.forEach(function(s) { %>
                      <li><%= s.memberName %> &mdash; <%= s.jobName %> (<%= s.shiftDate %><% if (s.startTime) { %> <%= s.startTime %><% if (s.endTime) { %>&ndash;<%= s.endTime %><% } %><% } %>)</li>
                    <% }); %>
                  </ul>
                <% } %>
              </details>
            <% }); %>
          </div>
        <% }); %>
      <% } %>
    <% } %>
  </main>
</body>
</html>
