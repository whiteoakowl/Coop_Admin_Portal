<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<%
  // A real bug report class: "Parent portal, clicking on [a Community &
  // Commerce page] changes the portal dashboard menu, it's going
  // somewhere else." /directory is a genuinely public page (browsable
  // signed out), so it can't assume every visitor belongs to one portal
  // the way a native /parent/* page can - but it used to show this plain
  // public header even to a signed-in parent/student, same class of bug
  // /events had before its own fix (see views/events-list.ejs's own
  // comment). A signed-in parent/student now gets their real portal nav
  // shell instead, with this exact same listing grid inside it.
  const hasParentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'parent');
  const hasStudentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'student');
  const usesPortalNavShell = hasParentRole || hasStudentRole;
%>
<body>
  <% if (usesPortalNavShell) { %>
    <%- include('partials/portal-nav', { portalTitle: hasParentRole ? 'Parent Portal' : 'Student Portal' }) %>
  <% } else { %>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="btn-secondary" href="/directory/mine">My Listings</a>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>
  <% } %>

  <main id="main-content" tabindex="-1"<% if (usesPortalNavShell) { %> class="admin-main"<% } %>>
    <section class="site-section">
      <div class="site-section-inner">
        <h1>Business Directory</h1>
        <% if (usesPortalNavShell) { %><p><a href="/directory/mine">My Listings</a></p><% } %>
        <p>Businesses owned and run by co-op families.</p>

        <% if (listings.length === 0) { %>
          <p class="roster-empty">No listings yet.</p>
        <% } else { %>
          <div class="event-card-grid">
            <% listings.forEach(function(l) { %>
              <a class="event-card" href="/directory/<%= l.id %>">
                <% if (l.imageUrl) { %>
                  <div class="event-card-image"><img src="<%= l.imageUrl %>" alt="" /></div>
                <% } %>
                <div class="event-card-body">
                  <% if (l.categoryTitle) { %><span class="event-card-date"><svg class="icon"><use href="#icon-tag"/></svg> <%= l.categoryTitle %></span><% } %>
                  <h3><%= l.business_name %></h3>
                  <% if (l.address) { %><p class="event-card-location"><svg class="icon"><use href="#icon-map-pin"/></svg> <%= l.address %></p><% } %>
                </div>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>
