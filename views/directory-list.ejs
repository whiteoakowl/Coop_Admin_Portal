<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="btn-secondary" href="/directory/mine">My Listings</a>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="site-section">
      <div class="site-section-inner">
        <h1>Business Directory</h1>
        <p>Businesses owned and run by co-op families.</p>

        <% if (listings.length === 0) { %>
          <p class="roster-empty">No listings yet.</p>
        <% } else { %>
          <div class="event-card-grid">
            <% listings.forEach(function(l) { %>
              <a class="event-card" href="/directory/<%= l.id %>">
                <% if (l.imageUrl) { %>
                  <div class="event-card-image"><img src="<%= l.imageUrl %>" alt="" /></div>
                <% } %>
                <div class="event-card-body">
                  <% if (l.category) { %><span class="event-card-date"><svg class="icon"><use href="#icon-tag"/></svg> <%= l.category %></span><% } %>
                  <h3><%= l.business_name %></h3>
                  <% if (l.address) { %><p class="event-card-location"><svg class="icon"><use href="#icon-map-pin"/></svg> <%= l.address %></p><% } %>
                </div>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>
