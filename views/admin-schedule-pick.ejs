<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main class="admin-main">
    <p class="subtitle no-print"><a href="/admin/schedule">&larr; All Schedules</a></p>
    <h1>New Schedule</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/admin/schedule/new" class="form-section">
      <label class="roster-checkbox-label" for="schedule-pick-member">Member</label>
      <select id="schedule-pick-member" name="memberId" required class="schedule-pick-select">
        <option value="">Choose a member&hellip;</option>
        <% students.forEach(function(s) { %><option value="<%= s.id %>"><%= s.name %></option><% }); %>
      </select>
      <button type="submit" class="primary-btn">Continue</button>
    </form>
  </main>
</body>
</html>
