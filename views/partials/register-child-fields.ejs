<%
// One repeatable "Child" block on the public self-registration form
// (views/portal-register.ejs) - same clone-a-<template> pattern as
// views/partials/membership-child-fields.ejs (see public/js/
// membership-form.js), reused here via public/js/portal-register-form.js
// so a family fills out parent AND child info once instead of the parent
// registering, then separately re-typing each child's name/grade/etc.
// somewhere else.
//
// Unlike the admin-entered Membership Form, a child block here is fully
// optional (no `required` on name fields) - self-registration must stay
// usable for an account that isn't tied to any currently-enrolled child
// yet, so an empty/removed block is silently dropped server-side
// (routes/portal-auth.js's own children filter) rather than blocking
// submission.
//
// `values` carries back whatever the visitor typed if the whole form
// re-renders after a validation error, so a mistake elsewhere on the
// form doesn't erase children they already filled in.
const v = (typeof values !== 'undefined' && values) || {};
%>
<div class="manage-section register-child-block" data-child-block>
  <%# A real request: "Put double title back but it should say parent/
      guardian #2, #3 etc. Same for children" - back to a per-block
      title, numbered the same way register-adult-fields.ejs's own
      Parent/Guardian blocks are. Unlike those (continuing on from the
      Parent/Guardian section above, implicitly #1), every child lives
      in this one dynamic list with no separate "Child #1" elsewhere on
      the page, so numbering here starts at #1, not #2. Filled in by
      public/js/portal-register-form.js's own renumberChildren() (empty
      here, not computed in EJS) for the same "stays correct after a
      block is removed from the middle of the list" reason given there. %>
  <div class="membership-child-header">
    <h3 data-child-title></h3>
    <button type="button" class="icon-btn register-remove-child" aria-label="Remove child" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
  </div>
  <div class="member-form-grid">
    <%# A real request: "Should be able to upload... student profile
        photos," later sharpened to "Upload photo button should be
        first under the title" - moved up from the bottom of this grid
        to right under this block's own h3. Same single-file-per-block
        convention views/member-intake-form.ejs's own child photo field
        already uses - routes/portal-auth.js's own POST /register
        matches it back to this child by this exact fieldname via
        req.files. %>
    <label class="member-form-full">Photo
      <input type="file" name="children[<%= index %>][photo]" accept="image/*" />
    </label>
    <label>First Name
      <input type="text" name="children[<%= index %>][firstName]" value="<%= v.firstName || '' %>" />
    </label>
    <label>Last Name
      <input type="text" name="children[<%= index %>][lastName]" value="<%= v.lastName || '' %>" />
    </label>
    <label>Birthdate
      <input type="date" name="children[<%= index %>][birthdate]" value="<%= v.birthdate || '' %>" />
    </label>
    <%# A real request: "Should not be able to choose a grade level.
        Remove this options, its only on admin portals and done by the
        system itself through behaviors." A visitor self-registering a
        child never picks a grade level here - Main Admin sets it (and
        the system advances it year over year) once the child is a real,
        approved member. %>
    <label class="member-form-full">Medical / Allergy Notes
      <textarea name="children[<%= index %>][medicalNotes]" rows="2"><%= v.medicalNotes || '' %></textarea>
    </label>
  </div>

  <label class="checkbox-option">
    <input type="checkbox" class="register-child-login-toggle" data-child-login-toggle name="children[<%= index %>][wantsLogin]" <%= v.wantsLogin ? 'checked' : '' %> />
    Give this student their own portal login
  </label>
  <div class="member-form-grid register-child-login-fields" data-child-login-fields <%= v.wantsLogin ? '' : 'hidden' %>>
    <label class="member-form-full">Student Login Email
      <input type="email" name="children[<%= index %>][loginEmail]" value="<%= v.loginEmail || '' %>" autocomplete="off" />
    </label>
    <label>Password
      <input type="password" name="children[<%= index %>][loginPassword]" minlength="8" autocomplete="new-password" />
    </label>
    <label>Confirm Password
      <input type="password" name="children[<%= index %>][loginPasswordConfirm]" minlength="8" autocomplete="new-password" />
    </label>
  </div>
  <% (childFields || []).forEach(function(f) { %>
    <%- include('membership-form-field', { field: f, namePrefix: 'children[' + index + '][customFields]', values: v.customFields }) %>
  <% }); %>
</div>
