<%
// Shared top bar for every portal (Admin, Co-op Admin, Parent, Student) -
// left side is the current-portal pill (portal-switcher.ejs), right side
// is Contact Admins + Profile. Locals isFullAdmin/currentPortalLabel/
// profileHref/profileInitial come from server.js's global res.locals
// middleware, so this never needs anything passed to it explicitly.
// `admin` (optional) offsets it past the fixed admin sidebar on desktop.
%>
<% if (typeof currentPortalLabel !== 'undefined' && currentPortalLabel) { %>
  <header class="portal-topbar<%= typeof admin !== 'undefined' && admin ? ' portal-topbar-admin' : '' %>">
    <div class="portal-topbar-left">
      <span class="portal-topbar-current-label">Current Portal:</span>
      <%- include('portal-switcher') %>
    </div>
    <div class="portal-topbar-right">
      <a class="portal-topbar-contact" href="/contact-admins">
        <svg class="icon"><use href="#icon-mail"/></svg>
        Contact Admins
      </a>
      <a class="portal-topbar-profile" href="<%= profileHref %>">
        <span class="portal-topbar-avatar"><%= profileInitial %></span>
        Profile
      </a>
    </div>
  </header>
<% } %>
