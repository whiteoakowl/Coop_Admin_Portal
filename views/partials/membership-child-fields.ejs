<%
// One repeatable "Child" block - included once for the child already on
// the page (index 0) and once (with index left as the literal placeholder
// __INDEX__) inside membership.ejs's <template>, which
// public/js/membership-form.js clones and re-indexes for every
// "+ Add Child" click.
%>
<div class="manage-section membership-child-block" data-child-block>
  <div class="membership-child-header">
    <h3>Child</h3>
    <button type="button" class="icon-btn membership-remove-child" aria-label="Remove child" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
  </div>
  <div class="member-form-grid">
    <label>First Name
      <input type="text" name="children[<%= index %>][firstName]" required />
    </label>
    <label>Last Name
      <input type="text" name="children[<%= index %>][lastName]" required />
    </label>
    <label>Birthdate
      <input type="date" name="children[<%= index %>][birthdate]" />
    </label>
    <label>Grade
      <select name="children[<%= index %>][gradeLevel]">
        <option value="">Select Grade</option>
        <% gradeOptions.forEach(function(g) { %>
          <option value="<%= g %>"><%= g %></option>
        <% }); %>
      </select>
    </label>
    <label class="member-form-full">Medical / Allergy Notes
      <textarea name="children[<%= index %>][medicalNotes]" rows="2"></textarea>
    </label>
    <label class="member-form-full">Child Photo
      <input type="file" name="children[<%= index %>][photo]" accept="image/*" />
    </label>
  </div>
</div>
