<%# Lesson content items (video/text/file/quiz) - the "drop down of the
    different links and activities" from a real request, shared between
    Co-op Admin's own lesson page and Teacher Portal's own lesson page so
    the two don't drift. basePath is '/admin/class-schedule' or
    '/teacher'; assignment/contentItems come from the including page. %>
<div class="manage-section">
  <div class="grid-box-header">
    <h2>Lesson Details</h2>
  </div>
  <form method="POST" action="<%= basePath %>/assignments/<%= assignment.id %>/edit" class="member-form-grid">
    <label class="member-form-full">Title
      <input type="text" name="title" value="<%= assignment.title %>" required />
    </label>
    <label class="member-form-full">Description
      <textarea name="description" rows="2"><%= assignment.description || '' %></textarea>
    </label>
    <label>Open Date
      <input type="date" name="openDate" value="<%= assignment.open_date || '' %>" />
    </label>
    <div class="member-form-full">
      <button type="submit" class="primary-btn">Save Lesson Details</button>
    </div>
  </form>
</div>

<div class="manage-section">
  <%# A real request: "lesson content says assignments" - renamed from
      "Lesson Content" (the underlying data model - class_assignments/
      lesson_content_items - keeps its own internal names; this is a
      label-only change, same as "Add Content" -> "Add Assignments"
      below). %>
  <div class="grid-box-header">
    <h2>Assignments (<%= contentItems.length %>)</h2>
  </div>
  <% if (contentItems.length === 0) { %>
    <p class="roster-empty">No assignments added yet.</p>
  <% } else { %>
    <div class="roster-scroll">
      <table class="roster-table members-table condensed-table">
        <thead>
          <tr><th></th><th>Type</th><th>Content</th><th></th><th></th></tr>
        </thead>
        <tbody data-content-reorder-tbody data-assignment-id="<%= assignment.id %>" data-reorder-url="<%= basePath %>/assignments/<%= assignment.id %>/content/reorder">
          <% contentItems.forEach(function(item) { %>
            <tr data-content-reorder-row="<%= item.id %>">
              <td class="roster-drag-col"><span data-content-reorder-handle class="lesson-drag-handle" title="Drag to reorder">&#9776;</span></td>
              <td><span class="status-badge status-badge-active"><%= item.type %></span></td>
              <td class="roster-name-col">
                <%= item.title || '(untitled)' %>
                <%# A real request: "the text is formatted row wise should
                    be how it is displayed for parent/student portal
                    view" - that view's own Lessons tab already shows
                    "Due {label}" next to each item's title. %>
                <% if (item.dueDateLabel) { %><div class="hint">Due <%= item.dueDateLabel %></div><% } %>
                <% if (item.type === 'video' && item.video_url) { %><div class="hint"><a href="<%= item.video_url %>" target="_blank" rel="noopener">Video link</a></div><% } %>
                <% if (item.type === 'video' && item.description) { %><div class="hint"><%= item.description %></div><% } %>
                <% if (item.type === 'file' && item.file_url) { %><div class="hint"><a href="<%= item.file_url %>" target="_blank" rel="noopener">File link</a></div><% } %>
                <% if (item.type === 'file' && item.description) { %><div class="hint"><%= item.description %></div><% } %>
                <% if (item.type === 'text' && item.body) { %><div class="hint forum-editable-display"><%- item.body %></div><% } %>
                <% if (item.type === 'quiz') { %><div class="hint"><%= item.questions.length %> question<%= item.questions.length === 1 ? '' : 's' %></div><% } %>
                <% if (item.type === 'assignment_upload') { %>
                  <% if (item.body) { %><div class="hint forum-editable-display"><%- item.body %></div><% } %>
                  <% if (item.attachmentUrl) { %><div class="hint"><a href="<%= item.attachmentUrl %>" target="_blank" rel="noopener"><%= item.attachment_name || 'Attachment' %></a></div><% } %>
                <% } %>
                <% if (item.type === 'assignment_submission') { %>
                  <% if (item.body) { %><div class="hint forum-editable-display"><%- item.body %></div><% } %>
                  <div class="hint"><% if (item.points_possible != null) { %><%= item.points_possible %> points<% } %></div>
                <% } %>
              </td>
              <td>
                <% if (item.type === 'quiz') { %>
                  <a class="roster-action-btn" href="<%= basePath %>/content/<%= item.id %>/questions">Manage Questions</a>
                <% } %>
                <% if (item.type === 'assignment_submission') { %>
                  <a class="roster-action-btn" href="<%= basePath %>/content/<%= item.id %>/submissions">Review Submissions</a>
                <% } %>
              </td>
              <td>
                <form method="POST" action="<%= basePath %>/content/<%= item.id %>/delete" onsubmit="return confirm('Remove this assignment?');">
                  <button type="submit" class="btn-secondary">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="portal-dashboard-card portal-dashboard-card-wide">
    <h3>Add Assignments</h3>
    <form method="POST" action="<%= basePath %>/assignments/<%= assignment.id %>/content" enctype="multipart/form-data" class="member-form-grid" data-toggle-form>
      <label class="member-form-full">Type
        <select name="type" data-toggle-select>
          <option value="video">Link to Video</option>
          <option value="text">Text Description</option>
          <option value="file">Link to File</option>
          <option value="quiz">Quiz (with scoring)</option>
          <option value="assignment_upload">Assignment Upload</option>
          <%# A real request: "there should be a assignment submit option.
              Where i can add a title, description, points, grade and the
              student will see an upload link." Distinct from Assignment
              Upload above (admin posting materials TO students) - this
              one is a student uploading their OWN file back, graded
              afterward from its own Review Submissions page. %>
          <option value="assignment_submission">Assignment Submission</option>
        </select>
      </label>
      <label class="member-form-full">Title
        <input type="text" name="title" />
      </label>
      <%# A real request: "Due dates should be on the assignments, not on
          the lesson" - shared across every content type (not just
          Assignment Submission), so it's outside any data-toggle-field
          block. %>
      <label class="member-form-full">Due Date <span class="hint">(optional)</span>
        <input type="date" name="contentDueDate" />
      </label>
      <label class="member-form-full" data-toggle-field="video">Video URL
        <input type="url" name="videoUrl" placeholder="https://..." />
      </label>
      <%# A real bug report: "if I add an assignment to a class when I save
          it says something went wrong." Every one of this form's five
          content-type sections stays in the DOM at once (CSS display:none
          hides the ones that don't match the selected Type - see
          public/js/lesson-content-form.js - rather than the inactive
          sections' fields being removed), so a plain HTML form submit
          sends every field, selected type or not. video's and file's
          "Description" used to share name="description", and text's
          textarea and assignment_upload's rich-text hidden input used to
          share name="body" - a browser form submit turns each same-named
          pair into a 2-element array server-side (Express/body-parser),
          and routes/admin-class-schedule.js's (and routes/teacher-
          portal.js's identical) POST handler called .trim() or
          sanitizePostBody() on that array expecting a string, throwing on
          every save regardless of which type was actually chosen. Each
          field now has its own unique name; the route reads the one that
          matches the selected type. %>
      <label class="member-form-full" data-toggle-field="video" style="display: none;">Description
        <textarea name="description" rows="2"></textarea>
      </label>
      <label class="member-form-full" data-toggle-field="text" style="display: none;">Description
        <textarea name="body" rows="3"></textarea>
      </label>
      <label class="member-form-full" data-toggle-field="file" style="display: none;">File URL
        <input type="url" name="fileUrl" placeholder="https://..." />
      </label>
      <label class="member-form-full" data-toggle-field="file" style="display: none;">Description
        <textarea name="fileDescription" rows="2"></textarea>
      </label>
      <p class="hint member-form-full" data-toggle-field="quiz" style="display: none;">A blank quiz will be added - add its questions afterward from the "Manage Questions" link.</p>
      <%# A real request: "assignment upload, text box with word count and
          full editing features, also be able to upload a file such as
          doc, pdf, jpg etc." - the exact same rich-text editor ("full
          editing features") the Class Description field above already
          uses, plus a live word count (public/js/assignment-upload-word-
          count.js) and its own file attachment. %>
      <div class="member-form-full" data-toggle-field="assignment_upload" style="display: none;" data-forum-editor>
        <label>Assignment Text</label>
        <%- include('forum-editor-toolbar') %>
        <div class="forum-editable" data-forum-editable data-word-count-source contenteditable="true"></div>
        <input type="hidden" name="assignmentBody" data-forum-body-input />
        <p class="hint"><span data-word-count>0</span> words</p>
      </div>
      <label class="member-form-full" data-toggle-field="assignment_upload" style="display: none;">Attach a File <span class="hint">(doc, pdf, or image)</span>
        <input type="file" name="attachment" accept=".doc,.docx,.pdf,.jpg,.jpeg,.png,.gif,.webp" />
      </label>
      <div class="member-form-full" data-toggle-field="assignment_submission" style="display: none;" data-forum-editor>
        <label>Description</label>
        <%- include('forum-editor-toolbar') %>
        <div class="forum-editable" data-forum-editable contenteditable="true"></div>
        <input type="hidden" name="submissionBody" data-forum-body-input />
      </div>
      <label class="member-form-full" data-toggle-field="assignment_submission" style="display: none;">Points Possible
        <input type="number" name="submissionPointsPossible" min="0" />
      </label>
      <div class="member-form-full">
        <button type="submit" class="primary-btn">Add Assignments</button>
      </div>
    </form>
  </div>
</div>
<script src="/js/lesson-drag-reorder.js"></script>
<script src="/js/lesson-content-form.js"></script>
<script src="/js/assignment-upload-word-count.js"></script>
