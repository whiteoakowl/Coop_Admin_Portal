<%
// Shared by views/partials/admin-nav.ejs and portal-nav.ejs's own mobile
// bottom bar loops - a real request: "the tab should not work on mobile
// until you click the subpage. When you click the orange menu bar at the
// bottom it should show the sub pages to click." A section with
// subpages renders as a <button data-subpages-dialog="..."> instead of a
// plain <a href> here, paired with its own <dialog> (the exact same
// .page-tabs-dialog/.view-tab markup/CSS every per-page popup already
// used, see styles.css's own comment on .page-tabs-dialog[open] -
// docking it to the top of the orange bar was already page-agnostic,
// just never reused at the nav-shell level before) - public/js/page-
// tabs.js wires the button to open it. Always present in the nav shell
// (unlike the old per-page dialogs), so it works from anywhere in this
// portal, not just from the page it's currently on.
//
// One id per link, derived from its own label - stable and unique across
// this one bar's own subpages-bearing items (nothing here has two
// sections sharing a label).
const dialogId = 'mobile-subpages-' + link.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
%>
<button type="button" class="mobile-tab-subpages-trigger" data-subpages-dialog="<%= dialogId %>" data-href="<%= link.href %>"<% if (link.match) { %> data-match="<%= link.match %>"<% } %>>
  <svg class="icon"><use href="#icon-<%= link.icon %>"/></svg><span><%= link.label %></span>
</button>
<dialog class="view-tabs page-tabs-dialog no-print" id="<%= dialogId %>">
  <% link.subpages.forEach(function(sp) { %>
    <a class="view-tab" href="<%= sp.href %>"><%= sp.label %></a>
  <% }); %>
  <button type="button" class="page-tabs-dialog-close" onclick="this.closest('dialog').close()">Close</button>
</dialog>
