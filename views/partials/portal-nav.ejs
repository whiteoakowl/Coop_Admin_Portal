// locals: navLinks ([{href, icon, label}]), portalTitle (e.g. "Parent
// Portal"). portalAccount/portalRoles come from res.locals
// (middleware/portalAuth.js's loadPortalSession) automatically, no
// explicit passing needed. Reuses the exact same .admin-sidebar/
// .admin-mobile-topbar/.admin-mobile-tabs shell the existing Co-op Admin
// Portal already uses (views/partials/admin-nav.ejs) - same visual
// language across every portal, just a different link set and the
// portal switcher below, which only ever appears when there's more than
// one portal to switch between.
// A real request: "Homeschool family management tab on parent portal.
// It needs to become its own portal." Every account holding the real
// 'parent' role now reaches TWO portals (Parent + Family School
// Management) from that one role - routes/portal-auth.js's own
// expandPortalRoles - so "Switch Portal" needs to show for a parent-
// only account too, not just a genuinely multi-role one.
const hasParentRole = typeof portalRoles !== 'undefined' && portalRoles.some(function (r) { return r.key === 'parent'; });
const showSwitcher = typeof portalRoles !== 'undefined' && (portalRoles.length > 1 || hasParentRole);

// A real request: "under main admin portal the users tab should be
// under the settings icon at the top" (and later, Website too) - Main
// Admin's own gear icon now opens its own admin-configuration Settings
// area (partials/main-admin-settings-tabs.ejs's own tab bar, /main-admin/
// settings redirects there) instead of the generic per-account Settings
// page (My Privacy, etc.) every other portal's gear still opens.
// A later real request: "Family school management, settings tab, should
// move to settings gear. Family school management, parent portal have
// the same linked settings gear." - FSM's own Settings tab (it used to
// live in FAMILY_SCHOOL_NAV_LINKS below) moved behind the gear instead,
// same pattern as Main Admin above, and Parent Portal's gear (a parent
// account's other portal for the same role) now opens that same hub too
// rather than the bare generic page, so there's one gear destination for
// both no matter which of the two portals a parent is looking at.
// A further real request: "All portals settings gear. [They] are all now
// the card setup" - Student Portal and Co-op Teacher Portal gained their
// own card-view hub too (routes/portal-auth.js's own /portal/settings-
// hub, views/portal-settings-hub.ejs) rather than opening the bare
// generic page directly.
const settingsHref = portalTitle === 'Main Admin' ? '/main-admin/settings'
  : (portalTitle === 'Family School Management' || portalTitle === 'Parent Portal') ? '/parent/family-school/settings-hub'
  : (portalTitle === 'Student Portal' || portalTitle === 'Co-op Teacher Portal') ? '/portal/settings-hub'
  : '/portal/settings';
// A real bug report: "Student portal, when you click on chat it should
// stay on Student portal" - the same "always guess Parent first" mistake
// sharedPortalTitle now fixes for Chat/Photos (see middleware/portalAuth.js's
// own comment) applies just as much here: My Profile/Settings are the
// SAME /portal/profile, /portal/settings URL no matter which portal's own
// corner renders this link, so a dual-role account clicking either from
// Student Portal used to land back in Parent Portal too. This partial
// already knows which portal it's rendering as (portalTitle, the param
// every caller passes in) - tagging these two corner links with that
// same ?portal=parent|student is enough, no guessing needed at all.
// Co-op Teacher Portal added to this list alongside Parent/Student once
// settingsHref above started giving it its own distinct hub content
// (/portal/settings-hub, resolved via sharedPortalTitle) - without this,
// a dual parent+teacher account's own corner gear link on Co-op Teacher
// Portal carried no query at all, so sharedPortalTitle's own hasParent-
// first precedence would silently resolve it back to the Parent hub
// instead, the exact "always guess Parent first" bug class this whole
// query-tagging mechanism exists to prevent.
const cornerPortalQuery = portalTitle === 'Parent Portal' ? '?portal=parent' : portalTitle === 'Student Portal' ? '?portal=student' : portalTitle === 'Co-op Teacher Portal' ? '?portal=teacher' : '';

// A real request: "On parent, student and teacher portal on mobile add an
// email icon at the top for contacting group leaders. On desktop it says
// contact admins." Main Admin already has every admin department's own
// contact info and isn't who this feature is for, so it's left out here -
// the Co-op Admin portal doesn't render this partial at all.
const showContactAdmins = portalTitle === 'Parent Portal' || portalTitle === 'Student Portal' || portalTitle === 'Co-op Teacher Portal' || portalTitle === 'Family School Management';
// cornerPortalQuery above only ever distinguishes parent vs. student (the
// one ambiguity /portal/profile and settingsHref's shared URLs have) - this
// link's own target (routes/contact-admins.js) needs to know Teacher too,
// since sharedPortalTitle doesn't cover it, so it gets its own query value.
const contactAdminsPortalQuery = portalTitle === 'Parent Portal' || portalTitle === 'Family School Management' ? '?portal=parent' : portalTitle === 'Student Portal' ? '?portal=student' : portalTitle === 'Co-op Teacher Portal' ? '?portal=teacher' : '';

