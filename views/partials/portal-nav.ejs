<%
// locals: navLinks ([{href, icon, label}]), portalTitle (e.g. "Parent
// Portal"). portalAccount/portalRoles come from res.locals
// (middleware/portalAuth.js's loadPortalSession) automatically, no
// explicit passing needed. Reuses the exact same .admin-sidebar/
// .admin-mobile-topbar/.admin-mobile-tabs shell the existing Co-op Admin
// Portal already uses (views/partials/admin-nav.ejs) - same visual
// language across every portal, just a different link set and the
// portal switcher below, which only ever appears when there's more than
// one portal to switch between.
const showSwitcher = typeof portalRoles !== 'undefined' && portalRoles.length > 1;

// A real request: "under main admin portal the users tab should be
// under the settings icon at the top" (and later, Website too) - Main
// Admin's own gear icon now opens its own admin-configuration Settings
// area (partials/main-admin-settings-tabs.ejs's own tab bar, /main-admin/
// settings redirects there) instead of the generic per-account Settings
// page (My Privacy, etc.) every other portal's gear still opens.
const settingsHref = portalTitle === 'Main Admin' ? '/main-admin/settings' : '/portal/settings';

// Main Admin's own primary nav - a real request: "there are many
// duplicate tabs, these should be the tabs and in this order." Every
// views/main-admin-*.ejs/admin-<feature>-*.ejs file used to pass its OWN
// copy of this same list as its own navLinks - 45 separate copies that
// only ever drifted further apart from each other (a feature added or
// reordered in one file with no reason it would ever get applied to the
// other 44), which is exactly what produced the duplicate/inconsistent
// tabs being reported. Defining it once here and using it for every
// Main Admin page regardless of whatever navLinks that page's own call
// site still happens to pass makes that drift structurally impossible
// from here on - whatever's in this one array IS Main Admin's nav,
// everywhere, unconditionally. Trimmed from 19 items down to 14 (Member
// Directory/Newsletter/Notifications/Publications/Audit Log dropped),
// then Publications was added back plus a new Academics tab (diploma +
// transcript creation - see routes/main-admin.js's /academics routes),
// for 16 total. Member Directory/Newsletter/Notifications/Audit Log
// still reachable by their own direct URL, just no longer a standing nav
// tab.
// A real request: "instead of the tabs on each page, make them subpages
// under each menu tab. When you click the menu tab the sub pages
// selection expands" (desktop), and later sharpened to "the tab should
// not work on mobile until you click the subpage" (mobile, see this same
// partial's own mobile-subpages-tab.ejs include below, driven by public/
// js/page-tabs.js) - the EXACT same tab links these pages used to render
// inline, now living once in this shared nav shell instead of scattered
// per page. `link.href` still points at the
// bare top-level page (unchanged - still what the mobile bottom tab bar
// below links to), `subpages` is the same set of tabs each of those
// pages' own route already recognizes via ?tab=; the first entry in each
// list always uses the bare href (no ?tab=) since that's each route's
// own default when no tab query param is present at all, letting
// admin-nav-accordion.js's active-highlighting match on that instead of
// hardcoding each route's own default tab name a second time here.
const MAIN_ADMIN_NAV_LINKS = [
  { href: '/main-admin', icon: 'home', label: 'Home' },
  { href: '/main-admin/members', icon: 'users', label: 'Members', subpages: [
    { href: '/main-admin/members', label: 'Members' },
    { href: '/main-admin/members?tab=approvals', label: 'Approvals' },
    { href: '/main-admin/members?tab=archive', label: 'Archive' },
    { href: '/main-admin/members?tab=settings', label: 'Settings' },
  ] },
  { href: '/main-admin/accounting', icon: 'file-text', label: 'Accounting' },
  { href: '/main-admin/announcements', icon: 'bell', label: 'Communication', subpages: [
    { href: '/main-admin/announcements', label: 'Announcements' },
    { href: '/main-admin/announcements/email', label: 'Email' },
    { href: '/main-admin/announcements/text', label: 'Text' },
    { href: '/main-admin/newsletter', label: 'Newsletter' },
  ] },
  { href: '/main-admin/events', icon: 'calendar-check', label: 'Events', subpages: [
    { href: '/main-admin/events', label: 'Calendar' },
    { href: '/main-admin/events?tab=drafts', label: 'Drafts' },
    { href: '/main-admin/events?tab=requests', label: 'Requests' },
    { href: '/main-admin/events?tab=attendance', label: 'Event Attendance' },
    { href: '/main-admin/events?tab=settings', label: 'Settings' },
  ] },
  { href: '/main-admin/forums', icon: 'users', label: 'Chat', subpages: [
    { href: '/main-admin/forums', label: 'Chat Groups' },
    { href: '/main-admin/forums?tab=archive', label: 'Archive' },
  ] },
  // A real request: "main admin portal, volunteer tab, sub pages
  // committees, sign up list, volunteer list."
  { href: '/main-admin/volunteers', icon: 'users', label: 'Volunteers', subpages: [
    { href: '/main-admin/volunteers', label: 'Committees' },
    { href: '/main-admin/volunteers?tab=signup-lists', label: 'Sign-Up Lists' },
    { href: '/main-admin/volunteers?tab=volunteer-lists', label: 'Volunteer Lists' },
  ] },
  { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags', subpages: [
    { href: '/main-admin/name-tags', label: 'Design' },
    { href: '/main-admin/name-tags?tab=print', label: 'Print' },
    { href: '/main-admin/name-tags?tab=requests', label: 'Requests' },
  ] },
  { href: '/main-admin/photos', icon: 'image', label: 'Photos' },
  { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links', subpages: [
    { href: '/main-admin/resource-links', label: 'Resources' },
    { href: '/main-admin/resource-links?tab=approvals', label: 'Approvals' },
  ] },
  { href: '/main-admin/directory', icon: 'map-pin', label: 'Business Directory', subpages: [
    { href: '/main-admin/directory', label: 'Directory' },
    { href: '/main-admin/directory?tab=requests', label: 'Requests' },
    { href: '/main-admin/directory?tab=archive', label: 'Archive' },
  ] },
  { href: '/main-admin/classifieds', icon: 'tag', label: 'Classifieds', subpages: [
    { href: '/main-admin/classifieds', label: 'Categories' },
    { href: '/main-admin/classifieds?tab=requests', label: 'Requests' },
    { href: '/main-admin/classifieds?tab=archive', label: 'Archive' },
  ] },
  { href: '/main-admin/store', icon: 'tag', label: 'Shop', subpages: [
    { href: '/main-admin/store', label: 'Products' },
    { href: '/main-admin/store?tab=orders', label: 'Orders' },
    { href: '/main-admin/store?tab=archived', label: 'Archived' },
    { href: '/main-admin/store?tab=analytics', label: 'Analytics' },
  ] },
  { href: '/main-admin/forms', icon: 'clipboard-list', label: 'Custom Forms' },
  { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters', subpages: [
    { href: '/main-admin/babysitters', label: 'Babysitter' },
    { href: '/main-admin/babysitters?tab=approvals', label: 'Approvals' },
    { href: '/main-admin/babysitters?tab=settings', label: 'Settings' },
  ] },
  { href: '/main-admin/publications', icon: 'book', label: 'Publications' },
  { href: '/main-admin/academics', icon: 'graduation-cap', label: 'Academics' },
  // Same Training & Learning module as Co-op Admin's own Training tab
  // (routes/main-admin-training.js, shared utils/training.js data) - a
  // real request: "the training tab should also be on main admin
  // portal. the features should be exactly the same." No data-match
  // needed - public/js/admin-nav.js already prefix-matches every sub-page
  // under /main-admin/training/... against this link's own href.
  { href: '/main-admin/training', icon: 'graduation-cap', label: 'Training' },
  // A real request: "there should not be a student portal section. the
  // fun tab should be part of the rest of the dashboard." This used to be
  // its own labeled 2nd section (a separate #class-nav-links group titled
  // "Student Portal", the exact same mechanism Parent/Student Portal use
  // for their own "Co-op Classes"/"Activities" groupings - see
  // classLinks/classLinksTitle below) - now just a normal entry in the
  // flat list like every other tab, same subpages shape (a details/
  // summary group on desktop, a mobile-subpages-tab.ejs popup on mobile).
  { href: '/main-admin/nature-news', icon: 'sprout', label: 'Fun', subpages: [
    { href: '/main-admin/nature-news', label: 'Nature News' },
    { href: '/main-admin/fun/reading-challenge/students', label: 'Student Reading Challenge' },
    { href: '/main-admin/fun/reading-challenge/parents', label: 'Parent Reading Challenge' },
    { href: '/main-admin/fun/games', label: 'Games' },
    { href: '/main-admin/fun/vocabulary-game', label: 'Vocabulary Game' },
  ] },
];
// Parent Portal's own primary nav - a real request: "Parent portal is not
// divided into sections. Tabs are in this order" (the exact 15-tab list
// below), which also killed off Parent Portal's own classLinks "Co-op
// Classes" 2nd section and communityLinks "Community" 3rd section (see
// classLinks/communityLinks further down - both forced to nothing for
// Parent Portal now, same override pattern as Main Admin/Student Portal
// below) - everything folds into this one flat list instead. Same anti-
// drift reasoning as MAIN_ADMIN_NAV_LINKS below - this used to be a
// copy-pasted navLinks+classLinks pair in all 15 views/parent-*.ejs files
// that pass this partial anything (drifting the moment one got edited
// and the others didn't - parent-name-tags.ejs's own copy had already
// drifted, with an extra Name Tags entry none of the others had),
// centralized here the same way once a real restructure request made
// that drift risk concrete. Achievements/Leaderboard dropped from the
// list entirely per that same request ("Achievements and leaderboard are
// buttons in reading challenge page") - they're still reachable at their
// own /parent/achievements and /parent/leaderboard URLs, just as buttons
// on views/parent-reading.ejs now instead of standing nav tabs. Resources
// and Documents are new routes (routes/parent-portal.js's own
// /parent/resources - the same role-scoped utils/resourceLinks.js list
// Student Portal already reads, just for the 'parent' role - and
// /parent/documents, a read-only card grid of the same `documents` table
// Co-op Admin manages, each card linking out to the existing public
// /documents/<token> view rather than duplicating its file-serving code).
const PARENT_NAV_LINKS = [
  { href: '/parent', icon: 'home', label: 'Home' },
  { href: '/events', icon: 'calendar-check', label: 'Events', subpages: [
    { href: '/events', label: 'Browse Events' },
    { href: '/parent/events', label: 'My Event Registrations' },
  ] },
  { href: '/parent/classes', icon: 'graduation-cap', label: 'Co-op Classes', subpages: [
    { href: '/parent/classes', label: 'Class Registration' },
    { href: '/parent/classes/manage', label: 'View/Cancel Classes' },
    { href: '/parent/classes/dashboard', label: 'Class Dashboard' },
    { href: '/name-tag', label: 'Name Tag Form' },
    { href: '/absence', label: 'Absence/Late Form' },
    { href: '/parent/handbook', label: 'Policy Handbook' },
  ] },
  { href: '/forums', icon: 'users', label: 'Chat' },
  { href: '/directory', icon: 'map-pin', label: 'Business Directory' },
  { href: '/classifieds', icon: 'tag', label: 'Classifieds' },
  { href: '/parent/resources', icon: 'book', label: 'Resources' },
  { href: '/parent/documents', icon: 'file-text', label: 'Documents' },
  { href: '/store', icon: 'grid', label: 'Store' },
  { href: '/photos', icon: 'camera', label: 'Photos' },
  { href: '/parent/academics', icon: 'clipboard-list', label: 'Academics' },
  { href: '/parent/babysitters', icon: 'user', label: 'Babysitters' },
  { href: '/parent/library', icon: 'book', label: 'Library' },
  { href: '/parent/reading', icon: 'book', label: 'Reading Challenge' },
  { href: '/accounting', icon: 'check-circle', label: 'Accounting' },
];
// Student Portal's own primary nav - a real request: "dashboard panel
// tabs. They should be these titles and in this order," plus a labeled
// 2nd section "Activities" (see STUDENT_ACTIVITY_LINKS/classLinksTitle
// below). Same anti-drift reasoning as MAIN_ADMIN_NAV_LINKS above -
// this used to be a copy-pasted navLinks array in all 12
// views/student-*.ejs files (drifting the moment one got edited and the
// other 11 didn't), centralized here the same way once a real
// restructure request made that drift risk concrete. Photos moved in
// from the old Community section (now empty for Student Portal, see
// COMMUNITY_LINKS_STUDENT below) since it's now one of these 8 named
// tabs rather than a Community extra; Name Tag dropped from the nav
// entirely (still reachable at its own /student/name-tag URL, just not
// a standing tab - not in the requested list).
const STUDENT_NAV_LINKS = [
  { href: '/student', icon: 'home', label: 'Home' },
  { href: '/events?view=calendar', icon: 'calendar-check', label: 'Calendar', subpages: [
    { href: '/events?view=calendar', label: 'Calendar' },
    { href: '/student/events', label: 'My Event Registrations' },
  ] },
  { href: '/forums', icon: 'users', label: 'Chat' },
  { href: '/student/classes', icon: 'graduation-cap', label: 'Classes' },
  { href: '/student/assignments', icon: 'clipboard-list', label: 'Assignments' },
  { href: '/student/resources', icon: 'book', label: 'Resources' },
  { href: '/photos', icon: 'camera', label: 'Photos' },
  { href: '/student/babysitter', icon: 'user', label: 'Babysitter Profile' },
];
// Section 2, labeled "Activities" (classLinksTitle below) - Achievements
// and Leaderboard used to be sections embedded inside the Reading
// Challenge page itself; a real request to list them as their own tabs
// here split them into their own routes/views (routes/student-portal.js's
// own /student/achievements, /student/leaderboard).
const STUDENT_ACTIVITY_LINKS = [
  { href: '/student/games', icon: 'gamepad', label: 'Games' },
  { href: '/student/pets', icon: 'paw', label: 'Pet' },
  { href: '/student/reading', icon: 'book', label: 'Reading Challenge' },
  { href: '/student/achievements', icon: 'star', label: 'Achievements' },
  { href: '/student/leaderboard', icon: 'trophy', label: 'Leaderboard' },
  { href: '/student/nature-news', icon: 'sprout', label: 'Nature News' },
  { href: '/student/spelling-bee', icon: 'type', label: 'Spelling Bee' },
];
const primaryNavLinks = portalTitle === 'Main Admin' ? MAIN_ADMIN_NAV_LINKS : portalTitle === 'Student Portal' ? STUDENT_NAV_LINKS : portalTitle === 'Parent Portal' ? PARENT_NAV_LINKS : navLinks;

// Optional - only a caller with no forced primaryNavLinks override above
// still gets to pass this (see their own comment). locals.classLinks, not
// `typeof classLinks !== 'undefined'` - that would reference this very
// declaration's own not-yet-initialized `const` binding (a genuine
// ReferenceError from `const`'s temporal dead zone), not the value the
// caller passed. Student Portal forces its own STUDENT_ACTIVITY_LINKS
// above regardless of whatever a page's own call site still passes (same
// override pattern as MAIN_ADMIN_NAV_LINKS above) - its own heading text
// is "Activities" (classLinksTitle, used by the template further down).
// Main Admin and Parent Portal both force null (no 2nd section at all) -
// Main Admin's old "Student Portal" group (just the Fun tab) folded back
// into MAIN_ADMIN_NAV_LINKS above; Parent Portal's old "Co-op Classes"
// group folded into PARENT_NAV_LINKS above per a later real request
// ("Parent portal is not divided into sections").
const classLinks = portalTitle === 'Student Portal' ? STUDENT_ACTIVITY_LINKS : (portalTitle === 'Main Admin' || portalTitle === 'Parent Portal') ? null : (typeof locals.classLinks !== 'undefined' ? locals.classLinks : null);
const classLinksTitle = portalTitle === 'Student Portal' ? 'Activities' : 'Co-op Classes';

// The Community & Commerce feature set (Events, Forums, Store, Business
// Directory, Classifieds, Member Directory, Newsletter, Photos,
// Publications, Custom Forms, Accounting, Notifications) shipped as
// sibling top-level pages, not tabs inside any one portal's own routes -
// see routes/accounting.js's own header comment for why (a hard boundary
// between this build and the pre-existing parent/teacher/student/main-
// admin route files). Every one of them only requires SOME signed-in
// portal account, no specific role, so they belong here - one shared
// list every portal shows - rather than duplicated per navLinks caller.
// A real bug this fixes: none of it was linked from anywhere at all once
// deployed, reachable only by typing the URL directly.
//
// Main Admin gets a DIFFERENT set of hrefs for the same feature names -
// each routes/admin-*.js file (mounted at /main-admin/<feature> in
// server.js) is that feature's own edit/moderate/create panel, not the
// same read-only page every other portal gets. A real request: "all the
// tabs [on Main Admin] should be ways of editing, moderating and creating
// things for the parent, teacher and student portals" - Main Admin
// browsing its own community exactly like a parent would defeats the
// point of being the platform's control center. Audit Log has no
// member-facing equivalent at all (nothing to browse, only to review), so
// it replaces Notifications - a personal per-account inbox with nothing
// to administer - in this list instead of just tacking on a 13th item.
const COMMUNITY_LINKS = [
  { href: '/events', icon: 'calendar-check', label: 'Events' },
  { href: '/forums', icon: 'users', label: 'Chat' },
  { href: '/member-directory', icon: 'user', label: 'Member Directory' },
  { href: '/directory', icon: 'map-pin', label: 'Business Directory' },
  { href: '/classifieds', icon: 'tag', label: 'Classifieds' },
  { href: '/forms', icon: 'clipboard-list', label: 'Forms' },
  { href: '/store', icon: 'grid', label: 'Store' },
  { href: '/newsletter', icon: 'mail', label: 'Newsletter' },
  { href: '/photos', icon: 'camera', label: 'Photos' },
  { href: '/publications', icon: 'file-text', label: 'Publications' },
  { href: '/accounting', icon: 'check-circle', label: 'Accounting' },
  { href: '/notifications', icon: 'bell', label: 'Notifications' },
];
// Parent Portal gets no separate Community section at all (empty array,
// same as Main Admin/Student Portal) - a later real request ("Parent
// portal is not divided into sections. Tabs are in this order") gave an
// exact, exhaustive single flat nav (PARENT_NAV_LINKS above, which is
// where Events/Chat/Business Directory/Classifieds/Store/Photos/
// Accounting - this section's old trimmed COMMUNITY_LINKS_PARENT set -
// all moved to). Member Directory/Newsletter/Publications/Forms/
// Notifications still aren't in that list - same reasoning as before,
// reachable to a parent only if Main Admin links to them from elsewhere
// (e.g. an announcement or the newsletter itself), not as a standing tab.
const COMMUNITY_LINKS_PARENT = [];
// Teacher gets a further-trimmed version - a real request: "teacher
// portal, remove the following tabs. newsletter, forms, store,
// publications, accounting, notifications, member directory, business
// directory, classifieds, events and reports." ("Reports" is Teacher
// Portal's own tab, dropped from its own navLinks array in every
// views/teacher-*.ejs file, not from this shared list.)
const COMMUNITY_LINKS_TEACHER = [
  { href: '/forums', icon: 'users', label: 'Chat' },
  { href: '/photos', icon: 'camera', label: 'Photos' },
];
// Student Portal gets no separate Community section at all (empty
// array, same as Main Admin above) - a real request: "dashboard panel
// tabs. They should be these titles and in this order" gave an exact,
// exhaustive two-section nav (STUDENT_NAV_LINKS + STUDENT_ACTIVITY_LINKS
// above); Calendar/Chat already cover Events/Chat, Photos moved into
// STUDENT_NAV_LINKS itself, and Store isn't in the requested list -
// still reachable at its own /store URL, just no longer a standing tab.
const COMMUNITY_LINKS_STUDENT = [];
// portalTitle is a plain, caller-supplied string ('Main Admin' from every
// views/main-admin-*.ejs and views/admin-<feature>-*.ejs file - the admin
// panels themselves reuse this same partial+shell, see their own
// portalTitle) rather than a role key, so this checks the literal value
// every one of those callers already passes - no new local needed.
//
// Main Admin gets no separate Community section at all (empty array, not
// its own COMMUNITY_ADMIN_LINKS list) - a real request: "this entire 2nd
// section of the main admin portal needs to be removed, the tabs are
// redundant." Every one of Main Admin's own navLinks arrays (one per
// views/main-admin-*.ejs/admin-<feature>-*.ejs file) already lists every
// Community & Commerce feature by its own /main-admin/<feature> edit
// route (Events, Business Directory, Classifieds, Member Directory, Chat,
// Custom Forms, Accounting, Store, Newsletter, Photos, Publications,
// Audit Log) - the old COMMUNITY_ADMIN_LINKS list below duplicated every
// one of them a second time, just with slightly different labels
// ("Forms" vs. "Custom Forms") and the read-only-portal hrefs swapped for
// the same /main-admin/<feature> ones already one section up. Unlike
// Parent/Teacher/Student Portal below, Main Admin's own navLinks were
// never trimmed down to a short "core" set with Community picking up the
// rest - they already ARE the full set, so there's nothing left for a
// second section to add.
const communityLinks =
  portalTitle === 'Main Admin' ? []
    : portalTitle === 'Parent Portal' ? COMMUNITY_LINKS_PARENT
    : portalTitle === 'Teacher Portal' ? COMMUNITY_LINKS_TEACHER
    : portalTitle === 'Student Portal' ? COMMUNITY_LINKS_STUDENT
    : COMMUNITY_LINKS;
%>
<%- include('icon-sprite') %>
<a href="#main-content" class="skip-link">Skip to main content</a>

<aside class="admin-sidebar">
  <a class="brand" href="/portal">
    <img src="/img/logo-owl.png" alt="Sanford Homeschoolers" />
  </a>
  <p class="portal-nav-title"><%= portalTitle %></p>
  <nav id="admin-nav-links">
    <% primaryNavLinks.forEach(function(link) { %>
      <% if (link.subpages && link.subpages.length) { %>
        <details class="admin-nav-group">
          <summary><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg> <%= link.label %> <svg class="icon admin-nav-group-chevron"><use href="#icon-chevron-down"/></svg></summary>
          <div class="admin-nav-subpages">
            <% link.subpages.forEach(function(sp) { %>
              <a href="<%= sp.href %>"><%= sp.label %></a>
            <% }); %>
          </div>
        </details>
      <% } else { %>
        <a href="<%= link.href %>"<% if (link.match) { %> data-match="<%= link.match %>"<% } %>><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg> <%= link.label %></a>
      <% } %>
    <% }); %>
  </nav>
  <% if (classLinks) { %>
    <p class="portal-nav-title"><%= classLinksTitle %></p>
    <nav id="class-nav-links">
      <% classLinks.forEach(function(link) { %>
        <% if (link.subpages && link.subpages.length) { %>
          <details class="admin-nav-group">
            <summary><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg> <%= link.label %> <svg class="icon admin-nav-group-chevron"><use href="#icon-chevron-down"/></svg></summary>
            <div class="admin-nav-subpages">
              <% link.subpages.forEach(function(sp) { %>
                <a href="<%= sp.href %>"><%= sp.label %></a>
              <% }); %>
            </div>
          </details>
        <% } else { %>
          <a href="<%= link.href %>"<% if (link.match) { %> data-match="<%= link.match %>"<% } %>><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg> <%= link.label %></a>
        <% } %>
      <% }); %>
    </nav>
  <% } %>
  <% if (communityLinks.length) { %>
    <p class="portal-nav-title">Community</p>
    <nav id="community-nav-links">
      <% communityLinks.forEach(function(link) { %>
        <a href="<%= link.href %>"><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg> <%= link.label %></a>
      <% }); %>
    </nav>
  <% } %>
  <div class="admin-sidebar-bottom">
    <form method="POST" action="/logout" class="logout-form">
      <button type="submit"><svg class="icon"><use href="#icon-log-out"/></svg> Log out</button>
    </form>
  </div>
</aside>

<%# Corner header: My Profile, Settings, Switch Portal - a real request:
    "Switch portal, profile icon, settings icon should all be top right
    of screen." Settings and Switch Portal used to live at the bottom of
    the left sidebar (.admin-sidebar-bottom, still Log Out's home) -
    moved up here, alongside My Profile, on desktop; the mobile topbar
    below already showed all four together and needs no change.
    My Profile (#icon-user-circle, a plain placeholder - no member
    profile-photo field exists yet) - a real request: "Clicking on the
    profile icon at the top on every portal should be the member's full
    profile membership form so that they can edit it" - distinct from
    settingsHref (the gear icon, account-level settings like My Privacy)
    since this request. Replaces the old Full Screen View toggle, removed
    here along with its script include per "remove full screen button and
    feature from all portal pages" - Kiosk Mode (kiosk-home.ejs) keeps its
    own separate, untouched copy. No search form here (unlike
    admin-nav.ejs's own corner) - that's a Co-op-Admin-only feature. %>
<header class="admin-page-corner-actions no-print">
  <a class="admin-corner-link" href="/portal/profile">
    <svg class="icon"><use href="#icon-user-circle"/></svg>
    My Profile
  </a>
  <a class="admin-corner-link" href="<%= settingsHref %>">
    <svg class="icon"><use href="#icon-gear"/></svg>
    Settings
  </a>
  <% if (showSwitcher) { %>
    <details class="portal-switcher-details">
      <summary><svg class="icon"><use href="#icon-monitor"/></svg> Switch Portal</summary>
      <div class="portal-switcher-menu">
        <a href="/portal">All My Portals</a>
      </div>
    </details>
  <% } %>
</header>

<div class="admin-mobile-topbar">
  <div class="admin-mobile-topbar-row">
    <a class="brand" href="/portal">
      <img src="/img/logo-owl.png" alt="" />
      <%= portalTitle %>
    </a>
    <div class="admin-nav-right admin-nav-right-mobile">
      <a class="admin-nav-right-link" href="/portal/profile" aria-label="My Profile"><svg class="icon"><use href="#icon-user-circle"/></svg></a>
      <a class="admin-nav-right-link" href="<%= settingsHref %>" aria-label="Settings"><svg class="icon"><use href="#icon-gear"/></svg></a>
      <% if (showSwitcher) { %>
        <a class="admin-nav-right-link" href="/portal" aria-label="Switch Portal"><svg class="icon"><use href="#icon-monitor"/></svg></a>
      <% } %>
      <form method="POST" action="/logout" class="logout-form">
        <button type="submit" class="admin-nav-right-link" aria-label="Log out"><svg class="icon"><use href="#icon-log-out"/></svg></button>
      </form>
    </div>
  </div>
</div>

<nav class="admin-mobile-tabs" id="admin-mobile-tabs">
  <% primaryNavLinks.forEach(function(link) { %>
    <% if (link.subpages && link.subpages.length) { %>
      <%- include('mobile-subpages-tab', { link: link }) %>
    <% } else { %>
      <a href="<%= link.href %>"<% if (link.match) { %> data-match="<%= link.match %>"<% } %>><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg><span><%= link.label %></span></a>
    <% } %>
  <% }); %>
  <%# Same classLinks as the desktop sidebar's own #class-nav-links block
      above, appended into this same scrollable bar for the same reason
      communityLinks is below - no room for a second section heading at
      this width. Parent Portal's own Classes entry has subpages (Class
      Registration/Manage Classes/Name Tag Request/Absence-Late Form/
      Policy Handbook - a real request), so this needs the same
      subpages-or-plain-link branch primaryNavLinks above has. %>
  <% if (classLinks) { %>
    <% classLinks.forEach(function(link) { %>
      <% if (link.subpages && link.subpages.length) { %>
        <%- include('mobile-subpages-tab', { link: link }) %>
      <% } else { %>
        <a href="<%= link.href %>"<% if (link.match) { %> data-match="<%= link.match %>"<% } %>><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg><span><%= link.label %></span></a>
      <% } %>
    <% }); %>
  <% } %>
  <%# Same COMMUNITY_LINKS as the desktop sidebar's own #community-nav-links
      block above, appended into this one already-horizontally-scrollable
      bar rather than a second mobile row - there's no room for a second
      section heading at this width, and admin-nav.ejs's own mobile tabs
      already establish "more tabs than fit -> scroll" as this app's one
      mobile-overflow pattern, not something to invent a second version of
      here. %>
  <% communityLinks.forEach(function(link) { %>
    <a href="<%= link.href %>"><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg><span><%= link.label %></span></a>
  <% }); %>
</nav>

<%# Rendered as siblings of #admin-mobile-tabs, not nested inside it - see
    mobile-subpages-dialog.ejs for why (that <nav> is position: fixed with
    its own z-index, which caps any dialog nested inside it). %>
<% primaryNavLinks.forEach(function(link) { %>
  <% if (link.subpages && link.subpages.length) { %>
    <%- include('mobile-subpages-dialog', { link: link }) %>
  <% } %>
<% }); %>
<% if (classLinks) { %>
  <% classLinks.forEach(function(link) { %>
    <% if (link.subpages && link.subpages.length) { %>
      <%- include('mobile-subpages-dialog', { link: link }) %>
    <% } %>
  <% }); %>
<% } %>

<%- include('confirm-dialog') %>

<script src="/js/admin-nav.js"></script>
<script src="/js/skip-link.js"></script>
<script src="/js/confirm-dialog.js"></script>
<%# A real request: "shrink the tabs to be seen fully on mobile view" -
    these two already exist and are loaded for the Co-op Admin Portal's
    own shell (views/partials/admin-nav.ejs), but were never wired in
    here for Main Admin/every other portal that reuses this shell
    instead - both are self-contained, CSS-class-scoped (.view-tabs,
    .roster-btn-row) utilities with nothing Co-op-Admin-specific about
    them, so every portal gets the same "tabs shrink to fit, buttons lay
    out in balanced rows on a phone" behavior Co-op Admin already has. %>
<script src="/js/fit-tabs.js"></script>
<script src="/js/roster-btn-row-grid.js"></script>
<%# A real request: "instead of the tabs on each page, make them subpages
    under each menu tab" (desktop) / "the tab should not work on mobile
    until you click the subpage" (mobile) - admin-nav-accordion.js drives
    the .admin-nav-group <details> above (auto-open + highlight the
    current subpage + exclusive open-one-at-a-time) and this partial's own
    mobile-subpages-tab.ejs dialogs, page-tabs.js wires each
    [data-subpages-dialog] trigger to open its own dialog. Loaded here,
    once, for every portal that shares this partial, same as every other
    script above - both no-op on a page with neither element. %>
<script src="/js/admin-nav-accordion.js"></script>
<script src="/js/page-tabs.js"></script>
