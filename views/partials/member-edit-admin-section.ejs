<%
// A real request: "when you click the edit profile button it should
// look exactly like the membership request form... For the two admin
// portals it will then show an admin only section at the bottom to
// change portals, sections and family." Everything here is an admin-
// only action on an EXISTING member (reassigning their family, which
// Sections they're visible under, which Portal Roles their account
// holds) - deliberately separate from partials/member-edit-fields.ejs
// above it (the part that looks exactly like the public membership
// form) rather than folded into a "Choose a Family" box up top the way
// the public form's own brand-new-member flow uses one, since none of
// this is something either the public form or a self-edit page ever
// touches.
//
// Locals:
//   member, families (with memberCount), memberFamilyId
//   allSections, memberSectionIds (Set)
//   allRoles, portalRoleIds (Set) - only rendered when portalAccount is
//     truthy, same "nothing to grant without an account" reasoning the
//     box this replaced already used
//   portalAccount - null or the account row
//   hasPasswordField - whether the member-edit-fields.ejs box above this
//     one (same page) actually offers a Password field - Main Admin's
//     own edit page does (creating a portal account is Main-Admin-only),
//     Co-op Admin's doesn't, so the "no account yet" hint below points
//     there instead of at a field that isn't on the page.
%>
<div class="manage-section member-form-section-box member-form-section-purple" data-family-box>
  <h2><svg class="icon"><use href="#icon-sliders"/></svg> Admin Settings</h2>

  <label class="member-form-full">Family
    <select name="familyId" data-family-select>
      <option value="">Choose from available families</option>
      <% families.forEach(function(f) { %>
        <option value="<%= f.id %>" <%= memberFamilyId === f.id ? 'selected' : '' %>>The <%= f.name %> Family</option>
      <% }); %>
    </select>
  </label>
  <button type="button" class="btn-secondary member-form-add-family-btn" data-add-family-open>+ Add New Family</button>

  <p><strong>Sections</strong></p>
  <% if (allSections.length === 0) { %>
    <p class="hint">No sections defined yet.</p>
  <% } else { %>
    <div class="grade-pill-grid">
      <% allSections.forEach(function(s) { %>
        <label class="grade-pill"><input type="checkbox" name="sectionIds" value="<%= s.id %>" <%= memberSectionIds.has(s.id) ? 'checked' : '' %> /> <%= s.name %></label>
      <% }); %>
    </div>
  <% } %>

  <p><strong>Portal Roles</strong></p>
  <% if (!portalAccount) { %>
    <% if (typeof hasPasswordField !== 'undefined' && hasPasswordField) { %>
      <p class="hint">No portal account yet - set a password above to create one, then Portal Roles can be granted.</p>
    <% } else { %>
      <p class="hint">No portal account yet - an account has to be created from Main Admin &gt; Users before roles can be granted.</p>
    <% } %>
  <% } else if (allRoles.length === 0) { %>
    <p class="hint">No roles defined yet.</p>
  <% } else { %>
    <div class="grade-pill-grid">
      <% allRoles.forEach(function(r) { %>
        <label class="grade-pill"><input type="checkbox" name="roleIds" value="<%= r.id %>" <%= portalRoleIds.has(r.id) ? 'checked' : '' %> /> <%= r.label %></label>
      <% }); %>
    </div>
  <% } %>
</div>
