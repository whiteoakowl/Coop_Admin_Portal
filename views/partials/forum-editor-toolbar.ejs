<%
// Toolbar for the shared rich-text editor (public/js/forum-editor.js) -
// used well beyond chat now (publications, newsletter, announcements/
// notifications, class/event descriptions - "anywhere there is text," a
// real request). Every button/dropdown here maps to something utils/
// sanitizeHtml.js actually allows to survive - no control offers
// formatting the server would just strip back out. A few toolbar-only
// conveniences that never touch the saved HTML at all (Find & Replace,
// Spellcheck, Fullscreen) have no server-side counterpart to keep in
// sync with.
%>
<div class="forum-editor-toolbar">
  <div class="forum-editor-toolbar-row">
    <button type="button" data-forum-cmd="toggleSource" title="Source">&lt;/&gt;</button>
    <span class="forum-editor-sep"></span>
    <button type="button" data-forum-cmd="undo" title="Undo">&#8630;</button>
    <button type="button" data-forum-cmd="redo" title="Redo">&#8631;</button>
    <span class="forum-editor-sep"></span>
    <button type="button" data-forum-cmd="findReplace" title="Find and Replace">&#128269;</button>
    <button type="button" data-forum-cmd="toggleSpellcheck" title="Toggle Spellcheck" data-forum-toggle>ABC&#10003;</button>
    <span class="forum-editor-sep"></span>
    <button type="button" data-forum-cmd="removeFormat" title="Remove Format">T&times;</button>
  </div>

  <div class="forum-editor-toolbar-row">
    <button type="button" data-forum-cmd="bold" title="Bold"><strong>B</strong></button>
    <button type="button" data-forum-cmd="italic" title="Italic"><em>I</em></button>
    <button type="button" data-forum-cmd="underline" title="Underline"><u>U</u></button>
    <button type="button" data-forum-cmd="strikeThrough" title="Strikethrough"><s>S</s></button>
    <button type="button" data-forum-cmd="subscript" title="Subscript">X<sub>2</sub></button>
    <button type="button" data-forum-cmd="superscript" title="Superscript">X<sup>2</sup></button>
    <span class="forum-editor-sep"></span>
    <button type="button" data-forum-cmd="insertOrderedList" title="Numbered List">1. List</button>
    <button type="button" data-forum-cmd="insertUnorderedList" title="Bullet List">&bull; List</button>
    <button type="button" data-forum-cmd="outdent" title="Decrease Indent">&#8676;</button>
    <button type="button" data-forum-cmd="indent" title="Increase Indent">&#8677;</button>
    <button type="button" data-forum-cmd="formatBlock" data-forum-value="blockquote" title="Quote">&ldquo;Quote&rdquo;</button>
  </div>

  <div class="forum-editor-toolbar-row">
    <button type="button" data-forum-cmd="justifyLeft" title="Align Left">&#8676;&#8801;</button>
    <button type="button" data-forum-cmd="justifyCenter" title="Align Center">&#8801;</button>
    <button type="button" data-forum-cmd="justifyRight" title="Align Right">&#8801;&#8677;</button>
    <button type="button" data-forum-cmd="justifyFull" title="Justify">&#8801;&#8801;</button>
    <button type="button" data-forum-cmd="toggleDirection" title="Text Direction (Left-to-Right / Right-to-Left)">&#8596;</button>
    <span class="forum-editor-sep"></span>
    <button type="button" data-forum-cmd="createLink" title="Insert Link">&#128279;</button>
    <button type="button" data-forum-cmd="unlink" title="Remove Link">&#128279;&times;</button>
    <button type="button" data-forum-cmd="insertImage" title="Insert Image">&#128247;</button>
    <button type="button" data-forum-cmd="insertTable" title="Insert Table">&#8862;</button>
    <button type="button" data-forum-cmd="insertHorizontalRule" title="Horizontal Line">&mdash;</button>
    <button type="button" data-forum-cmd="insertSymbol" title="Special Character / Emoji">&#9786;&#937;</button>
  </div>

  <div class="forum-editor-toolbar-row forum-editor-toolbar-row-dropdowns">
    <select data-forum-cmd="formatBlock" title="Styles">
      <option value="">Styles</option>
      <option value="p">Paragraph</option>
      <option value="h1">Heading 1</option>
      <option value="h2">Heading 2</option>
      <option value="h3">Heading 3</option>
      <option value="h4">Heading 4</option>
      <option value="pre">Preformatted</option>
    </select>
    <select data-forum-cmd="fontName" title="Font">
      <option value="">Font</option>
      <option value="Arial, sans-serif">Arial</option>
      <option value="Georgia, serif">Georgia</option>
      <option value="'Courier New', monospace">Courier New</option>
      <option value="Tahoma, sans-serif">Tahoma</option>
      <option value="'Times New Roman', serif">Times New Roman</option>
      <option value="Verdana, sans-serif">Verdana</option>
    </select>
    <select data-forum-cmd="fontSize" title="Size">
      <option value="">Size</option>
      <option value="1">Small</option>
      <option value="3">Normal</option>
      <option value="5">Large</option>
      <option value="7">Huge</option>
    </select>
    <label class="forum-editor-color" title="Text Color">A
      <input type="color" data-forum-cmd="foreColor" value="#000000" />
    </label>
    <label class="forum-editor-color forum-editor-color-bg" title="Background Color">&#9635;
      <input type="color" data-forum-cmd="hiliteColor" value="#ffff00" />
    </label>
    <span class="forum-editor-sep"></span>
    <button type="button" data-forum-cmd="toggleFullscreen" title="Fullscreen">&#10021;</button>
  </div>

  <div class="forum-editor-popup" data-forum-popup="symbol" hidden>
    <%
      // Literal characters, not HTML-entity source strings - so
      // rendering the attribute/label with normal EJS output-escaping
      // just outputs the character itself, not a double-escaped entity.
      var symbolChoices = ['©','®','™','°','§','¶','…','—','•','←','→','↑','↓','✓','✗','😀','👍','👎','🎉','❗','✅','🔔','📝','📅','★','❤️','💡'];
    %>
    <% symbolChoices.forEach(function(ch) { %>
      <button type="button" class="forum-editor-symbol-btn" data-forum-symbol="<%= ch %>"><%= ch %></button>
    <% }); %>
  </div>

  <div class="forum-editor-popup forum-editor-findreplace" data-forum-popup="findreplace" hidden>
    <input type="text" placeholder="Find" data-forum-find />
    <input type="text" placeholder="Replace with" data-forum-replace />
    <button type="button" data-forum-do-replace>Replace All</button>
  </div>
</div>
