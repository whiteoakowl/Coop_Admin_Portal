<%
// locals: type ('setupCleanup' | 'custom'), label, badges (rows from
// listMiscBadges), basePath (optional, default '/admin/design' - Main
// Admin's own Design/Print page passes '/main-admin/name-tags' so this
// exact partial can be reused unmodified there too, same basePath
// parameterization pattern as name-tag-editor.js's own BASE_PATH).
// Import always replaces the whole list for this type; Print with
// nothing checked prints every badge, checking rows prints just those
// (see routes/admin-misc-badges.js). Setup/Cleanup badges are no longer
// a separately admin-imported deck - each one is created/kept in sync
// automatically from the Task List (Setup/Cleanup > Tasks tab; see
// utils/taskList.js's addItem/updateItem and misc_badges' own
// task_item_id schema comment), so Import/Sample File only ever render
// for 'custom', which is still its own independent imported list.
const isTaskDerived = type === 'setupCleanup';
const badgeBasePath = typeof basePath !== 'undefined' && basePath ? basePath : '/admin/design';
%>
<form method="POST" action="<%= badgeBasePath %>/badges/<%= type %>/print" target="_blank" id="<%= type %>-badge-print-form" data-bulk-print-refresh>
  <div class="roster-toolbar no-print">
    <div class="schedule-filters">
      <label class="checkbox-option schedule-print-select-all">
        <input type="checkbox" class="<%= type %>-badge-select-all-checkbox" />
        Select All
      </label>
    </div>
    <div class="roster-btn-row">
      <% if (!isTaskDerived) { %>
        <button type="button" class="roster-action-btn file-action-btn" onclick="document.getElementById('<%= type %>-badge-import-dialog').showModal()">Import</button>
        <a class="roster-action-btn file-action-btn" href="<%= badgeBasePath %>/badges/<%= type %>/import-template.xlsx">Sample File</a>
      <% } %>
      <button type="submit" class="primary-btn">Print</button>
    </div>
  </div>

  <% if (badges.length === 0) { %>
    <p class="hint"><%= isTaskDerived ? 'No tasks added to the Task List yet - add one under Setup/Cleanup > Tasks.' : `No ${label} badges imported yet.` %></p>
  <% } else { %>
    <div class="member-picker-list">
      <% badges.forEach(function(b) { %>
        <label class="member-picker-row">
          <input type="checkbox" name="badgeIds" value="<%= b.id %>" />
          <span><%= b.badge_number ? '#' + b.badge_number + ' — ' : '' %><%= b.title || 'Untitled' %></span>
          <% if (b.description) { %><span class="hint"><%= b.description %></span><% } %>
          <%# Only for 'custom' badges - a setupCleanup badge is auto-
              created/kept in sync from the Task List (see isTaskDerived
              above), so deleting one here directly would desync it from
              its own task_item_id link with no way to recreate it except
              re-saving that task. The route itself (POST /admin/design/
              badges/:type/delete/:id) was already fully implemented but
              had no way to reach it from this panel at all - a real bug,
              since that left no way to remove a single custom badge
              short of re-importing the entire list without it. %>
          <% if (!isTaskDerived) { %>
            <button
              type="button"
              class="icon-btn icon-btn-danger"
              onclick="document.getElementById('<%= type %>-badge-delete-form-<%= b.id %>').requestSubmit()"
              aria-label="Delete <%= b.title || 'this badge' %>"
              title="Delete"
            ><svg class="icon"><use href="#icon-trash"/></svg></button>
          <% } %>
        </label>
      <% }); %>
    </div>
  <% } %>
</form>

<%# Standalone, deliberately OUTSIDE the print form above (line 13) - an
    HTML <form> nested inside another <form> is invalid and gets silently
    dropped by the browser's own parser (the element never actually makes
    it into the live DOM at all, even though it's right there in the raw
    server-rendered HTML), the same reason every other per-row delete form
    in this app (e.g. views/admin-members.ejs's own delete-form-<id>) is
    always its own top-level form, not nested inside a bigger one. %>
<% if (!isTaskDerived) { %>
  <% badges.forEach(function(b) { %>
    <form
      method="POST"
      action="<%= badgeBasePath %>/badges/<%= type %>/delete/<%= b.id %>"
      id="<%= type %>-badge-delete-form-<%= b.id %>"
      data-confirm="Delete &quot;<%= b.title || 'this badge' %>&quot;? This cannot be undone."
    ></form>
  <% }); %>
<% } %>

<% if (!isTaskDerived) { %>
  <dialog id="<%= type %>-badge-import-dialog" class="member-picker-dialog">
    <form method="POST" action="<%= badgeBasePath %>/badges/<%= type %>/import" enctype="multipart/form-data">
      <h3>Import <%= label %> Badges</h3>
      <a class="btn-secondary import-sample-link" href="<%= badgeBasePath %>/badges/<%= type %>/import-template.xlsx">Download Sample File</a>
      <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
        <button type="submit" class="primary-btn">Import</button>
      </div>
    </form>
  </dialog>
<% } %>
