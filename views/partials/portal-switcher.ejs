<%
// Pill showing the current portal, always rendered as a real dropdown -
// a member holding more than one portal (e.g. Co-op Admin + Parent) can
// jump between them without logging out; the master Admin account (or a
// single-portal member) just sees their one portal as the only option.
var roles = typeof portalRoles !== 'undefined' && portalRoles.length > 0 ? portalRoles : null;
%>
<% if (roles) { %>
  <form method="POST" action="/portal/switch-role" class="portal-switcher-pill portal-switcher-pill-interactive">
    <svg class="icon"><use href="#icon-users"/></svg>
    <select name="role" onchange="this.form.submit()" aria-label="Switch portal">
      <% roles.forEach(function(r) { %>
        <option value="<%= r %>" <%= portalRole === r ? 'selected' : '' %>>
          <%= r === 'coop_admin' ? 'Co-op Admin' : r === 'parent' ? 'Parent Portal' : 'Student Portal' %>
        </option>
      <% }); %>
    </select>
    <svg class="icon"><use href="#icon-chevron-down"/></svg>
  </form>
<% } else if (typeof currentPortalLabel !== 'undefined' && currentPortalLabel) { %>
  <span class="portal-switcher-pill portal-switcher-pill-interactive">
    <svg class="icon"><use href="#icon-users"/></svg>
    <select aria-label="Current portal">
      <option><%= currentPortalLabel %></option>
    </select>
    <svg class="icon"><use href="#icon-chevron-down"/></svg>
  </span>
<% } %>
