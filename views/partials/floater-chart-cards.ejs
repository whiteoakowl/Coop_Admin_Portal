<%
// The live, editable Floater Assignments chart - one card per hour (2x2,
// matching the Archive print layout), each card's rows drawn straight
// from substituteBoard: every permanent job (filled or not) plus one row
// per class's missing teacher/assistant - a class with two people out
// that hour lists twice, each row tagged with who it's covering for (see
// slot.reason below). The Floater column is the assign UI itself (no
// separate "needs a substitute" section) - a plain dropdown of whoever's
// actually free this date and not already covering another slot this
// same hour (rank-sorted, but never pre-picked - a real request: "don't
// suggest floaters. just offer the drop down menu of choices that aren't
// already assigned" - see routes/admin-volunteers.js) plus an
// Assign/Unassign button. Locals: day, dayLabel, selectedDate,
// hourSections.
//
// A real request: "floater printing. each page should have a header,
// each page should be an hour that fits to page." On screen this stays
// the existing 2x2 .floater-chart-cards-grid, but each hour is now
// wrapped in its own .floater-print-page - print-only CSS (styles.css)
// turns the grid to one column and page-breaks before every wrapper but
// the first, and each wrapper carries its own repeated, print-only
// .print-header (hidden on screen, same class/markup every other
// print-capable page uses) so a printed set of hour pages doesn't rely
// on a single top-of-document header landing on just one of them.
var FLOATER_ACCENTS = ['blue', 'green', 'orange', 'purple'];
%>
<% if (hourSections.length === 0) { %>
  <p class="roster-empty">Add a position above first (e.g. Front Desk, Hallway Monitor).</p>
<% } else { %>
  <div class="floater-cards-grid floater-chart-cards-grid">
    <% hourSections.forEach(function(hour, idx) { %>
      <% var accent = FLOATER_ACCENTS[idx % FLOATER_ACCENTS.length]; %>
      <div class="floater-print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub"><%= dayLabel %> Floater Assignments</p>
        </div>
      </div>
      <div class="floater-card floater-card-<%= accent %>">
        <div class="floater-card-header">
          <span class="floater-card-icon"><svg class="icon"><use href="#icon-clock"/></svg></span>
          <h3><%= hour.label %></h3>
          <%# A real request: "click the check boxes on each assignment
              or the whole card." Only meaningful (and only ever shown)
              once at least one position this hour is actually assigned
              - public/js/floater-text-notify.js wires this to check/
              uncheck every .floater-notify-checkbox in this one card.
              A later real request: "Send text button on hour title bar...
              when you click send text on title bar it will create a
              pop up" - a dedicated per-hour shortcut, always available
              (not gated behind the page-level Text Notification toggle
              the way Select All is), straight to the same compose popup
              pre-filled with every assigned position this hour. %>
          <% if (hour.slots.some(function (s) { return s.assigned; })) { %>
            <label class="floater-card-select-all no-print">
              <input type="checkbox" class="floater-card-select-all-checkbox" aria-label="Select all floaters for <%= hour.label %>" />
              Select All
            </label>
            <button type="button" class="floater-card-send-text-btn no-print" aria-label="Send a text to everyone assigned for <%= hour.label %>">Send Text</button>
          <% } %>
        </div>
        <table class="floater-card-table floater-chart-table">
          <thead><tr><th class="floater-notify-col no-print">Text</th><th>Position</th><th>Room</th><th>Floater</th></tr></thead>
          <tbody>
            <% hour.slots.forEach(function(slot) { %>
              <% var isApproved = slot.assigned && slot.assigned.status === 'approved'; %>
              <tr class="<%= slot.noneAvailable ? 'floater-row-noavail' : '' %>">
                <td class="floater-notify-col no-print">
                  <% if (slot.assigned) { %>
                    <input type="checkbox" class="floater-notify-checkbox" aria-label="Text <%= slot.assigned.name %> about <%= slot.label %>"
                      data-member-id="<%= slot.assigned.id %>"
                      data-position="<%= slot.label %>"
                      data-room="<%= slot.room || '' %>"
                      data-hour="<%= hour.label %>" />
                  <% } %>
                </td>
                <td class="floater-card-position">
                  <%= slot.label %>
                  <% if ((slot.slotType === 'class' || slot.slotType === 'vacancy') && slot.reason) { %><span class="floater-slot-reason"><%= slot.reason %></span><% } %>
                </td>
                <td><%= slot.room || '—' %></td>
                <td>
                  <% if (slot.noneAvailable) { %>
                    <select disabled class="floater-select-noavail" aria-label="No available floaters for <%= slot.label %>">
                      <option>No available floaters</option>
                    </select>
                  <% } else { %>
                    <form method="POST" class="floater-assign-form" action="/admin/volunteers/<%= day %>/substitutes/<%= isApproved ? 'unassign' : 'assign' %>?semesterId=<%= typeof semesterId !== 'undefined' ? semesterId : '' %>">
                      <input type="hidden" name="date" value="<%= selectedDate %>" />
                      <input type="hidden" name="slotType" value="<%= slot.slotType %>" />
                      <input type="hidden" name="slotId" value="<%= slot.slotId %>" />
                      <input type="hidden" name="isOverride" value="1" />
                      <select name="memberId" required <%= isApproved ? 'disabled' : '' %>>
                        <% if (!slot.assigned) { %><option value="" selected disabled>Select a floater…</option><% } %>
                        <% slot.candidates.forEach(function(c) { %>
                          <option value="<%= c.id %>" <%= slot.assigned && slot.assigned.id === c.id ? 'selected' : '' %><% if (c.checkedIn) { %> class="floater-option-checked-in"<% } %>>
                            <%= c.name %> (<%= c.rankLabel || 'Available' %><% if (c.assignedHourCount > 0) { %>, <%= c.assignedHourCount %><% } %><% if (c.infant) { %>, infant<% } %>)
                          </option>
                        <% }); %>
                      </select>
                      <button type="submit" class="floater-assign-btn<%= isApproved ? ' floater-assign-btn-unassign' : '' %>"><%= isApproved ? 'Unassign' : 'Assign' %></button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <div class="floater-card-footer">
          <svg class="icon"><use href="#icon-users"/></svg>
          <%= hour.slots.length %> Position<%= hour.slots.length === 1 ? '' : 's' %>
        </div>
      </div>
      </div>
    <% }); %>
  </div>
<% } %>
