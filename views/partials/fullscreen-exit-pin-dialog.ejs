<%# A real request: "there should be a code request to exit full screen
    mode" - so a device left running in full screen (e.g. a check-in
    station) can't be knocked out of it by one stray tap on the Exit Full
    Screen button. Reuses the shared Class Check-In PIN rather than a
    separate secret (public/js/fullscreen-toggle.js posts it to
    routes/admin.js's POST /admin/fullscreen/verify-pin). Loaded once per
    page alongside the Full Screen buttons themselves (see admin-nav.ejs)
    - pressing Esc still exits full screen instantly with no way for any
    page's JS to intercept that (a deliberate browser security guarantee,
    not something this dialog can close), so this only ever gates the
    app's own Exit Full Screen button/icon.

    verifyPinUrl (optional, defaults to the authenticated-admin route
    above) - the kiosk (views/kiosk-home.ejs) is deliberately
    unauthenticated, so it passes its own equivalent, unauthenticated
    route (routes/kiosk.js's own POST /kiosk/fullscreen/verify-pin)
    instead - see that route's own comment. data-verify-url carries it to
    fullscreen-toggle.js, which has no other way to know which of the two
    routes the page it's running on actually needs. %>
<dialog id="fullscreen-exit-pin-dialog" class="confirm-dialog" data-verify-url="<%= typeof verifyPinUrl !== 'undefined' ? verifyPinUrl : '/admin/fullscreen/verify-pin' %>">
  <div class="confirm-dialog-icon"><svg class="icon"><use href="#icon-minimize"/></svg></div>
  <p class="confirm-dialog-message">Enter the Class Check-In PIN to exit Full Screen View.</p>
  <form method="POST" action="<%= typeof verifyPinUrl !== 'undefined' ? verifyPinUrl : '/admin/fullscreen/verify-pin' %>">
    <%# A real request: "add a centered number keypad to type in the
        code" - public/js/kiosk-pin-keypad.js's initPinKeypad builds the
        display + digit grid below and writes into this input, same
        pattern every other kiosk scan screen's own ID keypad already
        uses (see kiosk-id-keypad.js). visually-kiosk-hidden (not the
        `hidden` attribute - see that class's own comment) rather than
        removed - it's still the one thing the form actually submits, and
        still real enough (typeable, and required/pattern/maxlength still
        enforced) for a physical keyboard, or plain HTML5 validation, to
        work as a fallback if the keypad script somehow doesn't load. %>
    <input
      id="fullscreen-exit-pin-input"
      name="pin"
      type="password"
      inputmode="numeric"
      pattern="[0-9]{4}"
      maxlength="4"
      autocomplete="off"
      required
      class="visually-kiosk-hidden"
    />
    <div id="fullscreen-exit-pin-keypad" class="kiosk-scan-col"></div>
    <p class="hint" id="fullscreen-exit-pin-error" role="alert" hidden></p>
    <div class="notes-dialog-actions">
      <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
      <button type="submit" class="primary-btn">Exit Full Screen</button>
    </div>
  </form>
</dialog>
