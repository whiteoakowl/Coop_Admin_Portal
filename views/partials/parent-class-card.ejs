<%# Shared class card, used by both parent-classes.ejs's grid view (one
    per grid cell) and its list view (one per flattened, time-sorted row)
    - a real request: "add icons at the top for grid view vs list view
    of classes". locals: cls, day, view, enrolledClassIds. %>
<button
  type="button"
  class="class-card class-card-clickable"
  style="border-left-color: <%= cls.color %>; background: color-mix(in srgb, <%= cls.color %> 42%, white);"
  data-view-class="<%= cls.id %>"
  data-view-class-day="<%= day %>"
  data-class-grade-list="<%= (cls.age_group || '').split(',').map(function(g) { return g.trim(); }).filter(Boolean).join(',') %>"
>
  <%# A real request: "the class image should show on
      the left side of the class card on the parent
      and student portal" - .class-card-thumb-row
      wraps the card's existing content so the photo
      (when this class has one) sits to its left; a
      class with no photo just renders the content
      div alone, same as before this change.
      A later real request: "image shouldn't show on the parent dashboard
      class schedule grids or co-op admin portal class schedule grids -
      it's only viewable when you click on the class or in class list
      view" - the image is gated to List view specifically now; the Room
      x Hour schedule Grid above (view === 'grid', the same shared card)
      never shows it, keeping each already-narrow grid cell free for just
      the title/teacher/room text it had before the photo feature. The
      class detail popup (parent-class-fragment.ejs) already shows the
      photo on its own, unaffected by this. %>
  <div class="class-card-thumb-row">
    <% if (cls.classImageUrl && view === 'list') { %>
      <img class="class-card-thumb" src="<%= cls.classImageUrl %>" alt="" />
    <% } %>
    <div class="class-card-thumb-content">
      <div class="class-card-header">
        <h3><%= cls.class_name %></h3>
        <% if (enrolledClassIds.indexOf(cls.id) !== -1) { %>
          <span class="badge-pill badge-pill-present" title="One of your children is enrolled">Registered</span>
        <% } %>
      </div>
      <div class="class-card-info">
        <% if (view === 'list') { %><p class="class-card-line"><span class="class-card-line-label">Time:</span> <%= cls.start_time || '?' %>&ndash;<%= cls.end_time || '?' %></p><% } %>
        <% if (cls.gradeLabel) { %><p class="class-card-line"><%= cls.gradeLabel %></p><% } %>
        <p class="class-card-line"><span class="class-card-line-label">Teacher:</span> <%= cls.teacherNames.length ? cls.teacherNames.join(', ') : '—' %></p>
        <%# A real request: "room: ... should not be on each class card on
            the grid. It's already the 1st column of titles" - Grid view
            (parent-classes.ejs) lays classes out in a Room x Hour table
            with the room as each row's own header, so repeating it again
            on every card in that row was redundant. List view has no such
            row header (one flat row per class, see that file's own
            comment) - Room still only shows there. %>
        <% if (cls.room && view === 'list') { %><p class="class-card-line"><span class="class-card-line-label">Room:</span> <%= cls.room %></p><% } %>
      </div>
    </div>
  </div>
</button>
