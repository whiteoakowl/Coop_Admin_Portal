<%
// One card per Setup/Cleanup team, listing its members and (editable
// mode only) which of that team's own linked task list items each one
// should do - mirrors partials/floater-assignment-cards.ejs's per-hour
// card look, just per-team instead. Shared by the live Assignments page
// (editable, day+date passed for the save form's action) and the
// read-only Archive fragment/print for a past date (editable=false,
// plain text instead of a dropdown - matches floater-assignment-
// cards.ejs's own "reassigning happens on the live tab, not here" rule).
//
// A real request: a card starts FROZEN (plain "Task 1"/"Task 2" text,
// no dropdowns) - clicking its own "Edit" button (public/js/setup-
// assignment-cards.js) is what reveals the dropdowns for every member on
// THAT card, "Save" submits all of them together in one request (routes/
// admin-setup.js's .../team/:teamId/save), "Cancel" resets the form
// (and hides the dropdowns again) without saving anything. Both the
// static text and the <select> for every slot are always in the DOM -
// the JS just toggles a class on the card - rather than building either
// with client-side fetch, so print/no-JS still shows a real value.
//
// Locals: cards (routes/admin-setup.js's assignmentCardsForDate), day,
// selectedDate, editable (defaults true).
var FLOATER_ACCENTS = ['blue', 'green', 'orange', 'purple'];
var isEditable = typeof editable === 'undefined' ? true : editable;
%>
<% if (cards.length === 0) { %>
  <p class="roster-empty">No teams yet &mdash; create one on the Setup/Cleanup Teams tab.</p>
<% } else { %>
  <div class="floater-cards-grid">
    <% cards.forEach(function(team, idx) { %>
      <% var accent = FLOATER_ACCENTS[idx % FLOATER_ACCENTS.length]; %>
      <div class="floater-card floater-card-<%= accent %>">
        <div class="floater-card-header">
          <span class="floater-card-icon"><svg class="icon"><use href="#icon-broom"/></svg></span>
          <h3><%= team.title %></h3>
          <% if (isEditable) { %>
            <%
              // Deliberately NOT using the plain `hidden` HTML attribute
              // here for the initially-hidden Cancel/Save buttons -
              // Chromium's own UA stylesheet applies [hidden] as if
              // !important, which beats even a higher-specificity author
              // rule trying to override it once .setup-card-editing is
              // added (confirmed live: the class landed correctly, but
              // getComputedStyle still reported display:none). CSS alone
              // (.floater-card-header-actions [data-save-card] below)
              // does the showing/hiding instead, with no attribute to
              // fight with.
            %>
            <div class="floater-card-header-actions no-print">
              <button type="button" class="condensed-btn" data-edit-card>Edit</button>
              <button type="button" class="condensed-btn btn-secondary" data-cancel-card>Cancel</button>
              <button type="submit" form="setup-card-form-<%= team.id %>" class="condensed-btn" data-save-card>Save</button>
            </div>
          <% } %>
        </div>
        <% if (isEditable) { %>
          <form method="POST" action="/admin/setup/<%= day %>/assignments/team/<%= team.id %>/save" id="setup-card-form-<%= team.id %>">
            <input type="hidden" name="date" value="<%= selectedDate %>" />
        <% } %>
        <table class="floater-card-table setup-assignment-table">
          <thead>
            <tr><th>Member</th><th>Task 1</th><th>Task 2</th></tr>
          </thead>
          <tbody>
            <% if (team.members.length === 0) { %>
              <tr><td colspan="3" class="roster-empty">No members yet.</td></tr>
            <% } %>
            <% team.members.forEach(function(m) { %>
              <tr>
                <td class="floater-card-position"><%= m.name %></td>
                <%
                  var slots = [
                    { num: 1, taskItemId: m.taskItemId, taskDescription: m.taskDescription, options: m.slot1Options },
                    { num: 2, taskItemId: m.taskItemId2, taskDescription: m.taskDescription2, options: m.slot2Options },
                  ];
                %>
                <% slots.forEach(function(slot) { %>
                  <td>
                    <% if (isEditable) { %>
                      <span class="setup-task-static"><%= slot.taskDescription || '—' %></span>
                      <select
                        name="task_<%= slot.num %>_<%= m.id %>"
                        class="setup-task-select"
                        form="setup-card-form-<%= team.id %>"
                      >
                        <option value="">&mdash; No suggestion &mdash;</option>
                        <% slot.options.forEach(function(item) { %>
                          <option value="<%= item.id %>" <%= slot.taskItemId === item.id ? 'selected' : '' %>>#<%= item.number %> &mdash; <%= item.description %></option>
                        <% }); %>
                      </select>
                      <% if (slot.num === 1 && team.taskOptions.length === 0) { %><p class="hint">No task list linked to this team yet.</p><% } %>
                    <% } else if (slot.taskDescription) { %>
                      <%= slot.taskDescription %>
                    <% } else { %>
                      <span class="floater-card-unassigned">No suggestion</span>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% if (isEditable) { %></form><% } %>
        <div class="floater-card-footer">
          <svg class="icon"><use href="#icon-users"/></svg>
          <%= team.members.length %> Member<%= team.members.length === 1 ? '' : 's' %>
        </div>
      </div>
    <% }); %>
  </div>
  <% if (isEditable) { %>
    <script src="/js/setup-assignment-cards.js"></script>
  <% } %>
<% } %>
