<%
// One card per Setup/Cleanup team, listing its members and (editable
// mode only) an Assign/Unassign control per member per task slot -
// mirrors partials/floater-assignment-cards.ejs's per-hour card look,
// just per-team instead. Shared by the live Assignments page (editable,
// day+date passed for each slot's own form action) and the read-only
// Archive fragment/print for a past date (editable=false, plain text
// instead of a control - matches floater-assignment-cards.ejs's own
// "reassigning happens on the live tab, not here" rule).
//
// A real request: this should "look and work like Floater Assignments" -
// a suggested-task dropdown next to an Assign button; clicking Assign
// posts immediately and locks that ONE slot (plain text + an Unassign
// button takes the dropdown's place), clicking Unassign frees it back up
// for a different, not-yet-taken pick. Both directions post to routes/
// admin-setup.js's same /assignments/:memberId/task route Floater's own
// assign/unassign pair mirrors - Assign with a real taskItemId, Unassign
// with none. No whole-card Edit/Save step and no client-side JS at all,
// same as Floater's own floater-chart-cards.ejs - every action is its own
// small form that round-trips on submit.
//
// Locals: cards (routes/admin-setup.js's assignmentCardsForDate), day,
// selectedDate, editable (defaults true).
var FLOATER_ACCENTS = ['blue', 'green', 'orange', 'purple'];
var isEditable = typeof editable === 'undefined' ? true : editable;
%>
<% if (cards.length === 0) { %>
  <p class="roster-empty">No teams yet &mdash; create one on the Setup/Cleanup Teams tab.</p>
<% } else { %>
  <div class="floater-cards-grid">
    <% cards.forEach(function(team, idx) { %>
      <% var accent = FLOATER_ACCENTS[idx % FLOATER_ACCENTS.length]; %>
      <div class="floater-card floater-card-<%= accent %>">
        <div class="floater-card-header">
          <span class="floater-card-icon"><svg class="icon"><use href="#icon-broom"/></svg></span>
          <h3><%= team.title %></h3>
        </div>
        <table class="floater-card-table setup-assignment-table">
          <thead>
            <tr><th>Member</th><th>Task 1</th><th>Task 2</th></tr>
          </thead>
          <tbody>
            <% if (team.members.length === 0) { %>
              <tr><td colspan="3" class="roster-empty">No members yet.</td></tr>
            <% } %>
            <% team.members.forEach(function(m) { %>
              <tr>
                <td class="floater-card-position"><%= m.name %></td>
                <%
                  var slots = [
                    { num: 1, taskItemId: m.taskItemId, taskNumber: m.taskNumber, taskDescription: m.taskDescription, options: m.slot1Options },
                    { num: 2, taskItemId: m.taskItemId2, taskNumber: m.taskNumber2, taskDescription: m.taskDescription2, options: m.slot2Options },
                  ];
                %>
                <% slots.forEach(function(slot) { %>
                  <td data-slot-cell="<%= m.id %>-<%= slot.num %>">
                    <% if (!isEditable) { %>
                      <% if (slot.taskDescription) { %>
                        <%= slot.taskDescription %>
                      <% } else { %>
                        <span class="floater-card-unassigned">No suggestion</span>
                      <% } %>
                    <% } else if (slot.taskItemId) { %>
                      <form method="POST" class="floater-assign-form" action="/admin/setup/<%= day %>/assignments/<%= m.id %>/task">
                        <input type="hidden" name="date" value="<%= selectedDate %>" />
                        <input type="hidden" name="slot" value="<%= slot.num %>" />
                        <input type="hidden" name="taskItemId" value="" />
                        <span class="setup-task-static">#<%= slot.taskNumber %> &mdash; <%= slot.taskDescription %></span>
                        <button type="submit" class="floater-assign-btn floater-assign-btn-unassign">Unassign</button>
                      </form>
                    <% } else if (slot.options.length === 0) { %>
                      <select disabled class="floater-select-noavail" aria-label="No tasks available for <%= m.name %>">
                        <option>No tasks available</option>
                      </select>
                      <% if (slot.num === 1 && team.taskOptions.length === 0) { %><p class="hint">No task list linked to this team yet.</p><% } %>
                    <% } else { %>
                      <form method="POST" class="floater-assign-form" action="/admin/setup/<%= day %>/assignments/<%= m.id %>/task">
                        <input type="hidden" name="date" value="<%= selectedDate %>" />
                        <input type="hidden" name="slot" value="<%= slot.num %>" />
                        <select name="taskItemId">
                          <% slot.options.forEach(function(item) { %>
                            <option value="<%= item.id %>">#<%= item.number %> &mdash; <%= item.description %></option>
                          <% }); %>
                        </select>
                        <button type="submit" class="floater-assign-btn">Assign</button>
                      </form>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <div class="floater-card-footer">
          <svg class="icon"><use href="#icon-users"/></svg>
          <%= team.members.length %> Member<%= team.members.length === 1 ? '' : 's' %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>
