<%
// One card per Setup/Cleanup team, listing its members and (editable
// mode only) an Assign/Unassign control per member per task slot -
// mirrors partials/floater-assignment-cards.ejs's per-hour card look,
// just per-team instead. Shared by the live Assignments page (editable,
// day+date passed for each slot's own form action) and the read-only
// Archive fragment/print for a past date (editable=false, plain text
// instead of a control - matches floater-assignment-cards.ejs's own
// "reassigning happens on the live tab, not here" rule).
//
// A real request: this should "look and work like Floater Assignments" -
// a suggested-task dropdown next to an Assign button; clicking Assign
// posts immediately and locks that ONE slot (plain text + an Unassign
// button takes the dropdown's place), clicking Unassign frees it back up
// for a different, not-yet-taken pick. Both directions post to routes/
// admin-setup.js's same /assignments/:memberId/task route Floater's own
// assign/unassign pair mirrors - Assign with a real taskItemId, Unassign
// with none. No whole-card Edit/Save step and no client-side JS at all,
// same as Floater's own floater-chart-cards.ejs - every action is its own
// small form that round-trips on submit.
//
// Locals: cards (routes/admin-setup.js's assignmentCardsForDate), day,
// selectedDate, editable (defaults true).
var FLOATER_ACCENTS = ['blue', 'green', 'orange', 'purple'];
var isEditable = typeof editable === 'undefined' ? true : editable;
%>
<% if (cards.length === 0) { %>
  <p class="roster-empty">No teams yet &mdash; create one on the Setup/Cleanup Teams tab.</p>
<% } else { %>
  <div class="floater-cards-grid setup-assignment-cards-grid">
    <% cards.forEach(function(team, idx) { %>
      <% var accent = FLOATER_ACCENTS[idx % FLOATER_ACCENTS.length]; %>
      <div class="floater-card floater-card-<%= accent %>">
        <div class="floater-card-header">
          <span class="floater-card-icon"><svg class="icon"><use href="#icon-broom"/></svg></span>
          <h3><%= team.title %></h3>
        </div>
        <%# A real request: "the leader, time, location, all those details
            should show on the kiosk side when you click the setup/cleanup
            button" - a team without any of the three set just omits this
            row entirely rather than showing empty placeholders. %>
        <% if (team.leaderName || team.meetingTime || team.meetingLocation) { %>
          <div class="floater-card-meta">
            <% if (team.leaderName) { %><span class="floater-card-meta-item"><svg class="icon"><use href="#icon-user"/></svg> <%= team.leaderName %></span><% } %>
            <% if (team.meetingTime) { %><span class="floater-card-meta-item"><svg class="icon"><use href="#icon-clock"/></svg> <%= team.meetingTime %></span><% } %>
            <% if (team.meetingLocation) { %><span class="floater-card-meta-item"><svg class="icon"><use href="#icon-map-pin"/></svg> <%= team.meetingLocation %></span><% } %>
          </div>
        <% } %>
        <table class="floater-card-table setup-assignment-table">
          <thead>
            <tr><th>Member</th><th>Task 1</th><th>Task 2</th></tr>
          </thead>
          <tbody>
            <% if (team.members.length === 0) { %>
              <tr><td colspan="3" class="roster-empty">No members yet.</td></tr>
            <% } %>
            <% team.members.forEach(function(m) { %>
              <%
                // A real bug report (surfaced by test/routes-setup-absent-
                // highlight.test.js failing on a real Wednesday): the
                // absent-row highlight and "(absent)" label used to only
                // ever render in editable mode - a leftover from before
                // this partial was shared between the live Assignments
                // page and the read-only kiosk/Archive views. m.absent
                // itself (assignmentCardsForDate, utils/setup.js) is
                // computed the same way regardless of editable, so there
                // was never a real reason to hide it in read-only mode -
                // if anything, "who's absent today" is exactly what a
                // read-only kiosk viewer (or someone checking a past
                // Archive date) needs to see, same as the admin page
                // already shows. Only the Assign/Unassign CONTROLS below
                // stay editable-only.
              %>
              <%# A real bug report: this used to build the whole
                  ' class="..."' string inside an EJS OUTPUT tag (the
                  HTML-escaping kind), which HTML-escapes its own double
                  quotes into an entity - the row's class attribute
                  rendered as literal, inert escaped text instead of a
                  real attribute, so the CSS rule never matched. Plain
                  control-flow tags (no dynamic text being escaped) avoid
                  the whole problem, matching how neither m.absent here
                  nor absentIds.has(m.id) in admin-setup.ejs's own
                  equivalent has ever needed real escaping - only a
                  literal, hardcoded class name is ever written either
                  way. %>
              <%# A real bug report: "highlight red member rows if absent,
                  green rows if present - it is currently highlighting all
                  rows of people who have checked in red." m.checkedIn
                  (assignmentCardsForDate, utils/setup.js) is computed the
                  same "read from attendance" way as m.absent just above -
                  only the CSS pairing for setup-assignment-row-checked-in
                  needed to change (red -> green, see styles.css), the
                  class name/precedence logic itself was already right.
                  Absent wins if somehow both are true (a corrected status
                  after an earlier check-in), same plain-control-flow-tag
                  class-attribute pattern as m.absent for the reason
                  explained above. %>
              <tr<% if (m.absent) { %> class="setup-assignment-row-absent"<% } else if (m.checkedIn) { %> class="setup-assignment-row-checked-in"<% } %>>
                <td class="floater-card-position">
                  <%= m.name %><% if (m.infant) { %> <span class="team-member-flag">(infant)</span><% } %><% if (m.absent) { %> <span class="floater-card-unassigned">(absent)</span><% } %>
                </td>
                <%
                  var slots = [
                    { num: 1, taskItemId: m.taskItemId, taskNumber: m.taskNumber, taskDescription: m.taskDescription, options: m.slot1Options, suggestedTaskItemId: m.suggestedTaskItemId },
                    { num: 2, taskItemId: m.taskItemId2, taskNumber: m.taskNumber2, taskDescription: m.taskDescription2, options: m.slot2Options, suggestedTaskItemId: m.suggestedTaskItemId2 },
                  ];
                %>
                <% slots.forEach(function(slot) { %>
                  <td data-slot-cell="<%= m.id %>-<%= slot.num %>">
                    <% if (!isEditable) { %>
                      <% if (slot.taskDescription) { %>
                        <%= slot.taskDescription %>
                      <% } else { %>
                        <span class="floater-card-unassigned">No suggestion</span>
                      <% } %>
                    <% } else if (slot.taskItemId) { %>
                      <form method="POST" class="floater-assign-form" action="/admin/setup/<%= day %>/assignments/<%= m.id %>/task">
                        <input type="hidden" name="date" value="<%= selectedDate %>" />
                        <input type="hidden" name="slot" value="<%= slot.num %>" />
                        <input type="hidden" name="taskItemId" value="" />
                        <span class="setup-task-static">#<%= slot.taskNumber %> &mdash; <%= slot.taskDescription %></span>
                        <button type="submit" class="floater-assign-btn floater-assign-btn-unassign">Unassign</button>
                      </form>
                    <% } else if (m.absent) { %>
                      <%# "no tasks should be suggested for that member" - absent
                          and not already assigned, so nothing to suggest and
                          nothing to hand-pick until they're marked present again. %>
                      <select disabled class="floater-select-noavail" aria-label="<%= m.name %> is absent - no task suggested">
                        <option>Absent - no task</option>
                      </select>
                    <% } else if (slot.options.length === 0) { %>
                      <select disabled class="floater-select-noavail" aria-label="No tasks available for <%= m.name %>">
                        <option>No tasks available</option>
                      </select>
                      <% if (slot.num === 1 && team.taskOptions.length === 0) { %><p class="hint">No task list linked to this team yet.</p><% } %>
                    <% } else { %>
                      <form method="POST" class="floater-assign-form" action="/admin/setup/<%= day %>/assignments/<%= m.id %>/task">
                        <input type="hidden" name="date" value="<%= selectedDate %>" />
                        <input type="hidden" name="slot" value="<%= slot.num %>" />
                        <select name="taskItemId">
                          <% if (!slot.suggestedTaskItemId) { %><option value="" selected disabled>Select a task&hellip;</option><% } %>
                          <% slot.options.forEach(function(item) { %>
                            <option value="<%= item.id %>"<%= item.id === slot.suggestedTaskItemId ? ' selected' : '' %>>#<%= item.number %> &mdash; <%= item.description %></option>
                          <% }); %>
                        </select>
                        <button type="submit" class="floater-assign-btn">Assign</button>
                      </form>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <div class="floater-card-footer">
          <svg class="icon"><use href="#icon-users"/></svg>
          <%= team.members.length %> Member<%= team.members.length === 1 ? '' : 's' %>
        </div>
        <% if (team.unassignedTasks && team.unassignedTasks.length > 0) { %>
          <div class="setup-unassigned-tasks">
            <h4>Unassigned Tasks</h4>
            <ul>
              <% team.unassignedTasks.forEach(function(item) { %>
                <li>#<%= item.number %> &mdash; <%= item.description %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>
      </div>
    <% }); %>
  </div>
<% } %>
