<%
// locals: day, activeFloaterTab ('assignments' | 'teams' | 'risk'),
// semesterId (optional - the combo picker's own current selection, query-
// string-ready: a number, 'none', or omitted/undefined).
// Monday/Wednesday used to be two separate top-level tabs here - now
// they're one "Floater Assignments" tab, with the Monday/Wednesday
// choice made via the day-toggle on the manage page itself (mirrors the
// Attendance page's Monday/Wednesday consolidation). The link below
// carries whichever day is currently in context (passed in as `day` by
// every one of this partial's 3 callers) so switching from, say,
// Wednesday Teams back to Floater Assignments lands on Wednesday, not a
// hardcoded default. semesterId does the same job for the newer semester
// combo picker (routes/admin-volunteers.js's own comboSemesterId) - a
// real request: "I need to be able to switch between semester views on
// floaters... " - so switching sub-tabs keeps whichever semester combo
// was already selected instead of resetting to the default.
var semesterQS = typeof semesterId !== 'undefined' && semesterId !== undefined ? '?semesterId=' + semesterId : '';
%>
<div class="view-tabs no-print">
  <a class="view-tab<%= activeFloaterTab === 'assignments' ? ' active' : '' %>" href="/admin/volunteers/<%= day %>/manage<%= semesterQS %>">Floater Assignments</a>
  <a class="view-tab<%= activeFloaterTab === 'teams' ? ' active' : '' %>" href="/admin/volunteers/<%= day %>/teams<%= semesterQS %>">Floater Teams</a>
  <a class="view-tab<%= activeFloaterTab === 'risk' ? ' active' : '' %>" href="/admin/volunteers/<%= day %>/risk<%= semesterQS %>">Class Cancellation Risk</a>
</div>
