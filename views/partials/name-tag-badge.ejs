<%
// locals: layout (array), data (object), badgeWidth, badgeHeight
var ALIGN_JUSTIFY = { left: 'flex-start', center: 'center', right: 'flex-end' };
%>
<div class="badge-canvas" style="width:<%= badgeWidth %>px; height:<%= badgeHeight %>px;">
  <% layout.forEach(function(el) { %>
    <% if (el.type === 'text') { %>
      <div
        class="badge-el badge-el-text"
        style="left:<%= el.x %>px; top:<%= el.y %>px; width:<%= el.width %>px; height:<%= el.height %>px; font-size:<%= el.fontSize %>px; color:<%= el.color %>; font-weight:<%= el.bold ? 700 : 400 %>; justify-content:<%= ALIGN_JUSTIFY[el.align] || 'center' %>;"
      ><%= (data && data[el.field]) || '' %></div>
    <% } else if (el.type === 'shape') { %>
      <div
        class="badge-el badge-el-shape"
        style="left:<%= el.x %>px; top:<%= el.y %>px; width:<%= el.width %>px; height:<%= el.height %>px; background:<%= el.fill || 'transparent' %>; border:<%= el.borderWidth || 0 %>px solid <%= el.borderColor || 'transparent' %>; border-radius:<%= el.borderRadius || 0 %>px;"
      ></div>
    <% } else if (el.type === 'image' && el.src) { %>
      <img
        class="badge-el badge-el-image"
        src="<%= el.src %>"
        alt=""
        style="left:<%= el.x %>px; top:<%= el.y %>px; width:<%= el.width %>px; height:<%= el.height %>px;"
      />
    <% } else if (el.type === 'barcode') { %>
      <svg
        class="badge-el badge-el-barcode"
        data-barcode-value="<%= (data && data.barcodeValue) || '' %>"
        style="left:<%= el.x %>px; top:<%= el.y %>px; width:<%= el.width %>px; height:<%= el.height %>px;"
      ></svg>
    <% } %>
  <% }); %>
</div>
