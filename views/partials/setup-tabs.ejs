<%
// locals: day, activeSetupTab ('assignments' | 'teams' | 'tasks'),
// semesterId (optional - the combo picker's own current selection, query-
// string-ready: a number, 'none', or omitted/undefined).
// Mirrors partials/floater-tabs.ejs's shape exactly - one shared "Setup/
// Cleanup" tab set across 4 pages, Monday/Wednesday picked via each
// page's own day-toggle rather than as separate top-level tabs (that's
// what these used to be - see admin-setup.ejs/admin-setup-tasks.ejs's
// git history - before this partial existed). semesterId does the same
// job for the newer semester combo picker (a real request: "I need to be
// able to switch between semester views on floaters, setup cleanup...")
// that replaced that day-toggle - switching sub-tabs keeps whichever
// combo was already selected instead of resetting to the default.
var semesterQS = typeof semesterId !== 'undefined' && semesterId !== undefined ? '?semesterId=' + semesterId : '';
%>
<div class="view-tabs no-print">
  <a class="view-tab<%= activeSetupTab === 'assignments' ? ' active' : '' %>" href="/admin/setup/<%= day %>/assignments<%= semesterQS %>">Setup/Cleanup Assignments</a>
  <a class="view-tab<%= activeSetupTab === 'teams' ? ' active' : '' %>" href="/admin/setup/<%= day %>/manage<%= semesterQS %>">Setup/Cleanup Teams</a>
  <a class="view-tab<%= activeSetupTab === 'tasks' ? ' active' : '' %>" href="/admin/setup/<%= day %>/tasks<%= semesterQS %>">Task List</a>
</div>
