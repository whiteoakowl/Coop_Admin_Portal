<%
// One repeatable "Adult" block on the public self-registration form
// (views/portal-register.ejs) - a real request: "There is a +child
// button. There should also be an add adult button." Same clone-a-
// <template> pattern as partials/register-child-fields.ejs (see public/
// js/portal-register-form.js), for a second (or third, etc.) parent/
// guardian beyond the one already inline at the top of the form.
//
// Fully optional, same as a child block here - a blank block is
// silently dropped server-side (routes/portal-auth.js's own additional-
// parents filter) rather than blocking submission.
//
// A real request: "For add an adult, also add check box for give this
// parent their own portal log in" - same wantsLogin/Password/Confirm
// pattern register-child-fields.ejs's own child-login-toggle already
// uses, except there's no separate login-email field here: the Email
// field already in the grid above doubles as the login email (routes/
// portal-auth.js's own additionalParents validation requires it be
// filled in when this is checked), rather than asking for the same
// address twice.
//
// `values` carries back whatever the visitor typed if the whole form
// re-renders after a validation error, so nothing the visitor already
// typed gets lost, but never their password - see register-child-
// fields.ejs's own matching comment.
const v = (typeof values !== 'undefined' && values) || {};
%>
<div class="manage-section register-adult-block" data-adult-block>
  <%# A real request: "Put double title back but it should say parent/
      guardian #2, #3 etc." - back to a per-block title, now numbered
      instead of repeating the same static "Additional Parent/Guardian"
      text verbatim for every block. The number itself is filled in by
      public/js/portal-register-form.js's own renumberAdults() (empty
      here, not computed in EJS) so it can count this block's actual
      position among every .register-adult-block currently in the DOM,
      starting from #2 since the Parent/Guardian section above this one
      is implicitly #1 - the one place that stays correct after a block
      is removed from the middle of the list, which a number baked in at
      render time never would. %>
  <div class="membership-child-header">
    <h3 data-adult-title></h3>
    <button type="button" class="icon-btn register-remove-adult" aria-label="Remove adult" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
  </div>
  <div class="member-form-grid">
    <%# A real request: "Upload photo button should be first under the
        title" - moved up from the bottom of this block to right under
        its own h3. %>
    <label class="member-form-full">Photo
      <input type="file" name="additionalParents[<%= index %>][photo]" accept="image/*" />
    </label>
    <label>First Name
      <input type="text" name="additionalParents[<%= index %>][firstName]" value="<%= v.firstName || '' %>" />
    </label>
    <label>Last Name
      <input type="text" name="additionalParents[<%= index %>][lastName]" value="<%= v.lastName || '' %>" />
    </label>
    <label>Email
      <input type="email" name="additionalParents[<%= index %>][email]" value="<%= v.email || '' %>" />
    </label>
    <label>Phone Number
      <input type="tel" name="additionalParents[<%= index %>][phone]" value="<%= v.phone || '' %>" placeholder="555-123-4567" />
    </label>
  </div>

  <%# "When adding an additional parent there should be a check box that
      says address is the same." Checked by default - most families
      share one address, and public/js/portal-register-form.js hides
      (not disables) the fields below while it's checked so a visitor
      never has to clear them back out to use their own address. %>
  <label class="checkbox-option">
    <input type="checkbox" class="register-adult-same-address-toggle" data-adult-same-address-toggle name="additionalParents[<%= index %>][sameAddress]" value="1" <%= v.sameAddress === false ? '' : 'checked' %> />
    Address is the same as the first parent/guardian
  </label>
  <div class="member-form-grid register-adult-address-fields" data-adult-address-fields <%= v.sameAddress === false ? '' : 'hidden' %>>
    <label class="member-form-full">Address
      <input type="text" name="additionalParents[<%= index %>][address]" value="<%= v.address || '' %>" />
    </label>
    <label class="member-form-full">Address 2
      <input type="text" name="additionalParents[<%= index %>][address2]" value="<%= v.address2 || '' %>" />
    </label>
    <label>City
      <input type="text" name="additionalParents[<%= index %>][city]" value="<%= v.city || '' %>" />
    </label>
    <label>State
      <input type="text" name="additionalParents[<%= index %>][state]" value="<%= v.state || '' %>" />
    </label>
    <label>Zip Code
      <input type="text" name="additionalParents[<%= index %>][zip]" value="<%= v.zip || '' %>" />
    </label>
  </div>

  <label class="checkbox-option">
    <input type="checkbox" class="register-adult-login-toggle" data-adult-login-toggle name="additionalParents[<%= index %>][wantsLogin]" <%= v.wantsLogin ? 'checked' : '' %> />
    Give this parent their own portal login
  </label>
  <div class="member-form-grid register-adult-login-fields" data-adult-login-fields <%= v.wantsLogin ? '' : 'hidden' %>>
    <p class="hint member-form-full">Uses the email address entered above as their login.</p>
    <label>Password
      <input type="password" name="additionalParents[<%= index %>][loginPassword]" minlength="8" autocomplete="new-password" />
    </label>
    <label>Confirm Password
      <input type="password" name="additionalParents[<%= index %>][loginPasswordConfirm]" minlength="8" autocomplete="new-password" />
    </label>
  </div>

</div>
