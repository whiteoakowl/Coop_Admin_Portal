<div class="game-play-card" id="checkers-card">
  <div class="game-card-info">
    <div class="checkers-score-card">
      <div class="checkers-score-row"><span class="checkers-piece-dot checkers-piece-dark"></span> You <strong id="checkers-score-you">12</strong></div>
      <div class="checkers-score-vs">vs</div>
      <div class="checkers-score-row"><span class="checkers-piece-dot checkers-piece-light"></span> Opponent <strong id="checkers-score-opp">12</strong></div>
    </div>
    <p class="checkers-turn-indicator"><span id="checkers-turn-label">Your Turn</span> <span class="checkers-turn-dot" id="checkers-turn-dot"></span></p>
  </div>
  <div class="checkers-board" id="checkers-board"></div>
  <button type="button" class="primary-btn game-play-action" id="checkers-reset"><svg class="icon"><use href="#icon-refresh"/></svg> New Game</button>
</div>
