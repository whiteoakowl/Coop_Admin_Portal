<div class="game-play-card" id="typing-card">
  <p class="typing-target" id="typing-target"></p>
  <input type="text" class="typing-input" id="typing-input" autocomplete="off" spellcheck="false" placeholder="Type here..." />
  <p class="game-card-sub" id="typing-result"></p>
  <button type="button" class="primary-btn game-play-action" id="typing-reset">New Sentence</button>
</div>
