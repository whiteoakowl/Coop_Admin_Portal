<div class="game-play-card" id="trivia-card">
  <div id="trivia-body">
    <div class="trivia-level-row" id="trivia-levels">
      <p class="game-card-sub">Pick a level to start</p>
      <button type="button" class="btn-secondary trivia-level-btn" data-level="k2">Grades K-2</button>
      <button type="button" class="btn-secondary trivia-level-btn" data-level="35">Grades 3-5</button>
      <button type="button" class="btn-secondary trivia-level-btn" data-level="68">Grades 6-8</button>
    </div>
    <div class="trivia-question-box" id="trivia-question-box" hidden>
      <p class="trivia-score" id="trivia-score"></p>
      <p class="trivia-question" id="trivia-question"></p>
      <div class="trivia-choices" id="trivia-choices"></div>
    </div>
  </div>
  <button type="button" class="btn-secondary game-play-action" id="trivia-reset">Change Level</button>
</div>
