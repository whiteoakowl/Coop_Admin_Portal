<div class="game-play-card" id="scramble-card">
  <p class="game-card-sub">Score: <span id="scramble-score">0</span></p>
  <p class="spelling-bee-clue" id="scramble-word" style="letter-spacing: 0.3em;"></p>
  <input type="text" id="scramble-input" class="spelling-bee-input" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Unscramble it..." />
  <p class="spelling-bee-feedback" id="scramble-feedback"></p>
  <button type="button" class="primary-btn" id="scramble-submit">Submit</button>
  <button type="button" class="btn-secondary game-play-action" id="scramble-reset">New Round</button>
</div>
