<div class="game-play-card" id="snake-card">
  <canvas id="snake-canvas" width="320" height="320" class="game-canvas"></canvas>
  <p class="game-card-sub">Score: <span id="snake-score">0</span></p>
  <div class="game-dpad">
    <button type="button" class="game-dpad-btn" data-dir="up" aria-label="Up"><svg class="icon"><use href="#icon-chevron-down"/></svg></button>
    <div class="game-dpad-row">
      <button type="button" class="game-dpad-btn" data-dir="left" aria-label="Left"><svg class="icon"><use href="#icon-chevron-down"/></svg></button>
      <button type="button" class="game-dpad-btn" data-dir="right" aria-label="Right"><svg class="icon"><use href="#icon-chevron-down"/></svg></button>
    </div>
    <button type="button" class="game-dpad-btn" data-dir="down" aria-label="Down"><svg class="icon"><use href="#icon-chevron-down"/></svg></button>
  </div>
  <button type="button" class="primary-btn game-play-action" id="snake-reset">New Game</button>
</div>
