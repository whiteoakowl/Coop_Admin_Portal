<div class="game-play-card" id="pong-card">
  <canvas id="pong-canvas" width="440" height="280" class="game-canvas"></canvas>
  <p class="game-card-sub">Score: <span id="pong-score">0 - 0</span></p>
  <div class="game-dpad-row">
    <button type="button" class="game-dpad-btn" data-dir="up" aria-label="Up"><svg class="icon"><use href="#icon-chevron-down"/></svg></button>
    <button type="button" class="game-dpad-btn" data-dir="down" aria-label="Down"><svg class="icon"><use href="#icon-chevron-down"/></svg></button>
  </div>
  <button type="button" class="primary-btn game-play-action" id="pong-reset">New Game</button>
</div>
