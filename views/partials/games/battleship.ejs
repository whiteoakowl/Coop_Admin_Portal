<div class="game-play-card" id="battle-card">
  <p class="game-card-sub" id="battle-status">Your turn - sink the enemy fleet!</p>
  <div class="battle-boards">
    <div>
      <p class="battle-board-label">Enemy Waters</p>
      <div class="battle-grid" id="battle-enemy-grid"></div>
    </div>
    <div>
      <p class="battle-board-label">Your Fleet</p>
      <div class="battle-grid" id="battle-you-grid"></div>
    </div>
  </div>
  <button type="button" class="primary-btn game-play-action" id="battle-reset">New Game</button>
</div>
