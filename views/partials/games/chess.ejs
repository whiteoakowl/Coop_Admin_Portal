<div class="game-play-card" id="chess-card">
  <div class="game-card-info">
    <div class="chess-score-card">
      <div class="chess-score-row">You<div class="hint">White</div></div>
      <div class="chess-score-vs">vs</div>
      <div class="chess-score-row">Opponent<div class="hint">Black</div></div>
    </div>
    <p class="chess-turn-indicator" id="chess-turn-indicator">White to move</p>
  </div>
  <div class="chess-board" id="chess-board"></div>
  <button type="button" class="primary-btn game-play-action" id="chess-reset"><svg class="icon"><use href="#icon-refresh"/></svg> New Game</button>
</div>
