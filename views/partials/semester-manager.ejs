<%
// locals: semesters, classDays/classDayLabels (every day of the week the
// "Add a Schedule"/edit checkboxes can offer), classSchedules (every
// class_schedules row - used here only to work out which days each
// semester already covers), backUrl (optional - where each form's own
// POST redirects back to; defaults to the Settings tab). Used by the
// Settings tab's own Semester sub-tab.
const semesterBackUrl = typeof backUrl !== 'undefined' && backUrl ? backUrl : '/admin/schedule?tab=settings';
// classDays is already in calendar order, so filtering it (rather than
// mapping classSchedules directly) gives each semester's own day list
// back in calendar order too, not creation order.
function daysForSemester(semesterId) {
  const covered = new Set(classSchedules.filter(function (cs) { return cs.semester_id === semesterId; }).map(function (cs) { return cs.day_of_week; }));
  return classDays.filter(function (d) { return covered.has(d); });
}
%>
<section class="portal-dashboard-card portal-dashboard-card-wide">
  <h2>Add a Semester</h2>
  <form method="POST" action="/admin/schedule/semesters" class="member-form-grid">
    <input type="hidden" name="back" value="<%= semesterBackUrl %>" />
    <label class="member-form-full">Title
      <input type="text" name="title" placeholder="e.g. Fall 2026" required />
    </label>
    <div class="member-form-full">
      <span class="checkbox-group-label">Add a Schedule</span>
      <div class="checkbox-group">
        <% classDays.forEach(function(d) { %>
          <label class="checkbox-option">
            <input type="checkbox" name="days" value="<%= d %>" />
            <%= classDayLabels[d] %>
          </label>
        <% }); %>
      </div>
    </div>
    <div class="member-form-full">
      <button type="submit" class="primary-btn">Add Semester</button>
    </div>
  </form>
</section>

<section class="portal-dashboard-section">
  <% if (semesters.length === 0) { %>
    <p class="roster-empty">No semesters yet.</p>
  <% } else { %>
    <div class="roster-scroll">
      <table class="roster-table members-table condensed-table semester-list-table">
        <thead>
          <tr><th>Title</th><th>Days</th><th></th></tr>
        </thead>
        <tbody>
          <% semesters.forEach(function(s) { %>
            <% var semesterDays = daysForSemester(s.id); %>
            <tr>
              <td class="roster-name-col">
                <button type="button" class="semester-title-btn" data-semester-edit-toggle="semester-edit-<%= s.id %>"><%= s.title %></button>
              </td>
              <td class="hint"><%= semesterDays.length ? semesterDays.map(function(d){ return classDayLabels[d]; }).join(', ') : 'No days yet' %></td>
              <td>
                <form method="POST" action="/admin/schedule/semesters/<%= s.id %>/delete" data-confirm="Are you sure you want to delete the &quot;<%= s.title %>&quot; semester? This action can&#39;t be reversed. Its Floater Assignments, Setup/Cleanup Teams, Task Lists, and Day Settings schedules will be permanently deleted too - classes assigned to it will just show No Semester.">
                  <input type="hidden" name="back" value="<%= semesterBackUrl %>" />
                  <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= s.title %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </form>
              </td>
            </tr>
            <tr id="semester-edit-<%= s.id %>" class="semester-edit-row" hidden>
              <td colspan="3">
                <form method="POST" action="/admin/schedule/semesters/<%= s.id %>/update" class="member-form-grid">
                  <input type="hidden" name="back" value="<%= semesterBackUrl %>" />
                  <label class="member-form-full">Title
                    <input type="text" name="title" value="<%= s.title %>" aria-label="Rename <%= s.title %>" required />
                  </label>
                  <div class="member-form-full">
                    <span class="checkbox-group-label">Days</span>
                    <div class="checkbox-group">
                      <% classDays.forEach(function(d) { %>
                        <label class="checkbox-option">
                          <input type="checkbox" name="days" value="<%= d %>" <%= semesterDays.includes(d) ? 'checked' : '' %> />
                          <%= classDayLabels[d] %>
                        </label>
                      <% }); %>
                    </div>
                  </div>
                  <div class="member-form-full semester-edit-actions">
                    <button type="submit" class="primary-btn">Save</button>
                    <button type="button" class="btn-secondary" data-semester-edit-cancel="semester-edit-<%= s.id %>">Cancel</button>
                  </div>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<script src="/js/semester-manager.js"></script>
