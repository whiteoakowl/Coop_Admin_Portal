<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%# Empty (not omitted) on every public/kiosk page - there's no admin
    session to hold a token for there, and none of those routes are
    CSRF-checked (see middleware/csrfProtection.js). public/js/csrf.js
    just no-ops when this is blank. %>
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>" />
<title><%= title %> · Sanford Homeschoolers</title>
<link rel="icon" type="image/png" href="/img/logo.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/styles.css" />

<!-- PWA: installable app shell (see Settings > Install App for the
     install button/steps and public/sw.js for what the service worker
     actually does - static-asset caching only, nothing session-gated). -->
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#4682B4" />
<%# A real bug report: "When downloading the app its labeled SH Check
    In. It should be labeled Co-op Admin Portal." manifest.json's own
    name/short_name already carry that label (used for Android/Chrome's
    install), but iOS Safari's "Add to Home Screen" often ignores the
    web manifest entirely and falls back to this specific meta tag - set
    explicitly so both platforms actually agree, instead of iOS silently
    reading whatever this page's own <title> happened to be. %>
<meta name="apple-mobile-web-app-title" content="Co-op Admin Portal" />
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
<script src="/js/pwa.js" defer></script>
<script src="/js/csrf.js" defer></script>
