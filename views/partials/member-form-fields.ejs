<%
// Shared Membership Form fields - included by the full Add/Edit page
// (views/admin-member-edit.ejs) for both 'create' and 'edit' modes, so
// the two never drift apart. Field layout/wording follows the
// Student/Parent Membership Form reference design exactly.
//
// locals: member, mode ('create'|'edit'), families (with memberCount),
// memberFamilyId, setupTeams (with memberCount), memberCleanupTeamIds,
// gradeLevels, adminPositions, memberAdminPositionIds, allowAdminType
//
// allowAdminType: "Choosing admins should not be on the membership
// profile, co-op admin portal. It should be on main admin member list
// edit only." Co-op Admin's own Add/Edit Member form (views/
// admin-member-edit.ejs) omits this local entirely, so it defaults to
// false below and this partial keeps its original Co-op-Admin-only
// restricted behavior (no way to pick Admin, see the toggle markup
// further down). Main Admin's own edit form (views/
// main-admin-member-edit.ejs) is the one place admin promotion/
// demotion should happen, so it passes allowAdminType: true to get the
// full 3-way Parent/Student/Admin toggle instead.
const allowAdminType = typeof locals.allowAdminType !== 'undefined' && locals.allowAdminType;
const isParent = member.member_type === 'parent';
// 'admin' - co-op staff/leaders who mainly just need a printable badge
// (see members.member_type's own schema comment) - a real request added
// this as a 3rd member type alongside the original Parent/Student toggle.
const isAdmin = member.member_type === 'admin';
const uid = 'mf-' + mode + '-' + (member.id || 'new');
const typeLabel = isAdmin ? 'Admin' : isParent ? 'Parent' : 'Student';
const US_STATES = [
  ['AL','Alabama'],['AK','Alaska'],['AZ','Arizona'],['AR','Arkansas'],['CA','California'],
  ['CO','Colorado'],['CT','Connecticut'],['DE','Delaware'],['DC','District of Columbia'],
  ['FL','Florida'],['GA','Georgia'],['HI','Hawaii'],['ID','Idaho'],['IL','Illinois'],
  ['IN','Indiana'],['IA','Iowa'],['KS','Kansas'],['KY','Kentucky'],['LA','Louisiana'],
  ['ME','Maine'],['MD','Maryland'],['MA','Massachusetts'],['MI','Michigan'],['MN','Minnesota'],
  ['MS','Mississippi'],['MO','Missouri'],['MT','Montana'],['NE','Nebraska'],['NV','Nevada'],
  ['NH','New Hampshire'],['NJ','New Jersey'],['NM','New Mexico'],['NY','New York'],
  ['NC','North Carolina'],['ND','North Dakota'],['OH','Ohio'],['OK','Oklahoma'],['OR','Oregon'],
  ['PA','Pennsylvania'],['RI','Rhode Island'],['SC','South Carolina'],['SD','South Dakota'],
  ['TN','Tennessee'],['TX','Texas'],['UT','Utah'],['VT','Vermont'],['VA','Virginia'],
  ['WA','Washington'],['WV','West Virginia'],['WI','Wisconsin'],['WY','Wyoming'],
];
%>
<div class="class-form-dialog-header member-form-header member-form-header-<%= isAdmin ? 'admin' : isParent ? 'parent' : 'student' %>" data-member-form-header>
  <span class="class-form-dialog-icon member-form-header-icon">
    <svg class="icon"><use href="#icon-<%= isAdmin ? 'badge' : isParent ? 'users' : 'graduation-cap' %>"/></svg>
  </span>
  <div class="member-form-header-text">
    <h3><%= typeLabel %> Membership Form</h3>
    <p>Create or update a <%= isAdmin ? 'co-op admin/leader' : isParent ? 'parent/guardian' : 'student' %> membership profile.</p>
  </div>
  <%# A real request: "Choosing admins should not be on the membership
      profile, co-op admin portal. It should be on main admin member
      list edit only." When allowAdminType is false (Co-op Admin's own
      Add/Edit Member form), this never offers a way to PICK Admin: a
      new/Parent/Student member only ever gets the 2-way Parent/Student
      toggle below. The one edge case is editing a member who's already
      Admin (assigned from Main Admin) - shown as a disabled, still-
      checked radio (not simply omitted) so the header/theme stays
      correctly "Admin" (public/js/member-form.js reads whichever radio
      is :checked) and a hidden input carries the same value through on
      submit, since a disabled input never posts - Co-op Admin can still
      edit that member's other fields without silently demoting them to
      Student the moment this form saves. Main Admin's own edit form
      passes allowAdminType: true and gets the full interactive 3-way
      toggle instead, since that's the one place promotion/demotion
      should happen. %>
  <div class="member-type-toggle" role="group" aria-label="Member type">
    <% if (allowAdminType) { %>
      <label class="member-type-toggle-btn member-type-toggle-parent">
        <input type="radio" name="memberType" value="parent" <%= isParent ? 'checked' : '' %> />
        <svg class="icon"><use href="#icon-user"/></svg> Parent
      </label>
      <label class="member-type-toggle-btn member-type-toggle-student">
        <input type="radio" name="memberType" value="student" <%= (!isParent && !isAdmin) ? 'checked' : '' %> />
        <svg class="icon"><use href="#icon-graduation-cap"/></svg> Student
      </label>
      <label class="member-type-toggle-btn member-type-toggle-admin">
        <input type="radio" name="memberType" value="admin" <%= isAdmin ? 'checked' : '' %> />
        <svg class="icon"><use href="#icon-badge"/></svg> Admin
      </label>
    <% } else if (isAdmin) { %>
      <label class="member-type-toggle-btn member-type-toggle-admin">
        <input type="radio" name="memberType" value="admin" checked disabled />
        <input type="hidden" name="memberType" value="admin" />
        <svg class="icon"><use href="#icon-badge"/></svg> Admin
      </label>
    <% } else { %>
      <label class="member-type-toggle-btn member-type-toggle-parent">
        <input type="radio" name="memberType" value="parent" <%= isParent ? 'checked' : '' %> />
        <svg class="icon"><use href="#icon-user"/></svg> Parent
      </label>
      <label class="member-type-toggle-btn member-type-toggle-student">
        <input type="radio" name="memberType" value="student" <%= !isParent ? 'checked' : '' %> />
        <svg class="icon"><use href="#icon-graduation-cap"/></svg> Student
      </label>
    <% } %>
  </div>
</div>

<div class="member-form-parent-flag" data-parent-only style="<%= isParent ? '' : 'display:none;' %>">
  <label class="checkbox-option primary-parent-top-option">
    <input type="checkbox" name="isPrimaryParent" value="1" <%= member.is_primary_parent ? 'checked' : '' %> />
    <svg class="icon"><use href="#icon-star"/></svg> Primary Parent
  </label>
</div>

<div class="member-form-card">
  <div class="member-form-top-row">
    <div class="member-photo-col">
      <label class="member-photo-circle" for="<%= uid %>-photo">
        <% if (member.photo_path) { %>
          <img src="<%= photoUrl(member.photo_path) %>" alt="" />
        <% } else { %>
          <svg class="icon member-photo-placeholder-icon"><use href="#icon-user"/></svg>
        <% } %>
        <span class="member-photo-camera"><svg class="icon"><use href="#icon-camera"/></svg></span>
      </label>
      <input type="file" name="photo" id="<%= uid %>-photo" accept="image/*" hidden />
      <label class="member-photo-upload-link" for="<%= uid %>-photo">Upload a photo</label>
      <span class="member-photo-hint">JPG, PNG up to 5MB</span>
    </div>
    <div class="member-fields-col">
      <div class="class-form-row">
        <div class="class-form-field">
          <span class="class-form-field-label required">Full Name</span>
          <input type="text" name="name" value="<%= member.name %>" placeholder="Enter full name" required />
        </div>
      </div>
      <div class="class-form-row">
        <div class="class-form-field">
          <span class="class-form-field-label required">Address</span>
          <input type="text" name="address" value="<%= member.address || '' %>" placeholder="Enter street address" />
        </div>
      </div>
      <div class="class-form-row">
        <div class="class-form-field">
          <span class="class-form-field-label required">City</span>
          <input type="text" name="city" value="<%= member.city || '' %>" placeholder="Enter city" />
        </div>
        <div class="class-form-field">
          <span class="class-form-field-label required">State</span>
          <select name="state">
            <option value="">Select state</option>
            <% US_STATES.forEach(function(s) { %>
              <option value="<%= s[0] %>" <%= member.state === s[0] ? 'selected' : '' %>><%= s[1] %></option>
            <% }); %>
          </select>
        </div>
        <div class="class-form-field">
          <span class="class-form-field-label required">Zip Code</span>
          <input type="text" name="zip" value="<%= member.zip || '' %>" placeholder="Enter zip code" />
        </div>
      </div>
    </div>
  </div>

  <div class="class-form-row">
    <div class="class-form-field">
      <span class="class-form-field-label required">Phone</span>
      <span class="input-with-icon">
        <svg class="icon"><use href="#icon-phone"/></svg>
        <input type="tel" name="phone" value="<%= member.phone || '' %>" placeholder="(123) 456-7890" />
      </span>
    </div>
    <div class="class-form-field">
      <span class="class-form-field-label required">Email</span>
      <span class="input-with-icon">
        <svg class="icon"><use href="#icon-mail"/></svg>
        <input type="email" name="email" value="<%= member.email || '' %>" placeholder="name@example.com" />
      </span>
    </div>
  </div>
  <div class="class-form-row">
    <div class="class-form-field">
      <span class="class-form-field-label">Medical / Allergy Notes</span>
      <textarea name="medicalNotes" rows="3" placeholder="Enter any medical conditions, allergies, or important notes"><%= member.medical_notes || '' %></textarea>
    </div>
  </div>
  <div class="class-form-row" data-student-only style="<%= (!isParent && !isAdmin) ? '' : 'display:none;' %>">
    <div class="class-form-field">
      <span class="class-form-field-label required">Birthday</span>
      <input type="date" name="birthday" value="<%= member.birthday || '' %>" />
    </div>
    <div class="class-form-field">
      <span class="class-form-field-label required">Grade Level</span>
      <select name="gradeLevel">
        <option value="">Select grade level</option>
        <% gradeLevels.forEach(function(g) { %>
          <option value="<%= g %>" <%= member.grade_level === g ? 'selected' : '' %>><%= g %></option>
        <% }); %>
      </select>
    </div>
  </div>
</div>

<div class="member-form-boxes">
  <div class="manage-section member-form-section-box member-form-section-<%= isParent ? 'green' : 'blue' %>" data-family-box>
    <h2><svg class="icon"><use href="#icon-users"/></svg> Choose a Family</h2>
    <label class="member-form-full">Select Family
      <select name="familyId" data-family-select>
        <option value="">Choose from available families</option>
        <% families.forEach(function(f) { %>
          <option value="<%= f.id %>" <%= memberFamilyId === f.id ? 'selected' : '' %>>The <%= f.name %> Family</option>
        <% }); %>
      </select>
    </label>
    <button type="button" class="btn-secondary member-form-add-family-btn" data-add-family-open>+ Add New Family</button>
  </div>

  <div class="manage-section member-form-section-box member-form-section-green" id="parent-only-fields" data-parent-only style="<%= isParent ? '' : 'display:none;' %>">
    <h2><svg class="icon"><use href="#icon-broom"/></svg> Setup / Cleanup Team</h2>
    <% if (setupTeams.length === 0) { %>
      <p class="hint">No Setup/Cleanup teams exist yet.</p>
    <% } else { %>
      <label class="member-form-full">Add a Team
        <select data-team-picker>
          <option value="">Choose from available teams</option>
          <% setupTeams.forEach(function(t) { %>
            <option value="<%= t.id %>"><%= t.day === 'monday' ? 'Monday' : 'Wednesday' %> &ndash; <%= t.title %></option>
          <% }); %>
        </select>
      </label>
      <div class="member-form-checklist" data-team-checklist>
        <% setupTeams.forEach(function(t) { %>
          <label class="member-form-checklist-row<%= memberCleanupTeamIds.includes(t.id) ? ' is-checked' : '' %>">
            <input type="checkbox" name="cleanupTeamIds" value="<%= t.id %>" class="member-form-checklist-checkbox" <%= memberCleanupTeamIds.includes(t.id) ? 'checked' : '' %> />
            <span class="member-form-checklist-box"><svg class="icon"><use href="#icon-check"/></svg></span>
            <span class="member-form-checklist-name"><%= t.day === 'monday' ? 'Monday' : 'Wednesday' %> &ndash; <%= t.title %></span>
            <span class="member-form-checklist-count"><%= t.memberCount %> member<%= t.memberCount === 1 ? '' : 's' %></span>
          </label>
        <% }); %>
      </div>
    <% } %>
  </div>

  <%# A real request: "ability to add unlimited admin positions to a
      member profile" - was a single <select> (member.admin_position_id),
      now a proper multi-select, same picker-dropdown + checkbox-checklist
      shape as the Setup/Cleanup Team box above (public/js/member-form.js's
      initPickerChecklist wires both the same way). %>
  <div class="manage-section member-form-section-box member-form-section-purple" id="admin-only-fields" data-admin-only style="<%= isAdmin ? '' : 'display:none;' %>">
    <h2><svg class="icon"><use href="#icon-badge"/></svg> Admin Positions</h2>
    <% if (adminPositions.length === 0) { %>
      <p class="hint">No positions added yet - add some under <a href="/main-admin/admins">Main Admin &gt; Admins</a>.</p>
    <% } else { %>
      <label class="member-form-full">Add a Position
        <select data-position-picker>
          <option value="">Choose from available positions</option>
          <% adminPositions.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.title %></option>
          <% }); %>
        </select>
      </label>
      <div class="member-form-checklist" data-position-checklist>
        <% adminPositions.forEach(function(p) { %>
          <label class="member-form-checklist-row<%= memberAdminPositionIds.includes(p.id) ? ' is-checked' : '' %>">
            <input type="checkbox" name="adminPositionIds" value="<%= p.id %>" class="member-form-checklist-checkbox" <%= memberAdminPositionIds.includes(p.id) ? 'checked' : '' %> />
            <span class="member-form-checklist-box"><svg class="icon"><use href="#icon-check"/></svg></span>
            <span class="member-form-checklist-name"><%= p.title %></span>
          </label>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
