<%
// locals: c (one allClassesList row - see utils/classSchedule.js's own
// classImageUrl field), selectedChild (null when the dashboard is
// showing a parent's own teaching/assisting classes instead of a
// child's enrolled ones - see views/parent-class-dashboard.ejs). A real
// request: "Class card should show Class image on left of card."
//
// A later real request ("all classes should have a delete button and
// view class button on each row to the right... you can now cancel the
// class on the classroom dashboard") replaced the whole-card link with
// explicit View Class / Delete buttons. A further real request ("Class
// card should not have view class button, you should be able to just
// click the class card to view. Delete button should say withdraw and
// be much smaller.") restores the whole-card click target - the color
// bar + body are wrapped in their own link instead, so the small
// Withdraw button can keep living beside it as its own separate click
// target without also triggering navigation. A parent's teaching card
// has nowhere to click through to at all yet (that detail route is
// student-enrollment-only) and isn't a registration to withdraw from
// either, so it still renders with no link/action row.
%>
<div class="class-dash-card">
  <% if (selectedChild) { %><a class="class-dash-card-link" href="/parent/classes/dashboard/<%= c.id %>?studentId=<%= selectedChild.id %>"><% } %>
    <div class="class-dash-card-color-bar" style="background:<%= c.color %>"></div>
    <div class="class-dash-card-body">
      <% if (c.classImageUrl) { %>
        <img class="class-dash-card-image" src="<%= c.classImageUrl %>" alt="" />
      <% } else { %>
        <span class="class-dash-card-image class-dash-card-image-placeholder"><svg class="icon"><use href="#icon-graduation-cap"/></svg></span>
      <% } %>
      <div class="class-dash-card-text">
        <h3 class="class-dash-card-title"><%= c.class_name %></h3>
        <p class="class-dash-card-meta"><%= c.timeLabel %></p>
        <p class="class-dash-card-meta"><%= c.room || 'No room set' %></p>
        <p class="class-dash-card-meta">Teacher: <%= c.teacherNames.length ? c.teacherNames.join(', ') : 'No teacher assigned' %></p>
      </div>
    </div>
  <% if (selectedChild) { %></a><% } %>
  <% if (selectedChild) { %>
    <div class="class-dash-card-actions">
      <button
        type="button"
        class="roster-action-btn roster-action-btn-danger roster-action-btn-small"
        data-withdraw-class-btn
        data-withdraw-class-url="/parent/classes/<%= c.id %>/unregister"
        data-withdraw-student-id="<%= selectedChild.id %>"
      >Withdraw</button>
    </div>
  <% } %>
</div>
