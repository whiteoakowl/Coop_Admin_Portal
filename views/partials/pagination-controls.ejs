<%
// Locals: pagination (the object utils/pagination.js's paginate() returns),
// baseHref (a URL up through and including its trailing "?" or "&", e.g.
// "/admin/members?type=student&" - this partial appends "page=N" or
// "pageSize=all" to it), viewingAll (optional - true when the route
// resolved pageSize=Infinity from a ?pageSize=all request; paginate()
// itself reports totalPages === 1 in that state same as a genuinely
// short list, so this flag is what actually distinguishes "nothing to
// paginate" from "everything's shown on purpose, offer a way back").
// Renders nothing when everything fits on one page AND View All was
// never requested, so a small co-op with a short list never sees
// pagination chrome at all. no-print like every other on-screen-only
// control (roster-toolbar, view-tabs) - the printed page shows the full
// unpaginated list, not just whichever page happened to be open on
// screen (see the print-only table each paginated view renders
// alongside its on-screen one).
var isViewingAll = typeof viewingAll !== 'undefined' && viewingAll;
%>
<% if (pagination.totalPages > 1 || isViewingAll) { %>
  <nav class="pagination-bar no-print" aria-label="Pagination">
    <span class="pagination-summary">Showing <%= pagination.startIndex %>&ndash;<%= pagination.endIndex %> of <%= pagination.totalItems %></span>
    <div class="pagination-nav">
      <% if (isViewingAll) { %>
        <%# A real request: "a view all button" - offered as a toggle
            rather than a dead end, since ?pageSize=all collapses
            pagination.totalPages to 1 with nothing left to Prev/Next
            through otherwise. %>
        <a class="pagination-btn" href="<%= baseHref %>page=1">Show Pages</a>
      <% } else { %>
        <% if (pagination.hasPrev) { %>
          <a class="pagination-btn" href="<%= baseHref %>page=<%= pagination.currentPage - 1 %>">&larr; Prev</a>
        <% } else { %>
          <span class="pagination-btn pagination-btn-disabled" aria-disabled="true">&larr; Prev</span>
        <% } %>
        <label class="pagination-page-select-label">
          Page
          <select
            class="pagination-page-select"
            aria-label="Jump to page"
            onchange="window.location = '<%= baseHref %>page=' + this.value"
          >
            <% for (var p = 1; p <= pagination.totalPages; p++) { %>
              <option value="<%= p %>"<%= p === pagination.currentPage ? ' selected' : '' %>><%= p %></option>
            <% } %>
          </select>
          of <%= pagination.totalPages %>
        </label>
        <% if (pagination.hasNext) { %>
          <a class="pagination-btn" href="<%= baseHref %>page=<%= pagination.currentPage + 1 %>">Next &rarr;</a>
        <% } else { %>
          <span class="pagination-btn pagination-btn-disabled" aria-disabled="true">Next &rarr;</span>
        <% } %>
        <a class="pagination-btn" href="<%= baseHref %>pageSize=all">View All</a>
      <% } %>
    </div>
  </nav>
<% } %>
