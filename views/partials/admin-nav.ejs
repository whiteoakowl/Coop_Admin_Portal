<%- include('icon-sprite') %>

<%# Off-screen until focused - lets keyboard/screen-reader users jump past
    the ~10-14 sidebar links (repeated on every admin page) straight to
    the page's own content instead of tabbing through the whole sidebar
    every time. Targets #main-content, set on every page's <main>. %>
<a href="#main-content" class="skip-link">Skip to main content</a>

<aside class="admin-sidebar">
  <a class="brand" href="/admin">
    <img src="/img/logo-owl.png" alt="Sanford Homeschoolers" />
  </a>
  <%
    // A real request: "instead of the tabs on each page, make them
    // subpages under each menu tab" (desktop) / "when you click the tab
    // below a menu will pop up" (mobile) - already built for every other
    // portal (see portal-nav.ejs's own primaryNavLinks/subpages and
    // public/js/admin-nav-accordion.js, page-tabs.js below), just never
    // wired in here for Co-op Admin's own separate nav shell.
    const adminNavLinks = [
      { href: '/admin', icon: 'home', label: 'Home' },
      // Each day's own Student/Parent roster toggle lives inside the page
      // itself (?tab=<day>-student vs. <day>-parent, etc., plus the
      // page's own semester+day combo picker for switching days) - none
      // of that is a query param this bare "Parent/Student Rosters" link
      // itself carries, so admin-nav-accordion.js's own exact-match pass
      // never matches it directly; its bare-href fallback (no query
      // params at all) is what actually highlights it as active for any
      // day/role combination, same as Classes' own "Class Schedules" link
      // just below.
      { href: '/admin/rosters', icon: 'calendar-check', label: 'Attendance', subpages: [
        // A bare href, matching Classes' own "Class Schedules" subpage
        // link just below - GET /admin/rosters with no ?tab= at all
        // renders its default day's Parent roster directly (routes/
        // admin-rosters.js) without ever redirecting the address bar to
        // one, so a query-string link here could never match it and the
        // title's own Menu dropdown would silently never appear (same
        // bug, same fix, as that comment explains in full). A real
        // request: "attendance, Monday, it should always land on parents
        // first" - still true, just no longer a fixed Monday/Wednesday
        // pair of links now that Day Settings can activate any day of
        // the week - the page's own semester+day combo picker is how an
        // admin switches days from here now.
        { href: '/admin/rosters', label: 'Parent/Student Rosters' },
        { href: '/admin/rosters?tab=classes', label: 'Classes' },
        { href: '/admin/rosters?tab=playground', label: 'Playground' },
        { href: '/admin/rosters?tab=archive', label: 'Archive' },
      ] },
      { href: '/admin/volunteers', icon: 'users', label: 'Floater Assignments' },
      { href: '/admin/setup', icon: 'broom', label: 'Setup/Cleanup' },
      { href: '/admin/schedule', icon: 'clock', match: '/admin/class-schedule', label: 'Classes', subpages: [
        // A real bug report: "co-op main menu, classes page should have
        // blue bubble dropdown menu next to title for subpages" - public/
        // js/page-tabs.js's own findCurrentSectionDialog only matches a
        // subpage link whose own href EXACTLY mirrors the current URL -
        // either the same query params, or (its fallback) a BARE href
        // with no query string at all matched against a bare current URL.
        // GET /admin/schedule with no ?tab= at all renders the Monday
        // tab directly (routes/admin-schedule.js's own `tab = ... :
        // 'monday'` default), without ever redirecting the address bar
        // to ?tab=monday - so with every single subpage link here
        // carrying its own ?tab=, NONE of them could ever match that bare
        // URL, and the title's own Menu dropdown silently never appeared.
        // A bare href on the one subpage that actually IS this route's
        // own default (matching Shop's/Communication's own identical
        // "first entry has no query string" convention, both already
        // working) fixes it without touching the route itself.
        { href: '/admin/schedule', label: 'Class Schedules' },
        ...(isFullAdmin ? [
          { href: '/admin/schedule?tab=members', label: 'Member Schedules' },
          { href: '/admin/schedule?tab=archive', label: 'Archive' },
          { href: '/admin/schedule?tab=settings', label: 'Settings' },
        ] : []),
      ] },
      { href: '/admin/logs', icon: 'clipboard-list', label: 'Logs', subpages: [
        // Same bug/fix as Classes' own identical comment above - GET
        // /admin/logs with no ?tab= renders the Absence/Late tab
        // directly (routes/admin-logs.js's own `tab = ... : 'absence'`
        // default) without ever redirecting to ?tab=absence.
        { href: '/admin/logs', label: 'Absence/Late Log' },
        { href: '/admin/logs?tab=checkinout', label: 'Co-op Check-In/Out Log' },
        { href: '/admin/logs?tab=classcheckinout', label: 'Class Check-In/Out Log' },
        { href: '/admin/logs?tab=nametag', label: 'Name Tag Requests' },
        { href: '/admin/logs?tab=classrisk', label: 'Class Cancellation Risk' },
        { href: '/admin/logs?tab=substitutes', label: 'Substitutes Needed' },
        { href: '/admin/logs?tab=allergies', label: 'Allergies/Medical' },
      ] },
      { href: '/admin/training', icon: 'graduation-cap', label: 'Training' },
    ];
    const adminFullAdminNavLinks = [
      // No Archived subpage here - a real request: "remove member archive
      // page, it is not needed on co-op admin, only main admin." Main
      // Admin's own Members nav (portal-nav.ejs) still has its Archive tab.
      { href: '/admin/members', icon: 'user-check', label: 'Members' },
      { href: '/admin/library', icon: 'book', label: 'Library', subpages: [
        // Same bug/fix as Classes' own identical comment above - GET
        // /admin/library with no ?tab= renders the Check In tab directly
        // (routes/admin-library.js's own `tab = ... : 'checkin'` default)
        // without ever redirecting to ?tab=checkin.
        { href: '/admin/library', label: 'Check In' },
        { href: '/admin/library?tab=checkout', label: 'Check Out' },
        { href: '/admin/library?tab=members', label: 'Library Log' },
        { href: '/admin/library?tab=titles', label: 'Catalog' },
      ] },
      { href: '/admin/documents', icon: 'file-text', label: 'Documents' },
      // A real request: "there should not be a dashboard tab for name
      // tags. that is already in design/print tab" - a standalone "Name
      // Tag" nav item used to sit here too, pointing at routes/admin-
      // name-tag.js's own older /admin/name-tag page. Design/Print
      // (routes/admin-design.js, /admin/design) already covers the exact
      // same ground - its own Design tab has a Student/Parent/Admin Name
      // Tag type in the same dropdown as Schedule Card, and its Print tab
      // already prints Name Tags/Name Tag Requests/Name Tags+Schedule
      // Cards - so the separate nav entry for /admin/name-tag was a
      // redundant second way to reach the same feature. Only the nav link
      // is removed here; the older page/route itself is left in place
      // (still directly reachable by URL) rather than deleted outright.
      { href: '/admin/design', icon: 'palette', label: 'Design/Print', subpages: [
        { href: '/admin/design', label: 'Design' },
        { href: '/admin/design?tab=print', label: 'Print' },
        { href: '/admin/design?tab=requests', label: 'Requests' },
      ] },
      { href: '/admin/announcements', icon: 'bell', label: 'Communication', subpages: [
        { href: '/admin/announcements', label: 'Announcements' },
        { href: '/admin/announcements/email', label: 'Email' },
        { href: '/admin/announcements/text', label: 'Text' },
      ] },
      // A real request: "Add an orientation tab. List of members
      // registered for classes on either day... Subpages, tour check in,
      // orientation check in." See routes/admin-orientation.js/utils/
      // orientation.js.
      { href: '/admin/orientation', icon: 'check-circle', label: 'Orientation', subpages: [
        { href: '/admin/orientation', label: 'Orientation' },
        { href: '/admin/orientation/tour-checkin', label: 'Tour Check-In' },
        { href: '/admin/orientation/orientation-checkin', label: 'Orientation Check-In' },
      ] },
    ];
  %>
  <nav id="admin-nav-links">
    <% adminNavLinks.concat(isFullAdmin ? adminFullAdminNavLinks : []).forEach(function(link) { %>
      <% if (link.subpages && link.subpages.length) { %>
        <details class="admin-nav-group">
          <summary><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg> <%= link.label %> <svg class="icon admin-nav-group-chevron"><use href="#icon-chevron-down"/></svg></summary>
          <div class="admin-nav-subpages">
            <% link.subpages.forEach(function(sp) { %>
              <a href="<%= sp.href %>"><%= sp.label %></a>
            <% }); %>
          </div>
        </details>
      <% } else { %>
        <a href="<%= link.href %>"<% if (link.match) { %> data-match="<%= link.match %>"<% } %>><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg> <%= link.label %></a>
      <% } %>
    <% }); %>
  </nav>
  <div class="admin-sidebar-bottom">
    <form method="POST" action="/admin/logout" class="logout-form">
      <button type="submit"><svg class="icon"><use href="#icon-log-out"/></svg> Log out</button>
    </form>
  </div>
</aside>

<%# Top-right corner controls (desktop): global search, My Portals
    (#icon-monitor, a real request: "the portals button should be a
    computer icon"), My Profile (#icon-user-circle - a plain placeholder,
    no member profile-photo field exists yet), and Settings. Replaces the
    old Full Screen View toggle, removed here along with its script
    include and PIN-exit dialog per "remove full screen button and
    feature from all portal pages" - Kiosk Mode (kiosk-home.ejs) keeps
    its own separate, untouched copy of that feature. A later real
    request ("Switch portal, profile icon, settings icon should all be
    top right of screen") moved Settings up here from
    .admin-sidebar-bottom (still Log Out's home) - Co-op Admin has no
    separate settings page from its own profile/account page, so both
    links point at /admin/settings, same as they already did in the
    mobile topbar below. %>
<header class="admin-page-corner-actions no-print">
  <% if (isFullAdmin) { %>
    <form method="GET" action="/admin/search" class="admin-corner-search">
      <label for="admin-corner-search-input" class="sr-only">Search members and library items</label>
      <svg class="icon"><use href="#icon-search"/></svg>
      <input id="admin-corner-search-input" type="search" name="q" placeholder="Search&hellip;" />
    </form>
  <% } %>
  <a class="admin-corner-link" href="/portal">
    <svg class="icon"><use href="#icon-monitor"/></svg>
    My Portals
  </a>
  <a class="admin-corner-link" href="/admin/settings">
    <svg class="icon"><use href="#icon-user-circle"/></svg>
    My Profile
  </a>
  <a class="admin-corner-link" href="/admin/settings">
    <svg class="icon"><use href="#icon-gear"/></svg>
    Settings
  </a>
</header>

<div class="admin-mobile-topbar">
  <div class="admin-mobile-topbar-row">
    <a class="brand" href="/admin">
      <img src="/img/logo-owl.png" alt="" />
      Sanford Homeschoolers
    </a>
    <div class="admin-nav-right admin-nav-right-mobile">
      <% if (isFullAdmin) { %>
        <a class="admin-nav-right-link" href="/admin/search" aria-label="Search"><svg class="icon"><use href="#icon-search"/></svg></a>
      <% } %>
      <a class="admin-nav-right-link" href="/portal" aria-label="My Portals"><svg class="icon"><use href="#icon-monitor"/></svg></a>
      <a class="admin-nav-right-link" href="/admin/settings" aria-label="My Profile"><svg class="icon"><use href="#icon-user-circle"/></svg></a>
      <a class="admin-nav-right-link" href="/admin/settings" aria-label="Settings"><svg class="icon"><use href="#icon-gear"/></svg></a>
      <form method="POST" action="/admin/logout" class="logout-form">
        <button type="submit" class="admin-nav-right-link" aria-label="Log out"><svg class="icon"><use href="#icon-log-out"/></svg></button>
      </form>
    </div>
  </div>
</div>

<nav class="admin-mobile-tabs" id="admin-mobile-tabs">
  <% adminNavLinks.concat(isFullAdmin ? adminFullAdminNavLinks : []).forEach(function(link) { %>
    <% if (link.subpages && link.subpages.length) { %>
      <%- include('mobile-subpages-tab', { link: link }) %>
    <% } else { %>
      <a href="<%= link.href %>"<% if (link.match) { %> data-match="<%= link.match %>"<% } %>><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg><span><%= link.label %></span></a>
    <% } %>
  <% }); %>
</nav>

<%# Rendered as siblings of #admin-mobile-tabs, not nested inside it - see
    mobile-subpages-dialog.ejs for why (that <nav> is position: fixed with
    its own z-index, which caps any dialog nested inside it). %>
<% adminNavLinks.concat(isFullAdmin ? adminFullAdminNavLinks : []).forEach(function(link) { %>
  <% if (link.subpages && link.subpages.length) { %>
    <%- include('mobile-subpages-dialog', { link: link }) %>
  <% } %>
<% }); %>

<%- include('session-timeout-dialog') %>
<%- include('confirm-dialog') %>

<script src="/js/fullscreen-navigate-shim.js"></script>
<script src="/js/admin-nav.js"></script>
<%# defer, unlike this file's other scripts - both read window.CSRF_TOKEN,
    which partials/head.ejs's csrf.js sets. csrf.js is itself deferred (it
    sits in <head>, before any DOM these two need exists), and a deferred
    script always runs after every earlier-in-the-document non-deferred
    script has already executed - so without defer here, either of these
    would run (and read an still-unset window.CSRF_TOKEN) before csrf.js
    ever does, despite appearing later in the HTML. %>
<script src="/js/session-timeout-warning.js" defer></script>
<script src="/js/unsaved-changes.js" defer></script>
<script src="/js/confirm-dialog.js"></script>
<script src="/js/print-blank-target.js"></script>
<script src="/js/fit-tabs.js"></script>
<script src="/js/roster-btn-row-grid.js"></script>
<script src="/js/roster-student-profile.js"></script>
<script src="/js/class-roster-ajax.js"></script>
<script src="/js/skip-link.js"></script>
<%# A real request: "the new tab system for mobile is only applied to
    main admin portal. It need to be applied to all portals" - every
    other portal shares portal-nav.ejs, which already loads this same
    pair (admin-nav-accordion.js drives the .admin-nav-group <details>
    above and this same shell's own mobile-subpages-tab.ejs dialogs;
    page-tabs.js wires each dialog's own [data-subpages-dialog] trigger
    button) - Co-op Admin's own separate nav shell just never had them
    wired in. %>
<script src="/js/admin-nav-accordion.js"></script>
<script src="/js/page-tabs.js"></script>
