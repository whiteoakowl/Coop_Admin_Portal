<%- include('icon-sprite') %>

<%# Off-screen until focused - lets keyboard/screen-reader users jump past
    the ~10-14 sidebar links (repeated on every admin page) straight to
    the page's own content instead of tabbing through the whole sidebar
    every time. Targets #main-content, set on every page's <main>. %>
<a href="#main-content" class="skip-link">Skip to main content</a>

<aside class="admin-sidebar">
  <a class="brand" href="/admin">
    <img src="/img/logo.png" alt="Sanford Homeschoolers" />
  </a>
  <nav id="admin-nav-links">
    <a href="/admin"><svg class="icon"><use href="#icon-home"/></svg> Home</a>
    <a href="/admin/rosters"><svg class="icon"><use href="#icon-calendar-check"/></svg> Attendance</a>
    <a href="/admin/volunteers"><svg class="icon"><use href="#icon-users"/></svg> Floater Assignments</a>
    <a href="/admin/setup"><svg class="icon"><use href="#icon-broom"/></svg> Setup/Cleanup</a>
    <a href="/admin/schedule" data-match="/admin/class-schedule"><svg class="icon"><use href="#icon-clock"/></svg> Schedules</a>
    <a href="/admin/logs"><svg class="icon"><use href="#icon-clipboard-list"/></svg> Logs</a>
    <% if (isFullAdmin) { %>
      <a href="/admin/members"><svg class="icon"><use href="#icon-user-check"/></svg> Members</a>
      <a href="/admin/library"><svg class="icon"><use href="#icon-book"/></svg> Library</a>
      <a href="/admin/documents"><svg class="icon"><use href="#icon-file-text"/></svg> Documents</a>
      <a href="/admin/design" data-match="/admin/name-tag"><svg class="icon"><use href="#icon-palette"/></svg> Design/Print</a>
    <% } %>
  </nav>
  <div class="admin-sidebar-bottom">
    <a href="/admin/settings"><svg class="icon"><use href="#icon-sliders"/></svg> Settings</a>
    <form method="POST" action="/admin/logout" class="logout-form">
      <button type="submit"><svg class="icon"><use href="#icon-log-out"/></svg> Log out</button>
    </form>
  </div>
</aside>

<!-- Top-right corner controls (desktop) - global search next to the Full
     Screen toggle, neither tied to any one page's own content, so both
     are reachable no matter which section is open. Search is full-admin
     only, same as the Members/Library nav links (see
     routes/admin-search.js for why); Full Screen has no such
     restriction. -->
<div class="admin-page-corner-actions no-print">
  <% if (isFullAdmin) { %>
    <form method="GET" action="/admin/search" class="admin-corner-search">
      <label for="admin-corner-search-input" class="sr-only">Search members and library items</label>
      <svg class="icon"><use href="#icon-search"/></svg>
      <input id="admin-corner-search-input" type="search" name="q" placeholder="Search&hellip;" />
    </form>
  <% } %>
  <button type="button" class="admin-corner-link" id="fullscreen-toggle-btn" aria-label="Full Screen View">
    <svg class="icon"><use href="#icon-maximize"/></svg>
    <span id="fullscreen-toggle-label">Full Screen View</span>
  </button>
</div>

<div class="admin-mobile-topbar">
  <div class="admin-mobile-topbar-row">
    <a class="brand" href="/admin">
      <img src="/img/logo.png" alt="" />
      Sanford Homeschoolers
    </a>
    <div class="admin-nav-right admin-nav-right-mobile">
      <% if (isFullAdmin) { %>
        <a class="admin-nav-right-link" href="/admin/search" aria-label="Search"><svg class="icon"><use href="#icon-search"/></svg></a>
      <% } %>
      <button type="button" class="admin-nav-right-link" id="fullscreen-toggle-btn-mobile" aria-label="Full Screen View"><svg class="icon"><use href="#icon-maximize"/></svg></button>
      <a class="admin-nav-right-link" href="/admin/settings" aria-label="Settings"><svg class="icon"><use href="#icon-sliders"/></svg></a>
      <form method="POST" action="/admin/logout" class="logout-form">
        <button type="submit" class="admin-nav-right-link" aria-label="Log out"><svg class="icon"><use href="#icon-log-out"/></svg></button>
      </form>
    </div>
  </div>
</div>

<nav class="admin-mobile-tabs" id="admin-mobile-tabs">
  <a href="/admin"><svg class="icon"><use href="#icon-home"/></svg><span>Home</span></a>
  <a href="/admin/rosters"><svg class="icon"><use href="#icon-calendar-check"/></svg><span>Attendance</span></a>
  <a href="/admin/volunteers"><svg class="icon"><use href="#icon-users"/></svg><span>Floaters</span></a>
  <a href="/admin/setup"><svg class="icon"><use href="#icon-broom"/></svg><span>Setup/Cleanup</span></a>
  <a href="/admin/schedule" data-match="/admin/class-schedule"><svg class="icon"><use href="#icon-clock"/></svg><span>Schedules</span></a>
  <a href="/admin/logs"><svg class="icon"><use href="#icon-clipboard-list"/></svg><span>Logs</span></a>
  <% if (isFullAdmin) { %>
    <a href="/admin/members"><svg class="icon"><use href="#icon-user-check"/></svg><span>Members</span></a>
    <a href="/admin/library"><svg class="icon"><use href="#icon-book"/></svg><span>Library</span></a>
    <a href="/admin/documents"><svg class="icon"><use href="#icon-file-text"/></svg><span>Documents</span></a>
    <a href="/admin/design" data-match="/admin/name-tag"><svg class="icon"><use href="#icon-palette"/></svg><span>Design/Print</span></a>
  <% } %>
</nav>

<%- include('admin-alerts-dialog') %>
<%- include('session-timeout-dialog') %>
<%- include('confirm-dialog') %>

<script src="/js/admin-nav.js"></script>
<script src="/js/alerts.js"></script>
<%# defer, unlike this file's other scripts - both read window.CSRF_TOKEN,
    which partials/head.ejs's csrf.js sets. csrf.js is itself deferred (it
    sits in <head>, before any DOM these two need exists), and a deferred
    script always runs after every earlier-in-the-document non-deferred
    script has already executed - so without defer here, either of these
    would run (and read an still-unset window.CSRF_TOKEN) before csrf.js
    ever does, despite appearing later in the HTML. %>
<script src="/js/session-timeout-warning.js" defer></script>
<script src="/js/unsaved-changes.js" defer></script>
<script src="/js/fullscreen-toggle.js"></script>
<script src="/js/fullscreen-nav.js"></script>
<script src="/js/confirm-dialog.js"></script>
<script src="/js/fit-tabs.js"></script>
<script src="/js/skip-link.js"></script>
