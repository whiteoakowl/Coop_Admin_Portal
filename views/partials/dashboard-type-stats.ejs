<%
// locals: label (string), stats ({ total, checkedIn, checkedOut, late, absent })
%>
<div class="analytics-type-section">
  <h3><%= label %></h3>
  <div class="analytics-stat-row">
    <div class="analytics-stat analytics-stat-checkedin">
      <span class="analytics-stat-label">Checked In</span>
      <span class="analytics-stat-value"><%= stats.checkedIn %><span class="analytics-stat-of"> of <%= stats.total %></span></span>
    </div>
    <div class="analytics-stat analytics-stat-checkedout">
      <span class="analytics-stat-label">Checked Out</span>
      <span class="analytics-stat-value"><%= stats.checkedOut %><span class="analytics-stat-of"> of <%= stats.total %></span></span>
    </div>
    <div class="analytics-stat analytics-stat-late">
      <span class="analytics-stat-label">Late</span>
      <span class="analytics-stat-value"><%= stats.late %><span class="analytics-stat-of"> of <%= stats.total %></span></span>
    </div>
    <div class="analytics-stat analytics-stat-absent">
      <span class="analytics-stat-label">Absent</span>
      <span class="analytics-stat-value"><%= stats.absent %><span class="analytics-stat-of"> of <%= stats.total %></span></span>
    </div>
  </div>
</div>
