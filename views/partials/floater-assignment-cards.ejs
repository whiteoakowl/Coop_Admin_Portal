<%
// One card per hour block, each listing every position for that hour -
// Position, Room, Floater Assigned - read-only (reassigning happens on
// the live Chart tab's own cards, not here). Used by the public kiosk
// view - previously also shared by the since-removed Floater Archive
// popup/print page, same partial, same look, everywhere this data was
// shown.
// Locals: cards (utils/substitutes.js dailyAssignmentCards, each hour's
// `label` merged in by the route), dayLabel and (optionally) dateLabel
// for the per-page print header - only actually rendered under @media
// print, so callers that never print, like the kiosk view, can simply
// omit them. kiosk (optional, default false) - true only for the public,
// no-login kiosk view (routes/volunteers.js's own comment already says
// "Plain names only" there, but the member-name link below used to render
// regardless of caller). A real bug report: tapping an assigned floater's
// name on that public board took an unauthenticated kiosk visitor to
// /admin/members/:id - at best a dead end at the admin login page, at
// worst (an admin device left signed in) a real navigation into the full
// admin site, either way landing on a page that never loads fullscreen-
// nav.js, so the very next link tap there broke kiosk fullscreen for
// real. The Archive popup/print callers (both requireAdmin-gated) keep
// the clickable link; the kiosk caller now gets a plain, unlinked name -
// same "no admin escape hatch" treatment setup-public.ejs's own member
// rows already use for the exact same reason.
//
// A real request: "floater printing. each page should have a header,
// each page should be an hour that fits to page." Each hour is wrapped
// in its own .floater-print-page - print-only CSS (styles.css) turns
// the grid to one column and page-breaks before every wrapper but the
// first, and each wrapper carries its own repeated, print-only
// .print-header instead of relying on volunteer-archive-print.ejs's own
// single top-of-document header, which would otherwise only land on
// whichever one page happens to hold it.
var FLOATER_ACCENTS = ['blue', 'green', 'orange', 'purple'];
var isKiosk = typeof kiosk !== 'undefined' && kiosk;
%>
<% if (cards.length === 0) { %>
  <p class="roster-empty">No positions configured for this day yet.</p>
<% } else { %>
  <div class="floater-cards-grid">
    <% cards.forEach(function(hour, idx) { %>
      <% var accent = FLOATER_ACCENTS[idx % FLOATER_ACCENTS.length]; %>
      <div class="floater-print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub"><%= typeof dayLabel !== 'undefined' ? dayLabel : '' %> Floater Assignments<% if (typeof dateLabel !== 'undefined' && dateLabel) { %> &mdash; <%= dateLabel %><% } %></p>
        </div>
      </div>
      <div class="floater-card floater-card-<%= accent %>">
        <div class="floater-card-header">
          <span class="floater-card-icon"><svg class="icon"><use href="#icon-clock"/></svg></span>
          <h3><%= hour.label %></h3>
        </div>
        <table class="floater-card-table">
          <thead>
            <tr><th>Position</th><th>Room</th><th>Floater</th></tr>
          </thead>
          <tbody>
            <% hour.jobs.forEach(function(job) { %>
              <tr>
                <td class="floater-card-position"><%= job.title %></td>
                <td><%= job.room || '—' %></td>
                <td>
                  <% if (job.assigned && isKiosk) { %>
                    <%= job.assigned.name %>
                  <% } else if (job.assigned) { %>
                    <a class="member-name-link" href="/admin/members/<%= job.assigned.id %>"><%= job.assigned.name %></a>
                  <% } else { %>
                    <span class="floater-card-unassigned">Unassigned</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <div class="floater-card-footer">
          <svg class="icon"><use href="#icon-users"/></svg>
          <%= hour.jobs.length %> Assignment<%= hour.jobs.length === 1 ? '' : 's' %>
        </div>
      </div>
      </div>
    <% }); %>
  </div>
<% } %>
