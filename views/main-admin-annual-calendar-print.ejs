<!doctype html>
<html lang="en">
<head>
  <%# A real request: "the download should be a pdf of exactly how it
      would also look when printing." utils/pdfRender.js renders this
      exact view (via req.app.render(), never through a real HTTP
      request) to build the Download PDF - pdfBaseUrl is only ever set
      for that internal render. %>
  <% if (typeof pdfBaseUrl !== 'undefined' && pdfBaseUrl) { %><base href="<%= pdfBaseUrl %>/"><% } %>
  <%- include('partials/head', { title }) %>
  <%# A real request: "Print and pdf should have the calendars in
      portrait view" - "letter" alone leaves the orientation ambiguous
      enough that some browsers' own print dialog defaults to whatever
      orientation was last chosen on this site (e.g. a landscape page
      like the Weekly Planner print view), instead of resetting to this
      page's own intended layout; the explicit "portrait" keyword below
      removes that ambiguity and locks the print dialog's own
      orientation control to match, the same way every landscape
      *-print.ejs view on this site already states "landscape"
      explicitly rather than leaving it implied. %>
  <style>@page { size: letter portrait; margin: 0.5in; }</style>
</head>
<body class="admin-page">
  <%- include('partials/portal-nav', { portalTitle: 'Main Admin' }) %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1>Annual Calendar</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <% if (!selectedFiscalYear || !calendar) { %>
      <p class="roster-empty">No calendar created for this fiscal year yet.</p>
    <% } else { %>
      <%# A real request: "Titl of page should be the school year such
          as 2026-2027." schoolYearLabel is computed server-side
          (routes/main-admin-annual-calendar.js) since EJS views here
          have no access to Node's require(). %>
      <h2><%= schoolYearLabel %></h2>

      <%# A real request: "Create key button... Key shows on page." Same
          legend-row convention the live view's key bar uses, just plain
          swatches here since there's nothing to click on a printed
          page. %>
      <% if (keys.length > 0) { %>
        <div class="roster-btn-row roster-btn-row-fit-text fs-attendance-row-left">
          <% keys.forEach(function(k) { %>
            <span class="badge-pill annual-calendar-key-legend-pill" style="background-color: <%= k.color %>;"><%= k.label %></span>
          <% }); %>
        </div>
      <% } %>

      <%# A real request, later flipped by a follow-up ("Calendars, pdf
          and print should be 3 columns of 4 months") to 3 columns x 4
          rows - its own grid classes (public/css/styles.css), kept
          separate from Family Attendance's own matching-shape print
          grid rather than literally shared, since the two have already
          diverged once. A further real request: "Add edit calendar
          colors buttons... set the color for the month row and set the
          color for the days of the week row" - same --annual-calendar-
          month-color/--annual-calendar-weekday-color custom properties
          the live view's own grid wrapper sets, so the print/PDF output
          matches whatever an admin picked there. %>
      <div
        class="annual-calendar-print-months-grid"
        <% if (calendar.month_row_color || calendar.weekday_row_color) { %>
          style="<%= calendar.month_row_color ? `--annual-calendar-month-color: ${calendar.month_row_color};` : '' %><%= calendar.weekday_row_color ? `--annual-calendar-weekday-color: ${calendar.weekday_row_color};` : '' %>"
        <% } %>
      >
        <% months.forEach(function(m) { %>
          <div class="annual-calendar-print-month">
            <h3><%= MONTH_NAMES[m.month - 1] %> <%= m.year %></h3>
            <table class="fs-attendance-calendar">
              <thead>
                <tr><th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th></tr>
              </thead>
              <tbody>
                <% m.weeks.forEach(function(week) { %>
                  <tr>
                    <% week.forEach(function(d) { %>
                      <% if (!d) { %>
                        <td class="fs-attendance-day fs-attendance-day-empty"></td>
                      <% } else {
                        var keyed = m.keyByDate[d.date];
                      %>
                        <td class="fs-attendance-day" <%- keyed ? `style="background-color: ${keyed.color};"` : '' %>><%= d.day %></td>
                      <% } %>
                    <% }); %>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
