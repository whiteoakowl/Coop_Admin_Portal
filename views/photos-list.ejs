<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<%
  // Same fix as directory-list.ejs's own comment.
  const hasParentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'parent');
  const hasStudentRole = typeof portalRoles !== 'undefined' && portalRoles.some((r) => r.key === 'student');
  const usesPortalNavShell = hasParentRole || hasStudentRole;
%>
<body>
  <% if (usesPortalNavShell) { %>
    <%
      // A real bug report: "Student portal, when you click on chat it
      // should stay on Student portal" was this exact same "always
      // guess Parent first" mistake, just for Photos instead of Chat -
      // sharedPortalTitle (middleware/portalAuth.js) now also honors
      // ?portal=parent|student when it's present (see portal-nav.ejs's
      // own Photos href), so a dual-role account keeps whichever portal
      // they actually clicked from instead of always landing in Parent.
    %>
    <%- include('partials/portal-nav', { portalTitle: sharedPortalTitle(hasParentRole ? 'Parent Portal' : 'Student Portal') }) %>
  <% } else { %>
  <%- include('partials/icon-sprite') %>

  <header class="site-header">
    <a class="site-header-brand" href="/welcome">
      <img src="/img/logo.png" alt="" />
      <%= settings.org_name %>
    </a>
    <div class="site-header-actions">
      <% if (typeof portalAccount !== 'undefined' && portalAccount) { %>
        <a class="primary-btn" href="/portal">My Portals</a>
      <% } else { %>
        <a class="btn-secondary" href="/login">Log In</a>
        <a class="primary-btn" href="/register">Member Registration</a>
      <% } %>
    </div>
  </header>
  <% } %>

  <main id="main-content" tabindex="-1"<% if (usesPortalNavShell) { %> class="admin-main"<% } %>>
    <section class="site-section">
      <div class="site-section-inner">
        <div class="grid-box-header">
          <h1>Photos</h1>
          <% if (typeof portalAccount !== 'undefined' && portalAccount && albums.length > 0) { %>
            <button type="button" class="roster-action-btn" onclick="document.getElementById('add-photo-dialog').showModal()">+ Add Photo</button>
          <% } %>
        </div>

        <% if (albums.length === 0) { %>
          <p class="roster-empty">No albums yet.</p>
        <% } else { %>
          <div class="event-card-grid">
            <% albums.forEach(function(a) { %>
              <a class="event-card" href="/photos/<%= a.id %>">
                <% if (a.cover_image_key) { %>
                  <div class="event-card-image"><img src="/photos/<%= a.id %>/cover" alt="" /></div>
                <% } %>
                <div class="event-card-body">
                  <h3><%= a.title %></h3>
                  <% if (a.description) { %><p class="event-card-location"><%= a.description %></p><% } %>
                </div>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <% if (typeof portalAccount !== 'undefined' && portalAccount && albums.length > 0) { %>
    <%
      // A real request: "when you click the photos tab it goes to a
      // completely different page than the whole dashboard. It should
      // look like other pages with an add photo button." The list page
      // has no album selected yet - unlike photos-detail.ejs's own
      // upload form (one fixed album) - so this one also asks which
      // album to add to, then posts to that exact same /photos/:id/upload
      // route (members can add photos to an existing album, never create
      // one - see routes/photos.js's own comment on why there's no
      // create-album route here at all).
    %>
    <dialog id="add-photo-dialog" class="member-picker-dialog dialog-label-stack">
      <form method="POST" action="/photos" enctype="multipart/form-data" onsubmit="this.action = '/photos/' + this.albumId.value + '/upload';">
        <h3>Add Photo</h3>
        <label>Album
          <select name="albumId" required>
            <% albums.forEach(function(a) { %><option value="<%= a.id %>"><%= a.title %></option><% }); %>
          </select>
        </label>
        <label>Photo(s)
          <input type="file" name="images" accept="image/*" multiple required />
        </label>
        <label>Caption <span class="hint">(optional, applies to all photos in this upload)</span>
          <input type="text" name="caption" placeholder="e.g. Field trip day" />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Upload</button>
        </div>
      </form>
    </dialog>
  <% } %>
</body>
</html>
