<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= activeTab === 'orders' ? 'Orders' : activeTab === 'archived' ? 'Archived' : activeTab === 'analytics' ? 'Analytics' : activeTab === 'settings' ? 'Settings' : 'Products' %></h1>
      <% if (activeTab === 'products') { %>
        <div class="roster-btn-row">
          <%# A real request: "add button that says view member store.
              This button shows you the member store view." %>
          <a class="roster-action-btn" href="/store" target="_blank" rel="noopener">View Member Store</a>
          <%# A real request: "remove settings subpage. Move add category
              button to the product page," later renamed and reworked
              into a combined popup: "add category button should say
              add/edit category. it should then be a pop up that shows
              current categories and allows you to add new ones or edit
              old ones. make multiple changes then click save." %>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-category-dialog').showModal()">Add/Edit Category</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('new-product-dialog').showModal()">+ New Product</button>
        </div>
      <% } else if (activeTab === 'orders') { %>
        <div class="roster-btn-row">
          <%# A real request: "button called fulfillment totals. Popup,
              show counts for all order that need to be filled." %>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('fulfillment-totals-dialog').showModal()">Fulfillment Totals</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('in-person-dialog').showModal()">+ In-Person Sale</button>
        </div>
      <% } %>
    </div>

    <%# Products/Orders/Archived/Analytics/Settings now live as subpages
        under the orange bar's own Shop item (views/partials/portal-
        nav.ejs) instead of a trigger+dialog here. %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (activeTab === 'products') { %>
      <%# A real request: "filter by category should just say filter." A
          follow-up bug report: "the buttons and dropdowns overlap. There
          should be some space in between" - this form sat directly under
          .grid-box-header's own button row with no margin of its own. %>
      <form method="GET" action="/main-admin/store" class="inline-block-form" style="display: block; margin: 1rem 0;">
        <input type="hidden" name="tab" value="products" />
        <label>Filter
          <select name="category" onchange="this.form.submit()">
            <option value="">All Categories</option>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= selectedCategory === c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }); %>
          </select>
        </label>
      </form>

      <% if (products.length === 0) { %>
        <p class="roster-empty">No products yet &mdash; create one above.</p>
      <% } %>

      <%# A real request: "not [no] edit button on the product, clicking
          the product takes you to the edit page" - the whole card is now
          the link, nothing left inside it needs its own click target.
          "Main admin portal product card should look exactly like this"
          (reference image): photo on top, name, a price + In Stock/Out
          of Stock row (same dot style as the member storefront card),
          a plain "Category: X" row, a plain "In Person Sales: N" row,
          and a status pill at the very bottom of the card. %>
      <div class="store-product-grid">
        <% products.forEach(function(p) { %>
          <a class="store-admin-product-card" href="/main-admin/store/<%= p.id %>/edit">
            <div class="store-product-card-image-wrap">
              <% if (p.imageUrl) { %>
                <img class="store-product-card-image" src="<%= p.imageUrl %>" alt="" />
              <% } %>
            </div>
            <div class="store-product-card-body">
              <h3 class="store-product-card-name"><%= p.name %></h3>
              <div class="store-product-card-price-row">
                <span class="store-product-card-price">$<%= (p.price_cents / 100).toFixed(2) %></span>
                <span class="store-product-card-stock <%= p.inStock ? 'store-in-stock' : 'store-out-of-stock' %>">
                  <span class="store-stock-dot"></span><%= p.inStock ? 'In Stock' : 'Out of Stock' %>
                </span>
              </div>
              <span class="store-admin-card-meta-row"><svg class="icon"><use href="#icon-folder"/></svg>Category: <%= p.categoryName || 'Uncategorized' %></span>
              <span class="store-admin-card-meta-row"><svg class="icon"><use href="#icon-users"/></svg>In Person Sales: <%= p.inPersonSales %></span>
              <span class="badge-pill badge-pill-<%= p.status === 'active' ? 'green' : 'orange' %> store-admin-card-status"><%= p.status === 'active' ? '✓ Active' : p.status.charAt(0).toUpperCase() + p.status.slice(1) %></span>
            </div>
          </a>
        <% }); %>
      </div>

      <%# A real request: "categories isn't listed on product page. just
          the product cards" - the standalone Categories list/section
          that used to live here is gone; managing categories now happens
          entirely in the Add/Edit Category popup below. %>

      <%# A real request: "add category button should say add/edit
          category. it should then be a pop up that shows current
          categories and allows you to add new ones or edit old ones.
          make multiple changes then click save." One form renames every
          changed row and adds the new one (if filled in) all in one
          submit - routes/admin-store.js's own POST /categories/bulk-save
          - instead of each row having its own separate Save button. Each
          row's own Delete stays its own tiny standalone <form> (the
          `form=""` attribute on its button submits that form instead of
          the enclosing one - forms can't nest) so it keeps its own
          data-confirm and doesn't get swept up by a Save meant only for
          renames/additions. %>
      <dialog id="add-category-dialog" class="member-picker-dialog">
        <form method="POST" action="/main-admin/store/categories/bulk-save">
          <h3>Add/Edit Category</h3>
          <% if (categories.length === 0) { %>
            <p class="hint">No categories yet &mdash; add one below.</p>
          <% } else { %>
            <div class="store-category-list">
              <% categories.forEach(function(c) { %>
                <div class="store-category-row">
                  <input type="hidden" name="categoryId" value="<%= c.id %>" />
                  <input type="text" name="categoryName" value="<%= c.name %>" required />
                  <button type="submit" form="delete-category-<%= c.id %>-form" class="icon-btn icon-btn-danger" aria-label="Delete <%= c.name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </div>
              <% }); %>
            </div>
          <% } %>
          <label for="add-store-category-name">New Category
            <input id="add-store-category-name" type="text" name="newCategoryName" placeholder="e.g. Apparel" />
          </label>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Save</button>
          </div>
        </form>
        <% categories.forEach(function(c) { %>
          <form method="POST" action="/main-admin/store/categories/<%= c.id %>/delete" id="delete-category-<%= c.id %>-form" data-confirm="Delete category &quot;<%= c.name %>&quot;? Its products become uncategorized."></form>
        <% }); %>
      </dialog>

      <dialog id="new-product-dialog" class="member-picker-dialog">
        <form method="POST" action="/main-admin/store">
          <h3>New Product</h3>
          <label>Name
            <input type="text" name="name" required />
          </label>
          <label>Price ($)
            <input type="number" name="price" min="0" step="0.01" required />
          </label>
          <label>Category
            <select name="categoryId">
              <option value="">Uncategorized</option>
              <% categories.forEach(function(c) { %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
            </select>
          </label>
          <label>Inventory (blank = unlimited) <span class="hint">(ignored once you add Options on the edit page)</span>
            <input type="number" name="inventoryCount" min="0" />
          </label>
          <label>Availability
            <select name="availability">
              <option value="both">Online + In-person</option>
              <option value="online">Online only</option>
              <option value="in_person">In-person only</option>
            </select>
          </label>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Create</button>
          </div>
        </form>
      </dialog>
    <% } %>

    <% if (activeTab === 'orders') { %>
      <% if (orders.length === 0) { %>
        <p class="roster-empty">No orders yet.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table roster-table-fit-content">
            <thead>
              <tr>
                <th>Order</th>
                <th>Member</th>
                <th>Type</th>
                <th>Total</th>
                <th>Status</th>
                <th>Date</th>
                <th class="store-orders-actions-col"></th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(function(o) { %>
                <tr>
                  <td><a href="/main-admin/store/orders/<%= o.id %>">#<%= o.id %></a></td>
                  <td><%= o.memberName %></td>
                  <td><%= o.sale_type === 'online' ? 'Online' : 'In-person' %></td>
                  <td>$<%= (o.total_cents / 100).toFixed(2) %></td>
                  <td><span class="badge-pill badge-pill-<%= o.status === 'fulfilled' || o.status === 'paid' ? 'green' : o.status === 'cancelled' ? 'gray' : 'orange' %>"><%= o.status %></span></td>
                  <td><%= o.created_at %></td>
                  <td class="store-orders-actions-col">
                    <%# A real bug report: "the buttons and list overlap and
                        need space between rows" - two things were wrong.
                        First, putting .roster-btn-row's class (mobile:
                        display: grid, see public/js/roster-btn-row-grid.js)
                        directly on a <td> broke the table's own column-
                        width math - every other table/card in the app
                        instead wraps .roster-btn-row in its own <div>
                        inside the cell, never on the cell itself. Second,
                        and the real cause of the squashed/overlapping
                        Fulfill+Cancel text: that same mobile CSS zeroes out
                        min-width on both the row and its buttons (so a
                        short toolbar can still split evenly into equal-
                        width columns) - but a <table> with the default
                        auto layout sizes each COLUMN off its cells' own
                        reported minimum width, so a min-width: 0 action
                        column got allocated almost none of the table's
                        width, no matter how much room the table actually
                        had. .store-orders-actions-col below (public/css/
                        styles.css) gives this one column back an explicit
                        floor the table layout can see. %>
                    <div class="roster-btn-row">
                      <% if (o.status === 'paid') { %>
                        <form method="POST" action="/main-admin/store/orders/<%= o.id %>/fulfill" class="inline-block-form">
                          <button type="submit" class="roster-action-btn">Fulfill</button>
                        </form>
                      <% } %>
                      <% if (o.status !== 'cancelled' && o.status !== 'fulfilled') { %>
                        <form method="POST" action="/main-admin/store/orders/<%= o.id %>/cancel" class="inline-block-form" data-confirm="Cancel order #<%= o.id %>?">
                          <button type="submit" class="roster-action-btn roster-action-btn-danger">Cancel</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <dialog id="in-person-dialog" class="class-form-dialog">
        <form method="POST" action="/main-admin/store/orders/in-person">
          <div class="class-form-dialog-header">
            <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-tag"/></svg></span>
            <h3>Record In-Person Sale</h3>
            <button type="button" class="class-form-dialog-close" onclick="this.closest('dialog').close()" aria-label="Close"><svg class="icon"><use href="#icon-x-circle"/></svg></button>
          </div>

          <% if (saleProducts.length === 0) { %>
            <p class="roster-empty">No products are set up for in-person sale yet.</p>
          <% } else { %>
            <p class="hint">Set a quantity for each item being sold. Add several different products (and options) to one sale.</p>
            <div class="sale-cart-list">
              <% saleProducts.forEach(function(p, idx) { %>
                <div class="sale-cart-row">
                  <input type="hidden" name="items[<%= idx %>][productId]" value="<%= p.id %>" />
                  <input class="sale-cart-qty" type="number" name="items[<%= idx %>][quantity]" min="0" <% if (p.optionGroups.length === 0 && p.inventory_count != null) { %>max="<%= p.inventory_count %>"<% } %> value="0" aria-label="Quantity of <%= p.name %>" />
                  <% p.optionGroups.forEach(function(group) { %>
                    <select class="sale-cart-option" name="items[<%= idx %>][optionValues][<%= group.id %>]" aria-label="<%= group.name %> of <%= p.name %>">
                      <% group.values.forEach(function(v) { %><option value="<%= v.id %>"><%= group.name %>: <%= v.name %><% if (v.price_cents != null) { %> (+$<%= (v.price_cents / 100).toFixed(2) %>)<% } %><% if (v.quantity != null) { %> (<%= v.quantity %> left)<% } %></option><% }); %>
                    </select>
                  <% }); %>
                  <span class="sale-cart-info">
                    <span class="sale-cart-name"><%= p.name %></span>
                    <span class="sale-cart-meta"><% if (p.optionGroups.length === 0) { %>$<%= (p.price_cents / 100).toFixed(2) %><% if (p.inventory_count != null) { %> &middot; <%= p.inventory_count %> in stock<% } %><% } %></span>
                  </span>
                </div>
              <% }); %>
            </div>
          <% } %>

          <label>Member
            <select name="memberId" required>
              <% members.forEach(function(m) { %><option value="<%= m.id %>"><%= m.name %></option><% }); %>
            </select>
          </label>
          <p class="hint">Recorded as paid immediately - this is for a sale where money already changed hands in person.</p>

          <div class="class-form-dialog-footer">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="primary-btn">Order</button>
          </div>
        </form>
      </dialog>

      <%# A real request: "button called fulfillment totals. Popup, show
          counts for all order that need to be filled. Example product
          title, option, qty. Repeat for each different product title and
          option that is different. This can be used for bulk product
          totals." - every 'paid' (not yet fulfilled) order item, summed
          by product + option (utils/store.js's own fulfillmentTotals). %>
      <dialog id="fulfillment-totals-dialog" class="member-picker-dialog">
        <h3>Fulfillment Totals</h3>
        <p class="hint">Everything still needing to be filled, across every paid order.</p>
        <% if (fulfillmentTotals.length === 0) { %>
          <p class="roster-empty">Nothing needs fulfilling right now.</p>
        <% } else { %>
          <div class="roster-scroll">
            <table class="roster-table condensed-table">
              <thead><tr><th>Product</th><th>Option</th><th>Qty</th></tr></thead>
              <tbody>
                <% fulfillmentTotals.forEach(function(row) { %>
                  <tr>
                    <td class="roster-name-col"><%= row.productName %></td>
                    <td><%= row.optionName || '–' %></td>
                    <td><%= row.qty %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
        </div>
      </dialog>
    <% } %>

    <% if (activeTab === 'archived') { %>
      <% if (archived.length === 0) { %>
        <p class="roster-empty">No archived products.</p>
      <% } else { %>
        <div class="team-card-grid">
          <% archived.forEach(function(p) { %>
            <div class="team-col">
              <div class="team-info-card">
                <h3 class="team-info-title"><%= p.name %></h3>
                <span class="badge-pill badge-pill-gray">Archived</span>
                <% if (p.categoryName) { %><span class="badge-pill"><%= p.categoryName %></span><% } %>
                <p class="hint">$<%= (p.price_cents / 100).toFixed(2) %></p>
                <div class="roster-btn-row">
                  <form method="POST" action="/main-admin/store/<%= p.id %>/status" class="inline-block-form">
                    <input type="hidden" name="status" value="draft" />
                    <input type="hidden" name="redirectTo" value="/main-admin/store?tab=archived" />
                    <button type="submit" class="roster-action-btn">Restore</button>
                  </form>
                  <form method="POST" action="/main-admin/store/<%= p.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= p.name %>&quot;? This cannot be undone.">
                    <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% } %>

    <%
    // A real request: "Store, analytics sub page. Shows graph of total
    // sales with filter drop down for today, this week, month, 3 months,
    // 6 month, 12 months, all time. Shows sale totals for each product
    // and product option in a card with three columns." Single-series
    // magnitude-over-time -> a plain bar chart, one brand hue, no legend
    // needed (see the dataviz skill's own form-heuristic for why a
    // one-series chart skips the legend box).
    const maxCents = analytics ? Math.max(1, ...analytics.dailyTotals.map(function (d) { return d.totalCents; })) : 1;
    const CHART_HEIGHT = 160;
    %>
    <% if (activeTab === 'analytics') { %>
      <form method="GET" action="/main-admin/store" class="inline-block-form">
        <input type="hidden" name="tab" value="analytics" />
        <label>Date Range
          <select name="range" onchange="this.form.submit()">
            <% analyticsRanges.forEach(function(r) { %>
              <option value="<%= r.key %>" <%= analyticsRange === r.key ? 'selected' : '' %>><%= r.label %></option>
            <% }); %>
          </select>
        </label>
      </form>

      <div class="manage-section">
        <div class="grid-box-header">
          <h2>Total Sales</h2>
          <span class="hint"><%= analytics.orderCount %> order<%= analytics.orderCount === 1 ? '' : 's' %> &middot; $<%= (analytics.totalCents / 100).toFixed(2) %></span>
        </div>
        <% if (analytics.dailyTotals.length === 0) { %>
          <p class="roster-empty">No sales in this range.</p>
        <% } else { %>
          <svg class="store-sales-chart" viewBox="0 0 <%= analytics.dailyTotals.length * 44 %> <%= CHART_HEIGHT + 26 %>" role="img" aria-label="Total sales over time" preserveAspectRatio="xMinYMin meet">
            <% analytics.dailyTotals.forEach(function(d, i) { %>
              <% const barHeight = Math.max(2, Math.round((d.totalCents / maxCents) * CHART_HEIGHT)); %>
              <rect x="<%= i * 44 + 8 %>" y="<%= CHART_HEIGHT - barHeight %>" width="28" height="<%= barHeight %>" rx="4" class="store-sales-bar">
                <title><%= d.date %>: $<%= (d.totalCents / 100).toFixed(2) %></title>
              </rect>
              <text x="<%= i * 44 + 22 %>" y="<%= CHART_HEIGHT + 16 %>" class="store-sales-bar-label" text-anchor="middle"><%= analytics.bucketedByMonth ? d.date : d.date.slice(5) %></text>
            <% }); %>
          </svg>
        <% } %>
      </div>

      <div class="manage-section">
        <div class="grid-box-header"><h2>Sales By Product</h2></div>
        <% if (analytics.byProductOption.length === 0) { %>
          <p class="roster-empty">No sales in this range.</p>
        <% } else { %>
          <div class="team-card-grid">
            <% analytics.byProductOption.forEach(function(row) { %>
              <div class="team-col">
                <div class="team-info-card store-analytics-card">
                  <span class="store-analytics-name"><%= row.productName %><% if (row.optionName) { %><br /><span class="hint"><%= row.optionName %></span><% } %></span>
                  <span class="store-analytics-figure"><%= row.qty %><br /><span class="hint">sold</span></span>
                  <span class="store-analytics-figure">$<%= (row.totalCents / 100).toFixed(2) %><br /><span class="hint">total</span></span>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    <% } %>

    <%# A real request: "Main admin portal. Shop. Add a subpage called
        settings. This where general store settings will happen." Same
        singleton-row shape and layout as the Events Settings tab
        (views/admin-events-list.ejs) - routes/admin-store.js's own
        updateStoreSettings. %>
    <% if (activeTab === 'settings') { %>
      <form method="POST" action="/main-admin/store/settings" class="stack-form member-form-page-panel">
        <h2>General Settings</h2>
        <div class="member-form-grid">
          <div class="member-form-full checkbox-group checkbox-group-stack">
            <label class="checkbox-option"><input type="checkbox" name="storeEnabled" value="1" <%= storeSettings.store_enabled ? 'checked' : '' %> /> Shop open for online purchases?</label>
          </div>
          <p class="hint member-form-full">Turning this off hides the member-facing Shop and product pages without archiving any products - recording an In-Person Sale from the Orders tab still works either way.</p>
          <label class="member-form-full">Welcome Message <span class="hint">(shown at the top of the member Shop homepage)</span>
            <textarea name="welcomeMessage" rows="3"><%= storeSettings.welcome_message || '' %></textarea>
          </label>
          <label class="member-form-full">Pickup Instructions <span class="hint">(shown on a member's own order page)</span>
            <textarea name="pickupInstructions" rows="3"><%= storeSettings.pickup_instructions || '' %></textarea>
          </label>
          <label class="member-form-full">Order Notification Email
            <input type="email" name="orderNotificationEmail" value="<%= storeSettings.order_notification_email || '' %>" placeholder="admin@example.com" />
          </label>
        </div>
        <div class="member-form-footer">
          <div class="member-form-footer-edit">
            <button type="submit" class="primary-btn">Save Settings</button>
          </div>
        </div>
      </form>
    <% } %>
  </main>
</body>
</html>
