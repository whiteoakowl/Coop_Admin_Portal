<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="roster-toolbar no-print">
      <h1>Teachers/Assistants</h1>
      <div class="roster-btn-row">
        <%# A real request: "organized by schedule grid semester with a
            dropdown filter" - a plain Semester-only select, same shape as
            the Classes grid's own standalone Semester filter (views/
            partials/class-schedule-grid.ejs) - NOT the shared semester+
            day combo picker (partials/schedule-combo-picker.ejs), since
            this list spans every day at once per teacher rather than
            showing one day's own grid. %>
        <form method="GET" action="/admin/teachers" class="category-filter">
          <label for="teachers-semester-select">Semester</label>
          <select id="teachers-semester-select" name="semesterId" onchange="this.form.submit()">
            <option value="" <%= !selectedSemesterId ? 'selected' : '' %>>All Semesters</option>
            <% semesters.forEach(function(s) { %>
              <option value="<%= s.id %>" <%= selectedSemesterId === s.id ? 'selected' : '' %>><%= s.title %></option>
            <% }); %>
          </select>
        </form>
      </div>
    </div>

    <% if (members.length === 0) { %>
      <p class="roster-empty">No teachers or assistants are staffed on a class<%= selectedSemesterId ? ' for this semester' : '' %> yet.</p>
    <% } else { %>
      <%# A real request: "If a teacher teaches multiple classes they will
          all be listed under the members name with a dropdown arrow and
          minimize feature" - <details>/<summary> is this app's own
          established collapsible idiom (e.g. the Filter popup's own
          filter-details), so a teacher with more than one class gets a
          real collapse/expand arrow for free; a single-class teacher
          just shows that one class inline since there's nothing to
          collapse. "Organized alphabetical by last name" - members is
          already byLastName-sorted server-side (routes/admin-teachers.js). %>
      <ul class="teacher-list">
        <% members.forEach(function(m) { %>
          <li class="teacher-list-item">
            <% if (m.classes.length > 1) { %>
              <details>
                <summary><%= m.name %> <span class="teacher-class-count">(<%= m.classes.length %> classes)</span></summary>
                <ul class="teacher-class-list">
                  <% m.classes.forEach(function(c) { %>
                    <%# A real request: "You can click on the class and it
                        will go to the class" - a full admin goes straight
                        to the class's own tabbed manage page (same click
                        target the Classes grid's own cards already use,
                        public/js/class-schedule-view.js), but that page
                        is requireFullAdmin-gated; a non-full Co-op Admin
                        (who can still see this list at all - see admin-
                        nav.ejs's own comment) instead lands on that
                        class's own day grid, the closest a read-only
                        viewer can actually open. %>
                    <li>
                      <a href="<%= isFullAdmin ? `/admin/class-schedule/classes/${c.id}/manage` : `/admin/schedule?tab=${c.day}${selectedSemesterId ? '&semesterId=' + selectedSemesterId : ''}` %>">
                        <span class="teacher-class-name"><%= c.className %></span>
                        <span class="teacher-class-role"><%= c.role === 'teacher' ? 'Teacher' : 'Assistant' %></span>
                        <span class="teacher-class-meta"><%= c.dayLabel %><%= c.timeLabel ? ' · ' + c.timeLabel : '' %><%= c.room ? ' · ' + c.room : '' %></span>
                      </a>
                    </li>
                  <% }); %>
                </ul>
              </details>
            <% } else { %>
              <%
                var onlyClass = m.classes[0];
                var onlyClassHref = isFullAdmin
                  ? `/admin/class-schedule/classes/${onlyClass.id}/manage`
                  : `/admin/schedule?tab=${onlyClass.day}${selectedSemesterId ? '&semesterId=' + selectedSemesterId : ''}`;
              %>
              <span class="teacher-list-name"><%= m.name %></span>
              <a class="teacher-single-class" href="<%= onlyClassHref %>">
                <span class="teacher-class-name"><%= onlyClass.className %></span>
                <span class="teacher-class-role"><%= onlyClass.role === 'teacher' ? 'Teacher' : 'Assistant' %></span>
                <span class="teacher-class-meta"><%= onlyClass.dayLabel %><%= onlyClass.timeLabel ? ' · ' + onlyClass.timeLabel : '' %><%= onlyClass.room ? ' · ' + onlyClass.room : '' %></span>
              </a>
            <% } %>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </main>
</body>
</html>
