<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Member Directory</h1>
    <p class="hint"><%= memberCount %> active member<%= memberCount == 1 ? '' : 's' %> currently visible (fewer if any have opted themselves out). Choose which fields show for everyone - never turn on more than families should reasonably see.</p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="manage-section">
      <form method="POST" action="/main-admin/member-directory/fields">
        <% fieldSettings.forEach(function(f) { %>
          <label class="grade-pill"><input type="checkbox" name="fields" value="<%= f.key %>" <%= f.visible ? 'checked' : '' %> /> <%= f.label %></label>
        <% }); %>
        <div class="member-form-full" style="margin-top: 1rem;">
          <button type="submit" class="primary-btn">Save</button>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
