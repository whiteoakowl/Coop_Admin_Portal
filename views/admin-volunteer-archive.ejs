<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main" data-day="<%= day %>">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= dayLabel %> Floater Archive</p>
      </div>
    </div>

    <h1>Floater Assignments</h1>

    <%- include('partials/floater-tabs', { day, activeFloaterTab: 'archive' }) %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="view-tab-panel">
      <div class="roster-toolbar no-print">
        <div class="day-toggle">
          <a class="day-toggle-option<%= day === 'monday' ? ' active' : '' %>" href="/admin/volunteers/monday/archive">Monday</a>
          <a class="day-toggle-option<%= day === 'wednesday' ? ' active' : '' %>" href="/admin/volunteers/wednesday/archive">Wednesday</a>
        </div>
        <div class="category-filter" style="margin: 0;">
          <label for="archive-date-select">Choose Date</label>
          <select id="archive-date-select" onchange="window.fullscreenNavigate('/admin/volunteers/<%= day %>/archive' + (this.value ? '?date=' + this.value : ''))">
            <option value="">All dates</option>
            <% dateOptions.forEach(function(d) { %>
              <option value="<%= d.date %>" <%= dateFilter === d.date ? 'selected' : '' %>><%= d.label %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr><th>Date</th><th>Positions</th><th>Assigned</th><th class="no-print">Actions</th></tr>
          </thead>
          <tbody>
            <% if (rows.length === 0) { %>
              <tr><td colspan="4" class="roster-empty">No archived dates<%= dateFilter ? ' for this date' : ' yet' %> - archive one from the Floater Assignments manage page's Edit Dates dialog.</td></tr>
            <% } %>
            <% rows.forEach(function(r) { %>
              <tr>
                <td><button type="button" class="member-name-link" data-view-archive-date="<%= r.date %>"><%= r.label %></button></td>
                <td><%= r.totalPositions %></td>
                <td><%= r.assignedCount %> of <%= r.totalPositions %></td>
                <td class="actions-cell no-print">
                  <%# A misclicked Archive shouldn't be a dead end - puts
                      the date right back on the manage page's own Choose
                      Date dropdown. %>
                  <form method="POST" action="/admin/volunteers/<%= day %>/archive/<%= r.date %>/unarchive" class="inline-block-form">
                    <button type="submit" class="link-btn">Restore</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <dialog id="volunteer-archive-view-dialog" class="volunteer-archive-view-dialog"></dialog>
  </main>
  <script src="/js/fragment-dialog.js"></script>
  <script src="/js/volunteer-archive-view.js"></script>
</body>
</html>
