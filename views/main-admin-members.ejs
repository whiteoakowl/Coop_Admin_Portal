<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Members</h1>

    <%# A real request: "under members in main admin portal there should
        be a tab that says approvals... there should be another tab
        under main admin members that says settings... main admin
        protal members should also have an archive tab." A second real
        request: "shrink the tabs to be seen fully on mobile view" -
        public/js/fit-tabs.js (now loaded globally, see views/partials/
        portal-nav.ejs) shrinks this row's font/padding to fit. %>
    <div class="view-tabs">
      <a class="view-tab<%= activeTab === 'members' ? ' active' : '' %>" href="/main-admin/members?tab=members">Members</a>
      <a class="view-tab<%= activeTab === 'approvals' ? ' active' : '' %>" href="/main-admin/members?tab=approvals">Approvals<%= (typeof pending !== 'undefined' && pending.length) ? ' (' + pending.length + ')' : '' %></a>
      <a class="view-tab<%= activeTab === 'settings' ? ' active' : '' %>" href="/main-admin/members?tab=settings">Settings</a>
      <a class="view-tab<%= activeTab === 'archive' ? ' active' : '' %>" href="/main-admin/members?tab=archive">Archive</a>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (activeTab === 'members' || activeTab === 'archive') { %>
      <p class="hint">The full family/member roster - the same records the Co-op Admin Portal's attendance, rosters, and schedules all draw from.</p>

      <%# Same shape as routes/admin-members.js's own bulk-permissions form -
          see that file's own comment. %>
      <form id="permissions-bulk-form" method="POST" action="/main-admin/members/bulk-permissions"></form>
      <%# Default action is the safe one (Archive) rather than Delete -
          public/js/members-bulk-actions.js always overwrites this with
          whichever dropdown option was actually picked before submitting,
          but a bare fallback submit (see that file's own comment on
          submitter-less requestSubmit()) should never land on the
          destructive route now that Delete isn't even offered here. %>
      <form id="members-select-form" method="POST" action="/main-admin/members/bulk-archive"></form>

      <%# A real request: "add member button, edit permissions button,
          edit, import, export buttons should be under the member tab
          above filter." Members tab only - Archive doesn't add/import
          members. %>
      <% if (activeTab === 'members') { %>
        <%# A real request: "mobile the buttons should all be the same size
            as the smaller buttons. keep the same height and make the
            width bigger as necessary to fit text. should fit in 2 clean
            rows." Same roster-btn-row-fit-text treatment already used for
            every other toolbar with a mix of short/long button labels
            (Attendance, Setup/Cleanup, Class Edit) - see styles.css's own
            comment on that class. + Add Member switches from primary-btn
            to roster-action-btn so it's sized the same as its neighbors
            here too, matching Setup/Cleanup's own "Edit Dates"
            precedent. %>
        <div class="roster-btn-row roster-btn-row-fit-text no-print">
          <a class="roster-action-btn" href="/main-admin/members/new">+ Add Member</a>
          <button type="button" class="roster-action-btn" data-permissions-toggle="members-table" aria-pressed="false">Edit Permissions</button>
          <button type="submit" form="permissions-bulk-form" class="roster-action-btn" data-permissions-save="members-table" hidden>Save Permissions</button>
          <button type="button" class="roster-action-btn" data-archive-toggle="members-select-form" data-archive-toggle-label="Edit" aria-pressed="false">Edit</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('main-admin-import-dialog').showModal()">Import</button>
          <a class="roster-action-btn file-action-btn" href="/main-admin/members/export.csv<%= (typeFilter || familyFilter) ? '?' : '' %><%= typeFilter ? 'type=' + typeFilter : '' %><%= (typeFilter && familyFilter) ? '&' : '' %><%= familyFilter ? 'family=' + familyFilter : '' %>">Export</a>
          <%# A real request: "make every member a user... give everyone
              the password changeme123. all members will have accounts."
              One-shot bulk bootstrap (routes/main-admin-members.js's own
              POST /bulk-create-accounts) - skips anyone who already has
              an account or has no email on file. %>
          <form method="POST" action="/main-admin/members/bulk-create-accounts" class="inline-block-form" data-confirm="Create a portal account (password: changeme123) for every member who doesn't have one yet? This can't be limited to a smaller group afterward.">
            <button type="submit" class="roster-action-btn">Create Accounts</button>
          </form>
        </div>

        <dialog id="main-admin-import-dialog" class="member-picker-dialog">
          <form method="POST" action="/main-admin/members/import" enctype="multipart/form-data">
            <h3>Import</h3>
            <a class="btn-secondary import-sample-link" href="/main-admin/members/import-template.xlsx">Download Sample File</a>
            <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
            <div class="notes-dialog-actions">
              <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
              <button type="submit" class="primary-btn">Import</button>
            </div>
          </form>
        </dialog>
      <% } %>

      <div class="roster-toolbar no-print">
        <form method="GET" action="/main-admin/members" class="category-filter" style="margin: 0;">
          <input type="hidden" name="tab" value="<%= activeTab %>" />
          <label for="q-input">Search by name</label>
          <input id="q-input" type="search" name="q" value="<%= q %>" placeholder="Search members&hellip;" />
        </form>
        <div class="category-filter" style="margin: 0;">
          <label for="type-select">Filter</label>
          <select id="type-select" onchange="window.location = this.value">
            <option value="/main-admin/members?tab=<%= activeTab %>" <%= (!typeFilter && !familyFilter) ? 'selected' : '' %>>All</option>
            <option value="/main-admin/members?tab=<%= activeTab %>&type=parent" <%= typeFilter === 'parent' ? 'selected' : '' %>>Parent</option>
            <option value="/main-admin/members?tab=<%= activeTab %>&type=student" <%= typeFilter === 'student' ? 'selected' : '' %>>Student</option>
            <option value="/main-admin/members?tab=<%= activeTab %>&type=admin" <%= typeFilter === 'admin' ? 'selected' : '' %>>Admin</option>
            <% if (families.length > 0) { %>
              <optgroup label="Family">
                <% families.forEach(function(f) { %>
                  <option value="/main-admin/members?tab=<%= activeTab %>&family=<%= f.id %>" <%= familyFilter === f.id ? 'selected' : '' %>><%= f.name %></option>
                <% }); %>
              </optgroup>
            <% } %>
          </select>
        </div>
        <%# Edit mode's Select All + Actions dropdown - hidden until the
            "Edit" toggle button above is clicked. A real request: "there
            should be an edit button on member page that says edit. when
            you click it it will show check boxes next to every member.
            you can select individusl, all or none, a dropdown also
            appears and says actions, delete or archive are the
            options." Members tab only - Archive already has its own
            per-row Reactivate button below.
            A later real request: "remove trash button from each member.
            you must archive the member and then they can be deleted
            while archived" - Delete dropped from this Members-tab
            dropdown for the same reason it was dropped from the per-row
            actions below; the bulk-delete route (routes/main-admin-
            members.js's own POST /bulk-delete) is otherwise unreferenced
            now, kept only so a per-row Archive-tab Delete still works. %>
        <% if (activeTab === 'members') { %>
          <div class="class-schedule-archive-controls" data-archive-controls="members-select-form" hidden>
            <label class="checkbox-option class-schedule-select-all">
              <input type="checkbox" data-select-all-for="members-select-form" />
              Select All
            </label>
            <select data-bulk-action-select form="members-select-form" aria-label="Actions">
              <option value="">Actions</option>
              <option
                value="archive"
                data-bulk-action="/main-admin/members/bulk-archive"
                data-bulk-confirm="Archive the selected member(s)? They'll move to the Archive tab, but nothing is deleted."
                data-bulk-confirm-yes-label="Yes, Archive"
                data-bulk-confirm-safe="1"
              >Archive</option>
            </select>
          </div>
        <% } %>
      </div>

      <% if (activeTab === 'members') { %>
        <details class="manage-section" style="margin-bottom: 1rem;">
          <summary><svg class="icon"><use href="#icon-users"/></svg> Add a Family</summary>
          <form method="POST" action="/main-admin/members/families/new" class="stack-form" style="margin-top: 0.75rem;">
            <label class="member-form-full">Family Name
              <input type="text" name="name" placeholder="e.g. Smith" required />
            </label>
            <button type="submit" class="primary-btn">Add Family</button>
          </form>
          <% if (families.length > 0) { %>
            <table class="roster-table condensed-table" style="margin-top: 1rem;">
              <thead><tr><th>Family</th><th>Active Members</th><th>Actions</th></tr></thead>
              <tbody>
                <% families.forEach(function(f) { %>
                  <tr>
                    <td>
                      <form method="POST" action="/main-admin/members/families/<%= f.id %>/rename" class="inline-block-form">
                        <input type="text" name="name" value="<%= f.name %>" style="width: 12rem;" />
                        <button type="submit" class="icon-btn" aria-label="Rename family" title="Rename"><svg class="icon"><use href="#icon-save"/></svg></button>
                      </form>
                    </td>
                    <td><%= f.memberCount %></td>
                    <td>
                      <form method="POST" action="/main-admin/members/families/<%= f.id %>/delete" class="inline-block-form" data-confirm="Delete the &quot;<%= f.name %>&quot; family? Its members stay in the roster, just ungrouped.">
                        <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete family" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        </details>
      <% } %>

      <% if (members.length === 0) { %>
        <p class="roster-empty"><%= showArchived ? 'No archived members.' : 'No members match this filter yet.' %></p>
      <% } else { %>
        <div class="roster-scroll">
          <%# A real request: "member list on main admin should look like
              the member list on co-op admin" - same photo-thumb column and
              data-family-key/members-col-name/members-list-table markup
              public/js/members-family-collapse.js (already shared with
              views/admin-members.ejs) needs to collapse each family down
              to just its primary parent's row, click to expand. members
              arrives already sorted primary-parent-first per family (see
              utils/members.js's membersWithDetails -> sortMembersByFamily),
              same as Co-op Admin's own list. %>
          <table id="members-table" class="roster-table members-table members-list-table condensed-table">
            <thead>
              <tr>
                <% if (activeTab === 'members') { %><th class="no-print"><span class="sr-only">Select</span></th><% } %>
                <th class="members-col-photo"><span class="sr-only">Photo</span></th>
                <th>Name</th>
                <%# A real request: "instead of showing type on the member
                    row mobile view show the sections a family is listed
                    in." Type stays the desktop column; .members-col-
                    sections (hidden on desktop, shown only on mobile -
                    see public/css/styles.css's own comment) takes its
                    place there, same swap admin-members.ejs's own
                    Type -> Roster Day already does. %>
                <th class="members-col-type">Type</th>
                <th class="members-col-sections">Sections</th>
                <th class="members-col-parent">Family</th>
                <th class="members-col-agegrade">Age/Grade</th>
                <th class="members-col-contact">Contact</th>
                <th class="permissions-col">Sections &amp; Portal Permissions</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% members.forEach(function(m) { %>
                <tr data-family-key="<%= m.family_id != null ? 'f' + m.family_id : 'solo' + m.id %>">
                  <% if (activeTab === 'members') { %>
                    <td class="no-print">
                      <input type="checkbox" name="memberIds" value="<%= m.id %>" form="members-select-form" class="archive-select-checkbox no-print" aria-label="Select <%= m.name %>" hidden />
                    </td>
                  <% } %>
                  <td class="members-col-photo">
                    <% if (m.photo_path) { %>
                      <img class="member-thumb" src="<%= photoUrl(m.photo_path) %>" alt="" />
                    <% } else { %>
                      <span class="member-thumb-placeholder"><%= m.name.charAt(0).toUpperCase() %></span>
                    <% } %>
                  </td>
                  <%# A real request: "no edit button, clicking the members
                      name opens their profile to edit." The Name link
                      already went to the member's profile page
                      (main-admin-member-profile.ejs, with its own rich
                      schedule/rosters/attendance history) - that page has
                      its own prominent Edit button up top, so the
                      separate per-row pencil icon below was pure
                      duplication of a click already one tap away. %>
                  <td class="roster-name-col members-col-name">
                    <a href="/main-admin/members/<%= m.id %>"><%= m.name %></a>
                    <% if (m.is_primary_parent) { %><span class="badge-pill" title="Primary Parent"><svg class="icon"><use href="#icon-star"/></svg></span><% } %>
                  </td>
                  <td class="members-col-type"><%= m.member_type === 'admin' ? 'Admin' : m.member_type === 'parent' ? 'Parent' : 'Student' %></td>
                  <td class="members-col-sections">
                    <% var memberSectionIds = sectionIdsByMember[m.id]; %>
                    <% var memberSections = memberSectionIds ? sections.filter(function(s) { return memberSectionIds.has(s.id); }) : []; %>
                    <% if (memberSections.length === 0) { %>
                      <span class="hint">none</span>
                    <% } else { %>
                      <% memberSections.forEach(function(s) { %>
                        <span class="badge-pill"><%= s.name %></span>
                      <% }); %>
                    <% } %>
                  </td>
                  <td class="members-col-parent"><%= m.familyName || '—' %></td>
                  <td class="members-col-agegrade">
                    <% if (m.member_type === 'student') { %>
                      <%= m.grade_level || '—' %><% if (m.age != null) { %> &middot; age <%= m.age %><% } %>
                    <% } else { %>—<% } %>
                  </td>
                  <td class="members-col-contact"><%= m.phone || m.email || '—' %></td>
                  <td class="permissions-col">
                    <input type="hidden" name="memberIds[]" value="<%= m.id %>" form="permissions-bulk-form" />
                    <details class="permissions-cell-group">
                      <summary>Sections</summary>
                      <% if (sections.length === 0) { %>
                        <p class="hint">No sections yet.</p>
                      <% } else { %>
                        <% sections.forEach(function(s) { %>
                          <label class="checkbox-option">
                            <input type="checkbox" name="sections_<%= m.id %>[]" value="<%= s.id %>" form="permissions-bulk-form" <%= sectionIdsByMember[m.id] && sectionIdsByMember[m.id].has(s.id) ? 'checked' : '' %> />
                            <%= s.name %>
                          </label>
                        <% }); %>
                      <% } %>
                    </details>
                    <details class="permissions-cell-group">
                      <summary>Portal Permissions</summary>
                      <% if (portalStatusByMember[m.id] && portalStatusByMember[m.id].account) { %>
                        <% roles.forEach(function(r) { %>
                          <label class="checkbox-option">
                            <input type="checkbox" name="roles_<%= m.id %>[]" value="<%= r.id %>" form="permissions-bulk-form" <%= portalStatusByMember[m.id].roleIds.has(r.id) ? 'checked' : '' %> />
                            <%= r.label %>
                          </label>
                        <% }); %>
                      <% } else { %>
                        <p class="hint">No portal account &mdash; use the "Create Accounts" button above, or add a password on this member's own <a href="/main-admin/members/<%= m.id %>/edit">Edit</a> page.</p>
                      <% } %>
                    </details>
                  </td>
                  <td class="actions-cell">
                    <div class="actions-btn-row">
                      <%# A real request: "there should be a mail icon on each
                          member line so that you can click and email the
                          member." email opens the phone/desktop's own
                          default mail app (mailto:) - same as a click
                          anywhere else in the app. %>
                      <% if (m.email) { %>
                        <a class="icon-btn" href="mailto:<%= m.email %>" aria-label="Email <%= m.name %>" title="Email <%= m.name %>"><svg class="icon"><use href="#icon-mail"/></svg></a>
                      <% } else { %>
                        <span class="icon-btn icon-btn-disabled" aria-hidden="true" title="No email on file"><svg class="icon"><use href="#icon-mail"/></svg></span>
                      <% } %>
                      <%# A real request: "add a phone icon, linked to their
                          phone number. phone icon opens on your personal
                          cellphone to call or text." tel: is the same
                          "hand off to whatever the device's own phone app
                          is" mechanism mailto: already uses for email. %>
                      <% if (m.phone) { %>
                        <a class="icon-btn" href="tel:<%= m.phone %>" aria-label="Call or text <%= m.name %>" title="Call or text <%= m.name %>"><svg class="icon"><use href="#icon-phone"/></svg></a>
                      <% } else { %>
                        <span class="icon-btn icon-btn-disabled" aria-hidden="true" title="No phone on file"><svg class="icon"><use href="#icon-phone"/></svg></span>
                      <% } %>
                      <%# A real request: "no edit button, clicking the
                          members name opens their profile to edit" - the
                          Name link (above) already opens the member's
                          profile page, which has its own Edit button, so
                          the separate pencil icon here was redundant. %>
                      <% if (showArchived) { %>
                        <%# A real request: "next to each members name
                            under archive there should be a button that
                            says reactivate to make them a member again
                            and remove them from the archive list." %>
                        <form method="POST" action="/main-admin/members/<%= m.id %>/unarchive" class="inline-block-form">
                          <button type="submit" class="roster-action-btn" aria-label="Reactivate <%= m.name %>" title="Reactivate">Reactivate</button>
                        </form>
                        <%# A real request: "remove trash button from each
                            member. you must archive the member and then
                            they can be deleted while archived." - the
                            per-row Delete button only exists here, on the
                            Archive tab, never on the live Members tab. %>
                        <form method="POST" action="/main-admin/members/<%= m.id %>/delete" class="inline-block-form" data-confirm="Permanently delete <%= m.name %>? This removes them from all rosters and attendance history. This cannot be undone.">
                          <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= m.name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                        </form>
                      <% } else { %>
                        <%# A real request: "change archive icon to
                            something for like archive." %>
                        <form method="POST" action="/main-admin/members/<%= m.id %>/archive" class="inline-block-form">
                          <button type="submit" class="icon-btn" aria-label="Archive <%= m.name %>" title="Archive"><svg class="icon"><use href="#icon-archive"/></svg></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>
      <% } %>
    <% } else if (activeTab === 'approvals') { %>
      <%# A real request: "this is where new membership requests appear.
          each line shows primary parent name. you can click the name and
          view their membership form and edit, add portal settings etc.
          save. each member line should have approve button, deny button
          and trash can symbol to delete the request." %>
      <p class="hint">Self-registered members awaiting review. Approving flips their account active and sends the Approval Letter (Settings tab); denying sends the Denial Letter without granting access.</p>
      <% if (pending.length === 0) { %>
        <p class="roster-empty">No membership requests awaiting approval.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table">
            <thead><tr><th>Primary Parent</th><th>Email</th><th>Family</th><th>Requested</th><th></th></tr></thead>
            <tbody>
              <% pending.forEach(function(p) { %>
                <tr>
                  <td class="roster-name-col"><a href="/main-admin/members/<%= p.memberId %>/edit"><%= p.primaryParentName %></a></td>
                  <td><%= p.email %></td>
                  <td><%= p.familyName || '—' %></td>
                  <td><%= p.requestedAtLabel %></td>
                  <td class="actions-cell">
                    <div class="actions-btn-row">
                      <form method="POST" action="/main-admin/members/approvals/<%= p.accountId %>/approve" class="inline-block-form">
                        <button type="submit" class="icon-btn" aria-label="Approve <%= p.primaryParentName %>" title="Approve"><svg class="icon"><use href="#icon-check"/></svg></button>
                      </form>
                      <form method="POST" action="/main-admin/members/approvals/<%= p.accountId %>/deny" class="inline-block-form" data-confirm="Deny <%= p.primaryParentName %>'s membership request? They'll receive the Denial Letter.">
                        <button type="submit" class="icon-btn icon-btn-danger" aria-label="Deny <%= p.primaryParentName %>" title="Deny"><svg class="icon"><use href="#icon-x-circle"/></svg></button>
                      </form>
                      <form method="POST" action="/main-admin/members/approvals/<%= p.accountId %>/delete" class="inline-block-form" data-confirm="Delete <%= p.primaryParentName %>'s membership request? This cannot be undone.">
                        <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete request from <%= p.primaryParentName %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } else if (activeTab === 'settings') { %>
      <%# A real request: "this will have an approval and deny letter
          that can be edited by admin. these letters are sent
          automatically went approve or deny buttons are clicked." A
          second real request: "approval and denial messages should have
          the same text editing icons we added to other chat boxes" -
          same forum-editor-toolbar/forum-editor.js rich-text component
          the Policy Handbook editor below already uses. %>
      <p class="hint">Use <code>{{name}}</code> anywhere in the subject or body to insert the applicant's name.</p>
      <%
        // The two letters were plain text (newline-separated paragraphs)
        // before this editor existed - dropped straight into a
        // contenteditable div, a run of newlines collapses to a single
        // space in HTML, losing the paragraph breaks on first load even
        // though the underlying saved text is untouched. Detecting "no
        // HTML tags yet" and turning newlines into real breaks only for
        // that initial fill (not the stored value) keeps a legacy letter
        // readable until the next time an admin saves it as real HTML.
        function toEditableHtml(text) {
          if (/<[a-z][\s\S]*>/i.test(text || '')) return text;
          const esc = (text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          return esc.split(/\n{2,}/).map((p) => '<p>' + p.replace(/\n/g, '<br>') + '</p>').join('');
        }
      %>
      <div class="manage-section">
        <h2>Approval Letter</h2>
        <form method="POST" action="/main-admin/members/settings/letters/approval" class="stack-form" data-forum-editor>
          <label class="member-form-full">Subject
            <input type="text" name="subject" value="<%= templates.approval.subject %>" required />
          </label>
          <%- include('partials/forum-editor-toolbar') %>
          <div class="forum-editable" data-forum-editable contenteditable="true"><%- toEditableHtml(templates.approval.body) %></div>
          <input type="hidden" name="body" data-forum-body-input />
          <button type="submit" class="primary-btn">Save Approval Letter</button>
        </form>
      </div>
      <div class="manage-section">
        <h2>Denial Letter</h2>
        <form method="POST" action="/main-admin/members/settings/letters/denial" class="stack-form" data-forum-editor>
          <label class="member-form-full">Subject
            <input type="text" name="subject" value="<%= templates.denial.subject %>" required />
          </label>
          <%- include('partials/forum-editor-toolbar') %>
          <div class="forum-editable" data-forum-editable contenteditable="true"><%- toEditableHtml(templates.denial.body) %></div>
          <input type="hidden" name="body" data-forum-body-input />
          <button type="submit" class="primary-btn">Save Denial Letter</button>
        </form>
      </div>

      <%# A real request: "there should be a place at the bottom of the
          membership application to check a box after reading the policy
          handbook. can't check the box until you have scrolled through
          the entire handbook." What's written here is what a family
          reads and must scroll through on the public application
          (views/portal-register.ejs) before they can submit. %>
      <div class="manage-section">
        <h2>Policy Handbook</h2>
        <p class="hint">Shown on the public membership application - an applicant must scroll through this before they can check the "I have read the Policy Handbook" box and submit.</p>
        <form method="POST" action="/main-admin/members/settings/handbook" class="stack-form" data-forum-editor>
          <%- include('partials/forum-editor-toolbar') %>
          <div class="forum-editable" data-forum-editable contenteditable="true"><%- handbookHtml %></div>
          <input type="hidden" name="handbookHtml" data-forum-body-input />
          <button type="submit" class="primary-btn">Save Policy Handbook</button>
        </form>
      </div>

      <%# A real request: "place at the bottom of the application for
          payment." This app has no online "pay now" flow anywhere (see
          utils/membershipHandbook.js's own comment) - what's saved here
          is the fee amount and how a family actually pays, shown as
          information on the application, not a checkout. %>
      <div class="manage-section">
        <h2>Membership Fee &amp; Payment</h2>
        <p class="hint">Shown on the public membership application. Leave the fee at $0 to hide the fee amount and just show the instructions.</p>
        <form method="POST" action="/main-admin/members/settings/payment" class="stack-form">
          <label>Membership Fee (USD)
            <input type="number" name="feeDollars" min="0" step="0.01" value="<%= (paymentInfo.feeCents / 100).toFixed(2) %>" />
          </label>
          <label class="member-form-full">Payment Instructions
            <textarea name="instructions" rows="4" placeholder="e.g. Pay by cash, check, or Venmo once your registration is approved."><%= paymentInfo.instructions %></textarea>
          </label>
          <button type="submit" class="primary-btn">Save Payment Info</button>
        </form>
      </div>

      <%# A real request: "under members in main admin portal there
          should be a settings tab for editing and adding parts of the
          membership form." Admin-defined extra questions, shown on both
          the admin-entered Membership Form/Add Member forms and the
          public self-registration application. %>
      <div class="manage-section">
        <h2>Membership Form Fields</h2>
        <p class="hint">Extra questions shown on the Parent/Guardian and Student sections of every form that adds a new family member.</p>
        <%- include('partials/membership-fields-manager', { target: 'parent', label: 'Parent', fields: parentFormFields, fieldTypes }) %>
        <%- include('partials/membership-fields-manager', { target: 'child', label: 'Student', fields: childFormFields, fieldTypes }) %>
      </div>
    <% } %>
  </main>
  <script src="/js/permissions-edit-toggle.js"></script>
  <script src="/js/members-family-collapse.js"></script>
  <script src="/js/archive-select-toggle.js"></script>
  <script src="/js/members-bulk-actions.js"></script>
  <% if (activeTab === 'settings') { %>
    <script src="/js/forum-editor.js"></script>
    <script src="/js/membership-field-type-toggle.js"></script>
  <% } %>
</body>
</html>
