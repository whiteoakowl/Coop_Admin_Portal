<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%# A real request: "add a print button to member list" - only the
        members/archive tabs render an actual roster worth a branded print
        header; Approvals/Settings render this same view too (with no
        showArchived of their own - see routes/main-admin-members.js) and
        have nothing print-worthy on them. %>
    <% if (activeTab === 'members' || activeTab === 'archive') { %>
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub"><%= showArchived ? 'Archived Members' : 'Members' %></p>
        </div>
      </div>
    <% } %>
    <h1><%= activeTab === 'approvals' ? 'Approvals' : activeTab === 'archive' ? 'Archive' : activeTab === 'settings' ? 'Settings' : 'Members' %></h1>

    <%# A real request: "under members in main admin portal there should
        be a tab that says approvals... there should be another tab
        under main admin members that says settings... main admin
        protal members should also have an archive tab." These tabs now
        live as subpages under the orange bar's own Members item instead
        of any markup on this page itself (views/partials/portal-nav.ejs's
        own MAIN_ADMIN_NAV_LINKS/mobile-subpages-tab.ejs) - desktop gets
        them as a sidebar dropdown, mobile as a popup reachable from any
        page, both driven by public/js/admin-nav-accordion.js. %>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (activeTab === 'members' || activeTab === 'archive') { %>
      <%# Default action is the safe one (Archive) rather than Delete -
          public/js/members-bulk-edit.js always overwrites this with
          whichever Bulk Edit action was actually chosen before the
          dialog's own Apply submits. %>
      <form id="members-select-form" method="POST" action="/main-admin/members/bulk-archive"></form>

      <%# A real request: "add member button, edit permissions button,
          edit, import, export buttons should be under the member tab
          above filter." Members tab only - Archive doesn't add/import
          members. %>
      <% if (activeTab === 'members') { %>
        <%# A real request: "mobile the buttons should all be the same size
            as the smaller buttons. keep the same height and make the
            width bigger as necessary to fit text. should fit in 2 clean
            rows." Same roster-btn-row-fit-text treatment already used for
            every other toolbar with a mix of short/long button labels
            (Attendance, Setup/Cleanup, Class Edit) - see styles.css's own
            comment on that class. + Add Member switches from primary-btn
            to roster-action-btn so it's sized the same as its neighbors
            here too, matching Setup/Cleanup's own "Edit Dates"
            precedent. %>
        <%# A real request: "delete create account button. every member
            already automatically has an account. instead there can be
            an add member button" - the old "Create Accounts" bulk
            bootstrap button (routes/main-admin-members.js's own POST
            /bulk-create-accounts, still there for a direct retrofit of
            any pre-existing member without one) is dropped from here;
            + Add Member already opens the full membership form
            (member-intake-form.ejs) to manually add a family and its
            members, which is what "instead" asked for. %>
        <%# A real request: "member page button order on mobile. Add
            member, edit member list, add/edit family. 2nd row
            underneath, edit permissions, add/edit sections. 3rd row
            underneath filter, import, export, print." Reordered to
            match, with two mobile-only .roster-btn-row-break spacers
            (styles.css) forcing exactly those 3/2/4 groupings on a
            narrow phone regardless of how each button's own text width
            would otherwise wrap - desktop is untouched (those spacers
            render as nothing there, same flex-wrap-as-space-allows
            layout as before). The Filter dropdown moves into this row
            as "row 3"'s lead item (partials/members-type-filter.ejs,
            shared with the Archive tab's own copy further down, which
            has no button toolbar of its own to join). %>
        <div class="roster-btn-row roster-btn-row-fit-text no-print">
          <a class="roster-action-btn" href="/main-admin/members/new">+ Add Member</a>
          <%# A real request: "remove manage family blue bar and make it
              an orange button with the rest of the orange buttons that
              says add/edit family" - replaces the old standalone
              .members-add-family-card that used to sit further down this
              page; same #manage-families-dialog, just opened from here
              now. %>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('manage-families-dialog').showModal()">Add/Edit Family</button>
          <span class="roster-btn-row-break" aria-hidden="true"></span>
          <%# A real request: "Add a button that's says grade level
              report." %>
          <a class="roster-action-btn" href="/main-admin/members/grade-level-report">Grade Level Report</a>
          <span class="roster-btn-row-break" aria-hidden="true"></span>
          <%- include('partials/members-type-filter', { activeTab, typeFilter, familyFilter, families }) %>
          <button type="button" class="icon-btn" onclick="document.getElementById('main-admin-import-dialog').showModal()" aria-label="Import" title="Import"><svg class="icon"><use href="#icon-upload"/></svg></button>
          <%# A real request: "change export and print buttons to icons" -
              same icon-btn + icon-download/icon-printer pattern already
              used elsewhere (e.g. views/admin-accounting-list.ejs's own
              toolbar). %>
          <a class="icon-btn" href="/main-admin/members/export.csv<%= (typeFilter || familyFilter) ? '?' : '' %><%= typeFilter ? 'type=' + typeFilter : '' %><%= (typeFilter && familyFilter) ? '&' : '' %><%= familyFilter ? 'family=' + familyFilter : '' %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
          <%# A real request: "all print button should show a print
              preview full real page on a page with a print button" -
              opens the dedicated main-admin-members-print.ejs view in a
              new tab instead of printing this interactive card list in
              place (see routes/main-admin-members.js's own GET /print).
              Carries the same Type/Family/search filters as Export CSV
              above, plus the search box's own q. %>
          <a class="icon-btn" href="/main-admin/members/print<%= (typeFilter || familyFilter || q) ? '?' : '' %><%= typeFilter ? 'type=' + typeFilter : '' %><%= (typeFilter && familyFilter) ? '&' : '' %><%= familyFilter ? 'family=' + familyFilter : '' %><%= ((typeFilter || familyFilter) && q) ? '&' : '' %><%= q ? 'q=' + encodeURIComponent(q) : '' %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
        </div>

        <dialog id="main-admin-import-dialog" class="member-picker-dialog">
          <form method="POST" action="/main-admin/members/import" enctype="multipart/form-data">
            <h3>Import</h3>
            <a class="btn-secondary import-sample-link" href="/main-admin/members/import-template.xlsx">Download Sample File</a>
            <input type="file" name="file" accept=".csv,.txt,.xlsx" required />
            <div class="notes-dialog-actions">
              <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
              <button type="submit" class="primary-btn">Import</button>
            </div>
          </form>
        </dialog>
      <% } %>

      <%# A real request (Archive tab): "filter button should be first on
          the row. Search bar next to it." Reversed from the Members tab's
          own search-then-filter order (that one keeps its own Filter in
          the button toolbar above, not here) - the Archive tab has no
          such toolbar, so its own copy of the filter leads this row
          instead. %>
      <div class="members-search-filter-row no-print">
        <% if (activeTab !== 'members') { %>
          <%- include('partials/members-type-filter', { activeTab, typeFilter, familyFilter, families }) %>
        <% } %>

        <form method="GET" action="/main-admin/members" class="members-search-bar">
          <input type="hidden" name="tab" value="<%= activeTab %>" />
          <input type="hidden" name="type" value="<%= typeFilter %>" />
          <input type="hidden" name="family" value="<%= familyFilter || '' %>" />
          <svg class="icon"><use href="#icon-search"/></svg>
          <input id="q-input" type="search" name="q" value="<%= q %>" placeholder="Search members&hellip;" aria-label="Search members" />
        </form>
      </div>

      <%# A real request: "Add a column of check boxes in the first
          column of every member. In the title row of this column is a
          single check box, selecting the box will select all and
          deselecting the box will uncheck all." The checkbox column and
          this row are permanently visible now (no more "Edit Member
          List" toggle hiding them).
          A later real request replaced the simple Bulk Action dropdown
          this used to be with a real "Bulk Edit button allows you to
          select 1 or multiple members and add them to a section,
          portal, family, delete, archive, text or email" - one button
          opens #bulk-edit-dialog (public/js/members-bulk-edit.js), which
          picks an action and (for Section/Portal/Family) a contextual
          sub-picker before Apply actually submits #members-select-form.
          Archive already has its own per-row Reactivate button below;
          Members tab only. %>
      <% if (activeTab === 'members') { %>
        <div class="roster-toolbar no-print">
          <div class="class-schedule-archive-controls">
            <label class="checkbox-option class-schedule-select-all">
              <input type="checkbox" data-select-all-for="members-select-form" />
              Select All
            </label>
            <button type="button" class="roster-action-btn" id="bulk-edit-btn">Bulk Edit</button>
          </div>
        </div>

        <dialog id="bulk-edit-dialog" class="member-picker-dialog">
          <h3>Bulk Edit</h3>
          <p class="hint">Applies to every member currently checked in the list below.</p>
          <div class="stack-form">
            <label>Action
              <select id="bulk-edit-action">
                <option value="">Choose an action&hellip;</option>
                <option value="sections">Add to Section(s)</option>
                <option value="roles">Add to Portal(s)</option>
                <option value="family">Add to Family</option>
                <option value="archive">Archive</option>
                <option value="delete">Delete</option>
                <option value="email">Email</option>
                <option value="text">Text</option>
              </select>
            </label>

            <div class="bulk-edit-subfields" id="bulk-edit-sections-fields" hidden>
              <p class="hint">Add every checked member to:</p>
              <% if (sections.length === 0) { %>
                <p class="hint">No sections yet - add one from Settings &gt; Sections.</p>
              <% } else { %>
                <% sections.forEach(function(s) { %>
                  <label class="checkbox-option">
                    <input type="checkbox" name="sectionIds" value="<%= s.id %>" form="members-select-form" />
                    <%= s.name %>
                  </label>
                <% }); %>
              <% } %>
            </div>

            <div class="bulk-edit-subfields" id="bulk-edit-roles-fields" hidden>
              <p class="hint">Grant every checked member (with a portal account) these portal(s):</p>
              <% roles.forEach(function(r) { %>
                <label class="checkbox-option">
                  <input type="checkbox" name="roleIds" value="<%= r.id %>" form="members-select-form" />
                  <%= r.label %>
                </label>
              <% }); %>
              <p class="hint">A member with no portal account yet is skipped - add one from their own Edit page first.</p>
            </div>

            <div class="bulk-edit-subfields" id="bulk-edit-family-fields" hidden>
              <label>Family
                <select name="familyId" form="members-select-form">
                  <option value="">Choose a family&hellip;</option>
                  <% families.forEach(function(f) { %><option value="<%= f.id %>"><%= f.name %></option><% }); %>
                </select>
              </label>
            </div>
          </div>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" form="members-select-form" class="primary-btn" id="bulk-edit-apply-btn" disabled>Apply</button>
          </div>
        </dialog>
      <% } %>

      <% if (activeTab === 'members') { %>
        <%# A real request: "add a family drop down should say manage
            families and have all the features of the manage families
            button. Get rid of old manage families button." One entry
            point now instead of a separate "+ Add a Family" card plus a
            second "Manage Families" disclosure - add, rename, and
            delete all live in this one dialog, same shape as Co-op
            Admin's own (views/admin-members.ejs, public/js/edit-
            families.js). A later real request replaced the standalone
            blue "Manage Families" card that used to open this dialog
            with the "Add/Edit Family" button up in the main toolbar row
            instead - this dialog itself is unchanged. %>
        <dialog id="manage-families-dialog" class="notes-dialog">
          <h3>Manage Families</h3>
          <form method="POST" action="/main-admin/members/families/new" class="manage-families-add-form">
            <label>New Family Name
              <input type="text" name="name" placeholder="e.g. Smith" required />
            </label>
            <button type="submit" class="primary-btn">Add</button>
          </form>
          <p id="edit-families-empty" class="hint" <%= families.length > 0 ? 'hidden' : '' %>>No families yet - add one above.</p>
          <ul id="edit-families-list" class="edit-families-list" data-base-path="/main-admin/members" <%= families.length === 0 ? 'hidden' : '' %>>
            <% families.forEach(function(f) { %>
              <li class="edit-families-row" data-family-id="<%= f.id %>">
                <form method="POST" action="/main-admin/members/families/<%= f.id %>/rename" class="edit-families-rename-form">
                  <input type="text" name="name" value="<%= f.name %>" aria-label="Rename <%= f.name %>" />
                  <button type="submit" class="icon-btn" aria-label="Save name for <%= f.name %>" title="Save"><svg class="icon"><use href="#icon-save"/></svg></button>
                </form>
                <span class="hint"><%= f.memberCount %> member<%= f.memberCount === 1 ? '' : 's' %></span>
                <button type="button" class="icon-btn icon-btn-danger" data-delete-family="<%= f.id %>" data-family-name="<%= f.name %>" data-member-count="<%= f.memberCount %>" aria-label="Delete <%= f.name %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
              </li>
            <% }); %>
          </ul>
          <div class="notes-dialog-actions">
            <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Close</button>
          </div>
        </dialog>
      <% } %>

      <div class="members-section-label-row">
        <span class="members-section-label"><%= showArchived ? 'ARCHIVE' : 'MEMBERS' %></span>
        <span class="members-count-pill"><%= pagination.totalItems %> member<%= pagination.totalItems === 1 ? '' : 's' %></span>
      </div>

      <% if (members.length === 0) { %>
        <p class="roster-empty"><%= showArchived ? 'No archived members.' : 'No members match this filter yet.' %></p>
      <% } else { %>
        <%# A real request, with a reference screenshot: cards (colored
            initials avatar, name, a colored role badge, a subline, and a
            row of action icons) instead of a table, same shape as Co-op
            Admin's own Members list (views/admin-members.ejs) - a
            family's non-head members collapse under their primary
            parent (or first-sorting member) until its own chevron is
            clicked, only one family open at a time (public/js/members-
            family-accordion.js, shared with that page). members arrives
            already sorted primary-parent-first per family (see utils/
            members.js's membersWithDetails -> sortMembersByFamily). %>
        <div id="members-table">
          <% members.forEach(function(m) { %>
            <% var familySize = members.filter(function(x) { return x.family_id != null && x.family_id === m.family_id; }).length; %>
            <% var isFamilyHead = m.is_primary_parent || m.family_id == null || familySize < 2; %>
            <div
              class="member-row-card"
              data-family-key="<%= m.family_id != null ? 'f' + m.family_id : 'solo' + m.id %>"
              data-family-member="<%= isFamilyHead ? '' : '1' %>"
            >
              <%# A real request: "arrow for dropdown stays on left side" -
                  moved from the end of .member-row-actions to the front
                  of the card, ahead of the avatar. %>
              <% if (isFamilyHead && familySize > 1) { %>
                <button type="button" class="family-accordion-toggle" aria-expanded="false" aria-label="Show <%= familySize - 1 %> more family member<%= familySize - 1 === 1 ? '' : 's' %>">
                  <svg class="icon"><use href="#icon-chevron-down"/></svg>
                </button>
              <% } else { %>
                <span class="member-row-chevron-spacer"></span>
              <% } %>
              <% if (activeTab === 'members') { %>
                <input type="checkbox" name="memberIds" value="<%= m.id %>" form="members-select-form" class="archive-select-checkbox no-print" aria-label="Select <%= m.name %>" />
              <% } %>
              <span class="member-avatar member-avatar-<%= avatarColorFor(m.family_id != null ? m.family_id : m.id) %>">
                <% if (m.photo_path) { %>
                  <img src="<%= photoUrl(m.photo_path) %>" alt="" />
                <% } else { %>
                  <%= m.name.charAt(0).toUpperCase() %>
                <% } %>
              </span>
              <div class="member-row-body">
                <div class="member-row-topline">
                  <%# A real request: "no edit button, clicking the members
                      name opens their profile to edit." The Name link
                      already goes to the member's profile page (main-
                      admin-member-profile.ejs, with its own rich
                      schedule/rosters/attendance history), which has its
                      own prominent Edit button up top. %>
                  <a class="member-row-name-link" href="/main-admin/members/<%= m.id %>"><%= m.name %></a>
                  <%# A real request: "Admins will simply get a star next
                      to their member name" - member_type === 'admin' is
                      now fully derived from holding an Admin Position
                      (utils/adminPositions.js's own syncMemberAdminStatus),
                      never a manually-chosen checkbox - this star is the
                      only remaining visual sign of it on the member list. %>
                  <% if (m.member_type === 'admin') { %>
                    <span class="member-admin-star" title="Admin"><svg class="icon"><use href="#icon-star"/></svg></span>
                  <% } %>
                  <%# A real request: "member rows remove primary column.
                      it can already be seen when viewing the profile" -
                      the profile page (main-admin-member-profile.ejs)
                      already shows Primary Parent status of its own. %>
                  <span class="badge-pill badge-pill-<%= avatarColorFor(m.family_id != null ? m.family_id : m.id) %> member-role-badge"><svg class="icon"><use href="#icon-star"/></svg> <%= m.member_type === 'admin' ? 'Admin' : m.member_type === 'parent' ? 'Parent' : 'Student' %></span>
                </div>
                <%# A real request: "icons in a row below the name" - grade/
                    age and sections used to be their own stacked rows; a
                    phone-or-email text line used to sit here too, but the
                    row's own phone/mail icon buttons (below) already cover
                    that, so it's redundant and dropped rather than shown
                    twice. %>
                <% var memberSectionIds = sectionIdsByMember[m.id]; %>
                <% var memberSections = memberSectionIds ? sections.filter(function(s) { return memberSectionIds.has(s.id); }) : []; %>
                <% if (m.member_type === 'student' || memberSections.length > 0 || (showArchived && m.archived_at)) { %>
                  <div class="member-row-icon-row">
                    <% if (m.member_type === 'student') { %>
                      <span class="member-row-subline"><svg class="icon"><use href="#icon-graduation-cap"/></svg> <%= m.grade_level || '—' %><% if (m.age != null) { %> &middot; age <%= m.age %><% } %></span>
                    <% } %>
                    <% if (memberSections.length > 0) { %>
                      <span class="member-row-subline"><svg class="icon"><use href="#icon-clipboard-list"/></svg> <%= memberSections.map(function(s) { return s.name; }).join(', ') %></span>
                    <% } %>
                    <%# A real request: "if a member is archived on main
                        admin portal it should show the date they were
                        archived." %>
                    <% if (showArchived && m.archived_at) { %>
                      <span class="member-row-subline"><svg class="icon"><use href="#icon-calendar-check"/></svg> Archived <%= m.archived_at.slice(0, 10) %></span>
                    <% } %>
                  </div>
                <% } %>
              </div>
              <div class="member-row-actions no-print">
                <% if (m.email) { %>
                  <a class="icon-btn" href="mailto:<%= m.email %>" aria-label="Email <%= m.name %>" title="Email <%= m.name %>"><svg class="icon"><use href="#icon-mail"/></svg></a>
                <% } else { %>
                  <span class="icon-btn icon-btn-disabled" aria-hidden="true" title="No email on file"><svg class="icon"><use href="#icon-mail"/></svg></span>
                <% } %>
                <%# A real request: "add a phone icon, linked to their
                    phone number. phone icon opens on your personal
                    cellphone to call or text." tel: is the same
                    "hand off to whatever the device's own phone app is"
                    mechanism mailto: already uses for email. %>
                <% if (m.phone) { %>
                  <a class="icon-btn" href="tel:<%= m.phone %>" aria-label="Call or text <%= m.name %>" title="Call or text <%= m.name %>"><svg class="icon"><use href="#icon-phone"/></svg></a>
                <% } else { %>
                  <span class="icon-btn icon-btn-disabled" aria-hidden="true" title="No phone on file"><svg class="icon"><use href="#icon-phone"/></svg></span>
                <% } %>
                <button
                  type="button"
                  class="icon-btn"
                  data-name-tag-request-url="/main-admin/members/<%= m.id %>/request-name-tag"
                  aria-label="Add name tag request for <%= m.name %>"
                  title="Add to Name Tag Request Log"
                ><svg class="icon"><use href="#icon-send"/></svg></button>
                <%# A real request: "all icons should show, no three dot
                    option" - Reactivate/Delete (Archive tab) or Archive
                    (Members tab) used to live behind a "More" (⋮)
                    overflow menu; each is now its own icon button, same
                    .icon-btn treatment as Email/Phone/Send beside them.
                    Click behavior is unchanged - each one's own global
                    delegated listener (public/js/member-row-actions.js)
                    matches by data attribute, not by living inside any
                    particular menu. %>
                <% if (showArchived) { %>
                  <%# A real request: "next to each members name under
                      archive there should be a button that says
                      reactivate to make them a member again and remove
                      them from the archive list." %>
                  <button type="button" class="icon-btn" data-member-unarchive-url="/main-admin/members/<%= m.id %>/unarchive" aria-label="Reactivate <%= m.name %>" title="Reactivate">
                    <svg class="icon"><use href="#icon-undo"/></svg>
                  </button>
                  <%# A real request: "remove trash button from each
                      member. you must archive the member and then they
                      can be deleted while archived." - Delete only
                      exists here, on the Archive tab, never on the live
                      Members tab. %>
                  <button
                    type="button"
                    class="icon-btn icon-btn-danger"
                    data-member-delete-url="/main-admin/members/<%= m.id %>/delete"
                    data-member-delete-name="<%= m.name %>"
                    data-member-delete-message="Permanently delete <%= m.name %>? This removes them from all rosters and attendance history. This cannot be undone."
                    aria-label="Delete <%= m.name %>"
                    title="Delete"
                  ><svg class="icon"><use href="#icon-trash"/></svg></button>
                <% } else { %>
                  <button type="button" class="icon-btn" data-member-archive-url="/main-admin/members/<%= m.id %>/archive" aria-label="Archive <%= m.name %>" title="Archive">
                    <svg class="icon"><use href="#icon-archive"/></svg>
                  </button>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
        <%- include('partials/pagination-controls', { pagination: pagination, baseHref: baseHref }) %>
      <% } %>
    <% } else if (activeTab === 'approvals') { %>
      <%# A real request: "this is where new membership requests appear.
          each line shows primary parent name. you can click the name and
          view their membership form and edit, add portal settings etc.
          save. each member line should have approve button, deny button
          and trash can symbol to delete the request." %>
      <% if (pending.length === 0) { %>
        <p class="roster-empty">No membership requests awaiting approval.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table condensed-table">
            <thead><tr><th>Primary Parent</th><th>Email</th><th>Family</th><th>Requested</th><th></th></tr></thead>
            <tbody>
              <% pending.forEach(function(p) { %>
                <tr>
                  <td class="roster-name-col"><a href="/main-admin/members/<%= p.memberId %>/edit"><%= p.primaryParentName %></a></td>
                  <td><%= p.email %></td>
                  <td><%= p.familyName || '—' %></td>
                  <td><%= p.requestedAtLabel %></td>
                  <td class="actions-cell">
                    <div class="actions-btn-row">
                      <form method="POST" action="/main-admin/members/approvals/<%= p.accountId %>/approve" class="inline-block-form">
                        <button type="submit" class="icon-btn" aria-label="Approve <%= p.primaryParentName %>" title="Approve"><svg class="icon"><use href="#icon-check"/></svg></button>
                      </form>
                      <form method="POST" action="/main-admin/members/approvals/<%= p.accountId %>/deny" class="inline-block-form" data-confirm="Deny <%= p.primaryParentName %>'s membership request? They'll receive the Denial Letter.">
                        <button type="submit" class="icon-btn icon-btn-danger" aria-label="Deny <%= p.primaryParentName %>" title="Deny"><svg class="icon"><use href="#icon-x-circle"/></svg></button>
                      </form>
                      <form method="POST" action="/main-admin/members/approvals/<%= p.accountId %>/delete" class="inline-block-form" data-confirm="Delete <%= p.primaryParentName %>'s membership request? This cannot be undone.">
                        <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete request from <%= p.primaryParentName %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } else if (activeTab === 'settings') { %>
      <%# A real request: "Change settings to card style like the gear
          icon settings. Move sections buttons to settings subpage as a
          card." Replaces the old in-page tab strip (views/portal-
          profile.ejs's own Profile/Schedules/Event Signups pattern) with
          the same landing-grid-of-cards shape /main-admin/settings
          itself uses (views/main-admin-settings-hub.ejs) - no
          settingsTab in the URL shows this grid; picking a card still
          just navigates to that same settingsTab query param as before,
          each one's own content unchanged below. Sections isn't a
          settingsTab at all (it's always been its own full page at
          /main-admin/sections) - its card just links straight there. %>
      <% if (!settingsTab) { %>
        <div class="team-card-grid">
          <div class="team-col">
            <a class="team-info-card" href="/main-admin/members?tab=settings&settingsTab=grade-levels">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-graduation-cap"/></svg></span>
              <h3 class="team-info-title">Grade Level Settings</h3>
              <p class="hint">Age/date rules for assigning a student's grade level.</p>
            </a>
          </div>
          <div class="team-col">
            <a class="team-info-card" href="/main-admin/members?tab=settings&settingsTab=fee-payment">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-coin"/></svg></span>
              <h3 class="team-info-title">Membership Fee &amp; Payment</h3>
              <p class="hint">The fee amount and payment instructions shown on the application.</p>
            </a>
          </div>
          <div class="team-col">
            <a class="team-info-card" href="/main-admin/members?tab=settings&settingsTab=form-fields">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-edit"/></svg></span>
              <h3 class="team-info-title">Membership Form Fields</h3>
              <p class="hint">Extra questions on the Membership Form and public application.</p>
            </a>
          </div>
          <div class="team-col">
            <a class="team-info-card" href="/main-admin/members?tab=settings&settingsTab=approval-denial">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-mail"/></svg></span>
              <h3 class="team-info-title">Approval/Denial Messages</h3>
              <p class="hint">The letters sent when a registration is approved or denied.</p>
            </a>
          </div>
          <div class="team-col">
            <a class="team-info-card" href="/main-admin/members?tab=settings&settingsTab=handbook">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-file-text"/></svg></span>
              <h3 class="team-info-title">Policy Handbook</h3>
              <p class="hint">What families must scroll through and accept to register.</p>
            </a>
          </div>
          <div class="team-col">
            <a class="team-info-card" href="/main-admin/sections">
              <span class="team-info-icon"><svg class="icon"><use href="#icon-clipboard-list"/></svg></span>
              <h3 class="team-info-title">Sections</h3>
              <p class="hint">Add, rename, or remove the sections members can belong to.</p>
            </a>
          </div>
        </div>
      <% } else { %>
        <p class="subtitle no-print"><a href="/main-admin/members?tab=settings">&larr; Settings</a></p>
      <% } %>

      <% if (settingsTab) { %>
      <% if (settingsTab === 'grade-levels') { %>
        <%# A real request: "Under member settings add a tab called grade
            level settings. Here is a list of graded levels. Next to each
            grade level is a date picker and another column for age.
            Clean rows. Each row will say, if student is (age), by
            (date/calendar picker), then they will be in (grade level)."
            One row per utils/classSchedule.js's own GRADE_LEVELS (see
            utils/gradeLevelSettings.js) - a reference list an admin
            fills in and reads, not wired into the Grade Level dropdown
            on the member form itself (still its own manual per-member
            choice). %>
        <div class="manage-section">
          <h2>Grade Level Settings</h2>
          <form method="POST" action="/main-admin/members/settings/grade-levels" class="stack-form" id="grade-level-settings-form">
            <div class="roster-scroll">
              <table class="roster-table condensed-table grade-level-settings-table">
                <thead><tr><th>If student is&hellip;</th><th>&hellip;by this date&hellip;</th><th>&hellip;then they will be in</th></tr></thead>
                <tbody>
                  <% gradeLevelRules.forEach(function(row) { %>
                    <tr>
                      <td class="grade-level-settings-age-cell">
                        <input type="hidden" name="gradeLevel" value="<%= row.gradeLevel %>" />
                        <input type="number" name="age" min="0" step="1" value="<%= row.age != null ? row.age : '' %>" placeholder="Age" /> years old
                      </td>
                      <td><input type="date" name="cutoffDate" value="<%= row.cutoffDate || '' %>" /></td>
                      <td><%= row.gradeLevel %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </form>
          <%# A real request: "Save grade level settings button and apply
              to all members button should be on the same row. Shrink to
              fit." Two separate <form>s (HTML forbids nesting one inside
              another) sharing one flex row reads as "the same row" - same
              roster-btn-row-fit-text/data-fixed-columns shrink-to-fit
              convention the Accounts page's own side-by-side button pair
              already uses. Apply is its own real action (see routes/
              main-admin-members.js's own POST .../grade-levels/apply) -
              data-confirm-safe since this only ever SETS a grade level it's
              confident about (a student matching no rule is left untouched
              - see the util's own comment), never blanks one out - not the
              same risk class as a delete. %>
          <div class="roster-btn-row roster-btn-row-fit-text" data-fixed-columns="2">
            <button type="submit" form="grade-level-settings-form" class="roster-action-btn roster-action-btn-fit">Save Grade Level Settings</button>
            <form method="POST" action="/main-admin/members/settings/grade-levels/apply" class="inline-block-form" data-confirm="Set every matching student's grade level from their birthday, using the rules above? This overwrites their current Grade Level on the member form." data-confirm-yes-label="Apply" data-confirm-icon="icon-refresh" data-confirm-safe="1">
              <button type="submit" class="roster-action-btn roster-action-btn-fit">
                <svg class="icon"><use href="#icon-refresh"/></svg>
                Apply to All Members
              </button>
            </form>
          </div>
        </div>
      <% } else if (settingsTab === 'fee-payment') { %>
        <%# A real request: "place at the bottom of the application for
            payment." This app has no online "pay now" flow anywhere (see
            utils/membershipHandbook.js's own comment) - what's saved
            here is the fee amount and how a family actually pays, shown
            as information on the application, not a checkout. %>
        <div class="manage-section">
          <h2>Membership Fee &amp; Payment</h2>
          <form method="POST" action="/main-admin/members/settings/payment" class="stack-form">
            <label>Membership Fee (USD)
              <input type="number" name="feeDollars" min="0" step="0.01" value="<%= (paymentInfo.feeCents / 100).toFixed(2) %>" />
            </label>
            <label class="member-form-full">Payment Instructions
              <textarea name="instructions" rows="4" placeholder="e.g. Pay by cash, check, or Venmo once your registration is approved."><%= paymentInfo.instructions %></textarea>
            </label>
            <button type="submit" class="primary-btn">Save Payment Info</button>
          </form>
        </div>
      <% } else if (settingsTab === 'form-fields') { %>
        <%# A real request: "under members in main admin portal there
            should be a settings tab for editing and adding parts of the
            membership form." Admin-defined extra questions, shown on
            both the admin-entered Membership Form/Add Member forms and
            the public self-registration application. %>
        <div class="manage-section">
          <h2>Membership Form Fields</h2>
          <%- include('partials/membership-fields-manager', { target: 'parent', label: 'Parent', fields: parentFormFields, fieldTypes }) %>
          <%- include('partials/membership-fields-manager', { target: 'child', label: 'Student', fields: childFormFields, fieldTypes }) %>
        </div>
      <% } else if (settingsTab === 'approval-denial') { %>
        <%# A real request: "this will have an approval and deny letter
            that can be edited by admin. these letters are sent
            automatically went approve or deny buttons are clicked." A
            second real request: "approval and denial messages should
            have the same text editing icons we added to other chat
            boxes" - same forum-editor-toolbar/forum-editor.js rich-text
            component the Policy Handbook editor uses. %>
        <%
          // The two letters were plain text (newline-separated
          // paragraphs) before this editor existed - dropped straight
          // into a contenteditable div, a run of newlines collapses to a
          // single space in HTML, losing the paragraph breaks on first
          // load even though the underlying saved text is untouched.
          // Detecting "no HTML tags yet" and turning newlines into real
          // breaks only for that initial fill (not the stored value)
          // keeps a legacy letter readable until the next save as HTML.
          function toEditableHtml(text) {
            if (/<[a-z][\s\S]*>/i.test(text || '')) return text;
            const esc = (text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return esc.split(/\n{2,}/).map((p) => '<p>' + p.replace(/\n/g, '<br>') + '</p>').join('');
          }
        %>
        <div class="manage-section">
          <h2>Approval Letter</h2>
          <form method="POST" action="/main-admin/members/settings/letters/approval" class="stack-form" data-forum-editor>
            <label class="member-form-full">Subject
              <input type="text" name="subject" value="<%= templates.approval.subject %>" required />
            </label>
            <%- include('partials/forum-editor-toolbar') %>
            <div class="forum-editable" data-forum-editable contenteditable="true"><%- toEditableHtml(templates.approval.body) %></div>
            <input type="hidden" name="body" data-forum-body-input />
            <button type="submit" class="primary-btn">Save Approval Letter</button>
          </form>
        </div>
        <div class="manage-section">
          <h2>Denial Letter</h2>
          <form method="POST" action="/main-admin/members/settings/letters/denial" class="stack-form" data-forum-editor>
            <label class="member-form-full">Subject
              <input type="text" name="subject" value="<%= templates.denial.subject %>" required />
            </label>
            <%- include('partials/forum-editor-toolbar') %>
            <div class="forum-editable" data-forum-editable contenteditable="true"><%- toEditableHtml(templates.denial.body) %></div>
            <input type="hidden" name="body" data-forum-body-input />
            <button type="submit" class="primary-btn">Save Denial Letter</button>
          </form>
        </div>
      <% } else { %>
        <%# A real request: "there should be a place at the bottom of the
            membership application to check a box after reading the
            policy handbook. can't check the box until you have scrolled
            through the entire handbook." What's written here is what a
            family reads and must scroll through on the public
            application (views/portal-register.ejs) before submitting. %>
        <div class="manage-section">
          <h2>Policy Handbook</h2>
          <form method="POST" action="/main-admin/members/settings/handbook" class="stack-form" data-forum-editor>
            <%- include('partials/forum-editor-toolbar') %>
            <div class="forum-editable" data-forum-editable contenteditable="true"><%- handbookHtml %></div>
            <input type="hidden" name="handbookHtml" data-forum-body-input />
            <button type="submit" class="primary-btn">Save Policy Handbook</button>
          </form>
        </div>

        <%# A real request: "add an option to upload the policy handbook
            as a document, pdf, etc." - an optional file alongside the
            rich-text handbook above (see utils/membershipHandbook.js's
            own comment on why this doesn't touch the existing scroll-to-
            read enforcement) - shown to families as a plain download
            link on the public application (views/portal-register.ejs). %>
        <div class="manage-section">
          <h2>Policy Handbook File <span class="hint">(optional PDF/Word download)</span></h2>
          <% if (handbookFile) { %>
            <p class="hint">
              Currently posted: <a href="/handbook-file" target="_blank"><%= handbookFile.originalName %></a>
            </p>
            <form method="POST" action="/main-admin/members/settings/handbook/file/delete" class="inline-block-form" data-confirm="Remove the uploaded Policy Handbook file? The rich-text handbook above is unaffected.">
              <button type="submit" class="roster-action-btn roster-action-btn-danger">Remove File</button>
            </form>
          <% } else { %>
            <p class="hint">No file uploaded yet.</p>
          <% } %>
          <form method="POST" action="/main-admin/members/settings/handbook/file" enctype="multipart/form-data" class="stack-form stack-form-narrow">
            <label>Upload <%= handbookFile ? 'a Replacement' : 'a' %> File
              <input type="file" name="file" accept=".pdf,.doc,.docx" required />
            </label>
            <button type="submit" class="primary-btn">Upload</button>
          </form>
        </div>
      <% } %>
      <% } %>
    <% } %>
  </main>
  <script src="/js/member-name-tag-request.js"></script>
  <script src="/js/members-family-accordion.js"></script>
  <script src="/js/edit-families.js"></script>
  <script src="/js/archive-select-toggle.js"></script>
  <script src="/js/members-bulk-edit.js"></script>
  <script src="/js/member-row-actions.js"></script>
  <% if (activeTab === 'settings') { %>
    <script src="/js/forum-editor.js"></script>
    <script src="/js/membership-field-type-toggle.js"></script>
  <% } %>
</body>
</html>
