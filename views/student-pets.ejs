<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Student Portal' }) %>
  <%- include('partials/pet-sprites') %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="pet-header">
      <h1><%= pet.name %> <button type="button" class="link-btn" onclick="document.getElementById('rename-pet-dialog').showModal()" aria-label="Rename pet"><svg class="icon"><use href="#icon-edit"/></svg></button></h1>
      <div class="pet-header-stats">
        <span class="pet-coin-pill"><svg class="icon"><use href="#icon-coin"/></svg> <%= pet.coins %></span>
        <span class="pet-level-pill"><svg class="icon"><use href="#icon-shield"/></svg> Level <%= levelInfo.level %></span>
      </div>
    </div>
    <div class="pet-xp-bar">
      <div class="pet-xp-bar-fill" style="width: <%= levelInfo.xpIntoLevel %>%;"></div>
    </div>
    <p class="hint pet-xp-label"><%= levelInfo.xpIntoLevel %> / <%= levelInfo.xpForLevel %> XP</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%
      // One icon per care action, matching the icon already on that
      // action's own button below - see this file's own <div
      // class="pet-particles"> comment for why a floating burst, not a
      // swappable pet part, is what actually sells the action here.
      var careActionIcon = { feed: 'icon-bone', play: 'icon-ball', bathe: 'icon-droplet' }[careAction];
      // Which stat bar this action actually raised - feed/hunger,
      // play/happiness, bathe/cleanliness (see utils/pets.js's own
      // careStats()) - so the bar gets a one-shot glow tying the stage
      // animation back to the number that changed.
      var careStatKey = { feed: 'hunger', play: 'happiness', bathe: 'cleanliness' }[careAction];
    %>
    <div class="pet-stage">
      <% if (look.image) { %>
        <div class="pet-stage-frame pet-stage-frame--photo">
          <img class="pet-display-photo<%= careAction ? ' pet-display--' + careAction : '' %>" src="<%= look.image %>" alt="<%= look.label %>" />
          <% if (careActionIcon) { %>
            <div class="pet-impact-ring pet-impact-ring-<%= careAction %>" aria-hidden="true"></div>
            <div class="pet-particles pet-particles-<%= careAction %>" aria-hidden="true">
              <svg class="icon pet-particle pet-particle-1"><use href="#<%= careActionIcon %>"/></svg>
              <svg class="icon pet-particle pet-particle-2"><use href="#<%= careActionIcon %>"/></svg>
              <svg class="icon pet-particle pet-particle-3"><use href="#<%= careActionIcon %>"/></svg>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="pet-stage-frame <%= look.svg.roomTheme %>">
          <svg class="pet-display<%= careAction ? ' pet-display--' + careAction : '' %>" viewBox="0 0 120 120" style="color: <%= look.svg.hex %>; --eye-color: <%= look.svg.eyeColor %>;">
            <use href="#pet-body-<%= look.svg.species %>"/>
            <use href="#pet-ears-<%= look.svg.ears %>"/>
            <use href="#pet-eyes-<%= look.svg.eyes %>"/>
            <use href="#pet-mouth-<%= look.svg.mouth %>"/>
            <use href="#pet-accessory-<%= look.svg.accessory %>"/>
          </svg>
          <% if (careActionIcon) { %>
            <div class="pet-impact-ring pet-impact-ring-<%= careAction %>" aria-hidden="true"></div>
            <div class="pet-particles pet-particles-<%= careAction %>" aria-hidden="true">
              <svg class="icon pet-particle pet-particle-1"><use href="#<%= careActionIcon %>"/></svg>
              <svg class="icon pet-particle pet-particle-2"><use href="#<%= careActionIcon %>"/></svg>
              <svg class="icon pet-particle pet-particle-3"><use href="#<%= careActionIcon %>"/></svg>
            </div>
          <% } %>
        </div>
      <% } %>
      <a class="roster-action-btn" href="/student/pets/customize">Edit Appearance</a>
    </div>

    <div class="pet-care-stats">
      <div class="pet-care-stat">
        <span class="pet-care-stat-label">Hunger</span>
        <div class="pet-care-bar"><div class="pet-care-bar-fill pet-care-bar-hunger<%= careStatKey === 'hunger' ? ' pet-care-bar-fill--pulse' : '' %>" style="width: <%= stats.hunger %>%;"></div></div>
      </div>
      <div class="pet-care-stat">
        <span class="pet-care-stat-label">Happiness</span>
        <div class="pet-care-bar"><div class="pet-care-bar-fill pet-care-bar-happiness<%= careStatKey === 'happiness' ? ' pet-care-bar-fill--pulse' : '' %>" style="width: <%= stats.happiness %>%;"></div></div>
      </div>
      <div class="pet-care-stat">
        <span class="pet-care-stat-label">Cleanliness</span>
        <div class="pet-care-bar"><div class="pet-care-bar-fill pet-care-bar-cleanliness<%= careStatKey === 'cleanliness' ? ' pet-care-bar-fill--pulse' : '' %>" style="width: <%= stats.cleanliness %>%;"></div></div>
      </div>
    </div>

    <div class="pet-care-actions">
      <form method="POST" action="/student/pets/feed" class="inline-block-form">
        <button type="submit" class="roster-action-btn pet-care-btn"><svg class="icon"><use href="#icon-bone"/></svg> Feed</button>
      </form>
      <form method="POST" action="/student/pets/play" class="inline-block-form">
        <button type="submit" class="roster-action-btn pet-care-btn"><svg class="icon"><use href="#icon-ball"/></svg> Play</button>
      </form>
      <form method="POST" action="/student/pets/bathe" class="inline-block-form">
        <button type="submit" class="roster-action-btn pet-care-btn"><svg class="icon"><use href="#icon-droplet"/></svg> Bathe</button>
      </form>
    </div>

    <dialog id="rename-pet-dialog" class="member-picker-dialog">
      <form method="POST" action="/student/pets/name">
        <h3>Rename Your Pet</h3>
        <label>Name
          <input type="text" name="name" value="<%= pet.name %>" maxlength="40" required />
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Save</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
