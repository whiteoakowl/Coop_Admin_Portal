<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="public-page">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="form-wrap">
    <div class="kiosk-header">
      <img class="form-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <h1>Log In</h1>
    </div>
    <p class="hint">Members, teachers, and admins sign in here. Looking for the co-op kiosk? <a href="/kiosk">Go to the kiosk</a>.</p>

    <% if (notice) { %><div class="alert alert-info"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/login" class="form-outer-panel">
      <input type="hidden" name="next" value="<%= next %>" />
      <div class="form-section">
        <label>Email
          <input type="email" name="email" required autocomplete="email" autofocus />
        </label>
        <label>Password
          <input type="password" name="password" required autocomplete="current-password" />
        </label>
      </div>
      <button type="submit" class="primary-btn">Log In</button>
      <p class="hint">New to the co-op? <a href="/register">Register for an account</a>.</p>
    </form>
  </main>
</body>
</html>
