<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <%# The Profile tab's own member-profile-card partial below already
        carries a "Member Profile" banner with its own Back/Edit links -
        this older subtitle+h1+Edit toolbar stays for Schedule/Attendance
        (which have no banner of their own), skipped on Profile so the
        two headers don't show side by side. %>
    <% if (tab !== 'profile') { %>
      <p class="subtitle no-print"><a href="/admin/members">&larr; Members</a></p>

      <div class="roster-toolbar">
        <div>
          <h1><%= member.name %><%- include('partials/medical-flag', { member: member }) %><% if (member.member_type === 'admin') { %> <span class="member-admin-star" title="Admin"><svg class="icon"><use href="#icon-star"/></svg></span><% } %></h1>
        </div>
        <div class="roster-btn-row no-print">
          <a class="roster-action-btn" href="/admin/members/<%= member.id %>/edit">Edit Profile</a>
        </div>
      </div>
    <% } %>

    <%# One specific member's own Profile/Class Schedule/Attendance tabs -
        no top-level nav entry to attach a popup to (reached by clicking
        into a member, not from the nav), so this stays the plain
        connected file-tab strip every other tabbed page used before the
        orange-bar popup existed, instead of a popup with nothing to open
        it from. %>
    <div class="view-tabs no-print">
      <a class="view-tab<%= tab === 'profile' ? ' active' : '' %>" href="/admin/members/<%= member.id %>?tab=profile">Profile</a>
      <a class="view-tab<%= tab === 'schedule' ? ' active' : '' %>" href="/admin/members/<%= member.id %>?tab=schedule">Class Schedule</a>
      <a class="view-tab<%= tab === 'attendance' ? ' active' : '' %>" href="/admin/members/<%= member.id %>?tab=attendance">Attendance</a>
    </div>

    <div class="view-tab-panel">
      <% if (tab === 'profile') { %>
        <%
        var famParents = familyMembers.filter(function(m) { return m.member_type !== 'student'; });
        var famChildren = familyMembers.filter(function(m) { return m.member_type === 'student'; });
        %>
        <%- include('partials/member-profile-card', {
          member,
          familyName,
          famParents,
          famChildren,
          memberSections,
          memberPortalRoles: portalRoles,
          backHref: '/admin/members',
          backLabel: 'Back to Members',
          editHref: '/admin/members/' + member.id + '/edit',
          familyMemberHref: function(id) { return '/admin/members/' + id; },
        }) %>

        <%# Co-op Admin-only extras the shared card above doesn't carry
            (Main Admin has no equivalent "which attendance Roster" or
            free-text Notes concept) - same side-card look, its own
            section below the shared two-column cards. %>
        <% if (rosters.length > 0 || member.notes) { %>
          <section class="member-profile-side-card member-profile-extra-card">
            <% if (rosters.length > 0) { %>
              <span class="member-profile-side-card-label">Rosters</span>
              <p><% rosters.forEach(function(r) { %><span class="badge-pill"><%= r.name %></span> <% }); %></p>
            <% } %>
            <% if (member.notes) { %>
              <span class="member-profile-side-card-label">Notes</span>
              <p><%= member.notes %></p>
            <% } %>
          </section>
        <% } %>

      <% } else if (tab === 'schedule') { %>
        <% if (familyRoster.length > 1) { %>
          <div class="category-filter member-profile-family-select">
            <label for="schedule-family-member-select">Family Member</label>
            <select id="schedule-family-member-select" onchange="if (this.value === 'all') { window.location = '/admin/members/<%= member.id %>?tab=schedule&family=all'; } else { window.location = '/admin/members/' + this.value + '?tab=schedule'; }">
              <option value="all" <%= scheduleFamilyAll ? 'selected' : '' %>>All</option>
              <% familyRoster.forEach(function(m) { %>
                <option value="<%= m.id %>" <%= (!scheduleFamilyAll && m.id === member.id) ? 'selected' : '' %>><%= m.name %></option>
              <% }); %>
            </select>
          </div>
        <% } %>
        <% if (scheduleFamilyAll) { %>
          <% familySchedules.forEach(function(fs) { %>
            <div class="schedule-day-columns member-profile-family-schedule">
              <h2 class="member-profile-family-schedule-name"><%= fs.member.name %></h2>
              <% fs.schedule.activeDays.forEach(function (d) { %>
                <% var dayLabel = dayLabels[d], rows = fs.schedule.byDay[d]; %>
                <div class="form-section">
                  <h3><%= dayLabel %> Schedule</h3>
                  <div class="roster-scroll schedule-table-scroll">
                    <table class="roster-table schedule-edit-table">
                      <thead>
                        <tr><th>#</th><th>Time</th><th>Class Name</th><th>Room</th></tr>
                      </thead>
                      <tbody>
                        <% var anyRows = rows.some(function (r) { return r.class_name || r.time || r.room || r.teacher; }); %>
                        <% if (!anyRows) { %>
                          <tr><td colspan="4" class="roster-empty">No classes on <%= dayLabel %> yet.</td></tr>
                        <% } %>
                        <% rows.forEach(function (r, i) { %>
                          <% if (!r.class_name && !r.time && !r.room && !r.teacher) return; %>
                          <tr>
                            <td class="schedule-edit-label"><%= i + 1 %></td>
                            <td><%= r.time || '—' %></td>
                            <td><%= r.class_name || '—' %></td>
                            <td><%= r.room || '—' %></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% }); %>
            </div>
          <% }); %>
          <a class="roster-action-btn print-action-btn no-print" href="/admin/schedule/print?familyId=<%= member.family_id %>" target="_blank">Print All Schedules</a>
        <% } else { %>
          <div class="schedule-day-columns">
            <% schedule.activeDays.forEach(function (d) { %>
              <% var dayLabel = dayLabels[d], rows = schedule.byDay[d]; %>
              <div class="form-section">
                <h2><%= dayLabel %> Schedule</h2>
                <div class="roster-scroll schedule-table-scroll">
                  <table class="roster-table schedule-edit-table">
                    <thead>
                      <tr><th>#</th><th>Time</th><th>Class Name</th><th>Room</th></tr>
                    </thead>
                    <tbody>
                      <% var anyRows = rows.some(function (r) { return r.class_name || r.time || r.room || r.teacher; }); %>
                      <% if (!anyRows) { %>
                        <tr><td colspan="4" class="roster-empty">No classes on <%= dayLabel %> yet.</td></tr>
                      <% } %>
                      <% rows.forEach(function (r, i) { %>
                        <% if (!r.class_name && !r.time && !r.room && !r.teacher) return; %>
                        <tr>
                          <td class="schedule-edit-label"><%= i + 1 %></td>
                          <td><%= r.time || '—' %></td>
                          <td><%= r.class_name || '—' %></td>
                          <td><%= r.room || '—' %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% }); %>
          </div>
          <a class="roster-action-btn print-action-btn no-print" href="/admin/schedule/print?memberId=<%= member.id %>" target="_blank">Print Schedule</a>
        <% } %>
      <% } else { %>
        <% if (familyRoster.length > 1) { %>
          <div class="category-filter member-profile-family-select">
            <label for="attendance-family-member-select">Family Member</label>
            <select id="attendance-family-member-select" onchange="if (this.value === 'all') { window.location = '/admin/members/<%= member.id %>?tab=attendance&family=all'; } else { window.location = '/admin/members/' + this.value + '?tab=attendance'; }">
              <option value="all" <%= attendanceFamilyAll ? 'selected' : '' %>>All</option>
              <% familyRoster.forEach(function(m) { %>
                <option value="<%= m.id %>" <%= (!attendanceFamilyAll && m.id === member.id) ? 'selected' : '' %>><%= m.name %></option>
              <% }); %>
            </select>
          </div>
        <% } %>
        <% if (attendanceFamilyAll) { %>
          <% familyAttendanceHistories.forEach(function(fa) { %>
            <div class="form-section member-profile-family-schedule">
              <h2 class="member-profile-family-schedule-name"><%= fa.member.name %></h2>
              <%- include('partials/member-attendance-rosters', { groups: fa.history, uidPrefix: 'fa-member-' + fa.member.id, includeNumberColumn: true }) %>
            </div>
          <% }); %>
        <% } else { %>
          <%- include('partials/member-attendance-rosters', { groups: history, uidPrefix: 'member-' + member.id, includeNumberColumn: true }) %>
        <% } %>
      <% } %>
    </div>
  </main>
  <script src="/js/member-attendance-accordion.js"></script>
</body>
</html>
