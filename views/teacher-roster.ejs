<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Teacher Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <%# A real request: "Teacher portal has an edit class button that
        goes to a page where they can edit their class information
        lesson plans etc." - this is that page now (routes/teacher-
        portal.js's own GET /classes/:id/edit); clicking a class itself
        lands on the read-only student/parent-style view instead (views/
        teacher-class-detail.ejs), reached from here by "Back to Class". %>
    <p class="hint"><a href="/teacher/classes/<%= cls.id %>">&larr; Back to <%= cls.class_name %></a></p>
    <h1>Edit <%= cls.class_name %></h1>
    <p class="hint"><%= cls.dayLabel %> &middot; <%= cls.timeLabel %> &middot; <%= cls.gradeLabel || 'All grades' %> &middot; Room <%= cls.room || 'Unassigned' %></p>
    <% if (cls.description) { %><p class="hint forum-editable-display"><%- cls.description %></p><% } %>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <section class="portal-dashboard-section">
      <h2>Roster</h2>
      <% if (students.length === 0) { %>
        <p class="roster-empty">No students enrolled yet.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Grade</th>
                <th>Medical/Allergy Notes</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(function(s) { %>
                <tr>
                  <td class="roster-name-col"><%= s.name %></td>
                  <td><%= s.grade_level || '—' %></td>
                  <td><%= s.medical_notes || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="portal-dashboard-section">
      <div class="grid-box-header">
        <h2>Assignments</h2>
        <a class="btn-secondary" href="/teacher/quiz-review">Quiz Review</a>
      </div>
      <% if (assignments.length === 0) { %>
        <p class="roster-empty">No assignments yet.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table">
            <thead>
              <tr>
                <th></th>
                <th>Title</th>
                <th>Open</th>
                <th>Due</th>
                <th></th>
              </tr>
            </thead>
            <tbody data-lesson-reorder-tbody data-class-id="<%= cls.id %>" data-reorder-url="/teacher/classes/<%= cls.id %>/assignments/reorder">
              <% assignments.forEach(function(a) { %>
                <tr data-lesson-reorder-row="<%= a.id %>">
                  <td class="roster-drag-col"><span data-lesson-reorder-handle class="lesson-drag-handle" title="Drag to reorder">&#9776;</span></td>
                  <td class="roster-name-col"><%= a.title %></td>
                  <td><%= a.open_date ? a.open_date : '—' %></td>
                  <td><%= a.dueDateLabel || '—' %></td>
                  <td><a class="roster-action-btn" href="/teacher/assignments/<%= a.id %>">Manage</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>

      <div class="portal-dashboard-card portal-dashboard-card-wide">
        <h3>New Assignment</h3>
        <form method="POST" action="/teacher/classes/<%= cls.id %>/assignments" class="member-form-grid">
          <label class="member-form-full">Title
            <input type="text" name="title" required />
          </label>
          <label class="member-form-full">Description
            <textarea name="description" rows="2"></textarea>
          </label>
          <label>Open Date
            <input type="date" name="openDate" />
          </label>
          <div class="member-form-full">
            <button type="submit" class="primary-btn">Add Assignment</button>
          </div>
        </form>
      </div>
    </section>
    <script src="/js/lesson-drag-reorder.js"></script>
  </main>
</body>
</html>
