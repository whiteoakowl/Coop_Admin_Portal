<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Orientation</h1>
    <p class="hint">Every family with a student registered for classes on either day, and their orientation progress. Click a circle to mark it complete/incomplete by hand - Tour and Orientation Meet Up are usually set from their own Check-In subpage instead.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (rows.length === 0) { %>
      <p class="roster-empty">No one is registered for classes on either day yet.</p>
    <% } else { %>
      <%
        // A real request: "If the column title has two words stack them
        // one on top of the other to save room" - applied generically so
        // any header here (this list, or a later one added to it) gets
        // the same treatment without a special case per column.
        var stackedHeader = function (text) {
          var words = text.split(' ');
          return words.length === 2 ? words.join('<br>') : text;
        };
        // A real request: "Orientation video column should say parent
        // orientation, teacher training should say teacher orientation,
        // add a column for open house" - labels only; the underlying
        // field keys (utils/orientation.js's own FIELDS) are unchanged.
        var columns = [
          { field: 'video', label: 'Parent Orientation' },
          { field: 'meetup', label: 'Orientation Meet Up' },
          { field: 'teacherTraining', label: 'Teacher Orientation' },
          { field: 'tour', label: 'Tour' },
          { field: 'openHouse', label: 'Open House' },
        ];
      %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>Member</th>
              <th>Day</th>
              <% columns.forEach(function(col) { %>
                <th class="orientation-col-center"><%- stackedHeader(col.label) %></th>
              <% }); %>
              <th class="orientation-col-center"><%- stackedHeader('% Complete') %></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(r) { %>
              <tr>
                <td class="roster-name-col"><%= r.memberName %></td>
                <td><%= r.day === 'monday' ? 'Monday' : 'Wednesday' %></td>
                <% columns.map(function(col) { return col.field; }).forEach(function(field) { %>
                  <td class="orientation-col-center">
                    <button
                      type="button"
                      class="orientation-dot<%= r[field] ? ' orientation-dot-complete' : '' %>"
                      data-orientation-toggle
                      data-member-id="<%= r.memberId %>"
                      data-day="<%= r.day %>"
                      data-field="<%= field %>"
                      data-complete="<%= r[field] ? '1' : '0' %>"
                      aria-pressed="<%= r[field] ? 'true' : 'false' %>"
                      aria-label="<%= field %> for <%= r.memberName %>, <%= r.day %> - <%= r[field] ? 'complete' : 'incomplete' %>"
                    ></button>
                  </td>
                <% }); %>
                <td><%= r.percentComplete %>%</td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
  <script src="/js/orientation-toggle.js"></script>
</body>
</html>
