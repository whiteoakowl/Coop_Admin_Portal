<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="kiosk kiosk-checkout">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="kiosk-wrap">
    <a href="/kiosk" class="kiosk-home"><svg class="icon"><use href="#icon-home"/></svg> Return to Home Screen</a>
    <div class="kiosk-header">
      <img class="kiosk-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <h1><%= title %></h1>
    </div>
    <p class="kiosk-date"><%= dateLabel %></p>

    <div id="step-scan" class="kiosk-panel">
      <p id="kiosk-instructions" class="kiosk-instructions">Scan your name tag barcode</p>
      <div id="kiosk-status" class="kiosk-status kiosk-status-idle">
        <span class="kiosk-status-icon"><svg class="icon"><use href="#icon-camera"/></svg></span>
      </div>
      <form id="scan-form" autocomplete="off">
        <input
          id="barcode-input"
          name="barcode"
          type="text"
          aria-label="Scan a barcode"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          inputmode="none"
        />
      </form>
    </div>

    <div id="step-number" class="kiosk-panel kiosk-hidden">
      <p class="kiosk-instructions">Hi <span id="member-name">-</span>, select your number</p>
      <p id="number-message" class="kiosk-submessage"></p>
      <div id="numpad" class="numpad"></div>
      <button id="cancel-btn" type="button" class="kiosk-cancel-btn">Cancel</button>
    </div>
  </main>
  <script src="/js/kiosk-common.js"></script>
  <script src="/js/kiosk-checkout.js"></script>
  <script src="/js/fullscreen-nav.js"></script>
</body>
</html>
