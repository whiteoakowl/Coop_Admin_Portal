<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="kiosk kiosk-checkout">
  <%- include('partials/icon-sprite') %>
  <main id="main-content" tabindex="-1" class="kiosk-wrap">
    <a href="/kiosk" class="kiosk-home"><svg class="icon"><use href="#icon-home"/></svg> Return to Home Screen</a>
    <div class="kiosk-header">
      <img class="kiosk-logo" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <h1><%= title %></h1>
    </div>
    <p class="kiosk-date"><%= dateLabel %></p>

    <div id="step-scan" class="kiosk-panel">
      <div class="kiosk-method-choice">
        <p class="kiosk-instructions">How would you like to check out?</p>
        <div class="kiosk-method-buttons">
          <button type="button" class="kiosk-method-btn kiosk-method-btn-scanner" data-method="scanner">
            <span class="landing-icon"><svg class="icon"><use href="#icon-barcode"/></svg></span>
            <span class="landing-label">Barcode Scanner</span>
          </button>
          <button type="button" class="kiosk-method-btn kiosk-method-btn-manual" data-method="manual">
            <span class="landing-icon"><svg class="icon"><use href="#icon-grid"/></svg></span>
            <span class="landing-label">Manually Enter ID #</span>
          </button>
        </div>
      </div>

      <div data-method-panel="scanner" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-scan-now-text">Scan barcode now</p>
      </div>

      <div data-method-panel="manual" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-scan-now-text">Please enter your ID number</p>
        <div id="id-keypad"></div>
        <button type="button" id="manual-submit-btn" class="primary-btn">Submit</button>
      </div>

      <div id="kiosk-result" hidden>
        <div id="kiosk-status" class="kiosk-status kiosk-status-idle">
          <span class="kiosk-status-icon"></span>
        </div>
        <p id="kiosk-instructions" class="kiosk-instructions"></p>
      </div>

      <form id="scan-form" autocomplete="off">
        <input
          id="barcode-input"
          name="barcode"
          type="text"
          aria-label="Scan a barcode"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          inputmode="none"
        />
      </form>
    </div>

    <!-- Parents only - students check out with a single name tag scan (see
         step-scan above and public/js/kiosk-checkout.js). Scan the
         Setup/Cleanup badge for the task just completed, same two-method
         shape as step-scan (its own scanner/manual chooser), just for a
         task's barcode instead of a member's. -->
    <!-- A real request: "if the check in/out needs to ask the parent to
         scan their setup/cleanup badge then after scanning their ID it
         will immediately say please scan your setup/cleanup badge. if
         they select ID, then after they enter their ID and click
         submit, it will immediately say please enter your setup/cleanup
         badge ID number." No chooser here anymore for that reason -
         public/js/kiosk-checkout.js jumps straight to whichever method
         panel matches step-scan's own (data-back-to-chooser still lets
         someone switch if they need to), so this step never makes them
         pick a method twice. -->
    <div id="step-task" class="kiosk-panel kiosk-hidden">
      <div class="kiosk-method-choice">
        <div class="kiosk-method-buttons">
          <button type="button" class="kiosk-method-btn kiosk-method-btn-scanner" data-method="scanner">
            <span class="landing-icon"><svg class="icon"><use href="#icon-barcode"/></svg></span>
            <span class="landing-label">Barcode Scanner</span>
          </button>
          <button type="button" class="kiosk-method-btn kiosk-method-btn-manual" data-method="manual">
            <span class="landing-icon"><svg class="icon"><use href="#icon-grid"/></svg></span>
            <span class="landing-label">Manually Enter ID #</span>
          </button>
        </div>
      </div>

      <div data-method-panel="scanner" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-instructions">Hi <span class="task-member-name">-</span>, please scan your Setup/Cleanup badge</p>
      </div>

      <div data-method-panel="manual" hidden>
        <button type="button" class="kiosk-method-back" data-back-to-chooser>&lsaquo; Change Method</button>
        <p class="kiosk-instructions">Hi <span class="task-member-name">-</span>, please enter your Setup/Cleanup badge ID number</p>
        <div id="task-id-keypad"></div>
        <button type="button" id="task-manual-submit-btn" class="primary-btn">Submit</button>
      </div>

      <div id="task-kiosk-result" hidden>
        <div id="task-kiosk-status" class="kiosk-status kiosk-status-idle">
          <span class="kiosk-status-icon"></span>
        </div>
        <p id="task-kiosk-instructions" class="kiosk-instructions"></p>
      </div>

      <form id="task-scan-form" autocomplete="off">
        <input
          id="task-barcode-input"
          name="barcode"
          type="text"
          aria-label="Scan your Setup/Cleanup badge"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          inputmode="none"
        />
      </form>

      <button id="cancel-btn" type="button" class="kiosk-cancel-btn">Cancel</button>
    </div>
  </main>
  <script src="/js/kiosk-common.js"></script>
  <script src="/js/kiosk-id-keypad.js"></script>
  <script src="/js/kiosk-checkout.js"></script>
  <script src="/js/fullscreen-nav.js"></script>
</body>
</html>
