<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= activeTab === 'archive' ? 'Archive' : 'Photos' %></h1>
      <% if (activeTab === 'photos') { %>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('new-album-dialog').showModal()">+ New Album</button>
      <% } %>
    </div>

    <%# "Add archive subpage under photos tab" - Photos/Archive now live
        as subpages under the orange bar's own Photos item (views/
        partials/portal-nav.ejs), same pattern as every other tabbed
        section. %>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%# Item 6 - Main Admin homepage links straight to #pending-photos so
        approving a submission is one click from the pending-requests
        counter, not a hunt through every album's own edit page. %>
    <% if (pendingPhotos.length > 0) { %>
      <section id="pending-photos" class="manage-section">
        <div class="grid-box-header"><h2>Pending Photos</h2></div>
        <div class="team-card-grid">
          <% pendingPhotos.forEach(function(p) { %>
            <div class="team-col">
              <div class="team-info-card">
                <img src="/photos/<%= p.album_id %>/image/<%= p.id %>" alt="<%= p.caption || '' %>" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); margin-bottom: 0.5rem;" />
                <p class="hint">In <a href="/main-admin/photos/<%= p.album_id %>/edit"><%= p.albumTitle %></a></p>
                <% if (p.caption) { %><p class="hint"><%= p.caption %></p><% } %>
                <div class="roster-btn-row">
                  <form method="POST" action="/main-admin/photos/<%= p.album_id %>/photos/<%= p.id %>/decide" class="inline-block-form">
                    <input type="hidden" name="decision" value="approve" />
                    <button type="submit" class="roster-action-btn">Approve</button>
                  </form>
                  <form method="POST" action="/main-admin/photos/<%= p.album_id %>/photos/<%= p.id %>/decide" class="inline-block-form">
                    <input type="hidden" name="decision" value="reject" />
                    <button type="submit" class="roster-action-btn roster-action-btn-danger">Reject</button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (albums.length === 0) { %>
      <p class="roster-empty"><%= activeTab === 'archive' ? 'Nothing archived.' : 'No albums yet — create one above.' %></p>
    <% } %>

    <%# A real request: "Main admin portal photo album view should look
        like parent portal view with cover photos" - reuses the same
        .event-card/.event-card-image markup as views/photos-list.ejs
        (the parent/student album grid) instead of the plain .team-card-
        grid text list. The image+title+description are wrapped in their
        own link (.photo-album-admin-card-link) rather than making the
        whole .event-card a link like the parent view does, because the
        icon row below still needs real <a>/<button> elements of its own
        - and a <button>/<a> can't be nested inside another <a>. %>
    <div class="event-card-grid">
      <% albums.forEach(function(a) { %>
        <div class="event-card photo-album-admin-card">
          <a class="photo-album-admin-card-link" href="/main-admin/photos/<%= a.id %>/edit">
            <% if (a.cover_image_key) { %>
              <div class="event-card-image"><img src="/photos/<%= a.id %>/cover" alt="" /></div>
            <% } %>
            <div class="event-card-body">
              <div class="photo-album-admin-card-title-row">
                <h3><%= a.title %></h3>
                <span class="badge-pill badge-pill-<%= a.visibility === 'public' ? 'orange' : 'gray' %>"><%= a.visibility === 'public' ? 'Public' : 'Members Only' %></span>
              </div>
              <% if (a.description) { %><p class="event-card-location"><%= a.description %></p><% } %>
            </div>
          </a>
          <%# A real request: "Manage button becomes edit icon... add
              export icon on each album card... icons should be bottom
              right. Also trash icon. Remove trashcan button from edit
              page." The card's own icon row replaces both the old
              "Manage" text button and the edit page's own Delete
              button (moved here instead). Main Admin only - the parent/
              student view (views/photos-list.ejs) has no icon row at all. %>
          <div class="roster-btn-row photo-album-card-icons">
            <% if (activeTab === 'archive') { %>
              <form method="POST" action="/main-admin/photos/<%= a.id %>/unarchive" class="inline-block-form">
                <button type="submit" class="roster-action-btn roster-action-btn-fit">Restore</button>
              </form>
            <% } %>
            <a class="icon-btn" href="/main-admin/photos/<%= a.id %>/edit" aria-label="Edit <%= a.title %>" title="Edit"><svg class="icon"><use href="#icon-edit"/></svg></a>
            <a class="icon-btn" href="/photos/<%= a.id %>/download" aria-label="Export <%= a.title %>" title="Export"><svg class="icon"><use href="#icon-download"/></svg></a>
            <form method="POST" action="/main-admin/photos/<%= a.id %>/delete" class="inline-block-form" data-confirm="Delete &quot;<%= a.title %>&quot; and all its photos? This cannot be undone.">
              <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= a.title %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>

    <dialog id="new-album-dialog" class="member-picker-dialog dialog-label-stack">
      <form method="POST" action="/main-admin/photos">
        <h3>New Album</h3>
        <label>Title
          <input type="text" name="title" required />
        </label>
        <label>Description
          <textarea name="description" rows="2"></textarea>
        </label>
        <label>Visibility
          <select name="visibility">
            <option value="members" selected>Members Only</option>
            <option value="public">Public</option>
          </select>
        </label>
        <p class="hint">Members Only is the safer default - a photo with children in it should stay members-only unless there's a specific reason to make an album public.</p>
        <%# A real request: "add a check box permission for members can
            add photos. If that box is not checked than the album will
            be view only on parent and student portals." %>
        <label class="checkbox-option">
          <input type="checkbox" name="allowMemberUploads" value="1" />
          Members can add photos
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
