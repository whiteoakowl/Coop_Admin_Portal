<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/members', icon: 'users', label: 'Members' },
      { href: '/main-admin/announcements', icon: 'bell', label: 'Communication' },
      { href: '/main-admin/resource-links', icon: 'book', label: 'Resource Links' },
      { href: '/main-admin/babysitters', icon: 'user', label: 'Babysitters' },
      { href: '/main-admin/name-tags', icon: 'badge', label: 'Name Tags' },
      { href: '/main-admin/events', icon: 'calendar-check', label: 'Events' },
      { href: '/main-admin/directory', icon: 'map-pin', label: 'Business Directory' },
      { href: '/main-admin/classifieds', icon: 'tag', label: 'Classifieds' },
      { href: '/main-admin/member-directory', icon: 'users', label: 'Member Directory' },
      { href: '/main-admin/forums', icon: 'users', label: 'Chat' },
      { href: '/main-admin/forms', icon: 'clipboard-list', label: 'Custom Forms' },
      { href: '/main-admin/accounting', icon: 'file-text', label: 'Accounting' },
      { href: '/main-admin/store', icon: 'tag', label: 'Store' },
      { href: '/main-admin/newsletter', icon: 'mail', label: 'Newsletter' },
      { href: '/main-admin/notifications', icon: 'bell', label: 'Notifications' },
      { href: '/main-admin/photos', icon: 'image', label: 'Photos' },
      { href: '/main-admin/publications', icon: 'book', label: 'Publications' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1>Photo Albums</h1>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('new-album-dialog').showModal()">+ New Album</button>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%# Item 6 - Main Admin homepage links straight to #pending-photos so
        approving a submission is one click from the pending-requests
        counter, not a hunt through every album's own edit page. %>
    <% if (pendingPhotos.length > 0) { %>
      <section id="pending-photos" class="manage-section">
        <div class="grid-box-header"><h2>Pending Photos</h2></div>
        <div class="team-card-grid">
          <% pendingPhotos.forEach(function(p) { %>
            <div class="team-col">
              <div class="team-info-card">
                <img src="/photos/<%= p.album_id %>/image/<%= p.id %>" alt="<%= p.caption || '' %>" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); margin-bottom: 0.5rem;" />
                <p class="hint">In <a href="/main-admin/photos/<%= p.album_id %>/edit"><%= p.albumTitle %></a></p>
                <% if (p.caption) { %><p class="hint"><%= p.caption %></p><% } %>
                <div class="roster-btn-row">
                  <form method="POST" action="/main-admin/photos/<%= p.album_id %>/photos/<%= p.id %>/decide" class="inline-block-form">
                    <input type="hidden" name="decision" value="approve" />
                    <button type="submit" class="roster-action-btn">Approve</button>
                  </form>
                  <form method="POST" action="/main-admin/photos/<%= p.album_id %>/photos/<%= p.id %>/decide" class="inline-block-form">
                    <input type="hidden" name="decision" value="reject" />
                    <button type="submit" class="roster-action-btn roster-action-btn-danger">Reject</button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <% if (albums.length === 0) { %>
      <p class="roster-empty">No albums yet &mdash; create one above.</p>
    <% } %>

    <div class="team-card-grid">
      <% albums.forEach(function(a) { %>
        <div class="team-col">
          <div class="team-info-card">
            <h3 class="team-info-title"><a href="/main-admin/photos/<%= a.id %>/edit"><%= a.title %></a></h3>
            <span class="badge-pill badge-pill-<%= a.visibility === 'public' ? 'orange' : 'gray' %>"><%= a.visibility === 'public' ? 'Public' : 'Members Only' %></span>
            <% if (a.description) { %><p class="hint"><%= a.description %></p><% } %>
            <div class="roster-btn-row">
              <a class="roster-action-btn" href="/main-admin/photos/<%= a.id %>/edit">Manage</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <dialog id="new-album-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/photos">
        <h3>New Album</h3>
        <label>Title
          <input type="text" name="title" required />
        </label>
        <label>Description
          <textarea name="description" rows="2"></textarea>
        </label>
        <label>Visibility
          <select name="visibility">
            <option value="members" selected>Members Only</option>
            <option value="public">Public</option>
          </select>
        </label>
        <p class="hint">Members Only is the safer default - a photo with children in it should stay members-only unless there's a specific reason to make an album public.</p>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create</button>
        </div>
      </form>
    </dialog>
  </main>
</body>
</html>
