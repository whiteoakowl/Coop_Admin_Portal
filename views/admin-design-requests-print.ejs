<!doctype html>
<html lang="en">
<head>
  <%# A real request: "the download should be a pdf of exactly how it
      would also look when printing." utils/pdfRender.js renders this
      exact view (via req.app.render(), never through a real HTTP
      request) to build the Download PDF - pdfBaseUrl is only ever set
      for that internal render, since Chromium otherwise has no "current
      page URL" of its own to resolve this page's relative asset URLs
      (/css/styles.css, /img/logo.png) against. A real person visiting
      this same page in their own browser (the Print button's own
      target) never sets it, so the page's own URL already does that
      job and this <base> tag is simply absent. %>
  <% if (typeof pdfBaseUrl !== 'undefined' && pdfBaseUrl) { %><base href="<%= pdfBaseUrl %>/"><% } %>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter; margin: 0; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= showArchived ? 'Archived Name Tag Requests' : 'Name Tag Requests' %></h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-page">
      <div class="print-header">
        <img src="/img/logo.png" alt="" />
        <div>
          <p class="print-header-title">Sanford Homeschoolers</p>
          <p class="print-header-sub"><%= showArchived ? 'Archived Name Tag Requests' : 'Name Tag Requests' %></p>
        </div>
      </div>

      <table class="roster-table members-table condensed-table">
        <thead>
          <tr><th>Submitted</th><th>Name</th><th>Request</th><th>Day</th><th>Description</th></tr>
        </thead>
        <tbody>
          <% if (allSubmissions.length === 0) { %>
            <tr><td colspan="5" class="roster-empty">No <%= showArchived ? 'archived' : '' %> name tag requests yet.</td></tr>
          <% } %>
          <% allSubmissions.forEach(function(s) { %>
            <tr>
              <td><%= s.timestamp %></td>
              <td><%= s.memberName %></td>
              <td><%= s.requestTypeLabel %></td>
              <td><%= s.dayLabel %></td>
              <td><%= s.description %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
