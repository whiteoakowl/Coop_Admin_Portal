<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/parent/family-school">&larr; Family School Management</a></p>
    <div class="roster-toolbar no-print">
      <h1>Annual Planner</h1>
    </div>

    <%# A real request: "Year dropdown, remove school year title. Move
        dropdown and add curriculum button to the same row as the print
        icons. Shrink to fit." One single roster-btn-row-fit-text row
        (not two separate flex groups under a space-between
        .roster-toolbar, which wrapped onto two lines on mobile) - every
        control sized to its own content instead. %>
    <div class="roster-toolbar no-print">
      <div class="roster-btn-row roster-btn-row-fit-text">
        <% if (familyStudents.length > 0) { %>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-curriculum-dialog').showModal()">+ Add Curriculum</button>
        <% } %>
        <form method="GET" action="/parent/family-school/annual-planner" class="inline-block-form">
          <select id="annual-planner-school-year" name="schoolYear" onchange="this.form.submit()" aria-label="School Year">
            <option value="all" <%= schoolYear === 'all' ? 'selected' : '' %>>All Years</option>
            <% yearOptions.forEach(function(y) { %>
              <option value="<%= y %>" <%= schoolYear === y ? 'selected' : '' %>><%= y %></option>
            <% }); %>
          </select>
        </form>
        <a class="icon-btn" href="/parent/family-school/annual-planner/export.csv?schoolYear=<%= schoolYear %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <a class="icon-btn" href="/parent/family-school/annual-planner/print?schoolYear=<%= schoolYear %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
        <a class="icon-btn" href="/parent/family-school/annual-planner/download.pdf?schoolYear=<%= schoolYear %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
      </div>
    </div>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <%# A real request: "Family management should also have a subpage
        called annual planner where it is organized by student and you
        add curriculum under each student. Pop up asks for curriculum
        name, brand, level and price." %>
    <% if (familyStudents.length === 0) { %>
      <p class="roster-empty">No students in your family yet.</p>
    <% } else { %>
      <% familyStudents.forEach(function(s) { %>
        <% var items = curriculumByStudent[s.id]; %>
        <% var studentTotal = items.reduce(function(sum, item) { return sum + (item.price != null ? Number(item.price) : 0); }, 0); %>
        <div class="manage-section" data-curriculum-section>
          <div class="grid-box-header">
            <h2><%= s.name %> <span class="hint" data-curriculum-total>Total: $<%= studentTotal.toFixed(2) %></span></h2>
          </div>
          <p class="roster-empty" data-curriculum-empty <%- items.length > 0 ? 'hidden' : '' %>>No curriculum added yet.</p>
          <div class="roster-scroll" <%- items.length === 0 ? 'hidden' : '' %>>
            <table class="roster-table members-table condensed-table table-stack-mobile">
              <thead><tr><th>Subject</th><th>Curriculum</th><th>Brand</th><th>Level</th><th>Price</th><th></th></tr></thead>
              <tbody>
                <% items.forEach(function(item) { %>
                  <tr data-curriculum-id="<%= item.id %>">
                    <td data-label="Subject" class="table-stack-heading"><%= item.subject || '—' %></td>
                    <td data-label="Curriculum"><%= item.name %></td>
                    <td data-label="Brand"><%= item.brand || '' %></td>
                    <td data-label="Level"><%= item.level || '' %></td>
                    <td data-label="Price"><%= item.price != null ? '$' + Number(item.price).toFixed(2) : '' %></td>
                    <td class="roster-btn-row accounting-row-icons">
                      <button type="button" class="icon-btn" aria-label="Edit" title="Edit"
                        data-edit-curriculum="<%= item.id %>"
                        data-subject="<%= item.subject || '' %>"
                        data-name="<%= item.name %>"
                        data-brand="<%= item.brand || '' %>"
                        data-level="<%= item.level || '' %>"
                        data-price="<%= item.price != null ? item.price : '' %>"
                        data-school-year="<%= item.school_year || '' %>"><svg class="icon"><use href="#icon-edit"/></svg></button>
                      <button type="button" class="icon-btn icon-btn-danger" aria-label="Delete" title="Delete"
                        data-delete-curriculum="<%= item.id %>"
                        data-curriculum-name="<%= item.name %>"
                        data-student-name="<%= s.name %>"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% }); %>
    <% } %>
  </main>

  <% if (familyStudents.length > 0) { %>
    <%# A real request: "Family school management tab, subpage, pages,
        popups etc. Make sure all buttons, text bars, lists etc all have
        adequate space between rows and no overlapping." Same missing-
        .stack-form bug as the New Class dialog (parent-family-school-
        classes.ejs's own comment on this) - with 5 stacked bare <label>
        fields here, the biggest case of it in this feature. %>
    <dialog id="add-curriculum-dialog" class="class-form-dialog">
      <form method="POST" action="/parent/family-school/annual-planner" class="stack-form">
        <div class="class-form-dialog-header">
          <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
          <h3>Add Curriculum</h3>
        </div>
        <label>Student
          <select name="studentId" required>
            <% familyStudents.forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }); %>
          </select>
        </label>
        <label>Subject
          <input type="text" name="subject" placeholder="e.g. Math, Language Arts" />
        </label>
        <label>Curriculum Name
          <input type="text" name="name" required />
        </label>
        <label>Brand
          <input type="text" name="brand" />
        </label>
        <label>Level
          <input type="text" name="level" />
        </label>
        <label>Price
          <input type="number" name="price" min="0" step="0.01" />
        </label>
        <label>School Year
          <select name="schoolYear">
            <% var dialogDefaultYear = schoolYear === 'all' ? currentSchoolYearValue : schoolYear; %>
            <% yearOptions.forEach(function(y) { %>
              <option value="<%= y %>" <%= y === dialogDefaultYear ? 'selected' : '' %>><%= y %></option>
            <% }); %>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Add Curriculum</button>
        </div>
      </form>
    </dialog>

    <%# A real request: "Add edit and delete icons to all annual
        planning curriculum rows." One shared dialog (not one per row)
        - public/js/annual-planner-curriculum.js populates it and sets
        the form's action from the clicked row's own Edit button before
        showing it, same convention as Weekly Planner's edit dialog. %>
    <dialog id="edit-curriculum-dialog" class="class-form-dialog">
      <form method="POST" action="" class="stack-form" id="edit-curriculum-form">
        <div class="class-form-dialog-header">
          <span class="class-form-dialog-icon"><svg class="icon"><use href="#icon-book"/></svg></span>
          <h3>Edit Curriculum</h3>
        </div>
        <label>Subject
          <input type="text" name="subject" placeholder="e.g. Math, Language Arts" />
        </label>
        <label>Curriculum Name
          <input type="text" name="name" required />
        </label>
        <label>Brand
          <input type="text" name="brand" />
        </label>
        <label>Level
          <input type="text" name="level" />
        </label>
        <label>Price
          <input type="number" name="price" min="0" step="0.01" />
        </label>
        <label>School Year
          <select name="schoolYear">
            <% yearOptions.forEach(function(y) { %>
              <option value="<%= y %>"><%= y %></option>
            <% }); %>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Save Changes</button>
        </div>
      </form>
    </dialog>
  <% } %>

  <script src="/js/annual-planner-curriculum.js"></script>
</body>
</html>
