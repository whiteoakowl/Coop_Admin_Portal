<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Invoices</h1>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <%# A real request: "Add invoice button should be fit to text and on
        the same row as the status dropdown menu. Also add a filter
        button to filter between members, sections." The +Invoice button,
        the Status dropdown and the new Filter button (member/section)
        now all live on one .roster-btn-row - the form itself IS that row
        (same shape as the per-charge Record Payment dialog's own single
        <form data-toggle-form>) so every control, including the ones
        tucked inside the Filter <details> popup below, shares one submit
        - .accounting-list-toolbar's own existing fit-to-text fix
        (.roster-action-btn { flex: 0 0 auto; }, styles.css) already
        covers +Invoice here exactly like it does on the Accounts page. %>
    <form method="GET" action="/main-admin/accounting/invoices" class="roster-btn-row accounting-list-toolbar no-print">
      <a class="roster-action-btn" href="/main-admin/accounting/invoices/new">+ Invoice</a>

      <select name="status" onchange="this.form.submit()">
        <option value="">All Statuses</option>
        <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
        <option value="paid" <%= status === 'paid' ? 'selected' : '' %>>Paid</option>
        <option value="cancelled" <%= status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        <option value="refunded" <%= status === 'refunded' ? 'selected' : '' %>>Refunded</option>
        <option value="partially_refunded" <%= status === 'partially_refunded' ? 'selected' : '' %>>Partially Refunded</option>
      </select>

      <%# Same <details>/Filter-button popup pattern as views/admin-
          rosters.ejs's own Class Rosters Filter (Day/Hour/Semester) -
          each select still navigates server-side on its own onchange
          (this.form.submit(), same convention as Status above), just
          tucked behind one Filter button instead of its own always-
          visible dropdown. %>
      <details class="filter-details" data-filter-details>
        <summary class="roster-action-btn">Filter</summary>
        <div class="filter-panel">
          <div class="category-filter">
            <label for="invoices-filter-member">Member</label>
            <select id="invoices-filter-member" name="memberId" onchange="this.form.submit()">
              <option value="">All Members</option>
              <% allMembers.forEach(function(m) { %>
                <option value="<%= m.id %>" <%= memberId === m.id ? 'selected' : '' %>><%= m.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="category-filter">
            <label for="invoices-filter-section">Section</label>
            <select id="invoices-filter-section" name="sectionId" onchange="this.form.submit()">
              <option value="">All Sections</option>
              <% allSections.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= sectionId === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }); %>
            </select>
          </div>
        </div>
      </details>
    </form>

    <% if (memberId) { %>
      <p class="no-print"><span class="badge-pill badge-pill-gray">Filtered to one member - <a href="/main-admin/accounting/invoices<%= status ? '?status=' + status : '' %><%= sectionId ? (status ? '&' : '?') + 'sectionId=' + sectionId : '' %>">clear</a></span></p>
    <% } %>

    <% if (invoices.length === 0) { %>
      <p class="roster-empty">No invoices match.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table accounting-table-mobile-fit accounting-table-mobile-fit-tighter">
          <thead>
            <tr>
              <th>Invoice #</th>
              <th>Member</th>
              <th>Description</th>
              <th>Amount</th>
              <th>Paid</th>
              <th>Status</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% invoices.forEach(function(c) { %>
              <tr>
                <td>#<%= c.id %></td>
                <td><a href="/main-admin/accounting/members/<%= c.member_id %>"><%= c.memberName %></a></td>
                <td><%= c.description %></td>
                <td><%= formatCents(c.amount_cents) %></td>
                <td><%= formatCents(c.amountPaid) %></td>
                <td><span class="badge-pill badge-pill-<%= c.status === 'paid' ? 'green' : c.status === 'cancelled' || c.status === 'refunded' ? 'gray' : 'orange' %>"><%= c.status.replace('_', ' ') %></span></td>
                <td><%= c.dateLabel %></td>
                <td class="roster-btn-row accounting-row-icons">
                  <a class="icon-btn" href="/main-admin/accounting/invoices/<%= c.id %>/edit" aria-label="Edit invoice #<%= c.id %>" title="Edit"><svg class="icon"><use href="#icon-edit"/></svg></a>
                  <a class="icon-btn" href="/main-admin/accounting/members/<%= c.member_id %>?autoprint=1" aria-label="Print invoice #<%= c.id %>" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
                  <form method="POST" action="/main-admin/accounting/invoices/<%= c.id %>/delete" class="inline-block-form" data-confirm="Delete invoice #<%= c.id %> for <%= c.memberName %>? This also removes any payments recorded against it.">
                    <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete invoice #<%= c.id %>" title="Delete"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
  <script src="/js/filter-details-dismiss.js"></script>
</body>
</html>
