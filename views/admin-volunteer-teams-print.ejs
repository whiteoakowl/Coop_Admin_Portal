<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <style>@page { size: letter portrait; margin: 0.5in; }</style>
</head>
<body class="admin-page floater-teams-print-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-preview-header no-print">
      <h1><%= dayLabel %> Floater Teams</h1>
      <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
    </div>

    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= dayLabel %> Floater Teams</p>
      </div>
    </div>

    <% if (teams.every(function(t) { return t.members.length === 0; })) { %>
      <p class="roster-empty">No floaters on <%= dayLabel %>'s list yet.</p>
    <% } %>

    <div class="team-card-grid floater-team-card-grid">
      <% teams.forEach(function(team, i) { %>
        <%# Read-only counterpart to the live Teams page's own card (views/
            admin-volunteer-teams.ejs) - no hour-label input, no rank
            select, no remove button, since this page has nothing
            editable to offer. Matches what the live page's own @media
            print rules already reduce it down to today (rank/remove are
            both wrapped in .no-print there). %>
        <div class="team-col">
          <div class="team-info-card team-accent-<%= i % 5 %>">
            <span class="team-info-icon"><svg class="icon"><use href="#icon-users"/></svg></span>
            <h3 class="team-info-title"><%= team.hourLabel %></h3>
            <span class="team-info-pill"><svg class="icon"><use href="#icon-users"/></svg> <span><%= team.members.length %> floater<%= team.members.length === 1 ? '' : 's' %></span></span>
          </div>
          <div class="team-members-card">
            <h4>Members</h4>
            <div class="team-card-members">
              <% if (team.members.length === 0) { %>
                <p class="team-card-empty">No floaters assigned to this hour yet.</p>
              <% } %>
              <% team.members.forEach(function(m) { %>
                <div class="team-member-row">
                  <span class="team-member-avatar"><%= m.name.charAt(0).toUpperCase() %></span>
                  <span class="team-member-name" title="<%= m.name %>"><%= m.name %><% if (m.infant) { %> <span class="team-member-flag">(infant)</span><% } %></span>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </main>
  <script src="/js/print-auto.js"></script>
</body>
</html>
