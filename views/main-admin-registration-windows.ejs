<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
    navLinks: [
      { href: '/main-admin', icon: 'home', label: 'Home' },
      { href: '/main-admin/users', icon: 'user-check', label: 'Users' },
      { href: '/main-admin/roles', icon: 'sliders', label: 'Roles & Permissions' },
      { href: '/main-admin/website', icon: 'palette', label: 'Website' },
      { href: '/main-admin/registration-windows', icon: 'clock', label: 'Registration' },
    ],
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Registration Windows</h1>
    <p class="hint">
      Stage class registration in rounds - e.g. teachers first, then everyone else. A class only accepts
      registrations once it's individually marked "Open for parent registration" (Co-op Admin Portal &gt;
      Class Schedule &gt; Edit Class) <em>and</em>, if any windows exist below, the parent qualifies for one
      that's currently open. With no windows at all, a class's own Open toggle is the only gate - exactly
      how registration worked before this page existed.
    </p>

    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <section class="portal-dashboard-card portal-dashboard-card-wide">
      <h2>Add a Window</h2>
      <form method="POST" action="/main-admin/registration-windows" class="member-form-grid">
        <label class="member-form-full">Label
          <input type="text" name="label" placeholder="e.g. Teacher Priority Registration" required />
        </label>
        <label>Opens To
          <select name="roleKey">
            <option value="">Everyone</option>
            <% roles.forEach(function(r) { %>
              <option value="<%= r.key %>"><%= r.label %></option>
            <% }); %>
          </select>
        </label>
        <label>Opens At
          <input type="datetime-local" name="opensAt" required />
        </label>
        <label>Closes At <span class="hint">(optional - blank means it stays open)</span>
          <input type="datetime-local" name="closesAt" />
        </label>
        <div class="member-form-full">
          <button type="submit" class="primary-btn">Add Window</button>
        </div>
      </form>
    </section>

    <section class="portal-dashboard-section">
      <h2>Current Windows</h2>
      <% if (windows.length === 0) { %>
        <p class="roster-empty">No registration windows yet - every open class is available to every family immediately.</p>
      <% } else { %>
        <div class="roster-scroll">
          <table class="roster-table members-table condensed-table">
            <thead>
              <tr>
                <th>Label</th>
                <th>Opens To</th>
                <th>Opens At</th>
                <th>Closes At</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% windows.forEach(function(w) { %>
                <tr>
                  <td class="roster-name-col"><%= w.label %></td>
                  <td><%= w.roleLabel || 'Everyone' %></td>
                  <td><%= w.opensLabel %></td>
                  <td><%= w.closesLabel || 'Stays open' %></td>
                  <td>
                    <form method="POST" action="/main-admin/registration-windows/<%= w.id %>/delete" data-confirm="Delete the &quot;<%= w.label %>&quot; window?">
                      <button type="submit" class="roster-action-btn roster-action-btn-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
