<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <h1>Class Dashboard</h1>

    <% if (children.length === 0 && parents.length === 0) { %>
      <p class="roster-empty">No family members are linked to your account yet. Contact an admin if this looks wrong.</p>
    <% } else { %>
      <%
        var selectedPerson = selectedChild || selectedParent;
        var selectedValue = selectedChild ? ('student-' + selectedChild.id) : selectedParent ? ('parent-' + selectedParent.id) : '';
      %>
      <%# A real request: "Classroom dashboard on parent portal should
          have Parent names in drop down menu to show what classes the
          parent is teaching or assisting in" - the dashboard's original
          request ("a dropdown menu... with each family member to choose
          view") already called for every family member, so this one
          picker now covers both children (viewing their enrolled
          classes) and parents (viewing the classes they teach/assist). %>
      <form method="GET" action="/parent/classes/dashboard" class="class-dash-picker-form">
        <label class="member-form-full">Viewing classes for
          <select name="viewer" onchange="this.form.submit()">
            <% if (children.length) { %>
              <optgroup label="Children">
                <% children.forEach(function(c) { %>
                  <option value="student-<%= c.id %>" <%= selectedValue === ('student-' + c.id) ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </optgroup>
            <% } %>
            <% if (parents.length) { %>
              <optgroup label="Parents">
                <% parents.forEach(function(p) { %>
                  <option value="parent-<%= p.id %>" <%= selectedValue === ('parent-' + p.id) ? 'selected' : '' %>><%= p.name %></option>
                <% }); %>
              </optgroup>
            <% } %>
          </select>
        </label>
        <noscript><button type="submit" class="roster-action-btn">Go</button></noscript>
      </form>

      <% if (mondayClasses.length === 0 && wednesdayClasses.length === 0) { %>
        <p class="roster-empty">
          <% if (selectedParent) { %>
            <%= selectedParent.name %> isn't teaching or assisting in any classes yet.
          <% } else { %>
            <%= selectedPerson.name %> isn't enrolled in any classes yet.
          <% } %>
        </p>
      <% } else { %>
        <h2>Monday</h2>
        <% if (mondayClasses.length === 0) { %>
          <p class="roster-empty">No Monday classes.</p>
        <% } else { %>
          <div class="class-dash-grid">
            <% mondayClasses.forEach(function(c) { %>
              <%- include('partials/class-dash-card', { c: c, selectedChild: selectedChild }) %>
            <% }); %>
          </div>
        <% } %>

        <h2>Wednesday</h2>
        <% if (wednesdayClasses.length === 0) { %>
          <p class="roster-empty">No Wednesday classes.</p>
        <% } else { %>
          <div class="class-dash-grid">
            <% wednesdayClasses.forEach(function(c) { %>
              <%- include('partials/class-dash-card', { c: c, selectedChild: selectedChild }) %>
            <% }); %>
          </div>
        <% } %>
      <% } %>
    <% } %>
  </main>
</body>
</html>
