<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="admin-page portal-page">
  <%- include('partials/icon-sprite') %>
  <%- include('partials/portal-topbar') %>
  <main class="portal-main">
    <div class="portal-header">
      <img class="landing-logo-sm" src="/img/logo.png" alt="Sanford Homeschoolers" />
      <div>
        <h1>Welcome, <%= member.name %>!</h1>
        <p class="subtitle"><%= portalRole === 'student' ? 'Student' : 'Parent' %> Portal</p>
      </div>
    </div>

    <% if (portalRole !== 'student') { %>
      <div class="manage-section">
        <h2>Family</h2>
        <div class="admin-card-grid">
          <% familyMembers.forEach(function(m) { %>
            <div class="admin-card portal-family-card">
              <strong><%= m.name %></strong>
              <span class="badge-pill"><%= m.member_type === 'parent' ? 'Parent' : m.member_type === 'admin' ? 'Admin' : 'Student' %></span>
              <% if (m.grade_level) { %><span class="hint"><%= m.grade_level %></span><% } %>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <div class="manage-section">
      <h2>This Week's Classes</h2>
      <% var anyClasses = classSchedule.some(function(d) { return d.items.length > 0; }); %>
      <% if (!anyClasses) { %>
        <p class="hint">No classes found yet.</p>
      <% } else { %>
        <div class="portal-schedule-grid">
          <% classSchedule.forEach(function(d) { %>
            <% if (d.items.length === 0) return; %>
            <div>
              <h3><%= d.dayLabel %></h3>
              <table class="roster-table condensed-table">
                <thead><tr><th>Hour</th><th>Class</th><th>Room</th><th>Who</th></tr></thead>
                <tbody>
                  <% d.items.forEach(function(item) { %>
                    <tr>
                      <td><%= item.hourLabel %></td>
                      <td><%= item.className %></td>
                      <td><%= item.room || '—' %></td>
                      <td><%= item.roles.join(', ') %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="manage-section">
      <h2>Recent Attendance</h2>
      <% if (recentAttendance.length === 0) { %>
        <p class="hint">No attendance history yet.</p>
      <% } else { %>
        <table class="roster-table condensed-table">
          <thead><tr><th>Date</th><th>Name</th><th>Status</th><th>Check-In</th></tr></thead>
          <tbody>
            <% recentAttendance.forEach(function(r) { %>
              <tr>
                <td><%= r.dateLabel %></td>
                <td><%= r.memberName %></td>
                <td><span class="cell-tag cell-<%= r.status === 'present' ? 'present' : r.status === 'late' ? 'late' : 'absent' %>"><%= r.status.charAt(0).toUpperCase() %></span></td>
                <td><%= r.checkInTime || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <% if (portalRole !== 'student') { %>
      <div class="manage-section">
        <h2>Quick Actions</h2>
        <div class="admin-card-grid">
          <a class="admin-card" href="/absence">Submit Absence/Late</a>
          <a class="admin-card" href="/name-tag">Request a Name Tag</a>
          <a class="admin-card" href="/volunteers/<%= defaultDay %>">Floater Assignments</a>
          <a class="admin-card" href="/class-schedule">Class Schedule</a>
        </div>
      </div>
    <% } %>
  </main>
</body>
</html>
