<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Family School Management' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="roster-toolbar no-print">
      <h1>Family Attendance</h1>
    </div>

    <% if (familyStudents.length === 0) { %>
      <p class="roster-empty">No students in your family yet.</p>
    <% } else { %>
      <%
        // A real request: "attendance drop down to choose one of your
        // children or family." studentIdParam carries the literal
        // "family" string through every link/form below instead of
        // selectedStudentId (which is null in family mode).
        var studentIdParam = isFamilyMode ? 'family' : selectedStudentId;
      %>
      <%# A real request: "Family attendance should have a filter
          button to choose student, family and school year. When
          viewing student or family it should show all 12 calendar
          months for that school year. Get rid of the month dropdown,
          name dropdown, everything on one row, shrink to fit." The old
          separate month-nav row (prev/next arrows + Month/Year
          selects) is gone entirely - Choose Student/Family and School
          Year both now live in one Filter popover, on the same row as
          the Export/Print/PDF icons and the Present/Absent legend. %>
      <div class="roster-btn-row roster-btn-row-fit-text fs-attendance-row-left fs-attendance-toolbar-row no-print">
        <details class="filter-details" data-filter-details>
          <summary class="roster-action-btn">Filter</summary>
          <form method="GET" action="/parent/family-school/attendance" class="filter-panel">
            <label for="attendance-student-select">Choose Student</label>
            <select id="attendance-student-select" name="studentId" onchange="this.form.submit()">
              <option value="" disabled>Choose Student</option>
              <% familyStudents.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= !isFamilyMode && selectedStudentId === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }); %>
              <option value="family" <%= isFamilyMode ? 'selected' : '' %>>Whole Family</option>
            </select>
            <label for="attendance-school-year-select">School Year</label>
            <select id="attendance-school-year-select" name="schoolYear" onchange="this.form.submit()">
              <% attendanceSchoolYearOptions.forEach(function(y) { %>
                <option value="<%= y %>" <%= schoolYear === y ? 'selected' : '' %>><%= y %></option>
              <% }); %>
            </select>
          </form>
        </details>
        <a class="icon-btn" href="/parent/family-school/attendance/export.csv?studentId=<%= studentIdParam %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <a class="icon-btn" href="/parent/family-school/attendance/print?studentId=<%= studentIdParam %>&schoolYear=<%= schoolYear %>" target="_blank" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></a>
        <a class="icon-btn" href="/parent/family-school/attendance/download.pdf?studentId=<%= studentIdParam %>&schoolYear=<%= schoolYear %>" aria-label="Download PDF" title="Download PDF"><svg class="icon"><use href="#icon-pdf"/></svg></a>
        <span class="fs-attendance-legend-row">
          <span class="badge-pill fs-attendance-legend-present">Present</span>
          <span class="badge-pill fs-attendance-legend-absent">Absent</span>
        </span>
      </div>

      <%# "View a calendar and mark days student is present for school by
          clicking on the date and it highlights gren. If you click again
          it becomes red for didn't do school." Click cycles unmarked ->
          present (green) -> absent (red) -> unmarked (public/js/family-
          school-attendance.js), one fetch() per click against this
          student's own toggle endpoint - no full page reload. The outer
          grid (not each month's own table) carries data-fs-attendance-
          calendar/data-toggle-url now, since that script already does
          event delegation down to whichever [data-fs-attendance-cell]
          was actually clicked - the same .annual-calendar-months-grid/
          .annual-calendar-month/.annual-calendar-table shrink-to-fit
          CSS the Main Admin Annual Calendar's own live view uses. %>
      <div class="annual-calendar-months-grid" data-fs-attendance-calendar data-student-id="<%= studentIdParam %>" data-toggle-url="<%= isFamilyMode ? '/parent/family-school/attendance/family/toggle' : '/parent/family-school/attendance/' + selectedStudentId + '/toggle' %>">
        <% months.forEach(function(m) { %>
          <div class="annual-calendar-month">
            <h3><%= MONTH_NAMES[m.month - 1] %> <%= m.year %></h3>
            <table class="fs-attendance-calendar annual-calendar-table">
              <thead>
                <tr><th>Su</th><th>Mo</th><th>Tu</th><th>We</th><th>Th</th><th>Fr</th><th>Sa</th></tr>
              </thead>
              <tbody>
                <% m.weeks.forEach(function(week) { %>
                  <tr>
                    <% week.forEach(function(d) { %>
                      <% if (!d) { %>
                        <td class="fs-attendance-day fs-attendance-day-empty"></td>
                      <% } else {
                        var status = m.attendanceByDate[d.date] || '';
                      %>
                        <td class="fs-attendance-day fs-attendance-day-<%= status || 'unmarked' %>" data-fs-attendance-cell data-date="<%= d.date %>"><%= d.day %></td>
                      <% } %>
                    <% }); %>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
  <script src="/js/filter-details-dismiss.js"></script>
  <script src="/js/family-school-attendance.js"></script>
</body>
</html>
