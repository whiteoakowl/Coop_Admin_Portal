<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/portal-nav', { portalTitle: 'Parent Portal' }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <p class="subtitle"><a href="/parent/family-school">&larr; Family School Management</a></p>
    <div class="roster-toolbar no-print">
      <h1>Family Attendance</h1>
    </div>

    <% if (familyStudents.length === 0) { %>
      <p class="roster-empty">No students in your family yet.</p>
    <% } else { %>
      <%
        var prevMonth = month === 1 ? 12 : month - 1;
        var prevYear = month === 1 ? year - 1 : year;
        var nextMonth = month === 12 ? 1 : month + 1;
        var nextYear = month === 12 ? year + 1 : year;
        var MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      %>
      <%# A real request: "Present and absent keys should be to the left,
          not centered and just under the title. The description goes
          under the key bubbles." roster-btn-row-fit-text's own mobile
          rule centers a row's contents (public/css/styles.css's own
          comment on that class) - fs-attendance-row-left (two classes,
          so it wins over that single-class mobile rule regardless of
          source order) overrides it back to left-aligned, the same
          left-start default this row already has at desktop widths. %>
      <div class="roster-btn-row roster-btn-row-fit-text fs-attendance-row-left">
        <span class="badge-pill fs-attendance-legend-present">Present</span>
        <span class="badge-pill fs-attendance-legend-absent">Absent</span>
      </div>
      <p class="hint">Click a date to mark present, click again for absent, a third time to clear it.</p>

      <%# "Add the following buttons to each page. Export, print,
          download, filter. Make sure they are the similar size, same
          height, fit to text." The old bare Student <select> moved into
          the Filter popover below (the same <details>/<summary> idiom
          admin-rosters.ejs's own Filter button already uses) so all four
          buttons sit in one same-height, fit-to-text row instead of a
          differently-shaped dropdown sitting apart from them. Export is
          this one selected student's attendance; Download is every
          family student's - see routes/parent-family-school.js's own
          /attendance/export.csv and /attendance/download.csv. %>
      <div class="roster-btn-row roster-btn-row-fit-text no-print">
        <a class="icon-btn" href="/parent/family-school/attendance/export.csv?studentId=<%= selectedStudentId %>" aria-label="Export CSV" title="Export CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <button type="button" class="icon-btn" onclick="window.print()" aria-label="Print" title="Print"><svg class="icon"><use href="#icon-printer"/></svg></button>
        <a class="icon-btn" href="/parent/family-school/attendance/download.csv" aria-label="Download CSV" title="Download CSV"><svg class="icon"><use href="#icon-download"/></svg></a>
        <details class="filter-details">
          <summary class="roster-action-btn">Filter</summary>
          <form method="GET" action="/parent/family-school/attendance" class="filter-panel">
            <label for="attendance-student-select">Student</label>
            <select id="attendance-student-select" name="studentId" onchange="this.form.submit()">
              <% familyStudents.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= selectedStudentId === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }); %>
            </select>
          </form>
        </details>
      </div>

      <%# "View a calendar and mark days student is present for school by
          clicking on the date and it highlights gren. If you click again
          it becomes red for didn't do school." Click cycles unmarked ->
          present (green) -> absent (red) -> unmarked (public/js/family-
          school-attendance.js), one fetch() per click against this
          student's own toggle endpoint - no full page reload. %>
      <%# A real request: "Then the blue arrow buttons that should be
          shrunk a lot and the month should be a drop down choice of
          months/years. Move this row to the left." fs-attendance-nav-btn
          shrinks Prev/Next well below the usual .btn-secondary size;
          the two new <select>s (auto-submitting the same GET this page
          already reads year/month from) sit between them as a direct
          jump-to-month/year alternative to stepping one month at a
          time. fs-attendance-row-left is the same left-alignment
          override the Present/Absent row above uses. %>
      <form method="GET" action="/parent/family-school/attendance" class="roster-btn-row roster-btn-row-fit-text fs-attendance-row-left fs-attendance-nav-row">
        <input type="hidden" name="studentId" value="<%= selectedStudentId %>" />
        <a class="btn-secondary fs-attendance-nav-btn" href="?studentId=<%= selectedStudentId %>&year=<%= prevYear %>&month=<%= prevMonth %>" aria-label="Previous month">&larr; Prev</a>
        <select name="month" aria-label="Month" onchange="this.form.submit()">
          <% MONTH_NAMES.forEach(function(name, i) { %>
            <option value="<%= i + 1 %>" <%= month === i + 1 ? 'selected' : '' %>><%= name %></option>
          <% }); %>
        </select>
        <select name="year" aria-label="Year" onchange="this.form.submit()">
          <% yearOptions.forEach(function(y) { %>
            <option value="<%= y %>" <%= year === y ? 'selected' : '' %>><%= y %></option>
          <% }); %>
        </select>
        <a class="btn-secondary fs-attendance-nav-btn" href="?studentId=<%= selectedStudentId %>&year=<%= nextYear %>&month=<%= nextMonth %>" aria-label="Next month">Next &rarr;</a>
      </form>

      <table class="fs-attendance-calendar" data-fs-attendance-calendar data-student-id="<%= selectedStudentId %>" data-toggle-url="/parent/family-school/attendance/<%= selectedStudentId %>/toggle">
        <thead>
          <tr><th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th></tr>
        </thead>
        <tbody>
          <% weeks.forEach(function(week) { %>
            <tr>
              <% week.forEach(function(d) { %>
                <% if (!d) { %>
                  <td class="fs-attendance-day fs-attendance-day-empty"></td>
                <% } else {
                  var status = attendanceByDate[d.date] || '';
                %>
                  <td class="fs-attendance-day fs-attendance-day-<%= status || 'unmarked' %>" data-fs-attendance-cell data-date="<%= d.date %>"><%= d.day %></td>
                <% } %>
              <% }); %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </main>
  <script src="/js/family-school-attendance.js"></script>
</body>
</html>
