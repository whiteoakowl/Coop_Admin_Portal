<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%# A real request: "admin chat category view shows a list of each
      thread to click on to read with an archive button at the end." See
      routes/admin-forums.js's own "Admin thread/post browsing" comment
      for why this is a separate view from the member-facing forums-
      category.ejs - this one always stays in Main Admin's own chrome. %>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= category.name %></h1>
      <div class="roster-btn-row">
        <%# A real request: "edit button should be on chat group page...
            no moderation tab/subpage," later: "instead of a popup edit
            chat to be a page with save button" - the same name/
            description/allow comments/sections/moderator settings the
            old Moderate tab's popup used to edit now live on their own
            page instead of a dialog here. %>
        <a class="roster-action-btn" href="/main-admin/forums/<%= category.id %>/edit">Edit</a>
        <%# A real request: "next to edit button should be add thread
            button. A thread or comment could be added by an admin." %>
        <button type="button" class="roster-action-btn" onclick="document.getElementById('add-thread-dialog').showModal()">Add Thread</button>
      </div>
    </div>
    <p><a href="/main-admin/forums">&larr; Chat</a></p>
    <% if (category.is_locked) { %><span class="badge-pill badge-pill-gray">Locked</span><% } %>
    <% if (category.status === 'archived') { %><span class="badge-pill badge-pill-gray">Archived</span><% } %>
    <% if (category.description) { %><p class="hint"><%= category.description %></p><% } %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (threads.length === 0) { %>
      <p class="roster-empty">No threads yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>Thread</th>
              <th>Started By</th>
              <th>Replies</th>
              <th>Last Activity</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% threads.forEach(function(t) { %>
              <tr>
                <td class="roster-name-col">
                  <a href="/main-admin/forums/threads/<%= t.id %>"><%= t.title %></a>
                  <% if (t.is_pinned) { %> <span class="badge-pill">Pinned</span><% } %>
                  <% if (t.is_locked) { %> <span class="badge-pill badge-pill-gray">Locked</span><% } %>
                  <% if (t.status === 'archived') { %> <span class="badge-pill badge-pill-gray">Archived</span><% } %>
                </td>
                <td><%= t.authorName || 'Unknown' %></td>
                <td><%= t.postCount - 1 %></td>
                <td><%= t.lastActivityAt %></td>
                <td>
                  <% if (t.status !== 'archived') { %>
                    <form method="POST" action="/main-admin/forums/threads/<%= t.id %>/archive" class="inline-block-form" data-confirm="Archive &quot;<%= t.title %>&quot;?">
                      <button type="submit" class="roster-action-btn roster-action-btn-danger">Archive</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <dialog id="add-thread-dialog" class="member-picker-dialog">
      <form method="POST" action="/main-admin/forums/<%= category.id %>/threads">
        <h3>Add Thread</h3>
        <label>Title
          <input type="text" name="title" required />
        </label>
        <div data-forum-editor>
          <label>Message</label>
          <%- include('partials/forum-editor-toolbar') %>
          <div class="forum-editable" data-forum-editable contenteditable="true"></div>
          <input type="hidden" name="body" data-forum-body-input />
        </div>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Post Thread</button>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/forum-editor.js"></script>
</body>
</html>
