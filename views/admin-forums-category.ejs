<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%# A real request: "admin chat category view shows a list of each
      thread to click on to read with an archive button at the end." See
      routes/admin-forums.js's own "Admin thread/post browsing" comment
      for why this is a separate view from the member-facing forums-
      category.ejs - this one always stays in Main Admin's own chrome. %>
  <%- include('partials/portal-nav', {
    portalTitle: 'Main Admin',
  }) %>

  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="grid-box-header">
      <h1><%= category.name %></h1>
      <%# A real request: "edit button should be on chat group page. no
          moderation tab/subpage." Same name/description/allow comments/
          sections/moderator settings the old Moderate tab's per-category
          popup used to edit (routes/admin-forums.js's own POST
          /:id/settings, unchanged), just reached from here now. %>
      <button type="button" class="roster-action-btn" onclick="document.getElementById('edit-chat-group-dialog').showModal()">Edit</button>
    </div>
    <p><a href="/main-admin/forums">&larr; Chat</a></p>
    <% if (category.description) { %><p class="hint"><%= category.description %></p><% } %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <% if (threads.length === 0) { %>
      <p class="roster-empty">No threads yet.</p>
    <% } else { %>
      <div class="roster-scroll">
        <table class="roster-table members-table condensed-table">
          <thead>
            <tr>
              <th>Thread</th>
              <th>Started By</th>
              <th>Replies</th>
              <th>Last Activity</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% threads.forEach(function(t) { %>
              <tr>
                <td class="roster-name-col">
                  <a href="/main-admin/forums/threads/<%= t.id %>"><%= t.title %></a>
                  <% if (t.is_pinned) { %> <span class="badge-pill">Pinned</span><% } %>
                  <% if (t.is_locked) { %> <span class="badge-pill badge-pill-gray">Locked</span><% } %>
                  <% if (t.status === 'archived') { %> <span class="badge-pill badge-pill-gray">Archived</span><% } %>
                </td>
                <td><%= t.authorName || 'Unknown' %></td>
                <td><%= t.postCount - 1 %></td>
                <td><%= t.lastActivityAt %></td>
                <td>
                  <% if (t.status !== 'archived') { %>
                    <form method="POST" action="/main-admin/forums/threads/<%= t.id %>/archive" class="inline-block-form" data-confirm="Archive &quot;<%= t.title %>&quot;?">
                      <button type="submit" class="roster-action-btn roster-action-btn-danger">Archive</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>

  <dialog id="edit-chat-group-dialog" class="member-picker-dialog">
    <form method="POST" action="/main-admin/forums/<%= category.id %>/settings">
      <h3>Edit Chat Group</h3>
      <label for="edit-chat-group-name">Chat Group Name
        <input id="edit-chat-group-name" type="text" name="name" value="<%= category.name %>" required />
      </label>
      <label for="edit-chat-group-description">Description
        <textarea id="edit-chat-group-description" name="description" rows="2"><%= category.description || '' %></textarea>
      </label>
      <div class="grade-pill-grid">
        <label class="grade-pill"><input type="checkbox" name="allowComments" <%= category.allow_comments ? 'checked' : '' %> /> Allow comments</label>
      </div>
      <span class="roster-checkbox-label">Sections <span class="hint">(leave all unchecked to allow every section)</span></span>
      <% if (allSections.length === 0) { %>
        <p class="hint">No sections defined yet.</p>
      <% } else { %>
        <div class="grade-pill-grid">
          <% allSections.forEach(function(s) { %>
            <label class="grade-pill"><input type="checkbox" name="sectionIds" value="<%= s.id %>" <%= sectionIds.includes(s.id) ? 'checked' : '' %> /> <%= s.name %></label>
          <% }); %>
        </div>
      <% } %>
      <label for="edit-chat-group-moderator">Member to Moderate
        <select id="edit-chat-group-moderator" name="moderatorMemberId">
          <option value="">None</option>
          <% members.forEach(function(m) { %>
            <option value="<%= m.id %>" <%= category.moderator_member_id === m.id ? 'selected' : '' %>><%= m.name %></option>
          <% }); %>
        </select>
      </label>
      <div class="notes-dialog-actions">
        <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
        <button type="submit" class="primary-btn">Save</button>
      </div>
    </form>
  </dialog>
</body>
</html>
