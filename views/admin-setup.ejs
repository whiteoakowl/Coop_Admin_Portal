<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <%# Explicit portrait, not left to whatever orientation the browser/
      printer last remembered - see .setup-team-card-grid's own @media
      print override in styles.css for the matching 2-per-row layout. %>
  <style>@page { size: letter portrait; margin: 0.5in; }</style>
</head>
<body class="admin-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= dayLabel %> Setup/Cleanup Teams</p>
      </div>
    </div>

    <h1>Setup/Cleanup</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="view-tabs no-print">
      <a class="view-tab<%= day === 'monday' ? ' active' : '' %>" href="/admin/setup/monday/manage">Monday Teams</a>
      <a class="view-tab<%= day === 'wednesday' ? ' active' : '' %>" href="/admin/setup/wednesday/manage">Wednesday Teams</a>
      <a class="view-tab" href="/admin/setup/<%= day %>/tasks">Task List</a>
    </div>

    <div class="view-tab-panel">
      <div class="roster-toolbar no-print">
        <div></div>
        <div class="roster-btn-row">
          <button type="button" class="roster-action-btn" onclick="document.getElementById('new-team-dialog').showModal()">+ Create New Team</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-member-dialog').showModal()">+ Add Member</button>
          <a class="roster-action-btn file-action-btn" href="/admin/setup/<%= day %>/export.csv">Export</a>
          <button type="button" class="roster-action-btn print-action-btn" onclick="window.print()">Print</button>
        </div>
      </div>

      <% if (teams.length === 0) { %>
        <p class="roster-empty">No teams yet &mdash; create one above.</p>
      <% } %>

      <div class="team-card-grid setup-team-card-grid">
        <% teams.forEach(function(t, i) { %>
          <%# The whole card (info + members) is one edit-toggle .edit-
              section (public/js/edit-toggle.js) - clicking Edit unfreezes
              the title/description/leader fields in place and reveals the
              delete-team and per-member remove trash icons, all at once.
              No popup: "Edit" just unfreezes this same card. %>
          <div class="team-col edit-section" data-edit-toggle-section>
            <div class="team-info-card team-accent-<%= i % 5 %>">
              <div class="team-card-corner-actions no-print">
                <button type="button" class="icon-btn" data-edit-toggle-edit aria-label="Edit <%= t.title %>" title="Edit Team">
                  <svg class="icon"><use href="#icon-edit"/></svg>
                </button>
                <button type="submit" class="icon-btn" form="team-edit-form-<%= t.id %>" data-edit-toggle-save hidden aria-label="Save <%= t.title %>" title="Save">
                  <svg class="icon"><use href="#icon-check"/></svg>
                </button>
                <button type="button" class="icon-btn" data-edit-toggle-cancel hidden aria-label="Cancel editing <%= t.title %>" title="Cancel">
                  <svg class="icon"><use href="#icon-x-circle"/></svg>
                </button>
                <form method="POST" action="/admin/setup/<%= day %>/teams/<%= t.id %>/delete" class="inline-block-form" data-edit-toggle-reveal hidden data-confirm="Delete team &quot;<%= t.title %>&quot;? This cannot be undone.">
                  <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= t.title %>" title="Delete Team"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </form>
              </div>
              <span class="team-info-icon"><svg class="icon"><use href="#icon-broom"/></svg></span>
              <form method="POST" action="/admin/setup/<%= day %>/teams/<%= t.id %>/edit" id="team-edit-form-<%= t.id %>" class="team-info-edit-form">
                <input type="text" name="title" class="team-info-title team-info-title-input" value="<%= t.title %>" required disabled />
                <div class="team-info-leader">
                  <svg class="icon"><use href="#icon-user"/></svg>
                  Leader:
                  <select name="leaderId" class="team-info-leader-select" disabled>
                    <option value="">No leader</option>
                    <% availableParents.forEach(function(p) { %>
                      <option value="<%= p.id %>" <%= t.leader_id === p.id ? 'selected' : '' %>><%= p.name %></option>
                    <% }); %>
                  </select>
                </div>
                <input type="text" name="description" class="team-info-desc-input" value="<%= t.description || '' %>" placeholder="Short description (optional)" disabled />
              </form>
            </div>
            <div class="team-members-card">
              <h4>Members</h4>
              <div class="team-card-members">
                <% if (t.members.length === 0) { %>
                  <p class="team-card-empty">No members yet.</p>
                <% } %>
                <% t.members.forEach(function(m) { %>
                  <div class="team-member-row<%= absentIds.has(m.id) ? ' team-member-row-absent' : '' %>">
                    <span class="team-member-avatar"><%= m.name.charAt(0).toUpperCase() %></span>
                    <span class="team-member-name" title="<%= m.name %><%= absentIds.has(m.id) ? ' (absent today)' : '' %>"><%= m.name %></span>
                    <form method="POST" action="/admin/setup/<%= day %>/teams/<%= t.id %>/remove-member/<%= m.id %>" class="inline-block-form" data-edit-toggle-reveal hidden data-confirm="Remove <%= m.name %> from this team?">
                      <button type="submit" class="icon-btn" aria-label="Remove <%= m.name %>" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                    </form>
                  </div>
                <% }); %>
              </div>
            </div>
            <% if (t.taskSection && t.taskSection.items.length > 0) { %>
              <div class="team-tasks-card">
                <h4>Tasks</h4>
                <ol class="team-tasks-list">
                  <% t.taskSection.items.forEach(function(item) { %>
                    <li><%= item.description %></li>
                  <% }); %>
                </ol>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>

    <dialog id="new-team-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/setup/<%= day %>/teams">
        <h3>Create New Team</h3>
        <input type="text" name="title" placeholder="Team title (e.g. Chairs &amp; Tables)" required />
        <input type="text" name="description" placeholder="Short description (optional)" />
        <label>Leader (optional)
          <select name="leaderId">
            <option value="">No leader</option>
            <% availableParents.forEach(function(p) { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% }); %>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create Team</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-member-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/setup/<%= day %>/teams/add-member">
        <h3>Add Member to a Team</h3>
        <% if (teams.length === 0) { %>
          <p class="hint">Create a team above first.</p>
        <% } else { %>
          <label>Member
            <select name="memberId" required>
              <option value="" disabled selected>Select member&hellip;</option>
              <% availableParents.forEach(function(p) { %>
                <option value="<%= p.id %>"><%= p.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Team
            <select name="teamId" required>
              <option value="" disabled selected>Select team&hellip;</option>
              <% teams.forEach(function(t) { %>
                <option value="<%= t.id %>"><%= t.title %></option>
              <% }); %>
            </select>
          </label>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <% if (teams.length > 0) { %>
            <button type="submit" class="primary-btn">Add</button>
          <% } %>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/edit-toggle.js"></script>
</body>
</html>
