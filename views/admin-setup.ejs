<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head', { title }) %>
  <%# Explicit portrait, not left to whatever orientation the browser/
      printer last remembered - see .setup-team-card-grid's own @media
      print override in styles.css for the matching one-team-per-page
      layout. %>
  <style>@page { size: letter portrait; margin: 0.5in; }</style>
</head>
<body class="admin-page setup-teams-print-page">
  <%- include('partials/admin-nav') %>
  <main id="main-content" tabindex="-1" class="admin-main">
    <div class="print-header">
      <img src="/img/logo.png" alt="" />
      <div>
        <p class="print-header-title">Sanford Homeschoolers</p>
        <p class="print-header-sub"><%= dayLabel %> Setup/Cleanup Teams</p>
      </div>
    </div>

    <h1>Setup/Cleanup</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <%- include('partials/setup-tabs', { day, activeSetupTab: 'teams' }) %>

    <div class="view-tab-panel">
      <div class="roster-toolbar no-print">
        <div class="day-toggle">
          <a class="day-toggle-option<%= day === 'monday' ? ' active' : '' %>" href="/admin/setup/monday/manage">Monday</a>
          <a class="day-toggle-option<%= day === 'wednesday' ? ' active' : '' %>" href="/admin/setup/wednesday/manage">Wednesday</a>
        </div>
        <div class="roster-btn-row roster-btn-row-fit-text">
          <button type="button" class="roster-action-btn" onclick="document.getElementById('new-team-dialog').showModal()">+ Create New Team</button>
          <button type="button" class="roster-action-btn" onclick="document.getElementById('add-member-dialog').showModal()">+ Add Member</button>
          <a class="roster-action-btn file-action-btn" href="/admin/setup/<%= day %>/export.csv">Export</a>
          <%# A real bug report: "floater team and setup cleanup teams
              should have a print preview before going to print." Lands on
              a dedicated read-only preview page (admin-setup-teams-print.ejs)
              with its own Print button, instead of jumping straight to the
              OS print dialog off this live edit page. %>
          <a class="roster-action-btn print-action-btn" href="/admin/setup/<%= day %>/teams/print" target="_blank">Print</a>
          <a class="roster-action-btn" href="/admin/setup/<%= day %>/archive">Archive</a>
        </div>
      </div>

      <% if (teams.length === 0) { %>
        <p class="roster-empty">No teams yet &mdash; create one above.</p>
      <% } %>

      <div class="team-card-grid setup-team-card-grid">
        <% teams.forEach(function(t, i) { %>
          <%# A real request: "printing the setup cleanup teams should be
              one team per page[,] reduced to fit one whole team card per
              page." This wrapper is inert on screen (plain block, no
              styling of its own there) - see .team-print-page-fit's own
              @media print rule in styles.css for the one-page-per-card
              layout, and public/js/print-shrink-to-fit.js's
              data-shrink-to-fit-on-print handling for the real-browser
              shrink that guarantees it, the same pattern the live
              Attendance roster grid already uses for the identical
              "always fit one page" problem. data-shrink-to-fit-budget
              hands fitOne() the same "how much room to shrink a busy
              team into" number as .team-print-page-fit's own max-height
              (see that rule's own comment for why it's a measurement-
              time budget rather than a permanent CSS height).

              Team 1 (i === 0) shares its page with .print-header above,
              unlike every later team - see admin-setup-teams-print.ejs's
              own copy of this same comment for the full "blank-looking
              leading page" bug report and why 8.2in, not 9.2in, is team
              1's own real budget once the header's ~0.79in is accounted
              for. Each team still runs fitOne() against its own budget
              first; data-shrink-to-fit-group="teams" then levels every
              team's resulting page down to whichever one needed the most
              shrinking, so a print job's pages all read the same font
              size - a real, twice-repeated request, most recently with
              two screenshots showing genuinely different sizes across
              pages. %>
          <div class="team-print-page-fit" data-shrink-to-fit-on-print data-shrink-to-fit-budget="<%= i === 0 ? '8.2in' : '9.2in' %>" data-shrink-to-fit-group="teams">
          <%# The whole card (info + members) is one edit-toggle .edit-
              section (public/js/edit-toggle.js) - clicking Edit unfreezes
              the title/description/leader fields in place and reveals the
              delete-team and per-member remove trash icons, all at once.
              No popup: "Edit" just unfreezes this same card. %>
          <div class="team-col edit-section" data-edit-toggle-section>
            <div class="team-info-card team-accent-<%= i % 5 %>">
              <div class="team-card-corner-actions no-print">
                <button type="button" class="icon-btn" data-edit-toggle-edit aria-label="Edit <%= t.title %>" title="Edit Team">
                  <svg class="icon"><use href="#icon-edit"/></svg>
                </button>
                <button type="submit" class="icon-btn" form="team-edit-form-<%= t.id %>" data-edit-toggle-save hidden aria-label="Save <%= t.title %>" title="Save">
                  <svg class="icon"><use href="#icon-check"/></svg>
                </button>
                <button type="button" class="icon-btn" data-edit-toggle-cancel hidden aria-label="Cancel editing <%= t.title %>" title="Cancel">
                  <svg class="icon"><use href="#icon-x-circle"/></svg>
                </button>
                <form method="POST" action="/admin/setup/<%= day %>/teams/<%= t.id %>/delete" class="inline-block-form" data-edit-toggle-reveal hidden data-confirm="Delete team &quot;<%= t.title %>&quot;? This cannot be undone.">
                  <button type="submit" class="icon-btn icon-btn-danger" aria-label="Delete <%= t.title %>" title="Delete Team"><svg class="icon"><use href="#icon-trash"/></svg></button>
                </form>
              </div>
              <span class="team-info-icon"><svg class="icon"><use href="#icon-broom"/></svg></span>
              <form method="POST" action="/admin/setup/<%= day %>/teams/<%= t.id %>/edit" id="team-edit-form-<%= t.id %>" class="team-info-edit-form">
                <input type="text" name="title" class="team-info-title team-info-title-input" value="<%= t.title %>" required disabled />
                <input type="text" name="description" class="team-info-desc-input" value="<%= t.description || '' %>" placeholder="Short description (optional)" disabled />
                <%# A real report: "on the setup/cleanup team cards its
                    showing the information circled twice... clean, professional...
                    balanced" - Leader/Meeting time/Meeting location used to
                    each get their own full-width stacked row, reading as a
                    tall, sparse header on screen too (the same "three
                    guaranteed separate rows" problem print already solved
                    for - see .team-info-meta-row's own comment in
                    styles.css). One flex-wrap row now, same balanced-chips
                    look as the print-only .team-print-meta a few lines
                    below, but still real editable form controls (a
                    <select>, two <input>s) - not the read-only text print
                    uses, since this row is what an admin actually edits. %>
                <div class="team-info-meta-row">
                  <%# "Leader:" as a spelled-out label (still how the Create
                      New Team dialog's own <label> reads, and how the
                      previous full-width stacked row read) doesn't fit
                      three items onto one balanced row on a phone-width
                      card - dropped here in favor of the same person-icon-
                      only convention print's own .team-print-meta chip
                      already uses successfully with no separate label. %>
                  <div class="team-info-leader">
                    <svg class="icon"><use href="#icon-user"/></svg>
                    <select name="leaderId" class="team-info-leader-select" disabled>
                      <option value="">No leader</option>
                      <%# A real request: admins should show up alongside
                          parents when choosing a team leader - they
                          regularly run a team themselves. Both
                          availableLeaders and the Add Member dialog below
                          (availableParents) are parent+admin now - see
                          routes/admin-setup.js's own comment. %>
                      <% availableLeaders.forEach(function(p) { %>
                        <option value="<%= p.id %>" <%= t.leader_id === p.id ? 'selected' : '' %>><%= p.name %></option>
                      <% }); %>
                    </select>
                  </div>
                  <%# A real request: "setup/cleanup team cards should have a
                      space for time to meet and meeting location." Free text
                      (same shape/treatment as description above, not a
                      time/date picker) - same freeze/unfreeze-in-place
                      editing, save together with everything else on this
                      form. %>
                  <div class="team-info-meeting">
                    <svg class="icon"><use href="#icon-clock"/></svg>
                    <input type="text" name="meetingTime" class="team-info-meeting-input" value="<%= t.meeting_time || '' %>" placeholder="Meeting time" disabled />
                  </div>
                  <div class="team-info-meeting">
                    <svg class="icon"><use href="#icon-map-pin"/></svg>
                    <input type="text" name="meetingLocation" class="team-info-meeting-input" value="<%= t.meeting_location || '' %>" placeholder="Meeting location" disabled />
                  </div>
                  <%# A real request: "add a dropdown menu to each setup/
                      cleanup team list that asks, log on check in or log
                      on check out. choosing one or the other will
                      determine when a member is asked to scan their
                      setup/cleanup card." Same freeze/unfreeze-in-place
                      editing as the rest of this row - saves together
                      with everything else on this form. Still only ever
                      asked of parents/admins either way - students never
                      scan a Setup/Cleanup badge (routes/checkout.js,
                      routes/kiosk.js). %>
                  <div class="team-info-leader">
                    <svg class="icon"><use href="#icon-barcode"/></svg>
                    <select name="taskScanTiming" class="team-info-leader-select" disabled>
                      <option value="checkout" <%= t.task_scan_timing !== 'checkin' ? 'selected' : '' %>>Log on check out</option>
                      <option value="checkin" <%= t.task_scan_timing === 'checkin' ? 'selected' : '' %>>Log on check in</option>
                    </select>
                  </div>
                </div>
              </form>
              <%# A real request: "header for each card in print should be
                  more organized with information reduced to balance equal
                  rows" - print-only balanced Leader/Time/Location row (see
                  .team-print-meta's own comment in styles.css); the row
                  above stays for screen editing but hides for print. %>
              <div class="team-print-meta">
                <% if (t.leaderName) { %><span class="team-print-meta-item"><svg class="icon"><use href="#icon-user"/></svg> <%= t.leaderName %></span><% } %>
                <% if (t.meeting_time) { %><span class="team-print-meta-item"><svg class="icon"><use href="#icon-clock"/></svg> <%= t.meeting_time %></span><% } %>
                <% if (t.meeting_location) { %><span class="team-print-meta-item"><svg class="icon"><use href="#icon-map-pin"/></svg> <%= t.meeting_location %></span><% } %>
              </div>
            </div>
            <div class="team-members-card">
              <h4>Members</h4>
              <div class="team-card-members">
                <% if (t.members.length === 0) { %>
                  <p class="team-card-empty">No members yet.</p>
                <% } %>
                <% t.members.forEach(function(m) { %>
                  <div class="team-member-row<%= absentIds.has(m.id) ? ' team-member-row-absent' : '' %>" data-member-remove-row>
                    <span class="team-member-avatar"><%= m.name.charAt(0).toUpperCase() %></span>
                    <span class="team-member-name-col"><span class="team-member-name" title="<%= m.name %><%= absentIds.has(m.id) ? ' (absent today)' : '' %>"><%= m.name %><% if (m.infant) { %> <span class="team-member-flag">(infant)</span><% } %></span><% if (m.phone) { %><span class="team-member-phone"><%= m.phone %></span><% } %></span>
                    <%# A real request: "when deleting ... cleanup/signup
                        members from lists it should allow for multiple
                        deletes and then click save before refreshing."
                        This trash icon no longer submits its own form
                        immediately - it flips a same-named hidden
                        checkbox tied (via form="...") to the card's own
                        team-edit-form, so any number of pending removals
                        ride along with that form's single Save submission
                        instead of each causing its own round trip/page
                        reload (public/js/team-member-remove-toggle.js). %>
                    <input type="checkbox" name="removeMemberIds" value="<%= m.id %>" form="team-edit-form-<%= t.id %>" hidden data-member-remove-checkbox />
                    <button type="button" class="icon-btn" data-edit-toggle-reveal hidden data-member-remove-btn aria-label="Remove <%= m.name %>" title="Remove"><svg class="icon"><use href="#icon-trash"/></svg></button>
                  </div>
                <% }); %>
              </div>
            </div>
            <% if (t.taskSection && t.taskSection.items.length > 0) { %>
              <div class="team-tasks-card">
                <h4>Tasks</h4>
                <ol class="team-tasks-list">
                  <% t.taskSection.items.forEach(function(item) { %>
                    <li><%= item.description %></li>
                  <% }); %>
                </ol>
              </div>
            <% } %>
          </div>
          </div>
        <% }); %>
      </div>
    </div>

    <dialog id="new-team-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/setup/<%= day %>/teams">
        <h3>Create New Team</h3>
        <input type="text" name="title" placeholder="Team title (e.g. Chairs &amp; Tables)" required />
        <input type="text" name="description" placeholder="Short description (optional)" />
        <input type="text" name="meetingTime" placeholder="Meeting time (optional)" />
        <input type="text" name="meetingLocation" placeholder="Meeting location (optional)" />
        <label>Leader (optional)
          <select name="leaderId">
            <option value="">No leader</option>
            <% availableLeaders.forEach(function(p) { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% }); %>
          </select>
        </label>
        <label>Setup/Cleanup badge scan
          <select name="taskScanTiming">
            <option value="checkout" selected>Log on check out</option>
            <option value="checkin">Log on check in</option>
          </select>
        </label>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <button type="submit" class="primary-btn">Create Team</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-member-dialog" class="member-picker-dialog">
      <form method="POST" action="/admin/setup/<%= day %>/teams/add-member">
        <h3>Add Member to a Team</h3>
        <% if (teams.length === 0) { %>
          <p class="hint">Create a team above first.</p>
        <% } else { %>
          <label>Member
            <select name="memberId" required>
              <option value="" disabled selected>Select member&hellip;</option>
              <% availableParents.forEach(function(p) { %>
                <option value="<%= p.id %>"><%= p.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Team
            <select name="teamId" required>
              <option value="" disabled selected>Select team&hellip;</option>
              <% teams.forEach(function(t) { %>
                <option value="<%= t.id %>"><%= t.title %></option>
              <% }); %>
            </select>
          </label>
        <% } %>
        <div class="notes-dialog-actions">
          <button type="button" class="btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
          <% if (teams.length > 0) { %>
            <button type="submit" class="primary-btn">Add</button>
          <% } %>
        </div>
      </form>
    </dialog>
  </main>
  <script src="/js/edit-toggle.js"></script>
  <script src="/js/team-member-remove-toggle.js"></script>
  <script src="/js/print-shrink-to-fit.js"></script>
</body>
</html>
